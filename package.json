{
  "name": "airlink-panel",
  "version": "2.5.191",
  "description": "Airlink Panel — game server management panel for Minecraft, Palworld, Rust, and more",
  "keywords": [
    "game-server",
    "minecraft",
    "palworld",
    "rust",
    "management-panel",
    "prisma",
    "express",
    "htmx",
    "petrodactyl-alternaitve"
  ],
  "homepage": "https://airlinklabs.xyz/",
  "repository": {
    "type": "git",
    "url": "https://github.com/airlinklabs/panel.git"
  },
  "bugs": {
    "url": "https://github.com/airlinklabs/panel/issues"
  },
  "author": "AirlinkLabs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env dist/app.js",
    "dev": "prisma generate && prisma db push && (trap 'kill 0' EXIT; tailwindcss -i ./public/styles/tw.css -o ./public/styles.css --watch & nodemon)",
    "build": "tsc && tsc -p tsconfig.prisma.json && tailwindcss -i ./public/styles/tw.css -o ./public/styles.css",
    "build:css": "tailwindcss -i ./public/styles/tw.css -o ./public/styles.css --watch",
    "setup": "node public/scripts/setup.mjs",
    "setup:full": "node public/scripts/setup.mjs && pnpm run start",
    "secret": "node dist/cli/secret.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "node dist/cli/seed.js",
    "db:reset": "prisma migrate reset --force && prisma generate",
    "db:drop": "prisma db execute --stdin <<< 'DROP DATABASE IF EXISTS airlink;'",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.prisma.json --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:docker": "docker compose -f tests/docker/docker-compose.test.yml up --build --abort-on-container-exit",
    "test:all": "vitest run && npx playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/lib-storage": "^3.1100.0",
    "@dicebear/core": "^9.4.3",
    "@dicebear/thumbs": "^9.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@formkit/auto-animate": "^0.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tanstack/query-core": "^5.101.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.6.0",
    "alpinejs": "^3.14.9",
    "bcryptjs": "^3.0.3",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "chart.js": "^4.4.0",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.6.2",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-ws": "^5.0.2",
    "form-data": "^4.0.6",
    "helmet": "^8.2.0",
    "htmx.org": "^2.0.4",
    "ioredis": "^5.6.1",
    "lucide": "^1.18.0",
    "monaco-editor": "^0.56.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "reconnecting-websocket": "^4.4.0",
    "validator": "^13.15.35",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/adm-zip": "^0.5.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/express-ws": "^3.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "eslint": "^10.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}
