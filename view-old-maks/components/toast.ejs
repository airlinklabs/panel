<script nonce="<%- nonce %>">
  (function () {
    if (window.createToastSystem) return;

    window.createToastSystem = () => {
      const toastContainer = document.getElementById('toast-container');

      const showToast = (message, type = 'error') => {
        const toast = document.createElement('div');
        toast.style.pointerEvents = 'auto';
        toast.className =
          'px-4 py-3 rounded-xl shadow-lg transform transition-all duration-300 ease-in-out opacity-0 translate-x-full flex flex-row items-center gap-3 border';

        if (type === 'error') {
          toast.classList.add('bg-white', 'dark:bg-neutral-800', 'text-red-600', 'dark:text-red-400', 'border-red-200', 'dark:border-red-500/20');
        } else if (type === 'success') {
          toast.classList.add('bg-white', 'dark:bg-neutral-800', 'text-emerald-600', 'dark:text-emerald-400', 'border-emerald-200', 'dark:border-emerald-500/20');
        } else if (type === 'warning') {
          toast.classList.add('bg-white', 'dark:bg-neutral-800', 'text-amber-600', 'dark:text-amber-400', 'border-amber-200', 'dark:border-amber-500/20');
        } else if (type === 'loading') {
          toast.classList.add('bg-white', 'dark:bg-neutral-800', 'text-blue-600', 'dark:text-blue-400', 'border-blue-200', 'dark:border-blue-500/20');
        } else {
          toast.classList.add('bg-white', 'dark:bg-neutral-800', 'text-blue-600', 'dark:text-blue-400', 'border-blue-200', 'dark:border-blue-500/20');
        }

        const icon = document.createElement('span');
        switch (type) {
          case 'error':
            icon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-red-500"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm-1.72 6.97a.75.75 0 10-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 101.06 1.06L12 13.06l1.72 1.72a.75.75 0 101.06-1.06L13.06 12l1.72-1.72a.75.75 0 10-1.06-1.06L12 10.94l-1.72-1.72z" clip-rule="evenodd"/></svg>';
            break;
          case 'success':
            icon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-emerald-500"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/></svg>';
            break;
          case 'warning':
            icon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-amber-500"><path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd"/></svg>';
            break;
          case 'loading':
            icon.innerHTML = '<svg class="animate-spin w-5 h-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><circle class="opacity-75" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-dasharray="31.4 31.4" stroke-dashoffset="0"></circle></svg>';
            break;
          default:
            icon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-blue-500"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd"/></svg>';
        }
        toast.appendChild(icon);

        const messageSpan = document.createElement('span');
        messageSpan.className = 'font-medium text-sm line-clamp-2';
        messageSpan.textContent = message;
        toast.appendChild(messageSpan);

        let progressBar;
        if (type === 'loading') {
          progressBar = document.createElement('div');
          progressBar.className = 'h-1 w-full bg-neutral-200 dark:bg-neutral-700 rounded mt-2 overflow-hidden';
          const progressFill = document.createElement('div');
          progressFill.className = 'h-full w-0 bg-blue-500 dark:bg-blue-400 transition-all duration-300';
          progressBar.appendChild(progressFill);
          toast.appendChild(progressBar);
        }

        toastContainer.appendChild(toast);
        requestAnimationFrame(() => {
          toast.classList.remove('opacity-0', 'translate-x-full');
          toast.classList.add('opacity-100', 'translate-x-0');
        });

        let dismissTimer;
        const removeToast = () => {
          toast.classList.add('opacity-0', 'translate-x-full');
          setTimeout(() => { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 300);
        };

        if (type !== 'loading') {
          dismissTimer = setTimeout(removeToast, 5000);
          toast.addEventListener('pointerenter', () => { clearTimeout(dismissTimer); });
          toast.addEventListener('pointerleave', () => { dismissTimer = setTimeout(removeToast, 2000); });
        } else {
          dismissTimer = setTimeout(removeToast, 60000);
          toast.addEventListener('pointerenter', () => { clearTimeout(dismissTimer); });
          toast.addEventListener('pointerleave', () => { dismissTimer = setTimeout(removeToast, 60000); });
        }

        (function addSwipeDismiss(el, removeFn) {
          var startX = 0, dx = 0, swiping = false;
          el.addEventListener('pointerdown', function (e) {
            startX = e.clientX; swiping = true;
            el.style.transition = 'none';
            el.setPointerCapture(e.pointerId);
          });
          el.addEventListener('pointermove', function (e) {
            if (!swiping) return;
            dx = e.clientX - startX;
            el.style.transform = 'translateX(' + dx + 'px)';
            el.style.opacity = Math.max(0, 1 - Math.abs(dx) / 160).toString();
          });
          el.addEventListener('pointerup', function () {
            swiping = false;
            el.style.transition = '';
            if (Math.abs(dx) > 80) { removeFn(); }
            else { el.style.transform = ''; el.style.opacity = '1'; }
            dx = 0;
          });
        })(toast, removeToast);

        return {
          updateProgress: (percent) => {
            if (progressBar) {
              progressBar.firstChild.style.width = percent + '%';
              if (percent >= 100) removeToast();
            }
          },
          close: removeToast,
        };
      };

      return { showToast };
    };

    const { showToast } = window.createToastSystem();
    window.showToast = showToast;
    window.showLoadingToast = (message) => showToast(message, 'loading');

    // Read URL params for toast messages (?toast=Msg&type=success OR ?message=Msg&success=true)
    try {
      var params = new URLSearchParams(window.location.search);
      var toastMsg = params.get('toast') || params.get('message');
      var toastType = params.get('type') || (params.get('success') === 'true' ? 'success' : null);
      if (toastMsg && toastType) {
        params.delete('toast');
        params.delete('message');
        params.delete('type');
        params.delete('success');
        params.delete('error');
        var cleanUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash;
        window.history.replaceState({}, '', cleanUrl);
        setTimeout(function () { showToast(decodeURIComponent(toastMsg), toastType); }, 200);
      }
    } catch (e) {}
  })();
</script>
<% if (typeof flashToast !== 'undefined' && flashToast) { %>
<script nonce="<%- nonce %>">
  (function() {
    try {
      var msg = <%- JSON.stringify(flashToast.message || '') %>;
      var type = <%- JSON.stringify(flashToast.type || 'success') %>;
      if (msg && window.showToast) {
        setTimeout(function() { window.showToast(msg, type); }, 200);
      }
    } catch(e) {}
  })();
</script>
<% } %>
