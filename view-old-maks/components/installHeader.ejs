<% if (typeof installed !== 'undefined') { %>
<% if (installed.failed) { %>
<div class="mx-<% if (isMobileViewport) { %>4 mt-3 px-3 py-2.5 gap-2.5<% } else { %>8 mt-4 px-4 py-3 gap-3<% } %> rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex items-center">
  <div class="rounded-lg bg-red-100 dark:bg-red-500/10 flex items-center justify-center shrink-0 <% if (isMobileViewport) { %>h-7 w-7<% } else { %>h-8 w-8<% } %>">
    <% if (isMobileViewport) { %>
    <%- icon('x', { size: 14, class: 'text-red-400 shrink-0' }) %>
    <% } else { %>
    <%- icon('x', { class: 'h-4 w-4 text-red-500 dark:text-red-400', strokeWidth: 2 }) %>
    <% } %>
  </div>
  <div class="min-w-0">
    <p class="<% if (isMobileViewport) { %>text-xs<% } else { %>text-sm<% } %> font-medium text-neutral-800 dark:text-neutral-100">Installation failed</p>
    <p class="<% if (isMobileViewport) { %>text-[11px]<% } else { %>text-xs<% } %> text-neutral-500 dark:text-neutral-400 mt-0.5"><% if (isMobileViewport) { %>Check logs or contact an administrator.<% } else { %>Check the server logs or contact an administrator.<% } %></p>
  </div>
</div>
<% } else if (!installed.installed && !installed.error) { %>
<div id="installBanner" class="mx-<% if (isMobileViewport) { %>4 mt-3 px-3 py-2.5 gap-2.5<% } else { %>8 mt-4 px-4 py-3 gap-3<% } %> rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex items-center">
  <div id="installIconWrap" class="rounded-lg bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center shrink-0 <% if (isMobileViewport) { %>h-7 w-7<% } else { %>h-8 w-8<% } %>">
    <%- icon('loader', { id: 'installSpinner', class: (isMobileViewport ? 'h-3.5 w-3.5' : 'h-4 w-4') + ' text-neutral-500 dark:text-neutral-400 animate-spin' }) %>
  </div>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-<% if (isMobileViewport) { %>1.5<% } else { %>2<% } %>">
      <p class="<% if (isMobileViewport) { %>text-xs<% } else { %>text-sm<% } %> font-medium text-neutral-800 dark:text-neutral-100 shrink-0">Installing server</p>
      <span class="text-neutral-300 dark:text-neutral-600">·</span>
      <p id="installStateText" class="<% if (isMobileViewport) { %>text-[11px]<% } else { %>text-xs<% } %> text-neutral-500 dark:text-neutral-400 truncate">Waiting for daemon…</p>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
(function () {
  var serverUUID = '<%= server.UUID %>';
  var stateText  = document.getElementById('installStateText');
  var spinnerEl  = document.getElementById('installSpinner');
  var iconWrap   = document.getElementById('installIconWrap');
  var banner     = document.getElementById('installBanner');

  var proto   = location.protocol === 'https:' ? 'wss' : 'ws';
  var evtSock = new WebSocket(proto + '://' + location.host + '/events/' + serverUUID);

  evtSock.onmessage = function(msg) {
    var parsed;
    try { parsed = JSON.parse(msg.data); } catch(e) { return; }
    if (parsed.event !== 'lifecycle') return;
    if (parsed.data.message) stateText.textContent = parsed.data.message;
  };

  function markDone() {
    evtSock.close();
    clearInterval(poller);
    stateText.textContent = 'Installation complete';
    if (spinnerEl) {
      spinnerEl.classList.remove('animate-spin', 'text-neutral-500');
      spinnerEl.setAttribute('stroke', 'currentColor');
      spinnerEl.setAttribute('stroke-width', '2');
      spinnerEl.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>';
      spinnerEl.classList.add('text-emerald-500');
    }
    if (iconWrap) {
      iconWrap.className = 'rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center shrink-0 <% if (isMobileViewport) { %>h-7 w-7<% } else { %>h-8 w-8<% } %>';
    }
    setTimeout(function() { window.location.reload(); }, 1600);
  }

  function markFailed() {
    evtSock.close();
    clearInterval(poller);
    stateText.textContent = 'Installation failed';
    if (spinnerEl) {
      spinnerEl.classList.remove('animate-spin', 'text-neutral-500');
      spinnerEl.setAttribute('stroke', 'currentColor');
      spinnerEl.setAttribute('stroke-width', '2');
      spinnerEl.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>';
      spinnerEl.classList.add('text-red-500');
    }
    if (iconWrap) {
      iconWrap.className = 'rounded-lg bg-red-50 dark:bg-red-500/10 flex items-center justify-center shrink-0 <% if (isMobileViewport) { %>h-7 w-7<% } else { %>h-8 w-8<% } %>';
    }
  }

  function poll() {
    fetch('/server/' + serverUUID + '/status')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var state = data.state || (data.installed ? 'installed' : data.failed ? 'failed' : 'installing');
        if (state === 'installed') markDone();
        else if (state === 'failed') markFailed();
      })
      .catch(function() {});
  }

  var poller = setInterval(poll, 3000);
  poll();
})();
</script>
<% } %>
<% } %>
