<% if (isMobileViewport) { %>
<%- include('../../components/header', { title: 'Scheduled Tasks' }) %>
<main id="page-content">
    <%- include('../../components/template') %>
    <section class="px-4 py-5">
        <%- include('../../components/serverHeader', { server: server, req: req }) %>
        <%- include('../../components/serverTemplate') %>
        <div class="space-y-4 mt-4">

            <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-medium text-neutral-800 dark:text-white">Scheduled Tasks</h2>
                </div>
                <div id="tasks-list" class="space-y-2">
                    <% if (typeof tasks !== 'undefined' && tasks && tasks.length > 0) { %>
                        <% tasks.forEach(function(task) { %>
                        <div class="data-animate-card rounded-xl bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-white/5 p-3" data-task-id="<%= task.id %>">
                            <div class="flex items-center justify-between">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium
                                            <% if (task.type === 'restart') { %>bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400
                                            <% } else { %>bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400<% } %>">
                                            <%= task.type.charAt(0).toUpperCase() + task.type.slice(1) %>
                                        </span>
                                        <span class="text-[10px] font-mono text-neutral-500"><%= task.cron %></span>
                                    </div>
                                    <div class="flex items-center gap-2 mt-1.5">
                                        <span class="inline-flex items-center rounded-md px-1.5 py-0.5 text-[10px] font-medium
                                            <% if (task.enabled) { %>bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400
                                            <% } else { %>bg-neutral-100 dark:bg-neutral-600 text-neutral-500 dark:text-neutral-400<% } %>">
                                            <%= task.enabled ? 'Enabled' : 'Disabled' %>
                                        </span>
                                        <span class="text-[10px] text-neutral-500">Last: <span class="font-medium text-neutral-700 dark:text-neutral-300"><%= task.lastRun ? new Date(task.lastRun).toLocaleString() : 'Never' %></span></span>
                                        <span class="text-[10px] text-neutral-500">Next: <span class="font-medium text-neutral-700 dark:text-neutral-300"><%= task.nextRun ? new Date(task.nextRun).toLocaleString() : '—' %></span></span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 shrink-0 ml-2">
                                    <button type="button" role="switch" aria-checked="<%= task.enabled %>" onclick="toggleTask('<%= task.id %>')" class="al-switch relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-400 dark:focus-visible:ring-offset-neutral-800 <%= task.enabled ? 'bg-emerald-500' : 'bg-neutral-200 dark:bg-neutral-700' %>" data-task-toggle="<%= task.id %>">
                                        <span class="al-switch-dot pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out <%= task.enabled ? 'translate-x-4' : 'translate-x-0' %>"></span>
                                    </button>
                                    <button type="button" onclick="deleteTask('<%= task.id %>')" class="rounded-xl bg-red-600 text-white px-2.5 py-1 text-[11px] font-medium transition hover:bg-red-700">Delete</button>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-xs text-neutral-500 text-center py-4" id="tasks-empty">No scheduled tasks. Create one to automate server management.</p>
                    <% } %>
                </div>
            </div>

            <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4">
                <h3 class="text-sm font-medium text-neutral-800 dark:text-white mb-3">Create Task</h3>
                <form id="createTaskForm" class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Type</label>
                                <select name="type" class="cs-select">
                            <option value="restart">Restart</option>
                            <option value="backup">Backup</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Cron Expression</label>
                        <input type="text" name="cron" placeholder="0 2 * * *" class="rounded-xl border border-neutral-200 dark:border-neutral-600/30 bg-white dark:bg-neutral-800/50 px-3 py-2 text-sm text-neutral-800 dark:text-white w-full font-mono focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30">
                        <p class="text-[10px] text-neutral-500 mt-1">e.g. 0 2 * * * for daily at 2am</p>
                    </div>
                    <button type="submit" class="rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 text-sm font-medium transition hover:opacity-90">Create Task</button>
                </form>
            </div>

        </div>
    </section>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>
<%- include('../../components/modal') %>
<%- include('../../components/footer') %>

<% } else { %>
<%- include('../../components/header', { title: 'Scheduled Tasks' }) %>
<main class="h-screen m-auto">
    <div class="flex h-screen">
        <%- include('../../components/template') %>
        <section id="page-content" class="flex-1 overflow-y-auto pt-16">
            <div class="px-8 pt-4">
                <%- include('../../components/serverHeader', { server: server, req: req }) %>
            </div>
            <%- include('../../components/serverTemplate') %>
            <div class="p-6">
                <div class="data-animate-card bg-neutral-50 dark:bg-neutral-800 rounded-xl p-5 border border-neutral-200 dark:border-white/5">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-lg font-semibold text-neutral-800 dark:text-white">Scheduled Tasks</h2>
                    </div>
                    <div id="tasks-list" class="space-y-3">
                        <% if (typeof tasks !== 'undefined' && tasks && tasks.length > 0) { %>
                            <% tasks.forEach(function(task) { %>
                            <div class="data-animate-card rounded-xl bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-white/5 p-4" data-task-id="<%= task.id %>">
                                <div class="flex items-center justify-between">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                                                <% if (task.type === 'restart') { %>bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400
                                                <% } else { %>bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400<% } %>">
                                                <%= task.type.charAt(0).toUpperCase() + task.type.slice(1) %>
                                            </span>
                                            <span class="text-xs font-mono text-neutral-500"><%= task.cron %></span>
                                        </div>
                                        <div class="flex items-center gap-3 mt-2">
                                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium
                                                <% if (task.enabled) { %>bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400
                                                <% } else { %>bg-neutral-100 dark:bg-neutral-600 text-neutral-500 dark:text-neutral-400<% } %>">
                                                <%= task.enabled ? 'Enabled' : 'Disabled' %>
                                            </span>
                                            <span class="text-xs text-neutral-500">Last Run: <span class="font-medium text-neutral-700 dark:text-neutral-300"><%= task.lastRun ? new Date(task.lastRun).toLocaleString() : 'Never' %></span></span>
                                            <span class="text-xs text-neutral-500">Next Run: <span class="font-medium text-neutral-700 dark:text-neutral-300"><%= task.nextRun ? new Date(task.nextRun).toLocaleString() : '—' %></span></span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 shrink-0 ml-4">
                                        <button type="button" role="switch" aria-checked="<%= task.enabled %>" onclick="toggleTask('<%= task.id %>')" class="al-switch relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-400 dark:focus-visible:ring-offset-neutral-800 <%= task.enabled ? 'bg-emerald-500' : 'bg-neutral-200 dark:bg-neutral-700' %>" data-task-toggle="<%= task.id %>">
                                            <span class="al-switch-dot pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out <%= task.enabled ? 'translate-x-5' : 'translate-x-0' %>"></span>
                                        </button>
                                        <button type="button" onclick="deleteTask('<%= task.id %>')" class="rounded-xl bg-red-600 text-white px-4 py-2 text-sm font-medium transition hover:bg-red-700">Delete</button>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-sm text-neutral-500 text-center py-8" id="tasks-empty">No scheduled tasks. Create one to automate server management.</p>
                        <% } %>
                    </div>
                </div>

                <div class="data-animate-card bg-neutral-50 dark:bg-neutral-800 rounded-xl p-5 border border-neutral-200 dark:border-white/5 mt-4">
                    <h3 class="text-lg font-semibold text-neutral-800 dark:text-white mb-4">Create Task</h3>
                    <form id="createTaskForm" class="space-y-4 max-w-lg">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Type</label>
                        <select name="type" class="cs-select">
                                    <option value="restart">Restart</option>
                                    <option value="backup">Backup</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Cron Expression</label>
                                <input type="text" name="cron" placeholder="0 2 * * *" class="rounded-xl border border-neutral-200 dark:border-neutral-600/30 bg-white dark:bg-neutral-800/50 px-3 py-2 text-sm text-neutral-800 dark:text-white w-full font-mono focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30">
                            </div>
                        </div>
                        <p class="text-xs text-neutral-500">e.g. 0 2 * * * for daily at 2am</p>
                        <button type="submit" class="rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 text-sm font-medium transition hover:opacity-90">Create Task</button>
                    </form>
                </div>
            </div>
        </section>
    </div>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>
<%- include('../../components/modal') %>
<%- include('../../components/footer') %>
<% } %>

<script nonce="<%- nonce %>">
var serverShortID = '<%= server.shortID %>';

document.getElementById('createTaskForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var form = e.target;
    var type = form.type.value;
    var cron = form.cron.value.trim();
    if (!cron) {
        showToast('Please enter a cron expression.', 'error');
        return;
    }
    var loader = showLoadingPopup('Creating task', 'Please wait...');
    try {
        var res = await fetch('/api/servers/' + serverShortID + '/tasks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: type, cron: cron })
        });
        var data = await res.json();
        loader.close();
        if (data.success || res.ok) {
            showToast('Task created.', 'success');
            location.reload();
        } else {
            showToast(data.error || 'Failed to create task.', 'error');
        }
    } catch(err) {
        loader.close();
        showToast('Failed to create task.', 'error');
    }
});

async function toggleTask(id) {
    try {
        var res = await fetch('/api/servers/' + serverShortID + '/tasks/' + id + '/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        var data = await res.json();
        if (data.success || res.ok) {
            location.reload();
        } else {
            showToast(data.error || 'Failed to toggle task.', 'error');
        }
    } catch(err) {
        showToast('Failed to toggle task.', 'error');
    }
}

function deleteTask(id) {
    window.modal.confirm({
        title: 'Delete Task',
        body: 'Are you sure you want to delete this scheduled task?',
        danger: true,
        confirmLabel: 'Delete',
        onConfirm: async function() {
            var loader = showLoadingPopup('Deleting task', 'Please wait...');
            try {
                var res = await fetch('/api/servers/' + serverShortID + '/tasks/' + id, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                var data = await res.json();
                loader.close();
                if (data.success) {
                    showToast('Task deleted.', 'success');
                    var row = document.querySelector('[data-task-id="' + id + '"]');
                    if (row) row.remove();
                    var list = document.getElementById('tasks-list');
                    if (list && list.querySelectorAll('[data-task-id]').length === 0) {
                        list.innerHTML = '<p class="text-xs text-neutral-500 text-center py-4" id="tasks-empty">No scheduled tasks. Create one to automate server management.</p>';
                    }
                } else {
                    showToast(data.error || 'Failed to delete task.', 'error');
                }
            } catch(err) {
                loader.close();
                showToast('Failed to delete task.', 'error');
            }
        }
    });
}
</script>
