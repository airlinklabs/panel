<% if (isMobileViewport) { %>
<%- include('../../components/header', { title: 'Server Alerts' }) %>
<main id="page-content">
    <%- include('../../components/template') %>
    <section class="px-4 py-5">
        <%- include('../../components/serverHeader', { server: server, req: req }) %>
        <%- include('../../components/serverTemplate') %>
        <div class="space-y-4 mt-4">

            <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-medium text-neutral-800 dark:text-white">Server Alerts</h2>
                </div>
                <div id="alerts-list" class="space-y-2">
                    <% if (typeof alerts !== 'undefined' && alerts && alerts.length > 0) { %>
                        <% alerts.forEach(function(alert) { %>
                        <div class="data-animate-card rounded-xl bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-white/5 p-3" data-alert-id="<%= alert.id %>">
                            <div class="flex items-center justify-between">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium
                                            <% if (alert.type === 'cpu') { %>bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400
                                            <% } else if (alert.type === 'memory') { %>bg-purple-50 dark:bg-purple-500/10 text-purple-700 dark:text-purple-400
                                            <% } else { %>bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400<% } %>">
                                            <%= alert.type.charAt(0).toUpperCase() + alert.type.slice(1) %>
                                        </span>
                                        <span class="text-xs text-neutral-500">Threshold: <%= alert.threshold %>%</span>
                                    </div>
                                    <div class="flex items-center gap-2 mt-1.5">
                                        <span class="text-[10px] text-neutral-500">Current: <span class="font-medium text-neutral-700 dark:text-neutral-300" data-alert-current="<%= alert.id %>">—</span></span>
                                        <span class="inline-flex items-center rounded-md px-1.5 py-0.5 text-[10px] font-medium
                                            <% if (alert.triggered) { %>bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400
                                            <% } else { %>bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400<% } %>" data-alert-status="<%= alert.id %>">
                                            <%= alert.triggered ? 'Triggered' : 'Normal' %>
                                        </span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 shrink-0 ml-2">
                                    <button type="button" role="switch" aria-checked="<%= alert.enabled %>" onclick="toggleAlert('<%= alert.id %>')" class="al-switch relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-400 dark:focus-visible:ring-offset-neutral-800 <%= alert.enabled ? 'bg-emerald-500' : 'bg-neutral-200 dark:bg-neutral-700' %>" data-alert-toggle="<%= alert.id %>">
                                        <span class="al-switch-dot pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out <%= alert.enabled ? 'translate-x-4' : 'translate-x-0' %>"></span>
                                    </button>
                                    <button type="button" onclick="deleteAlert('<%= alert.id %>')" class="rounded-xl bg-red-600 text-white px-2.5 py-1 text-[11px] font-medium transition hover:bg-red-700">Delete</button>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-xs text-neutral-500 text-center py-4" id="alerts-empty">No alerts set. Create one to get notified when resources are high.</p>
                    <% } %>
                </div>
            </div>

            <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4">
                <h3 class="text-sm font-medium text-neutral-800 dark:text-white mb-3">Create Alert</h3>
                <form id="createAlertForm" class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Type</label>
                                <select name="type" class="cs-select">
                            <option value="cpu">CPU Usage</option>
                            <option value="memory">Memory Usage</option>
                            <option value="disk">Disk Usage</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Threshold (%)</label>
                        <input type="number" name="threshold" min="0" max="100" value="80" class="rounded-xl border border-neutral-200 dark:border-neutral-600/30 bg-white dark:bg-neutral-800/50 px-3 py-2 text-sm text-neutral-800 dark:text-white w-full focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30">
                    </div>
                    <button type="submit" class="rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 text-sm font-medium transition hover:opacity-90">Create Alert</button>
                </form>
            </div>

        </div>
    </section>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>
<%- include('../../components/modal') %>
<%- include('../../components/footer') %>

<% } else { %>
<%- include('../../components/header', { title: 'Server Alerts' }) %>
<main class="h-screen m-auto">
    <div class="flex h-screen">
        <%- include('../../components/template') %>
        <section id="page-content" class="flex-1 overflow-y-auto pt-16">
            <div class="px-8 pt-4">
                <%- include('../../components/serverHeader', { server: server, req: req }) %>
            </div>
            <%- include('../../components/serverTemplate') %>
            <div class="p-6">
                <div class="data-animate-card bg-neutral-50 dark:bg-neutral-800 rounded-xl p-5 border border-neutral-200 dark:border-white/5">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-lg font-semibold text-neutral-800 dark:text-white">Server Alerts</h2>
                    </div>
                    <div id="alerts-list" class="space-y-3">
                        <% if (typeof alerts !== 'undefined' && alerts && alerts.length > 0) { %>
                            <% alerts.forEach(function(alert) { %>
                            <div class="data-animate-card rounded-xl bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-white/5 p-4" data-alert-id="<%= alert.id %>">
                                <div class="flex items-center justify-between">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                                                <% if (alert.type === 'cpu') { %>bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400
                                                <% } else if (alert.type === 'memory') { %>bg-purple-50 dark:bg-purple-500/10 text-purple-700 dark:text-purple-400
                                                <% } else { %>bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400<% } %>">
                                                <%= alert.type.charAt(0).toUpperCase() + alert.type.slice(1) %>
                                            </span>
                                            <span class="text-sm text-neutral-500">Threshold: <%= alert.threshold %>%</span>
                                        </div>
                                        <div class="flex items-center gap-3 mt-2">
                                            <span class="text-xs text-neutral-500">Current: <span class="font-medium text-neutral-700 dark:text-neutral-300" data-alert-current="<%= alert.id %>">—</span></span>
                                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium
                                                <% if (alert.triggered) { %>bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400
                                                <% } else { %>bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400<% } %>" data-alert-status="<%= alert.id %>">
                                                <%= alert.triggered ? 'Triggered' : 'Normal' %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 shrink-0 ml-4">
                                        <button type="button" role="switch" aria-checked="<%= alert.enabled %>" onclick="toggleAlert('<%= alert.id %>')" class="al-switch relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-400 dark:focus-visible:ring-offset-neutral-800 <%= alert.enabled ? 'bg-emerald-500' : 'bg-neutral-200 dark:bg-neutral-700' %>" data-alert-toggle="<%= alert.id %>">
                                            <span class="al-switch-dot pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out <%= alert.enabled ? 'translate-x-5' : 'translate-x-0' %>"></span>
                                        </button>
                                        <button type="button" onclick="deleteAlert('<%= alert.id %>')" class="rounded-xl bg-red-600 text-white px-4 py-2 text-sm font-medium transition hover:bg-red-700">Delete</button>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-sm text-neutral-500 text-center py-8" id="alerts-empty">No alerts set. Create one to get notified when resources are high.</p>
                        <% } %>
                    </div>
                </div>

                <div class="data-animate-card bg-neutral-50 dark:bg-neutral-800 rounded-xl p-5 border border-neutral-200 dark:border-white/5 mt-4">
                    <h3 class="text-lg font-semibold text-neutral-800 dark:text-white mb-4">Create Alert</h3>
                    <form id="createAlertForm" class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Type</label>
                        <select name="type" class="cs-select">
                                    <option value="cpu">CPU Usage</option>
                                    <option value="memory">Memory Usage</option>
                                    <option value="disk">Disk Usage</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Threshold (%)</label>
                                <input type="number" name="threshold" min="0" max="100" value="80" class="rounded-xl border border-neutral-200 dark:border-neutral-600/30 bg-white dark:bg-neutral-800/50 px-3 py-2 text-sm text-neutral-800 dark:text-white w-full focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30">
                            </div>
                        </div>
                        <button type="submit" class="rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 text-sm font-medium transition hover:opacity-90">Create Alert</button>
                    </form>
                </div>
            </div>
        </section>
    </div>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>
<%- include('../../components/modal') %>
<%- include('../../components/footer') %>
<% } %>

<script nonce="<%- nonce %>">
var serverShortID = '<%= server.shortID %>';

document.getElementById('createAlertForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var form = e.target;
    var type = form.type.value;
    var threshold = parseInt(form.threshold.value, 10);
    if (isNaN(threshold) || threshold < 0 || threshold > 100) {
        showToast('Please enter a threshold between 0 and 100.', 'error');
        return;
    }
    var loader = showLoadingPopup('Creating alert', 'Please wait...');
    try {
        var res = await fetch('/api/servers/' + serverShortID + '/alerts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: type, threshold: threshold })
        });
        var data = await res.json();
        loader.close();
        if (data.success || res.ok) {
            showToast('Alert created.', 'success');
            location.reload();
        } else {
            showToast(data.error || 'Failed to create alert.', 'error');
        }
    } catch(err) {
        loader.close();
        showToast('Failed to create alert.', 'error');
    }
});

async function toggleAlert(id) {
    try {
        var res = await fetch('/api/servers/' + serverShortID + '/alerts/' + id + '/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        var data = await res.json();
        if (data.success || res.ok) {
            location.reload();
        } else {
            showToast(data.error || 'Failed to toggle alert.', 'error');
        }
    } catch(err) {
        showToast('Failed to toggle alert.', 'error');
    }
}

function deleteAlert(id) {
    window.modal.confirm({
        title: 'Delete Alert',
        body: 'Are you sure you want to delete this alert?',
        danger: true,
        confirmLabel: 'Delete',
        onConfirm: async function() {
            var loader = showLoadingPopup('Deleting alert', 'Please wait...');
            try {
                var res = await fetch('/api/servers/' + serverShortID + '/alerts/' + id, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                var data = await res.json();
                loader.close();
                if (data.success) {
                    showToast('Alert deleted.', 'success');
                    var row = document.querySelector('[data-alert-id="' + id + '"]');
                    if (row) row.remove();
                    var list = document.getElementById('alerts-list');
                    if (list && list.querySelectorAll('[data-alert-id]').length === 0) {
                        list.innerHTML = '<p class="text-xs text-neutral-500 text-center py-4" id="alerts-empty">No alerts set. Create one to get notified when resources are high.</p>';
                    }
                } else {
                    showToast(data.error || 'Failed to delete alert.', 'error');
                }
            } catch(err) {
                loader.close();
                showToast('Failed to delete alert.', 'error');
            }
        }
    });
}
</script>
