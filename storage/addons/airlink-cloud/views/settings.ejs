<%- include('../../../../views/components/header', { title: 'Airlink Cloud' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="w-60 shrink-0"><%- include('../../../../views/components/template') %></div>

    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">
      <%- include('../../../../views/components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Airlink Cloud' }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Airlink Cloud</h1>
          <p class="al-page-desc">Configure your Airlink Cloud integration.</p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button type="button" id="saveBtn" class="al-btn-primary">Save Settings</button>
          <button type="button" id="resetBtn" class="al-btn-secondary">Reset</button>
        </div>
      </div>

      <div class="px-8 mt-5 space-y-6">

        <!-- API Configuration -->
        <div class="al-card">
          <h2 class="al-card-header">API Settings</h2>
          <div class="p-5 space-y-4">
            <div>
              <label class="al-label">Airlink Cloud API Key</label>
              <input type="password" id="airlinkCloudApiKey" value="<%= settings.airlinkCloudApiKey || '' %>" placeholder="YOUR_API_KEY_HERE"
                class="al-input">
                <p class="al-page-desc mt-2 text-xs">Get your API key from <a href="https://cloud.airlinklabs.xyz/" target="_blank" style="color:var(--theme-accent);text-decoration:underline">Airlink Cloud</a></p>
            </div>
          </div>
        </div>

        <!-- Feature Configuration -->
        <div class="al-card">
          <h2 class="al-card-header">Features</h2>
          <div class="p-5 flex items-center justify-between">
            <div>
              <p class="al-page-title text-sm" style="color:var(--theme-text)">Enable Cloud Backups</p>
              <p class="al-page-desc text-xs mt-0.5">When enabled, instance backups will be stored on Airlink Cloud instead of the local daemon.</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="airlinkCloudBackupEnabled" class="sr-only peer" <%= settings.airlinkCloudBackupEnabled ? 'checked' : '' %>>
               <div class="al-toggle-track">
                <div class="al-toggle-dot"></div>
              </div>
            </label>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<div id="page-data" style="display:none" data-csrf-token="<%= req.csrfToken() %>"></div>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-airlink-cloud-settings.js"></script>

<%- include('../../../../views/components/footer') %>
<%- include('../../../../views/components/toast') %>
