<div id="pc-sidebar" class="sidebar transition hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-56 lg:flex-col left-0">
  <div class="flex flex-col h-full bg-white/8 dark:bg-[#141414]/8 backdrop-blur-xl border-r border-neutral-200/30 dark:border-white/5">
    <div class="pl-6 pt-4 pb-4 flex min-w-0 shrink-0">
      <a href="/" class="flex items-center min-w-0">
        <img src="/assets/logo.png" alt="Logo" class="h-10 w-10 rounded-xl mr-3 shrink-0" onerror="this.style.display='none'">
        <h1 class="text-neutral-700 dark:text-white font-medium tracking-tight text-lg truncate min-w-0"><%= typeof panelTitle !== 'undefined' ? panelTitle : 'AirLink' %></h1>
      </a>
    </div>

    <a href="/account" class="flex items-center space-x-4 py-4 px-4 border-y border-neutral-800/10 dark:border-white/5 shrink-0 hover:bg-neutral-100 dark:hover:bg-white/[0.05] transition-colors group">
      <img class="h-8 w-8 rounded-xl border border-neutral-700/10 shrink-0" src="<%= user && user.avatar ? user.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(user ? user.username : 'default') %>" alt="Avatar">
      <div class="min-w-0">
        <p class="text-sm font-medium text-neutral-700 dark:text-white truncate"><%= user ? user.username : 'User' %></p>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 truncate"><%= user ? user.description : '' %></p>
      </div>
    </a>

    <nav class="flex-1 overflow-y-auto">
      <ul role="list" class="py-2">
        <li>
          <ul role="list" class="-mx-2 space-y-1 relative">
            <p class="pl-8 text-neutral-600 dark:text-neutral-400 text-xs font-medium pt-4 pb-2">Modrinth</p>
            <li>
              <a href="/modrinth" class="mt-1 text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal transition-all duration-200">
                <svg class="w-5 h-5 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                <span>Browse</span>
              </a>
            </li>
            <% if (user && user.isAdmin) { %>
            <li>
              <a href="/modrinth/admin/config" class="mt-1 text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal transition-all duration-200">
                <svg class="w-5 h-5 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Settings</span>
              </a>
            </li>
            <% } %>
          </ul>
        </li>
      </ul>
    </nav>

    <div class="shrink-0 border-t border-neutral-800/10 dark:border-white/5">
      <a href="/logout" class="group flex gap-x-3 pl-6 py-4 text-sm font-medium leading-6 text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors duration-200">
        <svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
        <span>Logout</span>
      </a>
    </div>
  </div>
</div>

<div id="colcont" class="lg:pl-56">
  <div class="fixed top-0 left-0 lg:left-56 right-0 z-40 flex h-16 shrink-0 items-center bg-white/8 dark:bg-[#141414]/8 backdrop-blur-xl border-b border-neutral-200/30 dark:border-white/5 px-4">
    <div class="flex items-center gap-3">
      <a href="/modrinth" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-800 dark:hover:text-white transition">Modrinth</a>
      <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-sm text-neutral-800 dark:text-white font-medium"><%= title %></span>
    </div>
  </div>
</div>