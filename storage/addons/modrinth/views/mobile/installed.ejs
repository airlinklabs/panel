<style>
  ::-webkit-scrollbar { display: none; }
  .mod-card {
    padding: 12px 14px; border-radius: 12px; border: 1px solid #e5e5e5;
    background: white; transition: border-color 0.15s;
  }
  .dark .mod-card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.07); }
  .mod-card:hover { border-color: #d4d4d4; }
  .dark .mod-card:hover { border-color: rgba(255,255,255,0.15); }
  .status-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 8px; border-radius: 6px; font-size: 9px; font-weight: 600;
  }
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 34px; padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 500;
    background: #171717; color: white; border: none; cursor: pointer; transition: opacity 0.15s;
  }
  .dark .btn-primary { background: white; color: #0a0a0a; }
  .btn-outline {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 34px; padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 500;
    background: transparent; color: #525252; border: 1px solid #e5e5e5; cursor: pointer; transition: opacity 0.15s;
  }
  .dark .btn-outline { color: #a3a3a3; border-color: rgba(255,255,255,0.1); }
  .btn-danger-sm {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 30px; padding: 4px 10px; border-radius: 7px; font-size: 11px; font-weight: 500;
    background: transparent; color: #dc2626; border: 1px solid #fca5a5; cursor: pointer; transition: opacity 0.15s;
  }
  .dark .btn-danger-sm { border-color: rgba(220,38,38,0.3); color: #f87171; }
</style>

<!-- Top nav -->
<div class="sticky top-14 z-30 bg-white dark:bg-[#141414] border-b border-neutral-200 dark:border-white/5 px-4 py-2.5 flex items-center justify-between">
  <div class="flex items-center gap-1.5 text-xs text-neutral-500 min-w-0 flex-1 mr-3">
    <a href="/modrinth" class="text-emerald-600 dark:text-emerald-400 shrink-0">Store</a>
    <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 111.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
    <span class="truncate"><%= server.name %></span>
  </div>
  <button onclick="window.location.href='/modrinth/progress'" class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-medium shrink-0">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
    Status
  </button>
</div>

<div class="px-4 py-4 space-y-4">

  <!-- Server info -->
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <h1 class="text-base font-medium text-neutral-900 dark:text-white truncate"><%= server.name %></h1>
      <% if (server.description) { %>
      <p class="text-xs text-neutral-500 mt-0.5 truncate"><%= server.description %></p>
      <% } %>
    </div>
    <span class="status-badge shrink-0 <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400' : server.status === 'stopped' ? 'bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400' : 'bg-neutral-100 dark:bg-neutral-700/40 text-neutral-600 dark:text-neutral-400' %>">
      <%= server.status || 'unknown' %>
    </span>
  </div>

  <!-- Updates banner -->
  <% if (updates && updates.length > 0) { %>
  <div class="rounded-xl bg-blue-50 dark:bg-blue-800/10 border border-blue-200 dark:border-blue-500/20 px-3 py-2.5">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
      <p class="text-xs font-medium text-blue-700 dark:text-blue-400"><%= updates.length %> update<%= updates.length !== 1 ? 's' : '' %> available</p>
    </div>
  </div>
  <% } %>

  <!-- Installation list -->
  <% if (installations && installations.length > 0) { %>
  <div class="space-y-2">
    <% installations.forEach(function(inst) { %>
    <div class="mod-card">
      <div class="flex items-start justify-between gap-2 mb-1.5">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5 flex-wrap">
            <p class="text-xs font-medium text-neutral-900 dark:text-white truncate"><%= inst.projectName || inst.projectId %></p>
            <span class="status-badge <%= inst.status === 'completed' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400' : inst.status === 'failed' ? 'bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400' : inst.status === 'in_progress' ? 'bg-blue-50 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400' : 'bg-neutral-100 dark:bg-neutral-700/40 text-neutral-600 dark:text-neutral-400' %>">
              <%= inst.status %>
            </span>
          </div>
          <div class="flex items-center gap-1.5 text-[10px] text-neutral-400 dark:text-neutral-500 mt-0.5 flex-wrap">
            <span><%= inst.projectType %></span>
            <% if (inst.installedAt) { %>
            <span>&bull;</span>
            <span><%= new Date(inst.installedAt).toLocaleDateString() %></span>
            <% } %>
          </div>
        </div>
      </div>

      <% if (inst.error) { %>
      <p class="text-[10px] text-red-500 dark:text-red-400 mb-2 break-all"><%= inst.error %></p>
      <% } %>

      <div class="flex items-center gap-2 mt-2">
        <% if (inst.status === 'completed') { %>
        <a href="/modrinth/project/<%= inst.projectId %>" class="btn-primary flex-1">View</a>
        <button onclick="uninstallMod('<%= inst.projectId %>', '<%= (inst.projectName || inst.projectId).replace(/'/g, "\\'") %>', '<%= inst.projectType %>')" class="btn-danger-sm shrink-0">Uninstall</button>
        <% } else if (inst.status === 'in_progress') { %>
        <span class="text-[10px] text-blue-500 dark:text-blue-400">Installing...</span>
        <% } %>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>

  <!-- Empty state -->
  <div class="flex flex-col items-center justify-center mt-20 text-center">
    <svg class="h-14 w-14 text-neutral-200 dark:text-neutral-700 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
    <h2 class="text-sm font-medium text-neutral-800 dark:text-white mb-1">No mods installed</h2>
    <p class="text-xs text-neutral-500 mb-4">Browse Modrinth to install mods for this server.</p>
    <a href="/modrinth" class="btn-primary" style="width: auto; min-width: 140px;">Browse Modrinth</a>
  </div>
  <% } %>

  <!-- Credits -->
  <div class="text-center py-4">
    <p class="text-[10px] text-neutral-400 dark:text-neutral-600">Modrinth Store &bull; Powered by <a href="https://modrinth.com" target="_blank" class="text-emerald-600 dark:text-emerald-400">Modrinth</a></p>
  </div>

</div>

<%- include('./progress') %>
<%- include('../../../../../views/mobile/components/toast') %>

<script nonce="<%- nonce %>">
(function() {
  function getCsrf() {
    var m = document.querySelector('meta[name="csrf-token"]');
    return m ? m.content : null;
  }

  window.uninstallMod = async function(projectId, projectName, projectType) {
    if (!confirm('Remove ' + projectName + '?')) return;
    try {
      var h = { 'Content-Type': 'application/json' };
      var t = getCsrf();
      if (t) h['X-CSRF-Token'] = t;
      var res = await fetch('/modrinth/api/uninstall', {
        method: 'POST',
        headers: h,
        body: JSON.stringify({
          serverId: '<%= server.UUID %>',
          projectId: projectId,
          projectName: projectName,
          projectType: projectType
        })
      });
      var data = await res.json();
      if (data.success) {
        showToast('Removed ' + projectName, 'success');
        setTimeout(function() { location.reload(); }, 800);
      } else {
        showToast(data.error || 'Uninstall failed', 'error');
      }
    } catch(e) {
      showToast('Uninstall failed', 'error');
    }
  };
})();
</script>
