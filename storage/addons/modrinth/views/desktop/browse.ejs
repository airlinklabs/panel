<%- include('../components/header', { title: 'Modrinth Store', user: user }) %>

<main class="h-screen flex">
  <div class="w-60 h-full flex-shrink-0">
    <%- include('../components/template') %>
  </div>

  <div class="flex-1 flex flex-col overflow-hidden pt-16">

    <% if (settings && settings.showWarningBanner) { %>
    <div class="flex-shrink-0 bg-amber-500/10 border-b border-amber-500/20 px-6 py-2.5 flex items-center gap-3">
      <svg class="w-4 h-4 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-amber-400 font-medium text-sm"><%= settings.warningTitle %></span>
      <span class="text-amber-300/70 text-sm"><%= settings.warningMessage %></span>
    </div>
    <% } %>

    <!-- Search bar -->
    <div class="flex-shrink-0 border-b border-neutral-200/30 dark:border-white/5 px-6 py-4">
      <form method="GET" action="/modrinth">
        <div class="flex gap-2.5">
          <div class="relative flex-1">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input type="text" name="q" value="<%= query || '' %>"
              placeholder="Search mods, modpacks, plugins..."
              class="w-full pl-10 pr-4 py-2.5 bg-white/5 dark:bg-white/5 border border-neutral-200/30 dark:border-white/5 rounded-xl text-sm text-neutral-800 dark:text-white placeholder-neutral-400 focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-300/20 transition-colors">
          </div>
          <select name="type" class="px-3 py-2.5 bg-white/5 dark:bg-white/5 border border-neutral-200/30 dark:border-white/5 rounded-xl text-sm text-neutral-800 dark:text-white focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-300/20 transition-colors min-w-[130px]">
            <option value="all" <%= (type || 'all') === 'all' ? 'selected' : '' %>>All types</option>
            <option value="mod" <%= type === 'mod' ? 'selected' : '' %>>Mods</option>
            <option value="modpack" <%= type === 'modpack' ? 'selected' : '' %>>Modpacks</option>
            <option value="resourcepack" <%= type === 'resourcepack' ? 'selected' : '' %>>Resource Packs</option>
            <option value="shader" <%= type === 'shader' ? 'selected' : '' %>>Shaders</option>
            <option value="plugin" <%= type === 'plugin' ? 'selected' : '' %>>Plugins</option>
            <option value="datapack" <%= type === 'datapack' ? 'selected' : '' %>>Data Packs</option>
          </select>
          <select name="index" class="px-3 py-2.5 bg-white/5 dark:bg-white/5 border border-neutral-200/30 dark:border-white/5 rounded-xl text-sm text-neutral-800 dark:text-white focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-300/20 transition-colors min-w-[120px]">
            <option value="relevance" <%= (index || 'relevance') === 'relevance' ? 'selected' : '' %>>Relevance</option>
            <option value="downloads" <%= index === 'downloads' ? 'selected' : '' %>>Downloads</option>
            <option value="follows" <%= index === 'follows' ? 'selected' : '' %>>Follows</option>
            <option value="newest" <%= index === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="updated" <%= index === 'updated' ? 'selected' : '' %>>Updated</option>
          </select>
          <button type="submit" class="px-5 py-2.5 bg-neutral-800 dark:bg-white/10 hover:bg-neutral-700 dark:hover:bg-white/15 text-neutral-800 dark:text-white rounded-xl text-sm font-medium transition-colors">Search</button>
        </div>
      </form>
    </div>

    <!-- Results -->
    <div class="flex-1 overflow-y-auto no-scrollbar">
      <div class="px-6 py-5">

        <% if (results && results.hits && results.hits.length > 0) { %>
        <div class="flex items-center justify-between mb-5">
          <div>
            <% if (query) { %>
            <h2 class="text-base font-medium text-neutral-800 dark:text-white">Results for "<span class="text-neutral-500 dark:text-neutral-400"><%= query %></span>"</h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5"><%= totalHits %> results found</p>
            <% } else { %>
            <h2 class="text-base font-medium text-neutral-800 dark:text-white">Browse Modrinth</h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5"><%= totalHits %> projects</p>
            <% } %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
          <% results.hits.forEach(function(hit) { %>
          <a href="/modrinth/project/<%= hit.project_id %>"
            class="group block rounded-xl bg-white/8 dark:bg-white/5 border border-neutral-200/30 dark:border-white/5 p-4 hover:bg-neutral-100 dark:hover:bg-white/[0.08] transition-all duration-200">
            <div class="flex items-start gap-3">
              <% if (hit.icon_url) { %>
              <img src="<%= hit.icon_url %>" alt="" class="w-12 h-12 rounded-lg object-cover bg-neutral-200 dark:bg-neutral-700 shrink-0">
              <% } else { %>
              <div class="w-12 h-12 rounded-lg bg-neutral-200 dark:bg-neutral-700 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </div>
              <% } %>
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-medium text-neutral-800 dark:text-white truncate group-hover:text-neutral-900 dark:group-hover:text-white"><%= hit.title %></h3>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 truncate"><%= hit.author %></p>
              </div>
              <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-neutral-200/50 dark:bg-white/10 text-neutral-600 dark:text-neutral-400 shrink-0"><%= hit.project_type %></span>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-3 line-clamp-2"><%= hit.description %></p>
            <div class="flex items-center gap-4 mt-3 text-[11px] text-neutral-400 dark:text-neutral-500">
              <span class="flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <%= hit.downloads.toLocaleString() %>
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                <%= hit.follows %>
              </span>
              <% if (hit.categories && hit.categories.length > 0) { %>
              <span class="truncate"><%= hit.categories.slice(0, 3).join(', ') %></span>
              <% } %>
            </div>
          </a>
          <% }); %>
        </div>

        <!-- Pagination -->
        <% if (totalHits > 20) { %>
        <div class="flex items-center justify-center gap-2 mt-8">
          <% if (offset > 0) { %>
          <a href="?q=<%= query || '' %>&type=<%= type || 'all' %>&index=<%= index || 'relevance' %>&offset=<%= Math.max(0, offset - 20) %>"
            class="px-3 py-1.5 text-sm rounded-lg bg-white/5 dark:bg-white/5 border border-neutral-200/30 dark:border-white/5 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-white/10 transition">Previous</a>
          <% } %>
          <span class="text-xs text-neutral-500 dark:text-neutral-400">Page <%= Math.floor(offset / 20) + 1 %> of <%= Math.ceil(totalHits / 20) %></span>
          <% if (offset + 20 < totalHits) { %>
          <a href="?q=<%= query || '' %>&type=<%= type || 'all' %>&index=<%= index || 'relevance' %>&offset=<%= offset + 20 %>"
            class="px-3 py-1.5 text-sm rounded-lg bg-white/5 dark:bg-white/5 border border-neutral-200/30 dark:border-white/5 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-white/10 transition">Next</a>
          <% } %>
        </div>
        <% } %>

        <% } else if (query) { %>
        <div class="text-center py-20">
          <svg class="w-12 h-12 text-neutral-300 dark:text-neutral-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">No results for "<span class="text-neutral-700 dark:text-neutral-300"><%= query %></span>"</p>
          <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">Try different keywords or check your filters</p>
        </div>
        <% } else { %>
        <div class="text-center py-20">
          <svg class="w-12 h-12 text-neutral-300 dark:text-neutral-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">Search for mods, modpacks, and more</p>
          <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">Powered by Modrinth</p>
        </div>
        <% } %>

      </div>
    </div>
  </div>
</main>

<%- include('../components/footer') %>
