<%- include('../layouts/auth', { title: t('login') }) %>

<div class="al-auth">
  <div class="al-auth-form">
    <div class="mx-auto w-full max-w-sm lg:w-96">
      <div>
        <img class="al-auth-logo"
          src="<%= (settings && settings.logo && settings.logo.startsWith('/')) ? settings.logo : '/' + ((settings && settings.logo) || 'favicon.ico') %>"
          alt="<%= (settings && settings.title) || 'Airlink' %>" width="48" height="48">
        <h1 class="al-auth-title mt-6"><%= t('loginTitle') %></h1>
        <p class="al-auth-subtitle"><%= t('loginSubtitle') %></p>
      </div>

      <% if (req.query.err) { %>
      <%
        /* Two of these codes are good news — the mail was sent, or the
           password changed. They render as a success notice, not an error. */
        var isSuccess = ['reset_email_sent', 'password_reset'].includes(req.query.err);
      %>
      <div class="al-auth-error <%= isSuccess ? 'al-auth-notice--success' : '' %> mt-6"
        role="alert" aria-live="assertive">
        <span class="mt-0.5 shrink-0">
          <%- icon(isSuccess ? 'check-circle' : 'alert-triangle', {
            class: 'h-5 w-5',
            style: isSuccess ? 'color:var(--theme-success)' : 'color:var(--theme-danger)'
          }) %>
        </span>
        <div>
          <p class="al-auth-error-title"<%= isSuccess ? ' style="color:var(--theme-success);"' : '' %>>
            <% if (req.query.err === 'missing_credentials') { %><%= t('errorTitleMissingCredentials') %>
            <% } else if (['invalid_credentials','incorrect_password','user_not_found'].includes(req.query.err)) { %><%= t('errorTitleInvalidCredentials') %>
            <% } else if (req.query.err === 'account_locked') { %><%= t('errorTitleAccountLocked') %>
            <% } else if (req.query.err === 'reset_email_sent') { %><%= t('errorTitleResetEmailSent') %>
            <% } else if (req.query.err === 'password_reset') { %><%= t('errorTitlePasswordReset') %>
            <% } else if (req.query.err === 'registration_disabled') { %><%= t('errorTitleRegistrationDisabled') %>
            <% } else { %><%= t('errorTitleGeneric') %><% } %>
          </p>
          <p class="al-auth-error-body"<%= isSuccess ? ' style="color:var(--theme-success);"' : '' %>>
            <% if (req.query.err === 'missing_credentials') { %><%= t('errorMissingCredentials') %>
            <% } else if (['invalid_credentials','incorrect_password','user_not_found'].includes(req.query.err)) { %><%= t('errorInvalidCredentials') %>
            <% } else if (req.query.err === 'account_locked') { %><%= t('errorAccountLocked', { wait: req.query.wait || 'a few' }) %>
            <% } else if (req.query.err === 'reset_email_sent') { %><%= t('errorResetEmailSent') %>
            <% } else if (req.query.err === 'password_reset') { %><%= t('errorPasswordReset') %>
            <% } else if (req.query.err === 'registration_disabled') { %><%= t('errorRegistrationDisabled') %>
            <% } else { %><%= t('errorGeneric') %><% } %>
          </p>
        </div>
      </div>
      <% } %>

      <form method="POST" action="/login" class="mt-8 space-y-6">
        <%- include('../partials/csrf') %>

        <%- include('../partials/ui/form-field', {
          type: 'text',
          name: 'identifier',
          label: t('fieldEmailOrUsername'),
          id: 'login-identifier',
          placeholder: t('fieldEmailOrUsernamePlaceholder'),
          required: true,
          autocomplete: 'username'
        }) %>

        <%- include('../partials/ui/form-field', {
          type: 'password',
          name: 'password',
          label: t('fieldPassword'),
          id: 'login-password',
          placeholder: t('fieldPasswordPlaceholder'),
          required: true,
          autocomplete: 'current-password'
        }) %>

        <div class="flex items-center justify-between gap-3">
          <%- include('../partials/ui/form-field', {
            type: 'checkbox',
            name: 'remember-me',
            id: 'remember',
            label: t('rememberMe'),
            checked: false
          }) %>
          <a class="text-sm transition-colors hover:underline" style="color:var(--theme-text-muted); text-underline-offset:3px;" href="/forgot-password">
            <%= t('forgotPassword') %>
          </a>
        </div>

        <%- include('../partials/ui/button', {
          type: 'submit',
          label: t('login'),
          variant: 'primary',
          size: 'lg',
          cls: 'w-full'
        }) %>
      </form>

      <p class="mt-6 text-sm" style="color:var(--theme-text-muted);">
        <%= t('noAccount') %>
        <a href="/register" class="font-medium hover:underline" style="color:var(--theme-primary); text-underline-offset:3px;">
          <%= t('register') %>
        </a>
      </p>
    </div>
  </div>

  <%- include('../partials/auth-visual', { wallpaper: settings.loginWallpaper, fallback: '/assets/auth/login.jpg' }) %>
</div>

<%- include('../layouts/auth-footer') %>
