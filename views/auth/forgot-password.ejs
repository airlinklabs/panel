<%- include('../components/auth-header', { title: 'Forgot password' }) %>

<%- include('../components/auth-styles') %>
<style>
  .auth-image {
    background: url('<%= settings.loginWallpaper || "/assets/wallpapers/login.jpeg" %>') center/cover no-repeat;
  }
  .auth-link { font-size: 14px; color: var(--theme-text-link); text-align: center; display: block; margin-top: 20px; text-decoration: none; }
  .auth-link:hover { color: var(--theme-text-strong); }
</style>

<div class="auth-split">
  <div class="auth-panel" id="authPanel">

    <div class="mb-8">
      <% if (settings.logo) { %>
      <img src="<%= settings.logo %>" alt="<%= settings.title %> logo" class="h-10 w-10 rounded-xl object-contain mb-5">
      <% } %>
      <h1 class="text-2xl font-semibold" style="color:var(--theme-text-strong)">Forgot password</h1>
      <p class="text-sm mt-1" style="color:var(--theme-text-muted)">We'll email you a reset link.</p>
    </div>

    <% if (req.query.err === 'rate_limited') { %>
    <div class="rounded-xl px-4 py-3 mb-5" style="background:var(--theme-danger-bg);border:1px solid var(--theme-danger)">
      <p class="text-sm font-medium" style="color:var(--theme-danger)">Too many requests. Wait an hour and try again.</p>
    </div>
    <% } %>

    <form id="forgotForm" method="POST" action="/forgot-password" novalidate>
      <%- include('../components/csrf') %>
      <div class="space-y-4">
        <div>
          <label class="auth-label" for="email">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email"
            required spellcheck="false" autocapitalize="none"
            class="auth-input" placeholder="you@example.com">
        </div>
        <button type="submit" class="auth-submit" id="submitBtn">
          <span class="btn-label">Send reset link</span>
        </button>
      </div>
    </form>

    <a href="/login" class="auth-link">Back to sign in</a>

  </div>
  <div class="auth-image"></div>
</div>

<script nonce="<%- nonce %>">
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      document.getElementById('authPanel').classList.add('visible');
    });
  });
</script>

<%- include('../components/footer') %>
