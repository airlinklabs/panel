<%- include('../components/auth-header', { title: 'Forgot password' }) %>

<style>
  ::-webkit-scrollbar { display: none; }
  body, html { height: 100%; margin: 0; }

  .auth-split { display: flex; min-height: 100vh; }
  .auth-panel {
    width: 100%; max-width: 420px; flex-shrink: 0;
    display: flex; flex-direction: column; justify-content: center;
    padding: 48px 40px;
    background: #fff;
    border-right: 1px solid #e5e5e5;
    position: relative; z-index: 1;
  }
  html.dark .auth-panel {
    background: #111111;
    border-right-color: rgba(255,255,255,0.06);
  }
  .auth-image {
    flex: 1;
    background: url('<%= settings.loginWallpaper || "/assets/wallpapers/login.jpeg" %>') center/cover no-repeat;
  }

  @media (max-width: 768px) {
    .auth-split { position: relative; display: block; min-height: 100vh; }
    .auth-image {
      position: fixed;
      inset: 0;
      display: block;
      z-index: 0;
    }
    .auth-panel {
      position: relative;
      z-index: 1;
      max-width: 100%;
      border-right: none;
      padding: 40px 24px;
      min-height: 100vh;
      justify-content: center;
      background: rgba(255, 255, 255, 0.95);
    }
    html.dark .auth-panel {
      background: rgba(17, 17, 17, 0.95);
    }
  }

  .auth-input {
    width: 100%; padding: 10px 14px; border-radius: 10px;
    border: 1px solid #e5e5e5; background: #f9fafb;
    font-size: 14px; color: #171717; outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-sizing: border-box; font-family: inherit;
  }
  html.dark .auth-input {
    background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.08); color: #e5e5e5;
  }
  .auth-input:focus {
    border-color: #a3a3a3; box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
  }
  html.dark .auth-input:focus {
    border-color: rgba(255,255,255,0.08); box-shadow: 0 0 0 3px rgba(255,255,255,0.08);
  }
  .auth-input::placeholder { color: #a3a3a3; }
  html.dark .auth-input::placeholder { color: #525252; }

  .auth-label { display: block; font-size: 13px; font-weight: 500; color: #525252; margin-bottom: 6px; }
  html.dark .auth-label { color: #a3a3a3; }

  .auth-submit {
    width: 100%; padding: 11px; border-radius: 10px;
    background: #171717; color: white; font-size: 14px; font-weight: 500;
    border: none; cursor: pointer; transition: background 0.15s;
    font-family: inherit;
  }
  html.dark .auth-submit { background: white; color: #0a0a0a; }
  .auth-submit:hover:not(:disabled) { background: #404040; }
  html.dark .auth-submit:hover:not(:disabled) { background: #e5e5e5; }

  .auth-link { font-size: 14px; color: #a3a3a3; text-align: center; display: block; margin-top: 20px; text-decoration: none; }
  .auth-link:hover { color: #737373; }
  html.dark .auth-link:hover { color: #d4d4d4; }

  .auth-panel { opacity: 0; transform: translateX(-12px); transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16,1,0.3,1); transition-delay: 30ms; will-change: opacity, transform; }
  .auth-panel.visible { opacity: 1; transform: translateX(0); }
</style>

<div class="auth-split">
  <div class="auth-panel" id="authPanel">

    <div class="mb-8">
      <% if (settings.logo) { %>
      <img src="<%= settings.logo %>" alt="" class="h-10 w-10 rounded-xl object-contain mb-5">
      <% } %>
      <h1 class="text-2xl font-semibold text-neutral-900 dark:text-white">Forgot password</h1>
      <p class="text-sm text-neutral-500 mt-1">We'll email you a reset link.</p>
    </div>

    <% if (req.query.err === 'rate_limited') { %>
    <div class="rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-5">
      <p class="text-sm font-medium text-red-700 dark:text-red-400">Too many requests. Wait an hour and try again.</p>
    </div>
    <% } %>

    <form id="forgotForm" method="POST" action="/forgot-password" novalidate>
      <%- include('../components/csrf') %>
      <div class="space-y-4">
        <div>
          <label class="auth-label" for="email">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email"
            required spellcheck="false" autocapitalize="none"
            class="auth-input" placeholder="you@example.com">
        </div>
        <button type="submit" class="auth-submit" id="submitBtn">
          <span class="btn-label">Send reset link</span>
        </button>
      </div>
    </form>

    <a href="/login" class="auth-link">Back to sign in</a>

  </div>
  <div class="auth-image"></div>
</div>

<script nonce="<%- nonce %>">
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      document.getElementById('authPanel').classList.add('visible');
    });
  });
</script>

<%- include('../components/footer') %>
