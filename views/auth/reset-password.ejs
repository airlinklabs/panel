<%- include('../layouts/auth', { title: t('resetPassword') }) %>

<div class="al-auth">
  <div class="al-auth-form">
    <div class="mx-auto w-full max-w-sm lg:w-96">
      <div>
        <img class="al-auth-logo"
          src="<%= (settings && settings.logo && settings.logo.startsWith('/')) ? settings.logo : '/' + ((settings && settings.logo) || 'favicon.ico') %>"
          alt="<%= (settings && settings.title) || 'Airlink' %>" width="48" height="48">
        <h1 class="al-auth-title mt-6"><%= t('resetPasswordTitle') %></h1>
        <p class="al-auth-subtitle"><%= t('resetPasswordSubtitle') %></p>
      </div>

      <% if (typeof invalidToken !== 'undefined' && invalidToken) { %>
      <div class="al-auth-error mt-6" role="alert" aria-live="assertive">
        <span class="mt-0.5 shrink-0"><%- icon('alert-triangle', { class: 'h-5 w-5', style: 'color:var(--theme-danger)' }) %></span>
        <div>
          <p class="al-auth-error-title"><%= t('errorTitleInvalidToken') %></p>
          <p class="al-auth-error-body"><%= t('errorInvalidToken') %></p>
        </div>
      </div>
      <p class="mt-4 text-sm">
        <a href="/forgot-password" class="inline-flex items-center gap-1 font-medium hover:underline" style="color:var(--theme-primary); text-underline-offset:3px;">
          <%- icon('arrow-left', { class: 'h-3.5 w-3.5', 'aria-hidden': 'true' }) %>
          <%= t('forgotPassword') %>
        </a>
      </p>

      <% } else { %>

      <% if (req.query.err) { %>
      <div class="al-auth-error mt-6" role="alert" aria-live="assertive">
        <span class="mt-0.5 shrink-0"><%- icon('alert-triangle', { class: 'h-5 w-5', style: 'color:var(--theme-danger)' }) %></span>
        <div>
          <p class="al-auth-error-title">
            <% if (req.query.err === 'mismatch') { %><%= t('errorTitlePasswordMismatch') %>
            <% } else if (req.query.err === 'weak') { %><%= t('errorTitleWeakPassword') %>
            <% } else if (req.query.err === 'missing') { %><%= t('errorTitleAllFieldsRequired') %>
            <% } else { %><%= t('errorTitleGeneric') %><% } %>
          </p>
          <p class="al-auth-error-body">
            <% if (req.query.err === 'mismatch') { %><%= t('errorPasswordMismatch') %>
            <% } else if (req.query.err === 'weak') { %><%= t('errorWeakPassword') %>
            <% } else if (req.query.err === 'missing') { %><%= t('errorAllFieldsRequired') %>
            <% } else { %><%= t('errorGeneric') %><% } %>
          </p>
        </div>
      </div>
      <% } %>

      <% if (typeof token !== 'undefined' && token) { %>
      <form method="POST" action="/reset-password" class="mt-8 space-y-6">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="token" value="<%= token %>">

        <div>
          <%- include('../partials/ui/form-field', {
            type: 'password',
            name: 'password',
            label: t('fieldNewPassword'),
            id: 'reset-password',
            placeholder: t('fieldNewPasswordPlaceholder'),
            required: true,
            autocomplete: 'new-password',
            helpText: t('passwordHelp')
          }) %>
          <ul class="al-pw-criteria" id="password-criteria">
            <li data-met="false" data-criterion="length">
              <%- icon('circle', { class: 'h-3 w-3 shrink-0', 'aria-hidden': 'true' }) %>
              <span><%= t('passwordCriteriaLength') %></span>
            </li>
            <li data-met="false" data-criterion="letter">
              <%- icon('circle', { class: 'h-3 w-3 shrink-0', 'aria-hidden': 'true' }) %>
              <span><%= t('passwordCriteriaLetter') %></span>
            </li>
            <li data-met="false" data-criterion="number">
              <%- icon('circle', { class: 'h-3 w-3 shrink-0', 'aria-hidden': 'true' }) %>
              <span><%= t('passwordCriteriaNumber') %></span>
            </li>
          </ul>
        </div>

        <%- include('../partials/ui/form-field', {
          type: 'password',
          name: 'passwordConfirm',
          label: t('fieldConfirmPassword'),
          id: 'reset-password-confirm',
          placeholder: t('fieldConfirmPasswordPlaceholder'),
          required: true,
          autocomplete: 'new-password'
        }) %>

        <%- include('../partials/ui/button', {
          type: 'submit',
          label: t('resetPasswordButton'),
          variant: 'primary',
          size: 'lg',
          cls: 'w-full'
        }) %>
      </form>
      <% } %>

      <p class="mt-6 text-sm" style="color:var(--theme-text-muted);">
        <a href="/login" class="inline-flex items-center gap-1 font-medium hover:underline" style="color:var(--theme-primary); text-underline-offset:3px;">
          <%- icon('arrow-left', { class: 'h-3.5 w-3.5', 'aria-hidden': 'true' }) %>
          <%= t('backToLogin') %>
        </a>
      </p>

      <% } %>
    </div>
  </div>

  <%- include('../partials/auth-visual', { wallpaper: settings && settings.loginWallpaper, fallback: '/assets/auth/login.jpg' }) %>
</div>

<script nonce="<%- nonce %>">
  (function () {
    var input = document.getElementById('reset-password');
    var list = document.getElementById('password-criteria');
    if (!input || !list) { return; }
    var checks = {
      length: function (v) { return v.length >= 8; },
      letter: function (v) { return /[A-Za-z]/.test(v); },
      number: function (v) { return /\d/.test(v); }
    };
    var items = list.querySelectorAll('li');
    var update = function () {
      var value = input.value;
      items.forEach(function (li) {
        li.dataset.met = checks[li.dataset.criterion](value) ? 'true' : 'false';
      });
    };
    input.addEventListener('input', update);
    update();
  })();
</script>

<%- include('../layouts/auth-footer') %>
