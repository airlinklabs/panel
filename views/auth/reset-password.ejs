<%- include('../components/auth-header', { title: 'Reset password' }) %>

<style>
  ::-webkit-scrollbar { display: none; }
  body, html { height: 100%; margin: 0; }

  .auth-split { display: flex; min-height: 100vh; }
  .auth-panel {
    width: 100%; max-width: 420px; flex-shrink: 0;
    display: flex; flex-direction: column; justify-content: center;
    padding: 48px 40px;
    background: #fff;
    border-right: 1px solid #e5e5e5;
    position: relative; z-index: 1;
  }
  html.dark .auth-panel {
    background: #111111;
    border-right-color: rgba(255,255,255,0.06);
  }
  .auth-image {
    flex: 1;
    background: url('<%= settings.loginWallpaper || "/assets/wallpapers/login.jpeg" %>') center/cover no-repeat;
  }

  @media (max-width: 768px) {
    .auth-split { position: relative; display: block; min-height: 100vh; }
    .auth-image {
      position: fixed;
      inset: 0;
      display: block;
      z-index: 0;
    }
    .auth-panel {
      position: relative;
      z-index: 1;
      max-width: 100%;
      border-right: none;
      padding: 40px 24px;
      min-height: 100vh;
      justify-content: center;
      background: rgba(255, 255, 255, 0.95);
    }
    html.dark .auth-panel {
      background: rgba(17, 17, 17, 0.95);
    }
  }

  .auth-input {
    width: 100%; padding: 10px 14px; border-radius: 10px;
    border: 1px solid #e5e5e5; background: #f9fafb;
    font-size: 14px; color: #171717; outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-sizing: border-box; font-family: inherit;
  }
  html.dark .auth-input {
    background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.08); color: #e5e5e5;
  }
  .auth-input:focus {
    border-color: #a3a3a3; box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
  }
  html.dark .auth-input:focus {
    border-color: rgba(255,255,255,0.08); box-shadow: 0 0 0 3px rgba(255,255,255,0.08);
  }
  .auth-input::placeholder { color: #a3a3a3; }
  html.dark .auth-input::placeholder { color: #525252; }

  .auth-label { display: block; font-size: 13px; font-weight: 500; color: #525252; margin-bottom: 6px; }
  html.dark .auth-label { color: #a3a3a3; }

  .auth-submit {
    width: 100%; padding: 11px; border-radius: 10px;
    background: #171717; color: white; font-size: 14px; font-weight: 500;
    border: none; cursor: pointer; transition: background 0.15s;
    font-family: inherit;
  }
  html.dark .auth-submit { background: white; color: #0a0a0a; }
  .auth-submit:hover:not(:disabled) { background: #404040; }
  html.dark .auth-submit:hover:not(:disabled) { background: #e5e5e5; }

  .pw-wrapper { position: relative; }
  .pw-toggle {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer; padding: 0; color: #a3a3a3; line-height: 0;
  }
  .pw-toggle:hover { color: #737373; }
  html.dark .pw-toggle:hover { color: #d4d4d4; }

  .auth-link { font-size: 14px; color: #a3a3a3; text-align: center; display: block; margin-top: 20px; text-decoration: none; }
  .auth-link:hover { color: #737373; }
  html.dark .auth-link:hover { color: #d4d4d4; }

  .auth-panel { opacity: 0; transform: translateX(-12px); transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16,1,0.3,1); transition-delay: 30ms; will-change: opacity, transform; }
  .auth-panel.visible { opacity: 1; transform: translateX(0); }
</style>

<div class="auth-split">
  <div class="auth-panel" id="authPanel">

    <div class="mb-8">
      <% if (settings.logo) { %>
      <img src="<%= settings.logo %>" alt="" class="h-10 w-10 rounded-xl object-contain mb-5">
      <% } %>
      <h1 class="text-2xl font-semibold text-neutral-900 dark:text-white">Reset password</h1>
      <p class="text-sm text-neutral-500 mt-1">Choose a new password for your account.</p>
    </div>

    <% if (invalidToken) { %>
    <div class="rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-5">
      <p class="text-sm font-medium text-red-700 dark:text-red-400">This reset link is invalid or has expired. Request a new one.</p>
    </div>
    <% } else { %>
      <% if (req.query.err === 'mismatch') { %>
      <div class="rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-5">
        <p class="text-sm font-medium text-red-700 dark:text-red-400">Passwords do not match.</p>
      </div>
      <% } else if (req.query.err === 'weak') { %>
      <div class="rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-5">
        <p class="text-sm font-medium text-red-700 dark:text-red-400">Password must be at least 8 characters with letters and numbers.</p>
      </div>
      <% } else if (req.query.err === 'expired') { %>
      <div class="rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-5">
        <p class="text-sm font-medium text-red-700 dark:text-red-400">This reset link is invalid or has expired. Request a new one.</p>
      </div>
      <% } else if (req.query.err === 'error') { %>
      <div class="rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-5">
        <p class="text-sm font-medium text-red-700 dark:text-red-400">Something went wrong. Try again.</p>
      </div>
      <% } %>

      <form id="resetForm" method="POST" action="/reset-password" autocomplete="off" novalidate>
        <%- include('../components/csrf') %>
        <input type="hidden" name="token" value="<%= token %>">
        <div class="space-y-4">
          <div>
            <label class="auth-label" for="password">New password</label>
            <div class="pw-wrapper">
              <input id="password" name="password" type="password" autocomplete="new-password"
                required class="auth-input" placeholder="At least 8 characters" style="padding-right:40px">
              <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password">
                <span id="eyeIcon"><%- icon('eye', { width: 16, height: 16 }) %></span>
              </button>
            </div>
          </div>
          <div>
            <label class="auth-label" for="confirmPassword">Confirm password</label>
            <div class="pw-wrapper">
              <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password"
                required class="auth-input" placeholder="Repeat password" style="padding-right:40px">
            </div>
          </div>
          <button type="submit" class="auth-submit" id="submitBtn">
            <span class="btn-label">Update password</span>
          </button>
        </div>
      </form>
    <% } %>

    <a href="/login" class="auth-link">Back to sign in</a>

  </div>
  <div class="auth-image"></div>
</div>

<script nonce="<%- nonce %>">
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      document.getElementById('authPanel').classList.add('visible');
    });
  });

  var pwToggle = document.getElementById('pwToggle');
  var pwInput = document.getElementById('password');
  if (pwToggle && pwInput) {
    pwToggle.addEventListener('click', function () {
      var show = pwInput.type === 'password';
      pwInput.type = show ? 'text' : 'password';
      document.getElementById('eyeIcon').innerHTML = show
        ? '<path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06l14.5 14.5a.75.75 0 1 0 1.06-1.06l-1.745-1.745a10.029 10.029 0 0 0 3.3-4.38 1.651 1.651 0 0 0 0-1.185A10.004 10.004 0 0 0 9.999 3a9.956 9.956 0 0 0-4.744 1.194L3.28 2.22ZM7.752 6.69l1.092 1.092a2.5 2.5 0 0 1 3.374 3.373l1.091 1.092a4 4 0 0 0-5.557-5.557Z" clip-rule="evenodd"/><path d="M10.748 13.93l2.523 2.524a10.065 10.065 0 0 1-5.27 0l-1.978-1.978a4 4 0 0 0 .005-5.53l-.738-.738A8.003 8.003 0 0 0 1.834 9.587a1.651 1.651 0 0 0 0 1.186A10.004 10.004 0 0 0 10 17c1.09 0 2.14-.175 3.124-.497l-2.376-2.573Z"/>'
        : '<path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/>';
  });
</script>

<%- include('../components/footer') %>
