
<button @click="openSftpModal()" type="button" aria-label="Open SFTP access"
  class="border block rounded-xl hover:opacity-90 px-3 py-2 text-center text-sm font-medium shadow-lg transition duration-300 focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none" style="background:var(--theme-btn-secondary-bg);border-color:var(--theme-btn-secondary-border);color:var(--theme-btn-secondary-text);">
  <%- icon('lock', { class: 'size-4 inline-flex mr-1 mb-0.5' }) %>
  SFTP
</button>


<div id="sftpModal" class="al-sheet-overlay fixed inset-0 z-50 hidden items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="sftpModalTitle">

  
  <div @click="closeSftpModal()" class="absolute inset-0 bg-transparent" aria-hidden="true"></div>

  
  <div class="al-sftp-panel al-sheet-panel relative rounded-2xl shadow-xl w-full max-w-md mx-4" style="background:var(--theme-bg-card); border-color:var(--theme-border);">

    
    <div class="al-sheet-header" style="border-color:var(--theme-border);">
        <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-9 h-9 rounded-lg" style="background:var(--theme-bg-secondary);">
          <%- icon('lock', { class: 'size-4', style: 'color:var(--theme-text-muted);' }) %>
        </div>
        <div>
          <h2 id="sftpModalTitle" class="text-sm font-semibold leading-none" style="color:var(--theme-text-strong);">SFTP Access</h2>
          <p class="text-xs mt-0.5" style="color:var(--theme-text-muted);">Connect using any SFTP client</p>
        </div>
        </div>
      <button type="button" @click="closeSftpModal()" aria-label="Close" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" style="color:var(--theme-text-muted);">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>

    
    <div id="sftpLoading" class="flex items-center gap-3 px-6 py-8">
      <span class="animate-spin size-4 shrink-0" style="color:var(--theme-text-muted);"><%- icon('loader', { class: 'size-4' }) %></span>
      <span class="text-sm" style="color:var(--theme-text-muted);">Fetching your keys…</span>
    </div>

    
    <div id="sftpError" class="hidden px-6 py-4">
      <div class="flex items-start gap-3 p-3 rounded-lg mb-4" style="background:var(--theme-danger-bg);border:1px solid var(--theme-danger);">
        <%- icon('triangle-alert', { class: 'size-4 shrink-0 mt-0.5', style: 'color:var(--theme-danger);' }) %>
        <div>
          <p id="sftpErrorTitle" class="text-xs font-medium" style="color:var(--theme-danger);">Couldn't load credentials — maybe generate a fresh set?</p>
          <p id="sftpErrorMsg" class="text-xs mt-0.5" style="color:var(--theme-danger);opacity:0.7;"></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" @click="generateSftpCredentials()" class="px-3 py-1.5 rounded-lg text-xs font-medium transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none border inline-flex items-center gap-1.5" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong);border-color:var(--theme-border);"><%- icon('key-round', { class: 'size-3', strokeWidth: 1.5 }) %>Generate credentials</button>
        <button type="button" @click="closeSftpModal()" class="px-3 py-1.5 rounded-lg text-xs font-medium transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none hover:opacity-80 inline-flex items-center gap-1.5" style="color:var(--theme-text-muted);"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>Close</button>
      </div>
    </div>

    
    <div id="sftpCredentials" class="hidden">
      <div class="px-6 py-3 space-y-1">

        
        <div class="flex items-center gap-3 py-2">
          <span class="text-xs font-medium w-16 shrink-0" style="color:var(--theme-text-muted);">Host</span>
          <span id="sftpValHost" class="text-xs flex-1 truncate font-mono" style="color:var(--theme-text);"></span>
          <button type="button" @click="sftpCopy('sftpValHost')" aria-label="Copy host" class="copy-btn shrink-0 flex items-center justify-center w-9 h-9 rounded-lg transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted);">
            <%- icon('copy', { class: 'size-3', strokeWidth: 2 }) %>
          </button>
        </div>
        <div class="h-px" style="background:var(--theme-border);"></div>

        
        <div class="flex items-center gap-3 py-2">
          <span class="text-xs font-medium w-16 shrink-0" style="color:var(--theme-text-muted);">Port</span>
          <span id="sftpValPort" class="text-xs flex-1 font-mono" style="color:var(--theme-text);"></span>
          <button type="button" @click="sftpCopy('sftpValPort')" aria-label="Copy port" class="copy-btn shrink-0 flex items-center justify-center w-9 h-9 rounded-lg transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted);">
            <%- icon('copy', { class: 'size-3', strokeWidth: 2 }) %>
          </button>
        </div>
        <div class="h-px" style="background:var(--theme-border);"></div>

        
        <div class="flex items-center gap-3 py-2">
          <span class="text-xs font-medium w-16 shrink-0" style="color:var(--theme-text-muted);">Username</span>
          <span id="sftpValUser" class="text-xs flex-1 truncate font-mono" style="color:var(--theme-text);"></span>
          <button type="button" @click="sftpCopy('sftpValUser')" aria-label="Copy username" class="copy-btn shrink-0 flex items-center justify-center w-9 h-9 rounded-lg transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted);">
            <%- icon('copy', { class: 'size-3', strokeWidth: 2 }) %>
          </button>
        </div>
        <div class="h-px" style="background:var(--theme-border);"></div>

        
        <div class="flex items-center gap-3 py-2">
          <span class="text-xs font-medium w-16 shrink-0" style="color:var(--theme-text-muted);">Password</span>
          <span id="sftpValPass" class="text-xs flex-1 truncate font-mono blur-sm transition-all duration-200 cursor-default select-all sftp-password" style="color:var(--theme-text);" title="Hover or tap to reveal"></span>
          <button type="button" @click="sftpCopy('sftpValPass')" aria-label="Copy password" class="copy-btn shrink-0 flex items-center justify-center w-9 h-9 rounded-lg transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted);">
            <%- icon('copy', { class: 'size-3', strokeWidth: 2 }) %>
          </button>
        </div>
        <div class="h-px" style="background:var(--theme-border);"></div>

        
        <div class="flex items-center gap-3 py-2" id="sftpExpiryRow">
          <span class="text-xs font-medium w-16 shrink-0" style="color:var(--theme-text-muted);">Expires</span>
          <span id="sftpValExpiry" class="text-xs flex-1 font-mono" style="color:var(--theme-text);"></span>
        </div>

      </div>

      
      <div class="al-sheet-footer" style="border-color:var(--theme-border);">
        <button type="button" @click="generateSftpCredentials()" id="sftpRegenBtn" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none disabled:opacity-40 inline-flex items-center gap-1.5" style="background:var(--theme-warning);color:var(--theme-bg);"><%- icon('refresh-cw', { class: 'size-3', strokeWidth: 1.5 }) %>Regenerate</button>
        <button type="button" @click="revokeSftpCredentials()" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none inline-flex items-center gap-1.5" style="background:var(--theme-danger);color:var(--theme-btn-danger-text);"><%- icon('trash-2', { class: 'size-3', strokeWidth: 1.5 }) %>Revoke</button>
      </div>
    </div>

  </div>
</div>

<style>
/* Desktop: hover to reveal. Touch: tap to toggle via JS */
@media (hover: hover) {
  .sftp-password:hover { filter: blur(0); }
}
.copy-btn:hover { background: var(--theme-bg-input); color: var(--theme-text-strong); }
.copy-btn:active { opacity: 0.7; }
</style>

<script nonce="<%- nonce %>">
(function () {
  const SERVER_ID = '<%= server.UUID %>';
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
  let sftpPlainPassword = null;
  let sftpExpired = false;
  let lastFocusedElement = null;

  function trapFocus(modal, e) {
    if (e.key !== 'Tab') return;
    const focusable = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  window.openSftpModal = function () {
    const modal = document.getElementById('sftpModal');
    const panel = modal.querySelector('.al-sftp-panel');
    lastFocusedElement = document.activeElement;
    if (window.Animate) Animate.openModal(modal, panel);
    else { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    loadSftpCredentials();
    // Focus first focusable element
    setTimeout(function() {
      const closeBtn = modal.querySelector('button[aria-label="Close"]');
      if (closeBtn) closeBtn.focus();
    }, 0);
    // Add keyboard handlers
    modal._keydownHandler = function(e) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeSftpModal();
        return;
      }
      trapFocus(modal, e);
    };
    document.addEventListener('keydown', modal._keydownHandler);
  };

  window.closeSftpModal = function () {
    const modal = document.getElementById('sftpModal');
    const panel = modal.querySelector('.al-sftp-panel');
    // Remove keyboard handler
    if (modal._keydownHandler) {
      document.removeEventListener('keydown', modal._keydownHandler);
      modal._keydownHandler = null;
    }
    const done = function () {
      modal.classList.add('hidden'); modal.classList.remove('flex');
      restoreFocus();
    };
    if (window.Animate && panel) Animate.closeModal(modal, panel, done);
    else done();
  };

  function restoreFocus() {
    if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
      lastFocusedElement.focus();
      lastFocusedElement = null;
    }
  }

  function showSftpState(state) {
    document.getElementById('sftpLoading').classList.toggle('hidden', state !== 'loading');
    document.getElementById('sftpError').classList.toggle('hidden', state !== 'error');
    document.getElementById('sftpCredentials').classList.toggle('hidden', state !== 'credentials');
  }

  function fillCredentials(data) {
    if (data.password) {
      sftpPlainPassword = data.password;
    }

    document.getElementById('sftpValHost').textContent = data.host;
    document.getElementById('sftpValPort').textContent = data.port;
    document.getElementById('sftpValUser').textContent = data.username;
    document.getElementById('sftpValPass').textContent = data.password || sftpPlainPassword || 'Regenerate to view';
    renderExpiry(data.expiresAt);
    showSftpState('credentials');
  }

  function renderExpiry(expiresAt) {
    const row = document.getElementById('sftpExpiryRow');
    const val = document.getElementById('sftpValExpiry');
    if (!row || !val) return;
    if (!expiresAt) {
      row.classList.add('hidden');
      setCredentialsLocked(false);
      return;
    }
    row.classList.remove('hidden');
    const ts = new Date(expiresAt).getTime();
    if (isNaN(ts)) {
      val.textContent = 'unknown';
      val.style.color = 'var(--theme-text)';
      setCredentialsLocked(false);
      return;
    }
    if (ts <= Date.now()) {
      sftpExpired = true;
      val.textContent = 'expired';
      val.style.color = 'var(--theme-danger)';
    } else {
      sftpExpired = false;
      val.style.color = 'var(--theme-text)';
      const ms = ts - Date.now();
      const days = Math.floor(ms / 86400000);
      const hours = Math.floor((ms % 86400000) / 3600000);
      const mins = Math.floor((ms % 3600000) / 60000);
      val.textContent = days > 0 ? days + 'd ' + hours + 'h ' + mins + 'm' : hours + 'h ' + mins + 'm';
    }
    setCredentialsLocked(sftpExpired);
  }

  function setCredentialsLocked(locked) {
    const modal = document.getElementById('sftpModal');
    modal.querySelectorAll('.copy-btn').forEach(function (btn) {
      btn.disabled = locked;
      btn.classList.toggle('opacity-40', locked);
    });
    const passEl = document.getElementById('sftpValPass');
    if (passEl) {
      passEl.classList.toggle('blur-sm', locked);
      passEl.classList.remove('blur-none');
    }
  }

  function loadSftpCredentials() {
    showSftpState('loading');
    // GET intentionally has no password — never resurface a stale one from a
    // previous generate on a fresh load; force a regenerate prompt instead.
    sftpPlainPassword = null;
    sftpExpired = false;
    fetch('/server/' + SERVER_ID + '/sftp/credentials')
      .then(function (resp) {
        if (resp.status === 404) {
          document.getElementById('sftpErrorTitle').textContent = 'No SFTP credentials yet.';
          document.getElementById('sftpErrorMsg').textContent = '';
          showSftpState('error');
          return;
        }
        if (!resp.ok) {
          return resp.json().catch(function () { return {}; }).then(function (d) {
            throw new Error(d.error || 'Request failed (' + resp.status + ')');
          });
        }
        return resp.json().then(fillCredentials);
      })
      .catch(function (err) {
        document.getElementById('sftpErrorTitle').textContent = "Couldn't load credentials — maybe generate a fresh set?";
        document.getElementById('sftpErrorMsg').textContent = err.message || 'Unknown error.';
        showSftpState('error');
      });
  }

  window.generateSftpCredentials = function () {
    const btn = document.getElementById('sftpRegenBtn');
    if (btn) btn.disabled = true;
    sftpPlainPassword = null;
    sftpExpired = false;
    showSftpState('loading');

    return fetch('/server/' + SERVER_ID + '/sftp/credentials', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'csrf-token': csrfToken },
    })
      .then(function (resp) {
        if (!resp.ok) {
          return resp.json().catch(function () { return {}; }).then(function (d) {
            throw new Error(d.error || 'Request failed (' + resp.status + ')');
          });
        }
        return resp.json();
      })
      .then(function (data) {
        if (btn) btn.disabled = false;
        fillCredentials(data);
        showToast('Fresh credentials ready.', 'success');
      })
      .catch(function (err) {
        if (btn) btn.disabled = false;
        document.getElementById('sftpErrorTitle').textContent = "Couldn't generate credentials — please try again.";
        document.getElementById('sftpErrorMsg').textContent = err.message || 'Unknown error.';
        showSftpState('error');
      });
  };

  window.revokeSftpCredentials = function () {
    fetch('/server/' + SERVER_ID + '/sftp/credentials', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json', 'csrf-token': csrfToken },
    })
      .then(function (resp) {
        if (!resp.ok) {
          return resp.json().catch(function () { return {}; }).then(function (d) {
            throw new Error(d.error || 'Request failed (' + resp.status + ')');
          });
        }
        sftpPlainPassword = null;
        sftpExpired = false;
        closeSftpModal();
        showToast('SFTP access revoked.', 'success');
      })
      .catch(function (err) {
        console.error('Failed to revoke SFTP credentials:', err);
        showToast(err && err.message ? err.message : 'Failed to revoke credentials. Try again.', 'error');
      });
  };

  window.sftpCopy = function (elementId) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const text = (el.textContent || '').trim();
    if (!text) return;

    const fallbackCopy = function () {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch (e) {
        ok = false;
      } finally {
        document.body.removeChild(ta);
      }
      showToast(ok ? 'Copied!' : 'Copy failed — try selecting and copying manually.', ok ? 'success' : 'error');
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        showToast('Copied!', 'success');
      }).catch(fallbackCopy);
    } else {
      fallbackCopy();
    }
  };

  // Touch device support: tap to toggle password reveal
  document.querySelectorAll('.sftp-password').forEach(function(el) {
    el.addEventListener('click', function() {
      this.classList.toggle('blur-sm');
      this.classList.toggle('blur-none');
    });
  });
})();
</script>
