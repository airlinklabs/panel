<!-- Sidebar -->
<div id="pc-sidebar" class="sidebar hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-56 lg:flex-col left-0"
  style="display:none;">
  <div id="pc-sidebar2" class="flex flex-col h-full">

    <!-- Static top: logo -->
    <div id="sidebar-logo-block" class="pl-5 pt-3 pb-3 flex min-w-0 shrink-0">
      <a href="/" id="sidebar-logo-link" class="flex items-center min-w-0">
        <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="Logo"
          class="logo-bg p-1 h-[34px] w-[34px] rounded-xl mr-2.5 shrink-0 inline-flex"
          style="background:var(--theme-logo-bg);">
        <h1 class="sidebar-label font-medium tracking-tight text-[15px] truncate min-w-0"
          style="color:var(--theme-text-strong);">
          <%= settings.title || 'Airlink' %>
        </h1>
      </a>
      <button type="button" id="sidebar-collapse-btn"
        class="sidebar-collapse-toggle ml-auto p-1.5 rounded-lg opacity-0 hover:opacity-100 focus:opacity-100 transition-opacity"
        style="color:var(--theme-text-muted);" aria-label="Collapse sidebar" aria-expanded="true">
        <%- icon('panel-left-close', { class: 'w-4 h-4' }) %>
      </button>
    </div>

    <!-- Static: user info — clicking goes to account page -->
    <% if (user !=null) { %>
      <a href="/account" id="sidebar-account-link"
        class="sidebar-special-link flex items-center space-x-3 py-3 px-3.5 border-y shrink-0 transition-colors group"
        style="border-color:var(--theme-nav-border);">
        <img loading="lazy" decoding="async" class="h-7 w-7 rounded-xl shrink-0"
          src="<%= user.avatar ? user.avatar : '/avatar/' + encodeURIComponent(user.username) %>" alt="User avatar">
        <div class="min-w-0">
          <p class="text-[13px] font-medium truncate transition-colors" style="color:var(--theme-text-strong);">
            <span id="sidebar-username">
              <%= user.username %>
            </span>
            <span style="color:var(--theme-text-muted);">
              <sup class="mt-1">#<%= String(user.id).padStart(4, '0' ) %></sup>
            </span>
          </p>
          <p id="sidebar-description" class="text-[11px] truncate" style="color:var(--theme-text-muted);">
            <%= user.description %>
          </p>
        </div>
      </a>
      <% } %>

        <!-- Scrollable nav -->
        <nav class="flex-1 overflow-y-auto">
          <ul role="list" class="py-1.5">
            <li>
              <ul role="list" class="-mx-2 space-y-0.5 relative">
                <div id="active-background"
                  class="ml-1.5 absolute left-2 w-[calc(97%-1.5rem)] h-8 transition-none duration-0 z-[-1] rounded-xl opacity-0">
                </div>
                <% const sidebarItems=regularMenuItems || (global.uiComponentStore ?
                  global.uiComponentStore.getSidebarItems(undefined, false) : []); const isServerPage=(typeof server
                  !=='undefined' && server && typeof req !=='undefined' && req && (req.path || req.originalUrl || ''
                  ).startsWith('/server/')); const srvNavT=(typeof req !=='undefined' && req && req.translations) || {};
                  %>
                  <div id="sidebar-main-view" class="sidebar-view<%= isServerPage ? ' hidden' : '' %>">
                    <% if (!sidebarItems || sidebarItems.length===0) { %>
                      <li class="nav-item sidebar-view-item" style="--i:0">
                        <a href="/"
                          class="nav-link mt-0.5 px-3.5 mx-3.5 group flex gap-x-2.5 py-[5px] rounded-xl text-[13px] leading-5 font-normal transition-all duration-200"
                          style="color:var(--theme-nav-text);" data-search="container instances servers"
                          data-match-prefix="/server">
                          <%- icon('layout-dashboard', { class: 'w-4 h-4 mt-0.5' }) %>
                            <span>Back to Dashboard</span>

                        </a>
                      </li>
                      <% } else { sidebarItems.forEach((item, i)=> {
                        const isCurrentPath = (req.path === item.url) || (item.matchPrefix &&
                        req.path.startsWith(item.matchPrefix));
                        %>
                        <li class="nav-item sidebar-view-item" style="--i:<%= i + 1 %>">
                          <a href="<%= item.url %>"
                            class="nav-link mt-0.5 px-3.5 mx-3.5 group flex gap-x-2.5 py-[5px] rounded-xl text-[13px] leading-5 font-normal transition-all duration-200"
                            style="color:var(--theme-nav-text);" <% if (item.matchPrefix) { %> data-match-prefix="<%=
                              item.matchPrefix %>"<% } %>
                                <% if (isCurrentPath) { %> aria-current="page"<% } %>>
                                    <%- item.icon %>
                                      <span>
                                        <%= item.label %>
                                      </span>
                          </a>
                        </li>
                        <% }); } %>

                          <% if (user !=null && user.isAdmin===true) { %>
                            <% let adminAnimIdx=0; %>
                              <% const adminGroups=adminSidebarGroups || []; %>
                                <% if (adminGroups.length> 0) { %>
                                  <p class="pl-7 text-[11px] font-medium pt-4 pb-1.5"
                                    style="color:var(--theme-nav-text);">
                                    <span>
                                      <%= req.translations.navAdminPanel || 'Admin Panel' %>
                                    </span>
                                  </p>
                                  <% adminGroups.forEach(function(group) { %>
                                    <% group.items.forEach(function(item) { %>
                                      <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
                                        <a href="<%= item.url %>"
                                          class="transition nav-link mt-0.5 px-3.5 mx-3.5 group flex gap-x-2.5 py-[5px] rounded-xl text-[13px] leading-5 font-normal"
                                          style="color:var(--theme-nav-text);" <% if (item.matchPrefix) { %>
                                          data-match-prefix="<%= item.matchPrefix %>"<% } %>
                                              <% if (req.path===item.url) { %> aria-current="page"<% } %>>
                                                  <%- item.icon %>
                                                    <span>
                                                      <%= item.label %>
                                                    </span>
                                        </a>
                                      </li>
                                      <% }); %>
                                        <% }); %>
                                          <% } %>
                                            <% } %>
                  </div>

                  <% if (isServerPage && global.uiComponentStore) { const
                    srvMenuItems=global.uiComponentStore.getServerMenuItems(); const srvIsAdmin=(typeof user
                    !=='undefined' && user && user.isAdmin===true); const srvIsSub=(typeof req !=='undefined' && req &&
                    req.subUser) ? true : false; const srvEntries=srvMenuItems.filter(item=> {
                    if (item.isAdminItem && !srvIsAdmin) return false;
                    if (item.ownerOnly && srvIsSub) return false;
                    if (item.feature && !(typeof features !== 'undefined' && features &&
                    features.includes(item.feature))) return false;
                    return true;
                    }).map(item => ({
                    item,
                    url: (item.url || '#').replace(':uuid', server.UUID).replace(':id', server.id),
                    }));
                    const srvGroupOrder = ['run', 'data', 'manage', 'settings'];
                    const srvT = (typeof req !== 'undefined' && req && req.translations) || {};
                    const srvGroupLabel = (g) => {
                    if (g === 'run') return srvT.navGroupRun || 'Run';
                    if (g === 'data') return srvT.navGroupData || 'Data';
                    if (g === 'manage') return srvT.navGroupManage || 'Manage';
                    return srvT.navGroupSettings || 'Settings';
                    };
                    const srvGrouped = srvGroupOrder
                    .map(g => ({ g, entries: srvEntries.filter(e => (e.item.group || 'manage') === g) }))
                    .filter(grp => grp.entries.length > 0);
                    if (srvGrouped.length > 0) {
                    let srvAnimIdx = 0;
                    %>
                    <div id="sidebar-server-view" class="sidebar-view showing">
                      <li class="nav-item">
                        <a href="/"
                          class="nav-link mt-0.5 px-3.5 mx-3.5 group flex gap-x-2.5 py-[5px] rounded-xl text-[13px] leading-5 font-normal transition-all duration-200"
                          style="color:var(--theme-nav-text);" data-search="container instances servers"
                          data-match-prefix="/server">
                          <%- icon('layout-dashboard', { class: 'w-4 h-4 mt-0.5' }) %>
                            <span>Back to Dashboard</span>

                        </a>
                      </li>
                      <% srvGrouped.forEach(grp=> { %>
                        <p class="pl-7 text-[11px] font-medium pt-3 pb-1 uppercase tracking-wide"
                          style="color:var(--theme-text-muted);"><span>
                            <%= srvGroupLabel(grp.g) %>
                          </span></p>
                        <% grp.entries.forEach(entry=> { %>
                          <li class="nav-item server-anim-in" style="--i:<%= srvAnimIdx++ %>">
                            <a href="<%= entry.url %>"
                              class="transition nav-link mt-0.5 px-3.5 mx-3.5 group flex gap-x-2.5 py-[5px] rounded-xl text-[13px] leading-5 font-normal"
                              style="color:var(--theme-nav-text);" data-server-control-link>
                              <%- entry.item.icon.replace(/class="[^" ]*"/, 'class="w-4 h-4 mt-0.5 shrink-0"' ) %>
                                <span>
                                  <%= entry.item.label %>
                                </span>
                            </a>
                          </li>
                          <% }); %>
                            <% }); %>
                    </div>
                    <% } %>
                      <% } %>


              </ul>
            </li>
          </ul>
        </nav>

        <style>
          /* Sidebar collapse/expand transitions */
          #pc-sidebar.collapsed {
            width: 72px !important;
          }

          #pc-sidebar.collapsed .sidebar-label,
          #pc-sidebar.collapsed .sidebar-special-link p:not(.text-xs),
          #pc-sidebar.collapsed .nav-link span,
          #pc-sidebar.collapsed #sidebar-logout-link span,
          #pc-sidebar.collapsed #sidebar-goback-btn span,
          #pc-sidebar.collapsed #sidebar-back-btn span,
          #pc-sidebar.collapsed p.pl-7,
          #pc-sidebar.collapsed .server-anim-in span {
            display: none;
          }

          #pc-sidebar.collapsed #pc-sidebar2 {
            align-items: center;
          }

          #pc-sidebar.collapsed #sidebar-logo-block {
            padding-left: 0;
            justify-content: center;
          }

          #pc-sidebar.collapsed #sidebar-logo-link {
            justify-content: center;
          }

          #pc-sidebar.collapsed #sidebar-logo-link img {
            margin-right: 0;
          }

          #pc-sidebar.collapsed #sidebar-account-link {
            padding-left: 0.75rem;
            justify-content: center;
          }

          #pc-sidebar.collapsed .nav-link {
            padding-left: 0;
            justify-content: center;
            gap: 0;
          }

          #pc-sidebar.collapsed .nav-link .w-4 {
            margin-top: 0;
          }

          #pc-sidebar.collapsed #sidebar-logout-link {
            padding-left: 0;
            justify-content: center;
          }

          #pc-sidebar.collapsed .sidebar-collapse-toggle {
            opacity: 1;
          }

          #pc-sidebar.collapsed #sidebar-goback-btn,
          #pc-sidebar.collapsed #sidebar-back-btn {
            padding-left: 0;
            justify-content: center;
            gap: 0;
          }

          #pc-sidebar.collapsed p.pl-7 {
            display: none;
          }

          #pc-sidebar.collapsed .server-anim-in {
            padding-left: 0;
            justify-content: center;
          }

          #pc-sidebar.collapsed #active-background {
            left: 0.375rem;
            width: calc(100% - 0.75rem);
          }

          /* Server/main sidebar view switching */
          /* Disabled: sidebar animations removed for cleaner page navigation */
          /*
    @keyframes sidebar-view-fade {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    #sidebar-server-view.showing, #sidebar-main-view.showing {
      animation: sidebar-view-fade 140ms ease-out both;
    }
    */
          /* Normal sidebar items — no animation */
          #sidebar-main-view .sidebar-view-item {
            opacity: 1;
          }

          /* Server buttons — no animation */
          #sidebar-server-view .server-anim-in {
            opacity: 1;
          }

          /*
    @keyframes sidebar-swipe-left {
      from { opacity: 0; transform: translateX(-16px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes sidebar-swipe-right {
      from { opacity: 0; transform: translateX(16px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    */
          @media (prefers-reduced-motion: reduce) {

            #sidebar-server-view.showing,
            #sidebar-main-view.showing,
            #sidebar-server-view.showing .server-anim-in,
            #sidebar-main-view.showing .sidebar-view-item {
              animation: none;
            }

            #sidebar-server-view .server-anim-in,
            #sidebar-main-view .sidebar-view-item {
              opacity: 1;
            }
          }
        </style>



        <!-- Static bottom: logout -->
        <div class="shrink-0 border-t" style="border-color:var(--theme-nav-border);">
          <a href="/logout" id="sidebar-logout-link"
            class="sidebar-special-link group flex gap-x-2.5 pl-5 py-3 text-[13px] font-medium leading-5 transition-colors duration-200"
            style="color:var(--theme-danger);">
            <%- icon('log-out', { class: 'w-4 h-4 mt-0.5 shrink-0' , strokeWidth: 1.5 }) %>
              <span>
                <%= req.translations.navLogout || 'Logout' %>
              </span>
          </a>
        </div>

  </div>
</div>

<script nonce="<%- nonce %>">
  (function () {
    const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(wsProtocol + '//' + window.location.host + '/online-check');
    ws.addEventListener('error', function () { /* WebSocket errors are handled by reconnection logic */ });

    function themeVar(name, fallback) {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return v || fallback;
    }

    function markSpecialLinks(path) {
      const pillBg = themeVar('--theme-text', '#171717');
      const pillFg = themeVar('--theme-bg', '#f0f0f0');
      const account = document.getElementById('sidebar-account-link');
      const logout = document.getElementById('sidebar-logout-link');
      const logo = document.getElementById('sidebar-logo-link');
      if (account) {
        const onAccount = path === '/account' || path.startsWith('/account/');
        const userText = account.querySelector('#sidebar-username');
        if (onAccount) {
          account.style.background = pillBg;
          account.style.color = pillFg;
          account.style.fontWeight = '700';
          if (userText) userText.parentElement.style.color = pillFg;
        } else {
          account.style.background = '';
          account.style.color = '';
          account.style.fontWeight = '';
          if (userText) userText.parentElement.style.color = '';
        }
      }
      if (logo) {
        const onCredits = path === '/credits' || path.startsWith('/credits/');
        const logoBlock = document.getElementById('sidebar-logo-block');
        const logoTitle = logo.querySelector('h1');
        const logoImg = logo.querySelector('img');
        if (onCredits) {
          if (logoBlock) {
            logoBlock.style.background = pillBg;
            logoBlock.style.borderRadius = '0.75rem';
          }
          logo.style.color = pillFg;
          if (logoImg) logoImg.style.background = pillFg;
          if (logoTitle) {
            logoTitle.style.color = pillFg;
            logoTitle.style.fontWeight = '700';
          }
        } else {
          if (logoBlock) {
            logoBlock.style.background = '';
            logoBlock.style.borderRadius = '';
          }
          logo.style.color = '';
          if (logoImg) logoImg.style.background = '';
          if (logoTitle) {
            logoTitle.style.color = '';
            logoTitle.style.fontWeight = '';
          }
        }
      }
      if (logout) {
        logout.style.background = '';
      }
    }

    function markActiveNav(path) {
      const pillBg = themeVar('--theme-text', '#171717');
      const pillFg = themeVar('--theme-bg', '#f0f0f0');

      const srvLinks = document.querySelectorAll('[data-server-control-link]');
      let srvBest = null;
      let bestLen = -1;
      srvLinks.forEach(function (link) {
        link.classList.remove('active');
        link.style.color = '';
        link.style.background = '';
        const href = link.getAttribute('href') || '';
        const matched = path === href || (href !== '/' && path.startsWith(href + '/'));
        if (matched && href.length > bestLen) {
          bestLen = href.length;
          srvBest = link;
        }
      });
      if (srvBest) {
        srvBest.classList.add('active');
        srvBest.style.color = pillFg;
        srvBest.style.background = pillBg;
        srvBest.style.borderRadius = '0.75rem';
      }

      const links = document.querySelectorAll('.nav-link');
      links.forEach(function (link) {
        if (link.hasAttribute('data-server-control-link')) return;
        const href = link.getAttribute('href');
        const prefix = link.getAttribute('data-match-prefix');
        if (srvBest && prefix && path.startsWith(prefix)) return;
        let active = false;
        if (href && path === href) {
          active = true;
        } else if (prefix && path.startsWith(prefix)) {
          active = true;
        } else if (href && path.startsWith(href + '/')) {
          active = true;
        }
        if (active) {
          link.classList.add('active');
          link.style.color = pillFg;
          link.style.background = pillBg;
          link.style.borderRadius = '0.75rem';
        } else {
          link.classList.remove('active');
          link.style.color = '';
          link.style.background = '';
        }
      });
    }

    function showActiveNavInView() {
      const activeLink = document.querySelector('#pc-sidebar .nav-link.active, #pc-sidebar [data-server-control-link].active');
      if (!activeLink) return;
      const container = activeLink.closest('nav');
      if (!container) return;
      const pad = 16;
      const cTop = container.getBoundingClientRect().top;
      const cBottom = container.getBoundingClientRect().bottom;
      const r = activeLink.getBoundingClientRect();
      if (r.bottom + pad > cBottom) {
        container.scrollTop = container.scrollTop + (r.bottom + pad - cBottom);
      } else if (r.top - pad < cTop) {
        container.scrollTop = container.scrollTop - (cTop - (r.top - pad));
      }
    }

    function showSidebarView(name) {
      const serverView = document.getElementById('sidebar-server-view');
      const mainView = document.getElementById('sidebar-main-view');
      let incoming = null;
      if (serverView) {
        const toServer = name === 'server';
        serverView.classList.toggle('hidden', !toServer);
        serverView.classList.remove('showing');
        if (toServer) incoming = serverView;
      }
      if (mainView) {
        const toMain = name !== 'server';
        mainView.classList.toggle('hidden', !toMain);
        mainView.classList.remove('showing');
        if (toMain) incoming = mainView;
      }
      if (incoming) {
        void incoming.offsetWidth;
        incoming.classList.add('showing');
      }
    }

    function wireSidebarViewToggle() {
      const backBtn = document.getElementById('sidebar-back-btn');
      if (backBtn) backBtn.addEventListener('click', function () { showSidebarView('main'); });
      const goBackBtn = document.getElementById('sidebar-goback-btn');
      if (goBackBtn) goBackBtn.addEventListener('click', function () { showSidebarView('server'); });
    }

    function initSidebarCollapse() {
      const sidebar = document.getElementById('pc-sidebar');
      const collapseBtn = document.getElementById('sidebar-collapse-btn');
      const colcont = document.getElementById('colcont');
      if (!sidebar || !collapseBtn) return;

      const COLLAPSED_KEY = 'sidebar-collapsed';
      const collapsed = localStorage.getItem(COLLAPSED_KEY) === 'true';
      if (collapsed) sidebar.classList.add('collapsed');
      updateContentPadding(collapsed);

      collapseBtn.addEventListener('click', function () {
        const isCollapsed = sidebar.classList.toggle('collapsed');
        localStorage.setItem(COLLAPSED_KEY, String(isCollapsed));
        collapseBtn.setAttribute('aria-expanded', String(!isCollapsed));
        const label = isCollapsed ? 'Expand sidebar' : 'Collapse sidebar';
        collapseBtn.setAttribute('aria-label', label);
        updateContentPadding(isCollapsed);
      });

      function updateContentPadding(isCollapsed) {
        if (colcont) colcont.style.paddingLeft = isCollapsed ? '72px' : '';
      }

      function addCollapsedTooltips() {
        if (!sidebar.classList.contains('collapsed')) return;
        const items = sidebar.querySelectorAll('.nav-link, #sidebar-logout-link, #sidebar-account-link');
        items.forEach(function (item) {
          if (item.getAttribute('title')) return;
          const span = item.querySelector('span');
          if (span) item.setAttribute('title', span.textContent.trim());
        });
      }

      const observer = new MutationObserver(function () {
        if (sidebar.classList.contains('collapsed')) {
          addCollapsedTooltips();
        } else {
          sidebar.querySelectorAll('[title]').forEach(function (el) {
            el.removeAttribute('title');
          });
        }
      });
      observer.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
    }

    if (document.getElementById('pc-sidebar')) {
      document.getElementById('pc-sidebar').style.display = '';
      markSpecialLinks(window.location.pathname);
      markActiveNav(window.location.pathname);
      showActiveNavInView();
      wireSidebarViewToggle();
      initSidebarCollapse();
      showSidebarView(window.location.pathname.startsWith('/server/') ? 'server' : 'main');
    }
  })();
</script>