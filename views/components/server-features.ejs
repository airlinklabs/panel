
<!-- EULA Feature -->

<% if (typeof features !== 'undefined' && features && features.includes('eula')) { %>
<script nonce="<%- nonce %>">
  window.modal.confirm({
    title: '<%= (req.translations && req.translations.acceptMinecraftEula) || "Accept Minecraft\'s EULA" %>',
    body: '<%= (req.translations && req.translations.eulaModalBody) || "By clicking Accept you agree to the Mojang End User License Agreement (EULA). The server will not start until you accept." %>',
    danger: false,
    confirmLabel: '<%= (req.translations && req.translations.acceptEula) || "Accept EULA" %>',
    onConfirm: () => {
      fetch('/api/v2/servers/<%= req.params.id %>/features/eula', { method: 'POST', headers: { 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' } })
        .then(() => {})
        .catch(error => {
          console.error('There was an error!', error);
          if (typeof showToast === 'function') {
            showToast('<%= (req.translations && req.translations.couldNotAcceptEula) || "Could not accept the EULA. Please try again." %>', 'error');
          }
        });
    }
  });
</script>
<% } %>

