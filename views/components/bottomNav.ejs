<!-- Mobile top bar -->
<div class="mobile-top-bar fixed top-0 left-0 right-0 z-40 lg:hidden h-12 flex items-center justify-between px-3.5 border-b" style="background:var(--theme-nav-bg); border-color:var(--theme-nav-border);">
  <a href="/" class="flex items-center gap-2 min-w-0">
    <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="Logo" class="h-7 w-7 rounded-lg shrink-0" style="background:var(--theme-logo-bg);">
    <h1 class="font-medium text-[13px] truncate" style="color:var(--theme-text-strong);"><%= settings.title || 'Airlink' %></h1>
  </a>
  <div class="flex items-center gap-1.5">
    <% if (user != null) { %>
    <a href="/account" class="p-1 rounded-lg transition-colors min-w-[40px] min-h-[40px] flex items-center justify-center" style="color:var(--theme-text-muted);">
      <img loading="lazy" decoding="async" class="w-5.5 h-5.5 rounded-lg" src="<%= user.avatar ? user.avatar : '/avatar/' + encodeURIComponent(user.username) %>" alt="User avatar">
    </a>
    <% } %>
  </div>
</div>

<!-- Mobile bottom navigation -->
<nav id="mobile-bottom-nav" class="mobile-bottom-nav fixed bottom-0 left-0 right-0 z-50 lg:hidden border-t" aria-label="Mobile navigation" style="background:var(--theme-nav-bg); border-color:var(--theme-nav-border);">
  <div class="flex items-stretch h-[52px] px-1.5">
    <%
    const bottomNavItems = regularMenuItems || (global.uiComponentStore ? global.uiComponentStore.getSidebarItems(undefined, false) : []);
    const navToShow = (bottomNavItems || []).slice(0, 4);
    const onServerPage = (typeof req !== 'undefined' && req && (req.path || req.originalUrl || '').startsWith('/server/'));
    const isAdminUser = (typeof user !== 'undefined' && user != null && user.isAdmin === true);
    const mT = (typeof req !== 'undefined' && req && req.translations) || {};
    let mSheetHasServerView = false;
    %>

    <% navToShow.forEach(function(item) { %>
    <a href="<%= item.url %>" class="mobile-nav-link min-w-0 flex-1 flex flex-col items-center justify-center gap-1 text-[11px] transition-colors active:scale-95" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent;" data-match-prefix="<%= item.matchPrefix || '' %>">
      <%- item.icon %>
      <span class="truncate max-w-[3.5rem]"><%= item.label %></span>
    </a>
    <% }); %>

    <!-- More button (for remaining items) -->
    <button type="button" id="mobile-more-btn" class="mobile-nav-link min-w-0 flex-1 flex flex-col items-center justify-center gap-1 text-[11px] transition-colors active:scale-95" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent;" aria-label="More navigation options" aria-expanded="false" aria-controls="mobile-more-sheet">
      <%- icon('more-horizontal', { class: 'w-4 h-4' }) %>
      <span>More</span>
    </button>
  </div>
</nav>

<!-- More sheet (extends up from bottom bar) -->
<div id="mobile-more-sheet" class="mobile-more-sheet fixed left-0 right-0 bottom-[60px] z-50 lg:hidden opacity-0 pointer-events-none will-change-transform" role="dialog" aria-label="Additional navigation" aria-modal="true" inert style="top: auto; max-height: calc(100vh - 80px);">
  <style>
    #mobile-more-sheet {
      translate: none;
      transform: translateY(16px);
      transition: transform var(--dur-enter, 320ms) cubic-bezier(0.16, 1, 0.3, 1),
                  opacity var(--dur-enter, 320ms) cubic-bezier(0.16, 1, 0.3, 1);
    }
    #mobile-more-sheet.open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    #mobile-more-sheet.closing {
      transform: translateY(16px);
      opacity: 0;
      transition: transform var(--dur-exit, 180ms) cubic-bezier(0.4, 0, 1, 1),
                  opacity var(--dur-exit, 180ms) cubic-bezier(0.4, 0, 1, 1);
    }
    .sheet-pill {
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background: var(--theme-text-muted);
      opacity: 0.35;
      transition: opacity 200ms, transform 200ms;
      margin: 0 auto;
    }
    .sheet-pill:active,
    #mobile-more-sheet.dragging .sheet-pill {
      opacity: 0.55;
      transform: scaleX(1.25);
    }
    .sheet-scroll {
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      scrollbar-width: none;
      max-height: calc(100vh - 130px);
    }
    .sheet-scroll::-webkit-scrollbar { display: none; }
    .sheet-scroll::before {
      content: '';
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      height: 24px;
      display: block;
      background: linear-gradient(to bottom, var(--theme-nav-bg), transparent);
      pointer-events: none;
      z-index: 2;
    }
    .sheet-scroll::after {
      content: '';
      position: sticky;
      bottom: 0;
      left: 0;
      right: 0;
      height: 16px;
      display: block;
      background: linear-gradient(to top, var(--theme-nav-bg), transparent);
      pointer-events: none;
      z-index: 2;
    }
    #mobile-more-sheet .sheet-item {
      transition: background-color 150ms, color 150ms;
    }
    #mobile-more-sheet .sheet-item.sheet-active {
      background: var(--theme-accent);
      color: var(--theme-text-on-accent, #fff);
    }
    @keyframes sheet-view-fade { from { opacity: 0; } to { opacity: 1; } }
    #mobile-more-server-view.showing, #mobile-more-main.showing { animation: sheet-view-fade 140ms ease-out both; }
    #mobile-more-main .sheet-anim-item { opacity: 0; }
    #mobile-more-main.showing .sheet-anim-item {
      animation: sheet-swipe-left 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: min(calc(var(--i, 0) * 25ms), 300ms);
    }
    #mobile-more-server-view .server-anim-in { opacity: 0; }
    #mobile-more-server-view.showing .server-anim-in {
      animation: sheet-swipe-right 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
    @keyframes sheet-swipe-left { from { opacity: 0; transform: translateX(-16px); } to { opacity: 1; transform: translateX(0); } }
    @keyframes sheet-swipe-right { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: translateX(0); } }
    @media (prefers-reduced-motion: reduce) {
      #mobile-more-sheet, #mobile-more-sheet.closing { transition: none; }
      #mobile-more-server-view.showing, #mobile-more-main.showing,
      #mobile-more-server-view.showing .server-anim-in,
      #mobile-more-main.showing .sheet-anim-item { animation: none; }
      #mobile-more-server-view .server-anim-in,
      #mobile-more-main .sheet-anim-item { opacity: 1; }
    }
  </style>

  <div class="rounded-t-2xl border-t shadow-xl flex flex-col" style="background:var(--theme-nav-bg); border-color:var(--theme-nav-border);">
    <!-- Pill drag handle -->
    <div id="mobile-sheet-pill" class="flex items-center justify-center pt-3 pb-2 cursor-grab active:cursor-grabbing touch-none select-none" role="separator" aria-label="Drag to resize">
      <div class="sheet-pill"></div>
    </div>

    <!-- Scrollable content -->
    <div class="sheet-scroll flex flex-col px-2 pb-3">
      <% if (onServerPage && typeof server !== 'undefined' && server && global.uiComponentStore) {
        const mSrvItems = global.uiComponentStore.getServerMenuItems();
        const mSrvEntries = mSrvItems.filter(item => {
          if (item.isAdminItem && !isAdminUser) return false;
          if (item.ownerOnly && (typeof req !== 'undefined' && req && req.subUser)) return false;
          if (item.feature && !(typeof features !== 'undefined' && features && features.includes(item.feature))) return false;
          return true;
        }).map(item => ({
          item,
          url: (item.url || '#').replace(':uuid', server.UUID).replace(':id', server.id),
        }));
        const mGroupOrder = ['run', 'data', 'manage', 'settings'];
        const mGroupLabel = (g) => {
          if (g === 'run') return mT.navGroupRun || 'Run';
          if (g === 'data') return mT.navGroupData || 'Data';
          if (g === 'manage') return mT.navGroupManage || 'Manage';
          return mT.navGroupSettings || 'Settings';
        };
        const mGrouped = mGroupOrder
          .map(g => ({ g, entries: mSrvEntries.filter(e => (e.item.group || 'manage') === g) }))
          .filter(grp => grp.entries.length > 0);
        if (mGrouped.length > 0) {
          let mAnimIdx = 0;
          mSheetHasServerView = true;
      %>
      <div id="mobile-more-server-view" class="mobile-sheet-view showing">
        <button type="button" id="mobile-sheet-back-btn" role="menuitem" class="sheet-item sheet-view-toggle flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl transition-colors active:scale-95" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent; min-height: 38px;">
          <%- icon('arrow-left', { class: 'w-4 h-4' }) %>
          <span class="text-[13px]"><%= mT.navBack || 'Back' %></span>
        </button>
        <% mGrouped.forEach(grp => { %>
        <p class="px-3.5 py-1 text-[11px] font-medium uppercase tracking-wide mt-2" style="color:var(--theme-text-muted);"><%= mGroupLabel(grp.g) %></p>
          <% grp.entries.forEach(entry => { %>
          <a href="<%= entry.url %>" role="menuitem" class="server-anim-in sheet-item mobile-more-link flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl transition-colors" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent; min-height: 38px; --i:<%= mAnimIdx++ %>" data-sheet-match-url="<%= entry.url %>">
            <%- entry.item.icon %>
            <span class="text-[13px]"><%= entry.item.label %></span>
          </a>
          <% }); %>
        <% }); %>
      </div>
      <% } } %>

      <div id="mobile-more-main" class="mobile-sheet-view<%= mSheetHasServerView ? ' hidden' : '' %>">
      <% if (mSheetHasServerView) { %>
      <button type="button" id="mobile-sheet-goback-btn" role="menuitem" class="sheet-item sheet-view-toggle flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl transition-colors active:scale-95" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent; min-height: 38px;">
        <%- icon('arrow-left', { class: 'w-4 h-4' }) %>
        <span class="text-[13px]"><%= mT.navGoBack || 'Go Back' %></span>
      </button>
      <% } %>
      <% (bottomNavItems || []).slice(4).forEach(function(item, i) { %>
      <a href="<%= item.url %>" role="menuitem" class="sheet-anim-item sheet-item mobile-more-link flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl transition-colors" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent; min-height: 38px; --i:<%= i + 1 %>" data-match-prefix="<%= item.matchPrefix || '' %>">
        <%- item.icon %>
        <span class="text-[13px]"><%= item.label %></span>
      </a>
      <% }); %>

      <div class="border-t mt-2 pt-2" style="border-color:var(--theme-border);">
        <% if (user != null) { %>
        <a href="/account" role="menuitem" class="sheet-anim-item sheet-item mobile-more-link flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl transition-colors" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent; min-height: 38px; --i:20">
          <img loading="lazy" decoding="async" class="w-5 h-5 rounded-lg" src="<%= user.avatar ? user.avatar : '/avatar/' + encodeURIComponent(user.username) %>" alt="">
          <span class="text-[13px]">Account</span>
        </a>
        <a href="/logout" role="menuitem" class="sheet-anim-item sheet-item mobile-more-link flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl transition-colors" style="color:var(--theme-danger); -webkit-tap-highlight-color: transparent; min-height: 38px; --i:21">
          <%- icon('log-out', { class: 'w-4 h-4' }) %>
          <span class="text-[13px]">Logout</span>
        </a>
        <% } else { %>
        <a href="/login" role="menuitem" class="sheet-anim-item sheet-item mobile-more-link flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl transition-colors" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent; min-height: 38px; --i:20">
          <%- icon('log-in', { class: 'w-4 h-4' }) %>
          <span class="text-[13px]">Login</span>
        </a>
        <% } %>
      <% if (isAdminUser) { %>
      <% let admSheetIdx = 20; %>
      <div class="border-t mt-2 pt-2" style="border-color:var(--theme-border);">
      <% const admGroups = adminSidebarGroups || []; %>
      <% if (admGroups.length > 0) { %>
        <% admGroups.forEach(function(group) { %>
        <p class="px-3.5 py-1 text-[11px] font-medium uppercase tracking-wide<%= group !== admGroups[0] ? ' mt-2' : '' %>" style="color:var(--theme-text-muted);"><%= group.label %></p>
        <% group.items.forEach(function(item) { %>
        <a href="<%= item.url %>" role="menuitem" class="sheet-anim-item sheet-item mobile-more-link flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl transition-colors" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent; min-height: 38px; --i:<%= admSheetIdx++ %>">
          <%- item.icon %>
          <span class="text-[13px]"><%= item.label %></span>
        </a>
        <% }); %>
        <% }); %>
      <% } %>
      </div>
      <% } %>
      </div>
    </div>
  </div>
</div>
</div>

<script nonce="<%- nonce %>">
(function () {
  const btn = document.getElementById('mobile-more-btn');
  const sheet = document.getElementById('mobile-more-sheet');
  const serverView = document.getElementById('mobile-more-server-view');
  const mainPane = document.getElementById('mobile-more-main');
  let lastFocus = null;

  function showSheetView(name) {
    let incoming = null;
    if (serverView) {
      const toServer = name === 'server';
      serverView.classList.toggle('hidden', !toServer);
      serverView.classList.remove('showing');
      if (toServer) incoming = serverView;
    }
    if (mainPane) {
      mainPane.classList.toggle('hidden', name === 'server');
      mainPane.classList.remove('showing');
      if (name !== 'server') incoming = mainPane;
    }
    if (incoming) {
      void incoming.offsetWidth;
      incoming.classList.add('showing');
    }
  }

  function openSheet() {
    if (serverView) { showSheetView('server'); } else { showSheetView('main'); }
    sheet.classList.remove('closing');
    sheet.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
    sheet.style.maxHeight = '';
    sheet.removeAttribute('inert');
    lastFocus = document.activeElement;
    markActiveSheetItems();
    const focusable = sheet.querySelector('a[href], button:not([disabled])');
    if (focusable) focusable.focus();
  }

  function closeSheet() {
    sheet.classList.remove('open');
    sheet.classList.add('closing');
    btn.setAttribute('aria-expanded', 'false');
    sheet.setAttribute('inert', '');
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }

    if (sheet) {
    sheet.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { e.preventDefault(); closeSheet(); return; }
      if (e.key !== 'Tab') return;
      const focusables = sheet.querySelectorAll('a[href], button:not([disabled])');
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    });
  }

  if (btn) btn.addEventListener('click', function() {
    if (sheet.classList.contains('open')) { closeSheet(); } else { openSheet(); }
  });

  const sheetBackBtn = document.getElementById('mobile-sheet-back-btn');
  if (sheetBackBtn) sheetBackBtn.addEventListener('click', function () { showSheetView('main'); });
  const sheetGoBackBtn = document.getElementById('mobile-sheet-goback-btn');
  if (sheetGoBackBtn) sheetGoBackBtn.addEventListener('click', function () { showSheetView('server'); });

  // Close sheet on any navigation link click
  document.querySelectorAll('.mobile-more-link').forEach(function(link) {
    link.addEventListener('click', closeSheet);
  });

  // Drag handle: swipe down to close
  const pill = document.getElementById('mobile-sheet-pill');
  let dragStartY = 0;
  let dragStartSheetH = 0;
  let dragging = false;

  if (pill && sheet) {
    pill.addEventListener('touchstart', function(e) {
      if (sheet.classList.contains('open')) {
        dragging = true;
        dragStartY = e.touches[0].clientY;
        dragStartSheetH = sheet.scrollHeight;
        sheet.classList.add('dragging');
        sheet.style.transition = 'none';
        e.preventDefault();
      }
    }, { passive: false });

    document.addEventListener('touchmove', function(e) {
      if (!dragging) return;
      const dy = e.touches[0].clientY - dragStartY;
      const newH = Math.max(0, Math.min(dragStartSheetH, dragStartSheetH + dy));
      sheet.style.maxHeight = newH + 'px';
    }, { passive: true });

    document.addEventListener('touchend', function() {
      if (!dragging) return;
      dragging = false;
      sheet.classList.remove('dragging');
      sheet.style.transition = '';
      const curH = parseFloat(getComputedStyle(sheet).maxHeight);
      sheet.style.maxHeight = '';
      if (curH < 80) {
        closeSheet();
      }
    }, { passive: true });
  }

  // Highlight active items in the sheet
  function markActiveSheetItems() {
    const path = window.location.pathname;
    const items = document.querySelectorAll('#mobile-more-sheet .sheet-item[data-match-prefix]');
    items.forEach(function(item) {
      const prefix = item.getAttribute('data-match-prefix');
      if (prefix && path.startsWith(prefix)) {
        item.classList.add('sheet-active');
      } else {
        item.classList.remove('sheet-active');
      }
    });
    // Server page items: match by href
    const srvItems = document.querySelectorAll('#mobile-more-server-view a[data-sheet-match-url]');
    srvItems.forEach(function(item) {
      const href = item.getAttribute('href') || '';
      if (path === href || path.startsWith(href + '/')) {
        item.classList.add('sheet-active');
      } else {
        item.classList.remove('sheet-active');
      }
    });
  }

  // Highlight active mobile nav link
  function markActiveMobile(path) {
    const links = document.querySelectorAll('.mobile-nav-link[data-match-prefix]');
    links.forEach(function(link) {
      const prefix = link.getAttribute('data-match-prefix');
      if (prefix && path.startsWith(prefix)) {
        link.classList.add('active-mobile');
        link.style.color = 'var(--theme-nav-text-active)';
      } else {
        link.classList.remove('active-mobile');
        link.style.color = '';
      }
    });
  }

  markActiveMobile(window.location.pathname);
})();
</script>
