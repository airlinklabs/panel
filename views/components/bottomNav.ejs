<!-- Mobile bottom navigation -->
<nav id="mobile-bottom-nav" class="mobile-bottom-nav fixed bottom-0 left-0 right-0 z-50 lg:hidden border-t border-neutral-200/30 dark:border-white/5 bg-white/8 dark:bg-[#141414]/8 backdrop-blur-xl" aria-label="Mobile navigation">
  <div class="flex items-center justify-around h-16 px-2">
    <%
    const bottomNavItems = regularMenuItems || (global.uiComponentStore ? global.uiComponentStore.getSidebarItems(undefined, false) : []);
    const navToShow = (bottomNavItems || []).slice(0, 4);
    %>

    <% navToShow.forEach(function(item) { %>
    <a href="<%= item.url %>" class="mobile-nav-link flex flex-col items-center justify-center w-16 h-full text-xs gap-1 transition-colors" data-match-prefix="<%= item.matchPrefix || '' %>">
      <%- item.icon %>
      <span class="truncate max-w-[4rem]"><%= item.label %></span>
    </a>
    <% }); %>

    <!-- More button (for remaining items) -->
    <button id="mobile-more-btn" class="mobile-nav-link flex flex-col items-center justify-center w-16 h-full text-xs gap-1 transition-colors" aria-label="More navigation options" aria-expanded="false" aria-controls="mobile-more-sheet">
      <%- icon('more-horizontal', { class: 'w-5 h-5' }) %>
      <span>More</span>
    </button>
  </div>
</nav>

<!-- More sheet (slides up from bottom) -->
<div id="mobile-more-sheet" class="mobile-more-sheet fixed inset-x-0 bottom-0 z-50 lg:hidden transform translate-y-full transition-transform duration-300 ease-out" role="dialog" aria-label="Additional navigation" aria-modal="true">
  <div class="bg-white dark:bg-neutral-900 rounded-t-2xl border-t border-neutral-200 dark:border-neutral-700 shadow-xl max-h-[70vh] overflow-y-auto">
    <div class="sticky top-0 bg-white dark:bg-neutral-900 px-4 py-3 border-b border-neutral-100 dark:border-neutral-800 flex items-center justify-between">
      <span class="text-sm font-medium text-neutral-800 dark:text-white">Navigation</span>
      <button id="mobile-more-close" class="p-1 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors" aria-label="Close menu">
        <%- icon('x', { class: 'w-5 h-5 text-neutral-500' }) %>
      </button>
    </div>
    <div class="px-2 py-2">
      <% (bottomNavItems || []).slice(4).forEach(function(item) { %>
      <a href="<%= item.url %>" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors" data-match-prefix="<%= item.matchPrefix || '' %>">
        <%- item.icon %>
        <span class="text-sm"><%= item.label %></span>
      </a>
      <% }); %>

      <% if (user.isAdmin === true) { %>
      <div class="border-t border-neutral-100 dark:border-neutral-800 mt-2 pt-2">
        <p class="px-4 py-1 text-xs font-medium text-neutral-400 uppercase tracking-wide">Admin</p>
        <a href="/admin/overview" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <%- icon('layout-grid', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Overview</span>
        </a>
        <a href="/admin/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <%- icon('settings', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Settings</span>
        </a>
        <a href="/admin/servers" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <%- icon('server', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Servers</span>
        </a>
        <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <%- icon('users', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Users</span>
        </a>
        <a href="/admin/nodes" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <%- icon('network', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Nodes</span>
        </a>
        <a href="/admin/images" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <%- icon('box', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Images</span>
        </a>
        <a href="/admin/addons" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <%- icon('puzzle', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Addons</span>
        </a>
        <a href="/admin/apikeys" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <%- icon('key', { class: 'w-5 h-5' }) %>
          <span class="text-sm">API Keys</span>
        </a>
      </div>
      <% } %>

      <div class="border-t border-neutral-100 dark:border-neutral-800 mt-2 pt-2">
        <a href="/account" class="flex items-center gap-3 px-4 py-3 rounded-xl text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <img class="w-6 h-6 rounded-lg" src="<%= user.avatar ? user.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(user.username) %>" alt="">
          <span class="text-sm">Account</span>
        </a>
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors">
          <%- icon('log-out', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Logout</span>
        </a>
      </div>
    </div>
  </div>
</div>
<div id="mobile-more-backdrop" class="fixed inset-0 z-40 lg:hidden bg-black/50 hidden" aria-hidden="true"></div>

<script nonce="<%- nonce %>">
(function () {
  var btn = document.getElementById('mobile-more-btn');
  var sheet = document.getElementById('mobile-more-sheet');
  var close = document.getElementById('mobile-more-close');
  var backdrop = document.getElementById('mobile-more-backdrop');

  function openSheet() {
    sheet.classList.remove('translate-y-full');
    backdrop.classList.remove('hidden');
    btn.setAttribute('aria-expanded', 'true');
  }

  function closeSheet() {
    sheet.classList.add('translate-y-full');
    backdrop.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
  }

  if (btn) btn.addEventListener('click', openSheet);
  if (close) close.addEventListener('click', closeSheet);
  if (backdrop) backdrop.addEventListener('click', closeSheet);

  // Highlight active mobile nav link
  function markActiveMobile(path) {
    var links = document.querySelectorAll('.mobile-nav-link[data-match-prefix]');
    links.forEach(function(link) {
      var prefix = link.getAttribute('data-match-prefix');
      if (prefix && path.startsWith(prefix)) {
        link.classList.add('active-mobile');
      } else {
        link.classList.remove('active-mobile');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    markActiveMobile(window.location.pathname);
  });
  document.addEventListener('al:navigated', function () {
    markActiveMobile(window.location.pathname);
  });
})();
</script>
