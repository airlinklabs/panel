<!-- Mobile top bar -->
<div class="mobile-top-bar fixed top-0 left-0 right-0 z-40 lg:hidden h-14 flex items-center justify-between px-4 border-b" style="background:var(--theme-nav-bg); border-color:var(--theme-nav-border);">
  <a href="/" class="flex items-center gap-2.5 min-w-0">
    <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="Logo" class="h-8 w-8 rounded-lg shrink-0" style="background:var(--theme-logo-bg);">
    <h1 class="font-medium text-sm truncate" style="color:var(--theme-text-strong);"><%= settings.title || 'Airlink' %></h1>
  </a>
  <div class="flex items-center gap-2">
    <button type="button" id="mobile-theme-toggle" class="p-2 rounded-lg transition-colors min-w-[36px] min-h-[36px] flex items-center justify-center" style="color:var(--theme-text-muted);" aria-label="Toggle theme">
      <%- icon('sun', { class: 'w-4 h-4 dark:hidden' }) %>
      <%- icon('moon', { class: 'w-4 h-4 hidden dark:block' }) %>
    </button>
    <% if (user != null) { %>
    <a href="/account" class="p-1 rounded-lg transition-colors min-w-[36px] min-h-[36px] flex items-center justify-center" style="color:var(--theme-text-muted);">
      <img class="w-6 h-6 rounded-lg" src="<%= user.avatar ? user.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(user.username) %>" alt="User avatar">
    </a>
    <% } %>
  </div>
</div>

<!-- Mobile bottom navigation -->
<nav id="mobile-bottom-nav" class="mobile-bottom-nav fixed bottom-0 left-0 right-0 z-50 lg:hidden border-t" aria-label="Mobile navigation" style="background:var(--theme-nav-bg); border-color:var(--theme-nav-border);">
  <div class="flex items-stretch h-[60px] px-2">
    <%
    const bottomNavItems = regularMenuItems || (global.uiComponentStore ? global.uiComponentStore.getSidebarItems(undefined, false) : []);
    const navToShow = (bottomNavItems || []).slice(0, 4);
    const onServerPage = (typeof req !== 'undefined' && req && (req.path || req.originalUrl || '').startsWith('/server/'));
    const isAdminUser = (typeof user !== 'undefined' && user != null && user.isAdmin === true);
    const mT = (typeof req !== 'undefined' && req && req.translations) || {};
    let mSheetHasServerView = false;
    %>

    <% navToShow.forEach(function(item) { %>
    <a href="<%= item.url %>" class="mobile-nav-link min-w-0 flex-1 flex flex-col items-center justify-center gap-1.5 text-xs transition-colors active:scale-95" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent;" data-match-prefix="<%= item.matchPrefix || '' %>">
      <%- item.icon %>
      <span class="truncate max-w-[4rem]"><%= item.label %></span>
    </a>
    <% }); %>

    <!-- More button (for remaining items) -->
    <button type="button" id="mobile-more-btn" class="mobile-nav-link min-w-0 flex-1 flex flex-col items-center justify-center gap-1.5 text-xs transition-colors active:scale-95" style="color:var(--theme-nav-text); -webkit-tap-highlight-color: transparent;" aria-label="More navigation options" aria-expanded="false" aria-controls="mobile-more-sheet">
      <%- icon('more-horizontal', { class: 'w-5 h-5' }) %>
      <span>More</span>
    </button>
  </div>
</nav>

<!-- More sheet (slides up from bottom) -->
<div id="mobile-more-sheet" class="mobile-more-sheet fixed inset-x-0 bottom-0 z-50 lg:hidden translate-y-full will-change-transform" role="dialog" aria-label="Additional navigation" aria-modal="true" inert>
  <style>
    #mobile-more-sheet {
      translate: none;
      transform: translateY(100%);
      transition: transform var(--dur-enter, 320ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    }
    #mobile-more-sheet:not(.translate-y-full) { transform: translateY(0); }
    #mobile-more-sheet.closing {
      transform: translateY(100%);
      transition: transform var(--dur-exit, 180ms) var(--ease-in, cubic-bezier(0.4, 0, 1, 1));
    }
    @keyframes sheet-view-fade { from { opacity: 0; } to { opacity: 1; } }
    #mobile-more-server-view.showing, #mobile-more-main.showing { animation: sheet-view-fade 140ms ease-out both; }
    #mobile-more-main .sheet-anim-item { opacity: 0; }
    #mobile-more-main.showing .sheet-anim-item {
      animation: sheet-swipe-left 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: min(calc(var(--i, 0) * 25ms), 300ms);
    }
    #mobile-more-server-view .server-anim-in { opacity: 0; }
    #mobile-more-server-view.showing .server-anim-in {
      animation: sheet-swipe-right 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
    @keyframes sheet-swipe-left { from { opacity: 0; transform: translateX(-16px); } to { opacity: 1; transform: translateX(0); } }
    @keyframes sheet-swipe-right { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: translateX(0); } }
    @media (prefers-reduced-motion: reduce) {
      #mobile-more-sheet, #mobile-more-sheet.closing { transition: none; }
      #mobile-more-server-view.showing, #mobile-more-main.showing,
      #mobile-more-server-view.showing .server-anim-in,
      #mobile-more-main.showing .sheet-anim-item { animation: none; }
      #mobile-more-server-view .server-anim-in,
      #mobile-more-main .sheet-anim-item { opacity: 1; }
    }
  </style>
  <div class="rounded-t-2xl border-t shadow-xl max-h-[70vh] overflow-y-auto" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <div class="sticky top-0 px-4 py-3 border-b flex items-center justify-between" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
      <span class="text-sm font-medium" style="color:var(--theme-text-strong);">Navigation</span>
      <button type="button" id="mobile-more-close" class="p-2 rounded-lg transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center" style="color:var(--theme-text-muted);" aria-label="Close menu">
        <%- icon('x', { class: 'w-5 h-5' }) %>
      </button>
    </div>
    <div class="px-2 py-2">
      <% if (onServerPage && typeof server !== 'undefined' && server && global.uiComponentStore) {
        const mSrvItems = global.uiComponentStore.getServerMenuItems();
        const mSrvEntries = mSrvItems.filter(item => {
          if (item.isAdminItem && !isAdminUser) return false;
          if (item.ownerOnly && (typeof req !== 'undefined' && req && req.subUser)) return false;
          if (item.feature && !(typeof features !== 'undefined' && features && features.includes(item.feature))) return false;
          return true;
        }).map(item => ({
          item,
          url: (item.url || '#').replace(':uuid', server.UUID).replace(':id', server.id),
        }));
        const mGroupOrder = ['run', 'data', 'manage', 'settings'];
        const mGroupLabel = (g) => {
          if (g === 'run') return mT.navGroupRun || 'Run';
          if (g === 'data') return mT.navGroupData || 'Data';
          if (g === 'manage') return mT.navGroupManage || 'Manage';
          return mT.navGroupSettings || 'Settings';
        };
        const mGrouped = mGroupOrder
          .map(g => ({ g, entries: mSrvEntries.filter(e => (e.item.group || 'manage') === g) }))
          .filter(grp => grp.entries.length > 0);
        if (mGrouped.length > 0) {
          let mAnimIdx = 0;
          mSheetHasServerView = true;
      %>
      <div id="mobile-more-server-view" class="mobile-sheet-view showing">
        <button type="button" id="mobile-sheet-back-btn" role="menuitem" class="sheet-view-toggle mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px;">
          <%- icon('arrow-left', { class: 'w-5 h-5' }) %>
          <span class="text-sm"><%= mT.navBack || 'Back' %></span>
        </button>
        <% mGrouped.forEach(grp => { %>
        <p class="px-4 py-1 text-xs font-medium uppercase tracking-wide mt-2" style="color:var(--theme-text-muted);"><%= mGroupLabel(grp.g) %></p>
          <% grp.entries.forEach(entry => { %>
          <a href="<%= entry.url %>" role="menuitem" class="server-anim-in mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= mAnimIdx++ %>">
            <%- entry.item.icon %>
            <span class="text-sm"><%= entry.item.label %></span>
          </a>
          <% }); %>
        <% }); %>
      </div>
      <% } } %>

      <div id="mobile-more-main" class="mobile-sheet-view<%= mSheetHasServerView ? ' hidden' : '' %>">
      <% if (mSheetHasServerView) { %>
      <button type="button" id="mobile-sheet-goback-btn" role="menuitem" class="sheet-view-toggle mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px;">
        <%- icon('arrow-left', { class: 'w-5 h-5' }) %>
        <span class="text-sm"><%= mT.navGoBack || 'Go Back' %></span>
      </button>
      <% } %>
      <% (bottomNavItems || []).slice(4).forEach(function(item, i) { %>
      <a href="<%= item.url %>" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= i + 1 %>" data-match-prefix="<%= item.matchPrefix || '' %>">
        <%- item.icon %>
        <span class="text-sm"><%= item.label %></span>
      </a>
      <% }); %>

      <div class="border-t mt-2 pt-2" style="border-color:var(--theme-border);">
        <% if (user != null) { %>
        <a href="/account" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:20">
          <img class="w-6 h-6 rounded-lg" src="<%= user.avatar ? user.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(user.username) %>" alt="">
          <span class="text-sm">Account</span>
        </a>
        <a href="/logout" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-danger); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:21">
          <%- icon('log-out', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Logout</span>
        </a>
        <% } else { %>
        <a href="/login" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:20">
          <%- icon('log-in', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Login</span>
        </a>
        <% } %>
      <% if (isAdminUser) { %>
      <div class="border-t mt-2 pt-2" style="border-color:var(--theme-border);">
      <% let admSheetIdx = 20; %>
      <p class="px-4 py-1 text-xs font-medium uppercase tracking-wide" style="color:var(--theme-text-muted);">Admin</p>
        
        <!-- Core -->
        <a href="/admin/overview" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('layout-grid', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Overview</span>
        </a>
        <a href="/admin/servers" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('server', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Servers</span>
        </a>
        <a href="/admin/users" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('users', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Users</span>
        </a>

        <!-- Infrastructure -->
        <p class="px-4 py-1 text-xs font-medium uppercase tracking-wide mt-2" style="color:var(--theme-text-muted);">Infrastructure</p>
        <a href="/admin/nodes" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('network', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Nodes</span>
        </a>
        <a href="/admin/locations" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('map-pin', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Locations</span>
        </a>
        <a href="/admin/activity" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('activity', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Activity Log</span>
        </a>
        <a href="/admin/images" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('box', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Images</span>
        </a>

        <!-- Extensions -->
        <p class="px-4 py-1 text-xs font-medium uppercase tracking-wide mt-2" style="color:var(--theme-text-muted);">Extensions</p>
        <a href="/admin/addons" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('puzzle', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Addons</span>
        </a>
        <a href="/admin/apikeys" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('key', { class: 'w-5 h-5' }) %>
          <span class="text-sm">API Keys</span>
        </a>

        <!-- Configuration -->
        <p class="px-4 py-1 text-xs font-medium uppercase tracking-wide mt-2" style="color:var(--theme-text-muted);">Configuration</p>
        <a href="/admin/settings" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- icon('settings', { class: 'w-5 h-5' }) %>
          <span class="text-sm">Settings</span>
        </a>
        <% if (adminMenuItems && adminMenuItems.length > 0) {
          adminMenuItems.forEach(item => { %>
        <a href="<%= item.url %>" role="menuitem" class="sheet-anim-item mobile-more-link flex items-center gap-3 px-4 py-3 rounded-xl transition-colors active:bg-black/5 dark:active:bg-white/5" style="color:var(--theme-text); -webkit-tap-highlight-color: transparent; min-height: 44px; --i:<%= admSheetIdx++ %>">
          <%- item.icon %>
          <span class="text-sm"><%= item.label %></span>
        </a>
        <% }); } %>
      </div>
      <% } %>
      </div>
    </div>
  </div>
</div>
<div id="mobile-more-backdrop" class="fixed inset-0 z-40 lg:hidden hidden" style="background:rgba(0,0,0,0.5);" aria-hidden="true"></div>

<script nonce="<%- nonce %>">
(function () {
  var btn = document.getElementById('mobile-more-btn');
  var sheet = document.getElementById('mobile-more-sheet');
  var close = document.getElementById('mobile-more-close');
  var backdrop = document.getElementById('mobile-more-backdrop');
  var themeToggle = document.getElementById('mobile-theme-toggle');
  var lastFocus = null;
  var serverView = document.getElementById('mobile-more-server-view');
  var mainPane = document.getElementById('mobile-more-main');

  function showSheetView(name) {
    var incoming = null;
    if (serverView) {
      var toServer = name === 'server';
      serverView.classList.toggle('hidden', !toServer);
      serverView.classList.remove('showing');
      if (toServer) incoming = serverView;
    }
    if (mainPane) {
      mainPane.classList.toggle('hidden', name === 'server');
      mainPane.classList.remove('showing');
      if (name !== 'server') incoming = mainPane;
    }
    if (incoming) {
      void incoming.offsetWidth;
      incoming.classList.add('showing');
    }
  }

  function openSheet() {
    if (serverView) { showSheetView('server'); } else { showSheetView('main'); }
    sheet.classList.remove('translate-y-full');
    sheet.classList.remove('closing');
    backdrop.classList.remove('hidden');
    btn.setAttribute('aria-expanded', 'true');
    sheet.removeAttribute('inert');
    lastFocus = document.activeElement;
    if (close) close.focus();
  }

  function closeSheet() {
    sheet.classList.add('closing');
    sheet.classList.add('translate-y-full');
    backdrop.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
    sheet.setAttribute('inert', '');
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }

  if (sheet) {
    sheet.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { e.preventDefault(); closeSheet(); return; }
      if (e.key !== 'Tab') return;
      var focusables = sheet.querySelectorAll('a[href], button:not([disabled])');
      if (focusables.length === 0) return;
      var first = focusables[0];
      var last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    });
  }

  if (btn) btn.addEventListener('click', openSheet);
  if (close) close.addEventListener('click', closeSheet);
  if (backdrop) backdrop.addEventListener('click', closeSheet);

  // Server pages: Back shows the normal nav, Go Back shows the server buttons
  var sheetBackBtn = document.getElementById('mobile-sheet-back-btn');
  if (sheetBackBtn) sheetBackBtn.addEventListener('click', function () { showSheetView('main'); });
  var sheetGoBackBtn = document.getElementById('mobile-sheet-goback-btn');
  if (sheetGoBackBtn) sheetGoBackBtn.addEventListener('click', function () { showSheetView('server'); });

  // Theme toggle for mobile
  if (themeToggle) {
    themeToggle.addEventListener('click', function() {
      if (typeof toggleTheme === 'function') {
        toggleTheme();
      } else {
        var isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        window.dispatchEvent(new CustomEvent('al:themechange'));
      }
    });
  }

  // Close sheet on any navigation link click
  document.querySelectorAll('.mobile-more-link').forEach(function(link) {
    link.addEventListener('click', closeSheet);
  });

  // Highlight active mobile nav link
  function markActiveMobile(path) {
    var links = document.querySelectorAll('.mobile-nav-link[data-match-prefix]');
    links.forEach(function(link) {
      var prefix = link.getAttribute('data-match-prefix');
      if (prefix && path.startsWith(prefix)) {
        link.classList.add('active-mobile');
        link.style.color = 'var(--theme-nav-text-active)';
      } else {
        link.classList.remove('active-mobile');
        link.style.color = '';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    markActiveMobile(window.location.pathname);
  });
  document.addEventListener('al:navigated', function () {
    markActiveMobile(window.location.pathname);
  });
})();
</script>
