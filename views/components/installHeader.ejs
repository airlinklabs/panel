<% if (typeof installed !== 'undefined') { %>
<% if (installed.failed) { %>
<div class="al-alert-danger mx-4 sm:mx-8 mt-8" role="alert">
  <div class="h-8 w-8 rounded-lg flex items-center justify-center shrink-0" style="background:var(--theme-danger-bg);">
    <%- icon('x', { class: 'h-4 w-4', style: 'color:var(--theme-danger)', strokeWidth: 2 }) %>
  </div>
  <div class="flex-1 min-w-0">
    <p class="text-sm font-medium" style="color:var(--theme-danger)">Installation failed</p>
    <p id="installFailReason" class="text-xs mt-0.5 break-words" style="color:var(--theme-text-muted)"><%= installed.error || 'Check the server logs or contact an administrator.' %></p>
  </div>
</div>
<% } else if (!installed.installed && !installed.error) { %>
<div id="installBanner" class="al-alert-info mx-4 sm:mx-8 mt-8">
  <div id="installIconWrap" class="h-8 w-8 rounded-lg flex items-center justify-center shrink-0" style="background:var(--theme-info-bg)">
    <%- icon('loader-circle', { id: 'installSpinner', class: 'h-4 w-4 animate-spin', style: 'color:var(--theme-info)', strokeWidth: 2 }) %>
  </div>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2">
      <p class="text-sm font-medium shrink-0" style="color:var(--theme-info)">Installing server</p>
      <span style="color:var(--theme-text-muted)">·</span>
      <p id="installStateText" class="text-xs truncate" style="color:var(--theme-text-muted)" aria-live="polite">Waiting for daemon…</p>
    </div>
  </div>
  <button id="installRetryBtn" class="hidden shrink-0 rounded-lg px-3 py-1.5 text-xs font-medium transition-colors outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 active:scale-95" style="background:var(--theme-accent);color:var(--theme-accent-text);">
    Retry install
  </button>
</div>

<script nonce="<%- nonce %>">
(function () {
  // Scope to this include's own container — installHeader is rendered in
  // both the desktop and mobile layouts on manage.ejs (mirrors), and each
  // instance must drive its own banner, not the first one in the document.
  const root = document.currentScript ? document.currentScript.parentNode : document;
  const serverUUID = '<%= server.UUID %>';
  const stateText  = root.querySelector('#installStateText');
  const spinnerEl  = root.querySelector('#installSpinner');
  const iconWrap   = root.querySelector('#installIconWrap');
  const banner     = root.querySelector('#installBanner');
  const retryBtn   = root.querySelector('#installRetryBtn');

  const startTime = Date.now();
  let finished  = false;
  let poller    = null;

  // Snapshot the original spinner markup so a retry pass can restore it.
  const originalSpinnerHtml = spinnerEl ? spinnerEl.innerHTML : '';
  const originalIconWrapClass = iconWrap ? iconWrap.className : '';
  const originalIconWrapBg = iconWrap ? iconWrap.style.background : '';

  function onLifecycleState(state) {
    if (!state || typeof state.type !== 'string') return;
    if (state.type === 'installed') { markDone(); return; }
    if (state.type === 'error') { markFailed(state.message || null); return; }
    if (state.message) stateText.textContent = state.message;
  }

  function setIcon(kind) {
    if (!spinnerEl) return;
    spinnerEl.classList.remove('animate-spin');
    spinnerEl.setAttribute('stroke', 'currentColor');
    spinnerEl.setAttribute('stroke-width', '2');
    const paths = {
      done: '<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>',
      fail: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>'
    };
    spinnerEl.innerHTML = paths[kind];
    if (iconWrap) {
      iconWrap.style.background = kind === 'done' ? 'var(--theme-success-bg)' : 'var(--theme-danger-bg)';
      iconWrap.className = 'h-8 w-8 rounded-lg flex items-center justify-center shrink-0';
      spinnerEl.style.color = kind === 'done' ? 'var(--theme-success)' : 'var(--theme-danger)';
    }
  }

  function resetIcon() {
    if (spinnerEl) {
      spinnerEl.innerHTML = originalSpinnerHtml;
      spinnerEl.setAttribute('stroke', 'currentColor');
      spinnerEl.setAttribute('stroke-width', '2');
      spinnerEl.classList.add('animate-spin');
      spinnerEl.classList.remove('text-emerald-500', 'text-red-500');
      spinnerEl.style.color = '';
    }
    if (iconWrap) {
      iconWrap.className = originalIconWrapClass;
      iconWrap.style.background = originalIconWrapBg;
    }
  }

  function markDone() {
    if (finished) return;
    finished = true;
    stateText.textContent = 'Installation complete';
    setIcon('done');
    if (poller) clearInterval(poller);
    if (window.retryDaemonConnection) {
      // On the server manage page we reconnect the sockets in place instead
      // of reloading; other pages don't have that plumbing, so reload there.
      setTimeout(function() {
        if (window.retryDaemonConnection) window.retryDaemonConnection();
        if (banner) banner.classList.add('hidden');
      }, 1200);
    } else {
      // Non-manage pages render install-gated content server-side; a single
      // state-transition reload after install completes is required to show
      // the page content. The persisted install toast already celebrates the
      // result, so no second toast is needed here.
      setTimeout(function() {
        if (banner) banner.classList.add('hidden');
      }, 400);
      setTimeout(function() { window.location.reload(); }, 1600);
    }
  }

  function markFailed(reason) {
    if (finished) return;
    finished = true;
    stateText.textContent = 'Installation failed';
    setIcon('fail');
    if (reason) {
      stateText.textContent = 'Installation failed: ' + reason;
      stateText.classList.remove('truncate');
      stateText.classList.add('whitespace-normal', 'break-words');
    }
    if (retryBtn) retryBtn.classList.remove('hidden');
  }

  // Graduated heartbeat: reassure, then nudge once an install runs long.
  const lastMessage = 'Waiting for daemon…';
  function heartbeat() {
    const elapsed = Math.floor((Date.now() - startTime) / 1000);
    let text;
    if (elapsed > 120)      text = 'Taking longer than expected — large images can take a while.';
    else if (elapsed > 30)  text = 'Still installing — most servers are ready in under two minutes.';
    else                    text = lastMessage;
    stateText.textContent = text;
  }

  retryBtn.addEventListener('click', function() {
    retryBtn.disabled = true;
    retryBtn.textContent = 'Retrying…';
    fetch('/server/' + encodeURIComponent(serverUUID) + '/reinstall', { method: 'POST', credentials: 'same-origin', headers: { 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' } })
      .then(function(r) {
        if (!r.ok) { return r.json().then(function(d) { throw new Error(d.error || 'Reinstall failed'); }); }
        if (window.retryDaemonConnection) {
          // Re-arm the banner for the new install pass without a reload.
          finished = false;
          stateText.textContent = 'Waiting for daemon…';
          stateText.classList.add('truncate');
          stateText.classList.remove('whitespace-normal', 'break-words');
          retryBtn.classList.add('hidden');
          retryBtn.disabled = false;
          retryBtn.textContent = 'Retry install';
          if (banner) banner.classList.remove('hidden');
          resetIcon();
          if (poller) clearInterval(poller);
          startPolling();
        } else {
          // State transition (reinstall re-arms the install banner). Reload
          // re-renders the install-gated page with the fresh state.
          if (window.showToast) showToast('Reinstalling server…', 'info');
          window.location.reload();
        }
      })
      .catch(function(err) {
        retryBtn.disabled = false;
        retryBtn.textContent = 'Retry install';
        if (window.modal && window.modal.alert) window.modal.alert(String(err.message || err));
      });
  });

  function poll() {
    if (finished) return;
    fetch('/server/' + serverUUID + '/status')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        const state = data.state || (data.installed ? 'installed' : data.failed ? 'failed' : 'installing');
        if (state === 'installed') markDone();
        else if (state === 'failed') markFailed(data.error);
      })
    .catch(function(err) { console.warn('Server status poll failed:', err); });
  }

  function startPolling() {
    if (poller) clearInterval(poller);
    poller = setInterval(function() { poll(); heartbeat(); }, 3000);
    poll();
    heartbeat();
  }

  // Realtime install — the shared /ws/realtime socket (footer.ejs) streams
  // daemon lifecycle events, so this banner no longer needs the old
  // per-page /events/:token socket or the /status round trip. The poll above
  // stays as a fallback while the socket is down.
  let realtimeWired = false;
  let realtimeSubscribed = false;

  function wireRealtime() {
    if (realtimeWired) return;
    const rt = window.alRealtime;
    if (!rt) return;
    realtimeWired = true;

    if (!realtimeSubscribed) {
      realtimeSubscribed = true;
      rt.subscribe(function (evt) {
        if (!evt || typeof evt.type !== 'string' || evt.type !== 'server.lifecycle.changed') return;
        const rid = evt.resource && evt.resource.type === 'server' ? String(evt.resource.id) : null;
        if (rid && rid !== serverUUID) return;
        onLifecycleState(evt.state);
      });
    }

    function resubscribe() { rt.watchEvents(serverUUID); }

    resubscribe();
    rt.onStatusChange(function (status) {
      if (status === 'connected') {
        resubscribe();
        if (poller) { clearInterval(poller); poller = null; }
      } else {
        startPolling();
      }
    });
  }

  if (window.alRealtime) wireRealtime();
  else window.addEventListener('al:realtime-ready', wireRealtime);

  startPolling();

  // Release the daemon event stream when navigating away (Turbo SPA keeps
  // this context alive across page loads), matching the watcher cleanup in
  // manage.ejs so the panel's event watcher can close its daemon socket.
  window.addEventListener('pagehide', function () {
    if (poller) { clearInterval(poller); poller = null; }
    if (window.alRealtime) {
      try { window.alRealtime.unwatchEvents(serverUUID); } catch (e) {}
    }
  }, { once: true });

  // Persistent install-progress toast. The record + job live in session
  // storage, so the toast survives navigation and keeps polling /status on
  // whatever page the user lands on until the server is installed or the
  // install fails. Group dedupe stops every server page from stacking one.
  if (window.showProgressToast) {
    window.showProgressToast('Installing server…', {
      indeterminate: true,
      group: 'install:' + serverUUID,
      job: { url: '/server/' + serverUUID + '/status', intervalMs: 3000 },
    });
  }
})();
</script>
<% } %>
<% } %>
