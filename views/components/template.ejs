<div id="colcont" class="transition-all duration-200">
  <!-- Search popup -->
  <div id="searchOverlay" class="al-sheet-overlay fixed inset-0 z-50 hidden items-start justify-center p-4"
    role="dialog" aria-modal="true" aria-label="<%= req.translations.navSearch || 'Search' %>"
    data-empty-title="<%= req.translations.searchEmptyTitle || 'No results for' %>"
    data-empty-hint="<%= req.translations.searchEmptyHint || 'Try a different term, or search for a server, user, node, or page.' %>"
    style="background:rgba(0,0,0,0.4); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); padding-top:14vh;">
    <div id="searchPanel" class="al-sheet-panel w-full max-w-xl rounded-2xl border overflow-hidden shadow-2xl"
      style="border-color:var(--theme-border); background:var(--theme-bg-card); box-shadow:0 25px 60px -12px rgba(0,0,0,0.35);">
      <div class="flex items-center gap-3 px-4 py-3.5 border-b" style="border-color:var(--theme-border);">
        <%- icon('search', { class: 'h-5 w-5 shrink-0', style: 'color:var(--theme-text-muted)' }) %>
        <input id="searchInput" type="text" aria-label="Search"
          placeholder="<%= req.translations.navSearch || 'Search' %>..."
          class="flex-1 bg-transparent outline-none text-sm min-w-0"
          style="color:var(--theme-text-strong);"
          role="combobox" aria-autocomplete="list" aria-expanded="false"
          aria-controls="searchResults" aria-activedescendant=""
          autocomplete="off" spellcheck="false">
        <span aria-hidden="true" class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium rounded-md"
          style="color:var(--theme-text-muted); background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">ESC</span>
      </div>
      <div id="searchResults" role="listbox" aria-label="Search results" class="p-2" style="max-height:45vh; overflow-y:auto;"></div>
      <div class="hidden sm:flex items-center gap-4 px-4 py-2.5 border-t text-[11px]" style="border-color:var(--theme-border); color:var(--theme-text-muted);">
        <span class="flex items-center gap-1.5"><kbd class="px-1 py-0.5 text-[10px] font-medium rounded" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">↑↓</kbd> navigate</span>
        <span class="flex items-center gap-1.5"><kbd class="px-1 py-0.5 text-[10px] font-medium rounded" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">Enter</kbd> open</span>
        <span class="flex items-center gap-1.5"><kbd class="px-1 py-0.5 text-[10px] font-medium rounded" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">Esc</kbd> close</span>
      </div>
    </div>
  </div>
</div>
<script nonce="<%- nonce %>" defer src="/javascript/shared/search.js?v=5"></script>
<style>
@keyframes search-pop-in  { from { opacity:0; transform:scale(0.92); } to { opacity:1; transform:scale(1); } }
@keyframes search-pop-out { from { opacity:1; transform:scale(1); } to { opacity:0; transform:scale(0.92); } }
.search-pop-in  { animation: search-pop-in 0.18s cubic-bezier(0.16,1,0.3,1) both; }
.search-pop-out { animation: search-pop-out 0.12s ease-in both; }
</style>
