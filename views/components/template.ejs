<!-- Sidebar -->
<div id="pc-sidebar" class="sidebar hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-56 lg:flex-col left-0" style="display:none;">
  <div id="pc-sidebar2" class="flex flex-col h-full">

    <!-- Static top: logo -->
    <div id="sidebar-logo-block" class="pl-6 pt-4 pb-4 flex min-w-0 shrink-0">
      <a href="/" id="sidebar-logo-link" class="flex items-center min-w-0">
        <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="Logo" class="logo-bg p-1 h-10 w-10 rounded-xl mr-3 shrink-0 inline-flex" style="background:var(--theme-logo-bg);">
        <h1 class="font-medium tracking-tight text-lg truncate min-w-0" style="color:var(--theme-text-strong);"><%= settings.title || 'Airlink' %></h1>
      </a>
    </div>

    <!-- Static: user info — clicking goes to account page -->
    <% if (user != null) { %>
    <a href="/account" id="sidebar-account-link" class="sidebar-special-link flex items-center space-x-4 py-4 px-4 border-y shrink-0 transition-colors group" style="border-color:var(--theme-nav-border);">
      <img loading="lazy" decoding="async" class="h-8 w-8 rounded-xl shrink-0" src="<%= user.avatar ? user.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(user.username) %>" alt="User avatar">
      <div class="min-w-0">
        <p class="text-sm font-medium truncate transition-colors" style="color:var(--theme-text-strong);">
          <span id="sidebar-username"><%= user.username %></span>
          <span style="color:var(--theme-text-muted);">
            <sup class="mt-1">#<%= String(user.id).padStart(4, '0') %></sup>
          </span>
        </p>
        <p id="sidebar-description" class="text-xs truncate" style="color:var(--theme-text-muted);"><%= user.description %></p>
      </div>
    </a>
    <% } %>

    <!-- Scrollable nav -->
    <nav class="flex-1 overflow-y-auto">
      <ul role="list" class="py-2">
        <li>
          <ul role="list" class="-mx-2 space-y-1 relative">
            <div id="active-background" class="ml-1.5 absolute left-2 w-[calc(97%-1.5rem)] h-9 transition-none duration-0 z-[-1] rounded-xl opacity-0"></div>
            <%
            const sidebarItems = regularMenuItems || (global.uiComponentStore ? global.uiComponentStore.getSidebarItems(undefined, false) : []);
            const isServerPage = (typeof server !== 'undefined' && server && typeof req !== 'undefined' && req && (req.path || req.originalUrl || '').startsWith('/server/'));
            const srvNavT = (typeof req !== 'undefined' && req && req.translations) || {};
            %>
            <div id="sidebar-main-view" class="sidebar-view<%= isServerPage ? ' hidden' : '' %>">
            <% if (isServerPage) { %>
              <li class="nav-item sidebar-view-item" style="--i:0">
                <button type="button" id="sidebar-goback-btn" class="sidebar-view-toggle nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 min-h-[44px] w-full rounded-xl text-sm leading-6 font-normal transition-all duration-200 active:scale-95" style="color:var(--theme-nav-text);">
                  <%- icon('arrow-left', { class: 'w-5 h-5 mt-0.5' }) %>
                  <span><%= srvNavT.navGoBack || 'Go Back' %></span>
                </button>
              </li>
            <% } %>
            <% if (!sidebarItems || sidebarItems.length === 0) { %>
              <li class="nav-item sidebar-view-item" style="--i:0">
                <a href="/" class="nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal transition-all duration-200" style="color:var(--theme-nav-text);" data-search="container instances servers" data-match-prefix="/server">
                  <%- icon('layout-dashboard', { class: 'w-5 h-5 mt-0.5' }) %>
                  <span><%= req.translations.navDashboard || 'Dashboard' %></span>
                </a>
              </li>
            <% } else {
              sidebarItems.forEach((item, i) => {
            %>
              <li class="nav-item sidebar-view-item" style="--i:<%= i + 1 %>">
                <a href="<%= item.url %>" class="nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal transition-all duration-200" style="color:var(--theme-nav-text);"<% if (item.matchPrefix) { %> data-match-prefix="<%= item.matchPrefix %>"<% } %>>
                  <%- item.icon %>
                  <span><%= item.label %></span>
                </a>
              </li>
            <% }); } %>
            
            <% if (user != null && user.isAdmin === true) { %>
            <% let adminAnimIdx = 0; %>
                          <p class="pl-8 text-xs font-medium pt-6 pb-2" style="color:var(--theme-nav-text);"><span><%= req.translations.navAdminPanel || 'Admin Panel' %></span></p>

                          <p class="pl-8 text-xs font-medium pt-4 pb-1.5 uppercase tracking-wide" style="color:var(--theme-text-muted);"><span>Core</span></p>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/overview" searchdata="admin overview control" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('layout-grid', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span><%= req.translations.navOverview || 'Overview' %></span>
                            </a>
                          </li>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/servers" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('server', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span><%= req.translations.navServers || 'Servers' %></span>
                            </a>
                          </li>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/users" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('users', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span><%= req.translations.navUsers || 'Users' %></span>
                            </a>
                          </li>

                          <p class="pl-8 text-xs font-medium pt-4 pb-1.5 uppercase tracking-wide" style="color:var(--theme-text-muted);"><span>Infrastructure</span></p>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/nodes" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('network', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span><%= req.translations.navNodes || 'Nodes' %></span>
                            </a>
                          </li>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/activity" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('activity', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span>Activity Log</span>
                            </a>
                          </li>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/images" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('box', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span><%= req.translations.navImages || 'Images' %></span>
                            </a>
                          </li>

                          <p class="pl-8 text-xs font-medium pt-4 pb-1.5 uppercase tracking-wide" style="color:var(--theme-text-muted);"><span>Extensions</span></p>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/addons" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('puzzle', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span><%= req.translations.navAddons || 'Addons' %></span>
                            </a>
                          </li>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/apikeys" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('key', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span><%= req.translations.navApiKeys || 'API Keys' %></span>
                            </a>
                          </li>

                          <p class="pl-8 text-xs font-medium pt-4 pb-1.5 uppercase tracking-wide" style="color:var(--theme-text-muted);"><span>Configuration</span></p>
                          <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
<a href="/admin/settings" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- icon('settings', { class: 'w-5 mt-0.5 h-5', strokeWidth: 1.5 }) %>
                              <span><%= req.translations.navSettings || 'Settings' %></span>
                            </a>
                          </li>

              <% if (adminMenuItems && adminMenuItems.length > 0) {
                adminMenuItems.forEach(item => {
              %>
              <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
                <a href="<%= item.url %>" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);">
                              <%- item.icon %>
                              <span><%= item.label %></span>
                            </a>
                          </li>
                          <% }); } %>
                        <% } %>
            </div>

            <% if (isServerPage && global.uiComponentStore) {
              const srvMenuItems = global.uiComponentStore.getServerMenuItems();
              const srvIsAdmin = (typeof user !== 'undefined' && user && user.isAdmin === true);
              const srvIsSub = (typeof req !== 'undefined' && req && req.subUser) ? true : false;
              const srvEntries = srvMenuItems.filter(item => {
                if (item.isAdminItem && !srvIsAdmin) return false;
                if (item.ownerOnly && srvIsSub) return false;
                if (item.feature && !(typeof features !== 'undefined' && features && features.includes(item.feature))) return false;
                return true;
              }).map(item => ({
                item,
                url: (item.url || '#').replace(':uuid', server.UUID).replace(':id', server.id),
              }));
              const srvGroupOrder = ['run', 'data', 'manage', 'settings'];
              const srvT = (typeof req !== 'undefined' && req && req.translations) || {};
              const srvGroupLabel = (g) => {
                if (g === 'run') return srvT.navGroupRun || 'Run';
                if (g === 'data') return srvT.navGroupData || 'Data';
                if (g === 'manage') return srvT.navGroupManage || 'Manage';
                return srvT.navGroupSettings || 'Settings';
              };
              const srvGrouped = srvGroupOrder
                .map(g => ({ g, entries: srvEntries.filter(e => (e.item.group || 'manage') === g) }))
                .filter(grp => grp.entries.length > 0);
              if (srvGrouped.length > 0) {
                let srvAnimIdx = 0;
            %>
            <div id="sidebar-server-view" class="sidebar-view showing">
              <li class="nav-item">
                <button type="button" id="sidebar-back-btn" class="sidebar-view-toggle nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 min-h-[44px] w-full rounded-xl text-sm leading-6 font-normal transition-all duration-200 active:scale-95" style="color:var(--theme-nav-text);">
                  <%- icon('arrow-left', { class: 'w-5 h-5 mt-0.5' }) %>
                  <span><%= srvT.navBack || 'Back' %></span>
                </button>
              </li>
              <p class="pl-8 text-xs font-medium pt-6 pb-2" style="color:var(--theme-nav-text);"><span class="block truncate"><%= server.name || (srvT.navServerControls || 'Server Controls') %></span></p>
              <% srvGrouped.forEach(grp => { %>
                <p class="pl-8 text-xs font-medium pt-4 pb-1.5 uppercase tracking-wide" style="color:var(--theme-text-muted);"><span><%= srvGroupLabel(grp.g) %></span></p>
                <% grp.entries.forEach(entry => { %>
                  <li class="nav-item server-anim-in" style="--i:<%= srvAnimIdx++ %>">
                    <a href="<%= entry.url %>" class="transition nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal" style="color:var(--theme-nav-text);" data-server-control-link>
                      <%- entry.item.icon.replace(/class="[^"]*"/, 'class="w-5 h-5 mt-0.5 shrink-0"') %>
                      <span><%= entry.item.label %></span>
                    </a>
                  </li>
                <% }); %>
              <% }); %>
            </div>
            <% } %>
            <% } %>

            
          </ul>
        </li>
      </ul>
    </nav>

    <style>
    /* Server/main sidebar view switching */
    @keyframes sidebar-view-fade {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    #sidebar-server-view.showing, #sidebar-main-view.showing {
      animation: sidebar-view-fade 140ms ease-out both;
    }
    /* Normal sidebar items swipe in from the left */
    #sidebar-main-view .sidebar-view-item { opacity: 0; }
    #sidebar-main-view.showing .sidebar-view-item {
      animation: sidebar-swipe-left 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: min(calc(var(--i, 0) * 25ms), 320ms);
    }
    /* Server buttons swipe in from the right */
    #sidebar-server-view .server-anim-in { opacity: 0; }
    #sidebar-server-view.showing .server-anim-in {
      animation: sidebar-swipe-right 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
    @keyframes sidebar-swipe-left {
      from { opacity: 0; transform: translateX(-16px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes sidebar-swipe-right {
      from { opacity: 0; transform: translateX(16px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      #sidebar-server-view.showing, #sidebar-main-view.showing,
      #sidebar-server-view.showing .server-anim-in,
      #sidebar-main-view.showing .sidebar-view-item { animation: none; }
      #sidebar-server-view .server-anim-in,
      #sidebar-main-view .sidebar-view-item { opacity: 1; }
    }
    </style>



    <!-- Static bottom: logout -->
    <div class="shrink-0 border-t" style="border-color:var(--theme-nav-border);">
      <a href="/logout" id="sidebar-logout-link" class="sidebar-special-link group flex gap-x-3 pl-6 py-4 text-sm font-medium leading-6 transition-colors duration-200" style="color:var(--theme-danger);">
        <%- icon('log-out', { class: 'w-5 h-5 mt-0.5 shrink-0', strokeWidth: 1.5 }) %>
        <span><%= req.translations.navLogout || 'Logout' %></span>
      </a>
    </div>

  </div>
</div>

<script nonce="<%- nonce %>">
(function () {
  const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  const ws = new WebSocket(wsProtocol + '//' + window.location.host + '/online-check');
  ws.addEventListener('error', function () { /* WebSocket errors are handled by reconnection logic */ });

  function themeVar(name, fallback) {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  // Highlight account/logout when on those pages
  function markSpecialLinks(path) {
    const pillBg = themeVar('--theme-text', '#171717');
    const pillFg = themeVar('--theme-bg', '#f0f0f0');
    const account = document.getElementById('sidebar-account-link');
    const logout  = document.getElementById('sidebar-logout-link');
    const logo = document.getElementById('sidebar-logo-link');
    if (account) {
      const onAccount = path === '/account' || path.startsWith('/account/');
      const userText = account.querySelector('#sidebar-username');
      if (onAccount) {
        account.style.background = pillBg;
        account.style.color = pillFg;
        account.style.fontWeight = '700';
        if (userText) userText.parentElement.style.color = pillFg;
      } else {
        account.style.background = '';
        account.style.color = '';
        account.style.fontWeight = '';
        if (userText) userText.parentElement.style.color = '';
      }
    }
    if (logo) {
      const onCredits = path === '/credits' || path.startsWith('/credits/');
      const logoBlock = document.getElementById('sidebar-logo-block');
      const logoTitle = logo.querySelector('h1');
      const logoImg = logo.querySelector('img');
      if (onCredits) {
        if (logoBlock) {
          logoBlock.style.background = pillBg;
          logoBlock.style.borderRadius = '0.75rem';
        }
        logo.style.color = pillFg;
        if (logoImg) logoImg.style.background = pillFg;
        if (logoTitle) {
          logoTitle.style.color = pillFg;
          logoTitle.style.fontWeight = '700';
        }
      } else {
        if (logoBlock) {
          logoBlock.style.background = '';
          logoBlock.style.borderRadius = '';
        }
        logo.style.color = '';
        if (logoImg) logoImg.style.background = '';
        if (logoTitle) {
          logoTitle.style.color = '';
          logoTitle.style.fontWeight = '';
        }
      }
    }
    if (logout) {
      logout.style.background = '';
    }
  }

  // Mark active nav link
  function markActiveNav(path) {
    const pillBg = themeVar('--theme-text', '#171717');
    const pillFg = themeVar('--theme-bg', '#f0f0f0');

    const srvLinks = document.querySelectorAll('[data-server-control-link]');
    let srvBest = null;
    let bestLen = -1;
    srvLinks.forEach(function(link) {
      link.classList.remove('active');
      link.style.color = '';
      link.style.background = '';
      const href = link.getAttribute('href') || '';
      const matched = path === href || (href !== '/' && path.startsWith(href + '/'));
      if (matched && href.length > bestLen) {
        bestLen = href.length;
        srvBest = link;
      }
    });
    if (srvBest) {
      srvBest.classList.add('active');
      srvBest.style.color = pillFg;
      srvBest.style.background = pillBg;
      srvBest.style.borderRadius = '0.75rem';
    }

    const links = document.querySelectorAll('.nav-link');
    links.forEach(function(link) {
      if (link.hasAttribute('data-server-control-link')) return;
      const href = link.getAttribute('href');
      const prefix = link.getAttribute('data-match-prefix');
      // On a server page the server controls own the highlight — don't
      // also light up the Dashboard item whose prefix matches /server.
      if (srvBest && prefix && path.startsWith(prefix)) return;
      let active = false;
      if (href && path === href) {
        active = true;
      } else if (prefix && path.startsWith(prefix)) {
        active = true;
      } else if (href && path.startsWith(href + '/')) {
        active = true;
      }
      if (active) {
        link.classList.add('active');
        link.style.color = pillFg;
        link.style.background = pillBg;
        link.style.borderRadius = '0.75rem';
      } else {
        link.classList.remove('active');
        link.style.color = '';
        link.style.background = '';
      }
    });
  }

  // If the active nav link sits below the sidebar's scrollable fold, bring
  // it fully into view on page load. If it is the last button (nothing
  // below it), the scroll clamps to the bottom of the list.
  function showActiveNavInView() {
    const activeLink = document.querySelector('#pc-sidebar .nav-link.active, #pc-sidebar [data-server-control-link].active');
    if (!activeLink) return;
    const container = activeLink.closest('nav');
    if (!container) return;
    const pad = 16;
    const cTop = container.getBoundingClientRect().top;
    const cBottom = container.getBoundingClientRect().bottom;
    const r = activeLink.getBoundingClientRect();
    if (r.bottom + pad > cBottom) {
      container.scrollTop = container.scrollTop + (r.bottom + pad - cBottom);
    } else if (r.top - pad < cTop) {
      container.scrollTop = container.scrollTop - (cTop - (r.top - pad));
    }
  }

  function showSidebarView(name) {
    const serverView = document.getElementById('sidebar-server-view');
    const mainView = document.getElementById('sidebar-main-view');
    let incoming = null;
    if (serverView) {
      const toServer = name === 'server';
      serverView.classList.toggle('hidden', !toServer);
      serverView.classList.remove('showing');
      if (toServer) incoming = serverView;
    }
    if (mainView) {
      const toMain = name !== 'server';
      mainView.classList.toggle('hidden', !toMain);
      mainView.classList.remove('showing');
      if (toMain) incoming = mainView;
    }
    if (incoming) {
      void incoming.offsetWidth;
      incoming.classList.add('showing');
    }
  }

  function wireSidebarViewToggle() {
    const backBtn = document.getElementById('sidebar-back-btn');
    if (backBtn) backBtn.addEventListener('click', function () { showSidebarView('main'); });
    const goBackBtn = document.getElementById('sidebar-goback-btn');
    if (goBackBtn) goBackBtn.addEventListener('click', function () { showSidebarView('server'); });
  }

  document.addEventListener('DOMContentLoaded', function () {
    // Show sidebar first — rects are all zeros while display:none, so the
    // scroll check below would never fire.
    document.getElementById('pc-sidebar').style.display = '';
    markSpecialLinks(window.location.pathname);
    markActiveNav(window.location.pathname);
    showActiveNavInView();
    wireSidebarViewToggle();
    showSidebarView(window.location.pathname.startsWith('/server/') ? 'server' : 'main');
  });
  document.addEventListener('al:navigated', function () {
    markSpecialLinks(window.location.pathname);
    markActiveNav(window.location.pathname);
    showActiveNavInView();
    if (document.getElementById('sidebar-server-view')) {
      if (window.location.pathname.startsWith('/server/')) {
        showSidebarView('server');
      } else {
        showSidebarView('main');
        const toggles = document.querySelectorAll('.sidebar-view-toggle');
        for (let t = 0; t < toggles.length; t++) toggles[t].style.display = 'none';
      }
    }
  });
})();
</script>

<div id="colcont" class="lg:pl-56 pb-16 lg:pb-0">
  <div class="fixed top-0 left-0 lg:left-56 right-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b px-4 sm:gap-x-6 sm:px-4 lg:px-4" style="background:var(--theme-nav-bg); border-color:var(--theme-nav-border);">
      <div class="flex flex-1 gap-x-4 self-stretch lg:gap-x-6">
        <!-- Search button -->
        <div class="flex items-center shrink-0 lg:-ml-2">
          <button id="searchButton" type="button"
            class="flex items-center gap-2.5 h-10 px-3.5 rounded-xl cursor-pointer transition-all duration-200 hover:opacity-80 active:scale-95"
            style="border:1px solid var(--theme-border-input); background:var(--theme-bg-secondary);"
            aria-label="<%= req.translations.navSearch || 'Search' %>" aria-haspopup="dialog" aria-expanded="false">
            <%- icon('search', { class: 'h-5 w-5', style: 'color:var(--theme-text-muted)' }) %>
            <span class="hidden sm:block text-sm" style="color:var(--theme-text-muted);"><%= req.translations.navSearch || 'Search' %></span>
            <span aria-hidden="true" class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium rounded-md"
              style="color:var(--theme-text-muted); background:var(--theme-bg-card); border:1px solid var(--theme-border);">CTRL K</span>
          </button>
        </div>

      <!-- Admin breadcrumbs (desktop) -->
      <div id="topbar-breadcrumbs" class="hidden lg:flex items-center justify-center min-w-0 flex-1 text-[11px]" style="color:var(--theme-text-muted);"></div>

      <!-- Theme toggle switch -->
      <div class="flex items-center shrink-0 ml-2">
        <div id="theme-toggle-topbar" class="theme-toggle-switch" role="button" tabindex="0" aria-label="Toggle theme" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();if(typeof toggleTheme==='function')toggleTheme();}">
          <div class="theme-toggle-knob"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search popup -->
  <div id="searchOverlay" class="al-sheet-overlay fixed inset-0 z-50 hidden items-start justify-center p-4"
    role="dialog" aria-modal="true" aria-label="<%= req.translations.navSearch || 'Search' %>"
    data-empty-title="<%= req.translations.searchEmptyTitle || 'No results for' %>"
    data-empty-hint="<%= req.translations.searchEmptyHint || 'Try a different term, or search for a server, user, node, or page.' %>"
    style="background:rgba(0,0,0,0.4); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); padding-top:14vh;">
    <div id="searchPanel" class="al-sheet-panel w-full max-w-xl rounded-2xl border overflow-hidden shadow-2xl"
      style="border-color:var(--theme-border); background:var(--theme-bg-card); box-shadow:0 25px 60px -12px rgba(0,0,0,0.35);">
      <div class="flex items-center gap-3 px-4 py-3.5 border-b" style="border-color:var(--theme-border);">
        <%- icon('search', { class: 'h-5 w-5 shrink-0', style: 'color:var(--theme-text-muted)' }) %>
        <input id="searchInput" type="text" aria-label="Search"
          placeholder="<%= req.translations.navSearch || 'Search' %>..."
          class="flex-1 bg-transparent outline-none text-sm min-w-0"
          style="color:var(--theme-text-strong);"
          role="combobox" aria-autocomplete="list" aria-expanded="false"
          aria-controls="searchResults" aria-activedescendant=""
          autocomplete="off" spellcheck="false">
        <span aria-hidden="true" class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium rounded-md"
          style="color:var(--theme-text-muted); background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">ESC</span>
      </div>
      <div id="searchResults" role="listbox" aria-label="Search results" class="p-2" style="max-height:45vh; overflow-y:auto;"></div>
      <div class="hidden sm:flex items-center gap-4 px-4 py-2.5 border-t text-[11px]" style="border-color:var(--theme-border); color:var(--theme-text-muted);">
        <span class="flex items-center gap-1.5"><kbd class="px-1 py-0.5 text-[10px] font-medium rounded" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">↑↓</kbd> navigate</span>
        <span class="flex items-center gap-1.5"><kbd class="px-1 py-0.5 text-[10px] font-medium rounded" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">Enter</kbd> open</span>
        <span class="flex items-center gap-1.5"><kbd class="px-1 py-0.5 text-[10px] font-medium rounded" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">Esc</kbd> close</span>
      </div>
    </div>
  </div>
</div>
<script nonce="<%- nonce %>" defer src="/javascript/shared/search.js?v=5"></script>
<style>
@keyframes search-pop-in  { from { opacity:0; transform:scale(0.92); } to { opacity:1; transform:scale(1); } }
@keyframes search-pop-out { from { opacity:1; transform:scale(1); } to { opacity:0; transform:scale(0.92); } }
.search-pop-in  { animation: search-pop-in 0.18s cubic-bezier(0.16,1,0.3,1) both; }
.search-pop-out { animation: search-pop-out 0.12s ease-in both; }
.theme-toggle-switch {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 70px;
  height: 30px;
  padding: 4px 10px;
  border-radius: 50px;
  cursor: pointer;
  background: var(--theme-text);
  border: 1px solid var(--theme-text);
  flex-shrink: 0;
  transition: background 0.25s ease, border-color 0.25s ease;
}
.dark .theme-toggle-switch {
  background: var(--theme-bg);
  border-color: var(--theme-bg);
}
.theme-toggle-knob {
  position: absolute;
  z-index: 1;
  top: 5px;
  left: 3px;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--theme-bg);
  transition: transform 0.22s var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)), background 0.25s ease;
}
.dark .theme-toggle-knob {
  transform: translateX(33px);
  background: var(--theme-text);
}
</style>
<script nonce="<%- nonce %>">
(function() {
  const btn = document.getElementById('theme-toggle-topbar');
  btn.addEventListener('click', function() {
    if (typeof toggleTheme === 'function') toggleTheme();
  });
})();
</script>
<script nonce="<%- nonce %>">
(function () {
  const ov = document.getElementById('pl-overlay');
  if (!ov) return;
  ov.style.left   = '224px';
  ov.style.top    = '64px';
  ov.style.right  = '0';
  ov.style.bottom = '0';
  ov.style.display = 'flex';
})();
</script>
