<!DOCTYPE html>
<html class="h-full js-loading" lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
    <title><%= settings.title %> - <%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/layout-animations.css">
    <link rel="stylesheet" href="/styles/motion.css">
    <link rel="icon" href="<%= settings.favicon && settings.favicon.startsWith('/') ? settings.favicon : '/favicon.ico' %>" type="image/x-icon">
    <link rel="shortcut icon" href="<%= settings.favicon && settings.favicon.startsWith('/') ? settings.favicon : '/favicon.ico' %>" type="image/x-icon">
    <!-- Default themes — always loaded, always the base layer -->
    <link rel="stylesheet" href="/themes/default-light.css">
    <link rel="stylesheet" href="/themes/default-dark.css">
    <!-- Optional override themes (solarized, material, user-defined) -->
    <% if (settings.lightTheme && settings.lightTheme !== 'default') { %>
    <link rel="stylesheet" href="<%= settings.lightTheme %>" id="light-theme-css" data-theme-mode="light">
    <% } %>
    <% if (settings.darkTheme && settings.darkTheme !== 'default') { %>
    <link rel="stylesheet" href="<%= settings.darkTheme %>" id="dark-theme-css" data-theme-mode="dark">
    <% } %>
    <link rel="stylesheet" href="/fonts/general-sans/general-sans.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.14.0/css/all.min.css">
    <script nonce="<%- nonce %>" src="/js/csrf.js"></script>
    <script nonce="<%- nonce %>" src="/javascript/shared/format-switcher.js"></script>
    <script nonce="<%- nonce %>" src="/javascript/shared/animations.js"></script>
    <script nonce="<%- nonce %>" src="/javascript/shared/custom-select.js"></script>
    <script nonce="<%- nonce %>" src="/javascript/shared/page-loader.js"></script>
    <script nonce="<%- nonce %>" src="/javascript/shared/checkbox-anim.js"></script>
    <script nonce="<%- nonce %>" src="/javascript/shared/layout-animations.js"></script>
    <style>
      html, body, * { scrollbar-width: none; -ms-overflow-style: none; }
      ::-webkit-scrollbar { display: none; }
      html, body { transition: background-color 0.25s ease-in, color 0.25s ease-in; background: var(--theme-bg); color: var(--theme-text); }
      /* Safe area handling for notched devices */
      body { 
        padding-top: env(safe-area-inset-top);
        padding-left: env(safe-area-inset-left);
        padding-right: env(safe-area-inset-right);
      }
      /* Mobile top bar spacing */
      @media (max-width: 1023px) {
        #page-content, #server-page-body { padding-top: 56px; padding-bottom: 64px; }
      }
      /* Pre-hide animatable content before JS runs so there's no flash-then-hide jitter */
      .js-loading #page-content > *:not(.mobile-top-bar):not(.mobile-bottom-nav):not(.mobile-more-sheet):not([style*="position: fixed"]),
      .js-loading #server-page-body > * {
        opacity: 0;
        transform: translateY(14px);
      }
    </style>
</head>
<body style="font-family: 'General Sans'" class="h-full">

<a href="#page-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[99999] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-neutral-900 focus:text-white focus:text-sm focus:font-medium focus:shadow-lg">Skip to main content</a>

<!-- Page loader overlay -->
<div id="pl-overlay" class="al-page-loader" style="display:none;">
  <div id="pl-inner" style="display:flex;flex-direction:column;align-items:center;gap:18px;">
    <img src="/assets/logo.png" alt="" style="width:42px;height:42px;object-fit:contain;border-radius:10px;display:block;" onerror="this.style.display='none'">
    <p style="margin:0;margin-top:-4px;font-family:'General Sans',sans-serif;font-size:14px;font-weight:600;letter-spacing:-0.015em;color:var(--theme-text-strong);" id="pl-title"><%= settings.title %></p>
    <div style="width:128px;height:1.5px;border-radius:2px;overflow:hidden;background:var(--theme-border-subtle);" id="pl-track">
      <div id="pl-bar" style="height:100%;width:0%;border-radius:2px;transition:width 260ms cubic-bezier(0.4,0,0.2,1);background:var(--theme-text-strong);"></div>
    </div>
    <p id="pl-msg" style="margin:0;margin-top:-4px;font-family:'General Sans',sans-serif;font-size:11px;color:var(--theme-text-muted);letter-spacing:0.01em;transition:opacity 180ms ease;">Preparing your experience...</p>
  </div>
</div>
<script nonce="<%- nonce %>">
function initializeTheme() {
    const userPreference = localStorage.getItem('theme');
    const systemPreference = window.matchMedia('(prefers-color-scheme: dark)').matches;

    if (userPreference === 'dark' || (!userPreference && systemPreference)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    applyThemeSheets();
  }

  function applyThemeSheets() {
    const isDark = document.documentElement.classList.contains('dark');
    const lightSheet = document.getElementById('light-theme-css');
    const darkSheet = document.getElementById('dark-theme-css');
    if (lightSheet) lightSheet.disabled = isDark;
    if (darkSheet) darkSheet.disabled = !isDark;
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    applyThemeSheets();
    if (typeof setTerminalTheme === 'function') {
      setTerminalTheme();
    }
    window.dispatchEvent(new CustomEvent('al:themechange'));
  }

  initializeTheme();
</script>
<%- include("./bottomNav") %>
<%- include("./modal") %>
<%- include("./toast") %>
