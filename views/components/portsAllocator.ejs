<!-- Ports allocator popup — window.PortsAllocator.open({ title, assignedPorts, availablePorts, requirements, onSave })
     availablePorts: [{ port, label }]  assignedPorts: [{ name, internalPort, externalPort, primary }] -->
<div id="paModal" class="al-sheet-overlay fixed inset-0 z-50 hidden items-center justify-center p-4" role="presentation" aria-hidden="true">
  <div id="paPanel" role="dialog" aria-modal="true" aria-labelledby="paTitle" class="al-sheet-panel relative w-full max-w-2xl rounded-2xl border overflow-hidden shadow-2xl"
    style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <div class="flex items-center gap-3 px-5 py-4 border-b" style="border-color:var(--theme-border)">
      <span class="flex items-center justify-center w-8 h-8 rounded-lg shrink-0"
        style="background:var(--theme-accent-subtle); color:var(--theme-text-strong)">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
        </svg>
      </span>
      <div class="min-w-0">
        <h2 id="paTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)">Assign ports</h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)">External ports are drawn from the node's allocation</p>
      </div>
      <button type="button" id="paClose" class="ml-auto p-2.5 rounded-lg transition hover:bg-neutral-200 dark:hover:bg-white/10" style="color:var(--theme-text-muted)" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="px-5 py-4">
      <div class="flex items-center justify-between mb-3">
        <p class="text-xs font-medium" style="color:var(--theme-text-muted)">Port mappings</p>
        <span id="paCount" class="text-[10px] font-medium px-2 py-0.5 rounded-full"
          style="background:var(--theme-accent-subtle); color:var(--theme-text-strong)"></span>
      </div>
      <div id="paRows" class="space-y-2.5 max-h-[46vh] overflow-y-auto pr-1"></div>
      <div id="paEmpty" class="hidden text-center py-8">
        <p class="text-sm" style="color:var(--theme-text-muted)">No ports available on this node</p>
      </div>
      <button type="button" id="paAddRow" class="mt-3 w-full flex items-center justify-center gap-1.5 rounded-xl border border-dashed px-3 py-2.5 text-xs font-medium transition hover:bg-neutral-100 dark:hover:bg-white/5"
        style="color:var(--theme-text-muted); border-color:var(--theme-border)">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add port
      </button>
    </div>

    <div class="flex items-center justify-between gap-2 px-5 py-4 border-t" style="border-color:var(--theme-border)">
      <p id="paHint" class="text-[11px]" style="color:var(--theme-text-muted)"></p>
      <div class="flex gap-2 shrink-0">
        <button type="button" id="paCancel" class="al-btn-secondary px-4 py-2 text-xs font-medium">Cancel</button>
        <button type="button" id="paSave" class="al-btn-primary px-4 py-2 text-xs font-medium">Save ports</button>
      </div>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
(function () {
  if (window.PortsAllocator) return;

  const modal = document.getElementById('paModal');
  const panel = document.getElementById('paPanel');
  const rowsEl = document.getElementById('paRows');
  const emptyEl = document.getElementById('paEmpty');
  const countEl = document.getElementById('paCount');
  const hintEl = document.getElementById('paHint');
  const addBtn = document.getElementById('paAddRow');

  const openLists = [];

  let cfg = null;
  let rows = [];
  let lastFocused = null;

  function rowKey(row) { return row.name + '|' + row.internalPort + '|' + row.externalPort; }
  function rowsChanged() { return rows.map(rowKey).join(';') !== cfg._lastKey; }

  function open(settings) {
    cfg = settings || {};
    cfg.requirements = cfg.requirements || [];
    rows = (cfg.assignedPorts || []).map(function (r) { return Object.assign({}, r); });
    cfg._lastKey = rows.map(rowKey).join(';');
    lastFocused = document.activeElement;

    if (window.Animate) Animate.openModal(modal, panel);
    else { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    modal.setAttribute('aria-hidden', 'false');
    render();
    var first = panel.querySelector('input, button');
    if (first) setTimeout(function () { first.focus(); }, 60);
  }

  function forceClose() {
    // Drop the veto hook so the confirm-initiated close can't re-trigger
    // the dirty check (infinite loop guard).
    modal._beforeClose = null;
    const done = function () {
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      lastFocused = null;
    };
    if (window.Animate) Animate.closeModal(modal, panel, done);
    else { modal.classList.add('hidden'); modal.classList.remove('flex'); done(); }
    modal.setAttribute('aria-hidden', 'true');
  }

  function close() {
    if (rowsChanged()) {
      const confirm = window.modal && typeof window.modal.confirm === 'function'
        ? window.modal.confirm
        : null;
      if (confirm) {
        confirm({
          title: 'Discard unsaved port changes?',
          body: 'You have unsaved changes to this port mapping. They will be lost.',
          danger: true,
          confirmLabel: 'Discard changes',
          onConfirm: forceClose
        });
        return;
      }
    }
    forceClose();
  }

  function commit() {
    rows = rows.filter(function (row) { return row.name && row.internalPort && row.externalPort; });
    rows.forEach(function (row, index) { row.primary = index === 0; });
    cfg._lastKey = rows.map(rowKey).join(';');
    if (cfg.onSave) cfg.onSave(rows);
    close();
  }

  function render() {
    rowsEl.innerHTML = '';
    const avail = cfg.availablePorts || [];
    const min = cfg.requirements.length;
    const used = new Set(rows.filter(function (r) { return r.externalPort; }).map(function (r) { return String(r.externalPort); }));

    if (avail.length === 0) {
      emptyEl.classList.remove('hidden');
      addBtn.classList.add('hidden');
      countEl.textContent = '0 ports';
    } else {
      emptyEl.classList.add('hidden');
      addBtn.classList.remove('hidden');
      countEl.textContent = rows.length + ' port' + (rows.length === 1 ? '' : 's') + ' assigned';
    }

    rows.forEach(function (row, index) {
      const el = document.createElement('div');
      el.className = 'pa-row rounded-xl border p-3';
      el.style.borderColor = 'var(--theme-border)';
      el.style.background = 'var(--theme-bg-secondary)';

      const topRow = document.createElement('div');
      topRow.className = 'flex items-center gap-2 mb-2';

      const nameLabel = document.createElement('span');
      nameLabel.className = 'text-[11px] font-medium';
      nameLabel.style.color = 'var(--theme-text-muted)';
      nameLabel.textContent = 'Port name';
      topRow.appendChild(nameLabel);

      if (index === 0) {
        const badge = document.createElement('span');
        badge.className = 'px-1.5 py-0.5 rounded text-[9px] font-semibold uppercase tracking-wide';
        badge.style.background = 'var(--theme-accent)';
        badge.style.color = 'var(--theme-accent-text)';
        badge.textContent = 'Primary';
        topRow.appendChild(badge);
      }

      if (index < min) {
        const req = document.createElement('span');
        req.className = 'px-1.5 py-0.5 rounded text-[9px] font-semibold uppercase tracking-wide';
        req.style.background = 'var(--theme-accent-subtle)';
        req.style.color = 'var(--theme-text-strong)';
        req.textContent = 'Required';
        topRow.appendChild(req);
      } else {
        const rmBtn = document.createElement('button');
        rmBtn.type = 'button';
        rmBtn.className = 'pa-rm ml-auto rounded-lg p-2.5 transition hover:bg-neutral-200 dark:hover:bg-white/10';
        rmBtn.style.color = 'var(--theme-danger)';
        rmBtn.setAttribute('aria-label', 'Remove port');
        rmBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l.608 10.34A2.25 2.25 0 0 0 9.6 20h4.8a2.25 2.25 0 0 0 2.242-2.16L17.25 7.5M12 11.25v4.5M8.25 7.5V5.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125V7.5M5.25 7.5h13.5" /></svg>';
        rmBtn.addEventListener('click', function () {
          rows.splice(index, 1);
          render();
        });
        topRow.appendChild(rmBtn);
      }

      el.appendChild(topRow);

      const nameInput = document.createElement('input');
      nameInput.type = 'text';
      nameInput.className = 'w-full rounded-lg border px-3 py-2 text-sm mb-2.5';
      nameInput.style.borderColor = 'var(--theme-border)';
      nameInput.style.background = 'var(--theme-bg-card)';
      nameInput.style.color = 'var(--theme-text-strong)';
      nameInput.value = row.name || '';
      nameInput.placeholder = 'e.g. Game port';
      nameInput.addEventListener('input', function () { row.name = nameInput.value; });
      el.appendChild(nameInput);

      const pair = document.createElement('div');
      pair.className = 'grid grid-cols-2 gap-2.5';

      const intWrap = field('Internal port', 'number');
      const intInput = intWrap.querySelector('input');
      intInput.min = '1'; intInput.max = '65535';
      intInput.value = row.internalPort !== undefined && row.internalPort !== null ? row.internalPort : '';
      intInput.placeholder = '25565';
      intInput.addEventListener('input', function () { row.internalPort = Number(intInput.value) || ''; });
      pair.appendChild(intWrap);

      const extWrap = document.createElement('div');
      extWrap.className = 'relative';
      const extLabel = document.createElement('span');
      extLabel.className = 'block text-[11px] mb-1';
      extLabel.style.color = 'var(--theme-text-muted)';
      extLabel.textContent = 'External port';
      extWrap.appendChild(extLabel);
      const extBtn = document.createElement('button');
      extBtn.type = 'button';
      extBtn.className = 'pa-ext flex w-full items-center justify-between gap-1.5 rounded-lg border px-3 py-2 text-sm transition hover:bg-neutral-100 dark:hover:bg-white/5';
      extBtn.style.borderColor = 'var(--theme-border)';
      extBtn.style.color = 'var(--theme-text-strong)';
      extBtn.setAttribute('aria-haspopup', 'listbox');
      extBtn.setAttribute('aria-expanded', 'false');
      extBtn.setAttribute('aria-controls', 'paList' + index);
      extBtn.setAttribute('aria-labelledby', extWrap.id);
      extWrap.appendChild(extBtn);
      const extText = document.createElement('span');
      extText.className = 'truncate';
      const chevron = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      chevron.setAttribute('viewBox', '0 0 24 24');
      chevron.setAttribute('fill', 'currentColor');
      chevron.setAttribute('class', 'size-4 shrink-0');
      chevron.style.color = 'var(--theme-text-muted)';
      chevron.innerHTML = '<path fill-rule="evenodd" d="M12.53 16.28a.75.75 0 0 1-1.06 0l-7.5-7.5a.75.75 0 0 1 1.06-1.06L12 14.69l6.97-6.97a.75.75 0 1 1 1.06 1.06l-7.5 7.5Z" clip-rule="evenodd" />';
      const listEl = document.createElement('div');
      listEl.className = 'hidden pa-extlist absolute z-10 w-full rounded-lg border shadow-xl max-h-48 overflow-y-auto';
      listEl.setAttribute('role', 'listbox');
      listEl.id = 'paList' + index;
      listEl.style.background = 'var(--theme-bg-card)';
      listEl.style.borderColor = 'var(--theme-border)';
      extWrap.appendChild(listEl);
      let listOpen = false;
      let activeOpt = -1;

      const extValue = row.externalPort !== undefined && row.externalPort !== null ? String(row.externalPort) : '';
      const chosen = avail.find(function (a) { return String(a.port) === extValue; });
      extText.textContent = chosen ? chosen.label : (extValue ? 'Port ' + extValue : 'Select port…');
      if (!chosen) extText.style.opacity = '0.45';
      extBtn.appendChild(extText);
      extBtn.appendChild(chevron);

      function fillList() {
        listEl.innerHTML = '';
        avail.forEach(function (item, idx) {
          const isSel = String(item.port) === extValue;
          const taken = used.has(String(item.port)) && !isSel;
          const opt = document.createElement('div');
          opt.className = 'pa-extopt flex items-center justify-between gap-2 px-3 py-2 text-xs truncate cursor-pointer transition hover:bg-neutral-100 dark:hover:bg-white/5';
          opt.style.color = taken ? 'var(--theme-text-muted)' : (isSel ? 'var(--theme-accent)' : 'var(--theme-text-strong)');
          opt.style.opacity = taken ? '0.45' : '1';
          opt.setAttribute('role', 'option');
          opt.setAttribute('id', 'paOpt' + index + '-' + idx);
          opt.setAttribute('aria-selected', String(isSel));
          opt.setAttribute('aria-disabled', String(taken));
          const txt = document.createElement('span');
          txt.className = 'truncate';
          txt.textContent = item.label + (taken ? ' — in use' : '');
          opt.appendChild(txt);
          if (isSel) {
            const ck = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            ck.setAttribute('viewBox', '0 0 24 24');
            ck.setAttribute('fill', 'currentColor');
            ck.setAttribute('class', 'size-3.5 shrink-0');
            ck.innerHTML = '<path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" />';
            opt.appendChild(ck);
          }
          if (!taken) {
            opt.addEventListener('click', function () {
              row.externalPort = item.port;
              paHideList();
              render();
            });
          }
          listEl.appendChild(opt);
        });
      }

      function moveActive(dir) {
        const opts = Array.from(listEl.querySelectorAll('[role="option"]:not([aria-disabled="true"])'));
        if (!opts.length) return;
        let next = activeOpt < 0 ? 0 : (activeOpt + dir + opts.length) % opts.length;
        activeOpt = next;
        listEl.querySelectorAll('.pa-extopt-active').forEach(function (o) { o.classList.remove('pa-extopt-active'); });
        opts[activeOpt].classList.add('pa-extopt-active');
        listEl.setAttribute('aria-activedescendant', opts[activeOpt].id);
        opts[activeOpt].scrollIntoView({ block: 'nearest' });
      }

      function selectActive() {
        const opts = Array.from(listEl.querySelectorAll('[role="option"]:not([aria-disabled="true"])'));
        const item = opts[activeOpt >= 0 ? activeOpt : 0];
        if (item) item.click();
      }

      function paHideList() {
        if (listEl.classList.contains('hidden')) return;
        listOpen = false;
        activeOpt = -1;
        extBtn.setAttribute('aria-expanded', 'false');
        extBtn.removeAttribute('aria-activedescendant');
        listEl.classList.remove('open');
        setTimeout(function () {
          extWrap.appendChild(listEl);
          listEl.removeAttribute('style');
          listEl.classList.add('hidden');
        }, 200);
      }

      function paShowList() {
        fillList();
        const rect = extBtn.getBoundingClientRect();
        listEl.style.position = 'fixed';
        listEl.style.left = rect.left + 'px';
        listEl.style.width = rect.width + 'px';
        listEl.style.zIndex = '110';
        const spaceBelow = window.innerHeight - rect.bottom - 6;
        const spaceAbove = rect.top - 6;
        if (spaceBelow < 140 && spaceAbove > spaceBelow) {
          listEl.style.top = 'auto';
          listEl.style.bottom = (window.innerHeight - rect.top + 5) + 'px';
          listEl.style.transformOrigin = 'bottom center';
        } else {
          listEl.style.top = (rect.bottom + 5) + 'px';
          listEl.style.bottom = 'auto';
          listEl.style.transformOrigin = 'top center';
        }
        document.body.appendChild(listEl);
        listEl.classList.remove('hidden');
        listEl.classList.add('al-dropdown');
        listOpen = true;
        activeOpt = -1;
        extBtn.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(function () { listEl.classList.add('open'); });
        if (openLists.indexOf(listEl) === -1) openLists.push(listEl);
        window.addEventListener('resize', paHideList);
        window.addEventListener('scroll', paHideList, true);
      }

      extBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (listEl.classList.contains('hidden')) {
          paShowList();
        } else {
          window.removeEventListener('resize', paHideList);
          window.removeEventListener('scroll', paHideList, true);
          paHideList();
        }
      });

      extBtn.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown' && listEl.classList.contains('hidden')) {
          e.preventDefault();
          paShowList();
          moveActive(1);
        } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          moveActive(e.key === 'ArrowDown' ? 1 : -1);
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (listOpen) selectActive();
          else paShowList();
        } else if (e.key === 'Escape') {
          e.preventDefault();
          window.removeEventListener('resize', paHideList);
          window.removeEventListener('scroll', paHideList, true);
          paHideList();
          extBtn.focus();
        } else if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          const opts = Array.from(listEl.querySelectorAll('[role="option"]:not([aria-disabled="true"])'));
          if (!opts.length) return;
          activeOpt = e.key === 'Home' ? 0 : opts.length - 1;
          listEl.querySelectorAll('.pa-extopt-active').forEach(function (o) { o.classList.remove('pa-extopt-active'); });
          opts[activeOpt].classList.add('pa-extopt-active');
          listEl.setAttribute('aria-activedescendant', opts[activeOpt].id);
          opts[activeOpt].scrollIntoView({ block: 'nearest' });
        }
      });

      pair.appendChild(extWrap);

      el.appendChild(pair);
      el.style.setProperty('--pa-i', String(index));
      rowsEl.appendChild(el);
    });

    hintEl.textContent = (cfg.availablePorts || []).length === 0
      ? ''
      : (rows.length > 0 && rowsChanged()
          ? 'Unsaved changes'
          : (cfg.requirements.length ? 'First port is marked as primary' : ''));
  }

  function field(labelText, type) {
    const wrap = document.createElement('label');
    const label = document.createElement('span');
    label.className = 'block text-[11px] mb-1';
    label.style.color = 'var(--theme-text-muted)';
    label.textContent = labelText;
    const input = document.createElement('input');
    input.type = type;
    input.className = 'w-full rounded-lg border px-3 py-2 text-sm';
    input.style.borderColor = 'var(--theme-border)';
    input.style.background = 'var(--theme-bg-card)';
    input.style.color = 'var(--theme-text-strong)';
    wrap.appendChild(label);
    wrap.appendChild(input);
    return wrap;
  }

  document.getElementById('paClose').addEventListener('click', close);
  document.getElementById('paCancel').addEventListener('click', close);
  document.getElementById('paSave').addEventListener('click', commit);
  addBtn.addEventListener('click', function () {
    rows.push({ name: 'Port ' + (rows.length + 1), internalPort: 25565, externalPort: '', primary: rows.length === 0 });
    render();
  });
  modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
  modal.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { e.preventDefault(); close(); }
  });

  // Click-away for the portaled port lists: a click outside an open
  // list and its trigger closes that list (the modal stays open).
  document.addEventListener('click', function (e) {
    if (!openLists.length) return;
    const hit = e.target.closest && e.target.closest('.pa-ext, .pa-extlist');
    if (hit) return;
    openLists.slice().forEach(function (list) {
      if (!list || list.classList.contains('hidden')) return;
      list.classList.remove('open');
      const btn = list.parentNode && list.parentNode.querySelector('.pa-ext');
      if (btn) btn.setAttribute('aria-expanded', 'false');
      setTimeout(function () {
        if (list.parentNode) list.parentNode.appendChild(list);
        list.removeAttribute('style');
        list.classList.add('hidden');
      }, 200);
    });
    openLists.length = 0;
  });

  // Close any open port lists when the modal itself closes (scrim,
  // Escape, save, or dirty-close confirm) so a portaled dropdown
  // can never survive its parent popup.
  function hideAllLists() {
    openLists.forEach(function (list) {
      if (!list) return;
      list.classList.remove('open');
      const btn = list.parentNode && list.parentNode.querySelector('.pa-ext');
      if (btn) btn.setAttribute('aria-expanded', 'false');
      if (list.parentNode) list.parentNode.appendChild(list);
      list.removeAttribute('style');
      list.classList.add('hidden');
    });
    openLists.length = 0;
  }
  const origClose = close;
  close = function () { hideAllLists(); return origClose(); };
  modal._beforeClose = close;

  window.PortsAllocator = { open: open, close: close };
})();
</script>
