<style>
  @keyframes al-toast-indeterminate {
    0%   { transform: scaleX(0.08); opacity: 0.35; }
    50%  { transform: scaleX(0.7);  opacity: 1; }
    100% { transform: scaleX(0.08); opacity: 0.35; }
  }
</style>
<script nonce="<%- nonce %>">
  (function () {
    if (window.createToastSystem) return;

    const colorMap = {
      error:   'var(--theme-danger)',
      success: 'var(--theme-success)',
      warning: 'var(--theme-warning)',
      loading: 'var(--theme-info)',
      info:    'var(--theme-info)',
    };

    const iconMap = {
      error: '<%- icon('circle-x', { class: 'w-5 h-5' }) %>',
      success: '<%- icon('circle-check', { class: 'w-5 h-5' }) %>',
      warning: '<%- icon('triangle-alert', { class: 'w-5 h-5' }) %>',
      loading: '<%- icon('loader-circle', { class: 'w-5 h-5 animate-spin' }) %>',
      info: '<%- icon('info', { class: 'w-5 h-5' }) %>',
      check: '<%- icon('circle-check', { class: 'w-5 h-5' }) %>',
      x: '<%- icon('x', { class: 'w-5 h-5' }) %>',
    };

    /*
     * Persistence — every toast is mirrored as a lightweight record in
     * session storage (expiry/dedup rules live in shared/toast-store.js).
     * Navigation keeps the record, so the toast is re-rendered on the next
     * page. Progress toasts may carry a `job` (a polled endpoint) that keeps
     * resolving after the page that started it is gone.
     */
    let storage = null;
    try {
      if (window.sessionStorage) {
        window.sessionStorage.setItem('__al_toast_probe__', '1');
        window.sessionStorage.removeItem('__al_toast_probe__');
        storage = window.sessionStorage;
      }
    } catch (e) {
      storage = null;
    }
    const store = window.ALToastStore ? window.ALToastStore.createStore(storage) : null;
    const uid = () => (window.ALToastStore ? window.ALToastStore.uid() : 't' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8));
    const remainingMs = (r, n) => (window.ALToastStore ? remainingMs(r, n) : 0);

    // Live toasts on this page — record id -> { record, handle }.
    const active = new Map();
    // Record id -> stop() for running job pollers.
    const jobPolls = new Map();
    // Record ids already re-rendered on this page.
    const hydrated = new Set();
    let saveTimer = null;

    function scheduleSave() {
      if (!store || saveTimer) return;
      saveTimer = setTimeout(function () {
        saveTimer = null;
        const list = [];
        active.forEach(function (entry) { list.push(entry.record); });
        store.save(list);
      }, 80);
    }

    function stopJobFor(id) {
      const stop = jobPolls.get(id);
      if (stop) {
        stop();
        jobPolls.delete(id);
      }
    }

    let toastContainer = null;
    function ensureContainer() {
      if (!toastContainer || !toastContainer.isConnected) {
        toastContainer = document.getElementById('toast-container');
      }
      if (!toastContainer) {
        toastContainer = document.createElement('div');
        toastContainer.id = 'toast-container';
        toastContainer.className = 'fixed top-4 right-4 z-50 flex flex-col gap-2 max-sm:left-4 max-sm:right-4';
        toastContainer.setAttribute('aria-live', 'polite');
        toastContainer.setAttribute('aria-atomic', 'false');
        toastContainer.setAttribute('role', 'status');
        document.body.appendChild(toastContainer);
      }
      return toastContainer;
    }

    /*
     * interpretJob maps a polled endpoint payload to a minimal view:
     *   { progress?, message?, done, success, error }
     * Handles both the generic progress convention and the server status
     * convention ({ state: installed|failed }) used by installs.
     */
    function interpretJob(data) {
      if (!data || typeof data !== 'object') return {};
      if (typeof data.state === 'string') {
        const st = data.state;
        if (st === 'installed') return { done: true, success: true, message: 'Installation complete.' };
        if (st === 'failed') return { done: true, success: false, error: data.error || 'Installation failed.' };
        return { progress: null, message: typeof data.error === 'string' ? data.error : undefined };
      }
      const done = data.done === true || data.success === true || data.success === false || !!data.error;
      return {
        progress: typeof data.progress === 'number' ? data.progress : undefined,
        message: typeof data.message === 'string' ? data.message : undefined,
        done: done,
        success: !(data.success === false || !!data.error),
        error: data.error,
      };
    }

    function createRecord(message, type, opts) {
      const progressMode = opts.progress === true || type === 'loading';
      return {
        id: uid(),
        group: typeof opts.group === 'string' && opts.group ? opts.group : null,
        mode: progressMode ? 'progress' : 'toast',
        message: String(message),
        type: type,
        startedAt: Date.now(),
        progress: progressMode ? 0 : null,
        indeterminate: progressMode && opts.indeterminate === true ? true : null,
        duration: progressMode ? 0 : (typeof opts.duration === 'number' ? opts.duration : 5000),
        finished: false,
        success: null,
        finishedAt: null,
        job: opts.job && typeof opts.job === 'object' ? Object.assign({}, opts.job) : null,
        autoCompleteAt100: opts.autoCompleteAt100,
      };
    }

    function showToast(message, type, opts) {
      opts = opts || {};
      const isPreset = opts._record != null;

      // Rehydrated records are prebuilt so their id/progress/job survive the
      // navigation. Fresh toasts are created from scratch.
      const rec = isPreset ? Object.assign({}, opts._record) : createRecord(message, type, opts);
      if (isPreset && typeof opts.duration === 'number') rec.duration = opts.duration;

      // Same group + still active => dedupe, return the first handle so the
      // caller (e.g. the install banner on every server page) still works.
      if (rec.group && !isPreset) {
        let existing = null;
        active.forEach(function (entry) {
          if (!existing && entry.record && entry.record.group === rec.group && !entry.record.finished) {
            existing = entry;
          }
        });
        if (existing && existing.handle) {
          return existing.handle;
        }
      }

      return renderToast(rec, opts);
    }

    function renderToast(rec, opts) {
      const progressMode = rec.mode === 'progress';
      const indeterminate = rec.indeterminate === true;
      const toast = ensureContainer();

      const el = document.createElement('div');
      el.className = 'al-toast px-4 py-3 rounded-xl shadow-lg flex flex-row items-start gap-3';
      el.style.background = 'var(--theme-bg-card)';
      el.style.border = '1px solid var(--theme-border)';
      el.style.transform = 'translateX(calc(100% + 1rem))';
      el.style.opacity = '0';
      el.style.maxWidth = '400px';
      el.style.touchAction = 'none';
      el.style.cursor = 'grab';
      el.style.userSelect = 'none';
      el.style.overflowWrap = 'break-word';
      el.style.transition = 'transform var(--dur-enter, 320ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)), opacity var(--dur-enter, 320ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1))';
      el.style.willChange = 'transform, opacity';
      el.style.color = 'var(--theme-text)';

      const icon = document.createElement('span');
      icon.className = 'mt-0.5 shrink-0';
      icon.style.color = (rec.type && colorMap[rec.type]) || colorMap.info;
      icon.innerHTML = (rec.type && iconMap[rec.type]) || iconMap.info;
      el.appendChild(icon);

      const body = document.createElement('div');
      body.className = 'flex-1 min-w-0';
      el.appendChild(body);

      const messageSpan = document.createElement('div');
      messageSpan.className = 'font-medium text-sm leading-relaxed';
      messageSpan.style.color = 'var(--theme-text)';
      messageSpan.textContent = rec.message;
      body.appendChild(messageSpan);

      const progressRow = document.createElement('div');
      progressRow.className = 'hidden items-center gap-2 mt-2';
      const barTrack = document.createElement('div');
      barTrack.className = 'h-1 flex-1 rounded overflow-hidden';
      barTrack.style.background = 'var(--theme-border)';
      const barFill = document.createElement('div');
      barFill.className = 'h-full rounded transition-all duration-300';
      barFill.style.transform = 'scaleX(0)';
      barFill.style.transformOrigin = 'left center';
      barFill.style.background = 'var(--theme-info)';
      barTrack.appendChild(barFill);
      const pctLabel = document.createElement('span');
      pctLabel.className = 'text-[10px] tabular-nums shrink-0';
      pctLabel.style.color = 'var(--theme-text-muted)';
      pctLabel.textContent = '0%';
      progressRow.appendChild(barTrack);
      progressRow.appendChild(pctLabel);
      body.appendChild(progressRow);

      if (!progressMode) {
        const dismissBtn = document.createElement('button');
        dismissBtn.type = 'button';
        dismissBtn.className = 'shrink-0 p-1 rounded-lg transition-opacity hover:opacity-70 ml-1';
        dismissBtn.style.color = 'var(--theme-text-muted)';
        dismissBtn.setAttribute('aria-label', 'Dismiss notification');
        dismissBtn.innerHTML = alIcon('x', 'w-3.5 h-3.5');
        dismissBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          removeToast();
        });
        el.appendChild(dismissBtn);
      }

      toast.appendChild(el);

      requestAnimationFrame(function () {
        el.style.transform = 'translateX(0)';
        el.style.opacity = '1';
      });

      let removed = false;
      let dismissTimer = null;
      let completed = false;

      const showProgressRow = function () {
        progressRow.classList.remove('hidden');
        progressRow.classList.add('flex');
      };

      function setFill(percent) {
        const p = Math.max(0, Math.min(100, Number(percent) || 0));
        barFill.style.transform = 'scaleX(' + (p / 100) + ')';
        pctLabel.textContent = Math.round(p) + '%';
      }

      if (progressMode) {
        if (indeterminate) {
          showProgressRow();
          barFill.style.transform = 'scaleX(0.6)';
          barFill.style.animation = 'al-toast-indeterminate 1.4s ease-in-out infinite';
          pctLabel.textContent = '';
        } else if (typeof rec.progress === 'number' && rec.progress > 0) {
          showProgressRow();
          setFill(rec.progress);
        }
      }

      const removeToast = function () {
        if (removed) return;
        removed = true;
        if (dismissTimer) clearTimeout(dismissTimer);
        stopJobFor(rec.id);
        active.delete(rec.id);
        scheduleSave();
        el.style.transition = 'transform var(--dur-exit, 180ms) var(--ease-in, cubic-bezier(0.4, 0, 1, 1)), opacity var(--dur-exit, 180ms) var(--ease-in, cubic-bezier(0.4, 0, 1, 1))';
        el.style.transform = 'translateX(calc(100% + 1rem))';
        el.style.opacity = '0';
        setTimeout(function () {
          if (el.parentNode) toast.removeChild(el);
        }, 200);
      };

      const scheduleDismiss = function (ms) {
        if (dismissTimer) clearTimeout(dismissTimer);
        if (ms > 0) dismissTimer = setTimeout(removeToast, ms);
      };

      const setType = function (t) {
        rec.type = t;
        icon.style.color = colorMap[t] || colorMap.info;
        icon.innerHTML = iconMap[t] || iconMap.info;
      };

      const setMessage = function (msg) {
        rec.message = String(msg);
        messageSpan.textContent = rec.message;
        scheduleSave();
      };

      const updateProgress = function (percent, msg) {
        if (removed) return;
        if (typeof msg === 'string') setMessage(msg);
        rec.progress = Math.max(0, Math.min(100, Number(percent) || 0));
        showProgressRow();
        if (indeterminate) {
          barFill.style.animation = null;
          barFill.style.transformOrigin = 'left center';
          barFill.style.transform = 'scaleX(' + (rec.progress / 100) + ')';
          pctLabel.textContent = Math.round(rec.progress) + '%';
        } else {
          setFill(rec.progress);
        }
        scheduleSave();
        if (rec.progress >= 100 && rec.autoCompleteAt100 !== false) complete(true);
      };

      const complete = function (success, msg) {
        if (removed || completed) return;
        completed = true;
        if (typeof msg === 'string') setMessage(msg);
        rec.finished = true;
        rec.finishedAt = Date.now();
        rec.success = !!success;
        scheduleSave();
        if (progressMode) {
          showProgressRow();
          barFill.style.animation = null;
          setFill(100);
          barFill.style.background = success ? 'var(--theme-success)' : 'var(--theme-danger)';
        }
        if (success) setType('success');
        else setType('error');
        icon.innerHTML = success ? iconMap.check : iconMap.x;
        scheduleDismiss(success ? 1600 : 4000);
      };

      // ===== job continuation ======================================
      let stopJob = function () {};
      if (rec.job && typeof rec.job === 'object') {
        const jobCfg = rec.job;
        const intervalMs = typeof jobCfg.intervalMs === 'number' ? jobCfg.intervalMs : 2000;
        let stopped = false;
        let timer = null;
        const tick = function () {
          if (stopped || removed || completed) return;
          fetch(jobCfg.url, {
            method: jobCfg.method || 'GET',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
          })
            .then(function (r) { return r.json().catch(function () { return {}; }); })
            .then(function (data) {
              if (stopped || removed || completed) return;
              const view = interpretJob(data);
              if (view.progress != null) updateProgress(view.progress);
              if (typeof view.message === 'string' && view.message !== rec.message) setMessage(view.message);
              if (view.done) complete(view.success, view.error || view.message || 'Done.');
            })
            .catch(function () { /* transient network blips are normal — keep polling */ })
            .then(function () {
              if (!stopped && !removed && !completed) timer = setTimeout(tick, intervalMs);
            });
        };
        stopJob = function () {
          stopped = true;
          if (timer) clearTimeout(timer);
        };
        jobPolls.set(rec.id, stopJob);
        tick();
      }

      if (!progressMode && !rec.finished) {
        scheduleDismiss(typeof rec.duration === 'number' ? rec.duration : 5000);
      }

      // Rehydrated finished toast: sit out its remaining visibility window.
      if (rec.finished === true) {
        const remain = remainingMs(rec, Date.now());
        if (remain <= 0) {
          active.delete(rec.id);
          if (el.parentNode) toast.removeChild(el);
          return noopHandle();
        }
        // Render the settled state (icon + message) without re-driving it.
        if (progressMode) {
          showProgressRow();
          setFill(100);
          barFill.style.animation = null;
          barFill.style.background = rec.success ? 'var(--theme-success)' : 'var(--theme-danger)';
        }
        icon.innerHTML = rec.success === false ? iconMap.x : iconMap.check;
        scheduleDismiss(remain);
      }

      const handle = {
        updateProgress: updateProgress,
        update: updateProgress,
        setMessage: setMessage,
        setType: setType,
        complete: complete,
        close: removeToast,
      };

      active.set(rec.id, { record: rec, handle: handle });
      scheduleSave();
      return handle;
    }

    function noopHandle() {
      const noop = function () {};
      return { updateProgress: noop, update: noop, setMessage: noop, setType: noop, complete: noop, close: noop };
    }

    // ===== hydration ===============================================
    // Whatever survived the navigation is re-rendered on this page; plain
    // toasts only come back inside their lifespan, progress toasts resume
    // (and keep polling their job) until they settle.
    function hydrate() {
      if (!store) return;
      const records = store.load();
      records.forEach(function (rec) {
        if (!rec || hydrated.has(rec.id)) return;
        hydrated.add(rec.id);
        const now = Date.now();

        if (rec.finished === true) {
          const remain = remainingMs(rec, now);
          if (remain <= 0) return;
          showToast(rec.message, rec.success === false ? 'error' : 'success', {
            _record: Object.assign({}, rec, { mode: 'toast', duration: remain }),
          });
          return;
        }

        if (rec.mode === 'progress') {
          showToast(rec.message, 'loading', { _record: rec });
          return;
        }

        const remainPlain = remainingMs(rec, now);
        if (remainPlain <= 0) return;
        showToast(rec.message, rec.type, { _record: rec, duration: remainPlain });
      });
    }

    function onReady() {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', onReady);
        return;
      }
      hydrate();
    }

    window.createToastSystem = function () {
      return { showToast: showToast };
    };
    window.showToast = showToast;
    window.showProgressToast = function (message, opts) {
      return showToast(message, 'loading', Object.assign({ progress: true }, opts || {}));
    };
    window.showLoadingToast = function (message) {
      return showToast(message, 'loading');
    };

    onReady();
  })();
</script>