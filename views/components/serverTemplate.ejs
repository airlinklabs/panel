<div class="mt-8 ml-4 sm:ml-8 mb-8 sm:hidden">
    <div>
       <%
        const rawMenuItemsMobile = global.uiComponentStore ? global.uiComponentStore.getServerMenuItems() : [];
        const isAdminMobile = (typeof user !== 'undefined' && user && user.isAdmin === true);
        const isSubUserMobile = (typeof req !== 'undefined' && req && req.subUser) ? true : false;
        const menuItemsMobile = rawMenuItemsMobile.filter(item => {
          if (item.isAdminItem && !isAdminMobile) return false;
          if (item.ownerOnly && isSubUserMobile) return false;
          return true;
        });
        const currentPath = (typeof req !== 'undefined' && req && (req.path || req.originalUrl)) ? req.path : '';
        const isCurrentItem = (url) => url && url !== '#' && (currentPath === url || (url !== '/' && currentPath.startsWith(url + '/')));
        const navEntries = menuItemsMobile
          .filter(item => !item.feature || (typeof features !== 'undefined' && features.includes(item.feature)))
          .map(item => ({
            item,
            url: (item.url || '#').replace(':uuid', server.UUID).replace(':id', server.id),
          }));
        const GROUP_ORDER = ['run', 'data', 'manage', 'settings'];
        const groupLabel = (g) => {
          const t = (typeof req !== 'undefined' && req && req.translations) || {};
          if (g === 'run') return t.navGroupRun || 'Run';
          if (g === 'data') return t.navGroupData || 'Data';
          if (g === 'manage') return t.navGroupManage || 'Manage';
          if (g === 'settings') return t.navGroupSettings || 'Settings';
          return null;
        };
        const grouped = GROUP_ORDER
          .map(g => ({ g, entries: navEntries.filter(e => (e.item.group || 'manage') === g) }))
          .filter(grp => grp.entries.length > 0);
        const activeEntry = navEntries.find(entry => isCurrentItem(entry.url));
        const activeGroup = activeEntry ? (activeEntry.item.group || 'manage') : GROUP_ORDER[0];
       %>
       <!-- Mobile server nav — groups as tabs, members shown under the active tab -->
       <div class="block sm:hidden mt-3">
         <% if (grouped.length > 1) { %>
         <div class="flex gap-1 overflow-x-auto pb-2" role="tablist" aria-label="Server sections">
           <% grouped.forEach(grp => { %>
           <button type="button" role="tab" aria-selected="<%= grp.g === activeGroup ? 'true' : 'false' %>"
             data-nav-group-tab="<%= grp.g %>"
             class="nav-group-tab flex items-center gap-1.5 py-1.5 px-3 text-sm rounded-xl border transition whitespace-nowrap"
             style="color:var(--theme-text-muted); border-color:transparent;">
             <%= groupLabel(grp.g) %>
           </button>
           <% }); %>
         </div>
         <% } %>
         <div class="flex flex-wrap gap-1">
           <% grouped.forEach(grp => { %>
           <div data-nav-group="<%= grp.g %>" class="<%= grp.g === activeGroup ? '' : 'hidden' %> flex flex-wrap gap-1">
             <% grp.entries.forEach(entry => { %>
             <a href="<%= entry.url %>" class="nav-link2 flex items-center gap-1.5 py-2 px-3 text-sm rounded-xl border border-transparent whitespace-nowrap" <%= isCurrentItem(entry.url) ? 'data-active="true"' : '' %>>
               <%- entry.item.icon %>
               <%= entry.item.label %>
             </a>
             <% }); %>
           </div>
           <% }); %>
         </div>
       </div>

       <!-- Server controls live in the sidebar on desktop (see template.ejs);
            mobile keeps the grouped tab strip below. -->
    </div>
  </div>

 <style>
  .nav-link2 { color: var(--theme-text-muted); }
  .nav-link2[data-active="true"] {
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
    color: var(--theme-accent);
    font-weight: 500;
  }
  .nav-group-tab[data-active-group="true"] {
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
  }
 </style>

 <!-- Server Sections -->
 <% if (global.uiComponentStore) {
    const sections = global.uiComponentStore.getServerSections();

    if (sections && sections.length > 0) {
 %>
 <div class="px-4 sm:px-8 mt-8">
    <% sections.forEach(section => { %>
      <div class="al-card p-5 sm:p-6 mb-6">
        <h2 class="al-section-title pb-3 mb-4 border-b" style="border-color:var(--theme-border)"><%= section.title %></h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <%
            const items = section.items || [];

            items.forEach(item => {
              let value = item.value;

              if (value.includes(':uuid')) value = value.replace(':uuid', server.UUID);
              if (value.includes(':id')) value = value.replace(':id', server.id);
              if (value.includes(':address')) {
                const primaryPort = server.Ports ? JSON.parse(server.Ports).find(p => p.primary) : null;
                const portNumber = primaryPort ? (primaryPort.externalPort || String(primaryPort.Port || '').split(':')[0]) : '';
                value = value.replace(':address', `${server.node.address}:${portNumber}`);
              }
              if (value.includes(':image')) value = value.replace(':image', server.image.name || 'Unknown');
              if (value.includes(':node')) value = value.replace(':node', server.node.name);
              if (value.includes(':memory')) value = value.replace(':memory', `${server.Memory} MB`);
              if (value.includes(':cpu')) value = value.replace(':cpu', `${server.Cpu}%`);
              if (value.includes(':disk')) value = value.replace(':disk', `${server.Storage} MB`);
          %>
            <div class="rounded-lg px-3.5 py-3 min-w-0" style="background:var(--theme-bg-secondary)">
              <h3 class="text-[11px] font-medium mb-1.5 truncate" style="color:var(--theme-text-muted)"><%= item.label %></h3>
              <% if (item.type === 'link') { %>
                <a href="<%= item.url %>" class="block text-sm font-medium truncate transition hover:opacity-75" style="color:var(--theme-accent)" title="<%= value %>"><%= value %></a>
              <% } else if (item.type === 'button') { %>
                <button type="button" onclick="<%= item.onClick %>" class="flex max-w-full items-center gap-1.5 text-sm font-medium transition hover:opacity-75" style="color:var(--theme-accent)" title="<%= value %>"><%- icon('arrow-up-right', { class: 'size-4 shrink-0', strokeWidth: 1.5 }) %><span class="truncate"><%= value %></span></button>
              <% } else { %>
                <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong)" title="<%= value %>"><%= value %></p>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
 </div>
 <% } } %>

  <script nonce="<%- nonce %>">
   (function () {
     // Scope to this include's own container — serverTemplate is rendered
     // twice (desktop + mobile mains) and querying the whole document would
     // let the hidden layout's links steal the highlight.
     var root = document.currentScript ? document.currentScript.parentNode : document;
     var navLinks2 = root.querySelectorAll('.nav-link2');

     function updateActiveLink(path) {
       var activeLink = null;
       var bestLen = 0;
       navLinks2.forEach(function(link) {
         link.setAttribute('data-active', 'false');
         var href = link.getAttribute('href') || '';
         var matched = path === href || (href !== '/' && path.startsWith(href + '/'));
         if (matched && href.length >= bestLen) {
           bestLen = href.length;
           activeLink = link;
         }
       });

       if (activeLink) {
         activeLink.setAttribute('data-active', 'true');
       }
     }

     function syncActiveLink() {
       updateActiveLink(window.location.pathname);
     }

     if (document.readyState === 'loading') {
       document.addEventListener('DOMContentLoaded', syncActiveLink);
     } else {
       syncActiveLink();
     }

      window.addEventListener('popstate', syncActiveLink);
      document.addEventListener('al:navigated', syncActiveLink);

      // Mobile group tabs — show the active group's items, keep the current
      // path's group selected on load.
      var tabButtons = root.querySelectorAll('[data-nav-group-tab]');
      var groups = root.querySelectorAll('[data-nav-group]');

      function selectGroup(name) {
        groups.forEach(function(group) {
          group.classList.toggle('hidden', group.getAttribute('data-nav-group') !== name);
        });
        tabButtons.forEach(function(btn) {
          var on = btn.getAttribute('data-nav-group-tab') === name;
          btn.setAttribute('aria-selected', on ? 'true' : 'false');
          if (on) {
            btn.style.color = 'var(--theme-accent)';
            btn.style.borderColor = 'var(--theme-accent)';
          } else {
            btn.style.color = 'var(--theme-text-muted)';
            btn.style.borderColor = 'transparent';
          }
        });
      }

      tabButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          selectGroup(btn.getAttribute('data-nav-group-tab'));
        });
      });
   })();
  </script>
