<%
const features = (typeof server !== 'undefined' && server && server.egg && server.egg.features) ? server.egg.features : [];
const rawMenuItems = global.uiComponentStore ? global.uiComponentStore.getServerMenuItems() : [];
const isAdmin = (typeof user !== 'undefined' && user && user.isAdmin === true);
const menuItems = rawMenuItems.filter(item => !(item.isAdminItem && !isAdmin));

const primaryLabels = ['Console', 'Files', 'Startup', 'Backups', 'Settings'];

function buildDefaultItems() {
  const items = [
    { label: 'Console', url: '/server/' + server.UUID, icon: 'terminal' },
    { label: 'Files', url: '/server/' + server.UUID + '/files', icon: 'folder' },
  ];
  if (features.includes('players')) items.push({ label: 'Players', url: '/server/' + server.UUID + '/players', icon: 'users' });
  if (features.includes('worlds')) items.push({ label: 'Worlds', url: '/server/' + server.UUID + '/worlds', icon: 'globe' });
  items.push(
    { label: 'Startup', url: '/server/' + server.UUID + '/startup', icon: 'play' },
    { label: 'Backups', url: '/server/' + server.UUID + '/backups', icon: 'hard-drive' },
    { label: 'Settings', url: '/server/' + server.UUID + '/settings', icon: 'settings' },
  );
  return items;
}

const allItems = (menuItems && menuItems.length > 0)
  ? menuItems.filter(item => !item.feature || features.includes(item.feature)).map(item => ({
      label: item.label,
      url: (item.url || '#').replace(':uuid', server.UUID).replace(':id', server.id),
      icon: item.icon || null,
    }))
  : buildDefaultItems();

const primaryItems = allItems.filter(item => primaryLabels.includes(item.label));
const secondaryItems = allItems.filter(item => !primaryLabels.includes(item.label));
%>
<% if (isMobileViewport) { %>
<div class="border-b border-neutral-200 dark:border-white/5 mb-4 -mx-4 px-4">
  <nav class="flex gap-1 min-w-max pb-1 overflow-x-auto">
    <% primaryItems.forEach(function(item) { %>
    <a href="<%= item.url %>" class="nav-link2 px-3 py-2 text-xs font-medium rounded-xl border border-transparent text-neutral-600 dark:text-neutral-400 whitespace-nowrap" data-active="false"><%= item.label %></a>
    <% }); %>
    <% if (secondaryItems.length > 0) { %>
    <div class="relative" id="mobile-more-wrapper">
      <button id="mobile-more-btn" class="nav-link2 px-3 py-2 text-xs font-medium rounded-xl border border-transparent text-neutral-600 dark:text-neutral-400 whitespace-nowrap flex items-center gap-1">
        More
        <%- icon('chevron-down', { class: 'w-3 h-3' }) %>
      </button>
      <div id="mobile-more-dropdown" class="hidden absolute top-full left-0 mt-1 min-w-[160px] rounded-xl py-1" style="z-index: var(--z-dropdown)">
        <% secondaryItems.forEach(function(item) { %>
        <a href="<%= item.url %>" class="flex items-center gap-2 px-3 py-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/5 transition">
          <% if (item.icon) { %><%- item.icon %><% } %>
          <%= item.label %>
        </a>
        <% }); %>
      </div>
    </div>
    <% } %>
  </nav>
</div>
<% if (secondaryItems.length > 0) { %>
<% } %>

<script nonce="<%- nonce %>" src="/js/core/server-nav.js"></script>

<% if (global.uiComponentStore) {
  const serverSections = global.uiComponentStore.getServerSections(server.UUID);
  if (serverSections && serverSections.length > 0) {
    serverSections.forEach(section => { %>
  <%- section.content %>
<% }); } } %>

<% } else { %>

<div class="mt-6 ml-8 mb-8">
  <div class="hidden relative sm:block">
    <nav class="flex relative" id="server-nav-container">
      <div class="flex relative" id="server-nav-overflow-wrapper">
        <ul role="list" class="flex min-w-full mt-1.5 flex-none gap-x-2 text-sm font-normal leading-6 text-neutral-600 dark:text-neutral-400" id="server-nav-list">
          <% primaryItems.forEach(function(item) { %>
          <li class="transition flex-shrink-0 server-nav-item">
            <a href="<%= item.url %>" class="nav-link2 whitespace-nowrap py-2 px-3 transition border hover:bg-neutral-100 dark:hover:bg-white/5 border-transparent hover:text-neutral-900 dark:hover:text-white hover:shadow rounded-xl data-[active=true]:bg-neutral-200 data-[active=true]:border-neutral-300 dark:data-[active=true]:bg-white/10 dark:data-[active=true]:border-neutral-300/20 data-[active=true]:text-neutral-900 dark:data-[active=true]:text-white data-[active=true]:font-medium data-[active=true]:shadow-sm">
              <% if (item.icon) { %><%- item.icon %><% } %>
              <%= item.label %>
            </a>
          </li>
          <% }); %>
        </ul>
      </div>
      <% if (secondaryItems.length > 0) { %>
      <div class="relative flex-shrink-0 ml-1" id="server-nav-more-wrap">
        <button id="server-nav-more-btn" class="whitespace-nowrap py-2 px-3 transition border border-transparent hover:bg-neutral-100 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white rounded-xl text-sm font-normal leading-6 text-neutral-600 dark:text-neutral-400 flex items-center gap-1.5">
          More
          <%- icon('chevron-down', { class: 'w-3.5 h-3.5' }) %>
        </button>
        <div id="server-nav-more-dropdown" class="hidden absolute left-0 top-full mt-1 min-w-[180px] rounded-xl py-1" style="z-index: var(--z-dropdown)">
          <% secondaryItems.forEach(function(item) { %>
          <a href="<%= item.url %>" class="flex items-center gap-2 px-3 py-2 text-[13px] font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/5 transition">
            <% if (item.icon) { %><%- item.icon %><% } %>
            <%= item.label %>
          </a>
          <% }); %>
        </div>
      </div>
      <% } %>
    </nav>
  </div>
</div>

<script nonce="<%- nonce %>" src="/js/core/server-nav.js"></script>

 <!-- Server Sections -->
 <% if (global.uiComponentStore) {
    const sections = global.uiComponentStore.getServerSections();

    if (sections && sections.length > 0) {
 %>
 <div class="px-8 mt-8">
    <% sections.forEach(section => { %>
      <div class="bg-white dark:bg-neutral-800 rounded-xl p-6 shadow-lg border border-neutral-200 dark:border-white/5 mb-6">
        <h2 class="text-lg font-semibold mb-4 text-neutral-800 dark:text-white"><%= section.title %></h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <%
            const items = section.items || [];

            items.forEach(item => {
              let value = item.value;

              if (value.includes(':uuid')) value = value.replace(':uuid', server.UUID);
              if (value.includes(':id')) value = value.replace(':id', server.id);
              if (value.includes(':address')) {
                const primaryPort = server.Ports ? JSON.parse(server.Ports).find(p => p.primary) : null;
                const portNumber = primaryPort ? (primaryPort.externalPort || String(primaryPort.Port || '').split(':')[0]) : '';
                value = value.replace(':address', `${server.node ? server.node.address : ''}:${portNumber}`);
              }
              if (value.includes(':image')) value = value.replace(':image', (server.image && server.image.name) ? server.image.name : 'Unknown');
              if (value.includes(':node')) value = value.replace(':node', server.node ? server.node.name : 'Unknown');
              if (value.includes(':memory')) value = value.replace(':memory', `${server.Memory} MB`);
              if (value.includes(':cpu')) value = value.replace(':cpu', `${server.Cpu}%`);
              if (value.includes(':disk')) value = value.replace(':disk', `${server.Storage} MB`);
          %>
            <div>
              <h3 class="text-sm font-medium text-neutral-600 dark:text-neutral-300 mb-2"><%= item.label %></h3>
              <% if (item.type === 'link') { %>
                <a href="<%= item.url %>" class="text-neutral-600 dark:text-neutral-300 hover:text-neutral-800 dark:hover:text-white transition"><%= value %></a>
              <% } else if (item.type === 'button') { %>
                <button onclick="<%= item.onClick %>" class="text-neutral-600 dark:text-neutral-300 hover:text-neutral-800 dark:hover:text-white transition"><%= value %></button>
              <% } else { %>
                <p class="text-neutral-600 dark:text-neutral-300"><%= value %></p>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
 </div>
 <% } } %>

<% } %>
