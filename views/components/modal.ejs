<!-- Global modal — one modal implementation for the whole panel.
     Confirmations: window.modal.confirm({ title, body, danger, confirmLabel, onConfirm })
     Alerts:        window.modal.alert({ title, body })
     Rich sheets:   window.modal.show({ title, bodyNode, panelClass, onClose })
                    bodyNode is moved into the shared panel; close with
                    window.modal.close(). The node is always restored to its
                    page position on close so getElementById works for the
                    next step of a multi-step flow. -->
<div id="globalModal" class="al-sheet-overlay al-modal-overlay fixed inset-0 z-50 hidden items-center justify-center" aria-hidden="true">
  <div class="absolute inset-0" id="globalModalBackdrop"></div>
  <div id="globalModalPanel" role="dialog" aria-modal="true" aria-labelledby="globalModalTitle" aria-describedby="globalModalBody" tabindex="-1" class="al-sheet-panel al-modal-panel relative border rounded-2xl shadow-lg w-full max-w-sm max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <div id="globalModalHeader" class="al-sheet-header" style="border-color:var(--theme-border);">
      <p id="globalModalTitle" class="text-sm font-semibold leading-snug truncate" style="color:var(--theme-text-strong);"></p>
      <button type="button" id="globalModalCloseBtn" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close"><%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %></button>
    </div>
    <div id="globalModalContent" class="flex-1 min-h-0 overflow-y-auto px-6 py-4" style="display:none;"></div>
    <div id="globalModalSimple" class="px-6 py-4">
      <p id="globalModalBody" class="text-xs leading-relaxed" style="color:var(--theme-text-muted);"></p>
    </div>
    <div id="globalModalFooter" class="al-sheet-footer justify-end" style="border-color:var(--theme-border);">
      <button type="button" id="globalModalCancel" class="al-btn-secondary inline-flex items-center gap-1.5"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Cancel</button>
      <button type="button" id="globalModalConfirm" class="px-4 py-2 text-xs font-medium rounded-xl text-white transition"></button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
(function () {
  if (window.modal) return;

  var overlay  = document.getElementById('globalModal');
  var panel    = document.getElementById('globalModalPanel');
  var header   = document.getElementById('globalModalHeader');
  var title    = document.getElementById('globalModalTitle');
  var body     = document.getElementById('globalModalBody');
  var content  = document.getElementById('globalModalContent');
  var simple   = document.getElementById('globalModalSimple');
  var footer   = document.getElementById('globalModalFooter');
  var cancel   = document.getElementById('globalModalCancel');
  var confirmBtn  = document.getElementById('globalModalConfirm');
  var backdrop = document.getElementById('globalModalBackdrop');
  var closeBtn = document.getElementById('globalModalCloseBtn');

  var currentResolve = null;
  var lastFocused = null;
  var onCloseHook = null;

  /* Body-node tracking. show() moves a node into the modal; close()
     always restores it to its original page position so getElementById
     works for the next step of a multi-step flow. No clones, no
     destruction — the original DOM node moves back and forth. */
  var lastBodyNode = null;
  var bodyOrigins = typeof WeakMap === 'function' ? new WeakMap() : null;

  function restoreBody() {
    if (!lastBodyNode) return;
    var o = bodyOrigins && bodyOrigins.get(lastBodyNode);
    if (o && o.parent && o.parent.parentNode) {
      lastBodyNode.style.display = 'none';
      o.parent.insertBefore(lastBodyNode, o.ref || null);
    }
    lastBodyNode = null;
  }

  function focusableElements() {
    return Array.from(panel.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
      .filter(function (el) { return !el.disabled && el.offsetParent !== null; });
  }

  function lockScroll() {
    document.body.style.overflow = 'hidden';
  }

  function unlockScroll() {
    document.body.style.overflow = '';
  }

  function showPanel() {
    overlay.setAttribute('aria-hidden', 'false');
    document.documentElement.setAttribute('data-modal-open', '');
    lockScroll();
    if (window.Animate) Animate.openModal(overlay, panel);
    else { overlay.classList.add('open'); panel.classList.add('open'); }
  }

  function hidePanel(done) {
    var finish = function () {
      overlay.setAttribute('aria-hidden', 'true');
      document.documentElement.removeAttribute('data-modal-open');
      unlockScroll();
      currentResolve = null;
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
      lastFocused = null;
      if (done) done();
    };
    if (window.Animate) Animate.closeModal(overlay, panel, finish);
    else { overlay.classList.remove('open'); panel.classList.remove('open'); finish(); }
  }

  function open(opts) {
    restoreBody();
    lastFocused = document.activeElement;
    title.textContent = opts.title || '';
    body.textContent  = opts.body || '';
    confirmBtn.textContent = opts.confirmLabel || 'Confirm';
    confirmBtn.className = opts.danger
      ? 'px-4 py-2 text-xs font-medium rounded-xl text-white transition al-btn-danger'
      : 'px-4 py-2 text-xs font-medium rounded-xl text-white transition al-btn-primary';

    currentResolve = opts.onConfirm || null;
    onCloseHook = opts.onClose || null;

    header.style.display = '';
    content.style.display = 'none';
    simple.style.display = '';
    footer.style.display = '';
    panel.setAttribute('aria-describedby', 'globalModalBody');
    panel.className = 'al-sheet-panel al-modal-panel relative border rounded-2xl shadow-lg w-full max-w-sm max-h-[85vh] flex flex-col';
    panel.style.background = 'var(--theme-bg-card)';
    panel.style.borderColor = 'var(--theme-border)';

    showPanel();
    setTimeout(function () { cancel.focus(); }, 0);
  }

  function show(opts) {
    var bodyNode = opts.bodyNode;

    /* Step 1: if a different body node is already in the modal, put it
       back on the page first so getElementById finds it next time. */
    if (lastBodyNode && lastBodyNode !== bodyNode && lastBodyNode.parentNode === content) {
      restoreBody();
    }

    lastFocused = document.activeElement;
    onCloseHook = opts.onClose || null;
    title.textContent = opts.title || '';
    panel.setAttribute('aria-describedby', '');

    /* Step 2: record the node's original position (first time only),
       then move it into the modal content. */
    if (bodyNode) {
      if (bodyOrigins && !bodyOrigins.has(bodyNode)) {
        bodyOrigins.set(bodyNode, { parent: bodyNode.parentNode, ref: bodyNode.nextSibling });
      }
      content.innerHTML = '';
      content.appendChild(bodyNode);
      bodyNode.style.display = '';
      lastBodyNode = bodyNode;
    }

    header.style.display = '';
    content.style.display = '';
    simple.style.display = 'none';
    footer.style.display = 'none';
    panel.className = 'al-sheet-panel al-modal-panel relative border rounded-2xl shadow-lg w-full max-h-[85vh] flex flex-col' + (opts.panelClass ? ' ' + opts.panelClass : '');
    panel.style.background = 'var(--theme-bg-card)';
    panel.style.borderColor = 'var(--theme-border)';

    showPanel();
    setTimeout(function () { panel.focus(); }, 0);
  }

  function close() {
    var hook = onCloseHook;
    onCloseHook = null;
    restoreBody();
    hidePanel(function () {
      if (hook) hook();
    });
  }

  cancel.addEventListener('click', close);
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);

  confirmBtn.addEventListener('click', function () {
    var fn = currentResolve;
    close();
    if (fn) fn();
  });

  overlay.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
      event.preventDefault();
      close();
      return;
    }
    if (event.key !== 'Tab') return;
    var focusable = focusableElements();
    if (!focusable.length) {
      event.preventDefault();
      panel.focus();
      return;
    }
    var first = focusable[0];
    var last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  function alertFn(message) {
    if (message && typeof message === 'object') open(message);
    else open({ title: 'Error', body: String(message || '') });
  }

  window.modal = { confirm: open, alert: alertFn, show: show, close: close };
})();
</script>