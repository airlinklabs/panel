<!-- Global modal — one modal implementation for the whole panel.
     Confirmations: window.modal.confirm({ title, body, danger, confirmLabel, onConfirm })
     Alerts:        window.modal.alert({ title, body })
     Rich sheets:   window.modal.show({ title, bodyNode, panelClass, onClose })
                    bodyNode is moved into the shared panel; close with window.modal.close(). -->
<div id="globalModal" class="al-sheet-overlay al-modal-overlay fixed inset-0 z-50 hidden items-center justify-center" aria-hidden="true">
  <div class="absolute inset-0" id="globalModalBackdrop"></div>
  <div id="globalModalPanel" role="dialog" aria-modal="true" aria-labelledby="globalModalTitle" aria-describedby="globalModalBody" tabindex="-1" class="al-sheet-panel al-modal-panel relative border rounded-2xl shadow-lg w-full max-w-sm mx-4 max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <div id="globalModalHeader" class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
      <p id="globalModalTitle" class="text-sm font-semibold leading-snug truncate" style="color:var(--theme-text-strong);"></p>
      <button type="button" id="globalModalCloseBtn" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close"><%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %></button>
    </div>
    <div id="globalModalContent" class="overflow-y-auto px-6 py-4 flex-grow" style="display:none;"></div>
    <div id="globalModalSimple" class="px-6 py-4">
      <p id="globalModalBody" class="text-xs leading-relaxed" style="color:var(--theme-text-muted);"></p>
    </div>
    <div id="globalModalFooter" class="flex gap-2 px-6 py-4 border-t justify-end shrink-0" style="border-color:var(--theme-border);">
      <button type="button" id="globalModalCancel" class="al-btn-secondary inline-flex items-center gap-1.5"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Cancel</button>
      <button type="button" id="globalModalConfirm" class="px-4 py-2 text-xs font-medium rounded-xl text-white transition"></button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
(function () {
  if (window.modal) return;

  const overlay  = document.getElementById('globalModal');
  const panel    = document.getElementById('globalModalPanel');
  const header   = document.getElementById('globalModalHeader');
  const title    = document.getElementById('globalModalTitle');
  const body     = document.getElementById('globalModalBody');
  const content  = document.getElementById('globalModalContent');
  const simple   = document.getElementById('globalModalSimple');
  const footer   = document.getElementById('globalModalFooter');
  const cancel   = document.getElementById('globalModalCancel');
  const confirmBtn  = document.getElementById('globalModalConfirm');
  const backdrop = document.getElementById('globalModalBackdrop');
  const closeBtn = document.getElementById('globalModalCloseBtn');

  let currentResolve = null;
  let lastFocused = null;
  let onCloseHook = null;
  let richNode = null;
  let richPanelClass = null;

  function focusableElements() {
    return Array.from(panel.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
      .filter(el => !el.disabled && el.offsetParent !== null);
  }

  function lockScroll() {
    document.body.style.overflow = 'hidden';
  }

  function unlockScroll() {
    document.body.style.overflow = '';
  }

  function showPanel() {
    overlay.setAttribute('aria-hidden', 'false');
    document.documentElement.setAttribute('data-modal-open', '');
    lockScroll();
    if (window.Animate) Animate.openModal(overlay, panel);
    else { overlay.classList.add('open'); panel.classList.add('open'); }
  }

  function hidePanel(done) {
    const finish = function () {
      overlay.setAttribute('aria-hidden', 'true');
      document.documentElement.removeAttribute('data-modal-open');
      unlockScroll();
      currentResolve = null;
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
      lastFocused = null;
      if (done) done();
    };
    if (window.Animate) Animate.closeModal(overlay, panel, finish);
    else { overlay.classList.remove('open'); panel.classList.remove('open'); finish(); }
  }

  function open({ title: t, body: b, danger = false, confirmLabel = 'Confirm', onConfirm }) {
    lastFocused = document.activeElement;
    title.textContent = t || '';
    body.textContent  = b || '';
    confirmBtn.textContent = confirmLabel;
    confirmBtn.className = danger
      ? 'px-4 py-2 text-xs font-medium rounded-xl text-white transition al-btn-danger'
      : 'px-4 py-2 text-xs font-medium rounded-xl text-white transition al-btn-primary';

    currentResolve = onConfirm || null;
    onCloseHook = null;
    richNode = null;

    header.style.display = '';
    content.style.display = 'none';
    simple.style.display = '';
    footer.style.display = '';
    panel.setAttribute('aria-describedby', 'globalModalBody');
    panel.className = 'al-sheet-panel al-modal-panel relative border rounded-2xl shadow-lg w-full max-w-sm mx-4 max-h-[85vh] flex flex-col';
    panel.style.background = 'var(--theme-bg-card)';
    panel.style.borderColor = 'var(--theme-border)';

    showPanel();
    // Focus the neutral action first — never land on the destructive
    // confirm (one accidental Enter should not destroy).
    setTimeout(function () { cancel.focus(); }, 0);
  }

  function show({ title: t, bodyNode, panelClass = '', onClose }) {
    lastFocused = document.activeElement;
    onCloseHook = onClose || null;

    title.textContent = t || '';
    panel.setAttribute('aria-describedby', '');

    if (bodyNode) {
      content.innerHTML = '';
      bodyNode.style.display = '';
      content.appendChild(bodyNode);
    }
    header.style.display = '';
    content.style.display = '';
    simple.style.display = 'none';
    footer.style.display = 'none';
    panel.className = 'al-sheet-panel al-modal-panel relative border rounded-2xl shadow-lg w-full mx-4 max-h-[85vh] flex flex-col' + (panelClass ? ' ' + panelClass : '');
    panel.style.background = 'var(--theme-bg-card)';
    panel.style.borderColor = 'var(--theme-border)';

    showPanel();
    setTimeout(function () { panel.focus(); }, 0);
  }

  function close() {
    const hook = onCloseHook;
    onCloseHook = null;
    hidePanel(function () {
      if (hook) hook();
    });
  }

  cancel.addEventListener('click', close);
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);

  confirmBtn.addEventListener('click', () => {
    const fn = currentResolve;
    close();
    if (fn) fn();
  });

  overlay.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
      event.preventDefault();
      close();
      return;
    }
    if (event.key !== 'Tab') return;
    const focusable = focusableElements();
    if (!focusable.length) {
      event.preventDefault();
      panel.focus();
      return;
    }
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  function alert(message) {
    if (message && typeof message === 'object') open(message);
    else open({ title: 'Error', body: String(message || '') });
  }

  window.modal = { confirm: open, alert: alert, show: show, close: close };
})();
</script>
