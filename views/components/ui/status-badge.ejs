<% /* status-badge: { status: online|offline|starting|stopping|installing|suspended } */
const s = (locals.status || 'offline').toLowerCase();
const configs = {
  online:     { cls: 'al-badge-online',  label: 'Online' },
  offline:    { cls: 'al-badge-offline', label: 'Offline' },
  starting:   { cls: 'al-badge-warning', label: 'Starting' },
  stopping:   { cls: 'al-badge-warning', label: 'Stopping' },
  installing: { cls: 'al-badge-info',    label: 'Installing' },
  suspended:  { cls: 'al-badge-offline', label: 'Suspended' },
};
const cfg = configs[s] || configs.offline;
%>
<span class="<%= cfg.cls %>">
  <span class="al-dot-<%= s === 'online' ? 'online' : ['starting','stopping'].includes(s) ? 'warning' : 'offline' %>"></span>
  <%= locals.label || cfg.label %>
</span>