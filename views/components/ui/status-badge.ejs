<% /* status-badge: { status: online|offline|starting|stopping|installing|suspended } */
const s = (locals.status || 'offline').toLowerCase();
const configs = {
  online:     { cls: 'al-badge-online',  label: t('online') },
  offline:    { cls: 'al-badge-offline', label: t('offline') },
  starting:   { cls: 'al-badge-warning', label: t('starting') },
  stopping:   { cls: 'al-badge-warning', label: t('stopping') },
  installing: { cls: 'al-badge-info',    label: t('installing') },
  suspended:  { cls: 'al-badge-offline', label: t('suspended') },
};
const cfg = configs[s] || configs.offline;
%>
<span class="<%= cfg.cls %>">
  <span class="al-dot-<%= s === 'online' ? 'online' : ['starting','stopping'].includes(s) ? 'warning' : 'offline' %>"></span>
  <%= locals.label || cfg.label %>
</span>