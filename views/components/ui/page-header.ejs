<% /* page-header: { title, description, actions } */ %>
<div class="al-page-header flex items-start justify-between gap-3">
  <div class="min-w-0">
    <h1 class="al-page-title"><%= locals.title || '' %></h1>
    <% if (locals.description) { %>
    <p class="al-page-desc"><%= locals.description %></p>
    <% } %>
  </div>
  <% if (locals.actions) { %>
  <div class="flex items-center gap-1.5 shrink-0"><%- locals.actions %></div>
  <% } %>
</div>
