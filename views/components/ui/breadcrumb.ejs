<% /* breadcrumb: { items: [{ label, href? }] } */ %>
<% if (locals.items && items.length > 0) { %>
<div class="w-full" style="border-bottom:1px solid var(--theme-border);background:var(--theme-bg-secondary);">
  <div class="pr-6 sm:pr-8 pl-0 py-3">
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5 text-xs">
        <% items.forEach(function(item, index) { %>
          <li class="flex items-center gap-1.5">
            <% if (index > 0) { %>
              <span style="color:var(--theme-text-placeholder);font-size:11px;">/</span>
            <% } %>
            <% if (item.href && index < items.length - 1) { %>
              <a href="<%= item.href %>" class="transition" style="color:var(--theme-text-muted);"><%= item.label %></a>
            <% } else { %>
              <span style="color:var(--theme-text-strong);font-weight:500;"><%= item.label %></span>
            <% } %>
          </li>
        <% }); %>
      </ol>
    </nav>
  </div>
</div>
<% } %>