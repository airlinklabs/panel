<% /* breadcrumb: { items: [{ label, href? }] } */ %>
<% if (locals.items && items.length > 0) { %>
<div class="lg:hidden w-full" style="border-bottom:1px solid var(--theme-border);background:var(--theme-bg-secondary);">
  <div class="pr-6 sm:pr-8 pl-0 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5 text-[11px] min-w-0">
        <% items.forEach(function(item, index) { %>
          <li class="flex items-center gap-1.5 min-w-0 <%= index === items.length - 1 ? 'flex-1' : 'shrink-0' %>">
            <% if (index > 0) { %>
              <span class="shrink-0" style="color:var(--theme-text-placeholder);font-size:10px;">/</span>
            <% } %>
            <% if (item.href && index < items.length - 1) { %>
              <a href="<%= item.href %>" class="transition truncate" style="color:var(--theme-text-muted);"><%= item.label %></a>
            <% } else { %>
              <span class="truncate" style="color:var(--theme-text-muted);font-weight:500;"><%= item.label %></span>
            <% } %>
          </li>
        <% }); %>
      </ol>
    </nav>
  </div>
</div>
<script nonce="<%- nonce %>">
(function () {
  const slot = document.getElementById('topbar-breadcrumbs');
  if (!slot) return;
  const items = <%- JSON.stringify(items).replace(/</g, '\\x3c') %>;
  slot.classList.remove('hidden');
  slot.innerHTML = '';
  items.forEach(function (item, i) {
    if (i > 0) {
      const sep = document.createElement('span');
      sep.className = 'mx-1 shrink-0';
      sep.style.color = 'var(--theme-text-placeholder)';
      sep.style.fontSize = '11px';
      sep.textContent = '/';
      slot.appendChild(sep);
    }
    if (item.href && i < items.length - 1) {
      const a = document.createElement('a');
      a.href = item.href;
      a.className = 'transition whitespace-nowrap';
      a.style.color = 'var(--theme-text-muted)';
      a.textContent = item.label;
      slot.appendChild(a);
    } else {
      const span = document.createElement('span');
      span.className = 'truncate whitespace-nowrap font-medium';
      span.style.color = 'var(--theme-text-muted)';
      span.style.minWidth = '0';
      span.style.flex = '0 1 auto';
      span.textContent = item.label;
      slot.appendChild(span);
    }
  });
})();
</script>
<% } %>
