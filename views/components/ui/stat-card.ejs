<% /* stat-card: { label, value, href, iconName } */ %>
<a href="<%= locals.href || '#' %>" class="group al-card p-3 hover:border-[var(--theme-border-accent)] transition-colors">
  <div class="flex items-center justify-between mb-2">
    <div class="inline-flex items-center justify-center w-7 h-7 rounded-lg" style="background:var(--theme-bg-secondary);">
      <%- icon(locals.iconName || 'bar-chart', { class: 'w-3.5 h-3.5', style: 'color:var(--theme-text-muted)' }) %>
    </div>
    <%- icon('arrow-right', { class: 'w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity', style: 'color:var(--theme-text-muted)' }) %>
  </div>
  <p class="text-xl font-semibold tabular-nums" style="color:var(--theme-text-strong)"><%= locals.value ?? '—' %></p>
  <p class="text-[11px] mt-0.5" style="color:var(--theme-text-muted)"><%= locals.label || '' %></p>
</a>
