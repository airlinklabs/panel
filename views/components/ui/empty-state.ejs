<% /* empty-state: { iconName, title, description, action } */ %>
<div class="flex flex-col items-center justify-center py-20 text-center">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">
    <%- icon(locals.iconName || 'inbox', { class: 'w-6 h-6', style: 'color:var(--theme-text-muted)' }) %>
  </div>
  <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= locals.title || 'Nothing here' %></h3>
  <% if (locals.description) { %>
  <p class="text-sm mt-1 max-w-xs" style="color:var(--theme-text-muted)"><%= locals.description %></p>
  <% } %>
  <% if (locals.action) { %>
  <div class="mt-5"><%- locals.action %></div>
  <% } %>
</div>
