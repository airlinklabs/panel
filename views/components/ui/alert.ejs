<% /* alert: { type: danger|warning|success|info, message, detail } */
const type = locals.type || 'info';
const classes = { danger: 'al-alert-danger', warning: 'al-alert-warning', success: 'al-alert-success', info: 'al-alert-info' };
const icons   = { danger: 'triangle-alert', warning: 'triangle-alert', success: 'circle-check', info: 'info' };
%>
<div class="<%= classes[type] || classes.info %>">
  <%- icon(icons[type] || icons.info, { class: 'w-3.5 h-3.5 shrink-0 mt-0.5' }) %>
  <div>
    <p class="font-medium text-[13px]"><%= locals.message || '' %></p>
    <% if (locals.detail) { %><p class="text-[11px] mt-0.5" style="color:var(--theme-text-muted)"><%= locals.detail %></p><% } %>
  </div>
</div>