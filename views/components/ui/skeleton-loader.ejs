<% /* skeleton-loader: shows animated placeholder cards while data loads */ %>
<div class="al-skeleton-loader" role="status" aria-label="Loading">
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
    <% for (let i = 0; i < (locals.count || 6); i++) { %>
    <div class="al-card p-4 space-y-3">
      <div class="flex items-center gap-3">
        <div class="al-skeleton w-10 h-10 rounded-lg"></div>
        <div class="flex-1 space-y-2">
          <div class="al-skeleton h-3.5 w-2/3 rounded"></div>
          <div class="al-skeleton h-2.5 w-1/3 rounded"></div>
        </div>
      </div>
      <div class="space-y-2">
        <div class="al-skeleton h-2.5 w-full rounded"></div>
        <div class="al-skeleton h-2.5 w-4/5 rounded"></div>
      </div>
      <div class="flex gap-2 pt-1">
        <div class="al-skeleton h-8 w-16 rounded-lg"></div>
        <div class="al-skeleton h-8 w-16 rounded-lg"></div>
      </div>
    </div>
    <% } %>
  </div>
  <span class="sr-only">Loading content...</span>
</div>

<style>
  .al-skeleton {
    background: var(--theme-skeleton-base);
    position: relative;
    overflow: hidden;
  }
  .al-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--theme-skeleton-shine, rgba(255,255,255,0.08)) 50%,
      transparent 100%
    );
    animation: al-skeleton-shimmer 1.5s ease-in-out infinite;
  }
  @keyframes al-skeleton-shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .dark .al-skeleton::after {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255,255,255,0.04) 50%,
      transparent 100%
    );
  }
  @media (prefers-reduced-motion: reduce) {
    .al-skeleton::after { animation: none; }
  }
</style>
