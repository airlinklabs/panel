<%- include('../../components/header', { title: 'Overview' }) %>

<main id="page-content" class="">
  <%- include('../../components/template') %>

  <div class="px-4 py-5">
<div class="flex items-center justify-between mb-5">
        <div>
           <h1 class="text-base font-medium text-neutral-800 dark:text-white" data-theme-i18n="adminUserTitle"><%= req.translations.adminUserTitle %></h1>
           <p class="text-xs text-neutral-500 mt-0.5" data-theme-i18n="adminUserText"><%= req.translations.adminUserText %></p>
         </div>
         <a href="/admin/users/edit/<%= dataUser.id %>" class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 px-3 py-2 text-xs font-medium text-white transition shrink-0" data-theme-i18n="editUser">
           <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
             <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
           </svg>
           <%= req.translations.editUser || 'Edit User' %>
         </a>
       </div>
       </div>
       <div class="px-4 mt-5">
         <!-- User details will be displayed here -->
         <div class="bg-white dark:bg-neutral-800/50 rounded-xl p-6 shadow-lg border border-neutral-200 dark:border-neutral-700/30">
           <div class="flex items-center gap-4 mb-5 pb-5 border-b border-neutral-200 dark:border-neutral-700/30">
             <img class="h-14 w-14 rounded-xl object-cover shrink-0 border border-neutral-200 dark:border-neutral-700/30" src="<%= dataUser.avatar ? dataUser.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(dataUser.username) %>" alt="" data-theme-image="{{viewedUser.avatar}}" data-theme-bindings="<%= JSON.stringify({"viewedUser.avatar":(dataUser.avatar ? dataUser.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(dataUser.username))}) %>">
             <div>
               <p class="text-sm font-semibold text-neutral-800 dark:text-white" data-theme-text="{{viewedUser.name}}" data-theme-bindings="<%= JSON.stringify({"viewedUser.name":(dataUser.username)}) %>"><%= dataUser.username %></p>
               <p class="text-xs text-neutral-500 dark:text-neutral-400" data-theme-text="{{viewedUser.email}}" data-theme-bindings="<%= JSON.stringify({"viewedUser.email":(dataUser.email)}) %>"><%= dataUser.email %></p>
             </div>
           </div>
           <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
             <div>
               <h2 class="text-lg font-medium text-neutral-800 dark:text-white border-b border-neutral-200 dark:border-neutral-700/30 pb-2 mb-4" data-theme-i18n="userInformation">
                 <%= req.translations.userInformation || 'User Information' %>
               </h2>
               <div class="space-y-4">
                 <div>
                   <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400" data-theme-i18n="username"><%= req.translations.username || 'Username' %></p>
                   <p class="mt-1 text-base font-medium text-neutral-800 dark:text-white" data-theme-text="{{viewedUser.name}}" data-theme-bindings="<%= JSON.stringify({"viewedUser.name":(dataUser.username)}) %>"><%= dataUser.username %></p>
                 </div>
                 <div>
                   <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400" data-theme-i18n="email"><%= req.translations.email || 'Email' %></p>
                   <p class="mt-1 text-base font-medium text-neutral-800 dark:text-white" data-theme-text="{{viewedUser.email}}" data-theme-bindings="<%= JSON.stringify({"viewedUser.email":(dataUser.email)}) %>"><%= dataUser.email %></p>
                 </div>
                 <div>
                   <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400" data-theme-i18n="role"><%= req.translations.role || 'Role' %></p>
                   <p class="mt-1">
                     <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                       <%= dataUser.isAdmin ? 'bg-emerald-600/10 text-emerald-400 ring-emerald-600/20' : 'bg-amber-600/10 text-amber-400 ring-red-600/20' %> ring-1 ring-inset" data-theme-text="{{viewedUser.role}}" data-theme-bindings="<%= JSON.stringify({"viewedUser.role":(dataUser.isAdmin ? req.translations.admin : 'User')}) %>">
                       <%= dataUser.isAdmin ? req.translations.admin : 'User' %>
                     </span>
                   </p>
                 </div>
                 <div>
                   <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400" data-theme-i18n="description"><%= req.translations.description || 'Description' %></p>
                   <p class="mt-1 text-base font-medium text-neutral-800 dark:text-white" data-theme-text="{{viewedUser.description}}" data-theme-bindings="<%= JSON.stringify({"viewedUser.description":(dataUser.description)}) %>"><%= dataUser.description || 'No description provided' %></p>
                 </div>
               </div>
             </div>
             <div>
               <h2 class="text-lg font-medium text-neutral-800 dark:text-white border-b border-neutral-200 dark:border-neutral-700/30 pb-2 mb-4" data-theme-i18n="serverInformation">
                 <%= req.translations.serverInformation || 'Server Information' %>
               </h2>
               <div class="space-y-4">
                 <div>
                   <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400" data-theme-i18n="totalServers"><%= req.translations.totalServers || 'Total Servers' %></p>
                   <p class="mt-1 text-base font-medium text-neutral-800 dark:text-white" data-theme-text="{{viewedUser.serverCount}}" data-theme-bindings="<%= JSON.stringify({"viewedUser.serverCount":(dataUser.servers ? dataUser.servers.length : 0)}) %>"><%= dataUser.servers ? dataUser.servers.length : 0 %></p>
                 </div>
               </div>
             </div>
           </div>
         </div>
       </div>
    </div>
  </div>
</main>
<%- include('../../components/footer') %>