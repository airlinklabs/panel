<%- include('../../components/header', { title: 'Theme Store' }) %>
<%- include('../../components/toast') %>

<style>
  .ts-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; padding: 16px; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
  .ts-overlay.open { opacity: 1; pointer-events: auto; }
  .ts-box { background: #fff; width: 100%; max-width: 760px; max-height: calc(100vh - 32px); overflow-y: auto; transform: scale(0.97); transition: transform 0.2s; }
  html.dark .ts-box { background: #1c1c1c; }
  .ts-overlay.open .ts-box { transform: none; }
  .ts-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  .ts-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ts-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 28px; height: 28px; border-radius: 999px; background: rgba(0,0,0,0.45); color: #fff; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer; opacity: 0; transition: opacity 0.15s; }
  .ts-media:hover .ts-nav, .ts-nav:focus-visible { opacity: 1; }
  .ts-nav.prev { left: 8px; }
  .ts-nav.next { right: 8px; }
  .ts-dots { position: absolute; bottom: 8px; left: 0; right: 0; display: flex; justify-content: center; gap: 5px; pointer-events: none; }
  .ts-dots span { width: 6px; height: 6px; border-radius: 999px; background: rgba(255,255,255,0.5); }
  .ts-dots span.on { background: #fff; }
  .ts-thumb { width: 72px; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 8px; border: 2px solid transparent; cursor: pointer; opacity: 0.7; }
  .ts-thumb.on { border-color: #a3a3a3; opacity: 1; }
  .ts-clamp { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<main id="page-content" class="">
  <%- include('../../components/template') %>

  <div class="px-4 py-5">
    <div class="px-4 pt-6 pb-0">
      <h1 class="text-base font-medium text-neutral-800 dark:text-white">Themes</h1>
      <p class="mt-0.5 text-sm text-neutral-500">Browse and install themes from the community store</p>
    </div>
    <div class="px-4 mt-5">
      <div class="flex items-center gap-3 mb-6">
        <input id="themeStoreFilterInput" type="text" placeholder="Search themes…" class="flex-1 min-w-0 sm:flex-none sm:w-52 rounded-xl border border-neutral-200 dark:border-neutral-600/30 bg-neutral-100 dark:bg-neutral-700/20 px-4 py-2 text-sm text-neutral-800 dark:text-white placeholder-neutral-400 focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-500 transition">
        <a href="/admin/settings#appearance" class="inline-block rounded-xl border border-neutral-200 dark:border-neutral-600/30 bg-neutral-100 dark:bg-neutral-700/20 hover:bg-neutral-200 dark:hover:bg-neutral-700/40 px-4 py-2 text-sm font-medium text-neutral-800 dark:text-white transition ml-auto shrink-0 whitespace-nowrap">Back to Appearance</a>
      </div>
      <div id="storeLoading" class="grid gap-5 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3"><% for (let i = 0; i < 3; i++) { %><div class="bg-white dark:bg-white/5 rounded-xl border border-neutral-200 dark:border-white/5 shadow-sm dark:shadow-none h-72 animate-pulse"></div><% } %></div>
      <div id="storeError" style="display:none" class="py-16 text-center"><p id="storeErrorMsg" class="text-sm text-neutral-500" data-theme-text="{{page.storeErrorMsg}}" data-theme-bindings="<%= JSON.stringify({"page.storeErrorMsg":("")}) %>" data-theme-live="page.storeErrorMsg"></p><button onclick="loadStore()" class="mt-3 text-xs text-neutral-400 underline cursor-pointer bg-transparent border-none">Retry</button></div>
      <div id="storeEmpty" style="display:none" class="py-16 text-center"><p class="text-sm text-neutral-500">No themes match your search.</p><button id="clearSearch" class="mt-3 text-xs text-neutral-400 underline cursor-pointer bg-transparent border-none">Clear</button></div>
      <div id="storeGrid" style="display:none" class="grid gap-5 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3"></div>
    </div>
  </div>
</main>

<div class="ts-overlay" id="themeOverlay">
  <div class="ts-box rounded-xl border border-neutral-200 dark:border-white/5 shadow-sm" role="dialog" aria-modal="true" aria-labelledby="dlgName">
    <div id="dlgMedia" class="ts-media bg-neutral-100 dark:bg-neutral-700/20"></div>
    <div id="dlgThumbs" class="flex gap-2 px-5 pt-4 overflow-x-auto"></div>
    <div class="px-5 py-5">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap"><p id="dlgName" class="text-base font-medium text-neutral-800 dark:text-white" data-theme-text="{{page.dlgName}}" data-theme-bindings="<%= JSON.stringify({"page.dlgName":("")}) %>" data-theme-live="page.dlgName"></p><span id="dlgBadges" class="flex gap-1.5"></span></div>
          <p id="dlgMeta" class="text-xs text-neutral-400 mt-0.5" data-theme-text="{{page.dlgMeta}}" data-theme-bindings="<%= JSON.stringify({"page.dlgMeta":("")}) %>" data-theme-live="page.dlgMeta"></p>
        </div>
      </div>
      <p id="dlgDesc" class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mt-4 whitespace-pre-line" data-theme-text="{{page.dlgDesc}}" data-theme-bindings="<%= JSON.stringify({"page.dlgDesc":("")}) %>" data-theme-live="page.dlgDesc"></p>
      <p id="dlgContent" style="display:none" class="text-xs text-neutral-500 mt-3">Changes text, images or icons. Needs a panel that supports theme content.</p>
      <div class="flex items-center gap-2 mt-5">
        <button id="dlgInstall" type="button" class="rounded-xl bg-neutral-900 dark:bg-white hover:bg-neutral-700 dark:hover:bg-neutral-200 text-white dark:text-neutral-900 px-6 py-2 text-sm font-medium shadow-sm transition disabled:opacity-50 disabled:cursor-not-allowed" data-theme-text="{{page.dlgInstall}}" data-theme-bindings="<%= JSON.stringify({"page.dlgInstall":("Install")}) %>" data-theme-live="page.dlgInstall">Install</button>
        <a id="dlgApply" href="/admin/settings#appearance" style="display:none" class="rounded-xl bg-neutral-900 dark:bg-white hover:bg-neutral-700 dark:hover:bg-neutral-200 text-white dark:text-neutral-900 px-6 py-2 text-sm font-medium shadow-sm transition disabled:opacity-50 disabled:cursor-not-allowed">Apply in Appearance</a>
        <a id="dlgGh" href="#" target="_blank" rel="noopener noreferrer" class="inline-block rounded-xl border border-neutral-200 dark:border-neutral-600/30 bg-neutral-100 dark:bg-neutral-700/20 hover:bg-neutral-200 dark:hover:bg-neutral-700/40 px-4 py-2 text-sm font-medium text-neutral-800 dark:text-white transition">GitHub</a>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const PILL = 'text-xs text-neutral-400 bg-neutral-100 dark:bg-neutral-700/40 px-2 py-0.5 rounded-full';
  const CARD = 'bg-white dark:bg-white/5 rounded-xl border border-neutral-200 dark:border-white/5 shadow-sm dark:shadow-none';
  function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function show(id, d) { const el = document.getElementById(id); if (el) el.style.display = d || ''; }
  function hide(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }
  const arrow = d => '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:14px;height:14px"><path stroke-linecap="round" stroke-linejoin="round" d="' + d + '"/></svg>';
  let themes = [], current = null;

  function media(el, images, onChange) {
    let index = 0;
    function draw() {
      if (!images.length) { el.innerHTML = '<div class="w-full h-full flex items-center justify-center text-xs text-neutral-400">No preview</div>'; return; }
      el.innerHTML = '<img src="' + esc(images[index]) + '" alt="" loading="lazy">' + (images.length > 1
        ? '<button type="button" class="ts-nav prev" aria-label="Previous image">' + arrow('M15.75 19.5 8.25 12l7.5-7.5') + '</button><button type="button" class="ts-nav next" aria-label="Next image">' + arrow('m8.25 4.5 7.5 7.5-7.5 7.5') + '</button><div class="ts-dots">' + images.map((_, i) => '<span class="' + (i === index ? 'on' : '') + '"></span>').join('') + '</div>'
        : '');
      el.querySelectorAll('.ts-nav').forEach(b => b.addEventListener('click', e => { e.stopPropagation(); go(index + (b.classList.contains('next') ? 1 : -1)); }));
      if (onChange) onChange(index);
    }
    function go(i) { index = (i + images.length) % images.length; draw(); }
    draw();
    return go;
  }

  function badges(t) {
    return (t.installed ? '<span class="' + PILL + '">Installed</span>' : '') + (t.content ? '<span class="' + PILL + '">Content</span>' : '');
  }

  async function loadStore() {
    ['storeError', 'storeGrid', 'storeEmpty'].forEach(hide); show('storeLoading', 'grid');
    try {
      const res = await fetch('/admin/themes/store/list');
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'The theme store could not be loaded.');
      hide('storeLoading');
      themes = data.available ? data.themes : [];
      render(filtered());
    } catch (err) {
      hide('storeLoading');
      const msg = String(err && err.message || err);
      document.getElementById('storeErrorMsg').textContent = /rate|403|429/i.test(msg) ? 'GitHub rate limit reached. Try again in a few minutes.' : msg;
      show('storeError');
    }
  }
  window.loadStore = loadStore;

  function filtered() {
    const q = document.getElementById('themeStoreFilterInput').value.trim().toLowerCase();
    return themes.filter(t => (!q || [t.name, t.description, t.author].some(v => (v || '').toLowerCase().includes(q))));
  }

  function render(list) {
    const grid = document.getElementById('storeGrid');
    if (!list.length) { hide('storeGrid'); show('storeEmpty'); return; }
    hide('storeEmpty');
    grid.innerHTML = '';
    list.forEach(t => {
      const el = document.createElement('div');
      el.className = CARD + ' overflow-hidden cursor-pointer transition hover:border-neutral-300 dark:hover:border-white/10';
      el.tabIndex = 0;
      el.innerHTML = '<div class="ts-media bg-neutral-100 dark:bg-neutral-700/20"></div>' +
        '<div class="px-4 py-3.5">' +
          '<div class="flex items-center justify-between gap-2"><p class="text-sm font-medium text-neutral-800 dark:text-white truncate">' + esc(t.name) + '</p><span class="flex gap-1.5 shrink-0">' + badges(t) + '</span></div>' +
          '<p class="ts-clamp text-xs text-neutral-500 mt-1 leading-relaxed">' + esc(t.description) + '</p>' +
          '<p class="text-xs text-neutral-400 mt-2">' + esc([t.author && 'by ' + t.author, t.version && 'v' + t.version].filter(Boolean).join(' · ')) + '</p>' +
        '</div>';
      media(el.querySelector('.ts-media'), t.images || []);
      el.addEventListener('click', () => openDetail(t));
      el.addEventListener('keydown', e => { if (e.key === 'Enter') openDetail(t); });
      grid.appendChild(el);
    });
    show('storeGrid', 'grid');
  }

  function setInstall() {
    const btn = document.getElementById('dlgInstall');
    btn.disabled = false;
    btn.textContent = 'Install';
    btn.style.display = current.installed ? 'none' : '';
    document.getElementById('dlgApply').style.display = current.installed ? '' : 'none';
  }

  function openDetail(t) {
    current = t;
    const images = t.images || [];
    const thumbs = document.getElementById('dlgThumbs');
    thumbs.innerHTML = images.length > 1 ? images.map((src, i) => '<img class="ts-thumb" data-i="' + i + '" src="' + esc(src) + '" alt="">').join('') : '';
    thumbs.style.display = images.length > 1 ? '' : 'none';
    const mediaEl = document.getElementById('dlgMedia');
    mediaEl.style.display = images.length ? '' : 'none';
    const go = media(mediaEl, images, i => thumbs.querySelectorAll('.ts-thumb').forEach(th => th.classList.toggle('on', Number(th.dataset.i) === i)));
    thumbs.querySelectorAll('.ts-thumb').forEach(th => th.addEventListener('click', () => go(Number(th.dataset.i))));
    document.getElementById('dlgName').textContent = t.name;
    document.getElementById('dlgBadges').innerHTML = badges(t);
    document.getElementById('dlgMeta').textContent = [t.author && 'by ' + t.author, t.version && 'v' + t.version].filter(Boolean).join(' · ');
    document.getElementById('dlgDesc').textContent = t.longDescription || t.description || '';
    document.getElementById('dlgContent').style.display = t.content ? '' : 'none';
    document.getElementById('dlgGh').href = t.github;
    setInstall();
    document.getElementById('themeOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDetail() { document.getElementById('themeOverlay').classList.remove('open'); document.body.style.overflow = ''; current = null; }

  document.getElementById('dlgInstall').addEventListener('click', async function () {
    if (!current || current.installed) return;
    const t = current, btn = this;
    btn.disabled = true; btn.textContent = 'Installing…';
    try {
      const res = await fetch('/admin/themes/store/install', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug: t.id }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error(data.message || 'The theme could not be installed.');
      t.installed = true;
      showToast(data.message, 'success');
      render(filtered());
      if (current === t) document.getElementById('dlgBadges').innerHTML = badges(t);
    } catch (err) {
      showToast(err.message, 'error');
    }
    if (current === t) setInstall();
  });

  document.getElementById('themeOverlay').addEventListener('click', e => { if (e.target === e.currentTarget) closeDetail(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && current) closeDetail(); });
  document.getElementById('themeStoreFilterInput').addEventListener('input', () => render(filtered()));
  document.getElementById('clearSearch').addEventListener('click', () => { document.getElementById('themeStoreFilterInput').value = ''; render(filtered()); });
  loadStore();
})();
</script>

<%- include('../../components/footer') %>
