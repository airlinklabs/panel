<%- include('../partials/head') %>
<div class="docs-layout">
  <aside class="docs-sidebar">
    <div class="docs-sidebar-header">
      <h2>Documentation</h2>
      <input type="text" id="docs-search" placeholder="Search docs..." class="docs-search-input">
    </div>
    <nav class="docs-nav">
      <% sections.forEach(section => { %>
        <div class="docs-section">
          <h3 class="docs-section-title"><%= section.name %></h3>
          <ul class="docs-section-list">
            <% section.pages.forEach(page => { %>
              <li>
                <a href="/docs/<%= page.slug %>" class="docs-link<%= currentSlug === page.slug ? ' active' : '' %>">
                  <%= page.title %>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </nav>
  </aside>
  <main class="docs-content">
    <div class="docs-welcome">
      <h1>Airlink Panel Documentation</h1>
      <p>Comprehensive documentation for the Airlink game server management panel.</p>
      <div class="docs-quick-links">
        <a href="/docs/getting-started" class="docs-card">
          <span class="docs-card-icon">🚀</span>
          <span class="docs-card-title">Getting Started</span>
          <span class="docs-card-desc">Set up your panel</span>
        </a>
        <a href="/docs/features/servers" class="docs-card">
          <span class="docs-card-icon">🖥️</span>
          <span class="docs-card-title">Servers</span>
          <span class="docs-card-desc">Manage game servers</span>
        </a>
        <a href="/docs/admin/getting-started" class="docs-card">
          <span class="docs-card-icon">⚙️</span>
          <span class="docs-card-title">Admin Guide</span>
          <span class="docs-card-desc">Administration reference</span>
        </a>
        <a href="/docs/api/v2-reference" class="docs-card">
          <span class="docs-card-icon">🔌</span>
          <span class="docs-card-title">API Reference</span>
          <span class="docs-card-desc">V2 REST API docs</span>
        </a>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/foot') %>
