<!--
  Fragment: shared-error-banner
  Used by: admin/users/delete, and other mutation error routes
  Target: #<%= targetId %>-error (or nearest error region)
  Swap: outerHTML
-->
<div id="<%= targetId %>-error" class="al-alert-danger" role="alert" aria-live="assertive">
  <%- icon('alert-circle', { class: 'h-5 w-5 shrink-0 mt-0.5' }) %>
  <div class="flex-1">
    <p class="al-alert-title"><%= message %></p>
    <% if (typeof hint !== 'undefined' && hint) { %>
    <p class="al-alert-body"><%= hint %></p>
    <% } %>
  </div>
  <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" onclick="this.closest('.al-alert-danger').remove()" aria-label="<%= t('close') %>">
    <%- icon('x', { class: 'h-4 w-4', strokeWidth: 1.5 }) %>
  </button>
</div>
