<!-- Recovery codes panel fragment — shown after successful 2FA enable -->
<div id="two-factor-recovery-codes" class="al-form-card max-w-xl mx-auto">
  <div class="flex items-start gap-3 mb-4">
    <span class="al-icon-tile al-icon-tile-sm al-icon-tile-accent shrink-0"><%- icon('key-round', { class: 'size-4' }) %></span>
    <div class="min-w-0">
      <h3 class="al-form-card-title"><%= t('savedRecoveryCodes') %></h3>
      <p class="al-form-card-desc"><%= t('recoveryCodesDesc') %></p>
    </div>
  </div>
  <div id="recoveryCodesList" class="grid grid-cols-2 sm:grid-cols-3 gap-2">
    <% for (const code of recoveryCodes) { %>
      <code class="al-badge al-badge-neutral font-mono justify-center select-all"><%= code %></code>
    <% } %>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3 mt-5">
    <button type="button" id="copyRecoveryCodes" class="al-btn al-btn-ghost"
      onclick="var codes=Array.from(document.querySelectorAll('#recoveryCodesList code')).map(function(c){return c.textContent}).join('\n');navigator.clipboard.writeText(codes).then(function(){showToast('<%= t('recoveryCodesCopied') %>','success')}).catch(function(){showToast('<%= t('couldNotCopy') %>','error')})">
      <%- icon('copy', { class: 'size-4' }) %>
      <%= t('copyAll') %>
    </button>
    <a href="/account" class="al-btn al-btn-primary"><%= t('iveSavedThem') %></a>
  </div>
</div>
