<!-- Server settings form fragment — vanilla JS auto-save -->
<div id="server-settings-form" class="al-card">
  <div class="al-card-header">
    <div class="min-w-0">
      <h2 class="al-card-title"><%= t('serverSettings') %></h2>
      <p class="al-card-subtitle"><%= t('serverSettingsDesc') %></p>
    </div>
  </div>

  <form id="serverSettingsFormEl">
    <div class="al-card-body">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <%- include('../../../partials/ui/form-field', {
          type: 'text', name: 'name', id: 'serverName',
          label: t('serverName'), value: '', cls: 'min-h-11'
        }) %>
        <%- include('../../../partials/ui/form-field', {
          type: 'text', name: 'description', id: 'serverDescription',
          label: t('description'), value: '', cls: 'min-h-11'
        }) %>
      </div>
      <div class="mt-5 flex items-center gap-3">
        <button type="submit" id="settingsSubmit" class="al-btn-primary min-h-11">
          <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %>
          <span id="settingsSaveLabel"><%= t('saveSettings') %></span>
          <span id="settingsSavingLabel" style="display:none"><%= t('saving') %></span>
        </button>
        <span id="settingsSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
      </div>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
(function() {
  var form = document.getElementById('serverSettingsFormEl');
  var nameInput = document.getElementById('serverName');
  var descInput = document.getElementById('serverDescription');
  var submitBtn = document.getElementById('settingsSubmit');
  var saveLabel = document.getElementById('settingsSaveLabel');
  var savingLabel = document.getElementById('settingsSavingLabel');
  var savedSpan = document.getElementById('settingsSaved');
  var saving = false;
  var debounceTimer = null;
  var msg = <%- JSON.stringify({
    savedPrefix: t('savedTimeAgo'),
    saved: t('settingsSaved'),
    saveFailed: t('failedToSaveSettings')
  }) %>;

  nameInput.value = '<%= server.name.replace(/\\/g, '\\\\').replace(/'/g, "\\'") %>';
  descInput.value = '<%= (server.description || "").replace(/\\/g, '\\\\').replace(/'/g, "\\'") %>';

  function updateSaved() {
    var now = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    savedSpan.textContent = msg.savedPrefix + now;
    savedSpan.style.display = '';
    setTimeout(function() { savedSpan.style.display = 'none'; }, 3000);
  }

  function save() {
    if (saving) return;
    saving = true;
    submitBtn.disabled = true;
    saveLabel.style.display = 'none';
    savingLabel.style.display = '';
    fetch('/api/v2/servers/<%= server.UUID %>/settings', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: nameInput.value, description: descInput.value }),
    }).then(function(res) { return res.json(); }).then(function(data) {
      if (data.success) {
        updateSaved();
        showToast(msg.saved, 'success');
      } else {
        showToast(data.error || msg.saveFailed, 'error');
      }
    }).catch(function() { showToast(msg.saveFailed, 'error'); })
    .finally(function() {
      saving = false;
      submitBtn.disabled = false;
      saveLabel.style.display = '';
      savingLabel.style.display = 'none';
    });
  }

  form.addEventListener('submit', function(e) { e.preventDefault(); save(); });

  function debounceSave() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(save, 500);
  }
  nameInput.addEventListener('input', debounceSave);
  descInput.addEventListener('input', debounceSave);
})();
</script>
