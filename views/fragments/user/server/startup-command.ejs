<!-- Startup command form fragment — vanilla JS auto-save -->
<div id="startup-command-form" class="al-card mb-6">
  <%
    let isStartupEditAllowed = false;
    try {
      isStartupEditAllowed = server.allowStartupEdit === true;
    } catch (e) {
      isStartupEditAllowed = false;
    }
  %>
  <div class="al-card-header">
    <div class="min-w-0">
      <h2 class="al-card-title"><%= t('startupCommand') %></h2>
      <p class="al-card-subtitle"><%= t('startupCommandDesc') %></p>
    </div>
    <div class="al-card-header-actions">
      <% if (!isStartupEditAllowed) { %>
        <span class="al-badge al-badge-offline">
          <%- icon('circle-x', { class: 'size-3', strokeWidth: 2 }) %>
          <%= t('editingDisabled') %>
        </span>
      <% } else { %>
        <span class="al-badge al-badge-online">
          <%- icon('circle-check', { class: 'size-3', strokeWidth: 2 }) %>
          <%= t('editingEnabled') %>
        </span>
      <% } %>
    </div>
  </div>

  <form id="startupCommandFormEl">
    <%- include('../../../partials/csrf') %>
    <div class="al-card-body">
      <label for="startCommand" class="al-form-label"><%= t('startupCommand') %></label>
      <textarea id="startCommand" name="startCommand" rows="3" class="al-input <%= !isStartupEditAllowed ? 'opacity-50 cursor-not-allowed' : '' %>" <%= !isStartupEditAllowed ? 'readonly' : '' %> aria-label="<%= t('startupCommand') %>"><%= server.StartCommand %></textarea>
      <% if (!isStartupEditAllowed) { %>
        <p class="al-form-help" style="color:var(--theme-danger)"><%= t('startupCommandDisabled') %></p>
      <% } else { %>
        <p class="al-form-help"><%= t('startupCommandHint') %></p>
      <% } %>
    </div>

    <div class="al-card-footer">
      <button type="submit" id="startupCommandSubmit" class="al-btn-primary <%= !isStartupEditAllowed ? 'opacity-50 cursor-not-allowed' : '' %> min-h-11" <%= !isStartupEditAllowed ? 'disabled' : '' %>>
        <span id="startupCommandSaveLabel"><%= t('saveCommand') %></span>
        <span id="startupCommandSavingLabel" style="display:none"><%= t('saving') %></span>
      </button>
      <span id="startupCommandSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
(function() {
  var form = document.getElementById('startupCommandFormEl');
  var textarea = document.getElementById('startCommand');
  var submitBtn = document.getElementById('startupCommandSubmit');
  var saveLabel = document.getElementById('startupCommandSaveLabel');
  var savingLabel = document.getElementById('startupCommandSavingLabel');
  var savedSpan = document.getElementById('startupCommandSaved');
  var saving = false;
  var debounceTimer = null;
  var msg = <%- JSON.stringify({
    savedPrefix: t('savedTimeAgo'),
    saved: t('startupCommandSaved'),
    saveFailed: t('failedToSaveCommand')
  }) %>;

  function updateSaved() {
    var now = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    savedSpan.textContent = msg.savedPrefix + now;
    savedSpan.style.display = '';
    setTimeout(function() { savedSpan.style.display = 'none'; }, 3000);
  }

  function save() {
    if (saving) return;
    var command = textarea.value.trim();
    if (!command) return;
    saving = true;
    submitBtn.disabled = true;
    saveLabel.style.display = 'none';
    savingLabel.style.display = '';
    fetch('/api/v2/servers/<%= server.UUID %>/startup/command', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ startCommand: textarea.value }),
    }).then(function(res) { return res.json(); }).then(function(data) {
      if (data.success) {
        updateSaved();
        showToast(msg.saved, 'success');
      } else {
        showToast(data.error || msg.saveFailed, 'error');
      }
    }).catch(function() { showToast(msg.saveFailed, 'error'); })
    .finally(function() {
      saving = false;
      submitBtn.disabled = false;
      saveLabel.style.display = '';
      savingLabel.style.display = 'none';
    });
  }

  form.addEventListener('submit', function(e) { e.preventDefault(); save(); });
  <% if (isStartupEditAllowed) { %>
  textarea.addEventListener('input', function() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(save, 500);
  });
  <% } %>
})();
</script>
