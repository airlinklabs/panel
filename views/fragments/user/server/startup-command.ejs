<!-- Startup command form fragment — vanilla JS auto-save -->
<div id="startup-command-form" class="al-card overflow-hidden mb-6">
  <div class="p-5 border-b flex justify-between items-center" style="border-color:var(--theme-border)">
    <div>
      <h2 class="text-lg font-semibold" style="color:var(--theme-text-strong)"><%= req.translations.startupCommand || 'Startup Command' %></h2>
      <p class="text-sm" style="color:var(--theme-text-muted)"><%= req.translations.startupCommandDesc || 'Customize the command used to start your server.' %></p>
    </div>
    <%
      let isStartupEditAllowed = false;
      try {
        isStartupEditAllowed = server.allowStartupEdit === true;
      } catch (e) {
        isStartupEditAllowed = false;
      }
      if (!isStartupEditAllowed) {
    %>
      <div class="flex items-center">
        <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-danger-bg);color:var(--theme-danger);--tw-ring-color:color-mix(in srgb, var(--theme-danger) 25%, transparent);">
          <%- icon('circle-x', { class: 'mr-1.5 h-3 w-3', style: 'color:var(--theme-danger)', strokeWidth: 2 }) %>
          <%= req.translations.editingDisabled || 'Editing Disabled' %>
        </span>
      </div>
    <% } else { %>
      <div class="flex items-center">
        <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-success-bg);color:var(--theme-success);--tw-ring-color:color-mix(in srgb, var(--theme-success) 25%, transparent);">
          <%- icon('circle-check', { class: 'mr-1.5 h-3 w-3', style: 'color:var(--theme-success)', strokeWidth: 2 }) %>
          <%= req.translations.editingEnabled || 'Editing Enabled' %>
        </span>
      </div>
    <% } %>
  </div>

  <form id="startupCommandFormEl">
    <%- include('../../../partials/csrf') %>
    <div class="p-5">
      <div class="mb-4">
        <label for="startCommand" class="block text-sm font-medium mb-2" style="color:var(--theme-text-muted)"><%= req.translations.startupCommand || 'Startup Command' %></label>
        <textarea id="startCommand" name="startCommand" rows="3" class="al-input <%= !isStartupEditAllowed ? 'opacity-50 cursor-not-allowed' : '' %>" <%= !isStartupEditAllowed ? 'readonly' : '' %> aria-label="<%= req.translations.startupCommand || 'Startup Command' %>"><%= server.StartCommand %></textarea>
        <% if (!isStartupEditAllowed) { %>
          <p class="mt-2 text-xs" style="color:var(--theme-danger);"><%= req.translations.startupCommandDisabled || 'Startup command editing is disabled for this server. Contact an administrator to enable this feature.' %></p>
        <% } else { %>
          <p class="mt-2 text-xs" style="color:var(--theme-text-muted)"><%= req.translations.startupCommandHint || 'Use $ALVKT(VARIABLE_NAME) to reference environment variables.' %></p>
        <% } %>
      </div>
    </div>

    <div class="px-5 py-4 border-t flex items-center gap-3" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
      <button type="submit" id="startupCommandSubmit" class="al-btn-primary rounded-xl px-6 py-2.5 text-center text-sm font-semibold shadow-sm <%= !isStartupEditAllowed ? 'opacity-50 cursor-not-allowed' : '' %>" <%= !isStartupEditAllowed ? 'disabled' : '' %>>
        <span id="startupCommandSaveLabel"><%= req.translations.saveCommand || 'Save Command' %></span>
        <span id="startupCommandSavingLabel" style="display:none">Saving...</span>
      </button>
      <span id="startupCommandSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
(function() {
  var form = document.getElementById('startupCommandFormEl');
  var textarea = document.getElementById('startCommand');
  var submitBtn = document.getElementById('startupCommandSubmit');
  var saveLabel = document.getElementById('startupCommandSaveLabel');
  var savingLabel = document.getElementById('startupCommandSavingLabel');
  var savedSpan = document.getElementById('startupCommandSaved');
  var saving = false;
  var debounceTimer = null;

  function updateSaved() {
    var now = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    savedSpan.textContent = 'Saved ' + now;
    savedSpan.style.display = '';
    setTimeout(function() { savedSpan.style.display = 'none'; }, 3000);
  }

  function save() {
    if (saving) return;
    var command = textarea.value.trim();
    if (!command) return;
    saving = true;
    submitBtn.disabled = true;
    saveLabel.style.display = 'none';
    savingLabel.style.display = '';
    fetch('/api/v2/servers/<%= server.UUID %>/startup/command', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ startCommand: textarea.value }),
    }).then(function(res) { return res.json(); }).then(function(data) {
      if (data.success || res.ok) {
        updateSaved();
        showToast('Startup command saved successfully!', 'success');
      } else {
        showToast(data.error || 'Failed to save command.', 'error');
      }
    }).catch(function() { showToast('Failed to save command.', 'error'); })
    .finally(function() {
      saving = false;
      submitBtn.disabled = false;
      saveLabel.style.display = '';
      savingLabel.style.display = 'none';
    });
  }

  form.addEventListener('submit', function(e) { e.preventDefault(); save(); });
  <% if (isStartupEditAllowed) { %>
  textarea.addEventListener('input', function() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(save, 500);
  });
  <% } %>
})();
</script>
