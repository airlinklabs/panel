<!-- Variables form fragment — vanilla JS auto-save -->
<div id="startup-variables-form" class="al-card mt-8">
  <div class="al-card-header">
    <div class="min-w-0">
      <h2 class="al-card-title"><%= t('serverVariables') %></h2>
      <p class="al-card-subtitle"><%= t('serverVariablesDesc') %></p>
    </div>
  </div>

  <form id="startupVariablesFormEl">
    <%- include('../../../partials/csrf') %>
    <div class="al-card-body">
      <div id="variablesContainer" class="space-y-4">
        <% if (serverVariables && serverVariables.length > 0) { %>
          <% serverVariables.forEach((variable, index) => { %>
            <div class="al-panel">
              <div class="al-panel-head">
                <div>
                  <label class="al-form-label" for="var_<%= variable.env %>"><%= variable.name %></label>
                  <p class="text-xs al-text-muted"><%= t('environmentLabel') %>: <span class="font-mono"><%= variable.env %></span></p>
                </div>
                <div class="md:col-span-2">
                  <% if (variable.type === 'boolean') { %>
                    <label class="relative inline-flex items-center cursor-pointer" for="toggle_<%= variable.env %>">
                      <input type="checkbox" name="var_<%= variable.env %>" id="toggle_<%= variable.env %>" class="sr-only peer" <%= variable.value == true || variable.value === '1' || variable.value === 1 ? 'checked' : '' %>>
                      <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
                      <span class="ms-3 text-sm font-medium al-text-muted" id="label_<%= variable.env %>"><%= variable.value == true || variable.value === '1' || variable.value === 1 ? t('enabled') : t('disabled') %></span>
                    </label>
                    <script nonce="<%- nonce %>">
                      document.getElementById('toggle_<%= variable.env %>').addEventListener('change', function() {
                        document.getElementById('label_<%= variable.env %>').textContent = this.checked ? <%- JSON.stringify(t('enabled')) %> : <%- JSON.stringify(t('disabled')) %>;
                      });
                    </script>
                  <% } else if (variable.type === 'number') { %>
                    <input type="number" name="var_<%= variable.env %>" id="var_<%= variable.env %>" value="<%= variable.value %>" class="al-input min-h-11" aria-label="<%= variable.name %>">
                  <% } else { %>
                    <input type="text" name="var_<%= variable.env %>" id="var_<%= variable.env %>" value="<%= variable.value %>" class="al-input min-h-11" aria-label="<%= variable.name %>">
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p class="al-text-muted"><%= t('noVariables') %></p>
        <% } %>
      </div>
    </div>

    <div class="al-card-footer">
      <button type="submit" id="variablesSubmit" class="al-btn-primary min-h-11">
        <span id="variablesSaveLabel"><%= t('saveVariables') %></span>
        <span id="variablesSavingLabel" style="display:none"><%= t('saving') %></span>
      </button>
      <span id="variablesSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
(function() {
  var form = document.getElementById('startupVariablesFormEl');
  var submitBtn = document.getElementById('variablesSubmit');
  var saveLabel = document.getElementById('variablesSaveLabel');
  var savingLabel = document.getElementById('variablesSavingLabel');
  var savedSpan = document.getElementById('variablesSaved');
  var saving = false;
  var msg = <%- JSON.stringify({
    savedPrefix: t('savedTimeAgo'),
    saved: t('variablesSaved'),
    saveFailed: t('failedToSaveVariables')
  }) %>;

  function updateSaved() {
    var now = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    savedSpan.textContent = msg.savedPrefix + now;
    savedSpan.style.display = '';
    setTimeout(function() { savedSpan.style.display = 'none'; }, 3000);
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (saving) return;
    saving = true;
    submitBtn.disabled = true;
    saveLabel.style.display = 'none';
    savingLabel.style.display = '';
    var formData = new FormData(form);
    fetch('/api/v2/servers/<%= server.UUID %>/startup/variables', {
      method: 'PATCH',
      body: formData,
    }).then(function(res) { return res.json(); }).then(function(data) {
      if (data.success) {
        updateSaved();
        showToast(msg.saved, 'success');
      } else {
        showToast(data.error || msg.saveFailed, 'error');
      }
    }).catch(function() { showToast(msg.saveFailed, 'error'); })
    .finally(function() {
      saving = false;
      submitBtn.disabled = false;
      saveLabel.style.display = '';
      savingLabel.style.display = 'none';
    });
  });
})();
</script>
