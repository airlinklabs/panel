<!-- Docker image form fragment — Alpine auto-save -->
<div id="startup-docker-form" class="al-card overflow-hidden"
  x-data="{
    saving: false,
    lastSaved: null,
    selectedImage: '',
    async save() {
      if (!this.selectedImage) return;
      this.saving = true;
      try {
        const res = await fetch('/server/<%= server.UUID %>/startup/docker-image', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dockerImage: this.selectedImage }),
        });
        const data = await res.json();
        if (data.success || res.ok) {
          this.lastSaved = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
          showToast('Docker image updated successfully! Server will be restarted if it was running.', 'success');
        } else {
          showToast(data.error || 'Failed to update Docker image.', 'error');
        }
      } catch (e) { showToast('Failed to update Docker image.', 'error'); }
      this.saving = false;
    }
  }">
  <div class="p-5 border-b flex justify-between items-center" style="border-color:var(--theme-border)">
    <div>
      <h3 class="text-lg font-semibold" style="color:var(--theme-text-strong)"><%= req.translations.dockerImageLabel || 'Docker Image' %></h3>
      <p class="text-sm" style="color:var(--theme-text-muted)"><%= req.translations.dockerImageDesc || 'Change the Docker image used by your server.' %></p>
    </div>
    <div class="flex items-center">
      <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-info-bg);color:var(--theme-info);--tw-ring-color:color-mix(in srgb, var(--theme-info) 25%, transparent);">
        <%- icon('info', { class: 'mr-1.5 h-3 w-3', style: 'color:var(--theme-info)', strokeWidth: 2 }) %>
        Requires Restart
      </span>
    </div>
  </div>

  <form @submit.prevent="save()">
    <%- include('../../../components/csrf') %>
    <div class="p-5">
      <div class="mb-4">
        <label for="dockerImage" class="block text-sm font-medium mb-2" style="color:var(--theme-text-muted)"><%= req.translations.dockerImageLabel || 'Docker Image' %></label>
        <%
          let currentDockerImage = '';
          try {
            const dockerImageObj = JSON.parse(server.dockerImage);
            currentDockerImage = Object.keys(dockerImageObj)[0];
          } catch (e) {
            currentDockerImage = '';
          }

          let availableDockerImages = [];
          try {
            if (server.image && server.image.dockerImages) {
              const dockerImagesArray = JSON.parse(server.image.dockerImages);
              dockerImagesArray.forEach(imageObj => {
                Object.keys(imageObj).forEach(key => {
                  availableDockerImages.push(key);
                });
              });
            }
          } catch (e) {
            availableDockerImages = [];
          }
        %>

        <div class="relative">
          <select id="dockerImage" name="dockerImage" class="cs-native" x-model="selectedImage" @change="save()">
            <% if (availableDockerImages.length > 0) { %>
              <% availableDockerImages.forEach(image => { %>
                <option value="<%= image %>" <%= image === currentDockerImage ? 'selected' : '' %>><%= image %></option>
              <% }); %>
            <% } else { %>
              <option value="" disabled selected><%= req.translations.noDockerImages || 'No Docker images available' %></option>
            <% } %>
          </select>
          <div class="custom-select" data-for="dockerImage"></div>
        </div>
        <p class="mt-2 text-xs" style="color:var(--theme-text-muted)"><%= req.translations.dockerImageHint || "Changing the Docker image will restart your server if it's currently running." %></p>
      </div>
    </div>

    <div class="px-5 py-4 border-t flex items-center gap-3" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
      <button type="submit" class="al-btn-primary rounded-xl px-6 py-2.5 text-center text-sm font-semibold shadow-sm" :disabled="saving">
        <span x-show="!saving"><%= req.translations.updateDockerImage || 'Update Docker Image' %></span>
        <span x-show="saving">Updating...</span>
      </button>
      <span x-show="lastSaved && !saving" x-transition x-text="'Saved ' + lastSaved" class="text-xs" style="color:var(--theme-success)"></span>
    </div>
  </form>
</div>
