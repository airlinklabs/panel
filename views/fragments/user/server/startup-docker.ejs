<!-- Docker image form fragment — vanilla JS auto-save -->
<div id="startup-docker-form" class="al-form-card">
  <div class="al-card-header">
    <div class="min-w-0">
      <h3 class="al-card-title"><%= t('dockerImageLabel') %></h3>
      <p class="al-card-subtitle"><%= t('dockerImageDesc') %></p>
    </div>
    <div class="al-card-header-actions">
      <span class="al-badge al-badge-info">
        <%- icon('info', { class: 'size-3', strokeWidth: 2 }) %>
        <%= t('requiresRestart') %>
      </span>
    </div>
  </div>

  <form id="startupDockerFormEl">
    <%- include('../../../partials/csrf') %>
    <div class="al-card-body">
      <%
        let currentDockerImage = '';
        try {
          const dockerImageObj = JSON.parse(server.dockerImage);
          currentDockerImage = Object.keys(dockerImageObj)[0];
        } catch (e) {
          currentDockerImage = '';
        }

        let availableDockerImages = [];
        try {
          if (server.image && server.image.dockerImages) {
            const dockerImagesArray = JSON.parse(server.image.dockerImages);
            dockerImagesArray.forEach(imageObj => {
              Object.keys(imageObj).forEach(key => {
                availableDockerImages.push(key);
              });
            });
          }
        } catch (e) {
          availableDockerImages = [];
        }
      %>

      <label for="dockerImage" class="al-form-label"><%= t('dockerImageLabel') %></label>
      <div class="relative">
        <select id="dockerImage" name="dockerImage" class="cs-native min-h-11">
          <% if (availableDockerImages.length > 0) { %>
            <% availableDockerImages.forEach(image => { %>
              <option value="<%= image %>" <%= image === currentDockerImage ? 'selected' : '' %>><%= image %></option>
            <% }); %>
          <% } else { %>
            <option value="" disabled selected><%= t('noDockerImages') %></option>
          <% } %>
        </select>
        <div class="custom-select" data-for="dockerImage"></div>
      </div>
      <p class="al-form-help"><%= t('dockerImageHint') %></p>
    </div>

    <div class="al-card-footer">
      <button type="submit" id="dockerImageSubmit" class="al-btn-primary min-h-11">
        <span id="dockerImageSaveLabel"><%= t('updateDockerImage') %></span>
        <span id="dockerImageSavingLabel" style="display:none"><%= t('updating') %></span>
      </button>
      <span id="dockerImageSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
(function() {
  var form = document.getElementById('startupDockerFormEl');
  var select = document.getElementById('dockerImage');
  var submitBtn = document.getElementById('dockerImageSubmit');
  var saveLabel = document.getElementById('dockerImageSaveLabel');
  var savingLabel = document.getElementById('dockerImageSavingLabel');
  var savedSpan = document.getElementById('dockerImageSaved');
  var saving = false;
  var msg = <%- JSON.stringify({
    savedPrefix: t('savedTimeAgo'),
    saved: t('dockerImageUpdated'),
    saveFailed: t('failedToUpdateDocker')
  }) %>;

  function updateSaved() {
    var now = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    savedSpan.textContent = msg.savedPrefix + now;
    savedSpan.style.display = '';
    setTimeout(function() { savedSpan.style.display = 'none'; }, 3000);
  }

  function save() {
    if (saving) return;
    var image = select.value;
    if (!image) return;
    saving = true;
    submitBtn.disabled = true;
    saveLabel.style.display = 'none';
    savingLabel.style.display = '';
    fetch('/api/v2/servers/<%= server.UUID %>/startup/docker-image', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ dockerImage: image }),
    }).then(function(res) { return res.json(); }).then(function(data) {
      if (data.success !== false) {
        updateSaved();
        showToast(msg.saved, 'success');
      } else {
        showToast(data.error || msg.saveFailed, 'error');
      }
    }).catch(function() { showToast(msg.saveFailed, 'error'); })
    .finally(function() {
      saving = false;
      submitBtn.disabled = false;
      saveLabel.style.display = '';
      savingLabel.style.display = 'none';
    });
  }

  form.addEventListener('submit', function(e) { e.preventDefault(); save(); });
  select.addEventListener('change', save);
})();
</script>
