<!-- Node table fragment — replaces #admin-nodes-table on delete -->
<div id="admin-nodes-table" class="al-table-wrapper">
  <% if (nodes.length === 0) { %>
    <%- include('../../../partials/empty-state', {
      iconName: 'network',
      title: t('noNodesYet'),
      description: t('addNodeToStartHosting'),
      action: '<a href="/admin/nodes/create" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }).toString() + ' ' + t('createNewNode') + '</a>'
    }) %>
  <% } else { %>
  <table class="al-table" style="table-layout:auto">
    <colgroup>
      <col style="min-width:170px">
      <col style="min-width:180px">
      <col style="min-width:80px">
      <col style="min-width:220px">
    </colgroup>
    <thead class="al-table-thead">
      <tr>
        <th scope="col" class="al-table-th"><%= t('name') %></th>
        <th scope="col" class="al-table-th"><%= t('connection') %></th>
        <th scope="col" class="al-table-th"><%= t('instances') %></th>
        <th scope="col" class="al-table-th"><%= t('actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% let nodeIdx = 0; nodes.forEach(function(node) { %>
        <tr data-node-id="<%= node.id %>" data-instances="<%= node.instances ? node.instances.length : 0 %>" data-online="<%= node.status === 'Online' ? 'true' : '' %>" data-location="<%= node.locationId ? 'true' : '' %>" style="--i:<%= nodeIdx++ %>" class="al-table-tr cursor-pointer" onclick="window.location='/admin/node/<%= node.id %>/stats'">
          <td class="al-table-td">
            <div class="flex items-center">
              <div class="mr-5">
                <% if (node.status == "Online") { %>
                  <span class="al-dot-online"></span>
                <% } else if (node.status == "Offline") { %>
                  <span class="al-dot-offline group relative">
                    <% if (node.error) { %>
                      <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 -translate-y-1 w-48 text-xs rounded py-1 px-2 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 pointer-events-none z-10" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); color:var(--theme-text);">
                        <%= node.error %>
                      </div>
                    <% } %>
                  </span>
                <% } else { %>
                  <span class="al-dot-warning"></span>
                <% } %>
              </div>
              <div class="al-table-cell-strong"><%= node.name %></div>
            </div>
          </td>
          <td class="al-table-td"><%= node.address %>:<%= node.port %>
            <div class="mt-1 ml-2">
              <span class="al-badge <%= node.versionRelease ? 'al-badge-online' : 'al-badge-neutral' %> font-mono">
                <%= node.versionRelease || t('unknown') %>
              </span>
            </div></td>
          <td class="al-table-td"><%= node.instances ? node.instances.length : 0 %></td>
          <td class="al-table-td">
            <div class="flex items-center gap-1.5">
              <a href="/admin/node/<%= node.id %>/configure"
                 title="<%= t('configureNode') %>" aria-label="<%= t('configureNode') %>"
                 class="al-btn-ghost al-btn-icon-only"
                 onclick="event.stopPropagation()">
                <%- icon('settings', { size: 16, class: 'shrink-0' }) %>
              </a>
              <a href="/admin/node/<%= node.id %>" onclick="event.stopPropagation()" title="<%= t('editNodeAria') %>" aria-label="<%= t('editNodeAria') %>"
                class="al-btn-ghost al-btn-icon-only">
                <%- icon('pencil', { size: 16, class: 'shrink-0' }) %>
              </a>
              <button type="button"
                title="<%= t('deleteNodeAria') %>" aria-label="<%= t('deleteNodeAria') %>"
                class="al-btn-ghost al-btn-icon-only"
                style="color:var(--theme-danger);"
                data-node-id="<%= node.id %>"
                onclick="deleteNode(this)">
                <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
              </button>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</div>
