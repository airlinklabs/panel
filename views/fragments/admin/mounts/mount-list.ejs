<!-- Mount list fragment — replaces the mounts table on create/delete -->
<div id="admin-mounts-list">
  <% if (mounts.length === 0) { %>
    <%- include('../../../partials/empty-state', {
      iconName: 'folder',
      title: t('noMountsYet'),
      description: t('noMountsYetDesc'),
      action: '<a href="/admin/mounts/new" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }).toString() + ' ' + t('newMount') + '</a>'
    }) %>
  <% } else { %>
    <div class="al-card al-card-flush">
      <table class="al-table">
        <colgroup>
          <col style="min-width:160px">
          <col style="min-width:200px">
          <col style="min-width:200px">
          <col style="min-width:110px">
          <col style="min-width:110px">
        </colgroup>
        <thead class="al-table-thead">
          <tr>
            <th scope="col" class="al-table-th"><%= t('mountName') %></th>
            <th scope="col" class="al-table-th"><%= t('mountSource') %></th>
            <th scope="col" class="al-table-th"><%= t('mountTarget') %></th>
            <th scope="col" class="al-table-th"><%= t('mountMode') %></th>
            <th scope="col" class="al-table-th"><%= t('mountActions') %></th>
          </tr>
        </thead>
        <tbody>
          <% mounts.forEach(function(m) { %>
          <tr class="al-table-tr" data-mount-id="<%= m.id %>">
            <td class="al-table-td">
              <span class="al-table-cell-strong"><%= m.name %></span>
            </td>
            <td class="al-table-td">
              <code class="al-chip al-chip-mono max-w-full truncate" title="<%= m.source %>"><%= m.source %></code>
            </td>
            <td class="al-table-td">
              <code class="al-chip al-chip-mono max-w-full truncate" title="<%= m.target %>"><%= m.target %></code>
            </td>
            <td class="al-table-td">
              <span class="<%= m.readOnly ? 'al-badge al-badge-warning' : 'al-badge al-badge-online' %>">
                <%= m.readOnly ? t('mountReadOnlyMode') : t('mountReadWrite') %>
              </span>
            </td>
            <td class="al-table-td">
              <% var deleteConfirm = t('mountDeleteConfirm').replace('{{name}}', m.name); %>
              <button
                type="button"
                class="al-btn-ghost al-btn-icon-only"
                style="color:var(--theme-danger);"
                aria-label="<%= t('mountDeleteAria') %>"
                onclick="if(confirm(<%= JSON.stringify(deleteConfirm) %>)) { fetch('/api/v2/admin/mounts/<%= m.id %>', { method: 'DELETE', headers: { 'csrf-token': document.querySelector('meta[name=csrf-token]')?.content || '' } }).then(function(r) { if (r.ok) { showToast(<%= JSON.stringify(t('mountDeleted')) %>, 'success'); window.location.reload(); } else { showToast(<%= JSON.stringify(t('mountDeleteFailed')) %>, 'error'); } }).catch(function() { showToast(<%= JSON.stringify(t('networkError')) %>, 'error'); }); }">
                <%- icon('trash-2', { size: 16 }) %>
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
