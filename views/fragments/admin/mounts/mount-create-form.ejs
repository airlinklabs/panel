<!-- Mount create form — loaded into #admin-mounts-dialog via hx-get -->
<div id="mountCreateForm">
  <form
    hx-post="/admin/mounts"
    hx-target="#admin-mounts-list"
    hx-swap="outerHTML"
    hx-disabled-elt="find button[type='submit']"
    hx-indicator="#mount-form-status"
    class="flex flex-col">
    <div id="mount-form-error"></div>
    <div class="space-y-4">
      <div>
        <label for="mountName" class="al-label">Name</label>
        <input id="mountName" name="name" class="al-input w-full" placeholder="Shared plugins" required>
      </div>
      <div>
        <label for="mountSource" class="al-label">Source (host path)</label>
        <input id="mountSource" name="source" class="al-input w-full font-mono text-xs" placeholder="/data/shared/plugins" required>
      </div>
      <div>
        <label for="mountTarget" class="al-label">Target (container path)</label>
        <input id="mountTarget" name="target" class="al-input w-full font-mono text-xs" placeholder="/home/container/plugins" required>
      </div>
      <label class="flex items-center gap-2.5 text-sm cursor-pointer select-none" style="color:var(--theme-text-strong)">
        <input name="readOnly" type="checkbox" class="h-4 w-4 rounded" style="border-color:var(--theme-border-input);accent-color:var(--theme-accent);">
        Read-only
      </label>
    </div>
    <div class="flex gap-2 pt-4">
      <button type="button" onclick="window.modal.close()" class="al-btn-secondary flex-1 inline-flex items-center gap-1.5">
        <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>
        Cancel
      </button>
      <button type="submit" class="al-btn-primary flex-1 inline-flex items-center gap-1.5">
        <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
        Create mount
      </button>
      <p id="mount-form-status" class="htmx-indicator text-sm" style="color:var(--theme-text-muted)">Creating…</p>
    </div>
  </form>
</div>
