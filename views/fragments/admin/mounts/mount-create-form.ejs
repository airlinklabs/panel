<!-- Mount create form — loaded into #admin-mounts-dialog via hx-get -->
<div x-data="{ open: true }" x-init="$nextTick(() => { if (open) $el.querySelector('dialog')?.showModal() })" @al:close-mount-modal.window="open = false">
  <dialog class="al-dialog" x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
    <div class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
      <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)">New mount</h3>
      <button type="button" @click="open = false" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <form
      hx-post="/admin/mounts"
      hx-target="#admin-mounts-list"
      hx-swap="outerHTML"
      hx-disabled-elt="find button[type='submit']"
      hx-indicator="#mount-form-status"
      @submit="open = false"
      class="flex flex-col">
      <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4 space-y-4">
        <div id="mount-form-error"></div>
        <div>
          <label for="mountName" class="al-label">Name</label>
          <input id="mountName" name="name" class="al-input w-full" placeholder="Shared plugins" required>
        </div>
        <div>
          <label for="mountSource" class="al-label">Source (host path)</label>
          <input id="mountSource" name="source" class="al-input w-full font-mono text-xs" placeholder="/data/shared/plugins" required>
        </div>
        <div>
          <label for="mountTarget" class="al-label">Target (container path)</label>
          <input id="mountTarget" name="target" class="al-input w-full font-mono text-xs" placeholder="/home/container/plugins" required>
        </div>
        <label class="flex items-center gap-2.5 text-sm cursor-pointer select-none" style="color:var(--theme-text-strong)">
          <input name="readOnly" type="checkbox" class="h-4 w-4 rounded border-neutral-300 dark:border-neutral-600" style="accent-color:var(--theme-accent);">
          Read-only
        </label>
      </div>
      <div class="flex gap-2 px-6 py-4 border-t justify-end" style="border-color:var(--theme-border);">
        <button type="button" @click="open = false" class="al-btn-secondary flex-1 inline-flex items-center gap-1.5">
          <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>
          Cancel
        </button>
        <button type="submit" class="al-btn-primary flex-1 inline-flex items-center gap-1.5">
          <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
          Create mount
        </button>
        <p id="mount-form-status" class="htmx-indicator text-sm" style="color:var(--theme-text-muted)">Creating…</p>
      </div>
    </form>
  </dialog>
</div>
