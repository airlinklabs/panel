<!--
  Fragment: admin-users-create-form
  Route: POST /admin/users/create-user   (HX-Request: true)
  Shell-free: swapped into the page in place of the form. The error block
  keeps role="alert" aria-live="assertive" — the tests assert on it.
-->
<div id="admin-users-create-form" class="space-y-5">
  <% if (typeof errors !== 'undefined' && errors) { %>
    <div id="admin-users-create-error" class="al-alert-danger" role="alert" aria-live="assertive">
      <%- icon('alert-triangle', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
      <p class="al-alert-title"><%= errors.message || t('pleaseFixErrors') %></p>
    </div>
  <% } %>

  <form id="createUserForm" class="space-y-5" method="POST" action="/api/v2/admin/users">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="al-card">
      <h2 class="al-card-header"><span class="al-card-title"><%= t('userInformation') %></span></h2>
      <div class="al-card-body">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="al-form-field <%= typeof errors !== 'undefined' && errors?.email ? 'al-field-invalid' : '' %>">
            <label for="userEmail" class="al-form-label"><%= t('emailLabel') %></label>
            <input id="userEmail" name="email" type="email" class="al-form-input"
                   value="<%= typeof form !== 'undefined' ? form.email || '' : '' %>"
                   placeholder="<%= t('fieldEmailPlaceholder') %>"
                   aria-invalid="<%= typeof errors !== 'undefined' && errors?.email ? 'true' : 'false' %>"
                   aria-describedby="<%= typeof errors !== 'undefined' && errors?.email ? 'email-error' : undefined %>"
                   required>
            <% if (typeof errors !== 'undefined' && errors?.email) { %>
              <p id="email-error" class="al-form-error-msg" role="alert"><%= errors.email %></p>
            <% } %>
          </div>

          <div class="al-form-field <%= typeof errors !== 'undefined' && errors?.username ? 'al-field-invalid' : '' %>">
            <label for="userUsername" class="al-form-label"><%= t('usernameLabel') %></label>
            <input id="userUsername" name="username" type="text" class="al-form-input"
                   value="<%= typeof form !== 'undefined' ? form.username || '' : '' %>"
                   placeholder="<%= t('fieldUsernamePlaceholder') %>"
                   aria-invalid="<%= typeof errors !== 'undefined' && errors?.username ? 'true' : 'false' %>"
                   aria-describedby="<%= typeof errors !== 'undefined' && errors?.username ? 'username-error' : undefined %>"
                   required>
            <% if (typeof errors !== 'undefined' && errors?.username) { %>
              <p id="username-error" class="al-form-error-msg" role="alert"><%= errors.username %></p>
            <% } %>
          </div>

          <div class="al-form-field md:col-span-2">
            <label for="userDescription" class="al-form-label"><%= t('descriptionLabel') %></label>
            <textarea id="userDescription" name="description" rows="3" class="al-form-textarea" placeholder="<%= t('optionalDescription') %>"><%= typeof form !== 'undefined' ? form.description || '' : '' %></textarea>
          </div>
        </div>
      </div>
    </div>

    <div class="al-card">
      <h2 class="al-card-header"><span class="al-card-title"><%= t('security') %></span></h2>
      <div class="al-card-body">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="al-form-field <%= typeof errors !== 'undefined' && errors?.password ? 'al-field-invalid' : '' %>">
            <label for="userPassword" class="al-form-label"><%= t('passwordLabel') %></label>
            <input id="userPassword" name="password" type="password" class="al-form-input"
                   placeholder="********"
                   aria-invalid="<%= typeof errors !== 'undefined' && errors?.password ? 'true' : 'false' %>"
                   aria-describedby="<%= typeof errors !== 'undefined' && errors?.password ? 'password-error' : undefined %>"
                   required>
            <% if (typeof errors !== 'undefined' && errors?.password) { %>
              <p id="password-error" class="al-form-error-msg" role="alert"><%= errors.password %></p>
            <% } %>
          </div>

          <div class="al-form-field">
            <label for="userConfirmPassword" class="al-form-label"><%= t('confirmPasswordLabel') %></label>
            <input id="userConfirmPassword" type="password" class="al-form-input" placeholder="********">
          </div>
        </div>

        <div class="al-setting-row">
          <div class="al-setting-copy">
            <h3 class="al-setting-title"><%= t('role') %></h3>
            <p class="al-setting-desc"><%= t('roleDescriptionCreate') %></p>
          </div>
          <div class="al-setting-control">
            <select id="userRole" name="role" class="al-form-select w-44" aria-label="<%= t('role') %>">
              <option value="user"><%= t('roleUser') %></option>
              <option value="privileged"><%= t('rolePrivileged') %></option>
              <option value="admin"><%= t('adminRole') %></option>
            </select>
          </div>
        </div>

        <div class="al-setting-row">
          <div class="al-setting-copy">
            <h3 class="al-setting-title"><%= t('adminStatus') %></h3>
            <p class="al-setting-desc"><%= t('adminStatusDesc') %></p>
          </div>
          <div class="al-setting-control">
            <label for="userIsAdminSwitch" class="relative inline-flex items-center cursor-pointer gap-3">
              <input type="checkbox" id="userIsAdminSwitch" name="isAdmin" value="true" aria-label="<%= t('adminStatus') %>" class="sr-only peer">
              <span class="al-toggle-track"><span class="al-toggle-dot"></span></span>
              <span id="adminStatusLabel" class="text-sm font-medium al-text-strong"><%= t('disabled') %></span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <div class="al-card">
      <h2 class="al-card-header"><span class="al-card-title"><%= t('serverLimits') %></span></h2>
      <div class="al-card-body">
        <p class="al-form-help mb-4"><%= t('serverLimitsDesc') %></p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="al-form-field">
            <label for="serverLimit" class="al-form-label"><%= t('serverLimit') %></label>
            <input type="number" id="serverLimit" name="serverLimit" min="0" max="100" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input">
          </div>
          <div class="al-form-field">
            <label for="maxMemory" class="al-form-label"><%= t('maxMemory') %></label>
            <input type="number" id="maxMemory" name="maxMemory" min="128" max="65536" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input">
          </div>
          <div class="al-form-field">
            <label for="maxCpu" class="al-form-label"><%= t('maxCpu') %></label>
            <input type="number" id="maxCpu" name="maxCpu" min="10" max="10000" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input">
          </div>
          <div class="al-form-field">
            <label for="maxStorage" class="al-form-label"><%= t('maxStorage') %></label>
            <input type="number" id="maxStorage" name="maxStorage" min="1" max="10000" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input">
          </div>
          <div class="al-form-field">
            <label for="maxDatabases" class="al-form-label"><%= t('maxDatabases') %></label>
            <input type="number" id="maxDatabases" name="maxDatabases" min="0" max="100000" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input">
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <button type="submit" class="al-btn-primary">
        <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
        <%= t('createUserBtn') %>
      </button>
      <a href="/admin/users" class="al-btn-secondary"><%= t('cancel') %></a>
    </div>
  </form>
</div>
