<!-- Image table fragment — replaces #installedTableSection on delete -->
<div id="installedTableSection" class="<%= images.length === 0 ? 'hidden' : '' %>">
  <div class="mt-5 mb-1">
    <input id="imageFilterInput" type="text" placeholder="<%= t('imageFilterPlaceholder') %>" aria-label="<%= t('ariaSearchImages') %>" class="al-input w-56">
  </div>
  <div class="al-table-wrapper mt-3">
    <table class="al-table min-w-full">
      <colgroup>
        <col style="min-width:240px">
        <col style="min-width:160px">
        <col style="min-width:140px">
        <col style="min-width:220px">
      </colgroup>
      <thead class="al-table-head">
        <tr>
          <th class="al-table-th"><%= t('name') %></th>
          <th class="al-table-th col-hide"><%= t('imageTableAuthor') %></th>
          <th class="al-table-th col-hide"><%= t('imageTableCreated') %></th>
          <th class="al-table-th"><%= t('actions') %></th>
        </tr>
      </thead>
      <tbody class="divide-y" style="border-color:var(--theme-border)" id="tableBody">
        <% let imgIdx = 0; images.forEach(function(image) { %>
        <tr class="al-table-tr transition-colors cursor-pointer img-row"
            style="--i:<%= imgIdx++ %>"
            data-search="<%= (image.name + ' ' + (image.author||'')).toLowerCase() %>"
            onclick="window.location.href='/admin/images/edit/<%= image.id %>'">
          <td class="al-table-td whitespace-nowrap font-medium" style="color:var(--theme-text-strong)"><%= image.name %></td>
          <td class="al-table-td whitespace-nowrap col-hide"><%= image.author || '—' %></td>
          <td class="al-table-td whitespace-nowrap col-hide"><%= new Date(image.createdAt).toLocaleDateString() %></td>
          <td class="al-table-td whitespace-nowrap">
            <div class="flex gap-2">
              <a href="/admin/images/edit/<%= image.id %>" onclick="event.stopPropagation()" class="al-btn-secondary al-btn-sm"><%- icon('pencil', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('imageEditBtn') %></a>
              <a href="/admin/images/export/<%= image.id %>" onclick="event.stopPropagation()" class="al-btn-secondary al-btn-sm"><%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('imageExportBtn') %></a>
              <button
                onclick="event.stopPropagation(); if(confirm('<%= t('imageDeleteConfirm', { name: image.name }) %>')) { fetch('/api/v2/admin/images/<%= image.id %>', { method: 'DELETE', headers: { 'csrf-token': document.querySelector('meta[name=csrf-token]')?.content || '' } }).then(r => { if(r.ok) window.location.reload(); else showToast('<%= t('failedToDelete') %>', 'error'); }).catch(() => showToast('<%= t('networkError') %>', 'error')); }"
                type="button"
                class="al-btn-danger"
                aria-label="<%= t('ariaDeleteImage', { name: image.name }) %>">
                <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <div id="noResults" class="hidden py-10 text-center text-sm" style="background:var(--theme-bg-card);color:var(--theme-text-muted)"><%= t('noImagesMatch') %></div>
  </div>
</div>
