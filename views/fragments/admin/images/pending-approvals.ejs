<!-- Pending approvals fragment — replaces #pendingApprovalsList on approve/reject -->
<div id="pendingApprovalsList" class="mt-5 space-y-4">
  <% if (pending.length === 0) { %>
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <div class="w-12 h-12 rounded-full bg-emerald-600/10 flex items-center justify-center mb-4">
      <%- icon('check', { class: 'w-6 h-6', style: 'color:var(--theme-text-muted)' }) %>
    </div>
    <p class="text-sm font-medium" style="color:var(--theme-text-strong)">No images waiting for review.</p>
    <p class="text-sm mt-1" style="color:var(--theme-text-muted)">User submissions will appear here for approval.</p>
  </div>
  <% } else { pending.forEach(function(image) { %>
  <div class="rounded-xl border p-5 pending-card" data-pending-image="<%= image.id %>" style="border-color:var(--theme-border); background:var(--theme-bg-card);">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h3 class="text-sm font-semibold truncate" style="color:var(--theme-text-strong)"><%= image.name %></h3>
          <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset"
            style="background:var(--theme-warning-bg);color:var(--theme-warning)">Pending</span>
        </div>
        <% if (image.description) { %><p class="text-sm mt-1 line-clamp-2" style="color:var(--theme-text-muted)"><%= image.description %></p><% } %>
        <% if (image.creator) { %>
        <p class="text-xs mt-2" style="color:var(--theme-text-muted)">Submitted by <span class="font-medium" style="color:var(--theme-text-strong)"><%= image.creator.username || image.creator.email %></span> &middot; <%= new Date(image.createdAt).toLocaleString() %></p>
        <% } %>
        <div class="flex flex-wrap gap-4 mt-3 text-xs" style="color:var(--theme-text-muted)">
          <span class="inline-flex items-center gap-1.5"><%- icon('terminal', { class: 'size-3.5', strokeWidth: 1.5 }) %><code style="font-family:ui-monospace,monospace;color:var(--theme-text-strong)"><%= image.startup || '' %></code></span>
          <span class="inline-flex items-center gap-1.5"><%- icon('container', { class: 'size-3.5', strokeWidth: 1.5 }) %><code style="font-family:ui-monospace,monospace;color:var(--theme-text-strong)"><%= image.dockerImages || '[]' %></code></span>
        </div>
      </div>
      <div class="flex gap-2 shrink-0">
        <a href="/admin/images/edit/<%= image.id %>" class="al-btn-ghost inline-flex items-center gap-1.5 text-xs"><%- icon('external-link', { class: 'size-4', strokeWidth: 1.5 }) %>View</a>
        <button
          x-data="{ approving: false }"
          @click="if(!approving && confirm('Approve this image? It will become available to all users.')) { approving = true; fetch('/admin/images/approve/<%= image.id %>', { method: 'POST' }).then(r => r.json()).then(d => { if(d.error) { showToast(d.error, 'error'); approving = false; } else { showToast(d.message || 'Image approved.', 'success'); window.location.reload(); } }).catch(() => { showToast('Something went wrong.', 'error'); approving = false; }); }"
          type="button"
          class="al-btn-primary inline-flex items-center gap-1.5 px-3 py-1.5 text-xs" :disabled="approving"><%- icon('check', { class: 'size-4', strokeWidth: 1.5 }) %>Approve</button>
        <button
          x-data="{ rejecting: false }"
          @click="if(!rejecting) { rejecting = true; $dispatch('image-reject-show', { id: '<%= image.id %>', name: '<%= image.name %>' }); rejecting = false; }"
          type="button"
          class="al-btn-danger inline-flex items-center gap-1.5 px-3 py-1.5 text-xs"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Reject</button>
      </div>
    </div>
  </div>
  <% }); } %>
</div>
