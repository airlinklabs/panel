<!-- Pending approvals fragment — replaces #pendingApprovalsList on approve/reject -->
<div id="pendingApprovalsList" class="mt-5 space-y-4">
  <% if (pending.length === 0) { %>
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <div class="w-12 h-12 rounded-full flex items-center justify-center mb-4" style="background:color-mix(in srgb, var(--theme-success) 12%, transparent)">
      <%- icon('check', { class: 'w-6 h-6', style: 'color:var(--theme-text-muted)' }) %>
    </div>
    <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('noImagesWaitingForReview') %></p>
    <p class="text-sm mt-1" style="color:var(--theme-text-muted)"><%= t('userSubmissionsAppearHere') %></p>
  </div>
  <% } else { pending.forEach(function(image) { %>
  <div class="pending-card al-card" data-pending-image="<%= image.id %>">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h3 class="text-sm font-semibold truncate" style="color:var(--theme-text-strong)"><%= image.name %></h3>
          <span class="al-badge al-badge-warning"><%= t('pendingApproval') %></span>
        </div>
        <% if (image.description) { %><p class="text-sm mt-1 line-clamp-2" style="color:var(--theme-text-muted)"><%= image.description %></p><% } %>
        <% if (image.creator) { %>
        <p class="text-xs mt-2" style="color:var(--theme-text-muted)"><%= t('activitySubmittedBy') %> <span class="font-medium" style="color:var(--theme-text-strong)"><%= image.creator.username || image.creator.email %></span> &middot; <%= new Date(image.createdAt).toLocaleString() %></p>
        <% } %>
        <div class="flex flex-wrap gap-4 mt-3 text-xs" style="color:var(--theme-text-muted)">
          <span class="inline-flex items-center gap-1.5"><%- icon('terminal', { class: 'size-3.5', strokeWidth: 1.5 }) %><code style="font-family:ui-monospace,monospace;color:var(--theme-text-strong)"><%= image.startup || '' %></code></span>
          <span class="inline-flex items-center gap-1.5"><%- icon('container', { class: 'size-3.5', strokeWidth: 1.5 }) %><code style="font-family:ui-monospace,monospace;color:var(--theme-text-strong)"><%= image.dockerImages || '[]' %></code></span>
        </div>
      </div>
      <div class="flex gap-2 shrink-0">
        <a href="/admin/images/edit/<%= image.id %>" class="al-btn-ghost al-btn-sm"><%- icon('external-link', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('viewBtn') %></a>
        <button
          onclick="if(!this._approving && confirm(<%- JSON.stringify(t('approveImageConfirm')) %>)) { this._approving = true; this.disabled = true; fetch('/api/v2/admin/images/<%= image.id %>/approve', { method: 'POST', headers: { 'x-csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' } }).then(function(r) { return r.json(); }).then(function(d) { if(d.error) { showToast(d.error, 'error'); } else { showToast(d.message || <%- JSON.stringify(t('imageApproved')) %>, 'success'); window.location.reload(); } }).catch(function() { showToast(<%- JSON.stringify(t('somethingWentWrong')) %>, 'error'); }); }"
          type="button"
          class="al-btn-primary al-btn-sm"><%- icon('check', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('approveBtn') %></button>
        <button
          onclick="var name='<%= image.name.replace(/'/g,"\\'") %>'; if(confirm(<%- JSON.stringify(t('rejectImageConfirm')) %>.replace('{{name}}', name))) { document.dispatchEvent(new CustomEvent('image-reject-show', { detail: { id: '<%= image.id %>', name: name } })); }"
          type="button"
          class="al-btn-danger al-btn-sm"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('rejectBtn') %></button>
      </div>
    </div>
  </div>
  <% }); } %>
</div>
