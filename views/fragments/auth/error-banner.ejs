<!-- Auth error banner fragment — reused by 2FA, login, and password reset routes -->
<div id="<%= targetId %>-error" class="al-auth-error mb-5" role="alert" aria-live="assertive">
  <span class="mt-0.5 shrink-0"><%- icon('alert-triangle', { class: 'h-5 w-5', style: 'color:var(--theme-danger)' }) %></span>
  <div>
    <p class="al-auth-error-title"><%= message %></p>
    <% if (hint) { %>
    <p class="al-auth-error-body"><%= hint %></p>
    <% } %>
  </div>
</div>
