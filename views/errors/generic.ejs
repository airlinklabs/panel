<%- include('../layouts/auth', { title: errorTitle || t('errorTitle') }) %>

<div class="al-error-state">
  <div class="al-icon-tile al-icon-tile-lg al-icon-tile-round al-icon-tile-danger">
    <%- icon('alert-triangle') %>
  </div>
  <p class="al-error-code"><%= statusCode || 500 %></p>
  <h1 class="al-error-title"><%= errorTitle || t('errorTitle') %></h1>
  <p class="al-error-body"><%= errorMessage || t('errorMessage') %></p>

  <div class="al-error-actions">
    <%- include('../partials/ui/button', {
      href: path || '/',
      label: t('goHome'),
      variant: 'secondary'
    }) %>
    <button type="button" class="al-btn al-btn-ghost" onclick="history.back()">
      <span><%= t('goBack') %></span>
    </button>
  </div>
</div>

<%- include('../layouts/auth-footer') %>
