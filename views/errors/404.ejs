<%- include('../layouts/auth', { title: '404 — ' + t('notFound') }) %>

<div class="al-error-state">
  <div class="al-icon-tile al-icon-tile-lg al-icon-tile-round">
    <%- icon('search') %>
  </div>
  <p class="al-error-code">404</p>
  <h1 class="al-error-title"><%= t('notFoundTitle') %></h1>
  <p class="al-error-body"><%= t('notFoundMessage') %></p>

  <div class="al-error-actions">
    <%- include('../partials/ui/button', {
      href: '/',
      label: t('goHome'),
      variant: 'secondary'
    }) %>
    <button type="button" class="al-btn al-btn-ghost" onclick="history.back()">
      <span><%= t('goBack') %></span>
    </button>
  </div>
</div>

<%- include('../layouts/auth-footer') %>
