<%- include('../layouts/auth', { title: '403 — ' + t('forbidden') }) %>

<div class="al-error-state">
  <div class="al-icon-tile al-icon-tile-lg al-icon-tile-round al-icon-tile-danger">
    <%- icon('shield-x') %>
  </div>
  <p class="al-error-code">403</p>
  <h1 class="al-error-title"><%= t('forbiddenTitle') %></h1>
  <p class="al-error-body"><%= t('forbiddenMessage') %></p>

  <div class="al-error-actions">
    <%- include('../partials/ui/button', {
      href: '/',
      label: t('goHome'),
      variant: 'secondary'
    }) %>
    <button type="button" class="al-btn al-btn-ghost" onclick="history.back()">
      <span><%= t('goBack') %></span>
    </button>
  </div>
</div>

<%- include('../layouts/auth-footer') %>
