<%- include('../layouts/auth', { title: '403 — ' + t('forbidden') }) %>

<div class="flex items-center justify-center min-h-[calc(100vh-80px)] px-4 pt-24 pb-32">
  <div class="w-full max-w-sm text-center">
    <div class="mb-6">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full mb-6"
        style="background:var(--theme-bg-secondary);">
        <%- icon('shield-x', { class: 'w-10 h-10', style: 'color:var(--theme-danger);' }) %>
      </div>
      <h1 class="text-6xl font-bold mb-2" style="color:var(--theme-text-strong);">403</h1>
      <h2 class="text-xl font-semibold mb-3" style="color:var(--theme-text-strong);">
        <%= t('forbiddenTitle') %>
      </h2>
      <p class="text-sm leading-relaxed" style="color:var(--theme-text-muted);">
        <%= t('forbiddenMessage') %>
      </p>
    </div>

    <div class="flex items-center justify-center gap-3 mt-8">
      <%- include('../partials/ui/button', {
        href: '/',
        label: t('goHome'),
        variant: 'secondary'
      }) %>
      <%- include('../partials/ui/button', {
        href: 'javascript:history.back()',
        label: t('goBack'),
        variant: 'ghost'
      }) %>
    </div>
  </div>
</div>

<%- include('../layouts/auth-footer') %>
