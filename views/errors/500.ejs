<%- include('../layouts/auth', { title: '500 — ' + t('serverError') }) %>

<div class="al-error-state">
  <div class="al-icon-tile al-icon-tile-lg al-icon-tile-round al-icon-tile-danger">
    <%- icon('server-crash') %>
  </div>
  <p class="al-error-code">500</p>
  <h1 class="al-error-title"><%= t('serverErrorTitle') %></h1>
  <p class="al-error-body"><%= t('serverErrorMessage') %></p>

  <div class="al-error-actions">
    <%- include('../partials/ui/button', {
      href: '/',
      label: t('goHome'),
      variant: 'secondary'
    }) %>
    <button type="button" class="al-btn al-btn-ghost" onclick="location.reload()">
      <span><%= t('tryAgain') %></span>
    </button>
  </div>
</div>

<%- include('../layouts/auth-footer') %>
