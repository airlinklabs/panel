<%- include('../components/header', { title:'ERROR' }) %>
    <main class="min-h-screen">
      <div class="flex min-h-screen">
        <% if (user != null) { %>
        <div class="hidden lg:block w-60 h-full">
      <%- include('../components/sidebar') %>
    </div>
<%- include('../components/template') %>
        <% } %>

        <div id="page-content" class="flex-1 overflow-y-auto pt-0">
          <div class="al-page-body">
            <section
              class="mx-auto flex min-h-[calc(100vh-12rem)] w-full max-w-3xl flex-col items-center justify-center text-center">
            <div
              class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border); color:var(--theme-text-strong);">
              <%- icon('triangle-alert', { class: 'h-7 w-7', strokeWidth: 1.6 }) %>
            </div>

            <p class="text-sm font-medium" style="color:var(--theme-text-muted);">Error <%= statusCode %></p>
            <h1 class="mt-3 text-2xl font-semibold tracking-tight" style="color:var(--theme-text-strong);">
              <%= errorTitle %>
            </h1>
            <p class="mt-3 max-w-xl text-sm leading-6" style="color:var(--theme-text-muted);">
              <%= errorMessage %>
            </p>
            <p
              class="mt-4 max-w-xl break-all rounded-lg px-3 py-2 font-mono text-xs" style="color:var(--theme-text-muted); background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">
              <%= path %>
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <button type="button" @click="history.length > 1 ? history.back() : location.assign('/')"
                class="al-btn-secondary inline-flex items-center gap-1.5">
                <%- icon('arrow-left', { class: 'size-4', strokeWidth: 1.5 }) %>
                Back
              </button>
              <a href="/"
                class="al-btn-primary">
                Dashboard
              </a>
              <% if (typeof user !== 'undefined' && user && user.isAdmin) { %>
                <a href="/admin/overview"
                  class="al-btn-secondary">
                  Admin
                </a>
                <% } %>
            </div>
          </section>
          </div>
        </div>
      </div>
    </main>
    <%- include('../components/footer') %>
