<%- include('../components/header', { title: 'API Documentation' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="w-60 h-full hidden lg:block">
      <%- include('../components/template') %>
    </div>
    <!-- Content -->
    <div id="page-content" class="flex-1 p-6 overflow-y-auto pt-0">
      <%- include('../components/ui/breadcrumb', { items: [
        { label: 'API' },
        { label: 'Documentation' }
      ] }) %>
      <div class="sm:flex sm:items-center px-8 pt-4">
        <div class="sm:flex-auto">
          <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong)">API Documentation</h1>
          <p class="mt-1 tracking-tight text-sm" style="color:var(--theme-text-muted)">Learn how to use the AirLink API</p>
        </div>
      </div>
      <div class="px-8 mt-5">
        <div class="rounded-xl p-6" style="background:var(--theme-bg-card);border:1px solid var(--theme-border)">
          <div class="sm:flex sm:items-center">
            <div class="sm:flex-auto">
              <h1 class="text-base font-semibold leading-6" style="color:var(--theme-text-strong)">Getting Started</h1>
              <p class="mt-2 text-sm" style="color:var(--theme-text-muted)">To use the API, you need an API key with the appropriate permissions.</p>
            </div>
          </div>
          <div class="mt-4">
            <p class="text-sm" style="color:var(--theme-text-muted)">API keys can be created in the <a href="/admin/apikeys" class="hover:underline" style="color:var(--theme-accent)">API Keys</a> section of the admin panel.</p>
            <p class="text-sm mt-2" style="color:var(--theme-text-muted)">All API requests must include an <code class="px-1 py-0.5 rounded" style="background:var(--theme-bg-secondary)">Authorization</code> header with a Bearer token:</p>
            <pre class="mt-2 p-3 rounded-md overflow-x-auto" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong)"><code>Authorization: Bearer YOUR_API_KEY</code></pre>
          </div>

          <div class="mt-8">
            <h2 class="text-lg font-semibold leading-6" style="color:var(--theme-text-strong)">Available Endpoints</h2>

            <div class="mt-4 space-y-8">
              <% apiEndpoints.forEach(category => { %>
                <div>
                  <h3 class="text-md font-medium border-b pb-2 mb-4" style="color:var(--theme-text-strong);border-color:var(--theme-border)"><%= category.category %> Endpoints</h3>
                  <div class="space-y-6">
                    <% category.endpoints.forEach(endpoint => { %>
                      <div class="rounded-md overflow-hidden" style="border:1px solid var(--theme-border)">
                        <div class="px-4 py-2 flex items-center" style="background:var(--theme-bg-secondary)">
                          <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset mr-2
                            <% if (endpoint.method === 'GET') { %>
                              style="background:var(--theme-success-bg);color:var(--theme-success);--tw-ring-color:var(--theme-success)"
                            <% } else if (endpoint.method === 'POST') { %>
                              style="background:var(--theme-accent-subtle);color:var(--theme-accent);--tw-ring-color:var(--theme-accent)"
                            <% } else if (endpoint.method === 'PATCH') { %>
                              style="background:var(--theme-warning-bg);color:var(--theme-warning);--tw-ring-color:var(--theme-warning)"
                            <% } else if (endpoint.method === 'DELETE') { %>
                              style="background:var(--theme-danger-bg);color:var(--theme-danger);--tw-ring-color:var(--theme-danger)"
                            <% } %>"><%= endpoint.method %></span>
                          <code class="text-sm font-mono"><%= endpoint.path %></code>
                          <span class="ml-auto text-xs" style="color:var(--theme-text-muted)">Permission: <%= endpoint.permission %></span>
                        </div>
                        <div class="px-4 py-3">
                          <p class="text-sm" style="color:var(--theme-text-muted)"><%= endpoint.description %></p>
                          <% if (endpoint.requestExample) { %>
                            <div class="mt-3">
                              <p class="text-xs font-medium" style="color:var(--theme-text)">Request Body:</p>
                              <pre class="mt-1 p-2 rounded-md overflow-x-auto text-xs" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong)"><code><%= endpoint.requestExample %></code></pre>
                            </div>
                          <% } %>
                          <% if (endpoint.responseExample) { %>
                            <div class="mt-3">
                              <p class="text-xs font-medium" style="color:var(--theme-text)">Response:</p>
                              <pre class="mt-1 p-2 rounded-md overflow-x-auto text-xs" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong)"><code><%= endpoint.responseExample %></code></pre>
                            </div>
                          <% } %>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

          <div class="mt-8">
            <h2 class="text-lg font-semibold leading-6" style="color:var(--theme-text-strong)">Response Format</h2>
            <p class="mt-2 text-sm" style="color:var(--theme-text-muted)">All successful responses return a JSON object with a <code class="px-1 py-0.5 rounded" style="background:var(--theme-bg-secondary)">data</code> property containing the requested information.</p>
            <pre class="mt-2 p-3 rounded-md overflow-x-auto" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong)"><code>{
  "data": {
    // Response data here
  }
}</code></pre>

            <p class="mt-4 text-sm" style="color:var(--theme-text-muted)">Error responses include an <code class="px-1 py-0.5 rounded" style="background:var(--theme-bg-secondary)">error</code> property with a description of the error.</p>
            <pre class="mt-2 p-3 rounded-md overflow-x-auto" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong)"><code>{
  "error": "Error message"
}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../components/footer') %>
