                      <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-neutral-800 dark:text-white"><%= apiKey.name %></td>
                      <td class="whitespace-nowrap px-4 py-3 text-sm text-neutral-500">
                        <div class="flex items-center">
                          <span class="font-mono text-xs"><%= apiKey.key.substring(0, 8) %>****<%= apiKey.key.slice(-4) %></span>
                          <button type="button" onclick="copyToClipboard('<%= apiKey.key %>')" class="ml-2 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition" title="Copy API key">
                            <%- icon('copy', { size: 14, class: 'shrink-0' }) %>
                          </button>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-sm text-neutral-500">
                        <div class="flex flex-wrap gap-1">
                          <% if (apiKey.permissions && apiKey.permissions.length > 0) { %>
                            <% apiKey.permissions.forEach(perm => { %>
                              <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-600/30"><%= perm.split('.').pop() %></span>
