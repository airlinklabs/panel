<%- include('../components/header', { title: req.translations.apiKeys || 'API Keys' }) %>

<% if (isMobileViewport) { %>
<main id="page-content" class="">
  <%- include('../components/template') %>
  <%- include('../components/toast') %>

  <div class="px-4 py-5 space-y-4">

    <div class="mb-2">
      <nav class="flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 mb-3">
        <a href="/account" class="hover:text-neutral-800 dark:hover:text-white transition">Account</a>
        <%- icon('chevron-right', { class: 'w-3 h-3 shrink-0' }) %>
        <span class="text-neutral-800 dark:text-white font-medium">API Keys</span>
      </nav>
      <div class="flex items-start justify-between gap-3">
        <div>
          <h1 class="text-base font-medium text-neutral-800 dark:text-white">API Keys</h1>
          <p class="text-xs text-neutral-500 mt-0.5">Manage API keys to access the panel API.</p>
        </div>
        <button id="createApiKeyBtn" type="button"
          class="flex items-center gap-1.5 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-3 py-2 text-xs font-medium shrink-0 transition active:scale-95">
          <%- icon('plus', { class: 'w-3.5 h-3.5' }) %>
          Create
        </button>
      </div>
    </div>

    <div class="space-y-2">
      <% if (typeof apiKeys !== 'undefined' && apiKeys.length > 0) { %>
        <% let keyIdx = 0; apiKeys.forEach(apiKey => { %>
          <div data-animate-card class="rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 px-4 py-3" style="--i:<%= keyIdx++ %>">
            <div class="flex items-start gap-3 mb-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= apiKey.name %></p>
                  <span class="shrink-0 text-[10px] font-medium px-1.5 py-0.5 rounded-md <%= apiKey.active ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20' : 'bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-500/20' %>">
                    <%= apiKey.active ? 'Active' : 'Inactive' %>
                  </span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2 mb-3 bg-neutral-100 dark:bg-neutral-800/50 rounded-xl px-3 py-2">
              <code class="text-xs font-mono text-neutral-600 dark:text-neutral-400 flex-1 truncate"><%= apiKey.key.substring(0, 8) %>****<%= apiKey.key.slice(-4) %></code>
              <button type="button" onclick="copyToClipboard('<%= apiKey.key %>')" class="shrink-0 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 transition active:scale-90" aria-label="Copy API key">
                <%- icon('copy', { size: 16, class: 'shrink-0' }) %>
              </button>
            </div>

            <% if (apiKey.permissions && apiKey.permissions.length > 0) { %>
              <div class="flex flex-wrap gap-1 mb-3">
                <% apiKey.permissions.forEach(perm => { %>
                  <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-600/30"><%= perm.split('.').pop() %></span>
                <% }) %>
              </div>
            <% } %>

            <div class="flex items-center justify-between">
              <p class="text-[11px] text-neutral-400"><%= new Date(apiKey.createdAt).toLocaleDateString() %><% if (apiKey.lastUsedAt) { %> · Last used <%= new Date(apiKey.lastUsedAt).toLocaleDateString() %><% } %></p>
              <div class="flex gap-1.5">
                <form action="/account/api-keys/toggle/<%= apiKey.id %>" method="POST" class="inline">
                  <%- include('../components/csrf') %>
                  <button type="submit" class="rounded-xl bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700/40 p-1.5 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition active:scale-90" aria-label="<%= apiKey.active ? 'Deactivate' : 'Activate' %>">
                    <%- icon(apiKey.active ? 'pause' : 'play', { size: 14, class: 'shrink-0' }) %>
                  </button>
                </form>
                <form id="deleteKeyForm_<%= apiKey.id %>" action="/account/api-keys/delete/<%= apiKey.id %>" method="POST" class="inline">
                  <%- include('../components/csrf') %>
                  <button type="button" onclick="confirmDeleteKey('<%= apiKey.id %>')" class="rounded-xl bg-red-600 p-1.5 text-white hover:bg-red-500 transition active:scale-90" aria-label="Delete API key">
                    <%- icon('trash-2', { size: 14, class: 'shrink-0' }) %>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 px-4 py-12 text-center">
          <%- icon('key', { size: 16, class: 'text-neutral-400 mx-auto mb-2' }) %>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">No API keys yet. Create one to access the panel API.</p>
        </div>
      <% } %>
    </div>

  </div>
</main>

<div id="createApiKeyModal" class="fixed inset-0 z-modal-backdrop hidden items-end justify-center bg-black/50 backdrop-blur-sm" aria-hidden="true">
  <div class="bg-white dark:bg-neutral-800 border-t border-neutral-200 dark:border-white/5 rounded-t-2xl w-full shadow-xl max-h-[90vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="createApiKeyTitle" tabindex="-1">
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-200 dark:border-neutral-700/60 sticky top-0 bg-white dark:bg-neutral-900 z-10">
      <div>
        <p id="createApiKeyTitle" class="text-sm font-semibold text-neutral-800 dark:text-white">New API Key</p>
        <p class="text-xs text-neutral-500 mt-0.5">Set a name and choose permissions.</p>
      </div>
      <button type="button" onclick="hideCreateModal()" class="w-7 h-7 flex items-center justify-center rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-500 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition active:scale-90" aria-label="Close">
        <%- icon('x', { size: 14, class: 'shrink-0' }) %>
      </button>
    </div>
    <form action="/account/api-keys/create" method="POST" class="px-5 py-4 space-y-4">
      <%- include('../components/csrf') %>
      <div>
        <label class="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">Name</label>
        <input type="text" name="name" placeholder="Key name" required
          class="w-full rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 px-3 py-2.5 text-sm text-neutral-800 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-neutral-500 transition">
      </div>
      <div>
        <p class="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-2">Permissions</p>
        <div class="space-y-2">
          <label class="flex items-center gap-2 px-3 py-2.5 rounded-xl border border-neutral-100 dark:border-neutral-700/40 bg-neutral-50 dark:bg-neutral-800/50 cursor-pointer active:scale-95 transition-all duration-150 has-[:checked]:border-neutral-900 dark:has-[:checked]:border-white/30 has-[:checked]:bg-neutral-900 dark:has-[:checked]:bg-white/10">
            <input type="checkbox" name="permissions" value="server.view" class="h-3.5 w-3.5 rounded shrink-0">
            <span class="text-xs text-neutral-600 dark:text-neutral-300">server.view</span>
          </label>
          <label class="flex items-center gap-2 px-3 py-2.5 rounded-xl border border-neutral-100 dark:border-neutral-700/40 bg-neutral-50 dark:bg-neutral-800/50 cursor-pointer active:scale-95 transition-all duration-150 has-[:checked]:border-neutral-900 dark:has-[:checked]:border-white/30 has-[:checked]:bg-neutral-900 dark:has-[:checked]:bg-white/10">
            <input type="checkbox" name="permissions" value="server.start" class="h-3.5 w-3.5 rounded shrink-0">
            <span class="text-xs text-neutral-600 dark:text-neutral-300">server.start</span>
          </label>
          <label class="flex items-center gap-2 px-3 py-2.5 rounded-xl border border-neutral-100 dark:border-neutral-700/40 bg-neutral-50 dark:bg-neutral-800/50 cursor-pointer active:scale-95 transition-all duration-150 has-[:checked]:border-neutral-900 dark:has-[:checked]:border-white/30 has-[:checked]:bg-neutral-900 dark:has-[:checked]:bg-white/10">
            <input type="checkbox" name="permissions" value="server.stop" class="h-3.5 w-3.5 rounded shrink-0">
            <span class="text-xs text-neutral-600 dark:text-neutral-300">server.stop</span>
          </label>
          <label class="flex items-center gap-2 px-3 py-2.5 rounded-xl border border-neutral-100 dark:border-neutral-700/40 bg-neutral-50 dark:bg-neutral-800/50 cursor-pointer active:scale-95 transition-all duration-150 has-[:checked]:border-neutral-900 dark:has-[:checked]:border-white/30 has-[:checked]:bg-neutral-900 dark:has-[:checked]:bg-white/10">
            <input type="checkbox" name="permissions" value="server.restart" class="h-3.5 w-3.5 rounded shrink-0">
            <span class="text-xs text-neutral-600 dark:text-neutral-300">server.restart</span>
          </label>
          <label class="flex items-center gap-2 px-3 py-2.5 rounded-xl border border-neutral-100 dark:border-neutral-700/40 bg-neutral-50 dark:bg-neutral-800/50 cursor-pointer active:scale-95 transition-all duration-150 has-[:checked]:border-neutral-900 dark:has-[:checked]:border-white/30 has-[:checked]:bg-neutral-900 dark:has-[:checked]:bg-white/10">
            <input type="checkbox" name="permissions" value="server.files" class="h-3.5 w-3.5 rounded shrink-0">
            <span class="text-xs text-neutral-600 dark:text-neutral-300">server.files</span>
          </label>
        </div>
      </div>
      <div class="flex gap-2 pb-2">
        <button type="button" onclick="hideCreateModal()" class="flex-1 py-2.5 text-xs font-medium rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 active:scale-95 transition">Cancel</button>
        <button type="submit" class="flex-1 py-2.5 text-xs font-medium rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 active:scale-95 transition">Create API Key</button>
      </div>
    </form>
  </div>
</div>

<% } else { %>
