<script nonce="<%- nonce %>">
document.addEventListener('DOMContentLoaded', () => {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

  function copyToClipboard(text) {
    navigator.clipboard.writeText(text)
      .then(() => showToast('API key copied', 'success'))
      .catch(() => showToast('Failed to copy', 'error'));
  }
  window.copyToClipboard = copyToClipboard;

  let activeModalId = null;
  let modalReturnFocus = null;

  function showModal(id) {
    const el = document.getElementById(id);
    modalReturnFocus = document.activeElement;
    activeModalId = id;
    el.setAttribute('aria-hidden', 'false');
    el.classList.remove('hidden');
    el.classList.add('flex');
  }

  function hideModal(id) {
    const el = document.getElementById(id);
    el.setAttribute('aria-hidden', 'true');
    el.classList.add('hidden');
    el.classList.remove('flex');
    if (modalReturnFocus && typeof modalReturnFocus.focus === 'function') modalReturnFocus.focus();
    modalReturnFocus = null;
    activeModalId = null;
  }

  document.getElementById('createApiKeyBtn')?.addEventListener('click', () => showModal('createApiKeyModal'));
  window.hideCreateModal = () => hideModal('createApiKeyModal');

  document.getElementById('createApiKeyModal')?.addEventListener('click', function(e) {
    if (e.target === this) hideModal('createApiKeyModal');
  });

  document.addEventListener('keydown', function(e) {
    if (!activeModalId) return;
    if (e.key === 'Escape') { e.preventDefault(); hideModal(activeModalId); }
  });

  window.confirmDeleteKey = function(keyId) {
    if (window.modal && typeof window.modal.confirm === 'function') {
      window.modal.confirm({
        title: 'Delete API key',
        body: 'This will permanently revoke the key. Any integrations using it will stop working.',
        danger: true,
        confirmLabel: 'Delete',
        onConfirm: () => { document.getElementById('deleteKeyForm_' + keyId).submit(); }
      });
      return;
    }
    if (confirm('Delete this API key? This cannot be undone.')) {
      document.getElementById('deleteKeyForm_' + keyId).submit();
    }
  };
});
</script>

