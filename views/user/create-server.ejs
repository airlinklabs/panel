<%- include('../layouts/user', { title: 'Create Server' }) %>

<div class="px-4 sm:px-6 lg:px-8 pt-4">
  <div class="flex items-start gap-4">
    <a href="/" class="al-btn al-btn-ghost p-2 shrink-0">
      <%- icon('arrow-left', { class: 'w-4 h-4' }) %>
    </a>
    <div>
      <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong)"><%= t('createServer') %></h1>
      <p class="text-sm mt-1" style="color:var(--theme-text-muted)"><%= t('createNewServerDesc') %></p>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="mt-4 p-3 rounded-xl text-[13px]" style="background:var(--theme-danger-bg); border:1px solid var(--theme-danger); color:var(--theme-danger);">
    <%= error %>
  </div>
  <% } %>

  <% if (typeof canCreate !== 'undefined' && !canCreate) { %>
  <div class="mt-8">
    <%- include('../partials/empty-state', {
      iconName: 'lock',
      title: t('serverCreationDisabled'),
      description: t('contactAdminToEnable')
    }) %>
  </div>
  <% } else { %>

  <form id="createServerForm" class="mt-5 max-w-2xl">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <!-- Server Name -->
    <div class="al-card p-4 mb-4">
      <h3 class="text-[13px] font-medium mb-3" style="color:var(--theme-text-strong)"><%= t('basicInfo') %></h3>
      <div class="al-form-field">
        <label class="al-form-label"><%= t('serverName') %> <span class="text-red-500">*</span></label>
        <input type="text" id="serverName" name="name" class="al-form-input" required maxlength="100"
          placeholder="my-server">
      </div>
      <div class="al-form-field mt-3">
        <label class="al-form-label"><%= t('description') %></label>
        <input type="text" id="serverDescription" name="description" class="al-form-input" maxlength="500"
          placeholder="<%= t('optionalDescription') %>">
      </div>
    </div>

    <!-- Node & Image Selection -->
    <div class="al-card p-4 mb-4">
      <h3 class="text-[13px] font-medium mb-3" style="color:var(--theme-text-strong)"><%= t('configuration') %></h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="al-form-field">
          <label class="al-form-label"><%= t('node') %> <span class="text-red-500">*</span></label>
          <select id="nodeId" name="nodeId" class="al-form-select" required>
            <option value="" disabled selected><%= t('selectNode') %></option>
            <% if (typeof nodes !== 'undefined' && Array.isArray(nodes)) { %>
              <% nodes.forEach(function(node) { %>
              <option value="<%= node.id %>"><%= node.name %> (<%= node.address %>)</option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div class="al-form-field">
          <label class="al-form-label"><%= t('image') %> <span class="text-red-500">*</span></label>
          <select id="imageId" name="imageId" class="al-form-select" required>
            <option value="" disabled selected><%= t('selectImage') %></option>
            <% if (typeof images !== 'undefined' && Array.isArray(images)) { %>
              <% images.forEach(function(img) { %>
              <option value="<%= img.id %>" data-name="<%= img.name %>"><%= img.name %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
      </div>
      <div class="al-form-field mt-3">
        <label class="al-form-label"><%= t('dockerImage') %> <span class="text-red-500">*</span></label>
        <select id="dockerImage" name="dockerImage" class="al-form-select" required>
          <option value="" disabled selected><%= t('selectDockerImage') %></option>
        </select>
      </div>
    </div>

    <!-- Resources -->
    <div class="al-card p-4 mb-4">
      <h3 class="text-[13px] font-medium mb-3" style="color:var(--theme-text-strong)"><%= t('resources') %></h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="al-form-field">
          <label class="al-form-label"><%= t('memory') %> (MB) <span class="text-red-500">*</span></label>
          <input type="number" id="memory" name="Memory" class="al-form-input" required min="128"
            value="<%= typeof resourceLimits !== 'undefined' ? 512 : 512 %>">
          <% if (typeof resourceLimits !== 'undefined') { %>
          <p class="text-[10px] mt-1" style="color:var(--theme-text-muted)">Max: <%= resourceLimits.maxMemory %> MB</p>
          <% } %>
        </div>
        <div class="al-form-field">
          <label class="al-form-label"><%= t('cpu') %> (%) <span class="text-red-500">*</span></label>
          <input type="number" id="cpu" name="Cpu" class="al-form-input" required min="5" step="5"
            value="<%= typeof resourceLimits !== 'undefined' ? 50 : 50 %>">
          <% if (typeof resourceLimits !== 'undefined') { %>
          <p class="text-[10px] mt-1" style="color:var(--theme-text-muted)">Max: <%= resourceLimits.maxCpu %>%</p>
          <% } %>
        </div>
        <div class="al-form-field">
          <label class="al-form-label"><%= t('storage') %> (MB) <span class="text-red-500">*</span></label>
          <input type="number" id="storage" name="Storage" class="al-form-input" required min="1024"
            value="<%= typeof resourceLimits !== 'undefined' ? 10240 : 10240 %>">
          <% if (typeof resourceLimits !== 'undefined') { %>
          <p class="text-[10px] mt-1" style="color:var(--theme-text-muted)">Max: <%= resourceLimits.maxStorage %> MB</p>
          <% } %>
        </div>
      </div>
      <div class="al-form-field mt-3">
        <label class="al-form-label"><%= t('swap') %> (MB, -1 = unlimited)</label>
        <input type="number" id="swap" name="Swap" class="al-form-input" min="-1" value="0">
      </div>
    </div>

    <!-- Submit -->
    <div class="flex items-center gap-3">
      <button type="submit" id="submitBtn" class="al-btn al-btn-primary">
        <%- icon('plus', { class: 'w-4 h-4' }) %> <%= t('createServer') %>
      </button>
      <a href="/" class="al-btn al-btn-ghost"><%= t('cancel') %></a>
    </div>
  </form>

  <% } %>
</div>

<script nonce="<%- nonce %>">
(function() {
  var images = <%- JSON.stringify(typeof images !== 'undefined' ? images : []) %>;
  var imageSelect = document.getElementById('imageId');
  var dockerSelect = document.getElementById('dockerImage');

  if (imageSelect) {
    imageSelect.addEventListener('change', function() {
      var selected = imageSelect.options[imageSelect.selectedIndex];
      var imageId = selected.value;
      dockerSelect.innerHTML = '<option value="" disabled selected>Loading...</option>';

      var image = images.find(function(img) { return String(img.id) === String(imageId); });
      if (!image) { dockerSelect.innerHTML = '<option value="" disabled>No images</option>'; return; }

      var dockerImages = [];
      try { dockerImages = JSON.parse(image.dockerImages || '[]'); } catch(e) { dockerImages = []; }

      dockerSelect.innerHTML = '';
      if (dockerImages.length === 0) {
        dockerSelect.innerHTML = '<option value="" disabled>No docker images</option>';
        return;
      }

      dockerImages.forEach(function(obj) {
        Object.keys(obj).forEach(function(key) {
          var opt = document.createElement('option');
          opt.value = key;
          opt.textContent = obj[key] || key;
          dockerSelect.appendChild(opt);
        });
      });
    });
  }

  document.getElementById('createServerForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.textContent = 'Creating...';

    try {
      var fd = new FormData(e.target);
      var data = {};
      fd.forEach(function(val, key) { data[key] = val; });

      var r = await fetch('/create-server', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
        body: JSON.stringify(data)
      });

      if (r.redirected) { window.location.href = r.url; }
      else if (r.ok) { window.location.href = '/dashboard'; }
      else { var err = await r.text(); showToast(err, 'error'); btn.disabled = false; btn.textContent = '<%= t("createServer") %>'; }
    } catch(err) {
      showToast('Failed to create server', 'error');
      btn.disabled = false;
      btn.textContent = '<%= t("createServer") %>';
    }
  });
})();
</script>

<%- include('../layouts/user-footer') %>
