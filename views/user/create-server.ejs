<%- include('../components/header', { title: 'Create Server' }) %>

<% if (isMobileViewport) { %>
<main id="page-content" class="">
  <%- include('../components/template') %>

  <div class="px-4 py-5">
    <div class="mb-5">
      <h1 class="text-base font-medium text-neutral-800 dark:text-white">Create Server</h1>
      <p class="text-xs text-neutral-500 mt-0.5">Spin up a new server in a few steps.</p>
    </div>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="mb-4 rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3">
      <p class="text-sm font-medium text-red-700 dark:text-red-400"><%= errorMessage.message || errorMessage %></p>
    </div>
    <% } %>

    <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4">
      <form id="createServerForm" class="flex flex-col gap-4">
        <div>
          <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Server Name</label>
          <input type="text" name="name" required placeholder="my-server"
            class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Description</label>
          <input type="text" name="description" placeholder="Optional description"
            class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Node</label>
          <select name="nodeId" required
            class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
            <% if (nodes && nodes.length > 0) { %>
              <% nodes.forEach(function(node) { %>
              <option value="<%= node.id %>"><%= node.name %></option>
              <% }); %>
            <% } else { %>
              <option value="" disabled selected>No nodes available</option>
            <% } %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Server Image</label>
          <select name="imageId" required id="imageSelect"
            class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
            <% if (images && images.length > 0) { %>
              <% images.forEach(function(img) { %>
              <option value="<%= img.id %>" data-docker="<%= img.dockerImage %>" data-name="<%= img.name %>"><%= img.name %></option>
              <% }); %>
            <% } else { %>
              <option value="" disabled selected>No images available</option>
            <% } %>
          </select>
          <input type="hidden" name="dockerImage" id="dockerImageInput" value="<%= images && images.length > 0 ? images[0].dockerImage : '' %>">
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Memory</label>
            <input type="hidden" name="Memory" id="userMemory" value="1024">
            <div class="flex items-stretch gap-0">
              <input id="userMemoryDisplay" type="number" min="1" value="1"
                class="w-full rounded-l-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
              <select id="userMemoryUnit"
                class="rounded-r-xl border border-l-0 border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] px-1.5 text-xs text-neutral-600 dark:text-neutral-400 focus:outline-none">
                <option value="1">MB</option>
                <option value="1024" selected>GB</option>
              </select>
            </div>
            <p class="text-[10px] text-neutral-400 mt-0.5">Max: <%= typeof resourceLimits !== 'undefined' ? resourceLimits.maxMemory : 8192 %> MB</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">CPU</label>
            <input type="hidden" name="Cpu" id="userCPU" value="100">
            <div class="flex items-stretch gap-0">
              <input id="userCPUDisplay" type="number" min="0.5" step="0.5" value="1"
                class="w-full rounded-l-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
              <select id="userCPUUnit"
                class="rounded-r-xl border border-l-0 border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] px-1.5 text-xs text-neutral-600 dark:text-neutral-400 focus:outline-none">
                <option value="cores" selected>Cores</option>
                <option value="percent">%</option>
              </select>
            </div>
            <p class="text-[10px] text-neutral-400 mt-0.5">1 core = 100%. Max: <%= typeof resourceLimits !== 'undefined' ? resourceLimits.maxCpu : 400 %>%</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Disk</label>
            <input type="hidden" name="Storage" id="userStorage" value="10240">
            <div class="flex items-stretch gap-0">
              <input id="userStorageDisplay" type="number" min="1" value="10"
                class="w-full rounded-l-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
              <select id="userStorageUnit"
                class="rounded-r-xl border border-l-0 border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] px-1.5 text-xs text-neutral-600 dark:text-neutral-400 focus:outline-none">
                <option value="1">MB</option>
                <option value="1024" selected>GB</option>
              </select>
            </div>
            <p class="text-[10px] text-neutral-400 mt-0.5">Max: <%= typeof resourceLimits !== 'undefined' ? resourceLimits.maxStorage : 51200 %> MB</p>
          </div>
        </div>

        <% if (typeof serverLimit !== 'undefined' && typeof currentCount !== 'undefined') { %>
        <p class="text-xs text-neutral-400">Servers: <%= currentCount %> / <%= serverLimit %></p>
        <% } %>

        <button type="submit" id="submitBtn"
          class="w-full rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2.5 text-sm font-medium transition hover:bg-neutral-700 dark:hover:bg-neutral-200 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-900 dark:focus-visible:ring-white focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950">
          Create Server
        </button>
      </form>
    </div>
  </div>
</main>

<% } else { %>
<main class="h-screen m-auto">
  <div class="flex h-screen">
    <%- include('../components/template') %>

    <div id="page-content" class="flex-1 overflow-y-auto pt-16">
      <div class="px-12 pt-6 pb-8">
        <div class="max-w-2xl mx-auto">
          <div class="mb-6">
            <h1 class="text-base font-medium text-neutral-800 dark:text-white">Create Server</h1>
            <p class="text-sm text-neutral-500 mt-0.5">Spin up a new server in a few steps.</p>
          </div>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          <div class="mb-5 rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3">
            <p class="text-sm font-medium text-red-700 dark:text-red-400"><%= errorMessage.message || errorMessage %></p>
          </div>
          <% } %>

          <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-6">
            <form id="createServerForm" class="space-y-5">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Server Name</label>
                <input type="text" name="name" required placeholder="my-server"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
              </div>

              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Description</label>
                <input type="text" name="description" placeholder="Optional description"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Node</label>
                  <select name="nodeId" required
                    class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
                    <% if (nodes && nodes.length > 0) { %>
                      <% nodes.forEach(function(node) { %>
                      <option value="<%= node.id %>"><%= node.name %></option>
                      <% }); %>
                    <% } else { %>
                      <option value="" disabled selected>No nodes available</option>
                    <% } %>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Server Image</label>
                  <select name="imageId" required id="imageSelect"
                    class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
                    <% if (images && images.length > 0) { %>
                      <% images.forEach(function(img) { %>
                      <option value="<%= img.id %>" data-docker="<%= img.dockerImage %>" data-name="<%= img.name %>"><%= img.name %></option>
                      <% }); %>
                    <% } else { %>
                      <option value="" disabled selected>No images available</option>
                    <% } %>
                  </select>
                  <input type="hidden" name="dockerImage" id="dockerImageInput" value="<%= images && images.length > 0 ? images[0].dockerImage : '' %>">
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Resources</label>
        <div class="flex flex-col gap-3 sm:grid sm:grid-cols-3 sm:gap-3">
                  <div>
                    <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">Memory</label>
                    <input type="hidden" name="Memory" id="userMemoryDesktop" value="1024">
                    <div class="flex items-stretch gap-0">
                      <input id="userMemoryDisplayDesktop" type="number" min="1" value="1"
                        class="w-full rounded-l-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
                      <select id="userMemoryUnitDesktop"
                        class="rounded-r-xl border border-l-0 border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] px-1.5 text-xs text-neutral-600 dark:text-neutral-400 focus:outline-none">
                        <option value="1">MB</option>
                        <option value="1024" selected>GB</option>
                      </select>
                    </div>
                    <p class="text-[10px] text-neutral-400 mt-0.5">Max: <%= typeof resourceLimits !== 'undefined' ? resourceLimits.maxMemory : 8192 %> MB</p>
                  </div>
                  <div>
                    <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">CPU</label>
                    <input type="hidden" name="Cpu" id="userCPUDesktop" value="100">
                    <div class="flex items-stretch gap-0">
                      <input id="userCPUDisplayDesktop" type="number" min="0.5" step="0.5" value="1"
                        class="w-full rounded-l-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
                      <select id="userCPUUnitDesktop"
                        class="rounded-r-xl border border-l-0 border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] px-1.5 text-xs text-neutral-600 dark:text-neutral-400 focus:outline-none">
                        <option value="cores" selected>Cores</option>
                        <option value="percent">%</option>
                      </select>
                    </div>
                    <p class="text-[10px] text-neutral-400 mt-0.5">1 core = 100%. Max: <%= typeof resourceLimits !== 'undefined' ? resourceLimits.maxCpu : 400 %>%</p>
                  </div>
                  <div>
                    <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">Disk</label>
                    <input type="hidden" name="Storage" id="userStorageDesktop" value="10240">
                    <div class="flex items-stretch gap-0">
                      <input id="userStorageDisplayDesktop" type="number" min="1" value="10"
                        class="w-full rounded-l-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-2.5 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30 transition">
                      <select id="userStorageUnitDesktop"
                        class="rounded-r-xl border border-l-0 border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] px-1.5 text-xs text-neutral-600 dark:text-neutral-400 focus:outline-none">
                        <option value="1">MB</option>
                        <option value="1024" selected>GB</option>
                      </select>
                    </div>
                    <p class="text-[10px] text-neutral-400 mt-0.5">Max: <%= typeof resourceLimits !== 'undefined' ? resourceLimits.maxStorage : 51200 %> MB</p>
                  </div>
                </div>
              </div>

              <% if (typeof serverLimit !== 'undefined' && typeof currentCount !== 'undefined') { %>
              <p class="text-xs text-neutral-400">Servers: <%= currentCount %> / <%= serverLimit %></p>
              <% } %>

              <div class="flex items-center gap-3 pt-2">
                <a href="/" class="min-h-10 px-4 py-2 rounded-xl text-sm font-medium bg-transparent text-neutral-500 border border-neutral-200 dark:border-white/10 hover:bg-neutral-100 dark:hover:bg-white/[0.05] transition">Cancel</a>
                <button type="submit" id="submitBtn"
                  class="min-h-10 px-6 py-2 rounded-xl text-sm font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-200 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-900 dark:focus-visible:ring-white focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950 active:scale-[0.98]">
                  Create Server
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<% } %>

<script nonce="<%- nonce %>">
(function() {
  var imageSelect = document.getElementById('imageSelect');
  var dockerInput = document.getElementById('dockerImageInput');
  var form = document.getElementById('createServerForm');
  var submitBtn = document.getElementById('submitBtn');

  if (imageSelect && dockerInput) {
    imageSelect.addEventListener('change', function() {
      var opt = imageSelect.options[imageSelect.selectedIndex];
      if (opt && opt.dataset.docker) {
        dockerInput.value = opt.dataset.docker;
      }
    });
  }

  function syncUnit(displayId, unitId, hiddenId) {
    var display = document.getElementById(displayId);
    var unit = document.getElementById(unitId);
    var hidden = document.getElementById(hiddenId);
    if (!display || !unit || !hidden) return;
    function update() {
      hidden.value = Math.round(parseFloat(display.value || 0) * parseInt(unit.value));
    }
    display.addEventListener('input', update);
    unit.addEventListener('change', function() {
      var prevMult = this.value === '1024' ? 1 : 1024;
      var newMult = parseInt(this.value);
      if (prevMult !== newMult) display.value = Math.round(parseFloat(display.value || 0) * prevMult / newMult) || 1;
      update();
    });
    update();
  }

  function syncCPU(displayId, unitId, hiddenId) {
    var display = document.getElementById(displayId);
    var unit = document.getElementById(unitId);
    var hidden = document.getElementById(hiddenId);
    if (!display || !unit || !hidden) return;
    function syncHidden() {
      var val = parseFloat(display.value) || 0;
      hidden.value = unit.value === 'cores' ? String(Math.round(val * 100)) : String(Math.round(val));
    }
    unit.addEventListener('change', syncHidden);
    display.addEventListener('input', syncHidden);
    syncHidden();
  }

  syncUnit('userMemoryDisplay', 'userMemoryUnit', 'userMemory');
  syncUnit('userStorageDisplay', 'userStorageUnit', 'userStorage');
  syncCPU('userCPUDisplay', 'userCPUUnit', 'userCPU');
  syncUnit('userMemoryDisplayDesktop', 'userMemoryUnitDesktop', 'userMemoryDesktop');
  syncUnit('userStorageDisplayDesktop', 'userStorageUnitDesktop', 'userStorageDesktop');
  syncCPU('userCPUDisplayDesktop', 'userCPUUnitDesktop', 'userCPUDesktop');

  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating...';

      var data = {};
      var fd = new FormData(form);
      fd.forEach(function(val, key) { data[key] = val; });

      try {
        var r = await fetch('/create-server', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        var result = await r.json();
        if (r.ok && result.success) {
          window.location.href = result.redirect || '/dashboard';
        } else {
          showToast(result.error || 'Failed to create server.', 'error');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Create Server';
        }
      } catch (err) {
        showToast('Something went wrong. Please try again.', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create Server';
      }
    });
  }
})();
</script>
