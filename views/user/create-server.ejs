<%- include('../components/header', { title: 'Create Server' }) %>

<style>
  ::-webkit-scrollbar { display: none; }

  /* ── Resource stepper ────────────────────────────────────── */
  .stepper { display: flex; align-items: center; gap: 0; border: 1px solid var(--theme-border, #e5e5e5); border-radius: 12px; overflow: hidden; background: var(--theme-bg-secondary, #f5f5f5); }
  .dark .stepper { border-color: var(--theme-border-subtle, rgba(255,255,255,0.08)); background: var(--theme-bg-secondary, rgba(255,255,255,0.06)); }
  .stepper-btn {
    padding: 10px 14px; background: none; border: none; cursor: pointer;
    font-size: 16px; color: var(--theme-text-muted, #525252); transition: background 0.1s;
    flex-shrink: 0; line-height: 1; min-width: 44px; min-height: 44px;
    display: flex; align-items: center; justify-content: center;
  }
  .dark .stepper-btn { color: var(--theme-text, #a3a3a3); }
  .stepper-btn:hover { background: var(--theme-bg-hover, rgba(0,0,0,0.06)); }
  .dark .stepper-btn:hover { background: var(--theme-bg-hover, rgba(255,255,255,0.07)); }
  .stepper-btn:active { background: var(--theme-bg-hover, rgba(0,0,0,0.1)); }
  .dark .stepper-btn:active { background: var(--theme-bg-hover, rgba(255,255,255,0.1)); }
  .stepper-input {
    flex: 1; text-align: center; border: none; background: none; outline: none;
    font-size: 14px; font-weight: 500; color: var(--theme-text-strong, #171717); padding: 9px 4px;
    font-family: inherit; min-width: 0;
  }
  .dark .stepper-input { color: var(--theme-text, #e5e5e5); }
</style>

<script nonce="<%- nonce %>">
function createServerPage() {
  return {
    error: '',
    showError(msg) { this.error = msg; },
    clearError() { this.error = ''; }
  };
}
</script>

<div x-data="createServerPage()">
<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="hidden lg:block w-60 h-full"><%- include('../components/sidebar') %></div>
<%- include('../components/template') %>

    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../components/ui/breadcrumb', { items: [
        { label: 'Dashboard', href: '/' },
        { label: 'Create Server' }
      ] }) %>
      <div class="px-8 lg:px-12 pt-6 pb-12 max-w-5xl">

        <!-- Header -->
        <div class="flex items-center justify-between mb-7">
          <div>
            <h1 class="al-page-title">Create a server</h1>
            <p class="al-page-desc"><%= currentCount %> of <%= serverLimit %> servers used</p>
          </div>
          <a href="/" class="text-sm transition" style="color:var(--theme-text-muted)">Cancel</a>
        </div>

        <div class="space-y-5">

          <!-- Top row: Details + Node & Image side by side on desktop -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

          <!-- Details -->
          <div class="al-card">
            <div class="al-card-header">Details</div>
            <div class="p-5 space-y-4">
              <div>
                <label class="al-label" for="serverName">Name</label>
                <input id="serverName" type="text" placeholder="My server" maxlength="64" class="al-input">
              </div>
              <div>
                <label class="al-label" for="serverDescription">Description <span style="color:var(--theme-text-muted);font-weight:normal">(optional)</span></label>
                <input id="serverDescription" type="text" placeholder="What is this for?" maxlength="128" class="al-input">
              </div>
            </div>
          </div>

          <!-- Node & Image -->
          <div class="al-card">
            <div class="al-card-header">Node & image</div>
            <div class="p-5 space-y-4">
              <div>
                <label class="al-label" for="nodeId">Node</label>
                <select id="nodeId" class="hidden">
                  <option value="" disabled>Select a node</option>
                  <% nodes.forEach(node => { %>
                  <option value="<%= node.id %>"<%= recommendedNodeId === node.id ? ' selected' : '' %>><%= node.name %> — <%= node.address %><% if (recommendedNodeId === node.id) { %> (recommended)<% } %></option>
                  <% }); %>
                </select>
                <div class="custom-select" data-for="nodeId"></div>
              </div>
              <div id="nodeHeadroom" class="hidden space-y-2.5 rounded-xl p-4" style="border:1px solid var(--theme-border); background:var(--theme-bg-secondary);">
                <p class="text-xs font-medium" style="color:var(--theme-text-muted)">Node headroom</p>
                <div id="nodeHeadroomRows" class="space-y-2.5"></div>
                <p id="headroomHint" class="text-[11px]" style="color:var(--theme-text-muted)"></p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="al-label" for="imageId">Image</label>
                  <select id="imageId" class="hidden">
                    <option value="" disabled selected>Select an image</option>
                    <% images.forEach(image => { %>
                    <option value="<%= image.id %>" data-docker="<%= image.dockerImages %>" data-port-requirements='<%= image.portRequirements || "[]" %>'><%= image.name %></option>
                    <% }); %>
                  </select>
                  <div class="custom-select" data-for="imageId"></div>
                </div>
                <div>
                  <label class="al-label" for="dockerImage">Docker variant</label>
                  <select id="dockerImage" class="hidden">
                    <option value="" disabled selected>Select an image first</option>
                  </select>
                  <div class="custom-select" data-for="dockerImage"></div>
                </div>
              </div>
              <div>
                <label class="al-label">Ports</label>
                <button type="button" id="assignPortsBtn" class="cs-trigger">
                  <span id="assignPortsLabel">Assign ports</span>
                </button>
              </div>
            </div>
          </div>

          </div><!-- /top grid -->

          <!-- Resources -->
          <div class="al-card overflow-hidden">
            <div class="al-card-header">Resources</div>
            <div class="p-5 grid grid-cols-3 gap-4">
              <div>
                <label for="MemoryDisplay" class="al-label flex items-center gap-1.5">
                  <%- icon('server', { width: 14, height: 14 }) %>
                  RAM
                </label>
                <!-- hidden field always holds MB -->
                <input type="hidden" id="Memory" value="512">
                <div class="flex items-stretch gap-0">
                  <button type="button" class="stepper-btn rounded-l-xl" data-action="dec" data-target="MemoryDisplay" data-step="128" data-min="1" aria-label="Decrease RAM">−</button>
                  <input id="MemoryDisplay" type="number" value="512" min="1" class="stepper-input flex-1" aria-label="RAM value">
                  <button type="button" class="stepper-btn" data-action="inc" data-target="MemoryDisplay" data-step="128" aria-label="Increase RAM">+</button>
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="MemoryDisplay" data-hidden="Memory"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
                <p class="text-[11px] mt-1.5" style="color:var(--theme-text-muted)"><%= resourceLimits.maxMemory > 0 ? 'Max ' + resourceLimits.maxMemory + ' MB' : 'Unlimited' %></p>
              </div>
              <div>
                <label for="Cpu" class="al-label flex items-center gap-1.5">
                  <%- icon('cpu', { width: 14, height: 14 }) %>
                  CPU <span style="color:var(--theme-text-muted);font-weight:normal">(%)</span>
                </label>
                <div class="stepper">
                  <button type="button" class="stepper-btn" data-action="dec" data-target="Cpu" data-step="50" data-min="50" aria-label="Decrease CPU">−</button>
                  <input id="Cpu" type="number" value="100" min="50" max="<%= resourceLimits.maxCpu %>" class="stepper-input" aria-label="CPU percentage">
                  <button type="button" class="stepper-btn" data-action="inc" data-target="Cpu" data-step="50" data-max="<%= resourceLimits.maxCpu %>" aria-label="Increase CPU">+</button>
                </div>
                <p class="text-[11px] mt-1.5" style="color:var(--theme-text-muted)">50% = half a core. <%= resourceLimits.maxCpu > 0 ? 'Max ' + resourceLimits.maxCpu + '%' : 'Unlimited' %></p>
              </div>
              <div>
                <label for="SwapDisplay" class="al-label flex items-center gap-1.5">
                  <%- icon('memory-stick', { width: 14, height: 14 }) %>
                  Swap
                </label>
                <!-- hidden field always holds MB; -1 = unlimited, 0 = off -->
                <input type="hidden" id="Swap" value="0">
                <div class="flex items-stretch gap-0">
                  <button type="button" class="stepper-btn rounded-l-xl" data-action="dec" data-target="SwapDisplay" data-step="128" data-min="-1" aria-label="Decrease swap">−</button>
                  <input id="SwapDisplay" type="number" value="0" min="-1" class="stepper-input flex-1" aria-label="Swap value">
                  <button type="button" class="stepper-btn" data-action="inc" data-target="SwapDisplay" data-step="128" aria-label="Increase swap">+</button>
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="SwapDisplay" data-hidden="Swap"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
                <p class="text-[11px] mt-1.5" style="color:var(--theme-text-muted)">0 = off, -1 = unlimited</p>
              </div>
              <div>
                <label for="StorageDisplay" class="al-label flex items-center gap-1.5">
                  <%- icon('hard-drive', { width: 14, height: 14 }) %>
                  Storage
                </label>
                <!-- hidden field always holds MB -->
                <input type="hidden" id="Storage" value="5120">
                <div class="flex items-stretch gap-0">
                  <button type="button" class="stepper-btn rounded-l-xl" data-action="dec" data-target="StorageDisplay" data-step="1" data-min="1" aria-label="Decrease storage">−</button>
                  <input id="StorageDisplay" type="number" value="5" min="1" class="stepper-input flex-1" aria-label="Storage value">
                  <button type="button" class="stepper-btn" data-action="inc" data-target="StorageDisplay" data-step="1" aria-label="Increase storage">+</button>
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="StorageDisplay" data-hidden="Storage"
                    data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
                </div>
                <p class="text-[11px] mt-1.5" style="color:var(--theme-text-muted)"><%= resourceLimits.maxStorage > 0 ? 'Max ' + resourceLimits.maxStorage + ' MB' : 'Unlimited' %></p>
              </div>
            </div>
          </div>

          <!-- Error -->
          <div x-show="error" x-transition class="hidden rounded-xl px-4 py-3" style="background:var(--theme-danger-bg);border:1px solid color-mix(in srgb, var(--theme-danger) 25%, transparent);">
            <p class="text-sm" style="color:var(--theme-danger)" x-text="error"></p>
          </div>

          <!-- Submit -->
          <div class="flex justify-end pt-1">
            <button type="button" id="createBtn"
              class="al-btn-primary px-6 py-2.5 text-sm font-medium shadow-sm transition inline-flex items-center gap-2">
              <span id="createBtnText">Create server</span>
              <span id="createBtnSpinner" class="hidden w-4 h-4 border-2 rounded-full animate-spin" style="border-color:color-mix(in srgb, var(--theme-btn-primary-text) 25%, transparent);border-top-color:var(--theme-btn-primary-text);"></span>
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>
</main>
</div><!-- /x-data -->

<div id="portsContent" style="display:none;">
  <p class="text-xs mb-3" style="color:var(--theme-text-muted)">External ports are assigned automatically to the next free node port. Edit the name and internal container port below.</p>
  <div id="requiredPortsList" class="space-y-2"></div>
  <button type="button" id="addPortBtn" class="mt-3 text-sm font-medium inline-flex items-center gap-1.5 transition" style="color:var(--theme-text-muted)">
    <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>Add port
  </button>
  <div class="flex justify-end mt-4">
    <button type="button" id="portsOk" class="al-btn-primary px-4 py-2 text-sm font-medium inline-flex items-center gap-2"><%- icon('check', { class: 'size-4', strokeWidth: 1.5 }) %>OK</button>
  </div>
</div>

<%- include('../components/loadingPopup') %>

<script nonce="<%- nonce %>" src="/javascript/user/create-server.js?v=5"></script>
<script nonce="<%- nonce %>">window.__nodeHeadroom = <%- JSON.stringify(nodeHeadroom) %>;</script>

<%- include('../components/footer') %>
