<%- include('../components/header', { title: t('editImage') }) %>

<style>
  ::-webkit-scrollbar { display: none; }
</style>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../components/sidebar') %>
    </div>
<%- include('../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../components/ui/breadcrumb', { items: [
        { label: t('myImages'), href: '/my-images' },
        { label: t('editImage') }
      ] }) %>

      <div class="al-page-header">
        <h1 class="al-page-title"><%= t('editImage') %></h1>
        <p class="al-page-desc"><%= image.name %> &mdash; <%= t('updateImageText') %></p>
      </div>

      <div class="al-page-body">
        <div class="rounded-xl p-6 shadow-lg border" style="background:var(--theme-bg-card);border-color:var(--theme-border)">
          <form id="imageEditForm" class="flex flex-col gap-4">
            <div class="grid grid-cols-2 gap-3">
              <div class="col-span-2"><label class="al-label"><%= t('name') %> <span style="color:var(--theme-danger)">*</span></label><input class="al-input" type="text" name="name" required value="<%= image.name || '' %>"></div>
              <div><label class="al-label"><%= t('author') %></label><input class="al-input" type="text" name="author" value="<%= image.author || '' %>"></div>
              <div><label class="al-label"><%= t('authorName') %></label><input class="al-input" type="text" name="authorName" value="<%= image.authorName || '' %>"></div>
              <div class="col-span-2"><label class="al-label"><%= t('startupCommand') %> <span style="color:var(--theme-danger)">*</span></label><input class="al-input" type="text" name="startup" required value="<%= image.startup || '' %>" style="font-family:ui-monospace,monospace;font-size:12px;"></div>
              <div class="col-span-2"><label class="al-label"><%= t('dockerImagesLabel') %> <span style="color:var(--theme-danger)">*</span></label><input class="al-input" type="text" name="dockerImages" required value="<%= image.dockerImages || '[]' %>" style="font-family:ui-monospace,monospace;font-size:12px;"></div>
              <div class="col-span-2"><label class="al-label"><%= t('description') %></label><textarea class="al-input" name="description" rows="2" style="resize:none;"><%= image.description || '' %></textarea></div>
              <div class="col-span-2"><label class="al-label"><%= t('variablesLabel') %> <span class="font-normal" style="color:var(--theme-text-muted)"><%= t('variablesHint') %></span></label><textarea class="al-input" name="variables" rows="4" style="resize:none;font-family:ui-monospace,monospace;font-size:12px;"><%= image.variables || '[]' %></textarea></div>
            </div>
            <div class="flex gap-2 pt-1">
              <a href="/my-images" class="flex-1 py-2 rounded-xl border text-sm font-medium hover:bg-[var(--theme-bg-hover)] transition inline-flex items-center justify-center gap-1.5" style="border-color:var(--theme-border);color:var(--theme-text)"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('cancel') %></a>
              <button type="submit" class="flex-1 py-2 rounded-xl border hover:bg-[var(--theme-bg-hover)] text-sm font-medium shadow-lg transition inline-flex items-center justify-center gap-1.5" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)"><%- icon('send', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('resubmitForReview') %></button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<div id="page-data" style="display:none"
  data-image-id="<%= image.id %>"
  data-state="<%= image.status === 'approved' ? 'published' : 'pending' %>"
  data-updated="<%= t('imageUpdated') %>"
  data-submit-error="<%= t('failedToSubmitImage') %>"
></div>

<%- include('../components/footer') %>