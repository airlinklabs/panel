<%- include('../components/header', { title: 'Two-Factor Authentication' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../components/sidebar') %>
    </div>
<%- include('../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../components/ui/breadcrumb', { items: [
        { label: 'Account', href: '/account' },
        { label: 'Two-Factor Authentication' }
      ] }) %>

      <div class="al-page-header mb-5">
        <% if (required) { %>
          <div class="mb-4 rounded-lg border px-4 py-3 text-sm" style="border-color:color-mix(in srgb, var(--theme-warning) 40%, transparent);background:color-mix(in srgb, var(--theme-warning) 10%, transparent)" style="color:var(--theme-text-strong)">
            <strong>Two-factor authentication is required</strong> to access the admin panel. Enable it now to continue.
          </div>
        <% } %>
        <div class="flex items-center gap-4">
          <div class="shrink-0">
            <%- icon('shield', { class: 'w-5 h-5', strokeWidth: 1.5 }) %>
          </div>
          <div>
            <h1 class="al-page-title">Set up two-factor authentication</h1>
            <p class="al-page-desc">Scan the QR code with an authenticator app, then confirm with a code.</p>
          </div>
        </div>
      </div>

      <div class="al-page-body">
        <div id="two-factor-setup-form-card" class="al-card p-6 sm:p-8 max-w-xl mx-auto">
          <ol class="flex items-center gap-2 text-xs font-medium mb-8">
            <li class="flex items-center gap-2" style="color:var(--theme-accent)">
              <span class="flex h-5 w-5 items-center justify-center rounded-full text-[10px] font-bold" style="background:var(--theme-accent);color:var(--theme-accent-text)">1</span>
              Scan QR code
            </li>
            <li class="h-px flex-1" style="background:var(--theme-border)"></li>
            <li class="flex items-center gap-2" style="color:var(--theme-text-muted)">
              <span class="flex h-5 w-5 items-center justify-center rounded-full text-[10px] font-bold border" style="background:var(--theme-bg-secondary);border-color:var(--theme-border);color:var(--theme-text-muted)">2</span>
              Enter code
            </li>
          </ol>

          <div class="flex flex-col items-center mb-7">
            <div class="rounded-2xl border p-1.5" style="border-color:var(--theme-border);background:var(--theme-bg-card)">
              <img src="<%= qrDataUrl %>" alt="QR code" class="h-48 w-48" width="220" height="220">
            </div>
            <p class="text-sm mt-4 mb-2" style="color:var(--theme-text-muted)">Can't scan? Enter this key manually in your authenticator app:</p>
            <div class="flex items-center gap-2 w-full max-w-xs">
              <code class="select-all flex-1 truncate rounded-lg px-3 py-2 text-sm font-mono text-center" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong)"><%= secretBase32 %></code>
              <button type="button" id="copySecret" class="al-btn-ghost shrink-0" aria-label="Copy secret key"
                @click="navigator.clipboard.writeText('<%= secretBase32 %>').then(function () { if (window.showToast) showToast('Secret key copied to clipboard.', 'success'); }).catch(function () { if (window.showToast) showToast('Could not copy secret key.', 'error'); })">
                <%- icon('copy', { size: 14 }) %>
              </button>
            </div>
          </div>

          <div id="two-factor-setup-status"></div>

          <form id="enable2faForm" novalidate
            hx-post="/api/v2/account/2fa/enable"
            hx-target="#two-factor-setup-status"
            hx-swap="innerHTML"
            hx-disabled-elt="find button[type='submit']"
            hx-indicator="#enable-form-status">
            <%- include('../components/csrf') %>
            <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)">6-digit code from your app</label>
            <div class="flex gap-2">
              <input id="totpToken" name="token" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" autofocus placeholder="••••••" class="al-input flex-1 text-center font-mono text-lg tracking-[0.4em]">
              <button id="enableBtn" type="submit" class="al-btn-primary px-5"><%- icon('shield', { class: 'size-4', strokeWidth: 1.5 }) %>Enable 2FA</button>
            </div>
            <p id="enable-form-status" class="htmx-indicator text-sm mt-2" aria-live="polite" style="color:var(--theme-text-muted)">Enabling…</p>
          </form>

          <div class="mt-7 pt-4 text-xs" style="border-top:1px solid var(--theme-border); color:var(--theme-text-muted)">
            <p class="flex items-center gap-1.5">
              <%- icon('shield-check', { class: 'w-3.5 h-3.5 shrink-0' }) %>
              Once enabled, you will be asked for a code from your authenticator app every time you sign in.
            </p>
            <p class="mt-1.5">Supported apps: Google Authenticator, Authy, 1Password, Bitwarden and other TOTP-compatible apps.</p>
          </div>
        </div>

        <!-- Passkey registration -->
        <div id="passkey-setup-card" class="al-card p-6 sm:p-8 max-w-xl mx-auto mt-6">
          <h3 class="text-sm font-semibold mb-3" style="color:var(--theme-text-strong)">Passkey (Face ID / Fingerprint / Security Key)</h3>
          <p class="text-sm mb-4" style="color:var(--theme-text-muted)">Register a passkey for passwordless 2FA verification.</p>

          <div id="passkey-setup-status"></div>

          <div class="flex gap-2 mb-4">
            <input id="passkeyDeviceName" type="text" placeholder="Device name (optional)" class="al-input flex-1">
            <button type="button" id="registerPasskeyBtn" class="al-btn-primary">
              <%- icon('key', { class: 'size-4', strokeWidth: 1.5 }) %>Register passkey
            </button>
          </div>

          <div id="passkey-list" class="mt-4" style="display:none">
            <h4 class="text-xs font-medium mb-2" style="color:var(--theme-text-muted)">Registered passkeys</h4>
            <div id="passkey-items" class="space-y-2"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<script type="module" nonce="<%- nonce %>">
  import { startRegistration } from '/vendor/@simplewebauthn/browser/esm/index.js';

  (async function () {
    var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    var statusEl = document.getElementById('passkey-setup-status');
    var regBtn = document.getElementById('registerPasskeyBtn');
    var listEl = document.getElementById('passkey-list');
    var itemsEl = document.getElementById('passkey-items');
    var nameInput = document.getElementById('passkeyDeviceName');

    async function loadPasskeys() {
      try {
        var res = await fetch('/api/v2/account/passkey/list', {
          headers: { 'csrf-token': csrfToken }
        });
        if (!res.ok) return;
        var data = await res.json();
        var passkeys = data.passkeys || [];
        if (passkeys.length === 0) {
          listEl.style.display = 'none';
          return;
        }
        listEl.style.display = '';
        itemsEl.innerHTML = '';
        passkeys.forEach(function (pk) {
          var row = document.createElement('div');
          row.className = 'flex items-center justify-between rounded-lg px-3 py-2';
          row.style.background = 'var(--theme-bg-secondary)';
          row.innerHTML =
            '<div class="min-w-0 flex-1">' +
              '<p class="text-sm font-medium truncate" style="color:var(--theme-text-strong)">' + (pk.name || 'Unnamed passkey') + '</p>' +
              '<p class="text-xs" style="color:var(--theme-text-muted)">Added ' + new Date(pk.createdAt).toLocaleDateString() + '</p>' +
            '</div>' +
            '<button type="button" class="al-btn-ghost text-xs px-2 py-1" data-delete-passkey="' + pk.id + '">' +
              '<%- icon("trash-2", { class: "size-3.5" }) %>' +
            '</button>';
          itemsEl.appendChild(row);
        });
        itemsEl.querySelectorAll('[data-delete-passkey]').forEach(function (delBtn) {
          delBtn.addEventListener('click', async function () {
            if (!confirm('Delete this passkey?')) return;
            try {
              var r = await fetch('/api/v2/account/passkey/' + delBtn.dataset.deletePasskey, {
                method: 'DELETE',
                headers: { 'csrf-token': csrfToken }
              });
              if (r.ok) {
                if (window.showToast) showToast('Passkey removed.', 'success');
                loadPasskeys();
              } else {
                var e = await r.json().catch(function () { return {}; });
                if (window.showToast) showToast(e.error || 'Failed to delete passkey.', 'error');
              }
            } catch (err) {
              if (window.showToast) showToast('Something went wrong.', 'error');
            }
          });
        });
      } catch (err) {
        // ignore
      }
    }

    regBtn.addEventListener('click', async function () {
      regBtn.disabled = true;
      statusEl.innerHTML = '';

      try {
        var optRes = await fetch('/api/v2/account/passkey/register/options', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'csrf-token': csrfToken }
        });
        if (!optRes.ok) {
          var errData = await optRes.json().catch(function () { return {}; });
          throw new Error(errData.error || 'Failed to get registration options');
        }
        var options = await optRes.json();

        var credential = await startRegistration({ optionsJSON: options });

        var deviceName = nameInput.value.trim() || '';
        var verifyRes = await fetch('/api/v2/account/passkey/register/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'csrf-token': csrfToken },
          body: JSON.stringify({ credential: credential, deviceName: deviceName })
        });
        var verifyData = await verifyRes.json();
        if (verifyRes.ok && verifyData.success) {
          if (window.showToast) showToast('Passkey registered.', 'success');
          nameInput.value = '';
          loadPasskeys();
        } else {
          throw new Error(verifyData.error || 'Passkey registration failed');
        }
      } catch (err) {
        statusEl.innerHTML = '<div class="rounded-xl px-4 py-3 mb-3" style="background:var(--theme-danger-bg);border:1px solid var(--theme-danger)"><p class="text-sm font-medium" style="color:var(--theme-danger)">' + (err.message || 'Failed to register passkey') + '</p></div>';
      } finally {
        regBtn.disabled = false;
      }
    });

    loadPasskeys();
  })();
</script>

<%- include('../components/footer') %>
