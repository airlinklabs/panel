<%- include('../components/header', { title: 'Servers' }) %>

<style>
  ::-webkit-scrollbar { display: none; }
  @keyframes al-view-in { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }
  .vt-active { background: var(--theme-bg-input); color: var(--theme-text-strong); box-shadow: 0 1px 3px var(--theme-border-subtle); }
  .fc-fc-drag-over { border-color: var(--theme-warning) !important; background: var(--theme-warning-bg) !important; box-shadow: 0 0 0 2px var(--theme-warning-bg) !important; }
  .sc-dragging { opacity: 0.4; transform: scale(0.97); box-shadow: none !important; }
  .ov-open { opacity: 1 !important; pointer-events: auto !important; }
  .pop-transform { transform: scale(1); opacity: 1; }
</style>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="hidden lg:block w-60 h-full"><%- include('../components/template') %></div>

    <div id="page-content" class="flex-1 overflow-y-auto pt-16">
      <%- include('../components/ui/breadcrumb', { items: [
        { label: 'Servers' }
      ] }) %>
      <div class="px-4 sm:px-8 pt-6 pb-8">

        <!-- Header -->
        <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
          <div>
            <h1 class="al-page-title"><%= req.translations.userDashboardTitle %></h1>
            <p class="al-page-desc"><%= req.translations.userDashboardText %></p>
          </div>
          <div class="flex items-center gap-2">
            <% if (canCreateServer) { %>
            <a href="/create-server" class="al-btn-primary">
              <%- icon('plus', { class: 'h-4 w-4' }) %>
              New server
            </a>
            <% } %>
            <button type="button" id="newFolderBtn" class="al-btn-secondary">
              <%- icon('folder-plus', { class: 'h-4 w-4', strokeWidth: 1.5 }) %>
              New folder
            </button>
            <% if (servers && servers.length > 0) { %>
            <div class="flex items-center gap-1 p-1 rounded-xl" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">
              <button type="button" id="gridViewBtn" class="vt-active min-h-9 px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5 transition-colors" style="color:var(--theme-text-muted);" aria-pressed="true">
                <%- icon('grid-2x2', { class: 'h-4 w-4' }) %>
                Grid
              </button>
              <button type="button" id="listViewBtn" class="min-h-9 px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5 transition-colors" style="color:var(--theme-text-muted);" aria-pressed="false">
                <%- icon('list', { class: 'h-4 w-4' }) %>
                List
              </button>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Alerts -->
        <% if (req.query.err === 'NOTACTIVEYET') { %>
        <%- include('../components/ui/alert', { type: 'warning', message: req.translations.awaitingInstallation || "Server is installing", detail: req.translations.awaitingInstallationDesc || "This server is not ready yet. It will be available once installation completes." }) %>
        <% } %>
        <% if (req.query.err === 'SERVER_LIMIT_REACHED') { %>
        <%- include('../components/ui/alert', { type: 'warning', message: "Server limit reached", detail: 'You have reached the maximum number of servers allowed. Contact your admin to increase your limit.' }) %>
        <% } %>
        <% if (typeof daemonOffline !== 'undefined' && daemonOffline) { %>
        <div class="al-alert-danger mb-5">
          <%- icon('triangle-alert', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
          <div class="flex-1">
            <p class="font-medium"><%= req.translations.connectionError || 'Connection Error' %></p>
            <p class="text-xs opacity-70 mt-0.5"><%= req.translations.connectionErrorDesc || 'One or more nodes are offline.' %></p>
          </div>
          <button type="button" onclick="window.location.reload()" class="shrink-0 px-3 py-1 text-xs rounded-lg transition-colors" style="background:var(--theme-danger-bg); color:var(--theme-danger);"><%= req.translations.retry || 'Retry' %></button>
        </div>
        <% } %>

        <% if (servers.length === 0 && (!folders || folders.length === 0)) { %>
        <%- include('../components/ui/empty-state', {
          iconName: 'server',
          title: req.translations.noServersYet || 'No servers yet',
          description: user.isAdmin ? 'Create your first server to get started.' : (canCreateServer ? 'Create your first server or ask an admin to assign one.' : 'An admin will assign one to you.'),
          action: user.isAdmin ? '<a href="/admin/servers/create" class="al-btn-primary"><span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> Create server</span></a>' : (canCreateServer ? '<a href="/create-server" class="al-btn-primary"><span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> Create server</span></a>' : '')
        }) %>
        <% } else { %>

        <!-- ── Folders ──────────────────────────────────────── -->
        <% if (folders && folders.length > 0) { %>
        <div class="mb-8">
          <p class="al-section-label">Folders</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3" id="folderGrid">
            <% let folderIdx = 0; folders.forEach(folder => { %>
            <div class="al-card flex items-center gap-3 cursor-pointer relative transition-[background,border-color,box-shadow] select-none hover:border-[var(--theme-border-accent)] group folder-card"
              role="button"
              tabindex="0"
              aria-label="Open folder <%= folder.name %>"
              style="--i:<%= folderIdx++ %>"
              data-folder-id="<%= folder.id %>"
              data-folder-name="<%= folder.name %>"
              data-folder-members='<%= JSON.stringify(folder.members.map(m => m.serverUUID)) %>'>
              <%- icon('folder', { class: 'h-5 w-5 shrink-0', style: 'color:var(--theme-warning);', fill: 'currentColor' }) %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong);"><%= folder.name %></p>
                <p class="text-xs mt-0.5" style="color:var(--theme-text-muted);"><%= folder.members.length %> server<%= folder.members.length !== 1 ? 's' : '' %></p>
              </div>
              <button type="button" class="folder-menu-btn al-btn-ghost shrink-0 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100 sm:group-focus-visible:opacity-100 transition-opacity"
                data-folder-id="<%= folder.id %>" aria-label="Folder options">
                <%- icon('more-horizontal', { class: 'w-4 h-4' }) %>
              </button>
            </div>
            <% }); %>
          </div>
          <p class="text-xs mt-2" style="color:var(--theme-text-muted);">Drag a server card onto a folder to add it</p>
        </div>
        <% } %>

        <!-- ── Servers header ───────────────────────────────── -->
        <p class="al-section-label">Servers</p>

        <!-- Grid view -->
        <div id="gridView" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
          <% let serverIdx = 0; servers.forEach(server => { %>
          <%
            const inFolder = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID));
            if (inFolder) return;
          %>
          <div class="al-server-card group relative block al-card cursor-grab hover:border-[var(--theme-border-accent)] hover:shadow-md transition-[box-shadow,transform,border-color] duration-150 active:cursor-grabbing"
            data-server-uuid="<%= server.UUID %>"
            data-server-name="<%= server.name %>"
            style="--i:<%= serverIdx++ %>"
            draggable="true">
            <a href="../server/<%= server.UUID %>" class="block">
              <div class="flex items-start justify-between mb-3">
                <div class="min-w-0 flex-1 mr-3">
                  <h3 class="text-sm font-medium truncate" style="color:var(--theme-text-strong);"><%= server.name %>
                    <% if (server.shared) { %>
                    <span class="al-badge-neutral align-middle ml-1"><%- icon('users', { class: 'w-2.5 h-2.5' }) %> Shared</span>
                    <% } %>
                  </h3>
                  <% if (server.description) { %>
                    <p class="text-xs mt-0.5 truncate" style="color:var(--theme-text-muted);"><%= server.description %></p>
                  <% } else { %>
                    <p class="text-xs mt-0.5 truncate italic" style="color:var(--theme-text-placeholder);"><%= req.translations.noDescription || 'No description' %></p>
                  <% } %>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="al-live-indicator hidden" aria-hidden="true"><span class="al-dot-online"></span>Live</span>
                  <%- include('../components/ui/status-badge', { status: server.status === 'running' ? 'online' : 'offline' }) %>
                </div>
              </div>
              <div class="flex gap-3 mb-3">
                <div class="flex-1 rounded-lg px-3 py-2" style="background:var(--theme-bg-secondary);">
                  <p class="text-[10px] mb-0.5" style="color:var(--theme-text-muted);">RAM</p>
                  <p class="text-sm font-medium" style="color:var(--theme-text);"><%= Math.round(server.ramUsage) %>%</p>
                </div>
                <div class="flex-1 rounded-lg px-3 py-2" style="background:var(--theme-bg-secondary);">
                  <p class="text-[10px] mb-0.5" style="color:var(--theme-text-muted);">CPU</p>
                  <p class="text-sm font-medium" style="color:var(--theme-text);"><%= Math.round(server.cpuUsage) %>%</p>
                </div>
                <div class="flex-1 rounded-lg px-3 py-2" style="background:var(--theme-bg-secondary);">
                  <p class="text-[10px] mb-0.5" style="color:var(--theme-text-muted);">Storage</p>
                  <p class="text-sm font-medium" style="color:var(--theme-text);"><%= server.Storage === 0 ? 'Unlimited' : (server.Storage >= 1024 ? (server.Storage / 1024).toFixed(1) + ' GB' : server.Storage + ' MB') %></p>
                </div>
              </div>
              <div class="flex items-center justify-between pt-2 border-t" style="border-color:var(--theme-border);">
                <div class="flex items-center gap-1.5 min-w-0">
                  <img loading="lazy" class="h-4 w-4 rounded-full shrink-0" src="<%= server.owner && server.owner.avatar ? server.owner.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(server.owner ? server.owner.username : 'unknown') %>" alt="<%= server.owner ? server.owner.username : 'Unknown' %>">
                  <span class="text-xs truncate" style="color:var(--theme-text-muted);"><%= server.owner ? server.owner.username : 'Unknown' %></span>
                </div>
                <% if (server.node) { %>
                <span class="text-xs shrink-0 ml-2 truncate max-w-[6rem]" style="color:var(--theme-text-placeholder);"><%= server.node.name || server.node.address %></span>
                <% } %>
              </div>
            </a>
            <!-- Right-click context menu -->
            <div class="server-ctx-menu hidden absolute z-40 top-2 right-2 rounded-xl shadow-lg py-1 w-44" role="menu" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
              <button type="button" role="menuitem" class="ctx-add-to-folder w-full text-left px-3 py-2 text-sm rounded-t-xl transition" style="color:var(--theme-text);" data-uuid="<%= server.UUID %>" aria-label="Add to folder">Add to folder</button>
              <button type="button" role="menuitem" class="ctx-remove-from-folder w-full text-left px-3 py-2 text-sm rounded-b-xl transition" style="color:var(--theme-text); display:<%= (folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID))) ? '' : 'none' %>" data-uuid="<%= server.UUID %>" aria-label="Remove from folder">Remove from folder</button>
            </div>
          </div>
          <% }); %>
        </div>

        <!-- List view -->
        <div id="listView" class="rounded-xl overflow-hidden shadow-sm hidden mb-6" style="border:1px solid var(--theme-border);">
          <table class="al-table">
            <thead class="al-table-head">
              <tr>
                <th class="al-table-th pl-6">Server</th>
                <th class="al-table-th">Status</th>
                <th class="al-table-th">Owner</th>
                <th class="al-table-th">RAM</th>
                <th class="al-table-th">CPU</th>
              </tr>
            </thead>
            <tbody style="border-color:var(--theme-border);">
              <% let listIdx = 0; servers.forEach(server => { %>
              <% const inFolderL = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID)); if (inFolderL) return; %>
              <tr style="--i:<%= listIdx++ %>; border-color:var(--theme-border);" data-server-uuid="<%= server.UUID %>" data-href="../server/<%= server.UUID %>" role="link" tabindex="0" class="al-table-tr cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset">
                <td class="al-table-td pl-6">
                  <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong);"><%= server.name %>
                    <% if (server.shared) { %>
                    <span class="al-badge-neutral align-middle ml-1"><%- icon('users', { class: 'w-2.5 h-2.5' }) %> Shared</span>
                    <% } %>
                  </p>
                  <% if (server.description) { %><p class="text-xs truncate max-w-xs" style="color:var(--theme-text-muted);"><%= server.description %></p><% } %>
                </td>
                <td class="al-table-td">
                <div class="flex items-center gap-2 shrink-0">
                  <span class="al-live-indicator hidden" aria-hidden="true"><span class="al-dot-online"></span>Live</span>
                  <%- include('../components/ui/status-badge', { status: server.status === 'running' ? 'online' : 'offline' }) %>
                </div>
                </td>
                <td class="al-table-td"><%= server.owner ? server.owner.username : 'Unknown' %></td>
                <td class="al-table-td"><%= Math.round(server.ramUsage) %>%</td>
                <td class="al-table-td"><%= Math.round(server.cpuUsage) %>%</td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (totalPages > 1) { %>
        <div class="flex items-center justify-center gap-3 mt-2">
          <% if (currentPage > 1) { %>
          <a href="/?page=<%= currentPage - 1 %>" class="al-btn-secondary"><%= req.translations.prev || 'Previous' %></a>
          <% } %>
          <span class="text-sm" style="color:var(--theme-text-muted);"><%= currentPage %> / <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
          <a href="/?page=<%= currentPage + 1 %>" class="al-btn-secondary"><%= req.translations.next || 'Next' %></a>
          <% } %>
        </div>
        <% } %>

        <% } %>
      </div>
    </div>
  </div>
</main>

<!-- Drag ghost element -->
<div id="drag-ghost" class="fixed z-[60] pointer-events-none rounded-xl px-3.5 py-2.5 text-[13px] font-medium shadow-[0_8px_24px_rgba(0,0,0,0.18)] flex items-center gap-2 opacity-95 max-w-[200px] whitespace-nowrap overflow-hidden text-ellipsis" style="display:none; transform:rotate(2deg); background:var(--theme-bg-card); border:1px solid var(--theme-border); color:var(--theme-text-strong);">
  <%- icon('folder', { class: 'w-3.5 h-3.5 shrink-0', style: 'color:var(--theme-warning);', fill: 'currentColor' }) %>
  <span id="drag-ghost-name"></span>
</div>

<!-- Folder popup -->
<div class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none data-[open]:opacity-100 data-[open]:pointer-events-auto" id="folderPopupOverlay">
    <div id="folderPopupPanel" class="al-sheet-panel border rounded-2xl w-full max-w-[440px] max-h-[80vh] flex flex-col overflow-hidden will-change-transform" role="dialog" aria-modal="true" aria-labelledby="folderPopupTitle" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <div class="flex items-center justify-between px-5 py-4 border-b flex-shrink-0" style="border-color:var(--theme-border);">
      <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong);" id="folderPopupTitle"></h2>
      <div class="flex items-center gap-1">
        <button type="button" id="deleteFolderBtn" class="w-10 h-10 flex items-center justify-center rounded-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500" style="color:var(--theme-danger);" title="Delete folder" aria-label="Delete folder">
          <%- icon('trash-2', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %>
        </button>
        <button type="button" id="closeFolderPopup" class="w-10 h-10 flex items-center justify-center rounded-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500" style="color:var(--theme-text-muted);" aria-label="Close folder">
          <%- icon('x', { class: 'w-4 h-4' }) %>
        </button>
      </div>
    </div>
    <div class="flex-1 overflow-y-auto p-4">
      <div id="folderPopupContent" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
    </div>
  </div>
</div>

<!-- New folder dialog -->
<div class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none data-[open]:opacity-100 data-[open]:pointer-events-auto" id="newFolderOverlay">
    <div id="newFolderPanel" class="al-sheet-panel border rounded-[14px] w-full max-w-[380px] p-[22px] will-change-transform" role="dialog" aria-modal="true" aria-labelledby="newFolderTitle" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <p id="newFolderTitle" class="text-sm font-semibold mb-1" style="color:var(--theme-text-strong);">New folder</p>
    <p class="text-xs mb-4" style="color:var(--theme-text-muted);">Give your folder a name. Drag server cards onto it to add servers.</p>
    <label for="newFolderName" class="sr-only">Folder name</label>
    <input id="newFolderName" type="text" class="al-input mb-4" placeholder="e.g. Game Servers">
    <div class="flex gap-2 justify-end">
      <button type="button" id="cancelNewFolder" class="al-btn-secondary">Cancel</button>
      <button type="button" id="confirmNewFolder" class="al-btn-primary">Create</button>
    </div>
  </div>
</div>

<!-- Delete folder confirm dialog -->
<div class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none data-[open]:opacity-100 data-[open]:pointer-events-auto" id="deleteFolderOverlay">
    <div id="deleteFolderPanel" class="al-sheet-panel border rounded-[14px] w-full max-w-[380px] p-[22px] will-change-transform" role="dialog" aria-modal="true" aria-labelledby="deleteFolderTitle" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <p id="deleteFolderTitle" class="text-sm font-semibold mb-1" style="color:var(--theme-text-strong);">Delete folder?</p>
    <p class="text-xs mb-4" style="color:var(--theme-text-muted);">Servers inside will stay accessible. They just won't be in this folder.</p>
    <div class="flex gap-2 justify-end">
      <button type="button" id="cancelDeleteFolder" class="al-btn-secondary">Cancel</button>
      <button type="button" id="confirmDeleteFolder" class="al-btn-danger">Delete folder</button>
    </div>
  </div>
</div>

<%- include('../components/toast') %>

<div id="dashboard-data" class="hidden"></div>
<script nonce="<%- nonce %>">
  document.getElementById('dashboard-data').dataset.folders = '<%- JSON.stringify(folders || []).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/</g, '\\x3c').replace(/>/g, '\\x3e') %>';
  document.getElementById('dashboard-data').dataset.servers = '<%- JSON.stringify((allServers || []).map(s => ({ UUID: s.UUID, name: s.name, status: s.status, ramUsage: s.ramUsage, cpuUsage: s.cpuUsage }))).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/</g, '\\x3c').replace(/>/g, '\\x3e') %>';
</script>

<script nonce="<%- nonce %>" src="/javascript/user/dashboard.js"></script>

<%- include('../components/footer') %>
