<script nonce="<%- nonce %>" src="/js/core/filter-sort.js"></script>
<script nonce="<%- nonce %>" src="/js/user/dashboard.js"></script>

<script nonce="<%- nonce %>">
(function() {
  const gridView = document.getElementById('gridView');
  const listView = document.getElementById('listView');
  const searchInput = document.getElementById('serverSearch');
  const clearBtn = document.getElementById('clearSearch');
  const countEl = document.getElementById('filterCount');

  // Filter state
  let filterStatus = '';
  let sortField = '';
  let sortDir = 'asc';
  let searchQuery = '';

  function getItems() {
    const items = [];
    // Grid view cards
    gridView.querySelectorAll('[data-server-uuid]').forEach(el => {
      items.push({
        el,
        name: el.dataset.serverName || '',
        status: el.dataset.status || '',
        ram: parseFloat(el.dataset.ram) || 0,
        cpu: parseFloat(el.dataset.cpu) || 0,
      });
    });
    return items;
  }

  function applyFilters() {
    const items = getItems();
    let visible = 0;

    // Sort
    if (sortField) {
      items.sort((a, b) => {
        let va = a[sortField];
        let vb = b[sortField];
        if (sortField === 'status') {
          va = va === 'running' ? 0 : 1;
          vb = vb === 'running' ? 0 : 1;
        } else if (sortField === 'name') {
          va = va.toLowerCase();
          vb = vb.toLowerCase();
        }
        if (va < vb) return sortDir === 'asc' ? -1 : 1;
        if (va > vb) return sortDir === 'asc' ? 1 : -1;
        return 0;
      });
    }

    items.forEach((item, i) => {
      let show = true;
      if (filterStatus && item.status !== filterStatus) show = false;
      if (searchQuery && !item.name.toLowerCase().includes(searchQuery)) show = false;

      if (show) {
        item.el.style.display = '';
        item.el.style.setProperty('--i', i);
        visible++;
      } else {
        item.el.style.display = 'none';
      }
    });

    // Also handle list view rows
    const listRows = listView.querySelectorAll('tr[data-name]');
    listRows.forEach(row => {
      let show = true;
      const rowName = row.dataset.name || '';
      const rowStatus = row.dataset.status || '';
      if (filterStatus && rowStatus !== filterStatus) show = false;
      if (searchQuery && !rowName.toLowerCase().includes(searchQuery)) show = false;
      row.style.display = show ? '' : 'none';
    });

    if (countEl) {
      if (filterStatus || searchQuery) {
        countEl.textContent = visible + ' server' + (visible !== 1 ? 's' : '');
        countEl.classList.remove('hidden');
      } else {
        countEl.classList.add('hidden');
      }
    }

    // Show empty state if nothing visible
    const emptyState = document.getElementById('emptyFilterState');
    if (emptyState) {
      emptyState.classList.toggle('hidden', visible > 0);
    }
  }

  // Popover handling
  document.querySelectorAll('#filterBar [data-popover-trigger]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const popover = btn.parentElement.querySelector('[data-popover]');
      const wasHidden = popover.classList.contains('hidden');
      // Close all popovers
      document.querySelectorAll('#filterBar [data-popover]').forEach(p => p.classList.add('hidden'));
      if (wasHidden) popover.classList.remove('hidden');
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('#filterBar [data-popover]').forEach(p => p.classList.add('hidden'));
  });

  // Filter options
  document.querySelectorAll('.al-filter-opt').forEach(opt => {
    opt.addEventListener('click', () => {
      filterStatus = opt.dataset.filterVal || '';
      const label = document.querySelector('.filter-label');
      if (label) label.textContent = filterStatus ? (filterStatus === 'running' ? 'Running' : 'Stopped') : 'Status';
      applyFilters();
    });
  });

  // Sort options
  document.querySelectorAll('.al-sort-opt').forEach(opt => {
    opt.addEventListener('click', () => {
      sortField = opt.dataset.sortVal;
      sortDir = opt.dataset.sortDir || 'asc';
      const label = document.querySelector('.sort-label');
      if (label) label.textContent = opt.textContent.trim();
      applyFilters();
    });
  });

  // Search
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      clearBtn.classList.toggle('hidden', !searchQuery);
      applyFilters();
    });
  }
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      clearBtn.classList.add('hidden');
      applyFilters();
    });
  }
})();

// Lazy loading - progressive reveal for server lists
(function() {
  const gridView = document.getElementById('gridView');
  const listView = document.getElementById('listView');
  if (gridView) {
    const gridCards = gridView.querySelectorAll('[data-server-uuid]');
    if (gridCards.length > 12) {
      AlFilter.enableProgressiveReveal(gridView, { batchSize: 12, itemSelector: '[data-server-uuid]' });
    }
  }
  if (listView) {
    const listRows = listView.querySelectorAll('tr[data-name]');
    if (listRows.length > 25) {
      AlFilter.enableProgressiveReveal(listView, { batchSize: 25, itemSelector: 'tr[data-name]' });
    }
  }
})();
</script>

