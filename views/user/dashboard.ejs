<% if (isMobileViewport) { %>
<%- include('../components/header', { title: 'Servers' }) %>

<main id="page-content" class="">
  <%- include('../components/template') %>

  <div class="px-4 py-5">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="text-base font-medium text-neutral-800 dark:text-white"><%= req.translations.userDashboardTitle %></h1>
        <p class="text-xs text-neutral-500 mt-0.5"><%= req.translations.userDashboardText %></p>
      </div>
      <div class="flex items-center gap-2">
        <% if (servers && servers.length > 0) { %>
        <div id="viewToggle" class="flex items-center gap-0.5 bg-neutral-100 dark:bg-neutral-800/60 p-0.5 rounded-lg border border-neutral-200 dark:border-white/5">
          <button id="gridViewBtn" class="p-1.5 rounded-md text-neutral-500 dark:text-neutral-400 transition" aria-label="Grid view">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          </button>
          <button id="listViewBtn" class="p-1.5 rounded-md text-neutral-500 dark:text-neutral-400 transition" aria-label="List view">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
          </button>
        </div>
        <% } %>
        <% if (canCreateServer) { %>
        <a href="/create-server" class="flex items-center gap-1 px-3 py-1.5 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-xs font-medium transition active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
            <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
          </svg>
          New
        </a>
        <% } %>
      </div>
    </div>

    <% if (req.query.err === "NOTACTIVEYET") { %>
      <div class="data-animate-card rounded-xl bg-amber-50 dark:bg-amber-800/10 border border-amber-200 dark:border-amber-500/20 px-4 py-3 mb-4">
        <p class="text-sm font-medium text-amber-700 dark:text-amber-400"><%= req.translations.awaitingInstallation || "This server's still getting its act together. Check back in a moment." %></p>
        <p class="text-xs text-amber-600 dark:text-amber-400/60 mt-0.5"><%= req.translations.awaitingInstallationDesc || "The server isn't installed yet or is in a failed state." %></p>
      </div>
    <% } %>

    <% if (req.query.err === 'SERVER_LIMIT_REACHED') { %>
      <div class="data-animate-card rounded-xl bg-amber-50 dark:bg-amber-800/10 border border-amber-200 dark:border-amber-500/20 px-4 py-3 mb-4">
        <p class="text-sm font-medium text-amber-700 dark:text-amber-400">You've hit your server limit — talk to your admin if you need more room.</p>
        <p class="text-xs text-amber-600 dark:text-amber-400/60 mt-0.5">You have reached the maximum number of servers allowed.</p>
      </div>
    <% } %>

    <% if (typeof daemonOffline !== 'undefined' && daemonOffline) { %>
      <div class="data-animate-card rounded-xl bg-red-50 dark:bg-red-800/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-4">
        <p class="text-sm font-medium text-red-700 dark:text-red-400"><%= req.translations.connectionError || 'Connection Error' %></p>
        <p class="text-xs text-red-600 dark:text-red-400/60 mt-0.5"><%= req.translations.connectionErrorDesc || 'One or more nodes are offline.' %></p>
        <button onclick="window.location.reload()" class="mt-2 px-3 py-1 bg-red-600 text-white text-xs rounded-lg"><%= req.translations.retry || 'Retry' %></button>
      </div>
    <% } %>

    <!-- Folders -->
    <% if (folders && folders.length > 0) { %>
    <div class="mb-5">
      <div class="flex items-center justify-between mb-2.5">
        <p class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Folders</p>
        <button id="newFolderBtn" class="text-xs text-neutral-500">+ New folder</button>
      </div>
      <div class="grid grid-cols-2 gap-2.5">
        <% let mFolderIdx = 0; folders.forEach(folder => { %>
        <div class="data-animate-card folder-card flex items-center gap-2.5 bg-neutral-100 dark:bg-neutral-800/40 border border-neutral-200 dark:border-white/5 rounded-xl px-3 py-2.5 active:scale-[0.97] transition-transform"
          style="--i:<%= mFolderIdx++ %>"
          data-folder-id="<%= folder.id %>"
          data-folder-name="<%= folder.name %>"
          data-folder-members='<%= JSON.stringify(folder.members.map(m => m.serverUUID)) %>'>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-amber-500 shrink-0">
            <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.146V6a3 3 0 0 1 3-3h5.379a2.25 2.25 0 0 1 1.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 0 1 3 3v1.146A4.483 4.483 0 0 0 19.5 12h-15a4.483 4.483 0 0 0-3 1.146Z" />
          </svg>
          <div class="min-w-0">
            <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= folder.name %></p>
            <p class="text-[10px] text-neutral-500"><%= folder.members.length %> server<%= folder.members.length !== 1 ? 's' : '' %></p>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } else { %>
    <div class="flex items-center justify-between mb-3">
      <p class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Servers</p>
      <button id="newFolderBtn" class="text-xs text-neutral-500">+ New folder</button>
    </div>
    <% } %>

    <% if (servers.length === 0 && (!folders || folders.length === 0)) { %>
      <div class="flex flex-col items-center justify-center mt-32 text-center px-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-20 w-20 text-neutral-300 dark:text-neutral-600 mb-4">
          <path fill-rule="evenodd" d="M11.622 1.602a.75.75 0 0 1 .756 0l2.25 1.313a.75.75 0 0 1-.756 1.295L12 3.118 10.128 4.21a.75.75 0 1 1-.756-1.295l2.25-1.313ZM5.898 5.81a.75.75 0 0 1-.27 1.025l-1.14.665 1.14.665a.75.75 0 1 1-.756 1.295L3.75 8.806v.944a.75.75 0 0 1-1.5 0V7.5a.75.75 0 0 1 .372-.648l2.25-1.312a.75.75 0 0 1 1.026.27Zm12.204 0a.75.75 0 0 1 1.026-.27l2.25 1.312a.75.75 0 0 1 .372.648v2.25a.75.75 0 0 1-1.5 0v-.944l-1.122.654a.75.75 0 1 1-.756-1.295l1.14-.665-1.14-.665a.75.75 0 0 1-.27-1.025Zm-9 5.25a.75.75 0 0 1 1.026-.27L12 11.882l1.872-1.092a.75.75 0 1 1 .756 1.295l-1.878 1.096V15a.75.75 0 0 1-1.5 0v-1.82l-1.878-1.095a.75.75 0 0 1-.27-1.025Z" clip-rule="evenodd" />
        </svg>
        <h2 class="text-base font-medium text-neutral-800 dark:text-white"><%= req.translations.noServersYet || "It's quiet here — suspiciously quiet." %></h2>
        <p class="text-sm text-neutral-500 mt-1">
          <% if (user.isAdmin) { %>
            <a href="/admin/servers/create" class="text-blue-500"><%= req.translations.createOneNow || 'Create one now' %></a>
          <% } else if (canCreateServer) { %>
            <a href="/create-server" class="text-blue-500">Create your first server</a>
          <% } else { %>
            An admin will assign one to you.
          <% } %>
        </p>
      </div>
    <% } else { %>
      <!-- Grid view -->
      <div id="gridView" class="space-y-3">
        <% let mServerIdx = 0; servers.forEach(server => { %>
        <%
          const inFolder = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID));
          if (inFolder) return;
        %>
          <div class="data-animate-card server-card relative bg-neutral-50 dark:bg-neutral-800/20 rounded-xl border border-neutral-200 dark:border-white/5 p-4 select-none touch-none"
            data-server-uuid="<%= server.UUID %>"
            data-server-name="<%= server.name %>"
            style="--i:<%= mServerIdx++ %>;overscroll-behavior: none;">
            <a href="../server/<%= server.UUID %>" class="block pointer-events-auto">
              <div class="flex items-start justify-between mb-2.5">
                <div class="min-w-0 flex-1 mr-2">
                  <h3 class="text-sm font-medium text-neutral-900 dark:text-white truncate"><%= server.name %></h3>
                  <% if (server.description) { %>
                    <p class="text-xs text-neutral-500 dark:text-neutral-400 truncate mt-0.5"><%= server.description %></p>
                  <% } else { %>
                    <p class="text-xs text-neutral-400 italic truncate mt-0.5"><%= req.translations.noDescription || 'No description' %></p>
                  <% } %>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-medium rounded-md shrink-0
                    <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30' : 'bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-500/20' %>">
                  <span class="relative flex h-1.5 w-1.5">
                    <% if (server.status === 'running') { %>
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                    <% } else { %>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-rose-500"></span>
                    <% } %>
                  </span>
                  <%= server.status === 'running' ? 'Running' : 'Stopped' %>
                </span>
              </div>
              <div class="flex gap-2 mb-3">
                <div class="flex-1 bg-white dark:bg-neutral-700/30 rounded-lg px-3 py-2 border border-neutral-100 dark:border-transparent">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">RAM</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= server.ramUsage %>%</p>
                </div>
                <div class="flex-1 bg-white dark:bg-neutral-700/30 rounded-lg px-3 py-2 border border-neutral-100 dark:border-transparent">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">CPU</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= server.cpuUsage %>%</p>
                </div>
                <div class="flex-1 bg-white dark:bg-neutral-700/30 rounded-lg px-3 py-2 border border-neutral-100 dark:border-transparent">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">Used</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= server.ramUsed || '0MB' %></p>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <img class="h-4 w-4 rounded-full shrink-0" src="<%= server.owner && server.owner.avatar ? server.owner.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(server.owner ? server.owner.username : 'unknown') %>" alt="">
                <span class="text-xs text-neutral-500 dark:text-neutral-400 truncate flex-1"><%= server.owner ? server.owner.username : 'Unknown' %></span>
                <% if (server.node) { %>
                <span class="text-xs text-neutral-400 dark:text-neutral-500 shrink-0 truncate max-w-[6rem]"><%= server.node.name || server.node.address %></span>
                <% } %>
              </div>
            </a>
          </div>
        <% }); %>
      </div>

      <!-- List view -->
      <div id="listView" class="hidden space-y-1">
        <% let lServerIdx = 0; servers.forEach(server => { %>
        <%
          const inFolderL = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID));
          if (inFolderL) return;
        %>
          <a href="../server/<%= server.UUID %>" class="data-animate-card table-row-animate flex items-center gap-3 bg-white dark:bg-neutral-800/30 rounded-xl border border-neutral-200 dark:border-white/5 px-3 py-2.5 active:scale-[0.98] transition-transform"
            style="--i:<%= lServerIdx++ %>">
            <span class="relative flex h-2 w-2 shrink-0">
              <% if (server.status === 'running') { %>
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              <% } else { %>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
              <% } %>
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= server.name %></p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-xs text-neutral-500 dark:text-neutral-400"><%= server.ramUsage %>% RAM</span>
              <span class="text-[10px] font-medium px-1.5 py-0.5 rounded
                <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400' : 'bg-rose-50 dark:bg-rose-500/10 text-rose-500 dark:text-rose-400' %>">
                <%= server.status === 'running' ? 'On' : 'Off' %>
              </span>
            </div>
          </a>
        <% }); %>
      </div>

      <% if (totalPages > 1) { %>
        <div class="flex items-center justify-center gap-3 mt-6">
          <% if (currentPage > 1) { %>
            <a href="/?page=<%= currentPage - 1 %>" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg"><%= req.translations.prev || 'Prev' %></a>
          <% } %>
          <span class="text-sm text-neutral-500"><%= currentPage %> / <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a href="/?page=<%= currentPage + 1 %>" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg"><%= req.translations.next || 'Next' %></a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>
</main>

<!-- Folder popup -->
<div id="folderOverlay" class="hidden fixed inset-0 z-50 bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5 max-h-[70dvh] overflow-y-auto">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-base font-medium text-neutral-800 dark:text-white" id="folderOverlayTitle">Folder</h2>
      <div class="flex items-center gap-1">
        <button id="addServersToFolderBtnMobile" class="p-2 rounded-xl text-neutral-400 hover:bg-neutral-50 dark:hover:bg-neutral-700/40 transition active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </button>
        <button id="renameFolderBtnMobile" class="p-2 rounded-xl text-neutral-400 hover:bg-neutral-50 dark:hover:bg-neutral-700/40 transition active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/>
          </svg>
        </button>
        <button id="deleteFolderBtn" class="p-2 rounded-xl text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4">
            <path fill-rule="evenodd" d="M5 3.25V4H2.75a.75.75 0 0 0 0 1.5h.3l.815 8.15A1.5 1.5 0 0 0 5.357 15h5.285a1.5 1.5 0 0 0 1.493-1.35l.815-8.15h.3a.75.75 0 0 0 0-1.5H11v-.75A2.25 2.25 0 0 0 8.75 1h-1.5A2.25 2.25 0 0 0 5 3.25Zm2.25-.75a.75.75 0 0 0-.75.75V4h3v-.75a.75.75 0 0 0-.75-.75h-1.5ZM6.05 6a.75.75 0 0 1 .787.713l.275 5.5a.75.75 0 0 1-1.498.075l-.275-5.5A.75.75 0 0 1 6.05 6Zm3.9 0a.75.75 0 0 1 .712.787l-.275 5.5a.75.75 0 0 1-1.498-.075l.275-5.5a.75.75 0 0 1 .786-.711Z" clip-rule="evenodd"/>
          </svg>
        </button>
        <button id="closeFolderOverlay" class="text-neutral-400 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>
    <div id="folderOverlayContent" class="space-y-2"></div>
  </div>
</div>

<!-- New folder dialog -->
<div id="newFolderDialog" class="hidden fixed inset-0 z-50 bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5">
    <h2 class="text-base font-medium text-neutral-800 dark:text-white mb-4">New folder</h2>
    <input type="text" id="newFolderName" maxlength="64" placeholder="Folder name"
      class="w-full rounded-xl bg-neutral-100 dark:bg-neutral-700/50 border border-neutral-200 dark:border-neutral-600/30 px-4 py-3 text-sm text-neutral-800 dark:text-white placeholder-neutral-400 focus:outline-none mb-4">
    <div class="flex gap-2">
      <button id="cancelNewFolder" class="flex-1 py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700/30 rounded-xl transition">Cancel</button>
      <button id="confirmNewFolder" class="flex-1 py-2.5 text-sm font-medium text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-xl transition">Create</button>
    </div>
  </div>
</div>

<!-- Rename folder sheet -->
<div id="renameFolderSheet" class="hidden fixed inset-0 z-50 bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5">
    <p class="text-base font-medium text-neutral-800 dark:text-white mb-1">Rename folder</p>
    <input type="text" id="renameFolderNameMobile" maxlength="64" placeholder="Folder name"
      class="w-full rounded-xl bg-neutral-100 dark:bg-neutral-700/50 border border-neutral-200 dark:border-neutral-600/30 px-4 py-3 text-sm text-neutral-800 dark:text-white placeholder-neutral-400 focus:outline-none mb-4">
    <div class="flex gap-2">
      <button id="cancelRenameFolderMobile" class="flex-1 py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700/30 rounded-xl transition">Cancel</button>
      <button id="confirmRenameFolderMobile" class="flex-1 py-2.5 text-sm font-medium text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-xl transition">Rename</button>
    </div>
  </div>
</div>

<!-- Delete folder confirm sheet -->
<div id="deleteFolderSheet" class="hidden fixed inset-0 z-50 bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5">
    <p class="text-base font-medium text-neutral-800 dark:text-white mb-1">Delete folder?</p>
    <p class="text-sm text-neutral-500 mb-4">Servers inside stay accessible — they just won't be in this folder.</p>
    <div class="flex gap-2">
      <button id="cancelDeleteFolder" class="flex-1 py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700/30 rounded-xl transition">Cancel</button>
      <button id="confirmDeleteFolder" class="flex-1 py-2.5 text-sm font-medium text-white bg-red-600 rounded-xl transition active:scale-[0.98]">Delete</button>
    </div>
  </div>
</div>
<div id="addToFolderDialog" class="hidden fixed inset-0 z-50 bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5 max-h-[60dvh] overflow-y-auto">
    <h2 class="text-base font-medium text-neutral-800 dark:text-white mb-4">Move to folder</h2>
    <div id="folderPickList" class="space-y-2 mb-4"></div>
    <button id="cancelAddToFolder" class="w-full py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700/30 rounded-xl transition">Cancel</button>
  </div>
</div>

<!-- Long-press action sheet -->
<div id="longPressSheet" class="hidden fixed inset-0 z-50 bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5">
    <p class="text-sm font-medium text-neutral-800 dark:text-white mb-1" id="longPressServerName"></p>
    <p class="text-xs text-neutral-500 mb-4">Choose an action</p>
    <div class="space-y-2">
      <button id="lpMoveToFolder" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-700/30 border border-neutral-200 dark:border-white/5 text-sm text-neutral-800 dark:text-white text-left transition active:scale-[0.98]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-amber-500 shrink-0">
          <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.146V6a3 3 0 0 1 3-3h5.379a2.25 2.25 0 0 1 1.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 0 1 3 3v1.146A4.483 4.483 0 0 0 19.5 12h-15a4.483 4.483 0 0 0-3 1.146Z"/>
        </svg>
        Move to folder
      </button>
      <button id="lpRemoveFromFolder" class="hidden w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-700/30 border border-neutral-200 dark:border-white/5 text-sm text-neutral-800 dark:text-white text-left transition active:scale-[0.98]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-neutral-400 shrink-0">
          <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
        Remove from folder
      </button>
      <button id="lpCancel" class="w-full py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700/30 rounded-xl transition">Cancel</button>
    </div>
  </div>
</div>

<!-- Mobile add servers to folder -->
<div id="mobileAddServersSheet" class="hidden fixed inset-0 z-50 bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5 max-h-[70dvh] flex flex-col">
    <p class="text-base font-medium text-neutral-800 dark:text-white mb-1">Add servers to folder</p>
    <p class="text-xs text-neutral-500 mb-3">Toggle servers to add or remove.</p>
    <input type="text" id="mobileServerPickerSearch" placeholder="Search servers…"
      class="w-full rounded-xl bg-neutral-100 dark:bg-neutral-700/50 border border-neutral-200 dark:border-neutral-600/30 px-4 py-3 text-sm text-neutral-800 dark:text-white placeholder-neutral-400 focus:outline-none mb-3">
    <div id="mobileServerPickerList" class="flex-1 overflow-y-auto space-y-1.5 max-h-[50dvh]"></div>
    <button id="mobileCancelAddServers" class="w-full py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700/30 rounded-xl transition mt-3">Done</button>
  </div>
</div>

<style>
  body { overscroll-behavior: none; }
</style>

<div id="dashboard-data" class="hidden"></div>
<script nonce="<%- nonce %>">
  document.getElementById('dashboard-data').dataset.folders = '<%- JSON.stringify(folders || []).replace(/'/g, "\\'") %>';
  document.getElementById('dashboard-data').dataset.servers = '<%- JSON.stringify((allServers || []).map(s => ({ UUID: s.UUID, name: s.name, status: s.status }))).replace(/'/g, "\\'") %>';
</script>

<script nonce="<%- nonce %>" src="/js/user/dashboard-mobile.js"></script>

<%- include('../components/footer') %>

<% } else { %>
<%- include('../components/header', { title: 'Servers' }) %>

<style>
  ::-webkit-scrollbar { display: none; }
  @keyframes al-view-in { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }
  .vt-active { background: var(--theme-bg-input, white); color: var(--theme-text-strong, #171717); box-shadow: 0 1px 3px var(--theme-border-subtle, rgba(0,0,0,0.08)); }
  .dark .vt-active { background: var(--theme-bg-active-nav, rgba(255,255,255,0.08)); color: var(--theme-text-strong, white); }
  .fc-drag-over { border-color: var(--theme-warning, #f59e0b) !important; background: var(--theme-warning-bg, rgba(245,158,11,0.06)) !important; box-shadow: 0 0 0 2px var(--theme-warning-bg, rgba(245,158,11,0.25)) !important; }
  .dark .fc-drag-over { border-color: var(--theme-warning, #f59e0b) !important; background: var(--theme-warning-bg, rgba(245,158,11,0.08)) !important; }
  .sc-dragging { opacity: 0.4; transform: scale(0.97); box-shadow: none !important; }
  .ov-open { opacity: 1 !important; pointer-events: auto !important; }
  .pop-transform { transform: scale(1); opacity: 1; }
</style>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="w-60 h-full"><%- include('../components/template') %></div>

    <div id="page-content" class="flex-1 overflow-y-auto pt-16">
      <div class="px-12 pt-6 pb-8">

        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-base font-medium text-neutral-800 dark:text-white"><%= req.translations.userDashboardTitle %></h1>
            <p class="text-sm text-neutral-500 mt-0.5"><%= req.translations.userDashboardText %></p>
          </div>
          <div class="flex items-center gap-2">
            <% if (canCreateServer) { %>
            <a href="/create-server" class="flex min-h-10 items-center gap-1.5 px-3 py-2 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-sm font-medium hover:bg-neutral-700 dark:hover:bg-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-900 dark:focus-visible:ring-white focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950 transition">
              <%- icon('plus', { class: 'h-4 w-4' }) %>
              New server
            </a>
            <% } %>
            <button id="newFolderBtn" class="flex min-h-10 items-center gap-1.5 px-3 py-2 rounded-xl border border-neutral-200 dark:border-neutral-700 text-neutral-600 dark:text-neutral-300 text-sm font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950 transition">
              <%- icon('folder-plus', { class: 'h-4 w-4', strokeWidth: 1.5 }) %>
              New folder
            </button>
            <% if (servers && servers.length > 0) { %>
            <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800/60 p-1 rounded-xl border border-neutral-200 dark:border-white/5">
              <button id="gridViewBtn" class="vt-active min-h-9 px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5 text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 transition-colors">
                <%- icon('grid-2x2', { class: 'h-4 w-4' }) %>
                Grid
              </button>
              <button id="listViewBtn" class="min-h-9 px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5 text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 transition-colors">
                <%- icon('list', { class: 'h-4 w-4' }) %>
                List
              </button>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Alerts -->
        <% if (req.query.err === 'NOTACTIVEYET') { %>
        <div class="data-animate-card rounded-xl bg-amber-50 dark:bg-amber-800/10 border border-amber-200 dark:border-amber-500/20 px-4 py-3 mb-5">
          <p class="text-sm font-medium text-amber-700 dark:text-amber-400"><%= req.translations.awaitingInstallation || "This server's still getting its act together. Check back in a moment." %></p>
          <p class="text-xs text-amber-600 dark:text-amber-400/60 mt-0.5"><%= req.translations.awaitingInstallationDesc || "The server isn't installed yet or is in a failed state." %></p>
        </div>
        <% } %>
        <% if (req.query.err === 'SERVER_LIMIT_REACHED') { %>
        <div class="data-animate-card rounded-xl bg-amber-50 dark:bg-amber-800/10 border border-amber-200 dark:border-amber-500/20 px-4 py-3 mb-5">
          <p class="text-sm font-medium text-amber-700 dark:text-amber-400">You've hit your server limit — talk to your admin if you need more room.</p>
          <p class="text-xs text-amber-600 dark:text-amber-400/60 mt-0.5">You have reached the maximum number of servers allowed.</p>
        </div>
        <% } %>
        <% if (typeof daemonOffline !== 'undefined' && daemonOffline) { %>
        <div class="data-animate-card rounded-xl bg-red-50 dark:bg-red-800/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-5">
          <p class="text-sm font-medium text-red-700 dark:text-red-400"><%= req.translations.connectionError || 'Connection Error' %></p>
          <p class="text-xs text-red-600 dark:text-red-400/60 mt-0.5"><%= req.translations.connectionErrorDesc || 'One or more nodes are offline.' %></p>
          <button onclick="window.location.reload()" class="mt-2 px-3 py-1 bg-red-600 text-white text-xs rounded-lg transition-colors"><%= req.translations.retry || 'Retry' %></button>
        </div>
        <% } %>

        <!-- ── Filters ────────────────────────────────────────── -->
        <div id="filterBar" class="flex items-center gap-2 mb-5 flex-wrap">
          <div class="relative">
            <button data-popover-trigger class="al-filter-btn flex items-center gap-1.5 px-3 py-2 rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800 text-sm text-neutral-700 dark:text-neutral-300 hover:border-neutral-300 dark:hover:border-white/20 transition">
              <%- icon('filter', { class: 'h-3.5 w-3.5 text-neutral-400' }) %>
              <span class="filter-label">Status</span>
              <%- icon('chevron-down', { class: 'h-3 w-3 text-neutral-400' }) %>
            </button>
            <div data-popover class="hidden absolute left-0 mt-1.5 z-50 w-44 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-white/10 rounded-xl shadow-lg p-1.5">
              <button data-filter-val="" class="al-filter-opt w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-neutral-100 dark:hover:bg-white/5 text-neutral-700 dark:text-neutral-300 transition">All</button>
              <button data-filter-val="running" class="al-filter-opt w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-neutral-100 dark:hover:bg-white/5 text-emerald-600 dark:text-emerald-400 transition">Running</button>
              <button data-filter-val="stopped" class="al-filter-opt w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-neutral-100 dark:hover:bg-white/5 text-rose-600 dark:text-rose-400 transition">Stopped</button>
            </div>
          </div>
          <div class="relative">
            <button data-popover-trigger class="al-filter-btn flex items-center gap-1.5 px-3 py-2 rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800 text-sm text-neutral-700 dark:text-neutral-300 hover:border-neutral-300 dark:hover:border-white/20 transition">
              <%- icon('arrow-up-down', { class: 'h-3.5 w-3.5 text-neutral-400' }) %>
              <span class="sort-label">Sort</span>
              <%- icon('chevron-down', { class: 'h-3 w-3 text-neutral-400' }) %>
            </button>
            <div data-popover class="hidden absolute left-0 mt-1.5 z-50 w-48 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-white/10 rounded-xl shadow-lg p-1.5">
              <button data-sort-val="name" data-sort-dir="asc" class="al-sort-opt w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-neutral-100 dark:hover:bg-white/5 text-neutral-700 dark:text-neutral-300 transition">Name (A-Z)</button>
              <button data-sort-val="name" data-sort-dir="desc" class="al-sort-opt w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-neutral-100 dark:hover:bg-white/5 text-neutral-700 dark:text-neutral-300 transition">Name (Z-A)</button>
              <button data-sort-val="status" data-sort-dir="asc" class="al-sort-opt w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-neutral-100 dark:hover:bg-white/5 text-neutral-700 dark:text-neutral-300 transition">Status (Running first)</button>
              <button data-sort-val="ramUsage" data-sort-dir="desc" class="al-sort-opt w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-neutral-100 dark:hover:bg-white/5 text-neutral-700 dark:text-neutral-300 transition">RAM (Highest)</button>
              <button data-sort-val="cpuUsage" data-sort-dir="desc" class="al-sort-opt w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-neutral-100 dark:hover:bg-white/5 text-neutral-700 dark:text-neutral-300 transition">CPU (Highest)</button>
            </div>
          </div>
          <div class="relative flex-1 max-w-xs">
            <input type="text" id="serverSearch" placeholder="Search servers..."
              class="w-full pl-3 pr-8 py-2 rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800 text-sm text-neutral-800 dark:text-white placeholder-neutral-400 focus:outline-none focus:border-neutral-400 dark:focus:border-white/25 transition">
            <button id="clearSearch" class="hidden absolute right-2 top-1/2 -translate-y-1/2 p-1 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition">
              <%- icon('x', { class: 'h-3.5 w-3.5' }) %>
            </button>
          </div>
          <p id="filterCount" class="text-xs text-neutral-400 dark:text-neutral-500 hidden"></p>
        </div>

        <% if (servers.length === 0 && (!folders || folders.length === 0)) { %>
        <div class="flex flex-col items-center justify-center mt-32 text-center">
          <%- icon('server', { class: 'h-16 w-16 text-neutral-200 dark:text-neutral-700 mb-4' }) %>
          <h2 class="text-base font-medium text-neutral-800 dark:text-white"><%= req.translations.noServersYet || "It's quiet here — suspiciously quiet." %></h2>
          <p class="text-sm text-neutral-500 mt-1">
            <% if (user.isAdmin) { %><a href="/admin/servers/create" class="text-blue-500"><%= req.translations.createOneNow || 'Create one now' %></a>
            <% } else if (canCreateServer) { %><a href="/create-server" class="text-blue-500">Create your first server</a>
            <% } else { %>An admin will assign one to you.<% } %>
          </p>
        </div>
        <% } else { %>

        <!-- ── Folders ──────────────────────────────────────── -->
        <% if (folders && folders.length > 0) { %>
        <div class="mb-8">
          <p class="text-xs font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-3">Folders</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3" id="folderGrid">
            <% let folderIdx = 0; folders.forEach(folder => { %>
            <div class="data-animate-card folder-card flex items-center gap-3 bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/[0.07] rounded-xl px-3.5 py-3 cursor-pointer relative transition-[background,border-color,box-shadow] select-none hover:bg-neutral-100 dark:hover:bg-white/[0.06] hover:border-neutral-300 dark:hover:border-white/[0.12] hover:shadow-sm group"
              role="button"
              tabindex="0"
              aria-label="Open folder <%= folder.name %>"
              style="--i:<%= folderIdx++ %>"
              data-folder-id="<%= folder.id %>"
              data-folder-name="<%= folder.name %>"
              data-folder-members='<%= JSON.stringify(folder.members.map(m => m.serverUUID)) %>'>
              <%- icon('folder', { class: 'h-5 w-5 text-amber-500 shrink-0', fill: 'currentColor' }) %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= folder.name %></p>
                <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-0.5"><%= folder.members.length %> server<%= folder.members.length !== 1 ? 's' : '' %></p>
              </div>

            </div>
            <% }); %>
          </div>
          <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-2">Drag a server card onto a folder to add it</p>
        </div>
        <% } %>

        <!-- ── Servers header ───────────────────────────────── -->
        <p class="text-xs font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-3">Servers</p>

        <!-- Grid view -->
        <div id="gridView" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
          <% let serverIdx = 0; servers.forEach(server => { %>
          <%
            const inFolder = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID));
            if (inFolder) return;
          %>
          <div class="data-animate-card group relative block bg-white dark:bg-neutral-800/20 rounded-xl border border-neutral-200 dark:border-white/5 shadow-sm p-4 cursor-grab hover:border-neutral-300 dark:hover:border-white/10 hover:shadow-md dark:hover:shadow-none transition-[box-shadow,transform,border-color] duration-150 active:cursor-grabbing"
            data-server-uuid="<%= server.UUID %>"
            data-server-name="<%= server.name %>"
            data-status="<%= server.status %>"
            data-ram="<%= Math.round(server.ramUsage) %>"
            data-cpu="<%= Math.round(server.cpuUsage) %>"
            style="--i:<%= serverIdx++ %>"
            draggable="true">
            <a href="../server/<%= server.UUID %>" class="block">
              <div class="flex items-start justify-between mb-3">
                <div class="min-w-0 flex-1 mr-3">
                  <h3 class="text-sm font-medium text-neutral-900 dark:text-white truncate"><%= server.name %></h3>
                  <% if (server.description) { %>
                    <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 truncate"><%= server.description %></p>
                  <% } else { %>
                    <p class="text-xs text-neutral-400 mt-0.5 truncate italic"><%= req.translations.noDescription || 'No description' %></p>
                  <% } %>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-medium rounded-md shrink-0 <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30' : 'bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-500/20' %>">
                  <span class="relative flex h-1.5 w-1.5">
                    <% if (server.status === 'running') { %>
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                    <% } else { %>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-rose-500"></span>
                    <% } %>
                  </span>
                  <%= server.status === 'running' ? 'Running' : 'Stopped' %>
                </span>
              </div>
              <div class="flex gap-3 mb-3">
                <div class="flex-1 bg-neutral-100 dark:bg-neutral-700/30 rounded-lg px-3 py-2">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">RAM</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= Math.round(server.ramUsage) %>%</p>
                </div>
                <div class="flex-1 bg-neutral-100 dark:bg-neutral-700/30 rounded-lg px-3 py-2">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">CPU</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= Math.round(server.cpuUsage) %>%</p>
                </div>
                <div class="flex-1 bg-neutral-100 dark:bg-neutral-700/30 rounded-lg px-3 py-2">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">Used</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= server.ramUsed || '0MB' %></p>
                </div>
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-neutral-100 dark:border-white/5">
                <div class="flex items-center gap-1.5 min-w-0">
                  <img class="h-4 w-4 rounded-full shrink-0" src="<%= server.owner && server.owner.avatar ? server.owner.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(server.owner ? server.owner.username : 'unknown') %>" alt="">
                  <span class="text-xs text-neutral-500 dark:text-neutral-400 truncate"><%= server.owner ? server.owner.username : 'Unknown' %></span>
                </div>
                <% if (server.node) { %>
                <span class="text-xs text-neutral-400 dark:text-neutral-500 shrink-0 ml-2 truncate max-w-[6rem]"><%= server.node.name || server.node.address %></span>
                <% } %>
              </div>
            </a>
            <!-- Right-click context menu -->
            <div class="server-ctx-menu hidden absolute z-40 top-2 right-2 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-white/10 rounded-xl shadow-lg py-1 w-44">
              <button class="ctx-add-to-folder w-full text-left px-3 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/5 transition rounded-t-xl" data-uuid="<%= server.UUID %>">Add to folder</button>
              <button class="ctx-remove-from-folder w-full text-left px-3 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/5 transition rounded-b-xl" data-uuid="<%= server.UUID %>" style="display:<%= (folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID))) ? '' : 'none' %>">Remove from folder</button>
            </div>
          </div>
          <% }); %>
        </div>

        <!-- List view -->
        <div id="listView" class="rounded-xl border border-neutral-200 dark:border-white/5 overflow-hidden shadow-sm hidden mb-6">
          <table class="min-w-full divide-y divide-neutral-200 dark:divide-white/5">
            <thead class="bg-neutral-50 dark:bg-neutral-800/20">
              <tr>
                <th class="py-3 pl-6 pr-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">Server</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">Status</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">Owner</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">RAM</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">CPU</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100 dark:divide-white/5 bg-white dark:bg-transparent">
              <% let listIdx = 0; servers.forEach(server => { %>
              <% const inFolderL = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID)); if (inFolderL) return; %>
              <tr style="--i:<%= listIdx++ %>" data-href="../server/<%= server.UUID %>" data-name="<%= server.name %>" data-status="<%= server.status %>" data-ram="<%= Math.round(server.ramUsage) %>" data-cpu="<%= Math.round(server.cpuUsage) %>" role="link" tabindex="0" class="hover:bg-neutral-50 dark:hover:bg-white/5 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-neutral-500">
                <td class="py-3.5 pl-6 pr-3">
                  <p class="text-sm font-medium text-neutral-900 dark:text-white truncate"><%= server.name %></p>
                  <% if (server.description) { %><p class="text-xs text-neutral-500 dark:text-neutral-400 truncate max-w-xs"><%= server.description %></p><% } %>
                </td>
                <td class="px-3 py-3.5">
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-medium rounded-md <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30' : 'bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-500/20' %>">
                    <span class="relative flex h-1.5 w-1.5"><% if (server.status === 'running') { %><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span><% } else { %><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-rose-500"></span><% } %></span>
                    <%= server.status === 'running' ? 'Running' : 'Stopped' %>
                  </span>
                </td>
                <td class="px-3 py-3.5 text-sm text-neutral-600 dark:text-neutral-300"><%= server.owner ? server.owner.username : 'Unknown' %></td>
                <td class="px-3 py-3.5 text-sm text-neutral-600 dark:text-neutral-300"><%= Math.round(server.ramUsage) %>%</td>
                <td class="px-3 py-3.5 text-sm text-neutral-600 dark:text-neutral-300"><%= Math.round(server.cpuUsage) %>%</td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (totalPages > 1) { %>
        <div class="flex items-center justify-center gap-3 mt-2">
          <% if (currentPage > 1) { %>
          <a href="/?page=<%= currentPage - 1 %>" class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800/60 border border-neutral-200 dark:border-white/5 rounded-xl hover:bg-neutral-200 dark:hover:bg-neutral-700/60 transition"><%= req.translations.prev || 'Prev' %></a>
          <% } %>
          <span class="text-sm text-neutral-500"><%= currentPage %> / <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
          <a href="/?page=<%= currentPage + 1 %>" class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800/60 border border-neutral-200 dark:border-white/5 rounded-xl hover:bg-neutral-200 dark:hover:bg-neutral-700/60 transition"><%= req.translations.next || 'Next' %></a>
          <% } %>
        </div>
        <% } %>

        <!-- Empty filter state -->
        <div id="emptyFilterState" class="hidden flex flex-col items-center justify-center mt-16 text-center">
          <%- icon('search', { class: 'h-12 w-12 text-neutral-300 dark:text-neutral-600 mb-3' }) %>
          <p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">No servers match your filters</p>
          <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">Try adjusting your search or filter criteria</p>
        </div>

        <% } %>
      </div>
    </div>
  </div>
</main>

