<% if (isMobileViewport) { %>
<%- include('../components/header', { title: 'Servers' }) %>

<main id="page-content" class="">
  <%- include('../components/template') %>

  <div class="px-4 py-5">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h1 class="text-base font-medium text-neutral-800 dark:text-white"><%= req.translations.userDashboardTitle %></h1>
        <p class="text-xs text-neutral-500 mt-0.5"><%= req.translations.userDashboardText %></p>
      </div>
      <div class="flex items-center gap-2">
        <% if (servers && servers.length > 0) { %>
        <div id="viewToggle" class="flex items-center gap-0.5 bg-neutral-100 dark:bg-neutral-800/60 p-0.5 rounded-lg border border-neutral-200 dark:border-white/5">
          <button id="gridViewBtn" class="p-2.5 rounded-md text-neutral-500 dark:text-neutral-400 transition" aria-label="Grid view">
            <%- icon('grid-2x2', { size: 14 }) %>
          </button>
          <button id="listViewBtn" class="p-2.5 rounded-md text-neutral-500 dark:text-neutral-400 transition" aria-label="List view">
            <%- icon('list', { size: 14 }) %>
          </button>
        </div>
        <% } %>
        <% if (canCreateServer) { %>
        <a href="/create-server" class="flex items-center gap-1 px-3 py-1.5 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-xs font-medium transition active:scale-95">
          <%- icon('plus', { class: 'h-3.5 w-3.5' }) %>
          New
        </a>
        <% } %>
      </div>
    </div>

    <% if (req.query.err === "NOTACTIVEYET") { %>
      <div class="data-animate-card rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 px-4 py-3 mb-4">
        <p class="text-sm font-medium text-amber-700 dark:text-amber-400"><%= req.translations.awaitingInstallation || "This server's still getting its act together. Check back in a moment." %></p>
        <p class="text-xs text-amber-600 dark:text-amber-400/60 mt-0.5"><%= req.translations.awaitingInstallationDesc || "The server isn't installed yet or is in a failed state." %></p>
      </div>
    <% } %>

    <% if (req.query.err === 'SERVER_LIMIT_REACHED') { %>
      <div class="data-animate-card rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 px-4 py-3 mb-4">
        <p class="text-sm font-medium text-amber-700 dark:text-amber-400">You've hit your server limit — talk to your admin if you need more room.</p>
        <p class="text-xs text-amber-600 dark:text-amber-400/60 mt-0.5">You have reached the maximum number of servers allowed.</p>
      </div>
    <% } %>

    <% if (typeof daemonOffline !== 'undefined' && daemonOffline) { %>
      <div class="data-animate-card rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-4">
        <p class="text-sm font-medium text-red-700 dark:text-red-400"><%= req.translations.connectionError || 'Connection Error' %></p>
        <p class="text-xs text-red-600 dark:text-red-400/60 mt-0.5"><%= req.translations.connectionErrorDesc || 'One or more nodes are offline.' %></p>
        <button onclick="window.location.reload()" class="mt-3 px-3 py-1.5 bg-red-600 text-white text-xs font-medium rounded-lg transition hover:bg-red-700 active:scale-95"><%= req.translations.retry || 'Retry' %></button>
      </div>
    <% } %>

    <!-- Folders -->
    <% if (folders && folders.length > 0) { %>
    <div class="mb-5">
      <div class="flex items-center justify-between mb-2.5">
        <p class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Folders</p>
        <button id="newFolderBtn" class="text-xs text-neutral-500">+ New folder</button>
      </div>
      <div class="grid grid-cols-2 gap-2.5">
        <% let mFolderIdx = 0; folders.forEach(folder => { %>
        <div class="data-animate-card folder-card flex items-center gap-2.5 bg-neutral-100 dark:bg-neutral-800/40 border border-neutral-200 dark:border-white/5 rounded-xl px-3 py-2.5 active:scale-[0.97] transition-transform"
          style="--i:<%= mFolderIdx++ %>"
          data-folder-id="<%= folder.id %>"
          data-folder-name="<%= folder.name %>"
          data-folder-members='<%= JSON.stringify(folder.members.map(m => m.serverUUID)) %>'>
          <%- icon('folder', { class: 'h-4 w-4 text-amber-500 shrink-0', fill: 'currentColor' }) %>
          <div class="min-w-0">
            <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= folder.name %></p>
            <p class="text-[10px] text-neutral-500"><%= folder.members.length %> server<%= folder.members.length !== 1 ? 's' : '' %></p>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } else { %>
    <div class="flex items-center justify-between mb-3">
      <p class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Servers</p>
      <button id="newFolderBtn" class="text-xs text-neutral-500">+ New folder</button>
    </div>
    <% } %>

    <% if (servers.length === 0 && (!folders || folders.length === 0)) { %>
      <section class="mt-24 overflow-hidden rounded-2xl border border-neutral-200/80 bg-white/80 p-5 text-left shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/[0.045]">
        <div class="mb-5 flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-neutral-100 dark:bg-white/10 text-neutral-400 dark:text-neutral-500">
            <%- icon('server', { class: 'h-6 w-6' }) %>
          </div>
          <div>
            <p class="text-xs font-medium text-neutral-400 dark:text-neutral-500">No servers assigned</p>
            <h2 class="mt-1 text-lg font-semibold text-neutral-900 dark:text-white"><%= req.translations.noServersYet || "Your server list is empty" %></h2>
          </div>
        </div>
        <p class="max-w-sm text-sm leading-6 text-neutral-600 dark:text-neutral-400">
          <% if (user.isAdmin) { %>
            Create a server from the admin panel to start tracking status and usage here.
          <% } else if (canCreateServer) { %>
            Create your first server and it will appear here with live RAM, CPU, and node details.
          <% } else { %>
            An admin will assign one to you.
          <% } %>
        </p>
        <% if (user.isAdmin) { %>
          <a href="/admin/servers/create" class="mt-5 inline-flex items-center justify-center rounded-lg bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200">Create server</a>
        <% } else if (canCreateServer) { %>
          <a href="/create-server" class="mt-5 inline-flex items-center justify-center rounded-lg bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200">Create server</a>
        <% } %>
      </section>
    <% } else { %>
      <!-- Grid view -->
      <div id="gridView" class="space-y-3">
        <% let mServerIdx = 0; servers.forEach(server => { %>
        <%
          const inFolder = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID));
          if (inFolder) return;
        %>
          <div class="data-animate-card server-card relative bg-neutral-50 dark:bg-neutral-800 rounded-xl border border-neutral-200 dark:border-white/5 p-4 select-none touch-none"
            data-server-uuid="<%= server.UUID %>"
            data-server-name="<%= server.name %>"
            style="--i:<%= mServerIdx++ %>;overscroll-behavior: none;">
            <a href="../server/<%= server.UUID %>" class="block pointer-events-auto">
              <div class="flex items-start justify-between mb-2.5">
                <div class="min-w-0 flex-1 mr-2">
                  <h3 class="text-sm font-medium text-neutral-900 dark:text-white truncate"><%= server.name %></h3>
                  <% if (server.description) { %>
                    <p class="text-xs text-neutral-500 dark:text-neutral-400 truncate mt-0.5"><%= server.description %></p>
                  <% } else { %>
                    <p class="text-xs text-neutral-400 italic truncate mt-0.5"><%= req.translations.noDescription || 'No description' %></p>
                  <% } %>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-medium rounded-md shrink-0
                    <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30' : server.status === 'starting' ? 'bg-amber-50 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-500/30' : 'bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-500/20' %>">
                  <span class="relative flex h-1.5 w-1.5">
                    <% if (server.status === 'running') { %>
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                    <% } else if (server.status === 'starting') { %>
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-amber-500"></span>
                    <% } else { %>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500"></span>
                    <% } %>
                  </span>
                  <%= server.status === 'running' ? 'Running' : server.status === 'starting' ? 'Starting' : 'Stopped' %>
                </span>
              </div>
              <div class="flex gap-2 mb-3">
                <div class="flex-1 bg-white dark:bg-neutral-700 rounded-lg px-3 py-2 border border-neutral-100 dark:border-transparent">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">RAM</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= server.ramUsage %>%</p>
                </div>
                <div class="flex-1 bg-white dark:bg-neutral-700 rounded-lg px-3 py-2 border border-neutral-100 dark:border-transparent">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">CPU</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= server.cpuUsage %>%</p>
                </div>
                <div class="flex-1 bg-white dark:bg-neutral-700 rounded-lg px-3 py-2 border border-neutral-100 dark:border-transparent">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">Used</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= server.ramUsed || '0MB' %></p>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <img class="h-4 w-4 rounded-md shrink-0" src="<%= server.owner && server.owner.avatar ? server.owner.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(server.owner ? server.owner.username : 'unknown') %>" alt="<%= server.owner ? server.owner.username + ' avatar' : 'Unknown owner avatar' %>">
                <span class="text-xs text-neutral-500 dark:text-neutral-400 truncate flex-1"><%= server.owner ? server.owner.username : 'Unknown' %></span>
                <% if (server.node) { %>
                <span class="text-xs text-neutral-400 dark:text-neutral-500 shrink-0 truncate max-w-[6rem]"><%= server.node.name || server.node.address %></span>
                <% } %>
              </div>
            </a>
          </div>
        <% }); %>
      </div>

      <!-- List view -->
      <div id="listView" class="hidden space-y-1">
        <% let lServerIdx = 0; servers.forEach(server => { %>
        <%
          const inFolderL = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID));
          if (inFolderL) return;
        %>
          <a href="../server/<%= server.UUID %>" class="data-animate-card table-row-animate flex items-center gap-3 bg-white dark:bg-neutral-800/30 rounded-xl border border-neutral-200 dark:border-white/5 px-3 py-2.5 active:scale-[0.98] transition-transform"
            style="--i:<%= lServerIdx++ %>">
            <span class="relative flex h-2 w-2 shrink-0">
              <% if (server.status === 'running') { %>
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              <% } else if (server.status === 'starting') { %>
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
              <% } else { %>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
              <% } %>
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= server.name %></p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-xs text-neutral-500 dark:text-neutral-400"><%= server.ramUsage %>% RAM</span>
              <span class="text-[10px] font-medium px-1.5 py-0.5 rounded
                <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400' : server.status === 'starting' ? 'bg-amber-50 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400' : 'bg-red-50 dark:bg-red-500/10 text-red-500 dark:text-red-400' %>">
                <%= server.status === 'running' ? 'On' : server.status === 'starting' ? 'Starting' : 'Off' %>
              </span>
            </div>
          </a>
        <% }); %>
      </div>

      <% if (totalPages > 1) { %>
        <div class="flex items-center justify-center gap-3 mt-6">
          <% const pageParams = '&status=' + encodeURIComponent(req.query.status || '') + '&search=' + encodeURIComponent(req.query.search || ''); %>
          <% if (currentPage > 1) { %>
            <a href="/?page=<%= currentPage - 1 %><%= pageParams %>" class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800/60 border border-neutral-200 dark:border-white/5 rounded-xl hover:bg-neutral-200 dark:hover:bg-neutral-700/60 transition"><%= req.translations.prev || 'Prev' %></a>
          <% } %>
          <span class="text-sm text-neutral-500"><%= currentPage %> / <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a href="/?page=<%= currentPage + 1 %><%= pageParams %>" class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800/60 border border-neutral-200 dark:border-white/5 rounded-xl hover:bg-neutral-200 dark:hover:bg-neutral-700/60 transition"><%= req.translations.next || 'Next' %></a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>
</main>

<!-- Folder popup -->
<div id="folderOverlay" class="hidden fixed inset-0 z-modal-backdrop bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5 max-h-[70dvh] overflow-y-auto">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-base font-medium text-neutral-800 dark:text-white" id="folderOverlayTitle">Folder</h2>
      <div class="flex items-center gap-1">
        <button id="addServersToFolderBtnMobile" class="p-2 rounded-xl text-neutral-400 hover:bg-neutral-50 dark:hover:bg-neutral-700/40 transition active:scale-95">
          <%- icon('plus', { class: 'h-4 w-4' }) %>
        </button>
        <button id="renameFolderBtnMobile" class="p-2 rounded-xl text-neutral-400 hover:bg-neutral-50 dark:hover:bg-neutral-700/40 transition active:scale-95">
          <%- icon('pencil', { class: 'h-4 w-4' }) %>
        </button>
        <button id="deleteFolderBtn" class="p-2 rounded-xl text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition active:scale-95">
          <%- icon('trash-2', { class: 'h-4 w-4' }) %>
        </button>
        <button id="closeFolderOverlay" class="text-neutral-400 p-1">
          <%- icon('x', { class: 'h-5 w-5' }) %>
        </button>
      </div>
    </div>
    <div id="folderOverlayContent" class="space-y-2"></div>
  </div>
</div>

<!-- New folder dialog -->
<div id="newFolderDialog" class="hidden fixed inset-0 z-modal-backdrop bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5">
    <h2 class="text-base font-medium text-neutral-800 dark:text-white mb-4">New folder</h2>
    <input type="text" id="newFolderName" maxlength="64" placeholder="Folder name"
      class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-3 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/40 transition mb-4">
    <div class="flex gap-2">
      <button id="cancelNewFolder" class="flex-1 py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700 rounded-xl transition">Cancel</button>
      <button id="confirmNewFolder" class="flex-1 py-2.5 text-sm font-medium text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-xl transition">Create</button>
    </div>
  </div>
</div>

<!-- Rename folder sheet -->
<div id="renameFolderSheet" class="hidden fixed inset-0 z-modal-backdrop bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5">
    <p class="text-base font-medium text-neutral-800 dark:text-white mb-1">Rename folder</p>
    <input type="text" id="renameFolderNameMobile" maxlength="64" placeholder="Folder name"
      class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-3 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/40 transition mb-4">
    <div class="flex gap-2">
      <button id="cancelRenameFolderMobile" class="flex-1 py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700 rounded-xl transition">Cancel</button>
      <button id="confirmRenameFolderMobile" class="flex-1 py-2.5 text-sm font-medium text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-xl transition">Rename</button>
    </div>
  </div>
</div>

<!-- Delete folder confirm sheet -->
<div id="deleteFolderSheet" class="hidden fixed inset-0 z-modal-backdrop bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5">
    <p class="text-base font-medium text-neutral-800 dark:text-white mb-1">Delete folder?</p>
    <p class="text-sm text-neutral-500 mb-4">Servers inside stay accessible — they just won't be in this folder.</p>
    <div class="flex gap-2">
      <button id="cancelDeleteFolder" class="flex-1 py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700 rounded-xl transition">Cancel</button>
      <button id="confirmDeleteFolder" class="flex-1 py-2.5 text-sm font-medium text-white bg-red-600 rounded-xl transition active:scale-[0.98]">Delete</button>
    </div>
  </div>
</div>
<div id="addToFolderDialog" class="hidden fixed inset-0 z-modal-backdrop bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5 max-h-[60dvh] overflow-y-auto">
    <h2 class="text-base font-medium text-neutral-800 dark:text-white mb-4">Move to folder</h2>
    <div id="folderPickList" class="space-y-2 mb-4"></div>
    <button id="cancelAddToFolder" class="w-full py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700 rounded-xl transition">Cancel</button>
  </div>
</div>

<!-- Long-press action sheet -->
<div id="longPressSheet" class="hidden fixed inset-0 z-modal-backdrop bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5">
    <p class="text-sm font-medium text-neutral-800 dark:text-white mb-1" id="longPressServerName"></p>
    <p class="text-xs text-neutral-500 mb-4">Choose an action</p>
    <div class="space-y-2">
      <button id="lpMoveToFolder" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-700 border border-neutral-200 dark:border-white/5 text-sm text-neutral-800 dark:text-white text-left transition active:scale-[0.98]">
        <%- icon('folder', { class: 'h-4 w-4 text-amber-500 shrink-0', fill: 'currentColor' }) %>
        Move to folder
      </button>
      <button id="lpRemoveFromFolder" class="hidden w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-700 border border-neutral-200 dark:border-white/5 text-sm text-neutral-800 dark:text-white text-left transition active:scale-[0.98]">
        <%- icon('x', { class: 'h-4 w-4 text-neutral-400 shrink-0' }) %>
        Remove from folder
      </button>
      <button id="lpCancel" class="w-full py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700 rounded-xl transition">Cancel</button>
    </div>
  </div>
</div>

<!-- Mobile add servers to folder -->
<div id="mobileAddServersSheet" class="hidden fixed inset-0 z-modal-backdrop bg-black/40 flex items-end p-0">
  <div class="bg-white dark:bg-neutral-800 rounded-t-2xl w-full p-5 max-h-[70dvh] flex flex-col">
    <p class="text-base font-medium text-neutral-800 dark:text-white mb-1">Add servers to folder</p>
    <p class="text-xs text-neutral-500 mb-3">Toggle servers to add or remove.</p>
    <input type="text" id="mobileServerPickerSearch" placeholder="Search servers…"
      class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-3 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/40 transition mb-3">
    <div id="mobileServerPickerList" class="flex-1 overflow-y-auto space-y-1.5 max-h-[50dvh]"></div>
    <button id="mobileCancelAddServers" class="w-full py-2.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700 rounded-xl transition mt-3">Done</button>
  </div>
</div>

<style>
  body { overscroll-behavior: none; }
</style>

<div id="dashboard-data" class="hidden"></div>
<script type="application/json" id="dashboard-folders-data"><%- JSON.stringify(folders || []) %></script>
<script type="application/json" id="dashboard-servers-data"><%- JSON.stringify((allServers || []).map(s => ({ UUID: s.UUID, name: s.name, status: s.status }))) %></script>
<script nonce="<%- nonce %>">
  document.getElementById('dashboard-data').dataset.folders = document.getElementById('dashboard-folders-data').textContent;
  document.getElementById('dashboard-data').dataset.servers = document.getElementById('dashboard-servers-data').textContent;
</script>

<script nonce="<%- nonce %>" src="/js/user/dashboard-mobile.js"></script>

<%- include('../components/footer') %>

<% } else { %>
<%- include('../components/header', { title: 'Servers' }) %>

<style>
  ::-webkit-scrollbar { display: none; }
  @keyframes al-view-in { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }
  .vt-active { background: var(--theme-bg-input, white); color: var(--theme-text-strong, #171717); box-shadow: 0 1px 3px var(--theme-border-subtle, rgba(0,0,0,0.08)); }
  .dark .vt-active { background: var(--theme-bg-active-nav, rgba(255,255,255,0.08)); color: var(--theme-text-strong, white); }
  .fc-drag-over { border-color: var(--theme-warning, #f59e0b) !important; background: var(--theme-warning-bg, rgba(245,158,11,0.06)) !important; box-shadow: 0 0 0 2px var(--theme-warning-bg, rgba(245,158,11,0.25)) !important; }
  .dark .fc-drag-over { border-color: var(--theme-warning, #f59e0b) !important; background: var(--theme-warning-bg, rgba(245,158,11,0.08)) !important; }
  .sc-dragging { opacity: 0.4; transform: scale(0.97); box-shadow: none !important; }
  .ov-open { opacity: 1 !important; pointer-events: auto !important; }
  .pop-transform { transform: scale(1); opacity: 1; }
</style>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="w-60 h-full"><%- include('../components/template') %></div>

    <div id="page-content" class="flex-1 overflow-y-auto pt-16">
      <div class="px-12 pt-6 pb-8">

        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-base font-medium text-neutral-800 dark:text-white"><%= req.translations.userDashboardTitle %></h1>
            <p class="text-sm text-neutral-500 mt-0.5"><%= req.translations.userDashboardText %></p>
          </div>
          <div class="flex items-center gap-2">
            <% if (canCreateServer) { %>
            <a href="/create-server" class="flex min-h-10 items-center gap-1.5 px-3 py-2 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-sm font-medium hover:bg-neutral-700 dark:hover:bg-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-900 dark:focus-visible:ring-white focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950 transition">
              <%- icon('plus', { class: 'h-4 w-4' }) %>
              New server
            </a>
            <% } %>
            <button id="newFolderBtn" class="flex min-h-10 items-center gap-1.5 px-3 py-2 rounded-xl border border-neutral-200 dark:border-neutral-700 text-neutral-600 dark:text-neutral-300 text-sm font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950 transition">
              <%- icon('folder-plus', { class: 'h-4 w-4', strokeWidth: 1.5 }) %>
              New folder
            </button>
            <% if (servers && servers.length > 0) { %>
            <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800/60 p-1 rounded-xl border border-neutral-200 dark:border-white/5">
              <button id="gridViewBtn" class="vt-active min-h-9 px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5 text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 transition-colors">
                <%- icon('grid-2x2', { class: 'h-4 w-4' }) %>
                Grid
              </button>
              <button id="listViewBtn" class="min-h-9 px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5 text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 transition-colors">
                <%- icon('list', { class: 'h-4 w-4' }) %>
                List
              </button>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Alerts -->
        <% if (req.query.err === 'NOTACTIVEYET') { %>
        <div class="data-animate-card rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 px-4 py-3 mb-5">
          <p class="text-sm font-medium text-amber-700 dark:text-amber-400"><%= req.translations.awaitingInstallation || "This server's still getting its act together. Check back in a moment." %></p>
          <p class="text-xs text-amber-600 dark:text-amber-400/60 mt-0.5"><%= req.translations.awaitingInstallationDesc || "The server isn't installed yet or is in a failed state." %></p>
        </div>
        <% } %>
        <% if (req.query.err === 'SERVER_LIMIT_REACHED') { %>
        <div class="data-animate-card rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 px-4 py-3 mb-5">
          <p class="text-sm font-medium text-amber-700 dark:text-amber-400">You've hit your server limit — talk to your admin if you need more room.</p>
          <p class="text-xs text-amber-600 dark:text-amber-400/60 mt-0.5">You have reached the maximum number of servers allowed.</p>
        </div>
        <% } %>
        <% if (typeof daemonOffline !== 'undefined' && daemonOffline) { %>
        <div class="data-animate-card rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-5">
          <p class="text-sm font-medium text-red-700 dark:text-red-400"><%= req.translations.connectionError || 'Connection Error' %></p>
          <p class="text-xs text-red-600 dark:text-red-400/60 mt-0.5"><%= req.translations.connectionErrorDesc || 'One or more nodes are offline.' %></p>
          <button onclick="window.location.reload()" class="mt-3 px-3 py-1.5 bg-red-600 text-white text-xs font-medium rounded-lg transition hover:bg-red-700 active:scale-95"><%= req.translations.retry || 'Retry' %></button>
        </div>
        <% } %>

        <!-- ── Filters ────────────────────────────────────────── -->
        <div id="filterBar" class="flex items-center gap-2 mb-5 flex-wrap">
          <div class="flex items-center gap-1.5 px-3 py-2 rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800">
            <%- icon('filter', { class: 'h-3.5 w-3.5 text-neutral-400' }) %>
            <select id="filterStatus" class="cs-select cs-sm">
              <option value="">Status</option>
              <option value="running">Running</option>
              <option value="stopped">Stopped</option>
            </select>
          </div>
          <div class="flex items-center gap-1.5 px-3 py-2 rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800">
            <%- icon('arrow-up-down', { class: 'h-3.5 w-3.5 text-neutral-400' }) %>
            <select id="sortSelect" class="cs-select cs-sm">
              <option value="">Sort</option>
              <option value="name-asc">Name (A-Z)</option>
              <option value="name-desc">Name (Z-A)</option>
              <option value="status-asc">Status (Running first)</option>
              <option value="ramUsage-desc">RAM (Highest)</option>
              <option value="cpuUsage-desc">CPU (Highest)</option>
            </select>
          </div>
          <div class="relative flex-1 max-w-xs">
            <input type="text" id="serverSearch" placeholder="Search servers..."
              class="w-full pl-3 pr-8 py-2 rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/40 transition">
            <button id="clearSearch" class="hidden absolute right-2 top-1/2 -translate-y-1/2 p-1 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition">
              <%- icon('x', { class: 'h-3.5 w-3.5' }) %>
            </button>
          </div>
          <p id="filterCount" class="text-xs text-neutral-400 dark:text-neutral-500 hidden"></p>
        </div>

        <% if (servers.length === 0 && (!folders || folders.length === 0)) { %>
        <section class="mx-auto mt-28 max-w-2xl overflow-hidden rounded-2xl border border-neutral-200/80 bg-white/80 p-7 text-left shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/[0.045]">
          <div class="mb-5 flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-neutral-100 dark:bg-white/10 text-neutral-400 dark:text-neutral-500">
              <%- icon('server', { class: 'h-7 w-7' }) %>
            </div>
            <div>
              <p class="text-sm font-medium text-neutral-400 dark:text-neutral-500">No servers assigned</p>
              <h2 class="mt-1 text-2xl font-semibold text-neutral-900 dark:text-white"><%= req.translations.noServersYet || "Your server list is empty" %></h2>
            </div>
          </div>
          <p class="max-w-xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">
            <% if (user.isAdmin) { %>Create a server from the admin panel to start tracking status and usage here.
            <% } else if (canCreateServer) { %>Create your first server and it will appear here with live RAM, CPU, and node details.
            <% } else { %>An admin will assign one to you.<% } %>
          </p>
          <% if (user.isAdmin) { %>
          <a href="/admin/servers/create" class="mt-6 inline-flex items-center justify-center rounded-lg bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-neutral-800 active:translate-y-0 dark:bg-white dark:text-neutral-900"><%= req.translations.createOneNow || 'Create server' %></a>
          <% } else if (canCreateServer) { %>
          <a href="/create-server" class="mt-6 inline-flex items-center justify-center rounded-lg bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-neutral-800 active:translate-y-0 dark:bg-white dark:text-neutral-900">Create server</a>
          <% } %>
        </section>
        <% } else { %>

        <!-- ── Folders ──────────────────────────────────────── -->
        <% if (folders && folders.length > 0) { %>
        <div class="mb-8">
          <p class="text-xs font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-3">Folders</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3" id="folderGrid">
            <% let folderIdx = 0; folders.forEach(folder => { %>
            <div class="data-animate-card folder-card flex items-center gap-3 bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/[0.07] rounded-xl px-3.5 py-3 cursor-pointer relative transition-[background,border-color,box-shadow] select-none hover:bg-neutral-100 dark:hover:bg-white/[0.06] hover:border-neutral-300 dark:hover:border-white/[0.12] hover:shadow-sm group"
              role="button"
              tabindex="0"
              aria-label="Open folder <%= folder.name %>"
              style="--i:<%= folderIdx++ %>"
              data-folder-id="<%= folder.id %>"
              data-folder-name="<%= folder.name %>"
              data-folder-members='<%= JSON.stringify(folder.members.map(m => m.serverUUID)) %>'>
              <%- icon('folder', { class: 'h-5 w-5 text-amber-500 shrink-0', fill: 'currentColor' }) %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= folder.name %></p>
                <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-0.5"><%= folder.members.length %> server<%= folder.members.length !== 1 ? 's' : '' %></p>
              </div>

            </div>
            <% }); %>
          </div>
          <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-2">Drag a server card onto a folder to add it</p>
        </div>
        <% } %>

        <!-- ── Servers header ───────────────────────────────── -->
        <p class="text-xs font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-3">Servers</p>

        <!-- Grid view -->
        <div id="gridView" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
          <% let serverIdx = 0; servers.forEach(server => { %>
          <%
            const inFolder = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID));
            if (inFolder) return;
          %>
          <div class="data-animate-card group relative block bg-white dark:bg-neutral-800 rounded-xl border border-neutral-200 dark:border-white/5 shadow-sm p-4 cursor-grab hover:border-neutral-300 dark:hover:border-white/10 hover:shadow-md dark:hover:shadow-none transition-[box-shadow,transform,border-color] duration-150 active:cursor-grabbing"
            data-server-uuid="<%= server.UUID %>"
            data-server-name="<%= server.name %>"
            data-status="<%= server.status %>"
            data-ram="<%= Math.round(server.ramUsage) %>"
            data-cpu="<%= Math.round(server.cpuUsage) %>"
            style="--i:<%= serverIdx++ %>"
            draggable="true">
            <a href="../server/<%= server.UUID %>" class="block">
              <div class="flex items-start justify-between mb-3">
                <div class="min-w-0 flex-1 mr-3">
                  <h3 class="text-sm font-medium text-neutral-900 dark:text-white truncate"><%= server.name %></h3>
                  <% if (server.description) { %>
                    <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 truncate"><%= server.description %></p>
                  <% } else { %>
                    <p class="text-xs text-neutral-400 mt-0.5 truncate italic"><%= req.translations.noDescription || 'No description' %></p>
                  <% } %>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-medium rounded-md shrink-0 <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30' : server.status === 'starting' ? 'bg-amber-50 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-500/30' : 'bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-500/20' %>">
                  <span class="relative flex h-1.5 w-1.5">
                    <% if (server.status === 'running') { %>
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                    <% } else if (server.status === 'starting') { %>
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-amber-500"></span>
                    <% } else { %>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500"></span>
                    <% } %>
                  </span>
                  <%= server.status === 'running' ? 'Running' : server.status === 'starting' ? 'Starting' : 'Stopped' %>
                </span>
              </div>
              <div class="flex gap-3 mb-3">
                <div class="flex-1 bg-neutral-100 dark:bg-neutral-700 rounded-lg px-3 py-2">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">RAM</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= Math.round(server.ramUsage) %>%</p>
                </div>
                <div class="flex-1 bg-neutral-100 dark:bg-neutral-700 rounded-lg px-3 py-2">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">CPU</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= Math.round(server.cpuUsage) %>%</p>
                </div>
                <div class="flex-1 bg-neutral-100 dark:bg-neutral-700 rounded-lg px-3 py-2">
                  <p class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-0.5">Used</p>
                  <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= server.ramUsed || '0MB' %></p>
                </div>
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-neutral-100 dark:border-white/5">
                <div class="flex items-center gap-1.5 min-w-0">
                  <img class="h-4 w-4 rounded-md shrink-0" src="<%= server.owner && server.owner.avatar ? server.owner.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(server.owner ? server.owner.username : 'unknown') %>" alt="<%= server.owner ? server.owner.username + ' avatar' : 'Unknown owner avatar' %>">
                  <span class="text-xs text-neutral-500 dark:text-neutral-400 truncate"><%= server.owner ? server.owner.username : 'Unknown' %></span>
                </div>
                <% if (server.node) { %>
                <span class="text-xs text-neutral-400 dark:text-neutral-500 shrink-0 ml-2 truncate max-w-[6rem]"><%= server.node.name || server.node.address %></span>
                <% } %>
              </div>
            </a>
            <!-- Right-click context menu -->
            <div class="server-ctx-menu hidden bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-white/10 rounded-xl shadow-xl py-1 w-44 z-30">
              <button class="ctx-add-to-folder w-full text-left px-3 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/5 transition rounded-t-xl" data-uuid="<%= server.UUID %>">Add to folder</button>
              <button class="ctx-remove-from-folder w-full text-left px-3 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/5 transition rounded-b-xl" data-uuid="<%= server.UUID %>" style="display:<%= (folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID))) ? '' : 'none' %>">Remove from folder</button>
            </div>
          </div>
          <% }); %>
        </div>

        <!-- List view -->
        <div id="listView" class="rounded-xl border border-neutral-200 dark:border-white/5 overflow-hidden shadow-sm hidden mb-6">
          <table class="min-w-full divide-y divide-neutral-200 dark:divide-white/5">
            <thead class="bg-neutral-50 dark:bg-neutral-800">
              <tr>
                <th class="py-3 pl-6 pr-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">Server</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">Status</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">Owner</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">RAM</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-neutral-500 dark:text-neutral-400">CPU</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100 dark:divide-white/5 bg-white dark:bg-transparent">
              <% let listIdx = 0; servers.forEach(server => { %>
              <% const inFolderL = folders && folders.some(f => f.members.some(m => m.serverUUID === server.UUID)); if (inFolderL) return; %>
              <tr style="--i:<%= listIdx++ %>" data-href="../server/<%= server.UUID %>" data-name="<%= server.name %>" data-status="<%= server.status %>" data-ram="<%= Math.round(server.ramUsage) %>" data-cpu="<%= Math.round(server.cpuUsage) %>" role="link" tabindex="0" class="hover:bg-neutral-50 dark:hover:bg-white/5 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-neutral-500">
                <td class="py-3.5 pl-6 pr-3">
                  <p class="text-sm font-medium text-neutral-900 dark:text-white truncate"><%= server.name %></p>
                  <% if (server.description) { %><p class="text-xs text-neutral-500 dark:text-neutral-400 truncate max-w-xs"><%= server.description %></p><% } %>
                </td>
                <td class="px-3 py-3.5">
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-medium rounded-md <%= server.status === 'running' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30' : server.status === 'starting' ? 'bg-amber-50 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-500/30' : 'bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-500/20' %>">
                    <span class="relative flex h-1.5 w-1.5"><% if (server.status === 'running') { %><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span><% } else if (server.status === 'starting') { %><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-amber-500"></span><% } else { %><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500"></span><% } %></span>
                    <%= server.status === 'running' ? 'Running' : server.status === 'starting' ? 'Starting' : 'Stopped' %>
                  </span>
                </td>
                <td class="px-3 py-3.5 text-sm text-neutral-600 dark:text-neutral-300"><%= server.owner ? server.owner.username : 'Unknown' %></td>
                <td class="px-3 py-3.5 text-sm text-neutral-600 dark:text-neutral-300"><%= Math.round(server.ramUsage) %>%</td>
                <td class="px-3 py-3.5 text-sm text-neutral-600 dark:text-neutral-300"><%= Math.round(server.cpuUsage) %>%</td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (totalPages > 1) { %>
        <div class="flex items-center justify-center gap-3 mt-2">
          <% const desktopPageParams = '&status=' + encodeURIComponent(req.query.status || '') + '&search=' + encodeURIComponent(req.query.search || ''); %>
          <% if (currentPage > 1) { %>
          <a href="/?page=<%= currentPage - 1 %><%= desktopPageParams %>" class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800/60 border border-neutral-200 dark:border-white/5 rounded-xl hover:bg-neutral-200 dark:hover:bg-neutral-700/60 transition"><%= req.translations.prev || 'Prev' %></a>
          <% } %>
          <span class="text-sm text-neutral-500"><%= currentPage %> / <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
          <a href="/?page=<%= currentPage + 1 %><%= desktopPageParams %>" class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800/60 border border-neutral-200 dark:border-white/5 rounded-xl hover:bg-neutral-200 dark:hover:bg-neutral-700/60 transition"><%= req.translations.next || 'Next' %></a>
          <% } %>
        </div>
        <% } %>

        <!-- Empty filter state -->
        <div id="emptyFilterState" class="hidden flex flex-col items-center justify-center mt-16 text-center">
          <%- icon('search', { class: 'h-12 w-12 text-neutral-300 dark:text-neutral-600 mb-3' }) %>
          <p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">No servers match your filters</p>
          <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">Try adjusting your search or filter criteria</p>
        </div>

        <% } %>
      </div>
    </div>
  </div>
</main>

<!-- Drag ghost element -->
<div id="drag-ghost" class="hidden rotate-2 fixed z-toast pointer-events-none bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-white/10 rounded-xl px-3.5 py-2.5 text-[13px] font-medium text-neutral-900 dark:text-neutral-100 shadow-[0_8px_24px_rgba(0,0,0,0.18)] flex items-center gap-2 opacity-95 max-w-[200px] whitespace-nowrap overflow-hidden text-ellipsis">
  <%- icon('folder', { class: 'w-3.5 h-3.5 text-amber-500 shrink-0', fill: 'currentColor' }) %>
  <span id="drag-ghost-name"></span>
</div>

<!-- Folder popup -->
<div class="fixed inset-0 z-modal-backdrop bg-black/45 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity data-[open]:opacity-100 data-[open]:pointer-events-auto" id="folderPopupOverlay">
