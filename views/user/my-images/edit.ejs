<%- include('../../layouts/user', { title: t('editImage') }) %>
<%
  /* Image review status → badge variant + translated label (the status
     value itself comes from the API in English). */
  function imageStatusClass(status) {
    if (status === 'approved') { return 'al-badge-online'; }
    if (status === 'pending') { return 'al-badge-warning'; }
    return 'al-badge-offline';
  }
  function imageStatusLabel(status) {
    if (status === 'approved') { return t('approved'); }
    if (status === 'pending') { return t('pending'); }
    if (status === 'rejected') { return t('rejected'); }
    return t('unknown');
  }
%>

<div class="al-page-header">
  <div class="flex items-start gap-2 min-w-0 justify-start flex-nowrap">
    <a href="/my-images" class="al-btn al-btn-ghost al-btn-icon-only shrink-0" title="<%= t('back') %>" aria-label="<%= t('back') %>">
      <%- icon('arrow-left', { class: 'w-4 h-4' }) %>
    </a>
    <div class="min-w-0">
      <h1 class="al-page-title"><%= t('editImage') %></h1>
      <p class="al-page-desc truncate"><%= typeof image !== 'undefined' && image ? image.name : '' %></p>
    </div>
  </div>
</div>

<div class="al-page-body">
  <% if (typeof image === 'undefined' || !image) { %>
  <div class="mt-8">
    <%- include('../../partials/empty-state', {
      iconName: 'alert-triangle',
      title: t('imageNotFound'),
      description: t('imageMayHaveBeenDeleted')
    }) %>
  </div>
  <% } else { %>

  <form id="editImageForm" class="mt-4 max-w-2xl space-y-4">
    <div class="al-form-card">
      <h3 class="al-form-card-title mb-4"><%= t('basicInfo') %></h3>
      <div class="al-form-field">
        <label for="imageName" class="al-form-label"><%= t('imageName') %> <span class="al-required" aria-hidden="true">*</span></label>
        <input type="text" id="imageName" name="name" class="al-form-input" required maxlength="100"
          value="<%= image.name %>" aria-required="true">
      </div>
      <div class="al-form-field mt-3">
        <label for="imageAuthor" class="al-form-label"><%= t('author') %></label>
        <input type="text" id="imageAuthor" name="author" class="al-form-input" maxlength="100"
          value="<%= image.author || '' %>">
      </div>
      <div class="al-form-field mt-3">
        <label for="imageDescription" class="al-form-label"><%= t('description') %></label>
        <textarea id="imageDescription" name="description" class="al-form-textarea" rows="2" maxlength="500"><%= image.description || '' %></textarea>
      </div>
      <div class="al-form-field mt-3">
        <span class="al-form-label"><%= t('status') %></span>
        <div class="flex items-center gap-2">
          <span class="al-badge <%= imageStatusClass(image.status) %>"><%= imageStatusLabel(image.status) %></span>
          <% if (image.rejectionReason) { %>
          <span class="al-form-error-msg"><%= image.rejectionReason %></span>
          <% } %>
        </div>
      </div>
    </div>

    <div class="al-form-card">
      <h3 class="al-form-card-title mb-4"><%= t('dockerConfig') %></h3>
      <div class="al-form-field">
        <label for="imageDockerImages" class="al-form-label"><%= t('dockerImages') %> (JSON) <span class="al-required" aria-hidden="true">*</span></label>
        <textarea id="imageDockerImages" name="dockerImages" class="al-form-textarea font-mono" rows="3"
          required aria-required="true"><%= image.dockerImages ? (typeof image.dockerImages === 'string' ? image.dockerImages : JSON.stringify(image.dockerImages)) : '' %></textarea>
      </div>
      <div class="al-form-field mt-3">
        <label for="imageStartup" class="al-form-label"><%= t('startupCommand') %> <span class="al-required" aria-hidden="true">*</span></label>
        <input type="text" id="imageStartup" name="startup" class="al-form-input font-mono"
          value="<%= image.startup || '' %>" required aria-required="true">
      </div>
      <div class="al-form-field mt-3">
        <label for="imageStop" class="al-form-label"><%= t('stopCommand') %></label>
        <input type="text" id="imageStop" name="stop" class="al-form-input font-mono"
          value="<%= image.stop || '' %>">
      </div>
    </div>

    <div class="al-form-card">
      <h3 class="al-form-card-title mb-4"><%= t('variables') %> (JSON)</h3>
      <div class="al-form-field">
        <textarea id="imageVariables" name="variables" class="al-form-textarea font-mono" rows="5"
          aria-label="<%= t('variables') %> (JSON)"><%= image.variables ? (typeof image.variables === 'string' ? image.variables : JSON.stringify(image.variables)) : '' %></textarea>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" id="submitBtn" class="al-btn al-btn-primary">
        <%- icon('save', { class: 'w-4 h-4' }) %> <%= t('saveChanges') %>
      </button>
      <button type="button" onclick="resubmit()" class="al-btn al-btn-secondary">
        <%- icon('refresh-cw', { class: 'w-4 h-4' }) %> <%= t('resubmitForReview') %>
      </button>
      <a href="/my-images" class="al-btn al-btn-ghost"><%= t('cancel') %></a>
    </div>
  </form>

  <% } %>
</div>

<script nonce="<%- nonce %>">
(function() {
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
  var imageId = <%= typeof image !== 'undefined' && image ? image.id : 'null' %>;
  // Copy is injected server-side: window.__i18n serialises to {} (Proxy with
  // a get trap only), so every client string must arrive through t().
  var EDIT_IMAGE_I18N = {
    imageUpdated: <%- JSON.stringify(t('imageUpdated')).replace(/</g, '\\x3c') %>,
    failedToUpdate: <%- JSON.stringify(t('failedToUpdate')).replace(/</g, '\\x3c') %>,
    imageResubmitted: <%- JSON.stringify(t('imageResubmitted')).replace(/</g, '\\x3c') %>,
    imageResubmitFailed: <%- JSON.stringify(t('imageResubmitFailed')).replace(/</g, '\\x3c') %>
  };

  // The form is absent on the "image not found" branch — guard the bind so
  // the empty state does not throw.
  var editForm = document.getElementById('editImageForm');
  if (editForm) {
    editForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      if (!imageId) return;
      var btn = document.getElementById('submitBtn');
      btn.disabled = true;

      try {
        var fd = new FormData(e.target);
        var data = {};
        fd.forEach(function(val, key) { data[key] = val; });

        var r = await fetch('/my-images/update/' + imageId + '/published', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify(data)
        });

        if (r.ok) { showToast(EDIT_IMAGE_I18N.imageUpdated, 'success'); window.location.href = '/my-images'; }
        else { var err = await r.text(); showToast(err, 'error'); btn.disabled = false; }
      } catch(err) {
        showToast(EDIT_IMAGE_I18N.failedToUpdate, 'error');
        btn.disabled = false;
      }
    });
  }

  window.resubmit = async function() {
    if (!imageId) return;
    try {
      var r = await fetch('/my-images/update/' + imageId + '/published', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ status: 'pending' })
      });
      if (r.ok) { showToast(EDIT_IMAGE_I18N.imageResubmitted, 'success'); window.location.href = '/my-images'; }
      else { showToast(EDIT_IMAGE_I18N.imageResubmitFailed, 'error'); }
    } catch(err) { showToast(EDIT_IMAGE_I18N.imageResubmitFailed, 'error'); }
  };
})();
</script>

<%- include('../../layouts/user-footer') %>
