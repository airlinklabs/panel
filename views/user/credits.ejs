<%- include('../components/header', { title: 'Credits' }) %>

<style>
  .credits-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .credits-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .credits-bg.fading-out canvas {
    opacity: 0 !important;
    transition: opacity 0.3s ease;
  }
</style>

<!-- Easter egg background -->
<div class="credits-bg" aria-hidden="true">
  <canvas id="credits-canvas"></canvas>
</div>

<main class="h-screen m-auto relative z-10">
  <div class="flex h-screen">
    <div class="hidden lg:block w-60 h-full shrink-0"><%- include('../components/template') %></div>
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">
      <%- include('../components/ui/breadcrumb', { items: [
        { label: 'Credits' }
      ] }) %>

      <div class="px-8 pt-5 mb-8">
        <div class="flex items-center gap-3 mb-1">
          <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong);">Credits</h1>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-md" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border); color:var(--theme-text-muted);">v<%= version %></span>
        </div>
        <p class="text-sm" style="color:var(--theme-text-muted);">The people who build and maintain Airlink.</p>
      </div>

      <div class="px-4 sm:px-8 space-y-8 max-w-5xl">

        <!-- Project leads — horizontal row on desktop -->
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:var(--theme-text-muted);">Project leads</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <% const leads = [
              { login: 'bthavanish', role: 'Current maintainer' },
              { login: 'privt00',   role: 'Project lead' },
              { login: 'achul123',  role: 'Core developer' },
            ]; %>
            <% leads.forEach(function(lead) { %>
            <div class="al-card flex items-center gap-4 px-5 py-4">
              <img src="https://github.com/<%= lead.login %>.png?size=80"
                   alt="<%= lead.login %>"
                   loading="lazy"
                   class="h-12 w-12 rounded-xl border border-neutral-200 dark:border-white/10 object-cover shrink-0"
                   onerror="this.src='https://github.com/ghost.png'">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold truncate" style="color:var(--theme-text-strong);"><%= lead.login %></p>
                <p class="text-xs mt-0.5" style="color:var(--theme-text-muted);"><%= lead.role %></p>
                <a href="https://github.com/<%= lead.login %>" target="_blank" rel="noopener"
                   class="inline-flex items-center gap-1 text-xs mt-1.5 transition-colors" style="color:var(--theme-text-muted);">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"/>
                  </svg>
                  GitHub
                </a>
              </div>
            </div>
            <% }); %>
          </div>
        </section>

        <!-- Contributors -->
        <section>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-semibold uppercase tracking-widest" style="color:var(--theme-text-muted);">Contributors</h2>
            <span id="contrib-cache-label" class="text-xs" style="color:var(--theme-text-muted);"></span>
          </div>
          <div id="contributors-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
            <div class="col-span-full flex items-center gap-2 py-2">
              <div class="h-4 w-4 border-2 border-neutral-300 dark:border-neutral-600 border-t-neutral-600 dark:border-t-neutral-300 rounded-full animate-spin"></div>
              <span class="text-sm" style="color:var(--theme-text-muted);">Loading contributors…</span>
            </div>
          </div>
        </section>

        <!-- Links — full horizontal row -->
