          <h2 class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:var(--theme-text-muted);">Links</h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">

            <a href="https://github.com/airlinklabs/panel" target="_blank" rel="noopener"
