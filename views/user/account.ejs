<%- include('../components/header', { title: req.translations.userAccountTitle || 'Account' }) %>

<style>
  .field-label { font-size: 11px; font-weight: 500; color: var(--theme-text-muted, #737373); display: block; margin-bottom: 5px; }
  .field-input {
    width: 100%; border-radius: 9px; border: 1px solid var(--theme-border, #e5e5e5);
    background: var(--theme-bg-input, #fafafa); padding: 8px 12px;
    font-size: 13px; color: var(--theme-text-strong, #171717); outline: none;
    transition: border-color 0.15s; box-sizing: border-box; font-family: inherit;
  }
  html.dark .field-input { background: var(--theme-bg-hover, rgba(255,255,255,0.04)); border-color: var(--theme-border-subtle, rgba(255,255,255,0.1)); color: var(--theme-text, #e5e5e5); }
  .field-input:focus { border-color: var(--theme-border, #a3a3a3); }
  html.dark .field-input:focus { border-color: var(--theme-border-subtle, rgba(255,255,255,0.25)); }
  .field-input::placeholder { color: var(--theme-text-placeholder, #a3a3a3); }
  html.dark .field-input::placeholder { color: var(--theme-text-muted, #525252); }
</style>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../components/template') %>
    </div>
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">
      <%- include('../components/ui/breadcrumb', { items: [
        { label: 'Account' }
      ] }) %>

      <div class="al-page-header mb-5">
        <div class="flex items-center gap-4">
          <div class="relative shrink-0">
            <img loading="lazy" decoding="async" id="avatar-preview"
              src="<%= user.avatar ? user.avatar : '/avatar/' + encodeURIComponent(user.username) %>"
              alt="Avatar"
              class="h-12 w-12 rounded-xl border object-cover" style="border-color:var(--theme-border);">
            <label for="avatar-input" title="Upload photo"
              class="absolute -bottom-1.5 -right-1.5 w-6 h-6 flex items-center justify-center rounded-full cursor-pointer hover:opacity-80 transition" style="background:var(--theme-text);border:2px solid var(--theme-bg);">
              <%- icon('upload', { class: 'w-3 h-3', strokeWidth: 2.5, style: 'color:var(--theme-bg);' }) %>
            </label>
            <input id="avatar-input" type="file" accept="image/*" class="hidden">
            <% if (user.avatar) { %>
            <button id="remove-avatar-btn" type="button" title="Remove photo"
              class="absolute -top-1.5 -right-1.5 w-6 h-6 flex items-center justify-center rounded-full hover:opacity-85 transition" style="background:var(--theme-danger);border:2px solid var(--theme-bg);">
              <%- icon('x', { class: 'w-3 h-3', strokeWidth: 2.5, style: 'color:var(--theme-btn-danger-text);' }) %>
            </button>
            <% } %>
          </div>
          <div class="min-w-0 flex-1">
            <h1 class="al-page-title"><%= req.translations.userAccountTitle || 'Account' %></h1>
            <p class="al-page-desc"><%= req.translations.userAccountText || 'Manage your profile and preferences.' %></p>
          </div>
          <a href="/credits"
            class="flex items-center gap-1.5 rounded-xl border px-3 py-1.5 text-xs font-medium shadow-sm transition shrink-0 hover:opacity-85" style="border-color:var(--theme-border);background:var(--theme-btn-secondary-bg);color:var(--theme-btn-secondary-text);">
            <%- icon('circle-alert', { class: 'w-3.5 h-3.5' }) %>
            Credits
          </a>
        </div>
      </div>

      <div class="al-page-body space-y-4">

        <div class="al-card p-5">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">

            <!-- Username -->
            <div>
              <label class="flex items-center gap-1.5 text-sm font-medium mb-3" style="color:var(--theme-text-strong)">
                <%- icon('user', { class: 'w-3.5 h-3.5' }) %> <%= req.translations.username || 'Username' %>
              </label>
              <div class="flex gap-1.5">
                <input id="username" type="text" name="username" placeholder="<%= user.username %>"
                  class="al-input flex-1">
                <span id="username-feedback" class="text-[11px] hidden" style="color:var(--theme-text-muted);"></span>
              </div>
            </div>

            <!-- Email -->
            <div>
              <label class="flex items-center gap-1.5 text-sm font-medium mb-3" style="color:var(--theme-text-strong)">
                <%- icon('mail', { class: 'w-3.5 h-3.5' }) %> <%= req.translations.email || 'Email' %>
              </label>
              <input id="email" type="email" name="email" placeholder="<%= user.email %>" class="al-input">
            </div>

            <!-- Current password -->
            <div>
              <label class="flex items-center gap-1.5 text-sm font-medium mb-3" style="color:var(--theme-text-strong)">
                <%- icon('lock', { class: 'w-3.5 h-3.5' }) %> <%= req.translations.currentPassword || 'Current password' %>
              </label>
              <span id="current-password-feedback" class="text-[11px] block mb-1 hidden" style="color:var(--theme-text-muted);"></span>
              <input id="currentPassword" type="password" name="currentPassword" placeholder="<%= req.translations.currentPassword || 'Current password' %>" class="al-input">
            </div>

            <!-- New password -->
            <div>
              <label class="flex items-center gap-1.5 text-sm font-medium mb-3" style="color:var(--theme-text-strong)">
                <%- icon('lock', { class: 'w-3.5 h-3.5' }) %> <%= req.translations.newPassword || 'New password' %>
              </label>
              <input id="newPassword" type="password" name="newPassword" placeholder="<%= req.translations.newPassword || 'New password' %>" disabled class="al-input disabled:opacity-50">
            </div>

            <!-- Description (full width) -->
            <div class="md:col-span-2">
              <label class="flex items-center gap-1.5 text-sm font-medium mb-3" style="color:var(--theme-text-strong)">
                <%- icon('file-text', { class: 'w-3.5 h-3.5' }) %> <%= req.translations.description || 'Description' %>
              </label>
              <textarea id="description" name="description" rows="2" class="al-input resize-none"><%= user.description %></textarea>
            </div>

            <!-- Language -->
            <div>
              <label for="language" class="flex items-center gap-1.5 text-sm font-medium mb-3" style="color:var(--theme-text-strong)">
                <%- icon('globe', { class: 'w-3.5 h-3.5' }) %> <%= req.translations.languagePreference || 'Language' %>
              </label>
              <select id="language" name="language" class="cs-native">
                <option value="en"  <%= req.lang === 'en'  ? 'selected' : '' %>>English</option>
                <option value="fr"  <%= req.lang === 'fr'  ? 'selected' : '' %>>Français</option>
                <option value="de"  <%= req.lang === 'de'  ? 'selected' : '' %>>Deutsch</option>
                <option value="es"  <%= req.lang === 'es'  ? 'selected' : '' %>>Español</option>
                <option value="pt"  <%= req.lang === 'pt'  ? 'selected' : '' %>>Português</option>
                <option value="it"  <%= req.lang === 'it'  ? 'selected' : '' %>>Italiano</option>
                <option value="ru"  <%= req.lang === 'ru'  ? 'selected' : '' %>>Русский</option>
                <option value="zh"  <%= req.lang === 'zh'  ? 'selected' : '' %>>中文</option>
                <option value="ja"  <%= req.lang === 'ja'  ? 'selected' : '' %>>日本語</option>
                <option value="ta"  <%= req.lang === 'ta'  ? 'selected' : '' %>>தமிழ்</option>
              </select>
              <div class="custom-select" data-for="language"></div>
            </div>

            <!-- 2FA -->
            <div>
              <p class="flex items-center gap-1.5 text-sm font-medium mb-3" style="color:var(--theme-text-strong)">
                <%- icon('shield', { class: 'w-3.5 h-3.5' }) %> <%= req.translations.twoFactorAuth || 'Two-factor authentication' %>
              </p>
              <div id="twofa-status">
              <% if (user.totpEnabled !== true) { %>
              <p class="text-sm mb-3" style="color:var(--theme-text-muted)">Add an extra layer of security to your account.</p>
              <a href="/account/2fa/setup" class="al-btn-primary text-sm inline-flex">Set up 2FA</a>
              <% } else { %>
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 dark:bg-emerald-400/10 px-2.5 py-1 text-xs font-medium text-emerald-500">
                  <%- icon('check', { class: 'w-3 h-3' }) %> Enabled
                </span>
              </div>
              <div class="flex gap-2 items-center">
                <input id="disable2faPassword" type="password" placeholder="Current password" class="al-input text-sm flex-1" style="max-width:180px">
                <button id="disable2faBtn" type="button" class="al-btn-secondary text-sm"><%- icon('shield-off', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.disable2FA || 'Disable 2FA' %></button>
              </div>
              <% } %>
              </div>
            </div>

          </div>

          <!-- Universal save button -->
          <div class="mt-6 pt-5" style="border-top:1px solid var(--theme-border)">
            <button id="saveAccountBtn" type="button" class="al-btn-primary px-6 py-2.5 text-sm font-medium">
              <%= req.translations.saveChanges || 'Save Changes' %>
            </button>
          </div>
        </div>

        <!-- Preferred node -->
        <div class="al-card p-5">
          <p class="text-sm font-medium mb-1" style="color:var(--theme-text-strong)"><%= req.translations.preferredNode || 'Preferred node' %></p>
          <p class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= req.translations.preferredNodeDesc || 'Pick the node your servers are created on by default.' %></p>
          <select id="preferredNode" class="al-input">
            <option value=""><%= req.translations.autoSelectNode || 'Auto (least loaded)' %></option>
            <% if (nodes && nodes.length) { nodes.forEach(node => { %>
            <option value="<%= node.id %>"<%= user?.preferredNodeId === node.id ? ' selected' : '' %>><%= node.name %> — <%= node.address %></option>
            <% }); } %>
          </select>
          <div class="mt-4">
            <button id="savePreferredNodeBtn" type="button" class="al-btn-primary px-4 py-2 text-sm font-medium">
              <%= req.translations.saveChanges || 'Save' %>
            </button>
          </div>
        </div>

        <!-- Custom image submissions -->
        <div class="al-card p-5" id="customImagesSection">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="flex items-center gap-1.5 text-sm font-medium mb-1" style="color:var(--theme-text-strong)">
                <%- icon('image', { class: 'w-4 h-4', strokeWidth: 1.5 }) %> <%= req.translations.customImages || 'Custom images' %>
              </p>
              <p class="text-xs" style="color:var(--theme-text-muted)"><%= req.translations.customImagesDesc || 'Submit an egg JSON or import from a URL. Admins review submissions before they become usable.' %></p>
            </div>
            <a href="/my-images" class="al-btn-ghost text-xs inline-flex items-center gap-1.5 shrink-0">
              <%- icon('list', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.myImages || 'My Images' %>
            </a>
          </div>
          <% if (allowed) { %>
          <div class="mt-4">
            <button id="openSubmitBtn" type="button" class="al-btn-primary px-4 py-2 text-sm font-medium inline-flex items-center gap-1.5">
              <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
              <%= req.translations.submitImage || 'Submit Image' %>
            </button>
          </div>
          <% } else { %>
          <p class="text-xs mt-3" style="color:var(--theme-text-muted)"><%= req.translations.imageSubmissionsDisabledText || 'An administrator has turned off user image submissions.' %></p>
          <% } %>
        </div>

        <!-- Login history -->
        <div class="al-card p-5">
          <p class="text-sm font-medium mb-4" style="color:var(--theme-text-strong)"><%= req.translations.loginHistory || 'Login history' %></p>
          <div class="overflow-x-auto rounded-xl border" style="border-color:var(--theme-border)">
            <table class="al-table min-w-full text-sm">
              <colgroup>
                <col style="min-width:200px">
                <col style="min-width:140px">
                <col style="min-width:280px">
              </colgroup>
              <thead class="al-table-head">
                <tr>
                  <th class="al-table-th px-4 py-3"><%= req.translations.dateTime || 'Date & Time' %></th>
                  <th class="al-table-th px-4 py-3"><%= req.translations.ipAddress || 'IP Address' %></th>
                  <th class="al-table-th px-4 py-3"><%= req.translations.browserDevice || 'Browser / Device' %></th>
                </tr>
              </thead>
              <tbody class="divide-y" style="border-color:var(--theme-border)">
                <% if (loginHistory && loginHistory.length > 0) { %>
                  <% let loginIdx = 0; loginHistory.forEach(login => { %>
                  <tr style="--i:<%= loginIdx++ %>" class="al-table-tr transition-colors">
                    <td class="px-4 py-3 whitespace-nowrap" style="color:var(--theme-text);"><%= new Date(login.timestamp).toLocaleString() %></td>
                    <td class="px-4 py-3 whitespace-nowrap font-mono text-xs" style="color:var(--theme-text-muted);"><%= login.ipAddress || 'Unknown' %></td>
                    <td class="px-4 py-3 text-xs truncate max-w-[260px]" style="color:var(--theme-text-muted);"><%= login.userAgent || 'Unknown' %></td>
                  </tr>
                  <% }) %>
                <% } else { %>
                <tr><td colspan="3" class="px-4 py-6 text-center text-sm" style="color:var(--theme-text-muted);"><%= req.translations.noLoginHistory || 'No login history available' %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
</div>
  </div>
</main>

<div id="image-submit-data" style="display:none"
  data-submitting="<%= req.translations.submitting || 'Submitting image...' %>"
  data-submit-error="<%= req.translations.errorSubmitting || 'Failed to submit the image.' %>"
></div>

<!-- Image submission popup -->
<% if (allowed) { %>
<div id="imModal" class="al-sheet-overlay fixed inset-0 z-[60] flex items-center justify-center p-4 opacity-0 pointer-events-none">
  <div class="al-sheet-panel rounded-2xl max-w-lg w-full shadow-xl max-h-[88vh] flex flex-col will-change-transform" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= req.translations.submitImage || 'Submit Image' %></h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= req.translations.submitImageText || 'Admins review submissions before they are usable.' %></p>
      </div>
      <button type="button" id="imClose" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4">
      <div class="flex gap-1 p-1 rounded-xl mb-4" style="background:var(--theme-bg-secondary)">
        <button type="button" id="imModeManual" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition" style="color:var(--theme-text-strong); background:var(--theme-bg-card);"><%= req.translations.manualEnter || 'Enter details' %></button>
        <button type="button" id="imModeJson" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition" style="color:var(--theme-text-muted);"><%= req.translations.pasteJson || 'Paste JSON' %></button>
        <button type="button" id="imModeUrl" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition" style="color:var(--theme-text-muted);"><%= req.translations.importFromUrl || 'Import from URL' %></button>
      </div>

      <!-- Manual form -->
      <form id="imManualForm" class="flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-3">
          <div class="col-span-2"><label class="field-label">Name <span class="text-red-500">*</span></label><input class="field-input" type="text" name="name" required placeholder="e.g. My Custom Game"></div>
          <div><label class="field-label">Author</label><input class="field-input" type="text" name="author" placeholder="e.g. github.com/you"></div>
          <div><label class="field-label">Author Name</label><input class="field-input" type="text" name="authorName" placeholder="Your Name"></div>
          <div class="col-span-2"><label class="field-label">Startup Command <span class="text-red-500">*</span></label><input class="field-input" type="text" name="startup" required placeholder="java -Xms128M -jar server.jar" style="font-family:ui-monospace,monospace;font-size:12px;"></div>
          <div class="col-span-2"><label class="field-label">Docker images (JSON array) <span class="text-red-500">*</span></label><input class="field-input" type="text" name="dockerImages" required placeholder='[{"game":"ghcr.io/you/image:latest"}]' style="font-family:ui-monospace,monospace;font-size:12px;"></div>
          <div class="col-span-2"><label class="field-label">Description</label><textarea class="field-input" name="description" rows="2" placeholder="What does this image run?" style="resize:none;"></textarea></div>
          <div class="col-span-2"><label class="field-label">Variables <span class="text-neutral-400 font-normal">(JSON array, optional)</span></label><textarea class="field-input" name="variables" rows="4" placeholder="[]" style="resize:none;font-family:ui-monospace,monospace;font-size:12px;">[]</textarea></div>
        </div>
        <div class="flex gap-2 pt-1">
          <button type="button" id="imManualCancel" class="flex-1 py-2 rounded-xl border border-neutral-200 dark:border-neutral-700 text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition inline-flex items-center justify-center gap-1.5"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Cancel</button>
          <button type="submit" class="flex-1 py-2 rounded-xl border border-neutral-800/20 bg-white hover:bg-neutral-200 text-neutral-800 dark:bg-neutral-900 dark:hover:bg-neutral-800 dark:text-white text-sm font-medium shadow-lg transition inline-flex items-center justify-center gap-1.5"><%- icon('send', { class: 'size-4', strokeWidth: 1.5 }) %>Submit for review</button>
        </div>
      </form>

      <!-- JSON paste -->
      <div id="imJsonSection" class="hidden">
        <label class="field-label" for="imJsonInput">Egg JSON</label>
        <textarea id="imJsonInput" class="field-input" rows="12" placeholder='{ "name": "...", "startup": "...", "docker_images": { "game": "ghcr.io/example/image:latest" } }' style="resize:none;font-family:ui-monospace,monospace;font-size:12px;"></textarea>
        <div class="flex gap-2 pt-4">
          <button type="button" id="imJsonCancel" class="flex-1 py-2 rounded-xl border border-neutral-200 dark:border-neutral-700 text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition inline-flex items-center justify-center gap-1.5">Cancel</button>
          <button type="button" id="imSubmitJsonBtn" class="flex-1 py-2 rounded-xl border border-neutral-800/20 bg-white hover:bg-neutral-200 text-neutral-800 dark:bg-neutral-900 dark:hover:bg-neutral-800 dark:text-white text-sm font-medium shadow-lg transition inline-flex items-center justify-center gap-1.5"><%- icon('send', { class: 'size-4', strokeWidth: 1.5 }) %>Submit for review</button>
        </div>
      </div>

      <!-- URL import -->
      <div id="imUrlSection" class="hidden">
        <label class="field-label" for="imUrlInput">Image URL</label>
        <input id="imUrlInput" type="url" class="field-input" placeholder="https://raw.githubusercontent.com/…/egg.json">
        <p class="mt-2 text-xs" style="color:var(--theme-text-muted)">Fetch a Pterodactyl egg JSON from a raw URL and submit it for review.</p>
        <div class="flex gap-2 pt-4">
          <button type="button" id="imUrlCancel" class="flex-1 py-2 rounded-xl border border-neutral-200 dark:border-neutral-700 text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition inline-flex items-center justify-center gap-1.5">Cancel</button>
          <button type="button" id="imSubmitUrlBtn" class="flex-1 py-2 rounded-xl border border-neutral-800/20 bg-white hover:bg-neutral-200 text-neutral-800 dark:bg-neutral-900 dark:hover:bg-neutral-800 dark:text-white text-sm font-medium shadow-lg transition inline-flex items-center justify-center gap-1.5"><%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %>Fetch &amp; Submit</button>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<script nonce="<%- nonce %>">
window.ALMount(() => {
  const { showToast } = createToastSystem();
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  let submitting = false;

  async function post(url, data) {
    if (submitting) return { ok: false, text: 'Already saving...' };
    submitting = true;
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify(data),
      });
      const text = await res.text();
      // Surface only the server's error field, never the raw response body.
      let message = text;
      if (!res.ok) {
        try {
          const parsed = JSON.parse(text);
          message = parsed.error || parsed.message || 'Request failed';
        } catch {
          message = 'Request failed';
        }
      }
      return { ok: res.ok, text: message };
    } finally { submitting = false; }
  }

  document.getElementById('saveAccountBtn')?.addEventListener('click', async () => {
    const btn = document.getElementById('saveAccountBtn');
    btn.disabled = true;
    btn.textContent = 'Saving\u2026';
    let hasError = false;

    const username = document.getElementById('username')?.value?.trim();
    if (username) {
      const r = await post('/update-username', { newUsername: username });
      if (!r.ok) { showToast(r.text || 'Failed to update username', 'error'); hasError = true; }
      else { const sb = document.getElementById('sidebar-username'); if (sb) sb.textContent = username; }
    }

    const email = document.getElementById('email')?.value?.trim();
    if (email) {
      const r = await post('/change-email', { email });
      if (!r.ok) { showToast(r.text || 'Failed to update email', 'error'); hasError = true; }
    }

    const currentPw = document.getElementById('currentPassword')?.value?.trim();
    const newPw = document.getElementById('newPassword')?.value?.trim();
    if (currentPw && newPw) {
      const r = await post('/change-password', { currentPassword: currentPw, newPassword: newPw });
      if (!r.ok) { showToast(r.text || 'Failed to update password', 'error'); hasError = true; }
      else { showToast('Password updated.', 'success'); }
    }

    const desc = document.getElementById('description')?.value?.trim();
    if (desc !== undefined) {
      const r = await post('/update-description', { description: desc });
      if (!r.ok) { showToast(r.text || 'Failed to update description', 'error'); hasError = true; }
    }

    const lang = document.getElementById('language')?.value;
    if (lang) {
      const r = await post('/set-language', { language: lang });
      if (!r.ok) { showToast(r.text || 'Failed to update language', 'error'); hasError = true; }
    }

    btn.disabled = false;
    btn.textContent = 'Save Changes';
    if (!hasError) showToast('All changes saved.', 'success');
  });

  // Preferred node — saved on its own so creating servers lands on the
  // node the user prefers rather than the least-loaded default.
  document.getElementById('savePreferredNodeBtn')?.addEventListener('click', async () => {
    const btn = document.getElementById('savePreferredNodeBtn');
    const nodeId = document.getElementById('preferredNode')?.value;
    btn.disabled = true;
    try {
      const r = await post('/set-preferred-node', { preferredNodeId: nodeId || null });
      if (r.ok) {
        showToast(r.message || 'Preferred node saved.', 'success');
      } else {
        showToast(r.message || r.text || 'Failed to save preferred node.', 'error');
      }
    } catch {
      showToast('Failed to save preferred node.', 'error');
    } finally {
      btn.disabled = false;
    }
  });

  // Username availability check
  const usernameInput = document.getElementById('username');
  const usernameFb = document.getElementById('username-feedback');
  let usernameTimer;
  usernameInput?.addEventListener('input', () => {
    clearTimeout(usernameTimer);
    usernameTimer = setTimeout(async () => {
      const val = usernameInput.value.trim();
      if (!val) { usernameFb.textContent = ''; return; }
      try {
        const res = await fetch(`/check-username?username=${encodeURIComponent(val)}`);
        const { exists } = await res.json();
        usernameFb.textContent = exists ? '<%= req.translations.usernameTaken || "Username taken" %>' : '<%= req.translations.usernameIsNotTaken || "Username available" %>';
      } catch (err) { console.error('Username check failed:', err); }
    }, 500);
  });

  // Password validation
  const currentPwInput = document.getElementById('currentPassword');
  const newPwInput = document.getElementById('newPassword');
  const pwFeedback = document.getElementById('current-password-feedback');
  let pwTimer;
  currentPwInput?.addEventListener('input', () => {
    clearTimeout(pwTimer);
    const val = currentPwInput.value.trim();
    if (!val) { pwFeedback.textContent = ''; newPwInput.disabled = true; newPwInput.value = ''; return; }
    pwTimer = setTimeout(async () => {
      try {
        const res = await fetch('/validate-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
          body: JSON.stringify({ currentPassword: val }),
        });
        const { valid } = await res.json();
        pwFeedback.textContent = valid ? '<%= req.translations.correctPassword || "Correct" %>' : '<%= req.translations.incorrectPassword || "Incorrect password" %>';
        newPwInput.disabled = !valid;
      } catch (err) { console.error('Password validation failed:', err); pwFeedback.textContent = 'Could not validate'; newPwInput.disabled = true; }
    }, 500);
  });

  // Avatar
  const avatarInput = document.getElementById('avatar-input');
  const avatarPreview = document.getElementById('avatar-preview');
  avatarInput?.addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
      const MAX_AVATAR_SIZE = 2 * 1024 * 1024;
      if (file.size > MAX_AVATAR_SIZE) { showToast('Image must be under 2 MB', 'error'); return; }
    const reader = new FileReader();
    reader.onload = evt => openCropPopup(evt.target.result, csrfToken);
    reader.readAsDataURL(file);
    avatarInput.value = '';
  });

  document.getElementById('remove-avatar-btn')?.addEventListener('click', async () => {
    const res = await fetch('/remove-avatar', { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken } });
    if (res.ok) {
      avatarPreview.src = '/avatar/<%= encodeURIComponent(user.username) %>';
      const removeAvatarBtn = document.getElementById('remove-avatar-btn');
      if (removeAvatarBtn) removeAvatarBtn.style.display = 'none';
      showToast('Profile picture removed.', 'success');
    } else showToast('Something went wrong.', 'error');
  });

  // Disable 2FA (requires current password)
  document.getElementById('disable2faBtn')?.addEventListener('click', async () => {
    const password = document.getElementById('disable2faPassword')?.value || '';
    if (!password) { showToast('Enter your current password to disable 2FA.', 'error'); return; }
    const btn = document.getElementById('disable2faBtn');
    btn.disabled = true;
    try {
      const res = await fetch('/account/2fa/disable', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({ password }),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Two-factor authentication disabled.', 'success');
        const twofaStatus = document.getElementById('twofa-status');
        if (twofaStatus) al.patchEl(twofaStatus, '<p class="text-sm mb-3" style="color:var(--theme-text-muted)">Add an extra layer of security to your account.</p><a href="/account/2fa/setup" class="al-btn-primary text-sm inline-flex">Set up 2FA</a>');
      } else {
        showToast(data.error || 'Failed to disable 2FA.', 'error');
      }
    } catch (err) {
      console.error('Failed to disable 2FA:', err);
      showToast('Something went wrong.', 'error');
    }
    btn.disabled = false;
  });

  function openCropPopup(dataUrl, csrf) {
    const overlay = document.createElement('div');
    overlay.className = 'al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center p-4';
    overlay.innerHTML = `
      <div class="al-sheet-panel rounded-2xl shadow-lg border w-full max-w-lg overflow-hidden" style="background:var(--theme-bg-card);border-color:var(--theme-border);">
        <div class="flex items-center justify-between px-5 pt-5 pb-3 border-b" style="border-color:var(--theme-border);">
          <div>
            <p class="text-sm font-semibold" style="color:var(--theme-text-strong);">Position your photo</p>
            <p class="text-xs mt-0.5" style="color:var(--theme-text-muted);">Drag and resize the selection box.</p>
          </div>
          <button type="button" id="crop-cancel" class="w-9 h-9 flex items-center justify-center rounded-lg hover:opacity-75 transition" style="color:var(--theme-text-muted);">
            <%- icon('x', { class: 'w-4 h-4', strokeWidth: 2 }) %>
          </button>
        </div>
        <div class="relative bg-neutral-900 dark:bg-neutral-950 select-none overflow-hidden" style="height:340px" id="crop-stage">
          <img id="crop-img" src="${dataUrl}" draggable="false" alt="Crop preview" style="position:absolute;top:0;left:0;user-select:none;max-width:none"/>
          <div id="crop-box" style="position:absolute;border:2px solid white;box-shadow:0 0 0 9999px rgba(0,0,0,0.55);cursor:move;box-sizing:border-box">
            <div class="crop-handle" data-dir="nw" style="position:absolute;top:-5px;left:-5px;width:10px;height:10px;background:white;border-radius:50%;cursor:nw-resize"></div>
            <div class="crop-handle" data-dir="ne" style="position:absolute;top:-5px;right:-5px;width:10px;height:10px;background:white;border-radius:50%;cursor:ne-resize"></div>
            <div class="crop-handle" data-dir="sw" style="position:absolute;bottom:-5px;left:-5px;width:10px;height:10px;background:white;border-radius:50%;cursor:sw-resize"></div>
            <div class="crop-handle" data-dir="se" style="position:absolute;bottom:-5px;right:-5px;width:10px;height:10px;background:white;border-radius:50%;cursor:se-resize"></div>
          </div>
        </div>
        <div class="flex gap-3 px-5 py-4 border-t" style="border-color:var(--theme-border);">
          <button type="button" id="crop-cancel-btn" class="flex-1 rounded-xl border py-2.5 text-sm font-medium transition hover:opacity-85" style="border-color:var(--theme-btn-secondary-border);background:var(--theme-btn-secondary-bg);color:var(--theme-btn-secondary-text);">Cancel</button>
          <button type="button" id="crop-save" class="flex-1 rounded-xl py-2.5 text-sm font-medium transition hover:opacity-85" style="background:var(--theme-btn-primary-bg);color:var(--theme-btn-primary-text);">Save photo</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    Animate.openModal(overlay, overlay.querySelector('.al-sheet-panel'));

    const stage = document.getElementById('crop-stage');
    const img   = document.getElementById('crop-img');
    const box   = document.getElementById('crop-box');
    const stageW = stage.offsetWidth, stageH = stage.offsetHeight;

    img.onload = () => {
      const scale = Math.min(stageW / img.naturalWidth, stageH / img.naturalHeight);
      const dw = img.naturalWidth * scale, dh = img.naturalHeight * scale;
      img.style.width = dw + 'px'; img.style.height = dh + 'px';
      img.style.left = ((stageW - dw) / 2) + 'px'; img.style.top = ((stageH - dh) / 2) + 'px';
      img._scale = scale; img._offX = (stageW - dw) / 2; img._offY = (stageH - dh) / 2;
      const bs = Math.min(dw, dh, 200);
      box.style.width = bs + 'px'; box.style.height = bs + 'px';
      box.style.left = ((stageW - bs) / 2) + 'px'; box.style.top = ((stageH - bs) / 2) + 'px';
    };
    if (img.complete) img.onload();

    let action = null, sx, sy, sb;
    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

    box.addEventListener('mousedown', e => {
      if (e.target.classList.contains('crop-handle')) return;
      e.preventDefault(); action = 'move'; sx = e.clientX; sy = e.clientY;
      sb = { l: parseInt(box.style.left), t: parseInt(box.style.top), w: box.offsetWidth, h: box.offsetHeight };
    });
    box.querySelectorAll('.crop-handle').forEach(h => h.addEventListener('mousedown', e => {
      e.preventDefault(); e.stopPropagation(); action = h.dataset.dir; sx = e.clientX; sy = e.clientY;
      sb = { l: parseInt(box.style.left), t: parseInt(box.style.top), w: box.offsetWidth, h: box.offsetHeight };
    }));

    const onUp = () => action = null;
    const onMove = e => {
      if (!action) return;
      const dx = e.clientX - sx, dy = e.clientY - sy, min = 60;
      if (action === 'move') {
        box.style.left = clamp(sb.l + dx, 0, stageW - sb.w) + 'px';
        box.style.top  = clamp(sb.t + dy, 0, stageH - sb.h) + 'px';
      } else {
        let l = sb.l, t = sb.t, w = sb.w, h = sb.h;
        if (action.includes('e')) w = Math.max(min, sb.w + dx);
        if (action.includes('s')) h = Math.max(min, sb.h + dy);
        if (action.includes('w')) { const nw = Math.max(min, sb.w - dx); l = sb.l + (sb.w - nw); w = nw; }
        if (action.includes('n')) { const nh = Math.max(min, sb.h - dy); t = sb.t + (sb.h - nh); h = nh; }
        l = clamp(l, 0, stageW - min); t = clamp(t, 0, stageH - min);
        w = Math.min(w, stageW - l); h = Math.min(h, stageH - t);
        box.style.left = l + 'px'; box.style.top = t + 'px';
        box.style.width = w + 'px'; box.style.height = h + 'px';
      }
    };

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);

    const close = () => {
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      Animate.closeModal(overlay, overlay.querySelector('.al-sheet-panel'), () => overlay.remove());
    };
    document.getElementById('crop-cancel').addEventListener('click', close);
    document.getElementById('crop-cancel-btn').addEventListener('click', close);

    document.getElementById('crop-save').addEventListener('click', () => {
      const scale = img._scale, offX = img._offX, offY = img._offY;
      const boxL = parseInt(box.style.left), boxT = parseInt(box.style.top);
      const canvas = document.createElement('canvas');
      canvas.width = 256; canvas.height = 256;
      canvas.getContext('2d').drawImage(img, (boxL - offX) / scale, (boxT - offY) / scale, box.offsetWidth / scale, box.offsetHeight / scale, 0, 0, 256, 256);
      canvas.toBlob(async blob => {
        const form = new FormData();
        form.append('avatar', blob, 'avatar.png');
        try {
          const res = await fetch('/upload-avatar', { method: 'POST', headers: { 'CSRF-Token': csrf }, body: form });
          if (res.ok) {
            const { avatar } = await res.json();
            avatarPreview.src = avatar + '?t=' + Date.now();
            showToast('Profile picture updated.', 'success');
            close();
          } else showToast('Failed to upload', 'error');
        } catch (err) { console.error('Avatar upload failed:', err); showToast('Failed to upload', 'error'); }
      }, 'image/png');
    });
  }
});
</script>

<% if (allowed) { %>
<script nonce="<%- nonce %>">
(function() {
  const pd = document.getElementById('image-submit-data')?.dataset || {};

  const modal = document.getElementById('imModal');
  if (!modal) return;

  function openModal() {
    modal.classList.remove('opacity-0', 'pointer-events-none');
  }
  function closeModal() {
    modal.classList.add('opacity-0', 'pointer-events-none');
  }

  function setMode(mode) {
    const manual = document.getElementById('imManualForm');
    const json = document.getElementById('imJsonSection');
    const url = document.getElementById('imUrlSection');
    const manualBtn = document.getElementById('imModeManual');
    const jsonBtn = document.getElementById('imModeJson');
    const urlBtn = document.getElementById('imModeUrl');
    manual.classList.toggle('hidden', mode !== 'manual');
    json.classList.toggle('hidden', mode !== 'json');
    url.classList.toggle('hidden', mode !== 'url');
    manualBtn.style.background = mode === 'manual' ? 'var(--theme-bg-card)' : 'transparent';
    jsonBtn.style.background = mode === 'json' ? 'var(--theme-bg-card)' : 'transparent';
    urlBtn.style.background = mode === 'url' ? 'var(--theme-bg-card)' : 'transparent';
    manualBtn.style.color = mode === 'manual' ? 'var(--theme-text-strong)' : 'var(--theme-text-muted)';
    jsonBtn.style.color = mode === 'json' ? 'var(--theme-text-strong)' : 'var(--theme-text-muted)';
    urlBtn.style.color = mode === 'url' ? 'var(--theme-text-strong)' : 'var(--theme-text-muted)';
  }

function loader() {
    try {
      return showLoadingPopup(pd.submitting, '');
    } catch {
      return { close: function() {}, updateProgress: function() {} };
    }
  }

  function goToMyImages() {
    setTimeout(function() { window.location.href = '/my-images'; }, 1000);
  }

  document.getElementById('openSubmitBtn')?.addEventListener('click', openModal);
  document.getElementById('imClose')?.addEventListener('click', closeModal);
  document.getElementById('imManualCancel')?.addEventListener('click', closeModal);
  document.getElementById('imJsonCancel')?.addEventListener('click', closeModal);
  document.getElementById('imUrlCancel')?.addEventListener('click', closeModal);

  document.getElementById('imModeManual').addEventListener('click', function() { setMode('manual'); });
  document.getElementById('imModeJson').addEventListener('click', function() { setMode('json'); });
  document.getElementById('imModeUrl').addEventListener('click', function() { setMode('url'); });
  setMode('manual');

  document.getElementById('imManualForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const l = loader();
    try {
      const payload = new FormData(this);
      const data = {};
      for (const [key, value] of payload.entries()) data[key] = value;
      const response = await fetch('/my-images/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json();
      l.close();
      if (result.error && !result.success) {
        showToast(result.error, 'error');
      } else {
        showToast(result.message || 'Submitted', 'success');
        goToMyImages();
      }
    } catch (error) {
      l.close();
      console.error('Failed to submit image:', error);
      showToast(pd.submitError || 'Failed to submit the image.', 'error');
    }
  });

  document.getElementById('imSubmitJsonBtn').addEventListener('click', async function() {
    const raw = document.getElementById('imJsonInput').value;
    if (!raw.trim()) { showToast('Paste an egg JSON first.', 'error'); return; }
    let payload;
    try {
      payload = JSON.parse(raw);
    } catch {
      showToast('Invalid JSON.', 'error');
      return;
    }
    const l = loader();
    try {
      const response = await fetch('/my-images/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      l.close();
      if (result.error && !result.success) {
        showToast(result.error, 'error');
      } else {
        showToast(result.message || 'Submitted', 'success');
        goToMyImages();
      }
    } catch (error) {
      l.close();
      console.error('Failed to submit image:', error);
      showToast(pd.submitError || 'Failed to submit the image.', 'error');
    }
  });

  document.getElementById('imSubmitUrlBtn').addEventListener('click', async function() {
    const url = document.getElementById('imUrlInput').value;
    if (!url.trim()) { showToast('Please enter an image URL.', 'error'); return; }
    const l = loader();
    try {
      const response = await fetch('/my-images/import-url', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: url.trim() }),
      });
      const result = await response.json();
      l.close();
      if (result.error && !result.success) {
        showToast(result.error, 'error');
      } else {
        showToast(result.message || 'Imported', 'success');
        goToMyImages();
      }
    } catch (error) {
      l.close();
      console.error('Failed to import image:', error);
      showToast(pd.submitError || 'Failed to submit the image.', 'error');
    }
  });

  if (window.location.hash === '#submit-image') {
    openModal();
  }
})();
</script>
<% } %>

