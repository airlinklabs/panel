<%- include('../layouts/user', { title: t('accountSettings') }) %>
<%
  /* Image review status → badge variant + translated label (the status
     value itself comes from the API in English). */
  function imageStatusClass(status) {
    if (status === 'approved') { return 'al-badge-online'; }
    if (status === 'pending') { return 'al-badge-warning'; }
    return 'al-badge-offline';
  }
  function imageStatusLabel(status) {
    if (status === 'approved') { return t('approved'); }
    if (status === 'pending') { return t('pending'); }
    if (status === 'rejected') { return t('rejected'); }
    return t('unknown');
  }
%>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('accountSettings') %></h1>
    <p class="al-page-desc"><%= t('manageYourAccount') %></p>
  </div>
  <div>
    <div class="al-segmented" role="group">
      <button type="button" class="al-segmented-btn" data-tab="profile" aria-pressed="true"><%= t('profile') %></button>
      <button type="button" class="al-segmented-btn" data-tab="security" aria-pressed="false"><%= t('security') %></button>
      <button type="button" class="al-segmented-btn" data-tab="images" aria-pressed="false"><%= t('images') %></button>
      <button type="button" class="al-segmented-btn" data-tab="folders" aria-pressed="false"><%= t('folders') %></button>
    </div>
  </div>
</header>

<div class="al-page-body">

  <!-- Profile Tab -->
  <div id="tab-profile" class="tab-content mt-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

      <!-- Avatar -->
      <section class="al-form-card">
        <h3 class="al-form-card-title mb-4"><%= t('avatar') %></h3>
        <div class="flex items-center gap-4">
          <img id="avatarPreview"
            src="<%= account.avatar ? account.avatar : '/avatar/' + encodeURIComponent(account.username) %>"
            class="al-avatar al-avatar-lg object-cover" alt="<%= account.username %>">
          <div>
            <form id="avatarForm" enctype="multipart/form-data">
              <input type="file" id="avatarInput" name="avatar" accept="image/*" class="hidden">
              <button type="button" onclick="document.getElementById('avatarInput').click()"
                class="al-btn al-btn-secondary"><%= t('uploadAvatar') %></button>
            </form>
            <% if (account.avatar) { %>
            <button type="button" onclick="removeAvatar()"
              class="al-btn al-btn-ghost mt-1.5" style="color:var(--theme-danger)"><%= t('removeAvatar') %></button>
            <% } %>
          </div>
        </div>
      </section>

      <!-- Username -->
      <section class="al-form-card">
        <h3 class="al-form-card-title mb-4"><label for="username"><%= t('username') %></label></h3>
        <form id="usernameForm">
          <div class="al-form-field">
            <input type="text" id="username" name="username" value="<%= account.username %>"
              class="al-form-input" minlength="3" maxlength="32" pattern="[a-zA-Z0-9_-]+">
          </div>
          <button type="submit" class="al-btn al-btn-primary mt-3"><%= t('saveChanges') %></button>
        </form>
      </section>

      <!-- Email -->
      <section class="al-form-card">
        <h3 class="al-form-card-title mb-4"><label for="email"><%= t('email') %></label></h3>
        <form id="emailForm">
          <div class="al-form-field">
            <input type="email" id="email" name="email" value="<%= account.email %>"
              class="al-form-input">
          </div>
          <button type="submit" class="al-btn al-btn-primary mt-3"><%= t('saveChanges') %></button>
        </form>
      </section>

      <!-- Description -->
      <section class="al-form-card">
        <h3 class="al-form-card-title mb-4"><label for="description"><%= t('description') %></label></h3>
        <form id="descriptionForm">
          <div class="al-form-field">
            <textarea id="description" name="description" class="al-form-textarea" rows="3"
              maxlength="500"><%= account.description || '' %></textarea>
          </div>
          <button type="submit" class="al-btn al-btn-primary mt-3"><%= t('saveChanges') %></button>
        </form>
      </section>

      <!-- Preferred Node -->
      <section class="al-form-card">
        <h3 class="al-form-card-title mb-4"><label for="preferredNodeId"><%= t('preferredNode') %></label></h3>
        <form id="preferredNodeForm">
          <div class="al-form-field">
            <select id="preferredNodeId" name="preferredNodeId" class="al-form-select">
              <option value="" <%= !account.preferredNodeId ? 'selected' : '' %>><%= t('auto') %></option>
            </select>
          </div>
          <button type="submit" class="al-btn al-btn-primary mt-3"><%= t('saveChanges') %></button>
        </form>
      </section>

      <!-- Language -->
      <section class="al-form-card">
        <h3 class="al-form-card-title mb-4"><label for="language"><%= t('language') %></label></h3>
        <form id="languageForm">
          <div class="al-form-field">
            <select id="language" name="language" class="al-form-select">
              <option value="en">English</option>
              <option value="es">Espanol</option>
              <option value="fr">Francais</option>
              <option value="de">Deutsch</option>
              <option value="pt">Portugues</option>
              <option value="tr">Turkce</option>
            </select>
          </div>
          <button type="submit" class="al-btn al-btn-primary mt-3"><%= t('saveChanges') %></button>
        </form>
      </section>

    </div>
  </div>

  <!-- Security Tab -->
  <div id="tab-security" class="tab-content mt-4 hidden">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

      <!-- Change Password -->
      <section class="al-form-card">
        <h3 class="al-form-card-title mb-4"><%= t('changePassword') %></h3>
        <form id="passwordForm">
          <div class="al-form-field">
            <label class="al-form-label" for="currentPassword"><%= t('currentPassword') %></label>
            <input type="password" id="currentPassword" name="currentPassword" class="al-form-input" required>
          </div>
          <div class="al-form-field mt-3">
            <label class="al-form-label" for="newPassword"><%= t('newPassword') %></label>
            <input type="password" id="newPassword" name="newPassword" class="al-form-input" minlength="8" required>
          </div>
          <button type="submit" class="al-btn al-btn-primary mt-3"><%= t('changePassword') %></button>
        </form>
      </section>

      <!-- 2FA -->
      <section class="al-form-card">
        <div class="flex items-center justify-between gap-3 mb-4">
          <h3 class="al-form-card-title"><%= t('twoFactorAuth') %></h3>
          <% if (account.totpEnabled) { %>
          <span class="al-badge al-badge-online"><%= t('enabled') %></span>
          <% } else { %>
          <span class="al-badge al-badge-offline"><%= t('disabled') %></span>
          <% } %>
        </div>
        <% if (account.totpEnabled) { %>
        <button type="button" onclick="disable2FA()" class="al-btn al-btn-danger-outline"><%= t('disable2FA') %></button>
        <% } else { %>
        <button type="button" onclick="setup2FA()" class="al-btn al-btn-primary"><%= t('enabled2FA') %></button>
        <% } %>
        <div id="twofa-setup" class="hidden mt-3">
          <div id="qr-container" class="al-code-wrap mb-3"></div>
          <div class="al-form-field">
            <label class="al-form-label" for="totpCode"><%= t('field2faCode') %></label>
            <input type="text" id="totpCode" class="al-form-input font-mono" maxlength="6" pattern="[0-9]{6}"
              placeholder="<%= t('field2faCodePlaceholder') %>" aria-describedby="totpCode-help">
            <p class="al-form-help" id="totpCode-help"><%= t('cantScanKey') %></p>
          </div>
          <button type="button" onclick="verify2FA()" class="al-btn al-btn-primary mt-3"><%= t('verifyAndEnable') %></button>
        </div>
      </section>

      <!-- 2FA Recovery Codes -->
      <div id="two-factor-recovery-codes" class="hidden al-form-card sm:col-span-2 max-w-xl">
        <div class="flex items-start gap-3 mb-4">
          <span class="al-icon-tile al-icon-tile-sm al-icon-tile-accent shrink-0"><%- icon('key-round', { class: 'size-4' }) %></span>
          <div class="min-w-0">
            <h3 class="al-form-card-title"><%= t('savedRecoveryCodes') %></h3>
            <p class="al-form-card-desc"><%= t('recoveryCodesDesc') %></p>
          </div>
        </div>
        <div id="recoveryCodesList" class="grid grid-cols-2 sm:grid-cols-3 gap-2"></div>
        <div class="flex flex-wrap items-center justify-between gap-3 mt-5">
          <button type="button" id="copyRecoveryCodes" class="al-btn al-btn-ghost">
            <%- icon('copy', { class: 'size-4' }) %>
            <%= t('copyAll') %>
          </button>
          <a href="/account" class="al-btn al-btn-primary"><%= t('iveSavedThem') %></a>
        </div>
      </div>

    </div>
  </div>

  <!-- Images Tab -->
  <div id="tab-images" class="tab-content mt-4 hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <h2 class="al-section-title"><%= t('myImages') %></h2>
      <div class="flex gap-2">
        <button type="button" onclick="showImportModal()" class="al-btn al-btn-secondary">
          <%- icon('download', { class: 'size-4' }) %> <%= t('importFromUrl') %>
        </button>
        <a href="/my-images/new" class="al-btn al-btn-primary">
          <%- icon('plus', { class: 'size-4' }) %> <%= t('newImage') %>
        </a>
      </div>
    </div>

    <% if (!Array.isArray(images) || images.length === 0) { %>
      <%- include('../partials/empty-state', {
        iconName: 'box',
        title: t('noImagesYet'),
        description: t('submitYourFirstImage')
      }) %>
    <% } else { %>
    <div class="al-table-wrapper">
      <table class="al-table">
        <thead class="al-table-thead">
          <tr>
            <th scope="col" class="al-table-th"><%= t('name') %></th>
            <th scope="col" class="al-table-th"><%= t('status') %></th>
            <th scope="col" class="al-table-th"><%= t('author') %></th>
            <th scope="col" class="al-table-th"><span class="sr-only"><%= t('actions') %></span></th>
          </tr>
        </thead>
        <tbody>
          <% images.forEach(function(img) { %>
          <tr class="al-table-tr">
            <td class="al-table-td">
              <span class="al-table-cell-strong"><%= img.name %></span>
            </td>
            <td class="al-table-td">
              <span class="al-badge <%= imageStatusClass(img.status) %>"><%= imageStatusLabel(img.status) %></span>
            </td>
            <td class="al-table-td">
              <span class="text-xs al-text-muted"><%= img.author || '' %></span>
            </td>
            <td class="al-table-td">
              <div class="flex items-center gap-1">
                <a href="/my-images/edit/<%= img.id %>" class="al-btn al-btn-ghost al-btn-icon-only"
                  title="<%= t('edit') %>" aria-label="<%= t('edit') %>">
                  <%- icon('pencil', { class: 'size-4' }) %>
                </a>
                <button type="button" onclick="deleteImage(<%= img.id %>, '<%= img.name %>')"
                  class="al-btn al-btn-ghost al-btn-icon-only" style="color:var(--theme-danger)"
                  title="<%= t('delete') %>" aria-label="<%= t('delete') %>">
                  <%- icon('trash-2', { class: 'size-4' }) %>
                </button>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <!-- Folders Tab -->
  <div id="tab-folders" class="tab-content mt-4 hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <h2 class="al-section-title"><%= t('serverFolders') %></h2>
      <button type="button" onclick="showCreateFolder()" class="al-btn al-btn-primary">
        <%- icon('plus', { class: 'size-4' }) %> <%= t('createFolder') %>
      </button>
    </div>

    <div id="create-folder-form" class="hidden mb-4">
      <div class="al-form-card">
        <form id="newFolderForm" class="flex flex-col sm:flex-row gap-2">
          <div class="al-form-field flex-1 min-w-0">
            <label class="sr-only" for="folderName"><%= t('folderName') %></label>
            <input type="text" id="folderName" class="al-form-input" placeholder="<%= t('folderName') %>" maxlength="64" required>
          </div>
          <button type="submit" class="al-btn al-btn-primary"><%= t('create') %></button>
          <button type="button" onclick="hideCreateFolder()" class="al-btn al-btn-ghost"><%= t('cancel') %></button>
        </form>
      </div>
    </div>

    <% if (!Array.isArray(folders) || folders.length === 0) { %>
      <%- include('../partials/empty-state', {
        iconName: 'folder',
        title: t('noFolders'),
        description: t('createFoldersToOrganize')
      }) %>
    <% } else { %>
    <div class="flex flex-col gap-3">
      <% folders.forEach(function(folder) { %>
      <div class="al-card flex flex-wrap items-center justify-between gap-3" data-folder-id="<%= folder.id %>">
        <div class="flex items-center gap-2 min-w-0">
          <%- icon('folder', { class: 'w-4 h-4 shrink-0', style: 'color:var(--theme-text-muted)' }) %>
          <span class="al-table-cell-strong truncate"><%= folder.name %></span>
          <% if (folder.members) { %>
          <span class="al-badge al-badge-neutral font-mono"><%= folder.members.length %> <%= t('servers') %></span>
          <% } %>
        </div>
        <div class="flex items-center gap-1">
          <button type="button" onclick="renameFolder(<%= folder.id %>, '<%= folder.name %>')"
            class="al-btn al-btn-ghost al-btn-icon-only" title="<%= t('rename') %>" aria-label="<%= t('rename') %>">
            <%- icon('pencil', { class: 'size-4' }) %>
          </button>
          <button type="button" onclick="deleteFolder(<%= folder.id %>, '<%= folder.name %>')"
            class="al-btn al-btn-ghost al-btn-icon-only" style="color:var(--theme-danger)"
            title="<%= t('delete') %>" aria-label="<%= t('delete') %>">
            <%- icon('trash-2', { class: 'size-4' }) %>
          </button>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>

</div>

<script nonce="<%- nonce %>">
(function() {
  // Tab switching — the segmented control carries state on aria-pressed.
  var tabs = document.querySelectorAll('.al-segmented-btn');
  var contents = document.querySelectorAll('.tab-content');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(function(t) { t.setAttribute('aria-pressed', t === tab ? 'true' : 'false'); });
      contents.forEach(function(c) { c.classList.add('hidden'); });
      document.getElementById('tab-' + tab.dataset.tab).classList.remove('hidden');
    });
  });

  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

  // Username form
  document.getElementById('usernameForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    try {
      var r = await fetch('/update-username', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ username: document.getElementById('username').value })
      });
      if (r.ok) { showToast('<%= t("usernameUpdated") %>', 'success'); }
      else { var d = await r.text(); showToast(d, 'error'); }
    } catch(err) { showToast('<%= t("failedToUpdate") %>', 'error'); }
  });

  // Email form
  document.getElementById('emailForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    try {
      var r = await fetch('/change-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ email: document.getElementById('email').value })
      });
      if (r.ok) { showToast('<%= t("emailUpdated") %>', 'success'); }
      else { var d = await r.text(); showToast(d, 'error'); }
    } catch(err) { showToast('<%= t("failedToUpdate") %>', 'error'); }
  });

  // Description form
  document.getElementById('descriptionForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    try {
      var r = await fetch('/update-description', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ description: document.getElementById('description').value })
      });
      if (r.ok) { showToast('<%= t("descriptionUpdated") %>', 'success'); }
      else { var d = await r.text(); showToast(d, 'error'); }
    } catch(err) { showToast('<%= t("failedToUpdate") %>', 'error'); }
  });

  // Password form
  document.getElementById('passwordForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    try {
      var r = await fetch('/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({
          currentPassword: document.getElementById('currentPassword').value,
          newPassword: document.getElementById('newPassword').value
        })
      });
      if (r.ok) { showToast('<%= t("passwordUpdated") %>', 'success'); document.getElementById('passwordForm').reset(); }
      else { var d = await r.text(); showToast(d, 'error'); }
    } catch(err) { showToast('<%= t("failedToUpdate") %>', 'error'); }
  });

  // Avatar upload
  document.getElementById('avatarInput').addEventListener('change', async function(e) {
    var file = e.target.files[0];
    if (!file) return;
    var fd = new FormData();
    fd.append('avatar', file);
    try {
      var r = await fetch('/upload-avatar', { method: 'POST', headers: { 'x-csrf-token': csrfToken }, body: fd });
      if (r.ok) { showToast('<%= t("profilePictureUpdated") %>', 'success'); window.location.reload(); }
      else { showToast('<%= t("failedToUpload") %>', 'error'); }
    } catch(err) { showToast('<%= t("failedToUpload") %>', 'error'); }
  });

  // Folders
  window.showCreateFolder = function() { document.getElementById('create-folder-form').classList.remove('hidden'); };
  window.hideCreateFolder = function() { document.getElementById('create-folder-form').classList.add('hidden'); };

  document.getElementById('newFolderForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var name = document.getElementById('folderName').value.trim();
    if (!name) return;
    try {
      var r = await fetch('/api/folders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ name: name })
      });
      if (r.ok) { showToast('<%= t("folderCreated") %>', 'success'); window.location.reload(); }
      else { showToast('<%= t("failedToCreate") %>', 'error'); }
    } catch(err) { showToast('<%= t("failedToCreate") %>', 'error'); }
  });

  window.deleteFolder = function(id, name) {
    window.modal.confirm({
      title: '<%= t("deleteFolder") %>',
      body: '<%= t("deleteFolderConfirm") %> "' + name + '"?',
      danger: true,
      confirmLabel: '<%= t("delete") %>',
      onConfirm: async function() {
        try {
          var r = await fetch('/api/folders/' + id, { method: 'DELETE', headers: { 'x-csrf-token': csrfToken } });
          if (r.ok) { showToast('<%= t("folderDeleted") %>', 'success'); window.location.reload(); }
          else { showToast('<%= t("failedToDelete") %>', 'error'); }
        } catch(err) { showToast('<%= t("failedToDelete") %>', 'error'); }
      }
    });
  };

  window.renameFolder = function(id, currentName) {
    var newName = prompt('<%= t("enterNewName") %>', currentName);
    if (newName && newName.trim()) {
      fetch('/api/folders/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ name: newName.trim() })
      }).then(function(r) { if (r.ok) window.location.reload(); });
    }
  };

  // Images
  window.deleteImage = function(id, name) {
    window.modal.confirm({
      title: '<%= t("deleteImage") %>',
      body: '<%= t("deleteImageConfirm") %> "' + name + '"?',
      danger: true,
      confirmLabel: '<%= t("delete") %>',
      onConfirm: async function() {
        try {
          var r = await fetch('/my-images/' + id, { method: 'DELETE', headers: { 'x-csrf-token': csrfToken } });
          if (r.ok) { showToast('<%= t("imageDeleted") %>', 'success'); window.location.reload(); }
          else { showToast('<%= t("failedToDelete") %>', 'error'); }
        } catch(err) { showToast('<%= t("failedToDelete") %>', 'error'); }
      }
    });
  };

  window.showImportModal = function() {
    var url = prompt('<%= t("enterImageUrl") %>');
    if (url && url.trim()) {
      fetch('/my-images/import-url', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ url: url.trim() })
      }).then(function(r) {
        if (r.ok) { showToast('<%= t("imageImported") %>', 'success'); window.location.reload(); }
        else { showToast('<%= t("imageImportFailed") %>', 'error'); }
      }).catch(function() { showToast('<%= t("imageImportFailed") %>', 'error'); });
    }
  };

  // 2FA
  window.setup2FA = async function() {
    try {
      var r = await fetch('/account/2fa/setup', { headers: { 'x-csrf-token': csrfToken } });
      var data = await r.json();
      if (data.otpauthUrl) {
        document.getElementById('twofa-setup').classList.remove('hidden');
        document.getElementById('qr-container').innerHTML =
          '<pre class="al-code"><code>' + escHtml(data.otpauthUrl) + '</code></pre>';
      }
    } catch(err) { showToast('<%= t("twoFactorSetupFailed") %>', 'error'); }
  };

  window.verify2FA = async function() {
    var code = document.getElementById('totpCode').value;
    if (!code || code.length !== 6) return;
    try {
      var r = await fetch('/account/2fa/enable', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ code: code })
      });
      var data = await r.json();
      if (data.enabled) {
        showToast('<%= t("twoFactorEnabled") %>', 'success');
        // Populate recovery codes
        var list = document.getElementById('recoveryCodesList');
        list.innerHTML = '';
        if (Array.isArray(data.recoveryCodes)) {
          data.recoveryCodes.forEach(function(code) {
            var el = document.createElement('div');
            el.className = 'al-badge al-badge-neutral font-mono justify-center';
            el.textContent = code;
            list.appendChild(el);
          });
        }
        // Wire copy button
        document.getElementById('copyRecoveryCodes').addEventListener('click', function() {
          var codes = Array.isArray(data.recoveryCodes) ? data.recoveryCodes.join('\n') : '';
          navigator.clipboard.writeText(codes).then(function() { showToast('<%= t("copied") %>', 'success'); });
        });
        // Show recovery codes panel
        document.getElementById('two-factor-recovery-codes').classList.remove('hidden');
      }
      else { showToast(data.error || '<%= t("invalidVerificationCode") %>', 'error'); }
    } catch(err) { showToast('<%= t("twoFactorSetupFailed") %>', 'error'); }
  };

  window.disable2FA = async function() {
    window.modal.confirm({
      title: '<%= t("disable2FA") %>',
      body: '<%= t("disable2FAConfirm") %>',
      danger: true,
      confirmLabel: '<%= t("disable") %>',
      onConfirm: async function() {
        try {
          var r = await fetch('/account/2fa/disable', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken } });
          if (r.ok) { showToast('<%= t("twoFactorDisabled") %>', 'success'); window.location.reload(); }
        } catch(err) { showToast('<%= t("failedToDisable2fa") %>', 'error'); }
      }
    });
  };

  // Check hash for tab
  var hash = window.location.hash.replace('#', '');
  if (hash && document.getElementById('tab-' + hash)) {
    var hashTab = document.querySelector('[data-tab="' + hash + '"]');
    if (hashTab) { hashTab.click(); }
  }
})();
</script>

