<%- include('../../components/header', { title: 'Schedules' }) %>

<main class="h-screen m-auto text-neutral-800 dark:text-white">
  <div class="flex h-full">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-16 pb-12 lg:pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Dashboard', href: '/' },
        { label: server.name, href: '/server/' + server.UUID },
        { label: 'Schedules' }
      ] }) %>
      <!-- Page Header: title + meta left, buttons right -->
      <div class="px-4 sm:px-8 pt-4 pb-2 sm:pb-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <!-- Server meta: image · node · id -->
            <%- include('../../components/serverMeta') %>
          </div>
          <div class="flex gap-2 shrink-0">
            <button id="addScheduleBtn" onclick="openAddScheduleModal()" type="button"
                class="al-btn-primary block rounded-xl px-3 py-2 text-center text-sm font-medium shadow-lg transition duration-300">
                <%- icon('plus', { class: 'size-4 inline-flex mr-1 mb-0.5', strokeWidth: 1.5 }) %>
                New Schedule
            </button>
          </div>
        </div>
      </div>

      <%- include('../../components/installHeader') %>

      <!-- Server Template -->
      <%- include('../../components/serverTemplate') %>

      <div id="server-page-body">

      <!-- Schedules -->
      <div class="px-6 mt-8">
        <div class="al-card rounded-xl overflow-hidden p-0">
          <div class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-6 py-3.5 border-b" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
            <div>
              <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Schedules</h2>
              <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)">Run commands, power actions, or backups on a timer.</p>
            </div>
          </div>
        <% if (schedules.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="al-table min-w-full">
              <thead class="al-table-head">
                <tr>
                  <th scope="col" class="al-table-th px-6 py-3 uppercase w-2/5">Name</th>
                  <th scope="col" class="al-table-th px-6 py-3 uppercase">Schedule</th>
                  <th scope="col" class="al-table-th px-6 py-3 uppercase">Tasks</th>
                  <th scope="col" class="al-table-th px-6 py-3 uppercase w-24">Enabled</th>
                  <th scope="col" class="al-table-th px-6 py-3 uppercase text-right w-52">Actions</th>
                </tr>
              </thead>
              <tbody>
            <% schedules.forEach((schedule, i) => { %>
                <tr class="al-table-tr transition-colors" data-schedule-id="<%= schedule.id %>">
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= schedule.name %></h3>
                      <% if (!schedule.enabled) { %>
                      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)">Disabled</span>
                      <% } %>
                    </div>
                    <div class="flex items-center gap-x-4 gap-y-1 mt-1.5 flex-wrap text-[11px]" style="color:var(--theme-text-muted)">
                      <span class="flex items-center gap-1">
                        <%- icon('clock', { class: 'w-3 h-3' }) %>
                        <% if (schedule.nextRunAt) { %>Next: <%= new Date(schedule.nextRunAt).toLocaleString() %><% } else { %>Next: —<% } %>
                      </span>
                      <span class="flex items-center gap-1">
                        <%- icon('history', { class: 'w-3 h-3' }) %>
                        <% if (schedule.lastRunAt) { %>Last: <%= new Date(schedule.lastRunAt).toLocaleString() %><% } else { %>Last: never<% } %>
                      </span>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap align-top">
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium font-mono" style="background:var(--theme-accent-subtle);color:var(--theme-accent)" title="Cron expression"><%= schedule.cron %></span>
                    <% if (schedule.timeOffset) { %>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium font-mono ml-1" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)" title="Schedule clock offset"><%= schedule.timeOffset > 0 ? '+' : '' %><%= schedule.timeOffset %>m</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center gap-2">
                      <span class="text-sm tabular-nums" style="color:var(--theme-text)" data-task-count="<%= schedule.id %>"><%= schedule.tasks.length %></span>
                      <button type="button" onclick="toggleTasks(<%= schedule.id %>)" data-manage-tasks="<%= schedule.id %>" aria-expanded="false"
                        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2"
                        style="color:var(--theme-accent);background:var(--theme-accent-subtle)">
                        <%- icon('settings', { class: 'w-3 h-3' }) %>
                        <span data-manage-label="<%= schedule.id %>">Manage</span>
                      </button>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <label class="relative inline-flex items-center cursor-pointer" title="<%= schedule.enabled ? 'Disable schedule' : 'Enable schedule' %>">
                      <input type="checkbox" class="sr-only peer sched-toggle" aria-label="<%= schedule.enabled ? 'Disable schedule' : 'Enable schedule' %>" <%= schedule.enabled ? 'checked' : '' %>>
                      <div class="al-toggle-track">
                        <div class="al-toggle-dot"></div>
                      </div>
                    </label>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <div class="flex justify-end items-center gap-2">
                      <button type="button" data-sched-name="<%= schedule.name %>" onclick="runSchedule(<%= schedule.id %>, this.dataset.schedName)"
                        <%= schedule.tasks.length === 0 ? 'disabled title="Add a task first"' : '' %>
                        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-40 disabled:pointer-events-none"
                        style="color:var(--theme-success);background:var(--theme-success-bg)">
                        <%- icon('play', { class: 'w-3 h-3' }) %>
                        Run now
                      </button>
                      <button type="button" data-sched-name="<%= schedule.name %>" onclick="deleteSchedule(<%= schedule.id %>, this.dataset.schedName)"
                        class="al-btn-ghost p-2 -mr-1.5" style="color:var(--theme-danger)" aria-label="Delete schedule">
                        <%- icon('trash-2', { size: 15 }) %>
                      </button>
                    </div>
                  </td>
                </tr>
                <tr class="al-table-tr" data-tasks-row="<%= schedule.id %>">
                  <td colspan="5" class="px-0 py-0">
                    <div class="tasks-wrap hidden px-6 pb-5" style="background:var(--theme-bg-secondary)">

                  <p class="text-[11px] font-semibold uppercase tracking-widest mb-2 pt-5" style="color:var(--theme-text-muted)">Tasks</p>
                  <% if (schedule.tasks.length > 0) { %>
                  <div class="space-y-1">
                    <% schedule.tasks.forEach(task => { %>
                      <div class="task-row flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm" data-task-row="<%= task.id %>" style="background:var(--theme-bg-card)">
                        <div class="min-w-0 flex items-center gap-2.5">
                          <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide shrink-0" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%= task.action %></span>
                          <span class="truncate font-mono text-xs" style="color:var(--theme-text)">
                            <% if (task.action === 'command') { %><%= task.payload.command %><% } else if (task.action === 'power') { %><%= task.payload.action %><% } else { %><%= task.payload.name %><% } %>
                          </span>
                          <% if (task.timeOffset > 0) { %>
                            <span class="shrink-0 text-[10px] font-medium" style="color:var(--theme-text-muted)">+<%= task.timeOffset %>s</span>
                          <% } %>
                        </div>
                        <button type="button" onclick="deleteTask(<%= schedule.id %>, <%= task.id %>)" class="al-btn-ghost p-2 -mr-1.5 shrink-0" style="color:var(--theme-danger)" aria-label="Remove task">
                          <%- icon('x', { class: 'w-3.5 h-3.5' }) %>
                        </button>
                      </div>
                    <% }); %>
                  </div>
                  <% } else { %>
                  <p class="text-sm italic sched-empty" data-schedule="<%= schedule.id %>" style="color:var(--theme-text-placeholder)">No tasks yet. Add one below.</p>
                  <% } %>

                  <div data-pending-tasks="<%= schedule.id %>" class="space-y-1 mt-1"></div>

                  <div class="flex flex-wrap items-end gap-2.5 pt-3">
                    <div>
                      <label class="al-label">Action</label>
                      <select class="al-input task-action w-28" data-schedule="<%= schedule.id %>">
                        <option value="command">Command</option>
                        <option value="power">Power</option>
                        <option value="backup">Backup</option>
                      </select>
                    </div>
                    <div class="task-fields-command flex-1 min-w-[200px]" data-schedule="<%= schedule.id %>">
                      <label class="al-label">Command</label>
                      <input type="text" class="al-input task-command font-mono w-full" placeholder="say hello" autocomplete="off">
                    </div>
                    <div class="task-fields-power hidden" data-schedule="<%= schedule.id %>">
                      <label class="al-label">Power action</label>
                      <select class="al-input task-power w-32">
                        <option value="start">Start</option>
                        <option value="stop">Stop</option>
                        <option value="restart">Restart</option>
                        <option value="kill">Kill</option>
                      </select>
                    </div>
                    <div class="task-fields-backup hidden" data-schedule="<%= schedule.id %>">
                      <label class="al-label">Backup name</label>
                      <input type="text" class="al-input task-backup-name w-48" placeholder="daily" autocomplete="off">
                    </div>
                    <div>
                      <label class="al-label">Seconds before</label>
                      <input type="number" min="0" step="1" value="0" class="al-input task-timeOffset w-24" data-schedule="<%= schedule.id %>" autocomplete="off">
                    </div>
                    <button type="button" onclick="addTask(<%= schedule.id %>)"
                      class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2"
                      style="color:var(--theme-accent);background:var(--theme-accent-subtle)">
                      <%- icon('plus', { class: 'w-3 h-3' }) %>
                      Add task
                    </button>
                    <button type="button" onclick="saveTasks(<%= schedule.id %>)" data-save-tasks="<%= schedule.id %>"
                      class="hidden inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2"
                      style="color:var(--theme-accent-text);background:var(--theme-accent)">
                      <%- icon('check', { class: 'w-3 h-3' }) %>
                      Save tasks
                    </button>
                  </div>
                  </div>
                </td>
              </tr>
            <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-10 text-center">
            <%- icon('calendar', { class: 'mx-auto h-12 w-12', style: 'color:var(--theme-text-muted)' }) %>
            <h3 class="mt-3 text-sm font-medium" style="color:var(--theme-text-strong)">No schedules</h3>
            <p class="mt-1 text-sm" style="color:var(--theme-text-muted)">Create a schedule to run commands, power actions, or backups on a timer.</p>
            <button type="button" onclick="openAddScheduleModal()" class="al-btn-primary inline-flex items-center gap-1.5 mt-5 rounded-xl px-4 py-2 text-sm font-medium">
              <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
              New Schedule
            </button>
          </div>
        <% } %>
        </div>
      </div>

      </div><!-- /server-page-body -->
    </div>
  </div>
</main>

<!-- New Schedule Modal -->
<div id="addScheduleModal" class="al-sheet-overlay fixed inset-0 z-50 hidden items-center justify-center p-4" aria-hidden="true">
  <div class="absolute inset-0 bg-transparent" aria-hidden="true" onclick="closeAddScheduleModal()"></div>
  <div id="addSchedulePanel" class="al-sheet-panel relative w-full max-w-2xl rounded-2xl max-h-[85vh] flex flex-col" role="dialog" aria-modal="true" aria-labelledby="addScheduleTitle" tabindex="-1" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:0 20px 60px rgba(0,0,0,0.3)">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 id="addScheduleTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)">New schedule</h3>
      <button type="button" onclick="closeAddScheduleModal()" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4 space-y-4">
      <div>
        <label for="schedName" class="al-label">Name</label>
        <input id="schedName" type="text" class="al-input w-full" placeholder="Daily restart" autocomplete="off">
      </div>
      <div>
        <div class="flex rounded-lg p-0.5 text-xs font-medium mb-1.5" style="background:var(--theme-bg-secondary)">
          <button type="button" data-sched-mode="cron" class="sched-mode-btn flex-1 rounded-md px-3 py-1.5 transition inline-flex items-center gap-1.5" style="color:var(--theme-text-strong);background:var(--theme-bg-card)" aria-pressed="true">
            <%- icon('clock', { class: 'size-3', strokeWidth: 1.5 }) %>
            Cron expression
          </button>
          <button type="button" data-sched-mode="visual" class="sched-mode-btn flex-1 rounded-md px-3 py-1.5 transition inline-flex items-center gap-1.5" style="color:var(--theme-text-muted)" aria-pressed="false">
            <%- icon('calendar', { class: 'size-3', strokeWidth: 1.5 }) %>
            Visual timing
          </button>
        </div>
      </div>
      <div id="schedCronWrap">
        <label for="schedCron" class="al-label">Cron expression</label>
        <input id="schedCron" type="text" class="al-input w-full font-mono" placeholder="0 0 * * * *" autocomplete="off" value="0 0 * * * *">
        <p id="schedCronErr" class="hidden mt-1.5 text-[11px]" style="color:var(--theme-danger)">Cron must be 5 or 6 fields — <span class="font-mono">second minute hour day month weekday</span> — with values in range (seconds/minutes 0-59, hours 0-23, day 1-31, month 1-12, weekday 0-7).</p>
        <p class="mt-1.5 text-[11px]" style="color:var(--theme-text-muted)">Format: <span class="font-mono">second minute hour day month weekday</span> — <span id="cronPreview" class="font-medium" style="color:var(--theme-accent)">every hour</span></p>
      </div>
      <div>
        <label class="al-label" for="schedTimeOffset">Time offset (minutes)</label>
        <input id="schedTimeOffset" type="number" min="-1440" max="1440" value="0" class="al-input w-full" autocomplete="off">
        <p class="mt-1.5 text-[11px]" style="color:var(--theme-text-muted)">Shift the schedule's clock forward (+) or backward (−) from the server's UTC time, in minutes. e.g. <span class="font-mono">60</span> = run as if the time were one hour ahead.</p>
      </div>
      <div id="schedVisualWrap" class="hidden space-y-4">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <%
            const granFields = [
              { key: 'sec',  label: 'Seconds',       min: 0,  max: 59 },
              { key: 'min',  label: 'Minutes',       min: 0,  max: 59 },
              { key: 'hour', label: 'Hours',         min: 0,  max: 23 },
              { key: 'dom',  label: 'Day of month',  min: 1,  max: 31 },
            ];
          %>
          <% granFields.forEach(f => { %>
          <div class="rounded-xl p-3" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
            <label class="block text-[11px] font-medium mb-2" style="color:var(--theme-text-muted)"><%= f.label %></label>
            <div class="flex items-center gap-1.5">
              <button type="button" class="sched-step" data-step-for="<%= f.key %>" data-step="-1" aria-label="Decrease <%= f.label.toLowerCase() %>">
                <%- icon('minus', { class: 'size-3.5', strokeWidth: 2 }) %>
              </button>
              <input id="schedG<%= f.key %>" type="number" min="<%= f.min %>" max="<%= f.max %>" value="<%= f.key === 'dom' ? 1 : 0 %>" class="al-input w-full px-2 py-1.5 text-center font-mono" aria-label="<%= f.label %> value">
              <span id="schedInt<%= f.key %>" class="sched-int hidden items-center justify-center gap-1 font-mono text-xs whitespace-nowrap" style="color:var(--theme-text)">every <b id="schedIntN<%= f.key %>" class="hidden" style="color:var(--theme-accent)">2</b></span>
              <button type="button" class="sched-step" data-step-for="<%= f.key %>" data-step="1" aria-label="Increase <%= f.label.toLowerCase() %>">
                <%- icon('plus', { class: 'size-3.5', strokeWidth: 2 }) %>
              </button>
            </div>
            <label class="sched-every-label mt-2 inline-flex items-center cursor-pointer select-none" title="Run for every <%= f.label.toLowerCase() %> value">
              <input type="checkbox" id="schedG<%= f.key %>Every" class="sr-only peer" checked aria-label="Run for every <%= f.label.toLowerCase() %> value">
              <span class="sched-every-chip">
                <%- icon('check', { class: 'size-3', strokeWidth: 2.5 }) %>
                every
              </span>
            </label>
          </div>
          <% }); %>
        </div>
        <div>
          <label class="block text-[11px] font-medium mb-1.5" style="color:var(--theme-text-muted)">Day of week</label>
          <div id="schedDowChips" class="flex flex-wrap gap-1.5" role="group" aria-label="Day of week">
            <button type="button" class="sched-day-chip on" data-dow="*" aria-pressed="true">Every day</button>
            <button type="button" class="sched-day-chip" data-dow="0" aria-pressed="false" title="Sunday">Sun</button>
            <button type="button" class="sched-day-chip" data-dow="1" aria-pressed="false" title="Monday">Mon</button>
            <button type="button" class="sched-day-chip" data-dow="2" aria-pressed="false" title="Tuesday">Tue</button>
            <button type="button" class="sched-day-chip" data-dow="3" aria-pressed="false" title="Wednesday">Wed</button>
            <button type="button" class="sched-day-chip" data-dow="4" aria-pressed="false" title="Thursday">Thu</button>
            <button type="button" class="sched-day-chip" data-dow="5" aria-pressed="false" title="Friday">Fri</button>
            <button type="button" class="sched-day-chip" data-dow="6" aria-pressed="false" title="Saturday">Sat</button>
          </div>
        </div>
        <div id="schedVisualWarn" class="hidden items-center gap-2.5 rounded-lg px-3 py-2.5 text-xs" style="background:var(--theme-danger-bg);color:var(--theme-danger)" role="alert">
          <%- icon('alert-triangle', { class: 'size-4 shrink-0', strokeWidth: 1.5 }) %>
          <span>This expression can't be shown visually — it uses ranges, lists, or values outside the visual editor. Edit it in Cron mode.</span>
        </div>
        <p class="text-[11px]" aria-live="polite" style="color:var(--theme-text-muted)">Runs <span id="schedVisualDesc" class="font-medium" style="color:var(--theme-accent)">every hour</span> — cron: <span id="schedVisualCron" class="font-mono font-medium" style="color:var(--theme-accent)">0 0 * * * *</span></p>
      </div>
    </div>
    <div class="flex gap-2 px-6 py-4 border-t justify-end">
      <button type="button" onclick="closeAddScheduleModal()" class="al-btn-secondary flex-1 inline-flex items-center gap-1.5">
        <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>
        Cancel
      </button>
      <button type="button" id="confirmAddSchedule" class="al-btn-primary flex-1 inline-flex items-center gap-1.5">
        <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
        <span>Create schedule</span>
      </button>
    </div>
  </div>
</div>


<script nonce="<%- nonce %>">
(function () {
const serverId = '<%= server.UUID %>';

const { showToast } = typeof createToastSystem === 'function' ? createToastSystem() : { showToast: window.showToast || ((m) => console.warn('[schedules]', m)) };

function escHtml(val) {
  return String(val)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function getFocusableElements(panel) {
  return Array.from((panel || document).querySelectorAll('a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'))
    .filter((el) => !el.disabled && el.offsetParent !== null);
}

let lastScheduleModalFocus = null;

window.openAddScheduleModal = () => {
  lastScheduleModalFocus = document.activeElement;
  document.getElementById('schedName').value = '';
  document.getElementById('schedCron').value = '0 0 * * * *';
  document.getElementById('schedTimeOffset').value = '0';
  document.getElementById('schedCronErr')?.classList.add('hidden');
  document.getElementById('cronPreview').textContent = describeCron('0 0 * * * *');
  setSchedMode('visual');
  Animate.openModal(document.getElementById('addScheduleModal'), document.getElementById('addSchedulePanel'));
  document.getElementById('schedName').focus();
};

window.closeAddScheduleModal = () => {
  Animate.closeModal(document.getElementById('addScheduleModal'), document.getElementById('addSchedulePanel'));
  if (lastScheduleModalFocus) lastScheduleModalFocus.focus();
};

document.addEventListener('keydown', (e) => {
  const modal = document.getElementById('addScheduleModal');
  if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
    e.preventDefault();
    closeAddScheduleModal();
    return;
  }
  if (e.key === 'Tab' && !modal.classList.contains('hidden')) {
    const focusable = getFocusableElements(document.getElementById('addSchedulePanel'));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }
});

/* ── Human-readable cron preview ──
   Never invents meaning: tokens outside the supported grammar are
   echoed back verbatim so the preview can't lie about a schedule. */
const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const DAY_SHORT = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

function fmtClock(h, m) {
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return h12 + ':' + String(m).padStart(2, '0') + ' ' + (h < 12 ? 'AM' : 'PM');
}

function splitCronField(v) {
  if (v === '*') return [];
  if (/^\*\/\d+$/.test(v)) return [['int', +v.slice(2)]];
  const parts = [];
  for (const item of v.split(',')) {
    const m = item.match(/^(\d+)(?:-(\d+))?$/);
    if (!m) return null;
    parts.push(m[2] !== undefined ? ['range', +m[1], +m[2]] : ['num', +m[1]]);
  }
  return parts;
}

function describeTime(minF, hourF, min, hour) {
  const minNum = min.length === 1 && min[0][0] === 'num' ? min[0][1] : null;
  const hourNum = hour.length === 1 && hour[0][0] === 'num' ? hour[0][1] : null;
  const minInt = min.length === 1 && min[0][0] === 'int' ? min[0][1] : null;
  const hourInt = hour.length === 1 && hour[0][0] === 'int' ? hour[0][1] : null;
  if (minF === '*') {
    if (hourF === '*') return 'every minute';
    if (hourInt !== null) return 'every minute during every ' + hourInt + ' hours';
    if (hourNum !== null) return 'every minute during hour ' + hourNum;
    return 'every minute during hours ' + hourF;
  }
  if (minInt !== null) {
    if (hourF === '*') return 'every ' + minInt + ' minutes';
    if (hourNum !== null) return 'every ' + minInt + ' minutes in hour ' + hourNum;
    return 'every ' + minInt + ' minutes, every ' + hourInt + ' hours';
  }
  if (minNum !== null) {
    if (hourF === '*') return minNum === 0 ? 'every hour' : 'every hour at minute ' + minNum;
    if (hourNum !== null) return 'at ' + fmtClock(hourNum, minNum);
    if (hourInt !== null) return minNum === 0 ? 'every ' + hourInt + ' hours' : 'every ' + hourInt + ' hours at minute ' + minNum;
    return 'at minute ' + minNum + ' during hours ' + hourF;
  }
  if (hourF === '*') return 'every hour at minutes ' + minF;
  return 'at minutes ' + minF + ' during hours ' + hourF;
}

function describeDate(domF, monF, dowF, dom, mon, dow) {
  const bits = [];
  const one = (f) => f.length === 1 && f[0][0] === 'num' ? f[0][1] : null;
  const intv = (f) => f.length === 1 && f[0][0] === 'int' ? f[0][1] : null;
  const dowNum = one(dow);
  const dowInt = intv(dow);
  if (dowF !== '*') {
    if (dowInt !== null) bits.push('every ' + dowInt + ' days of the week');
    else if (dow.length === 1 && dowNum !== null) bits.push('every ' + DAY_NAMES[dowNum % 7]);
    else bits.push('on ' + dowF.split(',').map((t) => {
      const m = t.match(/^(\d+)(?:-(\d+))?$/);
      if (!m) return t;
      return m[2] !== undefined ? DAY_SHORT[+m[1] % 7] + '-' + DAY_SHORT[+m[2] % 7] : DAY_SHORT[+m[1] % 7];
    }).join(', '));
  }
  const domNum = one(dom);
  const domInt = intv(dom);
  if (domF !== '*') {
    if (domInt !== null) bits.push('every ' + domInt + ' days of the month');
    else if (dom.length === 1 && domNum !== null) bits.push('on day ' + domNum + ' of the month');
    else bits.push('on days ' + domF + ' of the month');
  }
  const monNum = one(mon);
  const monInt = intv(mon);
  if (monF !== '*') {
    if (monInt !== null) bits.push('every ' + monInt + ' months');
    else if (mon.length === 1 && monNum !== null) bits.push('in ' + MONTH_NAMES[Math.min(12, Math.max(1, monNum)) - 1]);
    else bits.push('in months ' + monF);
  }
  return bits.length ? bits.join(', ') : null;
}

function describeCron(expr) {
  const p = String(expr || '').trim().split(/\s+/);
  if (p.length === 6) {
    const rest = describeCron5(p.slice(1).join(' '));
    if (p[0] === '*') return rest === 'every minute' ? 'every second' : 'every second, ' + rest;
    if (p[0] === '0') return rest;
    if (/^\*\/\d+$/.test(p[0])) return 'every ' + p[0].slice(2) + ' seconds' + (rest === 'every minute' ? '' : ', ' + rest);
    return 'at second ' + p[0] + ', ' + rest;
  }
  return describeCron5(p.join(' '));
}

function describeCron5(expr) {
  const p = String(expr || '').trim().split(/\s+/);
  if (p.length !== 5) return String(expr || '').trim() || 'invalid cron';
  const [minF, hourF, domF, monF, dowF] = p;
  const min = splitCronField(minF);
  const hour = splitCronField(hourF);
  const dom = splitCronField(domF);
  const mon = splitCronField(monF);
  const dow = splitCronField(dowF);
  if (!min || !hour || !dom || !mon || !dow) return expr;
  const time = describeTime(minF, hourF, min, hour);
  const date = describeDate(domF, monF, dowF, dom, mon, dow);
  return [time, date].filter(Boolean).join(' ');
}

document.getElementById('schedCron').addEventListener('input', function () {
  document.getElementById('schedCronErr')?.classList.add('hidden');
  document.getElementById('cronPreview').textContent = describeCron(this.value);
});

const granKeys = ['sec', 'min', 'hour', 'dom'];
const granLabels = { sec: 'Seconds', min: 'Minutes', hour: 'Hours', dom: 'Day of month' };
const granLimits = { sec: [0, 59], min: [0, 59], hour: [0, 23], dom: [1, 31] };
const granInterval = { sec: null, min: null, hour: null, dom: null };
let schedDowAll = true;
const schedDowDays = new Set();

function serializeDow() {
  if (schedDowAll || schedDowDays.size === 0 || schedDowDays.size === 7) return '*';
  const arr = [...schedDowDays].map(Number).sort((a, b) => a - b);
  const out = [];
  let start = arr[0];
  let prev = arr[0];
  for (let i = 1; i <= arr.length; i++) {
    const cur = arr[i];
    if (cur !== prev + 1) {
      out.push(start === prev ? String(start) : start + '-' + prev);
      start = cur;
    }
    prev = cur;
  }
  return out.join(',');
}

function dowSetFromToken(v) {
  const set = new Set();
  if (v === '*' || v === '') {
    for (let i = 0; i < 7; i++) set.add(i);
    return set;
  }
  for (const part of v.split(',')) {
    const m = part.match(/^([0-6])(?:-([0-6]))?$/);
    if (!m || (m[2] !== undefined && +m[2] < +m[1])) return null;
    for (let i = +m[1]; i <= +m[2] || i <= +m[1]; i++) set.add(i);
  }
  return set;
}

function granField(key) {
  const el = document.getElementById('schedG' + key);
  const every = document.getElementById('schedG' + key + 'Every');
  if (every.checked) return granInterval[key] ? '*/' + granInterval[key] : '*';
  let n = parseInt(el.value, 10);
  if (isNaN(n)) n = key === 'dom' ? 1 : 0;
  return String(Math.min(granLimits[key][1], Math.max(granLimits[key][0], n)));
}

function buildGranularCron() {
  const cron = granKeys.map(granField).concat(['*', serializeDow()]).join(' ');
  document.getElementById('schedVisualCron').textContent = cron;
  document.getElementById('schedVisualDesc').textContent = describeCron(cron);
  document.getElementById('schedCron').value = cron;
  document.getElementById('cronPreview').textContent = describeCron(cron);
}

function renderDowChips() {
  document.querySelectorAll('.sched-day-chip').forEach((c) => {
    const on = c.dataset.dow === '*' ? schedDowAll : schedDowDays.has(Number(c.dataset.dow));
    c.setAttribute('aria-pressed', String(on));
    c.classList.toggle('on', on);
  });
}

function updateIntervalDisplay(key) {
  const el = document.getElementById('schedG' + key);
  const every = document.getElementById('schedG' + key + 'Every');
  const span = document.getElementById('schedInt' + key);
  const nEl = document.getElementById('schedIntN' + key);
  const on = every.checked;
  const label = granLabels[key];
  el.classList.toggle('hidden', on);
  span.classList.toggle('hidden', !on);
  span.classList.toggle('inline-flex', on);
  const hasN = on && granInterval[key] !== null;
  nEl.classList.toggle('hidden', !hasN);
  if (hasN) nEl.textContent = String(granInterval[key]);
  document.querySelectorAll('[data-step-for="' + key + '"]').forEach((b) => {
    const dir = Number(b.dataset.step) > 0 ? 'Increase' : 'Decrease';
    b.setAttribute('aria-label', on ? dir + ' every-N interval for ' + label.toLowerCase() : dir + ' ' + label.toLowerCase() + ' value');
  });
}

function syncVisualFromCron() {
  const warn = document.getElementById('schedVisualWarn');
  const fields = document.getElementById('schedCron').value.trim().split(/\s+/);
  const parts = fields.length === 6 ? fields : fields.length === 5 ? ['0'].concat(fields) : null;
  if (!parts || !parts.slice(0, 4).every((f) => /^(\*|\*\/\d+|\d+)$/.test(f)) || !/^(\*|[0-6](?:-[0-6])?)(,[0-6](?:-[0-6])?)*$/.test(parts[5])) {
    warn.classList.remove('hidden');
    warn.classList.add('flex');
    return;
  }
  warn.classList.add('hidden');
  warn.classList.remove('flex');
  granKeys.forEach((key, i) => {
    const v = parts[i];
    const el = document.getElementById('schedG' + key);
    const every = document.getElementById('schedG' + key + 'Every');
    if (v === '*') { every.checked = true; granInterval[key] = null; }
    else if (/^\*\/\d+$/.test(v)) {
      every.checked = true;
      const n = parseInt(v.slice(2), 10);
      granInterval[key] = n > 1 ? Math.min(granLimits[key][1], n) : null;
    }
    else {
      every.checked = false;
      granInterval[key] = null;
      el.value = String(Math.min(granLimits[key][1], Math.max(granLimits[key][0], parseInt(v, 10) || (key === 'dom' ? 1 : 0))));
    }
    updateIntervalDisplay(key);
  });
  const days = dowSetFromToken(parts[5]);
  schedDowAll = days.size === 7;
  schedDowDays.clear();
  if (!schedDowAll) days.forEach((d) => schedDowDays.add(d));
  renderDowChips();
  buildGranularCron();
}

granKeys.forEach(key => {
  const el = document.getElementById('schedG' + key);
  const every = document.getElementById('schedG' + key + 'Every');
  const syncEveryChip = () => {
    const chip = every.parentElement.querySelector('.sched-every-chip');
    if (chip) chip.classList.toggle('on', every.checked);
  };
  document.querySelectorAll('[data-step-for="' + key + '"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const [min, max] = granLimits[key];
      if (every.checked) {
        const n = Math.min(max, Math.max(2, (granInterval[key] || 1) + Number(btn.dataset.step)));
        granInterval[key] = n;
        updateIntervalDisplay(key);
      } else {
        let n = parseInt(el.value, 10);
        if (isNaN(n)) n = key === 'dom' ? 1 : 0;
        el.value = String(Math.min(max, Math.max(min, n + Number(btn.dataset.step))));
      }
      buildGranularCron();
    });
  });
  el.addEventListener('change', () => {
    let n = parseInt(el.value, 10);
    if (isNaN(n)) n = key === 'dom' ? 1 : 0;
    el.value = String(Math.min(granLimits[key][1], Math.max(granLimits[key][0], n)));
    buildGranularCron();
  });
  el.addEventListener('input', () => { buildGranularCron(); });
  every.addEventListener('change', () => {
    if (every.checked) { granInterval[key] = null; }
    syncEveryChip();
    updateIntervalDisplay(key);
    buildGranularCron();
  });
  updateIntervalDisplay(key);
  syncEveryChip();
});
document.querySelectorAll('.sched-day-chip').forEach((c) => {
  c.addEventListener('click', () => {
    if (c.dataset.dow === '*') { schedDowAll = true; schedDowDays.clear(); }
    else {
      const d = Number(c.dataset.dow);
      schedDowAll = false;
      if (schedDowDays.has(d)) schedDowDays.delete(d);
      else schedDowDays.add(d);
      if (schedDowDays.size === 0) schedDowAll = true;
    }
    renderDowChips();
    buildGranularCron();
  });
});

function setSchedMode(mode) {
  document.querySelectorAll('.sched-mode-btn').forEach((b) => {
    const active = b.dataset.schedMode === mode;
    b.setAttribute('aria-pressed', String(active));
    b.style.background = active ? 'var(--theme-bg-card)' : 'transparent';
    b.style.color = active ? 'var(--theme-text-strong)' : 'var(--theme-text-muted)';
    b.style.boxShadow = active ? 'var(--theme-shadow-sm, 0 1px 2px rgba(0,0,0,0.05))' : 'none';
  });
  if (mode === 'visual') syncVisualFromCron();
  document.getElementById('schedCronWrap').classList.toggle('hidden', mode !== 'cron');
  document.getElementById('schedVisualWrap').classList.toggle('hidden', mode !== 'visual');
}
document.querySelectorAll('.sched-mode-btn').forEach((b) => b.addEventListener('click', () => setSchedMode(b.dataset.schedMode)));

const FIELD_BOUNDS = [[0, 59], [0, 59], [0, 23], [1, 31], [1, 12], [0, 7]];

function tokenValid(tok, bounds) {
  if (tok === '*') return true;
  const [lo, hi] = bounds;
  for (const item of tok.split(',')) {
    const m = item.match(/^\*\/?([0-9]+)?$|^(\*|(\d+)(?:-(\d+))?)$/);
    if (!m) return false;
    if (m[1] !== undefined) {
      const n = +m[1];
      if (!(n >= 1 && n <= hi)) return false;
    } else if (m[2] === '*') {
      continue;
    } else {
      const a = +m[3];
      const b = m[4] !== undefined ? +m[4] : a;
      if (a < lo || a > hi || b < lo || b > hi || b < a) return false;
    }
  }
  return true;
}

function validCron(c) {
  const parts = String(c || '').trim().split(/\s+/);
  if (parts.length !== 5 && parts.length !== 6) return false;
  const bounds = parts.length === 6 ? FIELD_BOUNDS : FIELD_BOUNDS.slice(1);
  return parts.every((t, i) => tokenValid(t, bounds[i]));
}

