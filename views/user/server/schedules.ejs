<%- include('../../components/header', { title: 'Schedules' }) %>

<main class="h-screen m-auto text-neutral-800 dark:text-white">
  <div class="flex h-full">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/template') %>
    </div>
    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-16 pb-0 lg:pb-0">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Servers', href: '/' },
        { label: server.name, href: '/server/' + server.UUID },
        { label: 'Schedules' }
      ] }) %>
      <!-- Page Header: title + meta left, buttons right -->
      <div class="px-4 sm:px-8 pt-4">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <!-- Server meta: image · node · id -->
            <div class="flex items-center gap-3 mt-1.5 flex-wrap">
              <div class="flex items-center gap-1.5">
                <%- icon('box', { class: 'h-3 w-3 shrink-0' }) %>
                <span class="text-[11px] truncate max-w-[140px]" style="color:var(--theme-text-muted)"><%= server.image.name %></span>
              </div>
              <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
              <div class="flex items-center gap-1.5">
                <%- icon('server', { class: 'h-3 w-3 shrink-0' }) %>
                <span class="text-[11px] truncate max-w-[100px]" style="color:var(--theme-text-muted)"><%= server.node.name %></span>
              </div>
              <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
              <div class="flex items-center gap-1.5">
                <%- icon('hash', { class: 'h-3 w-3 shrink-0' }) %>
                <span class="text-[11px] font-mono" style="color:var(--theme-text-muted)"><%= server.UUID.split('-')[0] %></span>
              </div>
            </div>
          </div>
          <div class="flex gap-2 shrink-0">
            <button id="addScheduleBtn" onclick="openAddScheduleModal()" type="button"
                class="al-btn-primary block rounded-xl px-3 py-2 text-center text-sm font-medium shadow-lg transition duration-300">
                <%- icon('plus', { class: 'size-4 inline-flex mr-1 mb-0.5', strokeWidth: 1.5 }) %>
                New Schedule
            </button>
          </div>
        </div>
      </div>

      <%- include('../../components/installHeader') %>

      <!-- Server Template -->
      <%- include('../../components/serverTemplate') %>

      <div id="server-page-body">

      <!-- Schedules -->
      <div class="px-6 space-y-4">
        <% if (schedules.length > 0) { %>
          <% schedules.forEach(schedule => { %>
            <div class="al-card rounded-lg shadow overflow-hidden" data-schedule-id="<%= schedule.id %>">
              <div class="px-5 py-4 flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2.5 flex-wrap">
                    <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= schedule.name %></h3>
                    <% if (!schedule.enabled) { %>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)">Disabled</span>
                    <% } %>
                    <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-medium font-mono" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%= schedule.cron %></span>
                  </div>
                  <div class="flex items-center gap-3 mt-1.5 flex-wrap text-[11px]" style="color:var(--theme-text-muted)">
                    <span class="flex items-center gap-1">
                      <%- icon('clock', { class: 'w-3 h-3' }) %>
                      <% if (schedule.nextRunAt) { %>Next: <%= new Date(schedule.nextRunAt).toLocaleString() %><% } else { %>Next: —<% } %>
                    </span>
                    <span class="flex items-center gap-1">
                      <%- icon('history', { class: 'w-3 h-3' }) %>
                      <% if (schedule.lastRunAt) { %>Last: <%= new Date(schedule.lastRunAt).toLocaleString() %><% } else { %>Last: never<% } %>
                    </span>
                    <span class="flex items-center gap-1">
                      <%- icon('list', { class: 'w-3 h-3' }) %>
                      <%= schedule.tasks.length %> task<%= schedule.tasks.length === 1 ? '' : 's' %>
                    </span>
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <label class="relative inline-flex items-center cursor-pointer" title="<%= schedule.enabled ? 'Disable schedule' : 'Enable schedule' %>">
                    <input type="checkbox" class="sr-only peer sched-toggle" <%= schedule.enabled ? 'checked' : '' %>>
                    <div class="al-toggle-track">
                      <div class="al-toggle-dot"></div>
                    </div>
                  </label>
                  <button type="button" onclick="runSchedule(<%= schedule.id %>, '<%= schedule.name.replace(/'/g, "&#39;") %>')"
                    class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                    style="color:var(--theme-success);background:var(--theme-success-bg)">
                    <%- icon('play', { class: 'w-3 h-3 mr-1' }) %>
                    Run now
                  </button>
                  <button type="button" onclick="toggleTasks(<%= schedule.id %>)"
                    class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                    style="color:var(--theme-accent);background:var(--theme-accent-subtle)">
                    <%- icon('settings', { class: 'w-3 h-3 mr-1' }) %>
                    Tasks
                  </button>
                  <button type="button" onclick="deleteSchedule(<%= schedule.id %>, '<%= schedule.name.replace(/'/g, "&#39;") %>')"
                    class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                    style="color:var(--theme-danger);background:var(--theme-danger-bg)">
                    <%- icon('trash-2', { class: 'w-3 h-3 mr-1' }) %>
                  </button>
                </div>
              </div>

              <!-- Task list (collapsed by default) -->
              <div class="tasks-wrap hidden border-t" style="border-color:var(--theme-border)">
                <div class="px-5 py-4 space-y-3">
                  <% if (schedule.tasks.length > 0) { %>
                    <% schedule.tasks.forEach(task => { %>
                      <div class="flex items-center justify-between gap-3 rounded-lg px-4 py-2.5 text-sm task-row" data-task-row="<%= task.id %>" style="background:var(--theme-bg-secondary)">
                        <div class="min-w-0 flex items-center gap-2.5">
                          <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide shrink-0" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%= task.action %></span>
                          <span class="truncate font-mono text-xs" style="color:var(--theme-text)">
                            <% if (task.action === 'command') { %><%= task.payload.command %><% } else if (task.action === 'power') { %><%= task.payload.action %><% } else { %><%= task.payload.name %><% } %>
                          </span>
                        </div>
                        <button type="button" onclick="deleteTask(<%= schedule.id %>, <%= task.id %>)"
                          class="text-xs inline-flex items-center gap-1 transition shrink-0"
                          style="color:var(--theme-danger)">
                          <%- icon('x', { class: 'w-3 h-3' }) %>
                          Remove
                        </button>
                      </div>
                    <% }); %>
                  <% } else { %>
                    <p class="text-sm italic sched-empty" data-schedule="<%= schedule.id %>" style="color:var(--theme-text-placeholder)">No tasks yet. Add one below.</p>
                  <% } %>

                  <div data-pending-tasks="<%= schedule.id %>" class="space-y-3"></div>

                  <!-- Add task form -->
                  <div class="flex flex-wrap items-end gap-2.5 pt-1">
                    <div>
                      <label class="block text-[11px] font-medium mb-1" style="color:var(--theme-text-muted)">Action</label>
                      <select class="al-input task-action w-32" data-schedule="<%= schedule.id %>">
                        <option value="command">Command</option>
                        <option value="power">Power</option>
                        <option value="backup">Backup</option>
                      </select>
                    </div>
                    <div class="task-fields-command" data-schedule="<%= schedule.id %>">
                      <label class="block text-[11px] font-medium mb-1" style="color:var(--theme-text-muted)">Command</label>
                      <input type="text" class="al-input task-command w-64 font-mono" placeholder="say hello" autocomplete="off">
                    </div>
                    <div class="task-fields-power hidden" data-schedule="<%= schedule.id %>">
                      <label class="block text-[11px] font-medium mb-1" style="color:var(--theme-text-muted)">Power action</label>
                      <select class="al-input task-power w-32">
                        <option value="start">Start</option>
                        <option value="stop">Stop</option>
                        <option value="restart">Restart</option>
                        <option value="kill">Kill</option>
                      </select>
                    </div>
                    <div class="task-fields-backup hidden" data-schedule="<%= schedule.id %>">
                      <label class="block text-[11px] font-medium mb-1" style="color:var(--theme-text-muted)">Backup name</label>
                      <input type="text" class="al-input task-backup-name w-48" placeholder="daily" autocomplete="off">
                    </div>
                    <button type="button" onclick="addTask(<%= schedule.id %>)"
                      class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                      style="color:var(--theme-accent);background:var(--theme-accent-subtle)">
                      <%- icon('plus', { class: 'w-3 h-3 mr-1' }) %>
                      Add task
                    </button>
                    <button type="button" onclick="saveTasks(<%= schedule.id %>)" data-save-tasks="<%= schedule.id %>"
                      class="hidden inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                      style="color:var(--theme-accent-text);background:var(--theme-accent)">
                      <%- icon('check', { class: 'w-3 h-3 mr-1' }) %>
                      Save tasks
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="al-card rounded-lg shadow">
            <div class="p-10 text-center">
              <%- icon('calendar', { class: 'mx-auto h-12 w-12', style: 'color:var(--theme-text-muted)' }) %>
              <h3 class="mt-3 text-sm font-medium" style="color:var(--theme-text-strong)">No schedules</h3>
              <p class="mt-1 text-sm" style="color:var(--theme-text-muted)">Create a schedule to run commands, power actions, or backups on a timer.</p>
              <button type="button" onclick="openAddScheduleModal()" class="al-btn-primary inline-flex items-center gap-1.5 mt-5 rounded-xl px-4 py-2 text-sm font-medium">
                <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                New Schedule
              </button>
            </div>
          </div>
        <% } %>
      </div>

      </div><!-- /server-page-body -->
    </div>
  </div>
</main>

<!-- New Schedule Modal -->
<div id="addScheduleModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" aria-hidden="true">
  <div class="absolute inset-0 bg-black/60" aria-hidden="true" onclick="closeAddScheduleModal()"></div>
  <div id="addSchedulePanel" class="relative w-full max-w-md rounded-2xl p-6" role="dialog" aria-modal="true" aria-labelledby="addScheduleTitle" tabindex="-1" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:0 20px 60px rgba(0,0,0,0.3)">
    <div class="flex items-center justify-between mb-4">
      <h3 id="addScheduleTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)">New schedule</h3>
      <button type="button" onclick="closeAddScheduleModal()" class="text-neutral-400 hover:text-neutral-200"><%- icon('x', { class: 'w-4 h-4' }) %></button>
    </div>
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)">Name</label>
        <input id="schedName" type="text" class="al-input w-full" placeholder="Daily restart" autocomplete="off">
      </div>
      <div>
        <div class="flex rounded-lg p-0.5 text-xs font-medium mb-1.5" style="background:var(--theme-bg-secondary)">
          <button type="button" data-sched-mode="cron" class="sched-mode-btn flex-1 rounded-md px-3 py-1.5 transition" style="color:var(--theme-text-strong);background:var(--theme-bg-card)">Cron expression</button>
          <button type="button" data-sched-mode="visual" class="sched-mode-btn flex-1 rounded-md px-3 py-1.5 transition" style="color:var(--theme-text-muted)">Visual timing</button>
        </div>
      </div>
      <div id="schedCronWrap">
        <label class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)">Cron expression</label>
        <input id="schedCron" type="text" class="al-input w-full font-mono" placeholder="0 0 * * * *" autocomplete="off" value="0 */6 * * *">
        <p class="mt-1.5 text-[11px]" style="color:var(--theme-text-muted)">Format: <span class="font-mono">second minute hour day month weekday</span> — <span id="cronPreview" class="font-medium" style="color:var(--theme-accent)">every 6 hours</span></p>
      </div>
      <div id="schedVisualWrap" class="hidden space-y-4">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <%
            const granFields = [
              { key: 'sec',  label: 'Seconds',       min: 0,  max: 59 },
              { key: 'min',  label: 'Minutes',       min: 0,  max: 59 },
              { key: 'hour', label: 'Hours',         min: 0,  max: 23 },
              { key: 'dom',  label: 'Day of month',  min: 1,  max: 31 },
            ];
          %>
          <% granFields.forEach(f => { %>
          <div class="rounded-xl p-3" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
            <label class="block text-[11px] font-medium mb-2" style="color:var(--theme-text-muted)"><%= f.label %></label>
            <div class="flex items-center gap-1.5">
              <input id="schedG<%= f.key %>" type="number" min="<%= f.min %>" max="<%= f.max %>" value="<%= f.key === 'dom' ? 1 : 0 %>" class="al-input w-full px-2 py-1.5 text-center font-mono" aria-label="<%= f.label %> value">
              <label class="shrink-0 cursor-pointer" title="Run for every <%= f.label.toLowerCase() %> value">
                <input type="checkbox" id="schedG<%= f.key %>Every" class="sr-only peer" checked>
                <span class="block text-[10px] font-medium rounded-md px-1.5 py-1 border border-neutral-200 dark:border-neutral-700 text-neutral-400 dark:text-neutral-500 peer-checked:border-neutral-900 peer-checked:bg-neutral-900 peer-checked:text-white dark:peer-checked:border-white dark:peer-checked:bg-white dark:peer-checked:text-neutral-900 transition">every</span>
              </label>
            </div>
          </div>
          <% }); %>
        </div>
        <div>
          <label class="block text-[11px] font-medium mb-1.5" style="color:var(--theme-text-muted)">Day of week</label>
          <select id="schedGDow" class="al-input w-full">
            <option value="*">Every day</option>
            <option value="0">Sunday</option>
            <option value="1">Monday</option>
            <option value="2">Tuesday</option>
            <option value="3">Wednesday</option>
            <option value="4">Thursday</option>
            <option value="5">Friday</option>
            <option value="6">Saturday</option>
          </select>
        </div>
        <p class="text-[11px]" style="color:var(--theme-text-muted)">Runs <span id="schedVisualDesc" class="font-medium" style="color:var(--theme-accent)">every hour</span> — cron: <span id="schedVisualCron" class="font-mono font-medium" style="color:var(--theme-accent)">0 0 * * * *</span></p>
      </div>
      <div class="flex gap-2 pt-1">
        <button type="button" onclick="closeAddScheduleModal()" class="al-btn-secondary flex-1">Cancel</button>
        <button type="button" id="confirmAddSchedule" class="al-btn-primary flex-1">Create schedule</button>
      </div>
    </div>
  </div>
</div>

<%- include('../../components/toast') %>

<script nonce="<%- nonce %>">
const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
const serverId = '<%= server.UUID %>';

const { showToast } = typeof createToastSystem === 'function' ? createToastSystem() : { showToast: (m, t) => alert(m) };

function getFocusableElements(panel) {
  return Array.from((panel || document).querySelectorAll('a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'))
    .filter((el) => !el.disabled && el.offsetParent !== null);
}

let lastScheduleModalFocus = null;

window.openAddScheduleModal = () => {
  lastScheduleModalFocus = document.activeElement;
  document.getElementById('schedName').value = '';
  document.getElementById('schedCron').value = '0 0 * * * *';
  document.getElementById('cronPreview').textContent = describeCron('0 0 * * * *');
  setSchedMode('visual');
  Animate.openModal(document.getElementById('addScheduleModal'), document.getElementById('addSchedulePanel'));
  const focusable = getFocusableElements(document.getElementById('addSchedulePanel'));
  (focusable[0] || document.getElementById('addSchedulePanel')).focus();
};

window.closeAddScheduleModal = () => {
  Animate.closeModal(document.getElementById('addScheduleModal'), document.getElementById('addSchedulePanel'));
  if (lastScheduleModalFocus) lastScheduleModalFocus.focus();
};

document.addEventListener('keydown', (e) => {
  const modal = document.getElementById('addScheduleModal');
  if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
    e.preventDefault();
    closeAddScheduleModal();
    return;
  }
  if (e.key === 'Tab' && !modal.classList.contains('hidden')) {
    const focusable = getFocusableElements(document.getElementById('addSchedulePanel'));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }
});

/* ── Human-readable cron preview ── */
function describeCron(expr) {
  const p = String(expr || '').trim().split(/\s+/);
  if (p.length === 6) {
    const rest = describeCron5(p.slice(1).join(' '));
    if (p[0] === '*') return rest === 'every minute' ? 'every second' : 'every second, ' + rest;
    if (p[0] === '0') return rest;
    if (/^\*\/\d+$/.test(p[0])) return 'every ' + p[0].slice(2) + ' seconds' + (rest === 'every minute' ? '' : ', ' + rest);
    return 'at second ' + p[0] + ', ' + rest;
  }
  return describeCron5(p.join(' '));
}

function describeCron5(expr) {
  const p = String(expr || '').trim().split(/\s+/);
  if (p.length !== 5) return 'invalid cron';
  const [min, hour, dom, mon, dow] = p;
  const m = (v) => v === '*' ? null : v;
  if (m(dow) === '0' || m(dow) === '7') return 'every Sunday';
  if (/^[1-6]$/.test(dow || '')) return 'every ' + ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][+dow - 1];
  if (m(dom) === null && m(mon) === null) {
    if (m(hour) === null) {
      if (m(min) === null) return 'every minute';
      if (m(min) === '0') return 'every hour';
      if (/^\*\/\d+$/.test(min)) return 'every ' + min.split('/')[1] + ' minutes';
      return 'at minute ' + min;
    }
    if (m(min) === '0') {
      if (/^\*\/\d+$/.test(hour)) return 'every ' + hour.split('/')[1] + ' hours';
      if (hour === '*/12') return 'twice a day';
      return 'every hour';
    }
    if (/^\*\//.test(hour)) return 'every ' + hour.slice(2) + ' hours';
  }
  return 'runs on schedule';
}

document.getElementById('schedCron').addEventListener('input', function () {
  document.getElementById('cronPreview').textContent = describeCron(this.value);
});

const granKeys = ['sec', 'min', 'hour', 'dom'];
const granLimits = { sec: [0, 59], min: [0, 59], hour: [0, 23], dom: [1, 31] };

function granField(key) {
  const el = document.getElementById('schedG' + key);
  const every = document.getElementById('schedG' + key + 'Every');
  if (every.checked) return '*';
  let n = parseInt(el.value, 10);
  if (isNaN(n)) n = key === 'dom' ? 1 : 0;
  const val = String(Math.min(granLimits[key][1], Math.max(granLimits[key][0], n)));
  return el.dataset.interval === 'true' ? '*/' + val : val;
}

function buildGranularCron() {
  const cron = granKeys.map(granField).concat(['*', document.getElementById('schedGDow').value]).join(' ');
  document.getElementById('schedVisualCron').textContent = cron;
  document.getElementById('schedVisualDesc').textContent = describeCron(cron);
  document.getElementById('schedCron').value = cron;
  document.getElementById('cronPreview').textContent = describeCron(cron);
}

function syncVisualFromCron() {
  const fields = document.getElementById('schedCron').value.trim().split(/\s+/);
  let parts = fields.length === 6 ? fields : ['0'].concat(fields.length === 5 ? fields : ['0', '*', '*', '*', '*']);
  let ok = parts.length === 6;
  parts.forEach(f => { if (!/^(\*|\*\/\d+|\d+)$/.test(f)) ok = false; });
  if (!ok) { parts = ['0', '0', '*', '*', '*', '*']; }
  granKeys.forEach((key, i) => {
    const v = parts[i];
    const el = document.getElementById('schedG' + key);
    const every = document.getElementById('schedG' + key + 'Every');
    if (v === '*') { every.checked = true; el.dataset.interval = 'false'; }
    else if (/^\*\/\d+$/.test(v)) { every.checked = false; el.value = String(parseInt(v.slice(2), 10) || 0); el.dataset.interval = 'true'; }
    else { every.checked = false; el.value = String(parseInt(v, 10) || 0); el.dataset.interval = 'false'; }
  });
  document.getElementById('schedGDow').value = /^\d+$/.test(parts[5]) ? String(Math.min(6, parseInt(parts[5], 10))) : '*';
  buildGranularCron();
}

granKeys.forEach(key => {
  const el = document.getElementById('schedG' + key);
  const every = document.getElementById('schedG' + key + 'Every');
  el.addEventListener('change', buildGranularCron);
  el.addEventListener('input', () => { el.dataset.interval = 'false'; buildGranularCron(); });
  every.addEventListener('change', () => { el.dataset.interval = 'false'; buildGranularCron(); });
});
document.getElementById('schedGDow').addEventListener('change', buildGranularCron);

function setSchedMode(mode) {
  document.querySelectorAll('.sched-mode-btn').forEach((b) => {
    const active = b.dataset.schedMode === mode;
    b.style.background = active ? 'var(--theme-bg-card)' : 'transparent';
    b.style.color = active ? 'var(--theme-text-strong)' : 'var(--theme-text-muted)';
  });
  if (mode === 'visual') syncVisualFromCron();
  document.getElementById('schedCronWrap').classList.toggle('hidden', mode !== 'cron');
  document.getElementById('schedVisualWrap').classList.toggle('hidden', mode !== 'visual');
}
document.querySelectorAll('.sched-mode-btn').forEach((b) => b.addEventListener('click', () => setSchedMode(b.dataset.schedMode)));

async function api(url, method, body) {
  try {
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Request failed');
    return data;
  } catch (err) {
    showToast(err.message || 'Something went wrong.', 'error');
    return null;
  }
}

document.getElementById('confirmAddSchedule')?.addEventListener('click', async () => {
  const name = document.getElementById('schedName').value.trim();
  const cron = document.getElementById('schedCron').value.trim();
  if (!name) { showToast('Enter a schedule name.', 'error'); return; }
  const result = await api('/server/' + serverId + '/schedules', 'POST', { name, cron });
  if (result) {
    showToast('Schedule created.', 'success');
    setTimeout(() => location.reload(), 900);
  }
});

document.querySelectorAll('.sched-toggle').forEach((toggle) => {
  toggle.addEventListener('change', function () {
    const scheduleId = this.closest('[data-schedule-id]').dataset.scheduleId;
    api('/server/' + serverId + '/schedules/' + scheduleId, 'PATCH', { enabled: this.checked }).then((r) => {
      if (r) showToast(this.checked ? 'Schedule enabled.' : 'Schedule disabled.', 'success');
      else this.checked = !this.checked;
    });
  });
});

document.querySelectorAll('.task-action').forEach((sel) => {
  sel.addEventListener('change', function () {
    const sched = this.dataset.schedule;
    document.querySelector('[data-schedule="' + sched + '"].task-fields-command').classList.toggle('hidden', this.value !== 'command');
    document.querySelector('[data-schedule="' + sched + '"].task-fields-power').classList.toggle('hidden', this.value !== 'power');
    document.querySelector('[data-schedule="' + sched + '"].task-fields-backup').classList.toggle('hidden', this.value !== 'backup');
  });
});

window.toggleTasks = (scheduleId) => {
  const wrap = document.querySelector('[data-schedule-id="' + scheduleId + '"] .tasks-wrap');
  wrap.classList.toggle('hidden');
};

window.runSchedule = async (scheduleId, name) => {
  if (!window.modal || typeof window.modal.confirm !== 'function') {
    if (!confirm('Run schedule "' + name + '" now?')) return;
  } else {
    await new Promise(resolve => {
      window.modal.confirm({ title: 'Run schedule', body: 'Run "' + name + '" now? Its tasks will execute immediately.', confirmLabel: 'Run', onConfirm: resolve });
    });
  }
  const result = await api('/server/' + serverId + '/schedules/' + scheduleId + '/run', 'POST');
  if (result) { showToast('Schedule run triggered.', 'success'); setTimeout(() => location.reload(), 1200); }
};

window.deleteSchedule = async (scheduleId, name) => {
  if (!window.modal || typeof window.modal.confirm !== 'function') {
    if (!confirm('Delete schedule "' + name + '"?')) return;
  } else {
    await new Promise(resolve => {
      window.modal.confirm({ title: 'Delete schedule', body: 'Delete "' + name + '"? This cannot be undone.', danger: true, confirmLabel: 'Delete', onConfirm: resolve });
    });
  }
  const result = await api('/server/' + serverId + '/schedules/' + scheduleId, 'DELETE');
  if (result) { showToast('Schedule deleted.', 'success'); setTimeout(() => location.reload(), 900); }
};

const pendingTasks = {};

function renderPendingTasks(scheduleId) {
  const wrap = document.querySelector('[data-pending-tasks="' + scheduleId + '"]');
  const saveBtn = document.querySelector('[data-save-tasks="' + scheduleId + '"]');
  const empty = document.querySelector('.sched-empty[data-schedule="' + scheduleId + '"]');
  if (!wrap || !saveBtn) return;
  const tasks = pendingTasks[scheduleId] || [];
  wrap.innerHTML = '';
  tasks.forEach((task, i) => {
    const label = task.action === 'command' ? task.payload.command : (task.action === 'power' ? task.payload.action : task.payload.name);
    const row = document.createElement('div');
    row.className = 'flex items-center justify-between gap-3 rounded-lg px-4 py-2.5 text-sm';
    row.style.cssText = 'background:var(--theme-bg-secondary);border:1px dashed var(--theme-accent)';
    row.innerHTML = '<div class="min-w-0 flex items-center gap-2.5">'
      + '<span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide shrink-0" style="background:var(--theme-accent-subtle);color:var(--theme-accent)">' + task.action + '</span>'
      + '<span class="truncate font-mono text-xs" style="color:var(--theme-text)">' + label.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</span>'
      + '<span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium shrink-0" style="background:var(--theme-accent-subtle);color:var(--theme-accent)">New</span>'
      + '</div>'
      + '<button type="button" class="text-xs inline-flex items-center gap-1 transition shrink-0" style="color:var(--theme-danger)"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>Remove</button>';
    row.querySelector('button').addEventListener('click', () => removePendingTask(scheduleId, i));
    wrap.appendChild(row);
  });
  saveBtn.classList.toggle('hidden', tasks.length === 0);
  if (empty) empty.classList.toggle('hidden', tasks.length > 0);
}

function removePendingTask(scheduleId, index) {
  pendingTasks[scheduleId].splice(index, 1);
  renderPendingTasks(scheduleId);
}

window.addTask = (scheduleId) => {
  const card = document.querySelector('[data-schedule-id="' + scheduleId + '"]');
  const action = card.querySelector('.task-action').value;
  let payload = {};
  if (action === 'command') {
    const command = card.querySelector('.task-command').value.trim();
    if (!command) { showToast('Enter a command.', 'error'); return; }
    payload = { command };
  } else if (action === 'power') {
    payload = { action: card.querySelector('.task-power').value };
  } else {
    const name = card.querySelector('.task-backup-name').value.trim();
    if (!name) { showToast('Enter a backup name.', 'error'); return; }
    payload = { name };
  }
  if (!pendingTasks[scheduleId]) pendingTasks[scheduleId] = [];
  pendingTasks[scheduleId].push({ action, payload });
  renderPendingTasks(scheduleId);
  card.querySelector('.task-command').value = '';
  card.querySelector('.task-backup-name').value = '';
  showToast('Task staged. Click "Save tasks" to apply.', 'success');
};

window.saveTasks = async (scheduleId) => {
  const tasks = pendingTasks[scheduleId] || [];
  if (!tasks.length) return;
  const btn = document.querySelector('[data-save-tasks="' + scheduleId + '"]');
  btn.disabled = true;
  btn.classList.add('opacity-60', 'pointer-events-none');
  let ok = true;
  for (const task of tasks) {
    const result = await api('/server/' + serverId + '/schedules/' + scheduleId + '/tasks', 'POST', { action: task.action, payload: task.payload });
    if (!result) { ok = false; break; }
  }
  btn.disabled = false;
  btn.classList.remove('opacity-60', 'pointer-events-none');
  if (!ok) return;
  delete pendingTasks[scheduleId];
  renderPendingTasks(scheduleId);
  showToast('Tasks saved.', 'success');
  setTimeout(() => location.reload(), 900);
};

window.deleteTask = async (scheduleId, taskId) => {
  const result = await api('/server/' + serverId + '/schedules/' + scheduleId + '/tasks/' + taskId, 'DELETE');
  if (!result) return;
  const row = document.querySelector('[data-task-row="' + taskId + '"]');
  if (row) row.remove();
  const card = document.querySelector('[data-schedule-id="' + scheduleId + '"]');
  const empty = card && card.querySelector('.sched-empty');
  if (empty) empty.classList.toggle('hidden', (pendingTasks[scheduleId] || []).length > 0 || card.querySelectorAll('.task-row').length > 0);
  showToast('Task removed.', 'success');
};
</script>

