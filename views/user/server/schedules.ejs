<%- include('../../layouts/user', { title: t('schedules') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('schedules') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= server.name || t('server') %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
  <div>
    <button id="addScheduleBtn" onclick="openAddScheduleModal()" type="button" class="al-btn-primary min-h-11">
      <%- icon('plus', { class: 'w-4 h-4', strokeWidth: 1.5 }) %> <%= t('newSchedule') %>
    </button>
  </div>
</header>

<div class="al-page-body">

  <% if (schedules && schedules.length > 0) { %>
  <!-- Schedules List -->
  <div class="al-table-wrapper">
    <div class="overflow-x-auto">
      <table class="al-table al-table-card w-full sm:min-w-[860px]">
        <thead class="al-table-thead">
          <tr>
            <th scope="col" class="al-table-th"><%= t('name') %></th>
            <th scope="col" class="al-table-th"><%= t('scheduleColumn') %></th>
            <th scope="col" class="al-table-th"><%= t('tasksColumn') %></th>
            <th scope="col" class="al-table-th"><%= t('enabledColumn') %></th>
            <th scope="col" class="al-table-th text-right"><%= t('actionsColumn') %></th>
          </tr>
        </thead>
        <tbody>
          <% schedules.forEach(function(schedule) { %>
            <tr class="al-table-tr" data-schedule-id="<%= schedule.id %>">
              <td class="al-table-td" data-label="<%= t('name') %>">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= schedule.name %></span>
                  <% if (!schedule.enabled) { %>
                  <span class="al-badge al-badge-neutral"><%= t('disabled') %></span>
                  <% } %>
                </div>
                <div class="flex items-center gap-x-4 gap-y-1 mt-1.5 flex-wrap text-[11px]" style="color:var(--theme-text-muted)">
                  <span class="inline-flex items-center gap-1">
                    <%- icon('clock', { class: 'w-3 h-3' }) %>
                    <%= t('nextLabel') %> <%= schedule.nextRunAt ? new Date(schedule.nextRunAt).toLocaleString() : '—' %>
                  </span>
                  <span class="inline-flex items-center gap-1">
                    <%- icon('history', { class: 'w-3 h-3' }) %>
                    <%= t('lastLabel') %> <%= schedule.lastRunAt ? new Date(schedule.lastRunAt).toLocaleString() : t('neverLabel') %>
                  </span>
                </div>
              </td>
              <td class="al-table-td" data-label="<%= t('scheduleColumn') %>">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="al-chip al-chip-accent al-chip-mono" title="<%= t('cronExpression') %>"><%= schedule.cron %></span>
                  <% if (schedule.timeOffset) { %>
                  <span class="al-chip al-chip-mono" title="<%= t('offsetLabel') %>"><%= schedule.timeOffset > 0 ? '+' : '' %><%= schedule.timeOffset %>m</span>
                  <% } %>
                </div>
              </td>
              <td class="al-table-td" data-label="<%= t('tasksColumn') %>">
                <div class="flex items-center gap-2">
                  <span class="text-sm tabular-nums" style="color:var(--theme-text)" data-task-count="<%= schedule.id %>"><%= schedule.tasks ? schedule.tasks.length : 0 %></span>
                  <button type="button" onclick="toggleTasks(<%= schedule.id %>)" data-manage-tasks="<%= schedule.id %>" aria-expanded="false"
                    class="al-btn-secondary al-btn-sm min-h-11">
                    <%- icon('settings', { class: 'w-3.5 h-3.5' }) %>
                    <span data-manage-label="<%= schedule.id %>"><%= t('manage') %></span>
                  </button>
                </div>
              </td>
              <td class="al-table-td" data-label="<%= t('enabledColumn') %>">
                <label class="relative inline-flex items-center cursor-pointer min-h-11" title="<%= schedule.enabled ? t('disableSchedule') : t('enableSchedule') %>">
                  <input type="checkbox" class="sr-only peer sched-toggle" <%= schedule.enabled ? 'checked' : '' %> aria-label="<%= schedule.enabled ? t('disableSchedule') : t('enableSchedule') %>">
                  <span class="al-toggle-track"><span class="al-toggle-dot"></span></span>
                </label>
              </td>
              <td class="al-table-td text-right whitespace-nowrap" data-label="<%= t('actionsColumn') %>">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="runSchedule(<%= schedule.id %>, '<%= schedule.name.replace(/'/g, "\\'") %>')"
                    class="al-btn-success al-btn-sm min-h-11">
                    <%- icon('play', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %>
                    <%= t('run') %>
                  </button>
                  <button type="button" onclick="deleteSchedule(<%= schedule.id %>, '<%= schedule.name.replace(/'/g, "\\'") %>')"
                    class="al-btn-danger al-btn-sm min-h-11">
                    <%- icon('trash-2', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %>
                    <%= t('delete') %>
                  </button>
                </div>
              </td>
            </tr>

            <!-- Tasks Row (hidden by default) -->
            <tr data-tasks-row="<%= schedule.id %>" class="hidden">
              <td colspan="5" class="al-table-td" data-label="">
                <div class="tasks-wrap hidden flex-col gap-3 p-3 sm:p-0">
                  <!-- Existing tasks -->
                  <div class="flex flex-col">
                    <% if (schedule.tasks && schedule.tasks.length > 0) { %>
                      <% schedule.tasks.forEach(function(task) { %>
                        <div class="flex items-center justify-between gap-3 py-2 border-t first:border-t-0" style="border-color:var(--theme-border)" data-task-row="<%= task.id %>">
                          <div class="min-w-0 flex items-center gap-2.5">
                            <span class="al-chip al-chip-accent"><%= t(task.action) %></span>
                            <span class="truncate font-mono text-xs" style="color:var(--theme-text-strong)">
                              <%= task.action === 'command' ? task.payload.command : (task.action === 'power' ? t(task.payload.action) : (task.payload.name || '')) %>
                            </span>
                            <% if (task.timeOffset > 0) { %>
                            <span class="shrink-0 text-[11px] font-medium" style="color:var(--theme-text-muted)">+<%= task.timeOffset %>s</span>
                            <% } %>
                          </div>
                          <button type="button" onclick="deleteTask(<%= schedule.id %>, <%= task.id %>)"
                            class="al-btn-danger al-btn-icon-only shrink-0"
                            aria-label="<%= t('removeTask') %>">
                            <%- icon('x', { class: 'w-4 h-4' }) %>
                          </button>
                        </div>
                      <% }); %>
                    <% } else { %>
                      <p class="text-xs pb-2" style="color:var(--theme-text-muted)"><%= t('noTasks') %></p>
                    <% } %>
                  </div>

                  <!-- Add task form -->
                  <div class="al-panel">
                    <div class="flex flex-wrap items-end gap-3">
                      <div class="al-form-field w-36">
                        <label class="al-form-label" for="task-action-<%= schedule.id %>"><%= t('actionLabel') %></label>
                        <select data-schedule="<%= schedule.id %>" id="task-action-<%= schedule.id %>" class="task-action al-form-select">
                          <option value="command"><%= t('command') %></option>
                          <option value="power"><%= t('power') %></option>
                          <option value="backup"><%= t('backup') %></option>
                        </select>
                      </div>
                      <div class="al-form-field task-fields-command flex-1 min-w-[14rem]" data-schedule="<%= schedule.id %>">
                        <label class="al-form-label" for="task-command-<%= schedule.id %>"><%= t('commandLabel') %></label>
                        <input type="text" id="task-command-<%= schedule.id %>" class="task-command al-form-input" placeholder="<%= t('enterCommand') %>">
                      </div>
                      <div class="al-form-field task-fields-power hidden w-44" data-schedule="<%= schedule.id %>">
                        <label class="al-form-label" for="task-power-<%= schedule.id %>"><%= t('powerActionLabel') %></label>
                        <select id="task-power-<%= schedule.id %>" class="task-power al-form-select">
                          <option value="start"><%= t('start') %></option>
                          <option value="stop"><%= t('stop') %></option>
                          <option value="restart"><%= t('restart') %></option>
                        </select>
                      </div>
                      <div class="al-form-field task-fields-backup hidden flex-1 min-w-[14rem]" data-schedule="<%= schedule.id %>">
                        <label class="al-form-label" for="task-backup-<%= schedule.id %>"><%= t('backupNameLabel') %></label>
                        <input type="text" id="task-backup-<%= schedule.id %>" class="task-backup-name al-form-input" placeholder="<%= t('enterBackupName') %>">
                      </div>
                      <div class="al-form-field w-28">
                        <label class="al-form-label" for="task-offset-<%= schedule.id %>"><%= t('offsetLabel') %></label>
                        <input type="number" id="task-offset-<%= schedule.id %>" class="task-timeOffset al-form-input" value="0" min="0">
                      </div>
                      <button type="button" onclick="addTask(<%= schedule.id %>)" class="al-btn-secondary al-btn-sm min-h-11">
                        <%- icon('plus', { class: 'w-3.5 h-3.5' }) %><%= t('addTask') %>
                      </button>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <% } else { %>
    <%- include('../../partials/empty-state', {
      iconName: 'calendar',
      title: t('noSchedules'),
      description: t('noSchedulesDesc'),
      action: '<button type="button" onclick="openAddScheduleModal()" class="al-btn-primary min-h-11">' + icon('plus', { class: 'w-4 h-4', strokeWidth: 1.5 }) + ' ' + t('newSchedule') + '</button>'
    }) %>
  <% } %>
</div>

<!-- Add Schedule Modal -->
<div id="addScheduleModal" class="al-sheet-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="addScheduleModalTitle">
  <div class="al-sheet-panel w-full sm:max-w-md flex flex-col rounded-2xl shadow-xl" style="background:var(--theme-bg-card);">
    <div class="al-sheet-header">
      <div class="min-w-0">
        <h3 id="addScheduleModalTitle" class="al-card-title"><%= t('newSchedule') %></h3>
      </div>
      <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" data-close-sched-modal aria-label="<%= t('close') %>"><%- icon('x', { class: 'w-5 h-5' }) %></button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <div class="al-form-field">
        <label for="scheduleName" class="al-form-label"><%= t('scheduleName') %></label>
        <input id="scheduleName" type="text" class="al-form-input" placeholder="<%= t('enterScheduleName') %>">
      </div>
      <div class="al-form-field mt-4">
        <label for="scheduleCron" class="al-form-label"><%= t('cronExpression') %></label>
        <input id="scheduleCron" type="text" class="al-form-input font-mono" placeholder="0 4 * * *">
        <p class="al-form-help"><%= t('cronHint') %></p>
      </div>
    </div>
    <div class="al-sheet-footer justify-end">
      <button type="button" data-close-sched-modal class="al-btn-secondary al-btn-sm min-h-11"><%= t('cancel') %></button>
      <button type="button" id="confirmAddSchedule" class="al-btn-primary al-btn-sm min-h-11">
        <%- icon('plus', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %><span><%= t('createSchedule') %></span>
      </button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
(function() {
  var serverId = '<%= server.UUID %>';
  var T = <%- JSON.stringify({
    enterScheduleName: t('enterScheduleName'),
    enterCronExpression: t('enterCronExpression'),
    enterCommand: t('enterCommand'),
    enterBackupName: t('enterBackupName'),
    scheduleCreated: t('scheduleCreated'),
    failedCreateSchedule: t('failedCreateSchedule'),
    scheduleRunTriggered: t('scheduleRunTriggered'),
    scheduleDeleted: t('scheduleDeleted'),
    scheduleEnabledToast: t('scheduleEnabledToast'),
    scheduleDisabledToast: t('scheduleDisabledToast'),
    taskAdded: t('taskAdded'),
    taskRemoved: t('taskRemoved'),
    requestFailed: t('requestFailed'),
    manage: t('manage'),
    close: t('close'),
    run: t('run'),
    delete: t('delete'),
    runSchedule: t('runSchedule'),
    runScheduleConfirmBody: t('runScheduleConfirmBody'),
    deleteSchedule: t('deleteSchedule'),
    deleteScheduleConfirmBody: t('deleteScheduleConfirmBody')
  }) %>;

  // Modal
  var modal = document.getElementById('addScheduleModal');
  window.openAddScheduleModal = function() {
    modal.style.display = 'flex';
    document.getElementById('scheduleName').value = '';
    document.getElementById('scheduleCron').value = '';
    document.getElementById('scheduleName').focus();
  };
  function closeModal() { modal.style.display = 'none'; }
  document.querySelectorAll('[data-close-sched-modal]').forEach(function(btn) { btn.addEventListener('click', closeModal); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

  // Create schedule
  document.getElementById('confirmAddSchedule').addEventListener('click', async function() {
    var name = document.getElementById('scheduleName').value.trim();
    var cron = document.getElementById('scheduleCron').value.trim();
    if (!name) { showToast(T.enterScheduleName, 'error'); return; }
    if (!cron) { showToast(T.enterCronExpression, 'error'); return; }
    var btn = this;
    btn.disabled = true;
    try {
      var response = await fetch('/server/' + serverId + '/schedules', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ name: name, cron: cron })
      });
      var result = await response.json().catch(function() { return {}; });
      if (response.ok && result.success !== false) {
        showToast(T.scheduleCreated, 'success');
        closeModal();
        window.location.reload();
      } else {
        showToast(result.error || T.failedCreateSchedule, 'error');
      }
    } catch(e) {
      showToast(T.requestFailed, 'error');
    } finally { btn.disabled = false; }
  });

  // Toggle enabled
  document.querySelectorAll('.sched-toggle').forEach(function(toggle) {
    toggle.addEventListener('change', function() {
      var scheduleId = this.closest('[data-schedule-id]').dataset.scheduleId;
      var checked = this.checked;
      fetch('/server/' + serverId + '/schedules/' + scheduleId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ enabled: checked })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success !== false) showToast(checked ? T.scheduleEnabledToast : T.scheduleDisabledToast, 'success');
        else { toggle.checked = !checked; showToast(d.error || T.requestFailed, 'error'); }
      }).catch(function() { toggle.checked = !checked; showToast(T.requestFailed, 'error'); });
    });
  });

  // Toggle tasks row
  window.toggleTasks = function(scheduleId) {
    var row = document.querySelector('[data-tasks-row="' + scheduleId + '"]');
    var wrap = row && row.querySelector('.tasks-wrap');
    if (!wrap) return;
    var closed = wrap.classList.toggle('hidden');
    row.classList.toggle('hidden', closed);
    var btn = document.querySelector('[data-manage-tasks="' + scheduleId + '"]');
    if (btn) {
      btn.setAttribute('aria-expanded', String(!closed));
      var label = btn.querySelector('[data-manage-label="' + scheduleId + '"]');
      if (label) label.textContent = closed ? T.manage : T.close;
    }
  };

  // Run schedule
  window.runSchedule = async function(scheduleId, name) {
    await new Promise(function(resolve) {
      window.modal.confirm({
        title: T.runSchedule,
        body: T.runScheduleConfirmBody.replace('{{name}}', name),
        confirmLabel: T.run,
        onConfirm: resolve,
      });
    });
    var result = await fetch('/server/' + serverId + '/schedules/' + scheduleId + '/run', { method: 'POST', headers: { 'x-csrf-token': csrfToken } }).then(function(r) { return r.json(); }).catch(function() { return null; });
    if (result && result.success !== false) showToast(T.scheduleRunTriggered, 'success');
    else showToast((result && result.error) || T.requestFailed, 'error');
  };

  // Delete schedule
  window.deleteSchedule = async function(scheduleId, name) {
    await new Promise(function(resolve) {
      window.modal.confirm({
        title: T.deleteSchedule,
        body: T.deleteScheduleConfirmBody.replace('{{name}}', name),
        danger: true,
        confirmLabel: T.delete,
        onConfirm: resolve,
      });
    });
    var result = await fetch('/server/' + serverId + '/schedules/' + scheduleId, { method: 'DELETE' }).then(function(r) { return r.json(); }).catch(function() { return null; });
    if (result && result.success !== false) { showToast(T.scheduleDeleted, 'success'); window.location.reload(); }
    else showToast((result && result.error) || T.requestFailed, 'error');
  };

  // Task actions
  document.querySelectorAll('.task-action').forEach(function(sel) {
    sel.addEventListener('change', function() {
      var sched = this.dataset.schedule;
      document.querySelector('[data-schedule="' + sched + '"].task-fields-command').classList.toggle('hidden', this.value !== 'command');
      document.querySelector('[data-schedule="' + sched + '"].task-fields-power').classList.toggle('hidden', this.value !== 'power');
      document.querySelector('[data-schedule="' + sched + '"].task-fields-backup').classList.toggle('hidden', this.value !== 'backup');
    });
  });

  // Add task
  window.addTask = function(scheduleId) {
    var card = document.querySelector('[data-tasks-row="' + scheduleId + '"]');
    var action = card.querySelector('.task-action').value;
    var payload = {};
    if (action === 'command') {
      var command = card.querySelector('.task-command').value.trim();
      if (!command) { showToast(T.enterCommand, 'error'); return; }
      payload = { command: command };
    } else if (action === 'power') {
      payload = { action: card.querySelector('.task-power').value };
    } else {
      var backupName = card.querySelector('.task-backup-name').value.trim();
      if (!backupName) { showToast(T.enterBackupName, 'error'); return; }
      payload = { name: backupName };
    }
    var timeOffset = parseInt(card.querySelector('.task-timeOffset').value, 10) || 0;
    fetch('/server/' + serverId + '/schedules/' + scheduleId + '/tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ action: action, payload: payload, timeOffset: Math.max(0, timeOffset) })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success !== false) { showToast(T.taskAdded, 'success'); window.location.reload(); }
      else showToast(d.error || T.requestFailed, 'error');
    }).catch(function() { showToast(T.requestFailed, 'error'); });
  };

  // Delete task
  window.deleteTask = async function(scheduleId, taskId) {
    var result = await fetch('/server/' + serverId + '/schedules/' + scheduleId + '/tasks/' + taskId, { method: 'DELETE' }).then(function(r) { return r.json(); }).catch(function() { return null; });
    if (result && result.success !== false) {
      var row = document.querySelector('[data-task-row="' + taskId + '"]');
      if (row) row.remove();
      var count = document.querySelector('[data-task-count="' + scheduleId + '"]');
      if (count) count.textContent = String(Math.max(0, (parseInt(count.textContent, 10) || 1) - 1));
      showToast(T.taskRemoved, 'success');
    } else showToast((result && result.error) || T.requestFailed, 'error');
  };
})();
</script>

<%- include('../../layouts/user-footer') %>
