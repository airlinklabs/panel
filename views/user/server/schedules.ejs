                  class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2"
                  style="color:var(--theme-accent);background:var(--theme-accent-subtle)">
                  <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                  Add task
                </button>
                <button type="button" onclick="saveTasks(${result.id})" data-save-tasks="${result.id}"
                  class="hidden inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2"
                  style="color:var(--theme-accent-text);background:var(--theme-accent)">
                  <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Save tasks
                </button>
              </div>
            </div>
          </td>
        </tr>`;
      al.addRow(tbody, rowHtml);
    }
  } else {
    btn.removeAttribute('aria-busy');
    btn.disabled = false;
    btn.classList.remove('opacity-60', 'pointer-events-none');
    btn.querySelector('span').textContent = 'Create schedule';
  }
});

document.querySelectorAll('.sched-toggle').forEach((toggle) => {
  toggle.addEventListener('change', function () {
    const scheduleId = this.closest('[data-schedule-id]').dataset.scheduleId;
    this.setAttribute('aria-label', this.checked ? 'Disable schedule' : 'Enable schedule');
    this.closest('label').setAttribute('title', this.checked ? 'Disable schedule' : 'Enable schedule');
    api('/server/' + serverId + '/schedules/' + scheduleId, 'PATCH', { enabled: this.checked }).then((r) => {
      if (r) showToast(this.checked ? 'Schedule enabled.' : 'Schedule disabled.', 'success');
      else {
        this.checked = !this.checked;
        this.setAttribute('aria-label', this.checked ? 'Disable schedule' : 'Enable schedule');
        this.closest('label').setAttribute('title', this.checked ? 'Disable schedule' : 'Enable schedule');
      }
    });
  });
});

document.querySelectorAll('.task-action').forEach((sel) => {
  sel.addEventListener('change', function () {
    const sched = this.dataset.schedule;
    document.querySelector('[data-schedule="' + sched + '"].task-fields-command').classList.toggle('hidden', this.value !== 'command');
    document.querySelector('[data-schedule="' + sched + '"].task-fields-power').classList.toggle('hidden', this.value !== 'power');
    document.querySelector('[data-schedule="' + sched + '"].task-fields-backup').classList.toggle('hidden', this.value !== 'backup');
  });
});

window.toggleTasks = (scheduleId) => {
  const wrap = document.querySelector('[data-tasks-row="' + scheduleId + '"] .tasks-wrap');
  if (!wrap) return;
  const closed = wrap.classList.toggle('hidden');
  const btn = document.querySelector('[data-manage-tasks="' + scheduleId + '"]');
  if (btn) {
    btn.setAttribute('aria-expanded', String(!closed));
    const label = btn.querySelector('[data-manage-label="' + scheduleId + '"]');
    if (label) label.textContent = closed ? 'Manage' : 'Close';
  }
};

window.runSchedule = async (scheduleId, name) => {
  await new Promise(resolve => {
    window.modal.confirm({
      title: 'Run schedule',
      body: 'Run "' + name + '" now? Its tasks will execute immediately.',
      confirmLabel: 'Run',
      onConfirm: resolve,
    });
  });
  const result = await api('/server/' + serverId + '/schedules/' + scheduleId + '/run', 'POST');
  if (result) { showToast('Schedule run triggered.', 'success'); }
};

window.deleteSchedule = async (scheduleId, name) => {
  await new Promise(resolve => {
    window.modal.confirm({
      title: 'Delete schedule',
      body: 'Delete "' + name + '"? This cannot be undone.',
      danger: true,
      confirmLabel: 'Delete',
      onConfirm: resolve,
    });
  });
  const result = await api('/server/' + serverId + '/schedules/' + scheduleId, 'DELETE');
  if (result) {
    showToast('Schedule deleted.', 'success');
    const tr = document.querySelector('[data-schedule-id="' + scheduleId + '"]');
    const tasksTr = document.querySelector('[data-tasks-row="' + scheduleId + '"]');
    if (tr) al.removeRow(tr);
    if (tasksTr) al.removeRow(tasksTr);
  }
};

const pendingTasks = {};

function renderPendingTasks(scheduleId) {
  const wrap = document.querySelector('[data-pending-tasks="' + scheduleId + '"]');
  const saveBtn = document.querySelector('[data-save-tasks="' + scheduleId + '"]');
  const empty = document.querySelector('.sched-empty[data-schedule="' + scheduleId + '"]');
  if (!wrap || !saveBtn) return;
  const tasks = pendingTasks[scheduleId] || [];
  wrap.innerHTML = '';
  tasks.forEach((task, i) => {
    const label = task.action === 'command' ? task.payload.command : (task.action === 'power' ? task.payload.action : task.payload.name);
    const row = document.createElement('div');
    row.className = 'flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm';
    row.style.cssText = 'background:var(--theme-bg-card);border:1px dashed var(--theme-accent)';

    const left = document.createElement('div');
    left.className = 'min-w-0 flex items-center gap-2.5';

    const badge = document.createElement('span');
    badge.className = 'inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide shrink-0';
    badge.style.cssText = 'background:var(--theme-accent-subtle);color:var(--theme-accent)';
    badge.textContent = task.action;

    const labelEl = document.createElement('span');
    labelEl.className = 'truncate font-mono text-xs';
    labelEl.style.color = 'var(--theme-text)';
    labelEl.textContent = label;
    left.appendChild(badge);
    left.appendChild(labelEl);

    if (task.timeOffset > 0) {
      const off = document.createElement('span');
      off.className = 'shrink-0 text-[10px] font-medium';
      off.style.color = 'var(--theme-text-muted)';
      off.textContent = '+' + task.timeOffset + 's';
      left.appendChild(off);
    }
    row.appendChild(left);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'al-btn-ghost p-2 -mr-1.5 shrink-0';
    btn.style.color = 'var(--theme-danger)';
    btn.setAttribute('aria-label', 'Remove task');
    btn.innerHTML = '<%- icon('x', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %>';
    btn.addEventListener('click', () => removePendingTask(scheduleId, i));
    row.appendChild(btn);
    wrap.appendChild(row);
  });
  saveBtn.classList.toggle('hidden', tasks.length === 0);
  if (empty) empty.classList.toggle('hidden', tasks.length > 0);
}

function removePendingTask(scheduleId, index) {
  pendingTasks[scheduleId].splice(index, 1);
  renderPendingTasks(scheduleId);
}

window.addTask = (scheduleId) => {
  const card = document.querySelector('[data-tasks-row="' + scheduleId + '"]');
  const action = card.querySelector('.task-action').value;
  let payload = {};
  if (action === 'command') {
    const command = card.querySelector('.task-command').value.trim();
    if (!command) { showToast('Enter a command.', 'error'); return; }
    payload = { command };
  } else if (action === 'power') {
    payload = { action: card.querySelector('.task-power').value };
  } else {
    const name = card.querySelector('.task-backup-name').value.trim();
    if (!name) { showToast('Enter a backup name.', 'error'); return; }
    payload = { name };
  }
  if (!pendingTasks[scheduleId]) pendingTasks[scheduleId] = [];
  const timeOffset = parseInt(card.querySelector('.task-timeOffset').value, 10) || 0;
  pendingTasks[scheduleId].push({ action, payload, timeOffset: Math.max(0, timeOffset) });
  renderPendingTasks(scheduleId);
  card.querySelector('.task-command').value = '';
  card.querySelector('.task-backup-name').value = '';
  card.querySelector('.task-timeOffset').value = '0';
  showToast('Task staged. Click "Save tasks" to apply.', 'success');
};

window.saveTasks = async (scheduleId) => {
  const tasks = pendingTasks[scheduleId] || [];
  if (!tasks.length) return;
  const btn = document.querySelector('[data-save-tasks="' + scheduleId + '"]');
  btn.disabled = true;
  btn.classList.add('opacity-60', 'pointer-events-none');
  let ok = true;
  for (const task of tasks) {
    const result = await api('/server/' + serverId + '/schedules/' + scheduleId + '/tasks', 'POST', { action: task.action, payload: task.payload, timeOffset: task.timeOffset || 0 });
    if (!result) { ok = false; break; }
  }
  btn.disabled = false;
  btn.classList.remove('opacity-60', 'pointer-events-none');
  if (!ok) return;
  delete pendingTasks[scheduleId];
  renderPendingTasks(scheduleId);
  showToast('Tasks saved.', 'success');
};

window.deleteTask = async (scheduleId, taskId) => {
  const result = await api('/server/' + serverId + '/schedules/' + scheduleId + '/tasks/' + taskId, 'DELETE');
  if (!result) return;
  const row = document.querySelector('[data-task-row="' + taskId + '"]');
  if (row) row.remove();
  const tasksRow = document.querySelector('[data-tasks-row="' + scheduleId + '"]');
  const empty = tasksRow && tasksRow.querySelector('.sched-empty');
  if (empty) empty.classList.toggle('hidden', (pendingTasks[scheduleId] || []).length > 0 || (tasksRow && tasksRow.querySelectorAll('.task-row').length > 0));
  const count = document.querySelector('[data-task-count="' + scheduleId + '"]');
  if (count) count.textContent = String(Math.max(0, (parseInt(count.textContent, 10) || 1) - 1));
  showToast('Task removed.', 'success');
};
})();
</script>

<%- include('../../components/footer') %>
