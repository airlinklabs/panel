<%- include('../../layouts/user', { title: (server.name || t('server')) + ' — ' + t('backups') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('backups') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('backups') %></h1>
    <p class="al-page-desc"><%= t('backupsPageDesc') %></p>
  </div>
  <div>
    <button id="createBackupBtn" type="button" class="al-btn-primary min-h-11" data-url="/server/<%= server.UUID %>/backups/create">
      <%- icon('plus', { class: 'w-4 h-4', strokeWidth: 2 }) %> <%= t('createBackup') %>
    </button>
  </div>
</header>

<div class="al-page-body" data-server-uuid="<%= server.UUID %>">

  <!-- Progress Bar -->
  <div id="backup-progress" class="hidden mb-4">
    <div class="al-panel">
      <div class="flex items-center justify-between mb-2">
        <span id="progress-label" class="text-sm font-medium al-text-strong"><%= t('creatingBackupLabel') %></span>
        <span id="progress-percent" class="text-sm tabular-nums al-text-muted">0%</span>
      </div>
      <div class="w-full h-2 rounded-full" style="background:var(--theme-bg);" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-labelledby="progress-label">
        <div id="progress-bar" class="h-full rounded-full transition-all duration-300" style="background:var(--theme-primary);width:0%;"></div>
      </div>
    </div>
  </div>

  <!-- Restore Progress -->
  <div id="restore-progress" class="hidden mb-4">
    <div class="al-panel">
      <div class="flex items-center justify-between mb-2">
        <span id="restore-progress-label" class="text-sm font-medium al-text-strong"><%= t('restoringBackupLabel') %></span>
        <span id="restore-progress-percent" class="text-sm tabular-nums al-text-muted">0%</span>
      </div>
      <div class="w-full h-2 rounded-full" style="background:var(--theme-bg);" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-labelledby="restore-progress-label">
        <div id="restore-progress-bar" class="h-full rounded-full transition-all duration-300" style="background:var(--theme-primary);width:0%;"></div>
      </div>
    </div>
  </div>

  <!-- Backup List -->
  <div id="backup-list">
    <% if (!backups || backups.length === 0) { %>
      <div class="al-card">
        <div class="al-state-panel">
          <div class="al-icon-tile al-icon-tile-lg mb-3" aria-hidden="true">
            <%- icon('archive', { class: 'w-5 h-5', strokeWidth: 1.5 }) %>
          </div>
          <p class="text-sm mb-1 al-text-strong"><%= t('noBackups') %></p>
          <p class="text-xs al-text-muted"><%= t('noBackupsDesc') %></p>
        </div>
      </div>
    <% } else { %>
      <% backups.forEach(function(backup) { %>
        <div class="al-card mb-3 flex flex-col sm:flex-row sm:items-center gap-3" data-backup-id="<%= backup.UUID %>">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <p class="text-sm font-medium truncate al-text-strong"><%= backup.name %></p>
              <% if (backup.locked) { %>
                <span class="al-badge al-badge-warning">
                  <%- icon('lock', { class: 'size-3', strokeWidth: 2 }) %>
                  <%= t('locked') %>
                </span>
              <% } %>
            </div>
            <p class="text-xs al-text-muted">
              <%= backup.createdAt ? new Date(backup.createdAt).toLocaleString() : '' %>
              <% if (backup.size) { %> · <%= (Number(backup.size) / 1024 / 1024).toFixed(1) %> MB<% } %>
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2 shrink-0 w-full sm:w-auto">
            <button type="button" class="lock-btn al-btn-secondary al-btn-sm min-h-11" data-backup-id="<%= backup.UUID %>" data-locked="<%= backup.locked %>">
              <%- icon(backup.locked ? 'unlock' : 'lock', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %>
              <%= backup.locked ? t('unlock') : t('lock') %>
            </button>
            <a href="/server/<%= server.UUID %>/backups/<%= backup.UUID %>/download" class="al-btn-secondary al-btn-sm min-h-11">
              <%- icon('download', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %> <%= t('download') %>
            </a>
            <button type="button" class="restore-btn al-btn-secondary al-btn-sm min-h-11" data-backup-id="<%= backup.UUID %>">
              <%- icon('rotate-ccw', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %> <%= t('restore') %>
            </button>
            <button type="button" class="delete-btn al-btn-danger al-btn-icon-only" data-backup-id="<%= backup.UUID %>" aria-label="<%= t('delete') %>">
              <%- icon('trash-2', { class: 'w-4 h-4', strokeWidth: 2 }) %>
            </button>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

</div>

<script type="module" nonce="<%- nonce %>">
  import { mount } from '<%= assetUrl('/javascript/user/server/backups.js') %>';
  const root = document.querySelector('[data-server-uuid]');
  if (root) mount(root);
</script>

<%- include('../../layouts/user-footer') %>
