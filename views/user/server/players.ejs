<%- include('../../layouts/user', { title: (server.name || t('server')) + ' — ' + t('players') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('players') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= server.name || t('server') %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
  <div>
    <button id="refreshPlayersBtn" type="button" class="al-btn-secondary min-h-11">
      <%- icon('refresh-cw', { class: 'w-4 h-4', strokeWidth: 2 }) %> <%= t('refresh') %>
    </button>
  </div>
</header>

<div class="al-page-body" data-server-uuid="<%= server.UUID %>">

  <!-- Online Players -->
  <div class="al-card">
    <div class="al-card-header">
      <div class="min-w-0"><h2 class="al-card-title"><%= t('online') %></h2></div>
      <span id="online-count" class="al-badge al-badge-online">0</span>
    </div>
    <div class="al-card-body">
      <div id="online-players" class="hidden"></div>
      <div id="online-empty"><%- include('../../partials/empty-state', { iconName: 'users', title: t('noPlayersOnline') }) %></div>
    </div>
  </div>

  <!-- Banned Players -->
  <div class="al-card mt-4">
    <div class="al-card-header">
      <div class="min-w-0"><h2 class="al-card-title"><%= t('banned') %></h2></div>
      <span id="banned-count" class="al-badge al-badge-offline">0</span>
    </div>
    <div class="al-card-body">
      <div id="banned-players" class="hidden"></div>
      <div id="banned-empty"><%- include('../../partials/empty-state', { iconName: 'shield-off', title: t('noBannedPlayers') }) %></div>
    </div>
  </div>

  <!-- Whitelist (if enabled) -->
  <div class="al-card mt-4 hidden" id="whitelist-card">
    <div class="al-card-header">
      <div class="min-w-0"><h2 class="al-card-title"><%= t('whitelisted') %></h2></div>
      <span id="whitelist-count" class="al-badge al-badge-info">0</span>
    </div>
    <div class="al-card-body">
      <div id="whitelisted-players" class="hidden"></div>
      <div id="whitelisted-empty"><%- include('../../partials/empty-state', { iconName: 'list-checks', title: t('noWhitelistedPlayers') }) %></div>
    </div>
  </div>

</div>

<!-- Player Action Modal -->
<div id="player-modal" class="al-sheet-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="al-sheet-panel w-full sm:max-w-md flex flex-col rounded-2xl shadow-xl" style="background:var(--theme-bg-card);">
    <div class="al-sheet-header">
      <div class="min-w-0"><h3 id="modal-title" class="al-card-title"></h3></div>
      <button id="modal-close" type="button" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'w-5 h-5' }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <p id="modal-desc" class="text-sm" style="color:var(--theme-text-muted)"></p>
    </div>
    <div class="al-sheet-footer justify-end">
      <button id="modal-cancel" type="button" class="al-btn-secondary al-btn-sm min-h-11"><%= t('cancel') %></button>
      <button id="modal-confirm" type="button" class="al-btn-danger al-btn-sm min-h-11"><%= t('confirm') %></button>
    </div>
  </div>
</div>

<script type="module" nonce="<%- nonce %>">
  const serverUUID = document.querySelector('[data-server-uuid]')?.dataset.serverUuid;
  const modal = document.getElementById('player-modal');
  const T = <%- JSON.stringify({
    kick: t('kick'),
    ban: t('ban'),
    pardon: t('pardon'),
    whitelistRemove: t('removeFromWhitelist'),
    confirmKick: t('confirmKick'),
    confirmBan: t('confirmBan'),
    confirmPardon: t('confirmPardon'),
    confirmWhitelistRemove: t('confirmWhitelistRemove'),
    noPlayersOnline: t('noPlayersOnline'),
    noBannedPlayers: t('noBannedPlayers'),
    noWhitelistedPlayers: t('noWhitelistedPlayers'),
    playerKicked: t('playerKicked'),
    playerBanned: t('playerBanned'),
    playerPardoned: t('playerPardoned'),
    playerWhitelistRemoved: t('playerWhitelistRemoved')
  }) %>;
  let currentPlayer = null;
  let currentAction = null;

  const actionMeta = {
    kick: { label: T.kick, confirm: T.confirmKick, success: T.playerKicked },
    ban: { label: T.ban, confirm: T.confirmBan, success: T.playerBanned },
    pardon: { label: T.pardon, confirm: T.confirmPardon, success: T.playerPardoned },
    'whitelist-remove': { label: T.whitelistRemove, confirm: T.confirmWhitelistRemove, success: T.playerWhitelistRemoved }
  };

  function setList(listEl, emptyEl, html) {
    listEl.innerHTML = html;
    listEl.classList.toggle('hidden', !html);
    emptyEl.classList.toggle('hidden', !!html);
  }

  function renderPlayerRow(player, actions) {
    return `
      <div class="flex items-center justify-between gap-3 py-3 border-t first:border-t-0" style="border-color:var(--theme-border)">
        <div class="flex items-center gap-3 min-w-0">
          <img src="https://mc-heads.net/avatar/${player.uuid || player.name}/32" alt="" class="w-8 h-8 rounded-full shrink-0" style="background:var(--theme-bg-secondary)" onerror="this.outerHTML='<span class=\'al-avatar al-avatar-sm\'>${(player.name||'?').slice(0,1)}</span>'">
          <div class="min-w-0">
            <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong)">${player.name || '—'}</p>
            <p class="text-[11px] font-mono truncate" style="color:var(--theme-text-muted)">${player.uuid || ''}</p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          ${actions.map(a => `
            <button type="button" class="player-action-btn al-btn-secondary al-btn-sm min-h-11" data-player="${player.name || player.uuid}" data-action="${a.action}">
              ${a.label}
            </button>
          `).join('')}
        </div>
      </div>`;
  }

  function wireActions() {
    document.querySelectorAll('.player-action-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentPlayer = btn.dataset.player;
        currentAction = btn.dataset.action;
        const meta = actionMeta[currentAction] || { label: currentAction, confirm: '' };
        document.getElementById('modal-title').textContent = meta.label;
        document.getElementById('modal-desc').textContent = (meta.confirm || '').replace('{{name}}', currentPlayer);
        modal.style.display = 'flex';
      });
    });
  }

  async function loadPlayers() {
    try {
      const res = await fetch(`/server/${serverUUID}/players/data`);
      const data = await res.json();
      const d = data.data || data || {};
      const online = d.online || [];
      const banned = d.banned || [];
      const whitelisted = d.whitelisted || [];

      document.getElementById('online-count').textContent = online.length;
      document.getElementById('banned-count').textContent = banned.length;

      setList(
        document.getElementById('online-players'),
        document.getElementById('online-empty'),
        online.length ? online.map(p => renderPlayerRow(p, [
          { action: 'kick', label: T.kick },
          { action: 'ban', label: T.ban },
        ])).join('') : ''
      );

      setList(
        document.getElementById('banned-players'),
        document.getElementById('banned-empty'),
        banned.length ? banned.map(p => renderPlayerRow(p, [
          { action: 'pardon', label: T.pardon },
        ])).join('') : ''
      );

      if (whitelisted.length > 0 || d.whitelistEnabled) {
        document.getElementById('whitelist-card').classList.remove('hidden');
        document.getElementById('whitelist-count').textContent = whitelisted.length;
        setList(
          document.getElementById('whitelisted-players'),
          document.getElementById('whitelisted-empty'),
          whitelisted.length ? whitelisted.map(p => renderPlayerRow(p, [
            { action: 'whitelist-remove', label: T.whitelistRemove },
          ])).join('') : ''
        );
      }

      wireActions();
    } catch (e) {
      console.error('Failed to load players', e);
    }
  }

  async function executeAction() {
    if (!currentPlayer || !currentAction) return;
    try {
      const res = await fetch(`/server/${serverUUID}/players/${encodeURIComponent(currentPlayer)}/${currentAction}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
      const data = await res.json();
      if (data.success !== false) {
        const meta = actionMeta[currentAction];
        if (window.showToast) window.showToast(meta ? meta.success : currentAction, 'success');
        loadPlayers();
      }
    } catch (e) {
      console.error('Action failed', e);
    }
    closeModal();
  }

  function closeModal() {
    modal.style.display = 'none';
    currentPlayer = null;
    currentAction = null;
  }

  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  document.getElementById('modal-cancel')?.addEventListener('click', closeModal);
  document.getElementById('modal-confirm')?.addEventListener('click', executeAction);
  document.getElementById('refreshPlayersBtn')?.addEventListener('click', loadPlayers);

  loadPlayers();
  setInterval(loadPlayers, 15000);
</script>

<%- include('../../layouts/user-footer') %>
