<% if (isMobileViewport) { %>
<%- include('../../components/header', { title: 'Players' }) %>
<main id="page-content">
    <%- include('../../components/template') %>
    <section class="px-4 py-5">
        <%- include('../../components/serverHeader', { server: server, req: req }) %>
        <%- include('../../components/installHeader') %>

        <% if (errorMessage && errorMessage.message) { %>
        <div data-animate-card class="rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3 mb-4 flex items-start gap-3">
          <%- icon('triangle-alert', { class: 'w-4 h-4 text-red-500 mt-0.5 shrink-0', strokeWidth: 2 }) %>
          <div>
            <p class="text-xs font-medium text-red-700 dark:text-red-400"><%= req.translations.connectionError || 'Error' %></p>
            <p class="text-xs text-red-600 dark:text-red-400/70 mt-0.5"><%= errorMessage.message %></p>
          </div>
        </div>
        <% } %>

        <%- include('../../components/serverTemplate', { features: ['players', 'worlds'] }) %>

        <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4 mb-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-neutral-800 dark:text-white">Players</p>
              <p class="text-xs text-neutral-500 mt-0.5">
                <% if (typeof serverInfo !== 'undefined') { %>
                  <%= serverInfo.onlinePlayers || 0 %> / <%= serverInfo.maxPlayers || 0 %> online
                  <% if (serverInfo.version) { %> &middot; v<%= serverInfo.version %><% } %>
                <% } else { %>
                  Manage your server's player list
                <% } %>
              </p>
            </div>
            <div class="text-xs text-neutral-500 flex items-center gap-1.5">
              <%- icon('refresh-cw', { class: 'h-3 w-3', strokeWidth: 2 }) %>
              <span><span id="refresh-countdown">30</span>s</span>
                      <button type="button" onclick="window.location.reload()" class="rounded-lg bg-transparent px-2 py-1 text-sm font-medium transition text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800">now</button>
            </div>
          </div>
        </div>

        <% if (players && players.length > 0) { %>
        <div id="PlayersGrid" class="grid grid-cols-2 gap-3">
          <% players.forEach(function(player) { %>
          <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-3 flex items-center gap-3">
            <img
              src="https://crafatar.com/avatars/<%= player.uuid %>?size=64&overlay"
              alt="<%= player.name %>"
              class="w-10 h-10 rounded-lg border border-neutral-200 dark:border-white/10 shrink-0"
            />
            <div class="min-w-0">
              <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= player.name %></p>
              <div class="flex items-center gap-1 mt-0.5">
                <span class="inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-[10px] text-neutral-500"><%= req.translations.online || 'Online' %></span>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div id="no-players-message" class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-8 text-center">
          <% if (!serverIsOnline && errorMessage && errorMessage.message) { %>
            <div class="w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-700/50 flex items-center justify-center mx-auto mb-3">
              <%- icon('wifi-off', { class: 'w-5 h-5 text-neutral-400', strokeWidth: 1.5 }) %>
            </div>
            <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Server offline</p>
            <p class="text-xs text-neutral-500 mt-1">Start your server to see online players.</p>
            <div class="mt-4">
                      <button type="button" onclick="window.location.reload()" class="rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 px-4 py-2 text-sm font-medium transition">Refresh</button>
            </div>
          <% } else if (serverIsOnline) { %>
            <div class="w-12 h-12 rounded-full bg-emerald-50 dark:bg-emerald-700/20 flex items-center justify-center mx-auto mb-3">
              <span class="inline-flex h-3 w-3 rounded-full bg-emerald-500"></span>
            </div>
            <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">No players online</p>
            <p class="text-xs text-neutral-500 mt-1">Players appear here when they join.</p>
            <% if (typeof serverInfo !== 'undefined' && serverInfo) { %>
            <p class="text-xs text-neutral-400 mt-2">v<%= serverInfo.version %> &middot; <%= serverInfo.onlinePlayers %>/<%= serverInfo.maxPlayers %></p>
            <% } %>
          <% } else { %>
            <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Status unknown</p>
            <p class="text-xs text-neutral-500 mt-1">The server may be starting up.</p>
          <% } %>
        </div>
        <% } %>
    </section>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/footer') %>

<% } else { %>
<%- include('../../components/header', { title: 'Players' }) %>
<main class="h-screen m-auto">
    <div class="flex h-screen">
        <%- include('../../components/template') %>
        <section id="page-content" class="flex-1 overflow-y-auto pt-16">
            <div class="px-8 pt-4">
                <%- include('../../components/serverHeader', { server: server, req: req }) %>
            </div>
            <%- include('../../components/installHeader') %>

            <% if (errorMessage && errorMessage.message) { %>
            <div class="mx-8 mt-4 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 flex items-start gap-3">
              <%- icon('triangle-alert', { class: 'w-4 h-4 text-red-500 mt-0.5 shrink-0', strokeWidth: 2 }) %>
              <div>
                <p class="text-sm font-medium text-red-700 dark:text-red-400"><%= req.translations.connectionError || 'Error' %></p>
                <p class="text-xs text-red-600 dark:text-red-400/70 mt-0.5"><%= errorMessage.message %></p>
              </div>
            </div>
            <% } %>

            <%- include('../../components/serverTemplate', { features: ['players', 'worlds'] }) %>

            <div class="p-6">
                <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-5 mb-5">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm font-medium text-neutral-800 dark:text-white">Players</p>
                      <p class="text-xs text-neutral-500 mt-0.5">
                        <% if (typeof serverInfo !== 'undefined') { %>
                          <%= serverInfo.onlinePlayers || 0 %> / <%= serverInfo.maxPlayers || 0 %> online
                          <% if (serverInfo.version) { %> &middot; v<%= serverInfo.version %><% } %>
                        <% } else { %>
                          Manage your server's player list
                        <% } %>
                      </p>
                    </div>
                    <div class="text-xs text-neutral-500 flex items-center gap-1.5">
                      <%- icon('refresh-cw', { class: 'h-3 w-3', strokeWidth: 2 }) %>
                      <span><span id="refresh-countdown">30</span>s</span>
                       <button type="button" onclick="window.location.reload()" class="rounded-lg bg-transparent px-2 py-1 text-sm font-medium transition text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800">now</button>
                    </div>
                  </div>
                </div>

                <% if (players && players.length > 0) { %>
                <div id="PlayersGrid" class="grid grid-cols-2 lg:grid-cols-3 gap-3">
                  <% players.forEach(function(player) { %>
                  <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4 flex items-center justify-between">
                    <div class="flex items-center gap-3 min-w-0">
                      <img
                        src="https://crafatar.com/avatars/<%= player.uuid %>?size=64&overlay"
                        alt="<%= player.name %>"
                        class="w-10 h-10 rounded-lg border border-neutral-200 dark:border-white/10 shrink-0"
                      />
                      <div class="min-w-0">
                        <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= player.name %></p>
                        <div class="flex items-center gap-1 mt-0.5">
                          <span class="inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                          <span class="text-[10px] text-neutral-500"><%= req.translations.online || 'Online' %></span>
                        </div>
                      </div>
                    </div>
                    <button type="button" onclick="kickPlayer('<%= player.name %>')" class="rounded-lg bg-red-600 text-white px-4 py-2 text-sm font-medium transition hover:bg-red-700 shrink-0">Kick</button>
                  </div>
                  <% }); %>
                </div>
                <% } else { %>
                <div id="no-players-message" class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-8 text-center">
                  <% if (!serverIsOnline && errorMessage && errorMessage.message) { %>
                    <div class="w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-700/50 flex items-center justify-center mx-auto mb-3">
                      <%- icon('wifi-off', { class: 'w-5 h-5 text-neutral-400', strokeWidth: 1.5 }) %>
                    </div>
                    <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Server offline</p>
                    <p class="text-xs text-neutral-500 mt-1">Start your server to see online players.</p>
                    <div class="mt-4">
              <button type="button" onclick="window.location.reload()" class="rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 px-4 py-2 text-sm font-medium transition">Refresh</button>
                    </div>
                  <% } else if (serverIsOnline) { %>
                    <div class="w-12 h-12 rounded-full bg-emerald-50 dark:bg-emerald-700/20 flex items-center justify-center mx-auto mb-3">
                      <span class="inline-flex h-3 w-3 rounded-full bg-emerald-500"></span>
                    </div>
                    <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">No players online</p>
                    <p class="text-xs text-neutral-500 mt-1">Players appear here when they join.</p>
                    <% if (typeof serverInfo !== 'undefined' && serverInfo) { %>
                    <p class="text-xs text-neutral-400 mt-2">v<%= serverInfo.version %> &middot; <%= serverInfo.onlinePlayers %>/<%= serverInfo.maxPlayers %></p>
                    <% } %>
                  <% } else { %>
                    <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Status unknown</p>
                    <p class="text-xs text-neutral-500 mt-1">The server may be starting up.</p>
                  <% } %>
                </div>
                <% } %>
            </div>
        </section>
    </div>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/footer') %>
<% } %>

<script nonce="<%- nonce %>">
    function kickPlayer(name) {
        if (!confirm('Kick ' + name + '?')) return;
        fetch('/api/servers/<%= server.shortID %>/players/' + name + '/kick', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        }).then(res => {
            if (res.ok) location.reload();
        });
    }
</script>
<script nonce="<%- nonce %>">
  (function() {
    var hasError = <%= errorMessage && errorMessage.message ? 'true' : 'false' %>;
    var refreshInterval = hasError ? 60000 : 30000;
    setTimeout(function() { window.location.reload(); }, refreshInterval);
    var startTime = Date.now();
    var timerEl = document.getElementById('refresh-countdown');
    if (timerEl) {
      (function tick() {
        var remaining = Math.max(0, Math.floor((refreshInterval - (Date.now() - startTime)) / 1000));
        timerEl.textContent = remaining;
        if (remaining > 0) requestAnimationFrame(tick);
      })();
    }
  })();
</script>
