<%- include('../../components/header', { title: 'Players' }) %>

<main class="h-screen m-auto text-neutral-800 dark:text-white">
  <div class="flex h-full">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/template') %>
    </div>

    <!-- Main Content -->
    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-16 pb-12 lg:pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Dashboard', href: '/' },
        { label: server.name, href: '/server/' + server.UUID },
        { label: 'Players' }
      ] }) %>
      <!-- Page Header: title + meta left -->
      <div class="px-4 sm:px-8 pt-4 pb-2 sm:pb-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <!-- Server meta: image · node · id -->
            <%- include('../../components/serverMeta') %>
          </div>
        </div>
      </div>

      <%- include('../../components/installHeader') %>
            <!-- Error Message -->
      <% if (errorMessage && errorMessage.message) { %>
          <div id="players-error-banner" class="p-4 ml-8 mr-8 mt-4 rounded-xl flex items-start space-x-4" style="background:var(--theme-danger-bg);border:1px solid var(--theme-danger);">
          <%- icon('triangle-alert', { class: 'size-6 mt-2 ml-1', style:'color:var(--theme-danger)' }) %>
      <div>
        <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= req.translations.connectionError || 'Error' %></p>
        <p class="text-sm" style="color:var(--theme-text-muted)"><%= errorMessage.message %></p>
      </div>
    </div>
      <% } %>

      <!-- Daemon down message removed as requested -->

      <!-- Server Template -->
      <%- include('../../components/serverTemplate', { features: ['players', 'worlds'] }) %>

      <div id="server-page-body">

      <!-- Players Section -->
      <div class="px-6 mt-8" id="players-section">
        <!-- Server Info Card -->
        <div class="al-card p-6 mb-6 shadow-lg">
          <div class="flex flex-col md:flex-row justify-between items-center mb-4">
            <div>
              <h2 class="text-xl font-semibold mb-1" style="color:var(--theme-text-strong)"><%= req.translations.players || 'Players' %></h2>
              <p class="text-sm" style="color:var(--theme-text-muted)">
                <% if (typeof serverInfo !== 'undefined') { %>
                  <span class="font-medium" id="onlineCount"><%= serverInfo.onlinePlayers || 0 %></span> / <span id="maxCount"><%= serverInfo.maxPlayers || 0 %></span> players online
                  <% if (serverInfo.version) { %>
                    • <span class="text-neutral-500" id="versionLabel">Version: <%= serverInfo.version %></span>
                  <% } %>
                <% } else { %>
                  Manage your server's player list
                <% } %>
              </p>
            </div>
          </div>

          <!-- Auto-refresh notice -->
          <div class="text-xs text-neutral-500 mb-4 flex items-center">
            <%- icon('refresh-cw', { class: 'h-3 w-3 mr-1', strokeWidth: 2 }) %>
            <span>
              Refreshing in <span id="refresh-countdown">30</span> seconds
                <button type="button" onclick="refreshPlayers()" class="ml-2 transition-colors duration-200 inline-flex items-center" style="color:var(--theme-accent)">
                  <%- icon('refresh-cw', { class: 'h-3 w-3 mr-1' }) %>
                Refresh now
              </button>
            </span>
          </div>
        </div>

        <!-- Players Grid -->
        <% if (players && players.length > 0) { %>
        <div id="PlayersGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          <% players.forEach(player => { %>
            <div class="relative p-4 al-card shadow-lg group transition-all duration-200">
              <div class="flex items-center">
                <img
                  src="https://crafatar.com/avatars/<%= player.uuid %>?size=64&overlay"
                  alt="<%= player.name %>'s Avatar"
                  loading="lazy"
                  class="rounded-lg mr-4"
                  width="64"
                  height="64"
                />
                <div>
                  <p class="text-lg font-bold" style="color:var(--theme-text-strong)"><%= player.name %></p>
                  <div class="flex items-center mt-1">
                    <span class="al-dot-online mr-2"></span>
                    <span class="text-xs" style="color:var(--theme-text-muted)"><%= req.translations.online || 'Online' %></span>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <% } else { %>
          <div id="no-players-message" class="rounded-xl p-8 text-center" style="background:var(--theme-bg-card);border:1px solid var(--theme-border)">
            <% if (!serverIsOnline && errorMessage && errorMessage.message) { %>
              <!-- Server Offline Message -->
              <div class="flex justify-center mb-6">
                <div class="w-16 h-16 rounded-full bg-neutral-200 dark:bg-neutral-700/50 flex items-center justify-center">
                  <%- icon('wifi-off', { class: 'size-6', strokeWidth: 1.5 }) %>
                </div>
              </div>
              <h2 class="text-xl font-semibold text-neutral-700 dark:text-neutral-300"><%= req.translations.serverOffline || 'Server Offline' %></h2>
              <p class="mt-2 text-sm text-neutral-500 max-w-md mx-auto">
                The server appears to be offline. Start your server to see online players.
              </p>
              <div class="mt-6">
                <button type="button" onclick="refreshPlayers()" class="al-btn-primary px-4 py-2 rounded-lg inline-flex items-center">
                  <%- icon('refresh-cw', { class: 'h-4 w-4 mr-2' }) %>
                  Refresh
                </button>
              </div>
            <% } else if (serverIsOnline) { %>
              <!-- Server Online but No Players Message -->
              <div class="flex justify-center mb-6">
                <div class="w-16 h-16 rounded-full bg-green-700/20 dark:bg-green-500/15 flex items-center justify-center">
                  <%- icon('ellipsis', { class: 'h-8 w-8 text-green-400', strokeWidth: 2 }) %>
                </div>
              </div>
              <h2 class="text-xl font-semibold text-neutral-700 dark:text-neutral-300"><%= req.translations.serverOnline || 'Server is online' %></h2>
              <p class="mt-2 text-sm text-neutral-500 max-w-md mx-auto">
                Your server is running but no players are currently connected. Players will appear here when they join.
              </p>
              <div class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
                <div class="flex items-center justify-center gap-4">
                  <div>
                    <span class="font-semibold">Version:</span> <%= serverInfo.version %>
                  </div>
                  <div>
                    <span class="font-semibold">Capacity:</span> <%= serverInfo.onlinePlayers %>/<%= serverInfo.maxPlayers %>
                  </div>
                </div>
              </div>
            <% } else { %>
              <!-- Unknown Status Message -->
              <div class="flex justify-center mb-6">
                <div class="w-16 h-16 rounded-full bg-yellow-700/20 dark:bg-yellow-500/15 flex items-center justify-center">
                  <%- icon('circle-help', { class: 'h-8 w-8 text-yellow-400', strokeWidth: 2 }) %>
                </div>
              </div>
              <h2 class="text-xl font-semibold text-neutral-700 dark:text-neutral-300"><%= req.translations.statusUnknown || 'Status Unknown' %></h2>
              <p class="mt-2 text-sm text-neutral-500 max-w-md mx-auto">
                We couldn't determine if your server is online. It may be starting up or in an unusual state.
              </p>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Scoped auto-refresh script -->
      <script nonce="<%- nonce %>">
        (function() {
          const REFRESH_MS = 30000;
          const section = document.getElementById('players-section');
          const countdownEl = document.getElementById('refresh-countdown');
          let lastRefresh = Date.now();

          function esc(s) {
            if (typeof s !== 'string') return '';
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
          }

          function renderData(data) {
            const info = data.serverInfo;
            const onlineEl = document.getElementById('onlineCount');
            const maxEl = document.getElementById('maxCount');
            const versionEl = document.getElementById('versionLabel');
            if (info) {
              if (onlineEl) onlineEl.textContent = info.onlinePlayers || 0;
              if (maxEl) maxEl.textContent = info.maxPlayers || 0;
              if (versionEl) versionEl.textContent = 'Version: ' + (info.version || 'Unknown');
            }

            const staticEmpty = document.getElementById('no-players-message');
            let dynamicEmpty = document.getElementById('no-players-dynamic');
            let grid = document.getElementById('PlayersGrid');

            if (data.players && data.players.length) {
              if (dynamicEmpty) { dynamicEmpty.remove(); dynamicEmpty = null; }
              if (staticEmpty) staticEmpty.remove();
              if (!grid && section) {
                grid = document.createElement('div');
                grid.id = 'PlayersGrid';
                grid.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4';
                section.appendChild(grid);
              }
              grid.innerHTML = data.players.map(p => {
                const name = esc(p.name);
                const uuid = esc(p.uuid);
                return '<div class="relative p-4 al-card shadow-lg group transition-all duration-200">'
                  + '<div class="flex items-center">'
                  + '<img src="https://crafatar.com/avatars/' + uuid + '?size=64&overlay" alt="' + name + '\'s Avatar" class="rounded-lg mr-4" width="64" height="64" loading="lazy">'
                  + '<div><p class="text-lg font-bold" style="color:var(--theme-text-strong)">' + name + '</p>'
                  + '<div class="flex items-center mt-1"><span class="al-dot-online mr-2"></span>'
                  + '<span class="text-xs" style="color:var(--theme-text-muted)">Online</span></div></div></div></div>';
              }).join('');
            } else {
              if (grid) grid.remove();
              if (staticEmpty) staticEmpty.remove();
              if (!dynamicEmpty && section) {
                dynamicEmpty = document.createElement('div');
                dynamicEmpty.id = 'no-players-dynamic';
                dynamicEmpty.className = 'rounded-xl p-8 text-center';
                dynamicEmpty.style.cssText = 'background:var(--theme-bg-card);border:1px solid var(--theme-border)';
                dynamicEmpty.innerHTML = '<h2 class="text-xl font-semibold text-neutral-700 dark:text-neutral-300">No players online</h2>'
                  + '<p class="mt-2 text-sm text-neutral-500 max-w-md mx-auto">Players will appear here when they join.</p>';
                section.appendChild(dynamicEmpty);
              }
            }
          }

          async function refreshPlayers() {
            lastRefresh = Date.now();
            try {
              const res = await fetch('/server/<%= server.UUID %>/players/data', { headers: { 'Accept': 'application/json' } });
              if (!res.ok) return;
              const data = await res.json();
              if (data.error) return;
              renderData(data);
              const banner = document.getElementById('players-error-banner');
              if (banner) banner.style.display = 'none';
            } catch (e) { console.warn('Player refresh failed:', e); }
          }
          window.refreshPlayers = refreshPlayers;

          if (countdownEl) {
            setInterval(function() {
              const remaining = Math.max(0, Math.ceil((REFRESH_MS - (Date.now() - lastRefresh)) / 1000));
              countdownEl.textContent = remaining;
            }, 500);
          }

          refreshPlayers();
          setInterval(refreshPlayers, REFRESH_MS);
        })();
      </script>
    </div>

      </div><!-- /server-page-body -->

      </div>
</main>

<%- include('../../components/footer') %>
