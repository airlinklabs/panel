<%- include('../../layouts/user', { title: (server.name || 'Server') + ' — Players' }) %>

<nav aria-label="Breadcrumb" class="al-breadcrumb mb-6">
  <ol class="flex items-center text-sm gap-1">
    <li class="flex items-center">
      <a href="/" class="transition-colors hover:underline" style="color:var(--theme-text-muted);"><%= t('dashboard') %></a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <a href="/server/<%= server.UUID %>" class="transition-colors hover:underline" style="color:var(--theme-text-muted);"><%= server.name %></a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <span style="color:var(--theme-text);"><%= t('players') %></span>
    </li>
  </ol>
</nav>

<div class="px-6 sm:px-8 pb-12" data-server-uuid="<%= server.UUID %>">

  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold" style="color:var(--theme-text);"><%= t('players') %></h1>
    <button id="refreshPlayersBtn" type="button" class="al-btn-secondary px-3 py-1.5 rounded-xl text-xs font-medium inline-flex items-center gap-1.5">
      <%- icon('refresh-cw', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %> <%= t('refresh') %>
    </button>
  </div>

  <!-- Online Players -->
  <div class="al-card p-4 mb-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong);">Online</h2>
      <span id="online-count" class="text-xs px-2 py-0.5 rounded-full" style="background:var(--theme-success-bg);color:var(--theme-success);">0</span>
    </div>
    <div id="online-players">
      <p class="text-xs" style="color:var(--theme-text-muted);">No players online</p>
    </div>
  </div>

  <!-- Banned Players -->
  <div class="al-card p-4">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong);">Banned</h2>
      <span id="banned-count" class="text-xs px-2 py-0.5 rounded-full" style="background:var(--theme-danger-bg);color:var(--theme-danger);">0</span>
    </div>
    <div id="banned-players">
      <p class="text-xs" style="color:var(--theme-text-muted);">No banned players</p>
    </div>
  </div>

  <!-- Whitelist (if enabled) -->
  <div class="al-card p-4 mt-6 hidden" id="whitelist-card">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong);">Whitelisted</h2>
      <span id="whitelist-count" class="text-xs px-2 py-0.5 rounded-full" style="background:var(--theme-info-bg, var(--theme-bg-secondary));color:var(--theme-info, var(--theme-text-muted));">0</span>
    </div>
    <div id="whitelisted-players">
      <p class="text-xs" style="color:var(--theme-text-muted);">No whitelisted players</p>
    </div>
  </div>

</div>

<!-- Player Action Modal -->
<div id="player-modal" class="fixed inset-0 z-50 hidden" style="background:rgba(0,0,0,0.5);display:none;">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="al-card p-6 w-full max-w-md" style="background:var(--theme-bg);border:1px solid var(--theme-border);">
      <div class="flex items-center justify-between mb-4">
        <h3 id="modal-title" class="text-sm font-semibold" style="color:var(--theme-text-strong);"></h3>
        <button id="modal-close" type="button" class="text-xs" style="color:var(--theme-text-muted);">✕</button>
      </div>
      <p id="modal-desc" class="text-xs mb-4" style="color:var(--theme-text-muted);"></p>
      <div class="flex justify-end gap-2">
        <button id="modal-cancel" type="button" class="al-btn-secondary px-3 py-1.5 rounded-lg text-xs font-medium">Cancel</button>
        <button id="modal-confirm" type="button" class="al-btn-danger px-3 py-1.5 rounded-lg text-xs font-medium">Confirm</button>
      </div>
    </div>
  </div>
</div>

<script type="module" nonce="<%- nonce %>">
  const serverUUID = document.querySelector('[data-server-uuid]')?.dataset.serverUuid;
  const modal = document.getElementById('player-modal');
  let currentPlayer = null;
  let currentAction = null;

  function renderPlayerCard(player, actions) {
    return `
      <div class="flex items-center justify-between py-2 border-b" style="border-color:var(--theme-border);">
        <div class="flex items-center gap-2 min-w-0">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style="background:var(--theme-bg-secondary);">
            <img src="https://mc-heads.net/avatar/${player.uuid || player.name}/24" alt="" class="w-6 h-6 rounded" onerror="this.parentElement.innerHTML='<span class=text-xs>${(player.name||'?')[0]}</span>'">
          </div>
          <div class="min-w-0">
            <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong);">${player.name || '—'}</p>
            <p class="text-[10px] truncate" style="color:var(--theme-text-muted);">${player.uuid || ''}</p>
          </div>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          ${actions.map(a => `
            <button type="button" class="player-action-btn al-btn-secondary px-2 py-1 rounded-lg text-[10px] font-medium" data-player="${player.name || player.uuid}" data-action="${a.action}">
              ${a.label}
            </button>
          `).join('')}
        </div>
      </div>`;
  }

  async function loadPlayers() {
    try {
      const res = await fetch(`/server/${serverUUID}/players/data`);
      const data = await res.json();
      const d = data.data || data || {};
      const online = d.online || [];
      const banned = d.banned || [];
      const whitelisted = d.whitelisted || [];

      document.getElementById('online-count').textContent = online.length;
      document.getElementById('banned-count').textContent = banned.length;

      const onlineEl = document.getElementById('online-players');
      if (online.length) {
        onlineEl.innerHTML = online.map(p => renderPlayerCard(p, [
          { action: 'kick', label: 'Kick' },
          { action: 'ban', label: 'Ban' },
        ])).join('');
      } else {
        onlineEl.innerHTML = '<p class="text-xs" style="color:var(--theme-text-muted);">No players online</p>';
      }

      const bannedEl = document.getElementById('banned-players');
      if (banned.length) {
        bannedEl.innerHTML = banned.map(p => renderPlayerCard(p, [
          { action: 'pardon', label: 'Pardon' },
        ])).join('');
      } else {
        bannedEl.innerHTML = '<p class="text-xs" style="color:var(--theme-text-muted);">No banned players</p>';
      }

      if (whitelisted.length > 0 || d.whitelistEnabled) {
        document.getElementById('whitelist-card').classList.remove('hidden');
        document.getElementById('whitelist-count').textContent = whitelisted.length;
        const wlEl = document.getElementById('whitelisted-players');
        if (whitelisted.length) {
          wlEl.innerHTML = whitelisted.map(p => renderPlayerCard(p, [
            { action: 'whitelist-remove', label: 'Remove' },
          ])).join('');
        } else {
          wlEl.innerHTML = '<p class="text-xs" style="color:var(--theme-text-muted);">No whitelisted players</p>';
        }
      }

      // Attach action listeners
      document.querySelectorAll('.player-action-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentPlayer = btn.dataset.player;
          currentAction = btn.dataset.action;
          const actionLabels = { kick: 'Kick', ban: 'Ban', pardon: 'Pardon', 'whitelist-remove': 'Remove from whitelist' };
          document.getElementById('modal-title').textContent = `${actionLabels[currentAction] || currentAction} Player`;
          document.getElementById('modal-desc').textContent = `Are you sure you want to ${currentAction} ${currentPlayer}?`;
          modal.style.display = 'flex';
        });
      });
    } catch (e) {
      console.error('Failed to load players', e);
    }
  }

  async function executeAction() {
    if (!currentPlayer || !currentAction) return;
    try {
      const res = await fetch(`/server/${serverUUID}/players/${encodeURIComponent(currentPlayer)}/${currentAction}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
      const data = await res.json();
      if (data.success !== false) {
        if (window.showToast) window.showToast(`Player ${currentAction}ed`, 'success');
        loadPlayers();
      }
    } catch (e) {
      console.error('Action failed', e);
    }
    closeModal();
  }

  function closeModal() {
    modal.style.display = 'none';
    currentPlayer = null;
    currentAction = null;
  }

  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  document.getElementById('modal-cancel')?.addEventListener('click', closeModal);
  document.getElementById('modal-confirm')?.addEventListener('click', executeAction);
  document.getElementById('refreshPlayersBtn')?.addEventListener('click', loadPlayers);

  loadPlayers();
  setInterval(loadPlayers, 15000);
</script>

<%- include('../../layouts/user-footer') %>
