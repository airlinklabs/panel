<%- include('../../layouts/user', { title: t('settings') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('settings') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= server.name %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
</header>

<div class="al-page-body">
  <!-- Settings Form -->
  <div class="al-card mb-4">
    <div class="al-card-header">
      <div class="min-w-0">
        <h2 class="al-card-title"><%= t('serverSettings') %></h2>
        <p class="al-card-subtitle"><%= t('serverSettingsDesc') %></p>
      </div>
    </div>
    <div class="al-card-body">
      <form id="serverSettingsForm">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <%- include('../../partials/ui/form-field', {
            type: 'text', name: 'name', label: t('serverName'), id: 'serverName',
            value: server.name, cls: 'min-h-11'
          }) %>
          <%- include('../../partials/ui/form-field', {
            type: 'text', name: 'description', label: t('description'), id: 'serverDescription',
            value: server.description || '', cls: 'min-h-11'
          }) %>
        </div>
        <div class="mt-5 flex items-center gap-3">
          <button type="submit" id="settingsSubmit" class="al-btn-primary min-h-11">
            <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %>
            <span id="settingsSaveLabel"><%= t('saveSettings') %></span>
            <span id="settingsSavingLabel" style="display:none"><%= t('saving') %></span>
          </button>
          <span id="settingsSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
        </div>
      </form>
    </div>
  </div>

  <!-- Server Information -->
  <div class="al-card mb-4">
    <div class="al-card-header">
      <div class="min-w-0">
        <h2 class="al-card-title"><%= t('serverInformation') %></h2>
      </div>
    </div>
    <div class="al-card-body">
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5">
        <div>
          <dt class="al-section-label"><%= t('serverId') %></dt>
          <dd class="text-sm font-mono m-0 al-text-muted"><%= server.UUID %></dd>
        </div>
        <div>
          <dt class="al-section-label"><%= t('createdAt') %></dt>
          <dd class="text-sm m-0 al-text-muted"><%= server.createdAt ? new Date(server.createdAt).toLocaleString() : '--' %></dd>
        </div>
        <div>
          <dt class="al-section-label"><%= t('node') %></dt>
          <dd class="text-sm m-0 al-text-muted"><%= server.node ? server.node.name : '--' %></dd>
        </div>
        <div>
          <dt class="al-section-label"><%= t('image') %></dt>
          <dd class="text-sm m-0 al-text-muted"><%= (server.image && server.image.name) || t('unknown') %></dd>
        </div>
        <div>
          <dt class="al-section-label"><%= t('memory') %></dt>
          <dd class="text-sm m-0 al-text-muted"><%= server.Memory === 0 ? t('unlimited') : (server.Memory >= 1024 ? (server.Memory / 1024).toFixed(1) + ' GB' : server.Memory + ' MB') %></dd>
        </div>
        <div>
          <dt class="al-section-label"><%= t('cpu') %></dt>
          <dd class="text-sm m-0 al-text-muted"><%= server.Cpu === 0 ? t('unlimited') : (server.Cpu / 100).toFixed(1) + ' ' + t('coresLabel') %></dd>
        </div>
        <div>
          <dt class="al-section-label"><%= t('storage') %></dt>
          <dd class="text-sm m-0 al-text-muted"><%= server.Storage === 0 ? t('unlimited') : (server.Storage >= 1024 ? (server.Storage / 1024).toFixed(1) + ' GB' : server.Storage + ' MB') %></dd>
        </div>
        <div>
          <dt class="al-section-label"><%= t('statusColumn') %></dt>
          <dd class="text-sm m-0">
            <span class="<%= server.Suspended ? 'al-badge al-badge-warning' : 'al-badge al-badge-online' %>">
              <span class="al-dot <%= server.Suspended ? 'al-dot-warning' : 'al-dot-online' %>"></span>
              <%= server.Suspended ? t('suspendedLabel') : t('activeLabel') %>
            </span>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Danger Zone -->
  <div class="al-card" style="background:var(--theme-danger-bg);border-color:color-mix(in srgb, var(--theme-danger) 25%, transparent)">
    <div class="al-card-header" style="background:transparent;border-color:color-mix(in srgb, var(--theme-danger) 25%, transparent)">
      <div class="min-w-0">
        <h2 class="al-card-title" style="color:var(--theme-danger)"><%= t('dangerZone') %></h2>
      </div>
    </div>
    <div class="al-card-body">
      <% if (user && (user.isAdmin || settings?.allowUserDeleteServer)) { %>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div class="min-w-0">
          <p class="text-sm font-medium al-text-strong"><%= t('deleteServer') %></p>
          <p class="text-xs al-text-muted"><%= t('deleteServerDesc') %></p>
        </div>
        <button id="deleteServerButton" type="button" class="al-btn-danger shrink-0 min-h-11">
          <%- icon('trash-2', { class: 'size-3.5', strokeWidth: 1.5 }) %>
          <%= t('delete') %>
        </button>
      </div>
      <% } %>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div class="min-w-0">
          <p class="text-sm font-medium al-text-strong"><%= t('reinstallServer') %></p>
          <p class="text-xs al-text-muted"><%= t('reinstallServerDesc') %></p>
        </div>
        <button id="reinstallButton" type="button" class="al-btn-danger shrink-0 min-h-11">
          <%- icon('rotate-ccw', { class: 'size-3.5', strokeWidth: 1.5 }) %>
          <%= t('reinstall') %>
        </button>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="min-w-0">
          <p class="text-sm font-medium al-text-strong"><%= t('reinstallAndDeleteData') %></p>
          <p class="text-xs al-text-muted"><%= t('reinstallAndDeleteDataDesc') %></p>
        </div>
        <button id="reinstallWipeButton" type="button" class="al-btn-danger shrink-0 min-h-11">
          <%- icon('triangle-alert', { class: 'size-3.5', strokeWidth: 1.5 }) %>
          <%= t('reinstallAndDeleteData') %>
        </button>
      </div>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
(function() {
  var serverId = '<%= server.UUID %>';
  var msg = <%- JSON.stringify({
    saved: t('settingsSaved'),
    saveFailed: t('failedToSaveSettings'),
    requestFailed: t('requestFailed'),
    saving: t('saving'),
    savedPrefix: t('savedTimeAgo'),
    deleteTitle: t('deleteServer'),
    deleteBody: t('deleteServerConfirmBody'),
    deleteConfirm: t('deleteServer'),
    typeDelete: t('typeDeleteToConfirm'),
    mustTypeDelete: t('mustTypeDelete'),
    deleting: t('deletingServer'),
    contacting: t('contactingNode'),
    preparing: t('preparingReinstall'),
    reinstallInitiated: t('reinstallInitiated'),
    failedLabel: t('failureLabel'),
    unknownError: t('unknownError'),
    somethingWentWrong: t('somethingWentWrong'),
    deleteFailed: t('failedToDeleteServer'),
    reinstallTitle: t('confirmReinstallation'),
    reinstallBody: t('reinstallConfirmBody'),
    reinstall: t('reinstall'),
    reinstalling: t('reinstallingServer'),
    reinstallDone: t('serverReinstalling'),
    wipeTitle: t('reinstallAndDeleteData'),
    wipeBody: t('wipeConfirmBody'),
    wipeConfirm: t('continueLabel'),
    wipeDone: t('serverReinstallingDataDeleted')
  }) %>;

  // Settings form
  var form = document.getElementById('serverSettingsForm');
  var submitBtn = document.getElementById('settingsSubmit');
  var saveLabel = document.getElementById('settingsSaveLabel');
  var savingLabel = document.getElementById('settingsSavingLabel');
  var savedSpan = document.getElementById('settingsSaved');
  var saving = false;

  function updateSaved() {
    var now = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    savedSpan.textContent = msg.savedPrefix + now;
    savedSpan.style.display = '';
    setTimeout(function() { savedSpan.style.display = 'none'; }, 3000);
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (saving) return;
    saving = true;
    submitBtn.disabled = true;
    saveLabel.style.display = 'none';
    savingLabel.style.display = '';
    fetch('/server/' + serverId + '/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({
        name: document.getElementById('serverName').value,
        description: document.getElementById('serverDescription').value
      })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success !== false) { updateSaved(); showToast(msg.saved, 'success'); }
      else showToast(d.error || msg.saveFailed, 'error');
    }).catch(function() { showToast(msg.saveFailed, 'error'); })
    .finally(function() {
      saving = false;
      submitBtn.disabled = false;
      saveLabel.style.display = '';
      savingLabel.style.display = 'none';
    });
  });

  // Delete server
  var deleteBtn = document.getElementById('deleteServerButton');
  if (deleteBtn) {
    deleteBtn.addEventListener('click', function() {
      window.modal.confirm({
        title: msg.deleteTitle,
        body: msg.deleteBody,
        danger: true,
        confirmLabel: msg.deleteConfirm,
        prompt: { label: msg.typeDelete, pattern: /^DELETE$/i, invalidMessage: msg.mustTypeDelete },
        onConfirm: function() {
          var loader = showProgressToast(msg.deleting);
          loader.setStage(msg.contacting);
          fetch('/api/v2/servers/' + serverId, { method: 'DELETE' })
            .then(function(r) { return r.json(); })
            .then(function(d) { loader.close(); if (d.success) window.location.href = '/'; else showToast(d.error?.message || msg.deleteFailed, 'error'); })
            .catch(function() { loader.close(); showToast(msg.somethingWentWrong, 'error'); });
        }
      });
    });
  }

  // Reinstall
  document.getElementById('reinstallButton').addEventListener('click', function() {
    window.modal.confirm({
      title: msg.reinstallTitle,
      body: msg.reinstallBody,
      confirmLabel: msg.reinstall,
      onConfirm: function() {
        var loader = showProgressToast(msg.reinstalling);
        loader.setStage(msg.preparing);
        fetch('/server/' + serverId + '/reinstall', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ preserveData: true })
        }).then(function(r) { return r.json(); }).then(function(data) {
          loader.setStage(msg.reinstallInitiated);
          setTimeout(function() { loader.close(); if (data.success !== false) showToast(msg.reinstallDone, 'success'); else showToast(data.error || msg.unknownError, 'error'); }, 1000);
        }).catch(function() { loader.close(); showToast(msg.somethingWentWrong, 'error'); });
      }
    });
  });

  // Reinstall with wipe
  var wipeBtn = document.getElementById('reinstallWipeButton');
  if (wipeBtn) {
    wipeBtn.addEventListener('click', function() {
      window.modal.confirm({
        title: msg.wipeTitle,
        body: msg.wipeBody,
        danger: true,
        confirmLabel: msg.wipeConfirm,
        prompt: { label: msg.typeDelete, pattern: /^DELETE$/i, invalidMessage: msg.mustTypeDelete },
        onConfirm: function() {
          var loader = showProgressToast(msg.reinstalling);
          loader.setStage(msg.preparing);
          fetch('/server/' + serverId + '/reinstall', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
            body: JSON.stringify({ preserveData: false })
          }).then(function(r) { return r.json(); }).then(function(data) {
            loader.setStage(msg.reinstallInitiated);
            setTimeout(function() { loader.close(); if (data.success !== false) showToast(msg.wipeDone, 'success'); else showToast(data.error || msg.unknownError, 'error'); }, 1000);
          }).catch(function() { loader.close(); showToast(msg.somethingWentWrong, 'error'); });
        }
      });
    });
  }
})();
</script>
