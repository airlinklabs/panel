<%- include('../../components/header', { title: 'Server Settings' }) %>

<main class="h-screen m-auto text-neutral-800 dark:text-white">
  <div class="flex h-full">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-0 pb-12 lg:pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Dashboard', href: '/' },
        { label: server.name, href: '/server/' + server.UUID },
        { label: 'Settings' }
      ] }) %>
      <!-- Page Header: title + meta left -->
      <div class="px-6 sm:px-8 pt-4 pb-2 sm:pb-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <!-- Server meta: image · node · id -->
            <%- include('../../components/serverMeta') %>
          </div>
        </div>
      </div>
      <%- include('../../components/installHeader') %>
      <%- include('../../components/serverTemplate') %>

      <div class="al-page-body space-y-5 mt-8">

        <%- include('../../fragments/user/server/settings-form', { req, server }) %>

        <div class="al-card p-5">
          <h2 class="text-lg font-semibold mb-4" style="color:var(--theme-text-strong)"><%= req.translations.serverInformation || 'Server Information' %></h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <h3 class="text-sm font-medium mb-1" style="color:var(--theme-text-muted)"><%= req.translations.serverId || 'Server ID' %></h3>
              <p style="color:var(--theme-text-muted)"><%= server.UUID %></p>
            </div>
            <div>
              <h3 class="text-sm font-medium mb-1" style="color:var(--theme-text-muted)"><%= req.translations.createdAt || 'Created' %></h3>
              <p style="color:var(--theme-text-muted)"><%= new Date(server.createdAt).toLocaleString() %></p>
            </div>
            <div>
              <h3 class="text-sm font-medium mb-1" style="color:var(--theme-text-muted)"><%= req.translations.nodes || 'Node' %></h3>
              <p style="color:var(--theme-text-muted)"><%= server.node.name %></p>
            </div>
            <div>
              <h3 class="text-sm font-medium mb-1" style="color:var(--theme-text-muted)"><%= req.translations.images || 'Image' %></h3>
              <p style="color:var(--theme-text-muted)"><%= server.image.name || 'Unknown' %></p>
            </div>
            <div>
              <h3 class="text-sm font-medium mb-1" style="color:var(--theme-text-muted)"><%= req.translations.memory || 'Memory' %></h3>
              <p style="color:var(--theme-text-muted)"><%= server.Memory === 0 ? 'Unlimited' : (server.Memory >= 1024 ? (server.Memory / 1024).toFixed(1) + ' GB' : server.Memory + ' MB') %></p>
            </div>
            <div>
              <h3 class="text-sm font-medium mb-1" style="color:var(--theme-text-muted)"><%= req.translations.cpu || 'CPU' %></h3>
              <p style="color:var(--theme-text-muted)"><%= server.Cpu === 0 ? 'Unlimited' : (server.Cpu / 100).toFixed(1) + ' cores' %></p>
            </div>
            <div>
              <h3 class="text-sm font-medium mb-1" style="color:var(--theme-text-muted)"><%= req.translations.storage || 'Storage' %></h3>
              <p style="color:var(--theme-text-muted)"><%= server.Storage === 0 ? 'Unlimited' : (server.Storage >= 1024 ? (server.Storage / 1024).toFixed(1) + ' GB' : server.Storage + ' MB') %></p>
            </div>
            <div>
              <h3 class="text-sm font-medium mb-1" style="color:var(--theme-text-muted)"><%= req.translations.statusColumn || 'Status' %></h3>
              <p style="color:var(--theme-text-muted)">
                <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset"
                  style="<%= server.Suspended ? 'background:var(--theme-warning-bg);color:var(--theme-warning);--tw-ring-color:color-mix(in srgb, var(--theme-warning) 25%, transparent)' : 'background:var(--theme-success-bg);color:var(--theme-success);--tw-ring-color:color-mix(in srgb, var(--theme-success) 25%, transparent)' %>">
                  <%= server.Suspended ? 'Suspended' : 'Active' %>
                </span>
              </p>
            </div>
          </div>
        </div>

        <div class="al-card p-5" style="background:var(--theme-danger-bg);border-color:color-mix(in oklch, var(--theme-danger) 20%, transparent)">
          <h2 class="text-lg font-semibold mb-4" style="color:var(--theme-text-strong)"><%= req.translations.dangerZone || 'Danger Zone' %></h2>

          <% if (user && (user.isAdmin || settings?.allowUserDeleteServer)) { %>
          <div class="flex items-center justify-between mb-5">
            <div>
              <h3 class="text-sm font-medium" style="color:var(--theme-text-muted)">Delete Server</h3>
              <p class="text-sm" style="color:var(--theme-text-muted)">Permanently delete this server and all its data.</p>
            </div>
            <button id="deleteServerButton" type="button" class="al-btn-danger inline-flex items-center gap-1.5">
              <%- icon('trash-2', { class: 'size-4', strokeWidth: 1.5 }) %>
              Delete
            </button>
          </div>
          <% } %>

          <div class="flex items-center justify-between gap-4 mb-5">
            <div>
              <h3 class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= req.translations.reinstallServer || 'Reinstall Server' %></h3>
              <p class="text-sm" style="color:var(--theme-text-muted)">Re-run the install scripts. Your files, worlds and settings are kept.</p>
            </div>
            <button id="reinstallButton" type="button" class="al-btn-danger inline-flex items-center gap-1.5">
              <%- icon('rotate-ccw', { class: 'size-4', strokeWidth: 1.5 }) %>
              <%= req.translations.reinstall || 'Reinstall' %>
            </button>
          </div>

          <div class="flex items-center justify-between gap-4">
            <div>
              <h3 class="text-sm font-medium" style="color:var(--theme-text-muted)">Reinstall &amp; Delete All Data</h3>
              <p class="text-sm" style="color:var(--theme-text-muted)">Wipes the server volume (worlds, configs, files) then reinstalls from scratch. This cannot be undone.</p>
            </div>
            <button id="reinstallWipeButton" type="button" class="al-btn-danger inline-flex items-center gap-1.5">
              <%- icon('triangle-alert', { class: 'size-4', strokeWidth: 1.5 }) %>
              Reinstall &amp; Delete All Data
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../../components/loadingPopup') %>
<%- include('../../components/footer') %>

<script nonce="<%- nonce %>">
  const deleteServerButton = document.getElementById('deleteServerButton');
    if (deleteServerButton) {
      deleteServerButton.addEventListener('click', () => {
        window.modal.confirm({
          title: 'Delete Server',
          body: 'This will permanently delete the server and all its data. Type <strong>DELETE</strong> to confirm.',
          danger: true,
          confirmLabel: 'Delete Server',
          prompt: { label: 'Type DELETE to confirm', pattern: /^DELETE$/i, invalidMessage: 'You must type DELETE to confirm.' },
          onConfirm: () => {
            const loader = showProgressToast ? showProgressToast('Deleting Server…') : showLoadingToast('Deleting Server...');
            loader.updateProgress(20, 'Contacting node...');
            <% if (user && user.isAdmin) { %>
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
            fetch('/admin/server/delete/<%= server.id %>', {
              method: 'POST',
              headers: { 'csrf-token': csrfToken },
            })
              .then(r => {
                loader.close();
                if (r.ok) window.location.href = '/';
                else return r.json().then(d => showToast((d && d.error) || "Couldn't delete the server.", 'error'));
              })
              .catch(() => { loader.close(); showToast('Something went wrong.', 'error'); });
            <% } else { %>
            fetch('/user/server/<%= server.UUID %>', { method: 'DELETE' })
              .then(r => r.json())
              .then(d => { loader.close(); if (d.success) window.location.href = '/'; else showToast(d.error || "Couldn't delete the server.", 'error'); })
              .catch(() => { loader.close(); showToast('Something went wrong.', 'error'); });
            <% } %>
          }
        });
      });
    }

    const reinstallButton = document.getElementById('reinstallButton');
    reinstallButton.addEventListener('click', () => {
      window.modal.confirm({
        title: '<%= req.translations.confirmReinstallation || "Confirm Reinstallation" %>',
        body: 'Re-run the install scripts. Your files, worlds and settings are kept. Continue?',
        confirmLabel: '<%= req.translations.reinstall || "Reinstall" %>',
        onConfirm: () => {
          const loader = showProgressToast ? showProgressToast('Reinstalling Server…') : showLoadingToast('Reinstalling Server...');
          loader.updateProgress(10, 'Preparing for reinstallation...');
          fetch(`/server/<%= server.UUID %>/reinstall`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ preserveData: true }) })
            .then(r => r.json())
            .then(data => {
              loader.updateProgress(100, 'Reinstallation initiated!');
              setTimeout(() => { loader.close(); if (data.success) showToast('Server reinstalling. This may take a while.', 'success'); else showToast('Failed to reinstall server: ' + (data.error || 'Unknown error'), 'error'); }, 1000);
            })
            .catch(() => { loader.close(); showToast('Something went wrong.', 'error'); });
        }
      });
    });

    const reinstallWipeButton = document.getElementById('reinstallWipeButton');
    if (reinstallWipeButton) {
      reinstallWipeButton.addEventListener('click', () => {
        window.modal.confirm({
          title: 'Reinstall & Delete All Data',
          body: 'This wipes the server volume (worlds, configs, files) and reinstalls from scratch. Type <strong>DELETE</strong> to confirm.',
          danger: true, confirmLabel: 'Continue',
          prompt: { label: 'Type DELETE to confirm', pattern: /^DELETE$/i, invalidMessage: 'You must type DELETE to confirm.' },
          onConfirm: () => {
                const loader = showProgressToast ? showProgressToast('Reinstalling Server…') : showLoadingToast('Reinstalling Server...');
            loader.updateProgress(10, 'Preparing for reinstallation...');
            fetch(`/server/<%= server.UUID %>/reinstall`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ preserveData: false }) })
              .then(r => r.json())
              .then(data => {
                loader.updateProgress(100, 'Reinstallation initiated!');
                setTimeout(() => { loader.close(); if (data.success) showToast('Server reinstalling. All data was deleted.', 'success'); else showToast('Failed to reinstall server: ' + (data.error || 'Unknown error'), 'error'); }, 1000);
              })
              .catch(() => { loader.close(); showToast('Something went wrong.', 'error'); });
          }
        });
      });
    }
</script>
