<% if (isMobileViewport) { %>
<%- include('../../components/header', { title: 'Server Settings' }) %>
<main id="page-content">
    <%- include('../../components/template') %>
    <section class="px-4 py-5">
        <%- include('../../components/serverHeader', { server: server, req: req }) %>
        <%- include('../../components/serverTemplate') %>
        <section class="px-4 py-5">

            <div class="space-y-4 mt-4">

                <!-- Settings form -->
                <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4">
                    <h2 class="text-sm font-medium text-neutral-800 dark:text-white mb-1"><%= req.translations.serverSettings || 'Server Settings' %></h2>
                    <p class="text-xs text-neutral-500 mb-4"><%= req.translations.serverSettingsDesc || "Configure your server's basic settings." %></p>
                    <form id="serverSettingsForm" class="space-y-3">
                        <div><label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1"><%= req.translations.serverName || 'Server Name' %></label><input type="text" name="name" value="<%= server.name %>" class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-600 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/40 transition"></div>
                        <div><label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Description</label><input type="text" name="description" value="<%= server.description || '' %>" class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-600 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/40 transition"></div>
                        <button type="submit" class="bg-[var(--theme-accent)] hover:bg-[var(--theme-accent-hover)] text-white rounded-xl px-4 py-2 text-sm font-medium"><%= req.translations.saveSettings || 'Save Settings' %></button>
                    </form>
                </div>

                <!-- Server Information -->
                <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4">
                    <h2 class="text-sm font-medium text-neutral-800 dark:text-white mb-3"><%= req.translations.serverInformation || 'Server Information' %></h2>
                    <dl class="grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <dt class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide">Node</dt>
                            <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-0.5 truncate"><%= server.node ? server.node.name : 'Unknown' %></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide">Image</dt>
                            <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-0.5 truncate"><%= server.image ? server.image.name : 'Unknown' %></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide">Memory</dt>
                            <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-0.5"><%= server.Memory %> MB</dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide">CPU</dt>
                            <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-0.5"><%= server.Cpu * 100 %>%</dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide">Storage</dt>
                            <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-0.5"><%= server.Storage >= 1024 ? (server.Storage / 1024).toFixed(1) + ' GB' : server.Storage + ' MB' %></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide">Status</dt>
                            <dd class="mt-0.5">
                                <% if (server.Suspended) { %>
                                <span class="inline-flex items-center rounded-md bg-amber-50 dark:bg-amber-500/10 px-2 py-1 text-xs font-medium text-amber-700 dark:text-amber-400">Suspended</span>
                                <% } else { %>
                                <span class="inline-flex items-center rounded-md bg-emerald-50 dark:bg-emerald-500/10 px-2 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400">Active</span>
                                <% } %>
                            </dd>
                        </div>
                        <div class="col-span-2">
                            <dt class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide">Server ID</dt>
                            <dd class="text-xs text-neutral-500 dark:text-neutral-400 font-mono mt-0.5 truncate"><%= server.UUID %></dd>
                        </div>
                        <div class="col-span-2">
                            <dt class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide">Created</dt>
                            <dd class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5"><%= new Date(server.createdAt).toLocaleString() %></dd>
                        </div>
                    </dl>
                </div>

                <!-- Danger Zone -->
                <div class="data-animate-card rounded-xl bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800/20 p-4">
                    <h2 class="text-sm font-medium text-red-700 dark:text-red-400 mb-3"><%= req.translations.dangerZone || 'Danger Zone' %></h2>
                    <div class="space-y-3">
                        <% if (user && (user.isAdmin || settings?.allowUserDeleteServer)) { %>
                        <div class="flex items-center justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-xs font-medium text-neutral-700 dark:text-neutral-300">Delete Server</p>
                                <p class="text-xs text-neutral-500">Permanently delete this server and all its data.</p>
                            </div>
                            <button id="deleteServerButton" class="rounded-xl bg-red-600 text-white px-4 py-2 text-sm font-medium transition hover:bg-red-700 shrink-0">Delete</button>
                        </div>
                        <div class="h-px bg-red-200 dark:bg-red-800/30"></div>
                        <% } %>
                        <div class="flex items-center justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-xs font-medium text-neutral-700 dark:text-neutral-300">Reinstall Server</p>
                                <p class="text-xs text-neutral-500">Reinstall from scratch — all data will be lost.</p>
                            </div>
                            <button id="reinstallButton" class="rounded-xl bg-red-600 text-white px-4 py-2 text-sm font-medium transition hover:bg-red-700 shrink-0">Reinstall</button>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </section>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>
<%- include('../../components/modal') %>
<%- include('../../components/footer') %>

<% } else { %>
<%- include('../../components/header', { title: 'Server Settings' }) %>
<main class="h-screen m-auto">
    <div class="flex h-screen">
        <%- include('../../components/template') %>
        <section id="page-content" class="flex-1 overflow-y-auto pt-16">
            <div class="px-8 pt-4">
                <%- include('../../components/serverHeader', { server: server, req: req }) %>
            </div>
            <%- include('../../components/serverTemplate') %>
            <div class="p-6">
                <div class="space-y-6">

                    <!-- Settings form -->
                    <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-5">
                        <h2 class="text-lg font-semibold mb-4 text-neutral-800 dark:text-white">Server Settings</h2>
                        <form id="serverSettingsForm">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div><label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Server Name</label><input type="text" name="name" value="<%= server.name %>" required class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-600 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/40 transition"></div>
                                <div>
                                    <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">Server Description</label>
                                    <textarea class="w-full rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-white/5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-600 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/40 transition" name="description" rows="3"><%= server.description || '' %></textarea>
                                </div>
                            </div>
                            <div class="mt-6">
                                <button type="submit" class="bg-[var(--theme-accent)] hover:bg-[var(--theme-accent-hover)] text-white rounded-xl px-4 py-2 text-sm font-medium">Save Settings</button>
                            </div>
                        </form>
                    </div>

                    <!-- Server Information -->
                    <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-5">
                        <h2 class="text-lg font-semibold mb-4 text-neutral-800 dark:text-white">Server Information</h2>
                        <dl class="grid grid-cols-2 gap-x-6 gap-y-4">
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Node</dt>
                                <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-1 truncate"><%= server.node ? server.node.name : 'Unknown' %></dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Image</dt>
                                <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-1 truncate"><%= server.image ? server.image.name : 'Unknown' %></dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Memory</dt>
                                <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-1"><%= server.Memory %> MB</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">CPU</dt>
                                <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-1"><%= server.Cpu * 100 %>%</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Storage</dt>
                                <dd class="text-sm text-neutral-700 dark:text-neutral-300 mt-1"><%= server.Storage >= 1024 ? (server.Storage / 1024).toFixed(1) + ' GB' : server.Storage + ' MB' %></dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Status</dt>
                                <dd class="mt-1">
                                    <% if (server.Suspended) { %>
                                    <span class="inline-flex items-center rounded-md bg-amber-50 dark:bg-amber-500/10 px-2 py-1 text-xs font-medium text-amber-700 dark:text-amber-400">Suspended</span>
                                    <% } else { %>
                                    <span class="inline-flex items-center rounded-md bg-emerald-50 dark:bg-emerald-500/10 px-2 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400">Active</span>
                                    <% } %>
                                </dd>
                            </div>
                            <div class="col-span-2">
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Server ID</dt>
                                <dd class="text-xs text-neutral-500 dark:text-neutral-400 font-mono mt-1 truncate"><%= server.UUID %></dd>
                            </div>
                            <div class="col-span-2">
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Created</dt>
                                <dd class="text-xs text-neutral-500 dark:text-neutral-400 mt-1"><%= new Date(server.createdAt).toLocaleString() %></dd>
                            </div>
                        </dl>
                    </div>

                    <!-- Danger Zone -->
                    <div class="data-animate-card rounded-xl bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800/20 p-5">
                        <h2 class="text-lg font-semibold mb-4 text-red-700 dark:text-red-400">Danger Zone</h2>
                        <div class="space-y-4">
                            <% if (user && (user.isAdmin || settings?.allowUserDeleteServer)) { %>
                            <div class="flex items-center justify-between gap-4">
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Delete Server</p>
                                    <p class="text-xs text-neutral-500">Permanently delete this server and all its data.</p>
                                </div>
                                <button id="deleteServerButton" class="rounded-xl bg-red-600 text-white px-4 py-2 text-sm font-medium transition hover:bg-red-700 shrink-0">Delete</button>
                            </div>
                            <div class="h-px bg-red-200 dark:bg-red-800/30"></div>
                            <% } %>
                            <div class="flex items-center justify-between gap-4">
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Reinstall Server</p>
                                    <p class="text-xs text-neutral-500">Reinstall from scratch — all data will be lost.</p>
                                </div>
                                <button id="reinstallButton" class="rounded-xl bg-red-600 text-white px-4 py-2 text-sm font-medium transition hover:bg-red-700 shrink-0">Reinstall</button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </div>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>
<%- include('../../components/modal') %>
<%- include('../../components/footer') %>
<% } %>

<script nonce="<%- nonce %>">
    document.addEventListener('DOMContentLoaded', function() {
        var serverSettingsForm = document.getElementById('serverSettingsForm');
        var reinstallButton = document.getElementById('reinstallButton');

        serverSettingsForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var formData = new FormData(serverSettingsForm);
            var settings = { name: formData.get('name'), description: formData.get('description') };
            var loader = showLoadingPopup('Updating Server Settings', 'Saving your changes...');
            fetch('/api/servers/<%= server.shortID %>/settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(settings)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                loader.close();
                if (data.success) {
                    showToast('Settings saved. Looking good.', 'success');
                    setTimeout(function() { window.location.reload(); }, 1500);
                } else {
                    showToast('Failed: ' + (data.error || 'Unknown error'), 'error');
                }
            })
            .catch(function(err) { loader.close(); showToast('Something went wrong.', 'error'); });
        });

        var deleteServerButton = document.getElementById('deleteServerButton');
        if (deleteServerButton) {
            deleteServerButton.addEventListener('click', function() {
                window.modal.confirm({
                    title: 'Delete Server',
                    body: 'This will permanently delete the server and all its data. This cannot be undone.',
                    danger: true,
                    confirmLabel: 'Delete Server',
                    onConfirm: function() {
                        window.modal.confirm({
                            title: 'Final Warning',
                            body: 'All server data will be permanently lost. Are you absolutely sure?',
                            danger: true,
                            confirmLabel: 'Yes, Delete',
                            onConfirm: function() {
                                showLoadingPopup('Deleting Server', 'Removing server and all data...');
                                <% if (user && user.isAdmin) { %>
                                window.location.href = '/admin/server/delete/<%= server.id %>';
                                <% } else { %>
                                fetch('/api/servers/<%= server.shortID %>', {
                                    method: 'DELETE',
                                    headers: { 'Content-Type': 'application/json' }
                                })
                                .then(function(r) { return r.json(); })
                                .then(function(data) {
                                    if (data.success) {
                                        showToast('Server deleted.', 'success');
                                        setTimeout(function() { window.location.href = '/dashboard'; }, 1500);
                                    } else {
                                        showToast('Failed: ' + (data.error || 'Unknown error'), 'error');
                                    }
                                })
                                .catch(function() { showToast('Something went wrong.', 'error'); });
                                <% } %>
                            }
                        });
                    }
                });
            });
        }

        reinstallButton.addEventListener('click', function() {
            window.modal.confirm({
                title: 'Confirm Reinstallation',
                body: 'WARNING: This will delete all data and reinstall from scratch. This cannot be undone.',
                danger: true,
                confirmLabel: 'Reinstall',
                onConfirm: function() {
                    window.modal.confirm({
                        title: 'Final Warning',
                        body: 'All server data will be permanently deleted. Proceed?',
                        danger: true,
                        confirmLabel: 'Proceed',
                        onConfirm: function() {
                            var loader = showLoadingPopup('Reinstalling Server', 'Initiating server reinstallation...');
                            loader.updateProgress(10, 'Preparing...');
                            fetch('/api/servers/<%= server.shortID %>/reinstall', { method: 'POST' })
                                .then(function(r) { return r.json(); })
                                .then(function(data) {
                                    loader.updateProgress(100, 'Reinstallation initiated!');
                                    setTimeout(function() {
                                        loader.close();
                                        if (data.success) {
                                            showToast('Server reinstalling. This may take a while.', 'success');
                                        } else {
                                            showToast('Failed: ' + (data.error || 'Unknown error'), 'error');
                                        }
                                    }, 1000);
                                })
                                .catch(function() { loader.close(); showToast('Something went wrong.', 'error'); });
                        }
                    });
                }
            });
        });
    });
</script>
