<%
function getFileIcon(category) {
  const iconNames = {
    'Configuration Files': 'file-code',
    'Documents': 'file-text',
    'Folder': 'folder',
    'Images': 'image',
    'No Category': 'file',
  };
  return iconNames[category] || 'file';
}

function isImageFile(filename) {
  const imageExtensions = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'svg', 'webp', 'tiff'];
  const extension = filename.split('.').pop().toLowerCase();
  return imageExtensions.includes(extension);
}
%>
<%
const fileList = (typeof files !== 'undefined' && Array.isArray(files)) ? files : [];
const curPath = (typeof filesCurrentPath !== 'undefined' && filesCurrentPath) ? filesCurrentPath : '';
const serverUUID = (typeof server !== 'undefined' && server && server.UUID) ? server.UUID : '';
%>
<% fileList.forEach(function(file, index) { %>
  <tr class="al-file-row al-table-tr" style="--i:<%= Math.min(index, 10) %>">
    <td class="al-table-td w-10">
      <input type="checkbox" class="al-form-checkbox file-checkbox" data-filename="<%= curPath && curPath !== '/' ? curPath.replace(new RegExp("^/+", "g"), '') + '/' + file.name : file.name %>" aria-label="<%= t('selectFile') %> <%= file.name %>">
    </td>
    <td class="al-table-td">
      <%
        const isImage = file.type !== 'directory' && isImageFile(file.name);
        const filePath = curPath && curPath !== '/'
          ? curPath.replace(new RegExp("^/+", "g"), '') + '/' + file.name
          : file.name;
        const fileHref = file.type === 'directory'
          ? '/server/' + serverUUID + '/files?path=' + encodeURIComponent(filePath)
          : isImage
            ? '#'
            : '/server/' + serverUUID + '/files/edit/' + encodeURIComponent(filePath);
        const fileSize = (function() {
          const sizes = ['Bytes', 'KB', 'MB', 'GB'];
          let size = file.size || 0;
          let unitIndex = 0;
          while (size >= 1024 && unitIndex < sizes.length - 1) {
            size /= 1024;
            unitIndex++;
          }
          return size.toFixed(2) + ' ' + sizes[unitIndex];
        })();
      %>
      <a href="<%= fileHref %>" class="al-file-link" data-filename="<%= file.name %>" data-path="<%= filePath %>" data-size="<%= fileSize %>" data-uuid="<%= serverUUID %>" <% if (isImage) { %>data-click="viewer"<% } %>>
        <span class="al-file-icon">
          <%- icon(getFileIcon(file.type === 'directory' ? 'Folder' : file.category || 'No Category'), { class: 'size-6' }) %>
        </span>
        <span class="truncate"><%= file.name %></span>
      </a>
    </td>
    <td class="al-table-td text-xs whitespace-nowrap font-mono tabular-nums" style="color:var(--theme-text-muted)">
      <%= fileSize %>
    </td>
    <td class="al-table-td text-xs whitespace-nowrap hidden md:table-cell" style="color:var(--theme-text-muted)">
      <% if (file.modifiedAt) { %>
        <time datetime="<%= new Date(file.modifiedAt).toISOString() %>" class="relative-time"><%= new Date(file.modifiedAt).toLocaleDateString() %></time>
      <% } else { %>
        <span aria-hidden="true">—</span>
      <% } %>
    </td>
  </tr>
<% }); %>
