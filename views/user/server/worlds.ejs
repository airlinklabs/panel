<%- include('../../layouts/user', { title: (server.name || t('server')) + ' — ' + t('worlds') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('worlds') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= server.name || t('server') %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
</header>

<div class="al-page-body" data-server-uuid="<%= server.UUID %>">

  <div id="worlds-list" class="flex flex-col gap-3">
    <% if (!worlds || worlds.length === 0) { %>
      <%- include('../../partials/empty-state', {
        iconName: 'globe',
        title: t('noWorlds'),
        description: t('noWorldsDesc')
      }) %>
    <% } else { %>
      <% worlds.forEach(function(world) { %>
        <div class="al-card" data-world-name="<%= world.name %>">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <div class="flex items-center gap-3 flex-1 min-w-0">
              <span class="al-icon-tile shrink-0"><%- icon('globe', { class: 'w-5 h-5' }) %></span>
              <div class="min-w-0">
                <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong)"><%= world.name %></p>
                <p class="text-[11px] mt-0.5" style="color:var(--theme-text-muted)">
                  <% if (world.size) { %><span><%= t('worldSizeLabel') %>: <%= (world.size / 1024 / 1024).toFixed(1) %> MB</span><% } %>
                  <% if (world.players !== undefined) { %><% if (world.size) { %> · <% } %><span><%= t('worldPlayersLabel', { count: world.players }) %></span><% } %>
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0 sm:justify-end">
              <% if (world.name !== 'world') { %>
                <button type="button" class="world-action-btn al-btn-secondary al-btn-sm min-h-11" data-world="<%= world.name %>" data-action="download" aria-label="<%= t('ariaDownloadWorld', { world: world.name }) %>">
                  <%- icon('download', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %> <%= t('download') %>
                </button>
                <button type="button" class="world-action-btn world-delete-btn al-btn-danger al-btn-icon-only" data-world="<%= world.name %>" data-action="delete" aria-label="<%= t('ariaDeleteWorld', { world: world.name }) %>">
                  <%- icon('trash-2', { class: 'w-4 h-4', strokeWidth: 2 }) %>
                </button>
              <% } else { %>
                <span class="al-badge al-badge-neutral"><%= t('default') %></span>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

</div>

<script type="module" nonce="<%- nonce %>">
  const serverUUID = document.querySelector('[data-server-uuid]')?.dataset.serverUuid;
  const T = <%- JSON.stringify({
    worldDeleteConfirmTitle: t('worldDeleteConfirmTitle'),
    worldDeleteConfirmBody: t('worldDeleteConfirmBody'),
    worldDeletedToast: t('worldDeletedToast'),
    worldDownloadStarted: t('worldDownloadStarted'),
    deleteLabel: t('delete')
  }) %>;

  async function confirmAction({ title, body, danger }) {
    await new Promise(resolve => {
      window.modal.confirm({ title, body, danger, confirmLabel: T.deleteLabel, onConfirm: resolve });
    });
  }

  document.querySelectorAll('.world-action-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const world = btn.dataset.world;
      const action = btn.dataset.action;

      if (action === 'delete') {
        await confirmAction({
          title: T.worldDeleteConfirmTitle,
          body: T.worldDeleteConfirmBody.replace('{{world}}', world),
          danger: true
        });
      }

      try {
        const res = await fetch(`/server/${serverUUID}/worlds/${encodeURIComponent(world)}/${action}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (data.success !== false) {
          if (action === 'delete') {
            btn.closest('[data-world-name]')?.remove();
          }
          if (window.showToast) window.showToast(action === 'delete' ? T.worldDeletedToast.replace('{{world}}', world) : T.worldDownloadStarted, 'success');
        }
      } catch (e) {
        console.error('World action failed', e);
      }
    });
  });
</script>

<%- include('../../layouts/user-footer') %>
