<%- include('../../layouts/user', { title: (server.name || 'Server') + ' — Worlds' }) %>

<nav aria-label="Breadcrumb" class="al-breadcrumb mb-6">
  <ol class="flex items-center text-sm gap-1">
    <li class="flex items-center">
      <a href="/" class="transition-colors hover:underline" style="color:var(--theme-text-muted);"><%= t('dashboard') %></a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <a href="/server/<%= server.UUID %>" class="transition-colors hover:underline" style="color:var(--theme-text-muted);"><%= server.name %></a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <span style="color:var(--theme-text);"><%= t('worlds') %></span>
    </li>
  </ol>
</nav>

<div class="px-6 sm:px-8 pb-12" data-server-uuid="<%= server.UUID %>">

  <h1 class="text-xl font-semibold mb-6" style="color:var(--theme-text);"><%= t('worlds') %></h1>

  <div id="worlds-list">
    <% if (!worlds || worlds.length === 0) { %>
      <div class="al-card p-8 text-center">
        <%- icon('globe', { class: 'w-10 h-10 mx-auto mb-3', strokeWidth: 1.5, style: 'color:var(--theme-text-muted);' }) %>
        <p class="text-sm mb-1" style="color:var(--theme-text-strong);">No worlds found</p>
        <p class="text-xs" style="color:var(--theme-text-muted);">Start your server to generate worlds.</p>
      </div>
    <% } else { %>
      <% worlds.forEach(function(world) { %>
        <div class="al-card p-4 mb-3 flex flex-col sm:flex-row sm:items-center gap-3" data-world-name="<%= world.name %>">
          <div class="flex items-center gap-3 flex-1 min-w-0">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background:var(--theme-bg-secondary);">
              <%- icon('globe', { class: 'w-5 h-5', strokeWidth: 1.5, style: 'color:var(--theme-text-muted);' }) %>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong);"><%= world.name %></p>
              <p class="text-[10px]" style="color:var(--theme-text-muted);">
                <% if (world.size) { %>Size: <%= (world.size / 1024 / 1024).toFixed(1) %> MB<% } %>
                <% if (world.players !== undefined) { %> · <%= world.players %> player(s)<% } %>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <% if (world.name !== 'world') { %>
              <button type="button" class="world-action-btn al-btn-secondary px-3 py-1.5 rounded-lg text-xs font-medium" data-world="<%= world.name %>" data-action="download">
                <%- icon('download', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %> Download
              </button>
              <button type="button" class="world-action-btn world-delete-btn al-btn-danger px-3 py-1.5 rounded-lg text-xs font-medium" data-world="<%= world.name %>" data-action="delete">
                <%- icon('trash-2', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %>
              </button>
            <% } else { %>
              <span class="text-[10px] px-2 py-1 rounded-lg" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted);">Default</span>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

</div>

<script type="module" nonce="<%- nonce %>">
  const serverUUID = document.querySelector('[data-server-uuid]')?.dataset.serverUuid;

  document.querySelectorAll('.world-action-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const world = btn.dataset.world;
      const action = btn.dataset.action;

      if (action === 'delete') {
        if (!confirm(`Delete world "${world}"? This cannot be undone.`)) return;
      }

      try {
        const res = await fetch(`/server/${serverUUID}/worlds/${encodeURIComponent(world)}/${action}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (data.success !== false) {
          if (action === 'delete') {
            btn.closest('[data-world-name]')?.remove();
          }
          if (window.showToast) window.showToast(`World ${action}d`, 'success');
        }
      } catch (e) {
        console.error(`World ${action} failed`, e);
      }
    });
  });
</script>

<%- include('../../layouts/user-footer') %>
