<% if (isMobileViewport) { %>
<%- include('../../components/header', { title: 'Worlds' }) %>
<main id="page-content">
    <%- include('../../components/template') %>
    <section class="px-4 py-5">
        <%- include('../../components/serverHeader', { server: server, req: req }) %>
        <div class="mt-4">
            <div class="data-animate-card rounded-xl bg-neutral-50 dark:bg-neutral-800/20 border border-neutral-200 dark:border-white/5 p-4">
                <h2 class="text-sm font-medium text-neutral-800 dark:text-white mb-3">Worlds</h2>
                <div id="worlds-list" class="space-y-2">
                    <% if (worlds.length === 0) { %>
                        <p class="text-xs text-neutral-500 text-center py-4">No worlds found.</p>
                    <% } else { %>
                        <% worlds.forEach(world => { %>
                            <div class="data-animate-card rounded-xl bg-neutral-100 dark:bg-neutral-700/30 border border-neutral-200 dark:border-white/5 p-3 flex items-center justify-between">
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-neutral-800 dark:text-white truncate"><%= world.name %></p>
                                    <p class="text-[10px] text-neutral-500">Size: <%= world.size %></p>
                                </div>
                                <div class="flex gap-1.5 shrink-0">
                                    <button class="rounded-lg bg-blue-600 hover:bg-blue-500 text-white px-2.5 py-1 text-[11px] font-medium transition" onclick="downloadWorld('<%= world.name %>')">Download</button>
                                    <button class="rounded-lg bg-red-600 hover:bg-red-500 text-white px-2.5 py-1 text-[11px] font-medium transition" onclick="deleteWorld('<%= world.name %>')">Delete</button>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/footer') %>

<% } else { %>
<%- include('../../components/header', { title: 'Worlds' }) %>
<main class="h-screen m-auto">
    <div class="flex h-screen">
        <%- include('../../components/template') %>
        <section id="page-content" class="flex-1 overflow-y-auto pt-16">
            <div class="px-8 pt-4">
                <%- include('../../components/serverHeader', { server: server, req: req }) %>
            </div>
            <div class="p-6">
                <div class="data-animate-card bg-neutral-50 dark:bg-neutral-800/20 rounded-xl p-5 border border-neutral-200 dark:border-white/5">
                    <h2 class="text-lg font-semibold text-neutral-800 dark:text-white mb-4">Worlds</h2>
                    <div id="worlds-list" class="space-y-3">
                        <% if (worlds.length === 0) { %>
                            <p class="text-sm text-neutral-500 text-center py-8">No worlds found.</p>
                        <% } else { %>
                            <% worlds.forEach(world => { %>
                                <div class="data-animate-card rounded-xl bg-neutral-100 dark:bg-neutral-700/30 border border-neutral-200 dark:border-white/5 p-4 flex items-center justify-between">
                                    <div class="min-w-0">
                                        <p class="text-sm font-medium text-neutral-800 dark:text-white"><%= world.name %></p>
                                        <p class="text-xs text-neutral-500">Size: <%= world.size %></p>
                                    </div>
                                    <div class="flex gap-2 shrink-0">
                                        <button class="rounded-xl bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 text-xs font-medium transition" onclick="downloadWorld('<%= world.name %>')">Download</button>
                                        <button class="rounded-xl bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 text-xs font-medium transition" onclick="deleteWorld('<%= world.name %>')">Delete</button>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/footer') %>
<% } %>

<script nonce="<%- nonce %>">
    function downloadWorld(name) {
        window.location.href = '/api/servers/<%= server.shortID %>/worlds/' + name + '/download';
    }

    function deleteWorld(name) {
        if (!confirm('Delete world ' + name + '?')) return;
        fetch('/api/servers/<%= server.shortID %>/worlds/' + name, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        }).then(res => {
            if (res.ok) location.reload();
        });
    }
</script>
