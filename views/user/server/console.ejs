<%- include('../../layouts/user', { title: (server.name || 'Server') + ' — Console', extraStyles: [assetUrl('/vendor/@xterm/xterm/css/xterm.css')] }) %>

<nav aria-label="Breadcrumb" class="al-breadcrumb mb-6">
  <ol class="flex items-center text-sm gap-1">
    <li class="flex items-center">
      <a href="/" class="transition-colors hover:underline" style="color:var(--theme-text-muted);"><%= t('dashboard') %></a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <a href="/server/<%= server.UUID %>" class="transition-colors hover:underline" style="color:var(--theme-text-muted);"><%= server.name %></a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <span style="color:var(--theme-text);"><%= t('console') %></span>
    </li>
  </ol>
</nav>

<div id="console-root" class="px-6 sm:px-8 pb-12"
  data-server-uuid="<%= server.UUID %>"
  data-server-name="<%= server.name %>"
  data-server-memory="<%= server.Memory || 0 %>"
  data-server-cpu="<%= server.Cpu || 0 %>"
  data-server-storage="<%= server.Storage || 0 %>"
  data-ws-token-url="/server/<%= server.UUID %>/ws-token"
  data-logs-history-url="/server/<%= server.UUID %>/console/logs"
  data-power-base-url="/server/<%= server.UUID %>/power"
  data-realtime-url="<%= typeof realtimeUrl !== 'undefined' ? realtimeUrl : '' %>">

  <!-- Stats Cards Row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="al-card p-4">
      <p class="text-[11px] font-medium uppercase tracking-wide mb-1" style="color:var(--theme-text-muted);"><%= t('status') %></p>
      <p id="status" class="text-lg font-medium tracking-tight leading-snug" style="color:var(--theme-text);"><%= t('loading') %></p>
      <p id="status-msg" class="text-xs font-medium mt-0.5 leading-snug transition-all duration-300 opacity-0 translate-y-1 pointer-events-none"></p>
      <canvas id="statusChart" class="mt-2 w-full h-6"></canvas>
    </div>
    <div class="al-card p-4">
      <p class="text-[11px] font-medium uppercase tracking-wide mb-1" style="color:var(--theme-text-muted);"><%= t('memory') %></p>
      <p id="ramUsage" class="text-sm font-medium" style="color:var(--theme-text-strong);">—</p>
      <canvas id="ramChart" class="mt-2 w-full h-6"></canvas>
    </div>
    <div class="al-card p-4">
      <p class="text-[11px] font-medium uppercase tracking-wide mb-1" style="color:var(--theme-text-muted);"><%= t('cpu') %></p>
      <p id="cpuUsage" class="text-sm font-medium" style="color:var(--theme-text-strong);">—</p>
      <canvas id="cpuChart" class="mt-2 w-full h-6"></canvas>
    </div>
    <div class="al-card p-4">
      <p class="text-[11px] font-medium uppercase tracking-wide mb-1" style="color:var(--theme-text-muted);"><%= t('disk') %></p>
      <p id="diskUsage" class="text-sm font-medium" style="color:var(--theme-text-strong);">—</p>
      <canvas id="diskChart" class="mt-2 w-full h-6"></canvas>
    </div>
  </div>

  <!-- Power Controls -->
  <div class="flex gap-2 mb-4">
    <button id="startButton" type="button" class="al-btn-primary px-4 py-2 rounded-xl text-sm font-medium inline-flex items-center gap-1.5">
      <%- icon('play', { class: 'w-4 h-4', strokeWidth: 2 }) %> <%= t('start') %>
    </button>
    <button id="restartButton" type="button" class="al-btn-secondary px-4 py-2 rounded-xl text-sm font-medium inline-flex items-center gap-1.5">
      <%- icon('refresh-cw', { class: 'w-4 h-4', strokeWidth: 2 }) %> <%= t('restart') %>
    </button>
    <button id="stopButton" type="button" class="al-btn-danger px-4 py-2 rounded-xl text-sm font-medium inline-flex items-center gap-1.5">
      <%- icon('square', { class: 'w-4 h-4', strokeWidth: 2 }) %> <%= t('stop') %>
    </button>
  </div>

  <!-- Queue Status -->
  <div id="queue-status" class="hidden mb-4 p-3 rounded-xl text-sm" style="background:var(--theme-warning-bg, var(--theme-bg-secondary));border:1px solid var(--theme-warning);">
    <p id="queue-position" class="font-medium" style="color:var(--theme-text-strong);"></p>
    <p id="queue-available" class="text-xs mt-0.5" style="color:var(--theme-text-muted);"></p>
    <button id="cancelQueueBtn" type="button" class="mt-2 text-xs underline" style="color:var(--theme-danger);">Cancel start</button>
  </div>

  <!-- Daemon Offline Warning -->
  <div id="daemonOfflineWarningRow" class="hidden mb-4 p-3 rounded-xl text-sm" style="background:var(--theme-danger-bg);border:1px solid var(--theme-danger);">
    <p class="font-medium" style="color:var(--theme-danger);">Daemon offline — console paused</p>
  </div>

  <!-- Console Terminal -->
  <div class="al-card overflow-hidden">
    <div class="flex items-center justify-between px-4 py-2 border-b" style="border-color:var(--theme-border);">
      <span class="text-xs font-medium" style="color:var(--theme-text-muted);">Console</span>
      <div class="flex items-center gap-2">
        <button id="loadHistoryBtn" type="button" class="text-xs px-2 py-1 rounded-lg transition-colors" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);" disabled>Load logs</button>
        <div id="consoleReadOnlyNotice" class="hidden text-[10px] px-2 py-0.5 rounded-full" style="background:var(--theme-warning-bg);color:var(--theme-warning);">Read-only (another tab open)</div>
      </div>
    </div>
    <div id="terminal" class="w-full" style="height:420px;background:#141414;"></div>
    <div class="flex items-center gap-2 px-4 py-2 border-t" style="border-color:var(--theme-border);">
      <span class="text-xs" style="color:var(--theme-text-muted);">~</span>
      <input id="input" type="text" class="flex-1 bg-transparent text-sm outline-none" style="color:var(--theme-text);" placeholder="Type a command..." disabled autocomplete="off" spellcheck="false">
    </div>
  </div>

  <!-- Mobile Console -->
  <div class="block md:hidden mt-4">
    <div class="al-card overflow-hidden">
      <div id="mobile-terminal" class="w-full" style="height:300px;background:#141414;"></div>
      <div class="flex items-center gap-2 px-4 py-2 border-t" style="border-color:var(--theme-border);">
        <input id="mobile-input" type="text" class="flex-1 bg-transparent text-sm outline-none" style="color:var(--theme-text);" placeholder="Type a command..." disabled autocomplete="off" spellcheck="false">
      </div>
    </div>
  </div>

</div>

<script type="module" nonce="<%- nonce %>">
  import { mount } from '<%= assetUrl('/javascript/islands/server-console.js') %>';
  const root = document.getElementById('console-root');
  if (root) {
    const config = {
      serverUUID: root.dataset.serverUuid,
      serverName: root.dataset.serverName,
      serverSuspended: false,
      serverMemory: Number(root.dataset.serverMemory) || 0,
      serverCpu: Number(root.dataset.serverCpu) || 0,
      serverStorage: Number(root.dataset.serverStorage) || 0,
      wsTokenUrl: root.dataset.wsTokenUrl,
      logsHistoryUrl: root.dataset.logsHistoryUrl,
      powerBaseUrl: root.dataset.powerBaseUrl,
      realtimeUrl: root.dataset.realtimeUrl || undefined,
      translations: {
        typeACommand: '<%= t('typeACommand') %>',
        confirmRestartServer: '<%= t('confirmRestartServer') %>',
        confirmRestartDesc: '<%= t('confirmRestartDesc') %>',
        restartServer: '<%= t('restartServer') %>',
        confirmStopServer: '<%= t('confirmStopServer') %>',
        confirmStopDesc: '<%= t('confirmStopDesc') %>',
        stopServer: '<%= t('stopServer') %>',
      },
      initialStatus: { online: false },
    };
    mount(root, config).catch(err => {
      console.error('Console mount failed:', err);
      root.innerHTML = '<div class="p-6 text-center text-sm" style="color:var(--theme-text-muted);">' +
        '<p class="font-medium mb-1" style="color:var(--theme-text);">Console unavailable</p>' +
        '<p>Failed to initialize the server console.</p></div>';
    });
  }
</script>

<%- include('../../layouts/user-footer') %>
