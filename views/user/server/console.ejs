<%- include('../../layouts/user', { title: (server.name || t('server')) + ' — ' + t('console'), extraStyles: [assetUrl('/vendor/@xterm/xterm/css/xterm.css')] }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('console') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('console') %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
</header>

<% /* console.ejs replaced manage.ejs as the server landing page (§15.3 F4), so
     it inherits manage's suspension notice. Kept outside #console-root because
     the island owns that subtree and replaces it wholesale on mount failure. */ %>
<% if (server.Suspended) { %>
<div class="al-alert-warning mb-4" role="alert">
  <%- icon('triangle-alert', { class: 'size-4 shrink-0 mt-0.5', 'aria-hidden': 'true' }) %>
  <div class="min-w-0">
    <p class="al-alert-title"><%= t('serverSuspended') %></p>
    <p class="al-alert-body"><%= t('serverSuspendedDesc') %></p>
  </div>
</div>
<% } %>

<div id="console-root" class="al-page-body"
  data-server-uuid="<%= server.UUID %>"
  data-server-name="<%= server.name %>"
  data-server-memory="<%= server.Memory || 0 %>"
  data-server-cpu="<%= server.Cpu || 0 %>"
  data-server-storage="<%= server.Storage || 0 %>"
  data-ws-token-url="/server/<%= server.UUID %>/ws-token"
  data-logs-history-url="/server/<%= server.UUID %>/console/logs"
  data-power-base-url="/server/<%= server.UUID %>/power"
  data-realtime-url="<%= typeof realtimeUrl !== 'undefined' ? realtimeUrl : '' %>">

  <!-- Stats Cards Row -->
  <div class="al-stat-grid mb-6">
    <div class="al-card">
      <p class="al-section-label"><%= t('status') %></p>
      <p id="status" class="text-lg font-medium tracking-tight leading-snug mt-1" style="color:var(--theme-text);"><%= t('loading') %></p>
      <p id="status-msg" class="text-xs font-medium mt-0.5 leading-snug transition-all duration-300 opacity-0 translate-y-1 pointer-events-none"></p>
      <canvas id="statusChart" class="mt-2 w-full h-6"></canvas>
    </div>
    <div class="al-card">
      <p class="al-section-label"><%= t('memory') %></p>
      <p id="ramUsage" class="text-sm font-medium mt-1 al-text-strong">—</p>
      <canvas id="ramChart" class="mt-2 w-full h-6"></canvas>
    </div>
    <div class="al-card">
      <p class="al-section-label"><%= t('cpu') %></p>
      <p id="cpuUsage" class="text-sm font-medium mt-1 al-text-strong">—</p>
      <canvas id="cpuChart" class="mt-2 w-full h-6"></canvas>
    </div>
    <div class="al-card">
      <p class="al-section-label"><%= t('disk') %></p>
      <p id="diskUsage" class="text-sm font-medium mt-1 al-text-strong">—</p>
      <canvas id="diskChart" class="mt-2 w-full h-6"></canvas>
    </div>
  </div>

  <!-- Power Controls -->
  <div class="flex flex-wrap gap-2 mb-4">
    <button id="startButton" type="button" class="al-btn-primary min-h-11">
      <%- icon('play', { class: 'w-4 h-4', strokeWidth: 2 }) %> <%= t('start') %>
    </button>
    <button id="restartButton" type="button" class="al-btn-secondary min-h-11">
      <%- icon('refresh-cw', { class: 'w-4 h-4', strokeWidth: 2 }) %> <%= t('restart') %>
    </button>
    <button id="stopButton" type="button" class="al-btn-danger min-h-11">
      <%- icon('square', { class: 'w-4 h-4', strokeWidth: 2 }) %> <%= t('stop') %>
    </button>
  </div>

  <!-- Queue Status -->
  <div id="queue-status" class="al-alert-warning hidden mb-4" role="status">
    <%- icon('clock', { class: 'size-4 shrink-0 mt-0.5', 'aria-hidden': 'true' }) %>
    <div class="min-w-0 flex-1">
      <p id="queue-position" class="al-alert-title"></p>
      <p id="queue-available" class="al-alert-body"></p>
      <button id="cancelQueueBtn" type="button" class="al-btn-link al-btn-sm mt-1 min-h-11"><%= t('cancelStart') %></button>
    </div>
  </div>

  <!-- Daemon Offline Warning -->
  <div id="daemonOfflineWarningRow" class="al-alert-danger hidden mb-4" role="alert">
    <%- icon('triangle-alert', { class: 'size-4 shrink-0 mt-0.5', 'aria-hidden': 'true' }) %>
    <div class="min-w-0">
      <p class="al-alert-title"><%= t('daemonOfflineConsoleTitle') %></p>
      <p class="al-alert-body"><%= t('daemonOfflineConsoleBody') %></p>
    </div>
  </div>

  <!-- Console Terminal -->
  <div class="al-card al-card-flush">
    <div class="al-console-bar">
      <span class="al-console-label"><%= t('console') %></span>
      <div class="al-console-actions">
        <button id="loadHistoryBtn" type="button" class="al-console-chip" disabled><%= t('loadLogs') %></button>
        <div id="consoleReadOnlyNotice" class="al-console-readonly hidden"><%= t('viewOnlyNotice') %></div>
      </div>
    </div>
    <div class="al-console-screen">
      <div id="terminal" class="absolute inset-0"></div>
    </div>
    <div class="al-console-inputbar">
      <span class="al-console-prompt" aria-hidden="true">~</span>
      <input id="input" type="text" class="al-console-input" placeholder="<%= t('typeACommand') %>" aria-label="<%= t('typeACommand') %>" disabled autocomplete="off" spellcheck="false">
    </div>
  </div>

  <!-- Mobile Console -->
  <div class="block md:hidden mt-4">
    <div class="al-card al-card-flush">
      <div class="al-console-screen">
        <div id="mobile-terminal" class="absolute inset-0"></div>
      </div>
      <div class="al-console-inputbar">
        <input id="mobile-input" type="text" class="al-console-input" placeholder="<%= t('typeACommand') %>" aria-label="<%= t('typeACommand') %>" disabled autocomplete="off" spellcheck="false">
      </div>
    </div>
  </div>

</div>

<script type="module" nonce="<%- nonce %>">
  import { mount } from '<%= assetUrl('/javascript/islands/server-console.js') %>';
  const root = document.getElementById('console-root');
  if (root) {
    const config = {
      serverUUID: root.dataset.serverUuid,
      serverName: root.dataset.serverName,
      serverSuspended: <%= !!server.Suspended %>,
      serverMemory: Number(root.dataset.serverMemory) || 0,
      serverCpu: Number(root.dataset.serverCpu) || 0,
      serverStorage: Number(root.dataset.serverStorage) || 0,
      wsTokenUrl: root.dataset.wsTokenUrl,
      logsHistoryUrl: root.dataset.logsHistoryUrl,
      powerBaseUrl: root.dataset.powerBaseUrl,
      realtimeUrl: root.dataset.realtimeUrl || undefined,
      translations: {
        typeACommand: '<%= t('typeACommand') %>',
        confirmRestartServer: '<%= t('confirmRestartServer') %>',
        confirmRestartDesc: '<%= t('confirmRestartDesc') %>',
        restartServer: '<%= t('restartServer') %>',
        confirmStopServer: '<%= t('confirmStopServer') %>',
        confirmStopDesc: '<%= t('confirmStopDesc') %>',
        stopServer: '<%= t('stopServer') %>',
      },
      initialStatus: { online: false },
    };
    mount(root, config).catch(err => {
      console.error('Console mount failed:', err);
      root.innerHTML = '<div class="p-6 text-center text-sm al-text-muted">' +
        '<p class="font-medium mb-1" style="color:var(--theme-text);"><%= t('Console unavailable') %></p>' +
        '<p><%= t('Failed to initialize the server console.') %></p></div>';
    });
  }
</script>

<%- include('../../layouts/user-footer') %>
