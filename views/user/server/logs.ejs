<%- include('../../layouts/user', { title: t('logs') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name, url: '/server/' + server.UUID },
    { label: t('logs') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('logs') %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="inline-flex items-center gap-1.5">
        <%- icon('box', { class: 'h-3.5 w-3.5 shrink-0' }) %>
        <span class="truncate max-w-[140px]"><%= server.image?.name %></span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <%- icon('server', { class: 'h-3.5 w-3.5 shrink-0' }) %>
        <span class="truncate max-w-[100px]"><%= server.node?.name %></span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <%- icon('hash', { class: 'h-3.5 w-3.5 shrink-0' }) %>
        <span class="font-mono"><%= server.UUID.split('-')[0] %></span>
      </span>
    </p>
  </div>
  <div>
    <a href="/server/<%= server.UUID %>" class="al-btn-ghost min-h-11">
      <%- icon('terminal', { class: 'size-4', strokeWidth: 1.5 }) %>
      <%= t('backToConsole') %>
    </a>
    <button id="logsRefreshBtn" type="button" class="al-btn-primary min-h-11">
      <%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %>
      <%= t('refresh') %>
    </button>
  </div>
</header>

<div class="al-page-body">
  <!-- Recent output viewer -->
  <div class="al-card mb-6">
    <div class="al-card-header">
      <div class="min-w-0">
        <h2 class="al-card-title"><%= t('recentOutput') %></h2>
        <p class="al-card-subtitle"><%= t('recentOutputDesc') %></p>
      </div>
    </div>
    <div class="al-card-body">
      <div id="logsViewer" class="al-code h-96 overflow-y-auto whitespace-pre-wrap break-words"></div>
    </div>
  </div>

  <!-- Saved logs -->
  <div class="al-card">
    <div class="al-card-header">
      <div class="min-w-0">
        <h2 class="al-card-title"><%= t('savedLogs') %></h2>
        <p class="al-card-subtitle"><%= t('savedLogsDesc') %></p>
      </div>
    </div>
    <div class="al-card-body">
      <ul id="logsArchiveList" class="divide-y -mx-5" style="border-color:var(--theme-table-divide)"></ul>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
  window.__serverUUID = '<%= server.UUID %>';
</script>
<script nonce="<%- nonce %>" src="<%= assetUrl('/javascript/user/server/logs.js') %>"></script>

<%- include('../../layouts/user-footer') %>
