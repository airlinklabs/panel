  function escAttr(val) {
    return String(val).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
%>

<div class="px-4 sm:px-8 pt-4 pb-8">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || 'Server', url: '/server/' + server.UUID },
    { label: t('subusers') }
  ] }) %>

  <div class="flex flex-wrap items-start justify-between gap-4 mt-4">
    <div class="flex-1 min-w-0">
      <h1 class="text-xl font-semibold" style="color:var(--theme-text-strong)"><%= server.name %></h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-1.5 text-[11px]" style="color:var(--theme-text-muted)">
        <% if (server.node) { %><span class="flex items-center gap-1"><%- icon('server', { class: 'w-3 h-3' }) %> <%= server.node.name %></span><% } %>
        <span class="flex items-center gap-1"><%- icon('hash', { class: 'w-3 h-3' }) %> <%= server.UUID %></span>
      </div>
    </div>
    <div class="flex gap-2 shrink-0">
      <button data-open-add-subuser type="button" class="al-btn-primary inline-flex items-center gap-1.5 rounded-xl px-3 py-2 text-sm font-medium shadow-sm">
        <%- icon('user-plus', { class: 'size-4', strokeWidth: 1.5 }) %>
        <%= t('addSubuser') %>
      </button>
    </div>
  </div>

  <!-- Subusers Table -->
  <div class="al-card rounded-lg shadow overflow-hidden mt-6">
    <div class="al-card-header">
      <div>
        <h3 class="text-[13px] font-semibold" style="color:var(--theme-text-strong)"><%= t('serverSubusers') || 'Server Subusers' %></h3>
        <p class="text-[11px]" style="color:var(--theme-text-muted)"><%= t('grantAccessDesc') || 'Grant other users access to manage this server.' %></p>
      </div>
    </div>
    <div class="overflow-x-auto">
      <% if (subUsers && subUsers.length > 0) { %>
        <table class="al-table min-w-full">
          <thead class="al-table-head">
            <tr>
              <th scope="col" class="al-table-th px-6 py-3 text-[11px] uppercase tracking-wide"><%= t('userColumn') || 'User' %></th>
              <th scope="col" class="al-table-th px-6 py-3 text-[11px] uppercase tracking-wide"><%= t('permissionsColumn') || 'Permissions' %></th>
              <th scope="col" class="al-table-th px-6 py-3 text-[11px] uppercase tracking-wide text-right"><%= t('actionsColumn') || 'Actions' %></th>
            </tr>
          </thead>
          <tbody class="divide-y" style="border-color:var(--theme-border)">
            <% subUsers.forEach(function(subUser) { %>
              <% var subName = (subUser.user && (subUser.user.username || subUser.user.email)) || 'Unknown'; %>
              <tr class="al-table-tr transition-colors" data-subuser-id="<%= subUser.id %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center gap-3">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-semibold shrink-0" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%= subName.slice(0, 1).toUpperCase() %></span>
                    <div class="min-w-0">
                      <div class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= subName %></div>
                      <div class="text-xs truncate max-w-[200px]" style="color:var(--theme-text-muted)"><%= subUser.user ? subUser.user.email : '' %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="flex flex-wrap gap-1.5 max-w-xs">
                    <% var shownPerms = subUser.permissions.slice(0, 4); var hiddenCount = subUser.permissions.length - shownPerms.length; %>
                    <% shownPerms.forEach(function(perm) { %>
                      <% if (permissionLabels && permissionLabels[perm]) { %>
                      <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-medium" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%- icon(permMeta[perm] ? permMeta[perm].icon : 'check', { size: 10 }) %><%= permissionLabels[perm] %></span>
                      <% } %>
                    <% }); %>
                    <% if (hiddenCount > 0) { %>
                      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)" title="<%= subUser.permissions.map(function(p) { return (permissionLabels && permissionLabels[p]) || p; }).join(', ') %>">+<%= hiddenCount %> <%= t('moreLabel') || 'more' %></span>
                    <% } %>
                    <% if (subUser.permissions.length === 0) { %>
                      <span class="text-xs italic" style="color:var(--theme-text-placeholder)"><%= t('noPermissions') || 'No permissions' %></span>
                    <% } %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex justify-end space-x-2">
                    <button type="button"
                      data-edit-subuser data-subuser-id="<%= subUser.id %>" data-subuser-name="<%= escAttr(subName) %>" data-subuser-perms='<%- JSON.stringify(subUser.permissions) %>'
                      class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-md transition-colors"
                      style="color:var(--theme-accent);background:var(--theme-accent-subtle)">
                      <%- icon('settings', { class: 'w-3 h-3 mr-1' }) %><%= t('editBtnLabel') || 'Edit' %>
                    </button>
                    <button type="button"
                      data-remove-subuser data-subuser-id="<%= subUser.id %>" data-subuser-name="<%= escAttr(subName) %>"
                      class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-md transition-colors"
                      style="color:var(--theme-danger);background:var(--theme-danger-subtle)">
                      <%- icon('trash-2', { class: 'w-3 h-3 mr-1' }) %>Remove
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="p-8 text-center text-sm" style="color:var(--theme-text-muted)">No subusers yet. Grant a user access with the button above.</div>
      <% } %>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
    var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
(function () {
  var serverId = '<%= server.UUID %>';

  var addModal = document.getElementById('addSubuserModal');
  var editModal = document.getElementById('editSubuserModal');
  var editId = null;

  function openModal(modal) { if (modal) modal.style.display = ''; }
  function closeModal(modal) { if (modal) modal.style.display = 'none'; }
  function closeAdd() { closeModal(addModal); }
  function closeEdit() { closeModal(editModal); }

  function permInput(modal, perm) {
    var label = modal.querySelector('label[data-perm="' + perm + '"]');
    return label ? label.querySelector('input[type="checkbox"]') : null;
  }

  function setPerm(modal, perm, on) {
    var input = permInput(modal, perm);
    if (input) input.checked = on;
  }

  function setAll(modal, on) {
    modal.querySelectorAll('label[data-perm] input[type="checkbox"]').forEach(function (input) {
      input.checked = on;
    });
  }

  function checkedPerms(modal) {
    var perms = [];
    modal.querySelectorAll('label[data-perm]').forEach(function (label) {
      var input = label.querySelector('input[type="checkbox"]');
      if (input && input.checked) perms.push(label.getAttribute('data-perm'));
    });
    return perms;
  }

  /* Parent perms (no dot) toggle their children; unchecking the last child
     unchecks the parent — mirrors subUserHasPermission in serverAuthUtil. */
  function wireCascade(modal) {
    if (!modal) return;
    modal.querySelectorAll('label[data-perm]').forEach(function (label) {
      var perm = label.getAttribute('data-perm');
      var input = label.querySelector('input[type="checkbox"]');
      if (!input) return;
      input.addEventListener('change', function () {
        if (perm.indexOf('.') === -1) {
          modal.querySelectorAll('label[data-perm^="' + perm + '."]').forEach(function (child) {
            var ci = child.querySelector('input[type="checkbox"]');
            if (ci) ci.checked = input.checked;
          });
          return;
        }
        var parent = perm.split('.')[0];
        if (input.checked) {
          setPerm(modal, parent, true);
          return;
        }
        var anyChild = false;
        modal.querySelectorAll('label[data-perm^="' + parent + '."]').forEach(function (child) {
          var ci = child.querySelector('input[type="checkbox"]');
          if (ci && ci.checked) anyChild = true;
        });
        if (!anyChild) setPerm(modal, parent, false);
      });
    });
  }

  wireCascade(addModal);
  wireCascade(editModal);

  document.querySelectorAll('[data-open-add-subuser]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var email = document.getElementById('addSubUserEmail');
      if (email) email.value = '';
      setAll(addModal, false);
      openModal(addModal);
    });
  });

  document.querySelectorAll('[data-edit-subuser]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var nameEl = document.getElementById('editSubuserName');
      if (nameEl) nameEl.textContent = btn.getAttribute('data-subuser-name') || '';
      var perms = [];
      try { perms = JSON.parse(btn.getAttribute('data-subuser-perms') || '[]'); } catch (e) { perms = []; }
      setAll(editModal, false);
      perms.forEach(function (p) { setPerm(editModal, p, true); });
      editId = btn.getAttribute('data-subuser-id') || '';
      openModal(editModal);
    });
  });

  document.querySelectorAll('[data-remove-subuser]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-subuser-id');
      var name = btn.getAttribute('data-subuser-name') || '';
      window.modal.confirm({
        title: 'Remove subuser',
        body: 'Remove ' + name + ' from this server? They will lose access immediately.',
        danger: true,
        confirmLabel: 'Remove',
        onConfirm: function () {
          fetch('/server/' + serverId + '/subusers/' + id + '/delete', {
            method: 'POST',
            headers: { 'x-csrf-token': csrfToken },
          })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (d.success !== false) { showToast('Subuser removed.', 'success'); window.location.reload(); }
              else showToast(d.error || 'Failed to remove subuser.', 'error');
            })
            .catch(function () { showToast('Request failed.', 'error'); });
        },
      });
    });
  });

  document.querySelectorAll('[data-select-all-add]').forEach(function (btn) {
    btn.addEventListener('click', function () { setAll(addModal, true); });
  });
  document.querySelectorAll('[data-clear-add]').forEach(function (btn) {
    btn.addEventListener('click', function () { setAll(addModal, false); });
  });
  document.querySelectorAll('[data-select-all-edit]').forEach(function (btn) {
    btn.addEventListener('click', function () { setAll(editModal, true); });
  });
  document.querySelectorAll('[data-clear-edit]').forEach(function (btn) {
    btn.addEventListener('click', function () { setAll(editModal, false); });
  });
  document.querySelectorAll('[data-close-add]').forEach(function (el) {
    el.addEventListener('click', closeAdd);
  });
  document.querySelectorAll('[data-close-edit]').forEach(function (el) {
    el.addEventListener('click', closeEdit);
  });

  var addConfirm = document.getElementById('addSubuserConfirmBtn');
  if (addConfirm) {
    addConfirm.addEventListener('click', function () {
      var emailEl = document.getElementById('addSubUserEmail');
      var email = emailEl ? emailEl.value.trim() : '';
      if (!email) { showToast('Enter the user email.', 'error'); return; }
      addConfirm.disabled = true;
      fetch('/server/' + serverId + '/subusers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ email: email, permissions: checkedPerms(addModal) }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.success !== false) { showToast('Subuser added.', 'success'); window.location.reload(); }
          else showToast(d.error || 'Failed to add subuser.', 'error');
        })
        .catch(function () { showToast('Request failed.', 'error'); })
        .finally(function () { addConfirm.disabled = false; });
    });
  }

  var editConfirm = document.getElementById('editSubuserConfirmBtn');
  if (editConfirm) {
    editConfirm.addEventListener('click', function () {
      if (!editId) return;
      editConfirm.disabled = true;
      fetch('/server/' + serverId + '/subusers/' + editId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ permissions: checkedPerms(editModal) }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.success !== false) { showToast('Permissions updated.', 'success'); window.location.reload(); }
          else showToast(d.error || 'Failed to update permissions.', 'error');
        })
        .catch(function () { showToast('Request failed.', 'error'); })
        .finally(function () { editConfirm.disabled = false; });
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeAdd(); closeEdit(); }
  });
})();
</script>
<!-- Add Subuser Modal -->
<div id="addSubuserModal" class="al-modal-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="addSubUserTitle">
  <div class="al-modal-backdrop" data-close-add></div>
  <div class="al-modal-container" style="max-width:32rem">
    <div class="al-modal-header">
      <h3 id="addSubUserTitle" class="al-modal-title"><%= t('addSubuserTitle') || 'Add Subuser' %></h3>
      <button type="button" class="al-modal-close" data-close-add aria-label="Close"><%- icon('x', { class: 'w-5 h-5' }) %></button>
    </div>
    <div class="al-modal-body" style="max-height:60vh;overflow-y:auto">
      <div class="mb-4">
        <label for="addSubUserEmail" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= t('userEmailLabel') || 'User Email' %></label>
        <input id="addSubUserEmail" type="email" class="al-input w-full" placeholder="friend@example.com" autocomplete="off">
      </div>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('permissionsLabel') || 'Permissions' %></label>
          <div class="flex items-center gap-3 text-[11px] font-medium">
            <button type="button" data-select-all-add class="inline-flex items-center gap-1" style="color:var(--theme-accent)"><%- icon('check-check', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('selectAll') || 'Select All' %></button>
            <button type="button" data-clear-add class="inline-flex items-center gap-1" style="color:var(--theme-text-muted)"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('clearAll') || 'Clear All' %></button>
          </div>
        </div>
        <div class="space-y-3 max-h-[44vh] overflow-y-auto pr-1">
          <% permissionGroups.forEach(function(group) { %>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-wider mb-1.5" style="color:var(--theme-text-muted)"><%= group.title %></p>
            <div class="space-y-1.5">
              <% group.perms.forEach(function(perm) { %>
              <label class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs cursor-pointer transition-colors" data-perm="<%= perm %>" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
                <input type="checkbox" class="form-checkbox h-4 w-4 rounded transition" style="accent-color:var(--theme-accent)">
                <%- icon(permMeta[perm] ? permMeta[perm].icon : 'check', { size: 14, class: 'shrink-0' }) %>
                <span class="shrink-0 font-medium" style="color:var(--theme-text-strong)"><%= permissionLabels ? permissionLabels[perm] : perm %></span>
                <span class="ml-auto truncate" style="color:var(--theme-text-muted)"><%= permMeta[perm] ? permMeta[perm].desc : '' %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
    <div class="al-modal-footer">
      <button type="button" data-close-add class="al-btn-secondary px-4 py-2 text-sm font-medium inline-flex items-center gap-1.5">
        <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('cancel') || 'Cancel' %>
      </button>
      <button type="button" id="addSubuserConfirmBtn" class="al-btn-primary px-4 py-2 text-sm font-medium inline-flex items-center gap-1.5">
        <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('addSubuserBtnLabel') || 'Add Subuser' %></span>
      </button>
    </div>
  </div>
</div>

<!-- Edit Subuser Modal -->
