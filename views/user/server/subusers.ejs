<%- include('../../components/header', { title: 'Subusers' }) %>
<style>
  .al-perm-row { transition: background 150ms ease, border-color 150ms ease; }
  .al-perm-row:has(input:checked) {
    border-color: var(--theme-accent);
    background: var(--theme-accent-subtle);
  }
  .al-perm-row input[type="checkbox"] { accent-color: var(--theme-accent); }
  .al-subuser-row {
    animation: al-subuser-in 180ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 18ms);
  }
  @keyframes al-subuser-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .al-subuser-row { animation: none; }
  }
</style>

<%
  const permMeta = {
    'websocket.connect': { icon: 'radio-tower', desc: 'Connect to the live console stream' },
    console: { icon: 'terminal', desc: 'View console and send commands' },
    'console.send': { icon: 'message-square', desc: 'Send commands to the console' },
    'control.start': { icon: 'play', desc: 'Start the server' },
    'control.stop': { icon: 'square', desc: 'Stop the server' },
    'control.restart': { icon: 'rotate-ccw', desc: 'Restart the server' },
    'control.console': { icon: 'send', desc: 'Access the console page' },
    files: { icon: 'folder', desc: 'View, upload and edit files' },
    'files.read': { icon: 'file-text', desc: 'View and read files' },
    'files.write': { icon: 'upload', desc: 'Edit and upload files' },
    'files.delete': { icon: 'trash-2', desc: 'Rename, move and delete files' },
    'files.sftp': { icon: 'key-round', desc: 'Generate SFTP credentials' },
    'files.pull': { icon: 'download', desc: 'Import files by URL' },
    'files.archive': { icon: 'archive', desc: 'Archive and unpack files' },
    'files.create': { icon: 'file-plus', desc: 'Create files and folders' },
    'files.update': { icon: 'pencil', desc: 'Save file changes' },
    startup: { icon: 'play', desc: 'View and edit startup variables' },
    'startup.read': { icon: 'eye', desc: 'View startup variables' },
    'startup.update': { icon: 'pencil', desc: 'Edit startup variables' },
    'startup.docker-image': { icon: 'box', desc: 'Change the Docker image' },
    backups: { icon: 'archive', desc: 'View and create backups' },
    'backups.read': { icon: 'list', desc: 'List backups' },
    'backups.create': { icon: 'plus', desc: 'Create backups' },
    'backups.delete': { icon: 'trash-2', desc: 'Delete backups' },
    'backups.download': { icon: 'download', desc: 'Download backups' },
    'backups.restore': { icon: 'history', desc: 'Restore backups' },
    'backups.lock': { icon: 'lock', desc: 'Lock backups' },
    'database.create': { icon: 'plus', desc: 'Create databases' },
    'database.read': { icon: 'database', desc: 'View databases' },
    'database.update': { icon: 'pencil', desc: 'Edit databases' },
    'database.delete': { icon: 'trash-2', desc: 'Delete databases' },
    'database.view_password': { icon: 'key', desc: 'View database passwords' },
    'schedule.create': { icon: 'plus', desc: 'Create schedules' },
    'schedule.read': { icon: 'calendar', desc: 'View schedules' },
    'schedule.update': { icon: 'pencil', desc: 'Edit schedules' },
    'schedule.delete': { icon: 'trash-2', desc: 'Delete schedules' },
    'allocation.read': { icon: 'map-pin', desc: 'View allocations' },
    'allocation.create': { icon: 'plus', desc: 'Create allocations' },
    'allocation.update': { icon: 'pencil', desc: 'Edit allocations' },
    'allocation.delete': { icon: 'trash-2', desc: 'Delete allocations' },
    settings: { icon: 'settings', desc: 'View server settings (read-only)' },
    'settings.update': { icon: 'pencil', desc: 'Edit server settings' },
    'settings.rename': { icon: 'tag', desc: 'Rename the server' },
    'settings.reinstall': { icon: 'refresh-cw', desc: 'Reinstall the server' },
    'activity.read': { icon: 'activity', desc: 'View the server activity log' },
  };

  function escAttr(val) {
    return String(val)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }
%>

<script nonce="<%- nonce %>">
function subusersPage() {
  const serverId = '<%= server.UUID %>';
  const allPerms = <%- JSON.stringify(permissionGroups.map(g => g.perms).flat()) %>;

  return {
    showAdd: false,
    showEdit: false,
    addEmail: '',
    addPerms: allPerms.filter(p => p.indexOf('.') === -1),
    editId: null,
    editName: '',
    editPerms: [],
    saving: false,

    openAdd() {
      this.addEmail = '';
      this.addPerms = allPerms.filter(p => p.indexOf('.') === -1);
      this.showAdd = true;
    },

    openEdit(id, name, permissions) {
      this.editId = id;
      this.editName = name;
      this.editPerms = [...permissions];
      this.showEdit = true;
    },

    isAddPerm(perm) { return this.addPerms.includes(perm); },
    isEditPerm(perm) { return this.editPerms.includes(perm); },

    toggleAddPerm(perm) {
      const isParent = perm.indexOf('.') === -1;
      if (isParent) {
        const idx = this.addPerms.indexOf(perm);
        if (idx === -1) {
          this.addPerms.push(perm);
          allPerms.filter(p => p.startsWith(perm + '.')).forEach(p => {
            if (!this.addPerms.includes(p)) this.addPerms.push(p);
          });
        } else {
          this.addPerms = this.addPerms.filter(p => p !== perm && !p.startsWith(perm + '.'));
        }
      } else {
        const idx = this.addPerms.indexOf(perm);
        if (idx === -1) {
          this.addPerms.push(perm);
          const parent = perm.split('.')[0];
          if (!this.addPerms.includes(parent)) this.addPerms.push(parent);
        } else {
          this.addPerms = this.addPerms.filter(p => p !== perm);
          const parent = perm.split('.')[0];
          if (!this.addPerms.some(p => p.startsWith(parent + '.') && p !== parent)) {
            this.addPerms = this.addPerms.filter(p => p !== parent);
          }
        }
      }
    },

    toggleEditPerm(perm) {
      const isParent = perm.indexOf('.') === -1;
      if (isParent) {
        const idx = this.editPerms.indexOf(perm);
        if (idx === -1) {
          this.editPerms.push(perm);
          allPerms.filter(p => p.startsWith(perm + '.')).forEach(p => {
            if (!this.editPerms.includes(p)) this.editPerms.push(p);
          });
        } else {
          this.editPerms = this.editPerms.filter(p => p !== perm && !p.startsWith(perm + '.'));
        }
      } else {
        const idx = this.editPerms.indexOf(perm);
        if (idx === -1) {
          this.editPerms.push(perm);
          const parent = perm.split('.')[0];
          if (!this.editPerms.includes(parent)) this.editPerms.push(parent);
        } else {
          this.editPerms = this.editPerms.filter(p => p !== perm);
          const parent = perm.split('.')[0];
          if (!this.editPerms.some(p => p.startsWith(parent + '.') && p !== parent)) {
            this.editPerms = this.editPerms.filter(p => p !== parent);
          }
        }
      }
    },

    selectAllAdd() { this.addPerms = [...allPerms]; },
    clearAdd() { this.addPerms = []; },
    selectAllEdit() { this.editPerms = [...allPerms]; },
    clearEdit() { this.editPerms = []; },

    async confirmAdd() {
      if (this.saving) return;
      if (!this.addEmail.trim()) { showToast('Enter the user email.', 'error'); return; }
      this.saving = true;
      try {
        const result = await api('/server/' + serverId + '/subusers', 'POST', {
          email: this.addEmail.trim(),
          permissions: [...this.addPerms]
        });
        if (result) {
          showToast('Subuser added.', 'success');
          this.showAdd = false;
          window.location.reload();
        }
      } catch (e) { showToast('Failed to add subuser.', 'error'); }
      finally { this.saving = false; }
    },

    async confirmEdit() {
      if (this.saving || !this.editId) return;
      this.saving = true;
      try {
        const result = await api('/server/' + serverId + '/subusers/' + this.editId, 'PUT', {
          permissions: [...this.editPerms]
        });
        if (result) {
          showToast('Permissions updated.', 'success');
          this.showEdit = false;
          window.location.reload();
        }
      } catch (e) { showToast('Failed to update permissions.', 'error'); }
      finally { this.saving = false; }
    },

    async removeSubUser(id, name) {
      window.modal.confirm({
        title: 'Remove subuser',
        body: 'Remove ' + name + ' from this server? They will lose access immediately.',
        danger: true,
        confirmLabel: 'Remove',
        onConfirm: async () => {
          const result = await api('/server/' + serverId + '/subusers/' + id, 'DELETE');
          if (result) {
            showToast('Subuser removed.', 'success');
            window.location.reload();
          }
        }
      });
    }
  };
}
</script>

<div x-data="subusersPage()">
<main class="h-screen m-auto" style="color:var(--theme-text)">
  <div class="flex h-full">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-0 pb-12 lg:pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Dashboard', href: '/' },
        { label: server.name, href: '/server/' + server.UUID },
        { label: 'Subusers' }
      ] }) %>
      <!-- Page Header: title + meta left, buttons right -->
      <div class="px-6 sm:px-8 pt-3 pb-2 sm:pb-6">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <!-- Server meta: image · node · id -->
            <%- include('../../components/serverMeta') %>
          </div>
          <div class="flex gap-2 shrink-0">
            <button @click="openAdd()" type="button"
                class="al-btn-primary block rounded-xl px-3 py-2 text-center text-sm font-medium shadow-lg transition duration-300">
                <%- icon('plus', { class: 'size-4 inline-flex mr-1 mb-0.5', strokeWidth: 1.5 }) %>
                Add Subuser
            </button>
          </div>
        </div>
      </div>

      <%- include('../../components/installHeader') %>

      <!-- Server Template -->
      <%- include('../../components/serverTemplate') %>

      <div id="server-page-body">

      <!-- Subusers Management -->
      <div class="px-6 mt-6">
        <div class="al-card rounded-lg shadow overflow-hidden">
          <div class="al-card-header">
            <div>
              <h2 class="text-[13px] font-semibold" style="color:var(--theme-text-strong)">Server Subusers</h2>
              <p class="text-[11px]" style="color:var(--theme-text-muted)">Grant other users access to this server.</p>
            </div>
          </div>
          <div class="overflow-x-auto">
            <% if (subUsers && subUsers.length > 0) { %>
              <table class="al-table min-w-full">
                <colgroup>
                  <col style="min-width:220px">
                  <col style="min-width:240px">
                  <col style="min-width:140px">
                </colgroup>
                <thead class="al-table-head">
                  <tr>
                    <th scope="col" class="al-table-th px-6 py-3 text-[11px] uppercase tracking-wide">User</th>
                    <th scope="col" class="al-table-th px-6 py-3 text-[11px] uppercase tracking-wide">Permissions</th>
                    <th scope="col" class="al-table-th px-6 py-3 text-[11px] uppercase tracking-wide text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="subusers-table-body" class="divide-y" style="border-color:var(--theme-border)">
                  <% let subIdx = 0; subUsers.forEach(subUser => { %>
                    <% const subName = subUser.user.username || subUser.user.email || 'Unknown'; %>
                    <tr class="al-table-tr al-subuser-row transition-colors" style="--i:<%= Math.min(subIdx++, 10) %>" data-subuser-id="<%= subUser.id %>">
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                          <span class="flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-semibold shrink-0" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%= subName.slice(0, 1).toUpperCase() %></span>
                          <div class="min-w-0">
                            <div class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= subName %></div>
                            <div class="text-xs truncate max-w-[200px]" style="color:var(--theme-text-muted)"><%= subUser.user.email %></div>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1.5 max-w-xs">
                          <% const shownPerms = subUser.permissions.slice(0, 4); const hiddenPerms = subUser.permissions.length - shownPerms.length; %>
                          <% shownPerms.forEach(perm => { %>
                            <% if (permissionLabels[perm]) { %>
                            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-medium" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%- icon(permMeta[perm] ? permMeta[perm].icon : 'check', { size: 10 }) %><%= permissionLabels[perm] %></span>
                            <% } %>
                          <% }) %>
                          <% if (hiddenPerms > 0) { %>
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)" title="<%= subUser.permissions.map(p => permissionLabels[p] || p).join(', ') %>">+<%= hiddenPerms %> more</span>
                          <% } %>
                          <% if (subUser.permissions.length === 0) { %>
                            <span class="text-xs italic" style="color:var(--theme-text-placeholder)">No permissions</span>
                          <% } %>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <div class="flex justify-end space-x-2">
                          <button type="button"
                            @click="openEdit(<%= subUser.id %>, '<%= escAttr(subName) %>', <%- JSON.stringify(subUser.permissions) %>)"
                            class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                            style="color:var(--theme-accent);background:var(--theme-accent-subtle)"
                          >
                            <%- icon('settings', { class: 'w-3 h-3 mr-1' }) %>
                            Edit
                          </button>
                          <button type="button"
                            @click="removeSubUser(<%= subUser.id %>, '<%= escAttr(subName) %>')"
                            class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                            style="color:var(--theme-danger);background:var(--theme-danger-bg)"
                          >
                            <%- icon('trash-2', { class: 'w-3 h-3 mr-1' }) %>
                            Remove
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } else { %>
              <div class="p-8 text-center">
                <div class="flex justify-center mb-5">
                  <div class="w-16 h-16 rounded-full flex items-center justify-center" style="background:var(--theme-bg-secondary);">
                    <%- icon('users', { class: 'size-6', strokeWidth: 1.5, style: 'color:var(--theme-text-muted)' }) %>
                  </div>
                </div>
                <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)">No subusers</h3>
                <p class="mt-1 text-sm" style="color:var(--theme-text-muted)">Invite other users to help manage this server.</p>
                <button type="button" @click="openAdd()" class="al-btn-primary inline-flex items-center gap-1.5 mt-5 rounded-xl px-4 py-2 text-sm font-medium">
                  <%- icon('user-plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                  Add subuser
                </button>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      </div><!-- /server-page-body -->
    </div>
  </div>
</main>

<!-- Add Subuser Modal -->
<div x-show="showAdd" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center" style="display:none" @keydown.escape.window="if(showAdd) showAdd = false">
  <div class="al-sheet-panel w-full max-w-lg rounded-2xl max-h-[85vh] flex flex-col" role="dialog" aria-modal="true" aria-labelledby="addSubUserTitle" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:0 20px 60px rgba(0,0,0,0.3)">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 id="addSubUserTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)">Add subuser</h3>
      <button type="button" @click="showAdd = false" aria-label="Close" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0"><%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %></button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4 space-y-4">
      <div>
        <label for="addSubUserEmail" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)">User email</label>
        <input id="addSubUserEmail" x-model="addEmail" type="email" class="al-input w-full" placeholder="friend@example.com" autocomplete="off" @keydown.enter.prevent="confirmAdd()">
      </div>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-medium" style="color:var(--theme-text-muted)">Permissions</label>
          <div class="flex items-center gap-3 text-[11px] font-medium">
            <button type="button" @click="selectAllAdd()" class="inline-flex items-center gap-1.5" style="color:var(--theme-accent)"><%- icon('check-check', { class: 'size-3', strokeWidth: 1.5 }) %>Select all</button>
            <button type="button" @click="clearAdd()" class="inline-flex items-center gap-1.5" style="color:var(--theme-text-muted)"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>Clear</button>
          </div>
        </div>
        <div class="space-y-3 max-h-[44vh] overflow-y-auto pr-1">
          <% permissionGroups.forEach(group => { %>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-wider mb-1.5" style="color:var(--theme-text-muted)"><%= group.title %></p>
            <div class="space-y-1.5">
              <% group.perms.forEach(perm => { %>
              <label class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs cursor-pointer transition-colors" :style="isAddPerm('<%= perm %>') ? 'background:var(--theme-accent-subtle);border:1px solid var(--theme-accent)' : 'background:var(--theme-bg-secondary);border:1px solid var(--theme-border)'">
                <input type="checkbox" :checked="isAddPerm('<%= perm %>')" @change="toggleAddPerm('<%= perm %>')" class="form-checkbox h-4 w-4 rounded transition" style="accent-color:var(--theme-accent)">
                <%- icon(permMeta[perm].icon, { size: 14, class: 'shrink-0' }) %>
                <span class="shrink-0 font-medium" style="color:var(--theme-text-strong)"><%= permissionLabels[perm] %></span>
                <span class="ml-auto truncate" style="color:var(--theme-text-muted)"><%= permMeta[perm].desc %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
    <div class="flex gap-2 px-6 py-4 border-t justify-end">
      <button type="button" @click="showAdd = false" class="al-btn-secondary flex-1 inline-flex items-center gap-1.5">
        <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Cancel
      </button>
      <button type="button" @click="confirmAdd()" class="al-btn-primary flex-1 inline-flex items-center gap-1.5" :disabled="saving">
        <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><span x-text="saving ? 'Adding\u2026' : 'Add subuser'">Add subuser</span>
      </button>
    </div>
  </div>
</div>

