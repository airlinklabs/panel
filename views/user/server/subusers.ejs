<%- include('../../components/header', { title: 'Subusers' }) %>

<%
  const permMeta = {
    console: { icon: 'terminal', desc: 'View console and send commands' },
    'console.send': { icon: 'message-square', desc: 'Send commands to the console' },
    files: { icon: 'folder', desc: 'View, upload and edit files' },
    'files.read': { icon: 'file', desc: 'View and read files' },
    'files.write': { icon: 'upload', desc: 'Edit and upload files' },
    'files.delete': { icon: 'trash-2', desc: 'Rename, move and delete files' },
    'files.sftp': { icon: 'key', desc: 'Generate SFTP credentials' },
    'files.pull': { icon: 'download', desc: 'Import files by URL' },
    'files.archive': { icon: 'archive', desc: 'Archive and unpack files' },
    startup: { icon: 'play', desc: 'View and edit startup variables' },
    'startup.read': { icon: 'eye', desc: 'View startup variables' },
    'startup.update': { icon: 'pencil', desc: 'Edit startup variables' },
    'startup.docker-image': { icon: 'box', desc: 'Change the Docker image' },
    backups: { icon: 'archive', desc: 'View and create backups' },
    'backups.read': { icon: 'list', desc: 'List backups' },
    'backups.create': { icon: 'plus', desc: 'Create backups' },
    'backups.delete': { icon: 'trash-2', desc: 'Delete backups' },
    'backups.download': { icon: 'download', desc: 'Download backups' },
    settings: { icon: 'settings', desc: 'View server settings (read-only)' },
    'settings.update': { icon: 'pencil', desc: 'Edit server settings' },
  };
  const permGroups = [
    { title: 'Console control', perms: ['console', 'console.send'] },
    { title: 'Files', perms: ['files', 'files.read', 'files.write', 'files.delete', 'files.sftp', 'files.pull', 'files.archive'] },
    { title: 'Startup', perms: ['startup', 'startup.read', 'startup.update', 'startup.docker-image'] },
    { title: 'Backups', perms: ['backups', 'backups.read', 'backups.create', 'backups.delete', 'backups.download'] },
    { title: 'Settings', perms: ['settings', 'settings.update'] },
  ];
%>

<main class="h-screen m-auto text-neutral-800 dark:text-white">
  <div class="flex h-full">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/template') %>
    </div>
    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-16 pb-12 lg:pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Dashboard', href: '/' },
        { label: server.name, href: '/server/' + server.UUID },
        { label: 'Subusers' }
      ] }) %>
      <!-- Page Header: title + meta left, buttons right -->
      <div class="px-4 sm:px-8 pt-4 pb-2 sm:pb-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <!-- Server meta: image · node · id -->
            <%- include('../../components/serverMeta') %>
          </div>
          <div class="flex gap-2 shrink-0">
            <button id="addSubUserBtn" onclick="openAddSubUserModal()" type="button"
                class="al-btn-primary block rounded-xl px-3 py-2 text-center text-sm font-medium shadow-lg transition duration-300">
                <%- icon('plus', { class: 'size-4 inline-flex mr-1 mb-0.5', strokeWidth: 1.5 }) %>
                Add Subuser
            </button>
          </div>
        </div>
      </div>

      <%- include('../../components/installHeader') %>

      <!-- Server Template -->
      <%- include('../../components/serverTemplate') %>

      <div id="server-page-body">

      <!-- Subusers Management -->
      <div class="px-6 mt-8">
        <div class="al-card rounded-lg shadow overflow-hidden">
          <div class="al-card-header">
            <div>
              <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Server Subusers</h2>
              <p class="text-xs" style="color:var(--theme-text-muted)">Grant other users access to this server.</p>
            </div>
          </div>
          <div class="overflow-x-auto">
            <% if (subUsers && subUsers.length > 0) { %>
              <table class="al-table min-w-full">
                <thead class="al-table-head">
                  <tr>
                    <th scope="col" class="al-table-th px-6 py-3 uppercase">User</th>
                    <th scope="col" class="al-table-th px-6 py-3 uppercase">Permissions</th>
                    <th scope="col" class="al-table-th px-6 py-3 uppercase">Added</th>
                    <th scope="col" class="al-table-th px-6 py-3 uppercase text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="subusers-table-body" class="divide-y" style="border-color:var(--theme-border)">
                  <% let subIdx = 0; subUsers.forEach(subUser => { %>
                    <tr class="al-table-tr transition-colors" style="--i:<%= subIdx++ %>" data-subuser-id="<%= subUser.id %>">
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                          <span class="flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-semibold shrink-0" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%= (subUser.user.username || subUser.user.email || '?').slice(0, 1).toUpperCase() %></span>
                          <div class="min-w-0">
                            <div class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= subUser.user.username || 'Unknown' %></div>
                            <div class="text-xs truncate max-w-[200px]" style="color:var(--theme-text-muted)"><%= subUser.user.email %></div>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1.5 max-w-xs">
                          <% const shownPerms = subUser.permissions.slice(0, 4); const hiddenPerms = subUser.permissions.length - shownPerms.length; %>
                          <% shownPerms.forEach(perm => { %>
                            <% if (permissionLabels[perm]) { %>
                            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-medium" style="background:var(--theme-accent-subtle);color:var(--theme-accent)"><%- icon(permMeta[perm] ? permMeta[perm].icon : 'check', { size: 10 }) %><%= permissionLabels[perm] %></span>
                            <% } %>
                          <% }) %>
                          <% if (hiddenPerms > 0) { %>
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)">+<%= hiddenPerms %> more</span>
                          <% } %>
                          <% if (subUser.permissions.length === 0) { %>
                            <span class="text-xs italic" style="color:var(--theme-text-placeholder)">No permissions</span>
                          <% } %>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm" style="color:var(--theme-text-muted)">
                          <%= new Date(subUser.createdAt).toLocaleDateString() %>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <div class="flex justify-end space-x-2">
                          <button type="button"
                            onclick="openEditSubUserModal(<%= subUser.id %>, '<%= subUser.user.username || subUser.user.email %>', <%= JSON.stringify(subUser.permissions).replace(/'/g, "&#39;") %>)"
                            class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                            style="color:var(--theme-accent);background:var(--theme-accent-subtle)"
                          >
                            <%- icon('settings', { class: 'w-3 h-3 mr-1' }) %>
                            Edit
                          </button>
                          <button type="button"
                            onclick="removeSubUser(<%= subUser.id %>, '<%= (subUser.user.username || subUser.user.email).replace(/'/g, "&#39;") %>')"
                            class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2"
                            style="color:var(--theme-danger);background:var(--theme-danger-bg)"
                          >
                            <%- icon('trash-2', { class: 'w-3 h-3 mr-1' }) %>
                            Remove
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } else { %>
              <div class="p-8 text-center">
                <%- icon('users', { class: 'mx-auto h-12 w-12', style: 'color:var(--theme-text-muted)' }) %>
                <h3 class="mt-2 text-sm font-medium" style="color:var(--theme-text-strong)">No subusers</h3>
                <p class="mt-1 text-sm" style="color:var(--theme-text-muted)">Invite other users to help manage this server.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      </div><!-- /server-page-body -->
    </div>
  </div>
</main>

<!-- Add Subuser Modal -->
<div id="addSubUserModal" class="al-sheet-overlay hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="al-sheet-panel w-full max-w-lg rounded-2xl max-h-[85vh] flex flex-col" role="dialog" aria-modal="true" aria-labelledby="addSubUserTitle" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:0 20px 60px rgba(0,0,0,0.3)">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 id="addSubUserTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)">Add subuser</h3>
      <button type="button" onclick="closeModal('addSubUserModal')" aria-label="Close" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0"><%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %></button>
    </div>
    <div class="px-6 py-4 space-y-4 overflow-y-auto">
      <div>
        <label for="addSubUserEmail" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)">User email</label>
        <input id="addSubUserEmail" type="email" class="al-input w-full" placeholder="friend@example.com" autocomplete="off">
      </div>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-medium" style="color:var(--theme-text-muted)">Permissions</label>
          <div class="flex items-center gap-3 text-[11px] font-medium">
            <button type="button" class="perm-select-all inline-flex items-center gap-1.5" data-modal="addSubUserModal" style="color:var(--theme-accent)"><%- icon('check-check', { class: 'size-3', strokeWidth: 1.5 }) %>Select all</button>
            <button type="button" class="perm-select-none inline-flex items-center gap-1.5" data-modal="addSubUserModal" style="color:var(--theme-text-muted)"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>Clear</button>
          </div>
        </div>
        <div class="space-y-3 max-h-[44vh] overflow-y-auto pr-1">
          <% permGroups.forEach(group => { %>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-wider mb-1.5" style="color:var(--theme-text-muted)"><%= group.title %></p>
            <div class="space-y-1.5">
              <% group.perms.forEach(perm => { %>
              <label class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs cursor-pointer transition hover:opacity-90" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border)">
                <input type="checkbox" class="add-perm" value="<%= perm %>" <%= perm.indexOf('.') === -1 ? 'checked' : '' %>>
                <%- icon(permMeta[perm].icon, { size: 14, class: 'shrink-0' }) %>
                <span class="shrink-0 font-medium" style="color:var(--theme-text-strong)"><%= permissionLabels[perm] %></span>
                <span class="ml-auto truncate" style="color:var(--theme-text-muted)"><%= permMeta[perm].desc %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <div class="flex gap-2 px-6 py-4 border-t justify-end">
        <button type="button" onclick="closeModal('addSubUserModal')" class="al-btn-secondary flex-1 inline-flex items-center gap-1.5">
          <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>
          Cancel
        </button>
        <button type="button" id="confirmAddSubUser" class="al-btn-primary flex-1 inline-flex items-center gap-1.5">
          <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
          Add subuser
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Subuser Modal -->
<div id="editSubUserModal" class="al-sheet-overlay hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="al-sheet-panel w-full max-w-lg rounded-2xl max-h-[85vh] flex flex-col" role="dialog" aria-modal="true" aria-labelledby="editSubUserTitle" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:0 20px 60px rgba(0,0,0,0.3)">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <div>
        <h3 id="editSubUserTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)">Edit permissions</h3>
        <p id="editSubUserName" class="text-xs mt-0.5" style="color:var(--theme-text-muted)"></p>
      </div>
      <button type="button" onclick="closeModal('editSubUserModal')" aria-label="Close" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0"><%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %></button>
    </div>
    <div class="px-6 py-4 space-y-4 overflow-y-auto">
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-medium" style="color:var(--theme-text-muted)">Permissions</label>
          <div class="flex items-center gap-3 text-[11px] font-medium">
            <button type="button" class="perm-select-all inline-flex items-center gap-1.5" data-modal="editSubUserModal" style="color:var(--theme-accent)"><%- icon('check-check', { class: 'size-3', strokeWidth: 1.5 }) %>Select all</button>
            <button type="button" class="perm-select-none inline-flex items-center gap-1.5" data-modal="editSubUserModal" style="color:var(--theme-text-muted)"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>Clear</button>
          </div>
        </div>
        <div class="space-y-3 max-h-[44vh] overflow-y-auto pr-1">
          <% permGroups.forEach(group => { %>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-wider mb-1.5" style="color:var(--theme-text-muted)"><%= group.title %></p>
            <div class="space-y-1.5">
              <% group.perms.forEach(perm => { %>
              <label class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs cursor-pointer transition hover:opacity-90" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border)">
                <input type="checkbox" class="edit-perm" value="<%= perm %>">
                <%- icon(permMeta[perm].icon, { size: 14, class: 'shrink-0' }) %>
                <span class="shrink-0 font-medium" style="color:var(--theme-text-strong)"><%= permissionLabels[perm] %></span>
                <span class="ml-auto truncate" style="color:var(--theme-text-muted)"><%= permMeta[perm].desc %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <div class="flex gap-2 px-6 py-4 border-t justify-end">
        <button type="button" onclick="closeModal('editSubUserModal')" class="al-btn-secondary flex-1 inline-flex items-center gap-1.5">
          <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>
          Cancel
        </button>
        <button type="button" id="confirmEditSubUser" class="al-btn-primary flex-1 inline-flex items-center gap-1.5">
          <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %>
          Save changes
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../../components/toast') %>

<script nonce="<%- nonce %>">
const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
const serverId = '<%= server.UUID %>';
let editingSubUserId = null;

const { showToast } = typeof createToastSystem === 'function' ? createToastSystem() : { showToast: (m) => console.warn('[subusers]', m) };

function openModal(id) {
  const el = document.getElementById(id);
  if (!el) return;
  Animate.openModal(el, el.querySelector('.al-sheet-panel'));
}
function closeModal(id) {
  const el = document.getElementById(id);
  if (!el) return;
  Animate.closeModal(el, el.querySelector('.al-sheet-panel'));
}
window.closeModal = closeModal;

document.querySelectorAll('.perm-select-all, .perm-select-none').forEach(btn => {
  btn.addEventListener('click', () => {
    const modal = document.getElementById(btn.dataset.modal);
    if (!modal) return;
    const selectAll = btn.classList.contains('perm-select-all');
    modal.querySelectorAll('.add-perm, .edit-perm').forEach(cb => cb.checked = selectAll);
  });
});

window.openAddSubUserModal = () => {
  document.getElementById('addSubUserEmail').value = '';
  document.querySelectorAll('.add-perm').forEach(cb => cb.checked = true);
  openModal('addSubUserModal');
};

window.openEditSubUserModal = (id, name, permissions) => {
  editingSubUserId = id;
  document.getElementById('editSubUserName').textContent = name;
  document.querySelectorAll('.edit-perm').forEach(cb => cb.checked = permissions.includes(cb.value));
  openModal('editSubUserModal');
};

async function api(url, method, body) {
  try {
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Request failed');
    return data;
  } catch (err) {
    showToast(err.message || 'Something went wrong.', 'error');
    return null;
  }
}

document.getElementById('confirmAddSubUser')?.addEventListener('click', async () => {
  const email = document.getElementById('addSubUserEmail').value.trim();
  if (!email) { showToast('Enter the user email.', 'error'); return; }
  const permissions = [...document.querySelectorAll('.add-perm:checked')].map(cb => cb.value);
  const result = await api('/server/' + serverId + '/subusers', 'POST', { email, permissions });
  if (result) {
    showToast('Subuser added.', 'success');
    setTimeout(() => location.reload(), 900);
  }
});

document.getElementById('confirmEditSubUser')?.addEventListener('click', async () => {
  if (!editingSubUserId) return;
  const permissions = [...document.querySelectorAll('.edit-perm:checked')].map(cb => cb.value);
  const result = await api('/server/' + serverId + '/subusers/' + editingSubUserId, 'PUT', { permissions });
  if (result) {
    showToast('Permissions updated.', 'success');
    setTimeout(() => location.reload(), 900);
  }
});

window.removeSubUser = async (id, name) => {
  await new Promise(resolve => {
    window.modal.confirm({
      title: 'Remove subuser',
      body: 'Remove ' + name + ' from this server? They will lose access immediately.',
      danger: true,
      confirmLabel: 'Remove',
      onConfirm: resolve,
    });
  });
  const result = await api('/server/' + serverId + '/subusers/' + id, 'DELETE');
  if (result) {
    showToast('Subuser removed.', 'success');
    setTimeout(() => location.reload(), 900);
  }
};
</script>

<%- include('../../components/footer') %>
