                <input type="checkbox" :checked="isEditPerm('<%= perm %>')" @change="toggleEditPerm('<%= perm %>')" class="form-checkbox h-4 w-4 rounded transition" style="accent-color:var(--theme-accent)">
                <%- icon(permMeta[perm].icon, { size: 14, class: 'shrink-0' }) %>
                <span class="shrink-0 font-medium" style="color:var(--theme-text-strong)"><%= permissionLabels[perm] %></span>
                <span class="ml-auto truncate" style="color:var(--theme-text-muted)"><%= permMeta[perm].desc %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
    <div class="flex gap-2 px-6 py-4 border-t justify-end">
      <button type="button" @click="showEdit = false" class="al-btn-secondary flex-1 inline-flex items-center gap-1.5">
        <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Cancel
      </button>
      <button type="button" @click="confirmEdit()" class="al-btn-primary flex-1 inline-flex items-center gap-1.5" :disabled="saving">
        <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %><span x-text="saving ? 'Saving\u2026' : 'Save changes'">Save changes</span>
      </button>
    </div>
  </div>
</div>
</div><!-- /x-data -->

<%- include('../../components/footer') %>
