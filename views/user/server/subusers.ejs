<%- include('../../layouts/user', { title: t('subusers') }) %>

<%
  /* Permission metadata: icon + translated help line per permission.
     Keys live in storage/lang/en/lang.json (permDesc.*) so nothing
     user-facing is hardcoded here. */
  const permMeta = {
    'websocket.connect': { icon: 'radio-tower', descKey: 'permDesc.websocket.connect' },
    console: { icon: 'terminal', descKey: 'permDesc.console' },
    'console.send': { icon: 'message-square', descKey: 'permDesc.console.send' },
    'control.start': { icon: 'play', descKey: 'permDesc.control.start' },
    'control.stop': { icon: 'square', descKey: 'permDesc.control.stop' },
    'control.restart': { icon: 'rotate-ccw', descKey: 'permDesc.control.restart' },
    'control.console': { icon: 'send', descKey: 'permDesc.control.console' },
    files: { icon: 'folder', descKey: 'permDesc.files' },
    'files.read': { icon: 'file-text', descKey: 'permDesc.files.read' },
    'files.write': { icon: 'upload', descKey: 'permDesc.files.write' },
    'files.delete': { icon: 'trash-2', descKey: 'permDesc.files.delete' },
    'files.sftp': { icon: 'key-round', descKey: 'permDesc.files.sftp' },
    'files.pull': { icon: 'download', descKey: 'permDesc.files.pull' },
    'files.archive': { icon: 'archive', descKey: 'permDesc.files.archive' },
    'files.create': { icon: 'file-plus', descKey: 'permDesc.files.create' },
    'files.update': { icon: 'pencil', descKey: 'permDesc.files.update' },
    startup: { icon: 'play', descKey: 'permDesc.startup' },
    'startup.read': { icon: 'eye', descKey: 'permDesc.startup.read' },
    'startup.update': { icon: 'pencil', descKey: 'permDesc.startup.update' },
    'startup.docker-image': { icon: 'box', descKey: 'permDesc.startup.docker-image' },
    backups: { icon: 'archive', descKey: 'permDesc.backups' },
    'backups.read': { icon: 'list', descKey: 'permDesc.backups.read' },
    'backups.create': { icon: 'plus', descKey: 'permDesc.backups.create' },
    'backups.delete': { icon: 'trash-2', descKey: 'permDesc.backups.delete' },
    'backups.download': { icon: 'download', descKey: 'permDesc.backups.download' },
    'backups.restore': { icon: 'history', descKey: 'permDesc.backups.restore' },
    'backups.lock': { icon: 'lock', descKey: 'permDesc.backups.lock' },
    'database.create': { icon: 'plus', descKey: 'permDesc.database.create' },
    'database.read': { icon: 'database', descKey: 'permDesc.database.read' },
    'database.update': { icon: 'pencil', descKey: 'permDesc.database.update' },
    'database.delete': { icon: 'trash-2', descKey: 'permDesc.database.delete' },
    'database.view_password': { icon: 'key', descKey: 'permDesc.database.view_password' },
    'schedule.create': { icon: 'plus', descKey: 'permDesc.schedule.create' },
    'schedule.read': { icon: 'calendar', descKey: 'permDesc.schedule.read' },
    'schedule.update': { icon: 'pencil', descKey: 'permDesc.schedule.update' },
    'schedule.delete': { icon: 'trash-2', descKey: 'permDesc.schedule.delete' },
    'allocation.read': { icon: 'map-pin', descKey: 'permDesc.allocation.read' },
    'allocation.create': { icon: 'plus', descKey: 'permDesc.allocation.create' },
    'allocation.update': { icon: 'pencil', descKey: 'permDesc.allocation.update' },
    'allocation.delete': { icon: 'trash-2', descKey: 'permDesc.allocation.delete' },
    settings: { icon: 'settings', descKey: 'permDesc.settings' },
    'settings.update': { icon: 'pencil', descKey: 'permDesc.settings.update' },
    'settings.rename': { icon: 'tag', descKey: 'permDesc.settings.rename' },
    'settings.reinstall': { icon: 'refresh-cw', descKey: 'permDesc.settings.reinstall' },
    'activity.read': { icon: 'activity', descKey: 'permDesc.activity.read' }
  };

  function escAttr(val) {
    return String(val).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
%>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('subusers') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= server.name || t('server') %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
  <div>
    <button data-open-add-subuser type="button" class="al-btn-primary min-h-11">
      <%- icon('user-plus', { class: 'w-4 h-4', strokeWidth: 1.5 }) %> <%= t('addSubuser') %>
    </button>
  </div>
</header>

<div class="al-page-body">
  <!-- Subusers Table -->
  <% if (subUsers && subUsers.length > 0) { %>
  <div class="al-table-wrapper">
    <div class="overflow-x-auto">
      <table class="al-table al-table-card w-full sm:min-w-[640px]">
        <thead class="al-table-thead">
          <tr>
            <th scope="col" class="al-table-th"><%= t('userColumn') %></th>
            <th scope="col" class="al-table-th"><%= t('permissionsColumn') %></th>
            <th scope="col" class="al-table-th text-right"><%= t('actionsColumn') %></th>
          </tr>
        </thead>
        <tbody>
          <% subUsers.forEach(function(subUser) { %>
            <% var subName = (subUser.user && (subUser.user.username || subUser.user.email)) || t('unknown'); %>
            <tr class="al-table-tr" data-subuser-id="<%= subUser.id %>">
              <td class="al-table-td" data-label="<%= t('userColumn') %>">
                <div class="flex items-center gap-3">
                  <span class="al-avatar al-avatar-sm al-avatar-accent"><%= subName.slice(0, 1).toUpperCase() %></span>
                  <div class="min-w-0">
                    <div class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= subName %></div>
                    <div class="text-xs truncate max-w-[200px]" style="color:var(--theme-text-muted)"><%= subUser.user ? subUser.user.email : '' %></div>
                  </div>
                </div>
              </td>
              <td class="al-table-td" data-label="<%= t('permissionsColumn') %>">
                <div class="flex flex-wrap gap-1.5 max-w-xs">
                  <% var shownPerms = subUser.permissions.slice(0, 4); var hiddenCount = subUser.permissions.length - shownPerms.length; %>
                  <% shownPerms.forEach(function(perm) { %>
                    <% if (permissionLabels && permissionLabels[perm]) { %>
                    <span class="al-chip al-chip-accent"><%- icon(permMeta[perm] ? permMeta[perm].icon : 'check', { size: 12 }) %><%= permissionLabels[perm] %></span>
                    <% } %>
                  <% }); %>
                  <% if (hiddenCount > 0) { %>
                    <span class="al-chip" title="<%= subUser.permissions.map(function(p) { return (permissionLabels && permissionLabels[p]) || p; }).join(', ') %>">+<%= hiddenCount %> <%= t('moreLabel') %></span>
                  <% } %>
                  <% if (subUser.permissions.length === 0) { %>
                    <span class="text-xs italic" style="color:var(--theme-text-placeholder)"><%= t('noPermissions') %></span>
                  <% } %>
                </div>
              </td>
              <td class="al-table-td whitespace-nowrap text-right" data-label="<%= t('actionsColumn') %>">
                <div class="flex justify-end gap-2">
                  <button type="button"
                    data-edit-subuser data-subuser-id="<%= subUser.id %>" data-subuser-name="<%= escAttr(subName) %>" data-subuser-perms='<%- JSON.stringify(subUser.permissions) %>'
                    class="al-btn-secondary al-btn-sm min-h-11">
                    <%- icon('settings', { class: 'w-3.5 h-3.5' }) %><%= t('editBtnLabel') %>
                  </button>
                  <button type="button"
                    data-remove-subuser data-subuser-id="<%= subUser.id %>" data-subuser-name="<%= escAttr(subName) %>"
                    class="al-btn-danger al-btn-sm min-h-11">
                    <%- icon('trash-2', { class: 'w-3.5 h-3.5' }) %><%= t('remove') %>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <% } else { %>
    <%- include('../../partials/empty-state', {
      iconName: 'user-plus',
      title: t('noSubusers'),
      description: t('grantAccessDesc')
    }) %>
  <% } %>
</div>

<script nonce="<%- nonce %>">
    var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
(function () {
  var serverId = '<%= server.UUID %>';
  var T = <%- JSON.stringify({
    enterUserEmail: t('enterUserEmail'),
    subuserAdded: t('subuserAdded'),
    subuserRemoved: t('subuserRemoved'),
    permissionsUpdated: t('permissionsUpdated'),
    failedAddSubuser: t('failedAddSubuser'),
    failedRemoveSubuser: t('failedRemoveSubuser'),
    failedUpdatePermissions: t('failedUpdatePermissions'),
    requestFailed: t('requestFailed'),
    removeSubuserTitle: t('removeSubuserTitle'),
    removeSubuserBody: t('removeSubuserBody'),
    remove: t('remove')
  }) %>;

  var addModal = document.getElementById('addSubuserModal');
  var editModal = document.getElementById('editSubuserModal');
  var editId = null;

  function openModal(modal) { if (modal) modal.style.display = 'flex'; }
  function closeModal(modal) { if (modal) modal.style.display = 'none'; }
  function closeAdd() { closeModal(addModal); }
  function closeEdit() { closeModal(editModal); }

  function permInput(modal, perm) {
    var label = modal.querySelector('label[data-perm="' + perm + '"]');
    return label ? label.querySelector('input[type="checkbox"]') : null;
  }

  function setPerm(modal, perm, on) {
    var input = permInput(modal, perm);
    if (input) input.checked = on;
  }

  function setAll(modal, on) {
    modal.querySelectorAll('label[data-perm] input[type="checkbox"]').forEach(function (input) {
      input.checked = on;
    });
  }

  function checkedPerms(modal) {
    var perms = [];
    modal.querySelectorAll('label[data-perm]').forEach(function (label) {
      var input = label.querySelector('input[type="checkbox"]');
      if (input && input.checked) perms.push(label.getAttribute('data-perm'));
    });
    return perms;
  }

  /* Parent perms (no dot) toggle their children; unchecking the last child
     unchecks the parent — mirrors subUserHasPermission in serverAuthUtil. */
  function wireCascade(modal) {
    if (!modal) return;
    modal.querySelectorAll('label[data-perm]').forEach(function (label) {
      var perm = label.getAttribute('data-perm');
      var input = label.querySelector('input[type="checkbox"]');
      if (!input) return;
      input.addEventListener('change', function () {
        if (perm.indexOf('.') === -1) {
          modal.querySelectorAll('label[data-perm^="' + perm + '."]').forEach(function (child) {
            var ci = child.querySelector('input[type="checkbox"]');
            if (ci) ci.checked = input.checked;
          });
          return;
        }
        var parent = perm.split('.')[0];
        if (input.checked) {
          setPerm(modal, parent, true);
          return;
        }
        var anyChild = false;
        modal.querySelectorAll('label[data-perm^="' + parent + '."]').forEach(function (child) {
          var ci = child.querySelector('input[type="checkbox"]');
          if (ci && ci.checked) anyChild = true;
        });
        if (!anyChild) setPerm(modal, parent, false);
      });
    });
  }

  wireCascade(addModal);
  wireCascade(editModal);

  document.querySelectorAll('[data-open-add-subuser]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var email = document.getElementById('addSubUserEmail');
      if (email) email.value = '';
      setAll(addModal, false);
      openModal(addModal);
    });
  });

  document.querySelectorAll('[data-edit-subuser]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var nameEl = document.getElementById('editSubuserName');
      if (nameEl) nameEl.textContent = btn.getAttribute('data-subuser-name') || '';
      var perms = [];
      try { perms = JSON.parse(btn.getAttribute('data-subuser-perms') || '[]'); } catch (e) { perms = []; }
      setAll(editModal, false);
      perms.forEach(function (p) { setPerm(editModal, p, true); });
      editId = btn.getAttribute('data-subuser-id') || '';
      openModal(editModal);
    });
  });

  document.querySelectorAll('[data-remove-subuser]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-subuser-id');
      var name = btn.getAttribute('data-subuser-name') || '';
      window.modal.confirm({
        title: T.removeSubuserTitle,
        body: T.removeSubuserBody.replace('{{name}}', name),
        danger: true,
        confirmLabel: T.remove,
        onConfirm: function () {
          fetch('/server/' + serverId + '/subusers/' + id + '/delete', {
            method: 'POST',
            headers: { 'x-csrf-token': csrfToken },
          })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (d.success !== false) { showToast(T.subuserRemoved, 'success'); window.location.reload(); }
              else showToast(d.error || T.failedRemoveSubuser, 'error');
            })
            .catch(function () { showToast(T.requestFailed, 'error'); });
        },
      });
    });
  });

  document.querySelectorAll('[data-select-all-add]').forEach(function (btn) {
    btn.addEventListener('click', function () { setAll(addModal, true); });
  });
  document.querySelectorAll('[data-clear-add]').forEach(function (btn) {
    btn.addEventListener('click', function () { setAll(addModal, false); });
  });
  document.querySelectorAll('[data-select-all-edit]').forEach(function (btn) {
    btn.addEventListener('click', function () { setAll(editModal, true); });
  });
  document.querySelectorAll('[data-clear-edit]').forEach(function (btn) {
    btn.addEventListener('click', function () { setAll(editModal, false); });
  });
  document.querySelectorAll('[data-close-add]').forEach(function (el) {
    el.addEventListener('click', closeAdd);
  });
  document.querySelectorAll('[data-close-edit]').forEach(function (el) {
    el.addEventListener('click', closeEdit);
  });

  var addConfirm = document.getElementById('addSubuserConfirmBtn');
  if (addConfirm) {
    addConfirm.addEventListener('click', function () {
      var emailEl = document.getElementById('addSubUserEmail');
      var email = emailEl ? emailEl.value.trim() : '';
      if (!email) { showToast(T.enterUserEmail, 'error'); return; }
      addConfirm.disabled = true;
      fetch('/server/' + serverId + '/subusers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ email: email, permissions: checkedPerms(addModal) }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.success !== false) { showToast(T.subuserAdded, 'success'); window.location.reload(); }
          else showToast(d.error || T.failedAddSubuser, 'error');
        })
        .catch(function () { showToast(T.requestFailed, 'error'); })
        .finally(function () { addConfirm.disabled = false; });
    });
  }

  var editConfirm = document.getElementById('editSubuserConfirmBtn');
  if (editConfirm) {
    editConfirm.addEventListener('click', function () {
      if (!editId) return;
      editConfirm.disabled = true;
      fetch('/server/' + serverId + '/subusers/' + editId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ permissions: checkedPerms(editModal) }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.success !== false) { showToast(T.permissionsUpdated, 'success'); window.location.reload(); }
          else showToast(d.error || T.failedUpdatePermissions, 'error');
        })
        .catch(function () { showToast(T.requestFailed, 'error'); })
        .finally(function () { editConfirm.disabled = false; });
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeAdd(); closeEdit(); }
  });
})();
</script>
<!-- Add Subuser Modal -->
<div id="addSubuserModal" class="al-sheet-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="addSubUserTitle">
  <div class="al-sheet-panel w-full sm:max-w-2xl flex flex-col rounded-2xl shadow-xl" style="background:var(--theme-bg-card);">
    <div class="al-sheet-header">
      <div class="min-w-0">
        <h3 id="addSubUserTitle" class="al-card-title"><%= t('addSubuserTitle') %></h3>
      </div>
      <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" data-close-add aria-label="<%= t('close') %>"><%- icon('x', { class: 'w-5 h-5' }) %></button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <div class="al-form-field">
        <label for="addSubUserEmail" class="al-form-label"><%= t('userEmailLabel') %></label>
        <input id="addSubUserEmail" type="email" class="al-form-input" placeholder="friend@example.com" autocomplete="off">
      </div>
      <div class="mt-4">
        <div class="flex items-center justify-between mb-2">
          <span class="al-form-label mb-0"><%= t('permissionsLabel') %></span>
          <div class="flex items-center gap-2">
            <button type="button" data-select-all-add class="al-btn-ghost al-btn-sm min-h-11"><%- icon('check-check', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %><%= t('selectAll') %></button>
            <button type="button" data-clear-add class="al-btn-ghost al-btn-sm min-h-11"><%- icon('x', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %><%= t('clearAll') %></button>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <% permissionGroups.forEach(function(group) { %>
          <div class="al-panel">
            <p class="al-section-label"><%= group.title %></p>
            <div class="flex flex-col gap-1">
              <% group.perms.forEach(function(perm) { %>
              <label class="al-form-check cursor-pointer" data-perm="<%= perm %>">
                <input type="checkbox" class="al-form-checkbox">
                <%- icon(permMeta[perm] ? permMeta[perm].icon : 'check', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
                <span class="al-form-check-label font-medium"><%= permissionLabels ? permissionLabels[perm] : perm %></span>
                <span class="ml-auto truncate text-xs" style="color:var(--theme-text-muted)"><%= permMeta[perm] ? t(permMeta[perm].descKey) : '' %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
    <div class="al-sheet-footer justify-end">
      <button type="button" data-close-add class="al-btn-secondary al-btn-sm min-h-11"><%= t('cancel') %></button>
      <button type="button" id="addSubuserConfirmBtn" class="al-btn-primary al-btn-sm min-h-11">
        <%- icon('plus', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %><span><%= t('addSubuserBtnLabel') %></span>
      </button>
    </div>
  </div>
</div>

<!-- Edit Subuser Modal -->
<div id="editSubuserModal" class="al-sheet-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="editSubUserTitle">
  <div class="al-sheet-panel w-full sm:max-w-2xl flex flex-col rounded-2xl shadow-xl" style="background:var(--theme-bg-card);">
    <div class="al-sheet-header">
      <div class="min-w-0">
        <h3 id="editSubUserTitle" class="al-card-title"><%= t('editPermissions') %></h3>
        <p id="editSubuserName" class="al-card-subtitle"></p>
      </div>
      <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" data-close-edit aria-label="<%= t('close') %>"><%- icon('x', { class: 'w-5 h-5' }) %></button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <div class="flex items-center justify-between mb-2">
        <span class="al-form-label mb-0"><%= t('permissionsLabel') %></span>
        <div class="flex items-center gap-2">
          <button type="button" data-select-all-edit class="al-btn-ghost al-btn-sm min-h-11"><%- icon('check-check', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %><%= t('selectAll') %></button>
          <button type="button" data-clear-edit class="al-btn-ghost al-btn-sm min-h-11"><%- icon('x', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %><%= t('clearAll') %></button>
        </div>
      </div>
      <div class="flex flex-col gap-3">
        <% permissionGroups.forEach(function(group) { %>
        <div class="al-panel">
          <p class="al-section-label"><%= group.title %></p>
          <div class="flex flex-col gap-1">
            <% group.perms.forEach(function(perm) { %>
            <label class="al-form-check cursor-pointer" data-perm="<%= perm %>">
              <input type="checkbox" class="al-form-checkbox">
              <%- icon(permMeta[perm] ? permMeta[perm].icon : 'check', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
              <span class="al-form-check-label font-medium"><%= permissionLabels ? permissionLabels[perm] : perm %></span>
              <span class="ml-auto truncate text-xs" style="color:var(--theme-text-muted)"><%= permMeta[perm] ? t(permMeta[perm].descKey) : '' %></span>
            </label>
            <% }); %>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <div class="al-sheet-footer justify-end">
      <button type="button" data-close-edit class="al-btn-secondary al-btn-sm min-h-11"><%= t('cancel') %></button>
      <button type="button" id="editSubuserConfirmBtn" class="al-btn-primary al-btn-sm min-h-11">
        <%- icon('save', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %><span><%= t('saveChanges') %></span>
      </button>
    </div>
  </div>
</div>
