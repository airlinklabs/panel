<%- include('../../layouts/user', { title: (server.name || t('server')) + ' — ' + (file.name || t('files')) }) %>

<%
const fileExtension = (file.extension || '').toString().toLowerCase();
const languageMap = {
  js: 'javascript', mjs: 'javascript', cjs: 'javascript', jsx: 'javascript',
  json: 'json', html: 'html', htm: 'html', css: 'css',
  ts: 'typescript', tsx: 'typescript', md: 'markdown', markdown: 'markdown',
  txt: 'plaintext', py: 'python', sh: 'shell', bash: 'shell', zsh: 'shell',
  go: 'go', php: 'php', sql: 'sql', c: 'c', h: 'c', cpp: 'cpp',
  cs: 'csharp', java: 'java', rb: 'ruby', rs: 'rust', yml: 'yaml',
  yaml: 'yaml', xml: 'xml', toml: 'ini', ini: 'ini', cfg: 'ini',
  conf: 'ini', properties: 'ini', env: 'plaintext', dockerfile: 'dockerfile',
  gradle: 'groovy', kt: 'kotlin', swift: 'swift', lua: 'lua', r: 'r',
  dart: 'dart', ex: 'elixir', exs: 'elixir', hs: 'haskell', scala: 'scala',
  vue: 'html', svelte: 'html',
};
const language = languageMap[fileExtension] || 'plaintext';
const _initContent = file.content || '';
const fileContentTooLarge = _initContent.length > 1048576;
const fileContentInvalidUtf8 = /[\uFFFD]/.test(_initContent);
const fileContentSkipped = fileContentTooLarge || fileContentInvalidUtf8;
const filePath = file.path || '';
const serverUUID = server.UUID;
%>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name, url: '/server/' + serverUUID },
    { label: t('files'), url: '/server/' + serverUUID + '/files' },
    { label: file.name }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title break-all"><%= file.name %></h1>
    <p class="al-page-desc break-all"><%= t('editingFileIn', { path: filePath }) %></p>
  </div>
  <div>
    <a class="al-btn-secondary al-btn-sm min-h-11" href="/server/<%= serverUUID %>/files">
      <%- icon('arrow-left', { class: 'size-4', strokeWidth: 2 }) %>
      <%= t('backToFiles') %>
    </a>
    <% if (file.type !== 'directory') { %>
      <a class="al-btn-primary al-btn-sm min-h-11" href="/server/<%= serverUUID %>/files/download<%= filePath.split('/').map(encodeURIComponent).join('/') %>">
        <%- icon('download', { class: 'size-4', strokeWidth: 2 }) %>
        <%= t('download') %>
      </a>
    <% } %>
  </div>
</header>

<div class="al-page-body">
  <div id="file-editor-root" data-config="<%- JSON.stringify({
    serverUUID: serverUUID,
    filePath: filePath,
    language: language,
    content: fileContentSkipped ? '' : (file.content || ''),
    tooLarge: fileContentTooLarge,
    invalidUtf8: fileContentInvalidUtf8,
    skipped: fileContentSkipped,
    fileExtension: fileExtension,
    saveUrl: '/server/' + serverUUID + '/files/' + encodeURIComponent(filePath),
  }).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') %>">

    <div class="al-card">
      <div class="al-editor-toolbar flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
        <h2 class="al-editor-path text-sm font-medium min-w-0 al-text-strong">
          <a class="hover:text-[var(--theme-text-strong)] transition al-text-muted" href="/server/<%= serverUUID %>/files">/home/container/</a>
          <%
            if (filePath) {
              const parts = filePath.split('/');
              let curBuild = '';
              parts.forEach(function(part, index) {
                curBuild += part;
                if (index < parts.length - 1) { %>
                  <a href="/server/<%= serverUUID %>/files?path=<%= curBuild %>" class="hover:text-[var(--theme-text-strong)] transition al-text-muted"><%= part %></a><span class="al-text-muted">/</span>
                <% curBuild += '/';
                } else { %>
                  <span class="al-text-strong"><%= part %></span>
                <% }
              });
            }
          %>
        </h2>
        <div class="flex shrink-0">
          <button id="saveBtn" class="al-btn-primary al-btn-sm min-w-24 min-h-11" type="button">
            <%- icon('save', { class: 'size-4', strokeWidth: 2 }) %>
            <%= t('saveBtn') %>
          </button>
        </div>
      </div>
      <div class="al-editor-frame" id="editor-container-wrapper">
        <div class="al-editor-shell" id="editor-container"></div>
        <div class="al-editor-status flex flex-col xl:flex-row xl:justify-between xl:items-center px-3 py-2 border-t text-xs font-mono overflow-x-auto" style="background:var(--theme-bg-secondary);border-top-color:var(--theme-border);color:var(--theme-text-muted);">
          <div class="flex items-center gap-3 whitespace-nowrap">
            <div id="editor-status"><%= t('editorLineColumnInit') %></div>
            <div id="file-info" class="al-editor-stat"><%= t('loadingEllipsis') %></div>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center">
              <span class="opacity-75 mr-1.5"><%= t('wordWrap') %>:</span>
              <button type="button" id="toggle-wordwrap"><%= t('offLabel') %></button>
            </div>
            <div class="flex items-center">
              <span class="opacity-75 mr-1.5"><%= t('minimap') %>:</span>
              <button type="button" id="toggle-minimap"><%= t('offLabel') %></button>
            </div>
            <div class="flex items-center">
              <span class="opacity-75 mr-1.5"><%= t('theme') %>:</span>
              <button type="button" id="toggle-theme"><%= t('autoLabel') %></button>
            </div>
            <div class="flex items-center">
              <span class="opacity-75 mr-1.5"><%= t('saveBtn') %>:</span>
              <span data-kbd><%= t('ctrlS') %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>" src="<%= assetUrl('/monaco/vs/loader.js') %>"></script>
<script type="application/json" id="editor-file-data"><%- JSON.stringify({ content: file.content || '', tooLarge: fileContentTooLarge, invalidUtf8: fileContentInvalidUtf8 }).replace(/<\//g, '<\\/').replace(/&/g, '&amp;').replace(/"/g, '&quot;') %></script>
<script type="module" nonce="<%- nonce %>">
  import { mount } from '<%= assetUrl('/javascript/islands/file-editor.js') %>';
  const root = document.getElementById('file-editor-root');
  if (root) {
    const { teardown } = await mount(root, JSON.parse(root.dataset.config));
    window.addEventListener('beforeunload', () => {
      if (teardown) teardown();
    }, { once: true });
  }
</script>

<%- include('../../layouts/user-footer') %>
