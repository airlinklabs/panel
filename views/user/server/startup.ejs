<%- include('../../components/header', { title: 'Startup' }) %>

<main class="h-screen m-auto text-neutral-800 dark:text-white">
  <div class="flex h-full">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>

    <!-- Main Content -->
    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-16 pb-12 lg:pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Dashboard', href: '/' },
        { label: server.name, href: '/server/' + server.UUID },
        { label: 'Startup' }
      ] }) %>
      <!-- Page Header: title + meta left -->
      <div class="px-4 sm:px-8 pt-4 pb-2 sm:pb-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <!-- Server meta: image · node · id -->
            <%- include('../../components/serverMeta') %>
          </div>
        </div>
      </div>

      <%- include('../../components/installHeader') %>

      <!-- Server Template -->
      <%- include('../../components/serverTemplate') %>

      <div id="server-page-body">

      <!-- Startup Configuration -->
      <div class="px-4 sm:px-8 mt-8">
          <div class="al-card overflow-hidden mb-6">
            <div class="p-5 border-b flex justify-between items-center" style="border-color:var(--theme-border)">
              <div>
                <h2 class="text-lg font-semibold" style="color:var(--theme-text-strong)"><%= req.translations.startupCommand || 'Startup Command' %></h2>
                <p class="text-sm" style="color:var(--theme-text-muted)"><%= req.translations.startupCommandDesc || 'Customize the command used to start your server.' %></p>
              </div>
              <%
                let isStartupEditAllowed = false;
                try {
                  isStartupEditAllowed = server.allowStartupEdit === true;
                } catch (e) {
                  isStartupEditAllowed = false;
                }
                if (!isStartupEditAllowed) {
              %>
                <div class="flex items-center">
                  <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-danger-bg);color:var(--theme-danger);--tw-ring-color:color-mix(in srgb, var(--theme-danger) 25%, transparent);">
                    <%- icon('circle-x', { class: 'mr-1.5 h-3 w-3', style: 'color:var(--theme-danger)', strokeWidth: 2 }) %>
                    Editing Disabled
                  </span>
                </div>
              <% } else { %>
                <div class="flex items-center">
                  <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-success-bg);color:var(--theme-success);--tw-ring-color:color-mix(in srgb, var(--theme-success) 25%, transparent);">
                    <%- icon('circle-check', { class: 'mr-1.5 h-3 w-3', style: 'color:var(--theme-success)', strokeWidth: 2 }) %>
                    Editing Enabled
                  </span>
                </div>
              <% } %>
            </div>

            <form id="startupForm" novalidate>
              <%- include('../../components/csrf') %>
              <div class="p-5">
                <div class="mb-4">
                  <label for="startCommand" class="block text-sm font-medium mb-2" style="color:var(--theme-text-muted)"><%= req.translations.startupCommand || 'Startup Command' %></label>
                  <textarea id="startCommand" name="startCommand" rows="3" class="al-input <%= !isStartupEditAllowed ? 'opacity-50 cursor-not-allowed' : '' %>" <%= !isStartupEditAllowed ? 'readonly' : '' %> aria-label="<%= req.translations.startupCommand || 'Startup Command' %>"><%= server.StartCommand %></textarea>
                  <% if (!isStartupEditAllowed) { %>
                    <p class="mt-2 text-xs" style="color:var(--theme-danger);"><%= req.translations.startupCommandDisabled || 'Startup command editing is disabled for this server. Contact an administrator to enable this feature.' %></p>
                  <% } else { %>
                    <p class="mt-2 text-xs" style="color:var(--theme-text-muted)"><%= req.translations.startupCommandHint || 'Use $ALVKT(VARIABLE_NAME) to reference environment variables.' %></p>
                  <% } %>
                </div>
              </div>

              <div class="px-5 py-4 border-t" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
                <button type="submit" class="al-btn-primary rounded-xl px-6 py-2.5 text-center text-sm font-semibold shadow-sm <%= !isStartupEditAllowed ? 'opacity-50 cursor-not-allowed' : '' %>" <%= !isStartupEditAllowed ? 'disabled' : '' %>><%= req.translations.saveCommand || 'Save Command' %></button>
              </div>
            </form>
          </div>

          <!-- Docker Image Selection -->
          <div class="al-card overflow-hidden">
            <div class="p-5 border-b flex justify-between items-center" style="border-color:var(--theme-border)">
              <div>
                <h3 class="text-lg font-semibold" style="color:var(--theme-text-strong)"><%= req.translations.dockerImageLabel || 'Docker Image' %></h3>
                <p class="text-sm" style="color:var(--theme-text-muted)"><%= req.translations.dockerImageDesc || 'Change the Docker image used by your server.' %></p>
              </div>
              <div class="flex items-center">
                <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-info-bg);color:var(--theme-info);--tw-ring-color:color-mix(in srgb, var(--theme-info) 25%, transparent);">
                  <%- icon('info', { class: 'mr-1.5 h-3 w-3', style: 'color:var(--theme-info)', strokeWidth: 2 }) %>
                  Requires Restart
                </span>
              </div>
            </div>

            <form id="dockerImageForm" novalidate>
              <%- include('../../components/csrf') %>
              <div class="p-5">
                <div class="mb-4">
                  <label for="dockerImage" class="block text-sm font-medium mb-2" style="color:var(--theme-text-muted)"><%= req.translations.dockerImageLabel || 'Docker Image' %></label>
                  <%
                    let currentDockerImage = '';
                    try {
                      const dockerImageObj = JSON.parse(server.dockerImage);
                      currentDockerImage = Object.keys(dockerImageObj)[0];
                    } catch (e) {
                      currentDockerImage = '';
                    }

                    let availableDockerImages = [];
                    try {
                      if (server.image && server.image.dockerImages) {
                        const dockerImagesArray = JSON.parse(server.image.dockerImages);
                        dockerImagesArray.forEach(imageObj => {
                          Object.keys(imageObj).forEach(key => {
                            availableDockerImages.push(key);
                          });
                        });
                      }
                    } catch (e) {
                      availableDockerImages = [];
                    }
                  %>

                  <div class="relative">
                    <select id="dockerImage" name="dockerImage" class="cs-native">
                      <% if (availableDockerImages.length > 0) { %>
                        <% availableDockerImages.forEach(image => { %>
                          <option value="<%= image %>" <%= image === currentDockerImage ? 'selected' : '' %>><%= image %></option>
                        <% }); %>
                      <% } else { %>
                        <option value="" disabled selected><%= req.translations.noDockerImages || 'No Docker images available' %></option>
                      <% } %>
                    </select>
                    <div class="custom-select" data-for="dockerImage"></div>
                  </div>
                  <p class="mt-2 text-xs" style="color:var(--theme-text-muted)"><%= req.translations.dockerImageHint || "Changing the Docker image will restart your server if it's currently running." %></p>
                </div>
              </div>

              <div class="px-5 py-4 border-t" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
                <button type="submit" class="al-btn-primary rounded-xl px-6 py-2.5 text-center text-sm font-semibold shadow-sm"><%= req.translations.updateDockerImage || 'Update Docker Image' %></button>
              </div>
            </form>
          </div>

        <!-- Server Variables -->
        <div class="al-card p-6 shadow-lg mt-8">
          <h2 class="text-lg font-semibold mb-4" style="color:var(--theme-text-strong)"><%= req.translations.serverVariables || 'Server Variables' %></h2>
          <p class="text-sm mb-4" style="color:var(--theme-text-muted)"><%= req.translations.serverVariablesDesc || 'Configure environment variables for your server.' %></p>

          <form id="variablesForm" novalidate>
            <%- include('../../components/csrf') %>
            <div id="variablesContainer" class="space-y-4">
              <% if (serverVariables && serverVariables.length > 0) { %>
                <% serverVariables.forEach((variable, index) => { %>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4 rounded-lg border" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
                    <div>
                      <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-muted)" for="var_<%= variable.env %>"><%= variable.name %></label>
                      <p class="text-xs" style="color:var(--theme-text-muted)">Environment: <%= variable.env %></p>
                    </div>
                    <div class="md:col-span-2">
                      <% if (variable.type === 'boolean') { %>
                        <label class="relative inline-flex items-center cursor-pointer" for="toggle_<%= variable.env %>">
                          <input type="checkbox" name="var_<%= variable.env %>" id="toggle_<%= variable.env %>" class="sr-only peer" <%= variable.value == true || variable.value === '1' || variable.value === 1 ? 'checked' : '' %>>
                          <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
                          <span class="ms-3 text-sm font-medium" style="color:var(--theme-text-muted)" id="label_<%= variable.env %>"><%= variable.value == true || variable.value === '1' || variable.value === 1 ? 'Enabled' : 'Disabled' %></span>
                        </label>
                        <script nonce="<%- nonce %>">
                          document.getElementById('toggle_<%= variable.env %>').addEventListener('change', function() {
                            document.getElementById('label_<%= variable.env %>').textContent = this.checked ? 'Enabled' : 'Disabled';
                          });
                        </script>
                      <% } else if (variable.type === 'number') { %>
                        <input type="number" name="var_<%= variable.env %>" id="var_<%= variable.env %>" value="<%= variable.value %>" class="al-input" aria-label="<%= variable.name %>">
                      <% } else { %>
                        <input type="text" name="var_<%= variable.env %>" id="var_<%= variable.env %>" value="<%= variable.value %>" class="al-input" aria-label="<%= variable.name %>">
                      <% } %>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <p style="color:var(--theme-text-muted)"><%= req.translations.noVariables || 'No variables available for this server.' %></p>
              <% } %>
            </div>

            <div class="mt-6">
              <button type="submit" class="al-btn-primary"><%= req.translations.saveVariables || 'Save Variables' %></button>
            </div>
          </form>
        </div>
      </div>
    </div>

      </div><!-- /server-page-body -->

      </div>
</main>


<%- include('../../components/footer') %>

<script nonce="<%- nonce %>">
  window.ALMount(function() {
    const startupForm = document.getElementById('startupForm');
    const dockerImageForm = document.getElementById('dockerImageForm');
    const variablesForm = document.getElementById('variablesForm');

    startupForm.addEventListener('submit', function(e) {
      e.preventDefault();

      const submitButton = startupForm.querySelector('button[type="submit"]');
      const originalButtonText = submitButton.textContent;
      submitButton.textContent = 'Saving...';
      submitButton.disabled = true;

      // Prepare form data
      const formData = new FormData(startupForm);

      // Submit via fetch (CSRF token will be added automatically by csrf.js)
      fetch('/server/<%= server.UUID %>/startup/command', {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || ''
        },
        body: formData
      })
      .then(response => {
        if (response.ok) {
          return response.json().catch(() => ({ success: true }));
        } else {
          return response.json().then(data => Promise.reject(data));
        }
      })
      .then(data => {
        submitButton.textContent = originalButtonText;
        submitButton.disabled = false;

        if (data.success !== false) {
          showToast('Startup command saved successfully!', 'success');
        } else {
          showToast(data.error || 'Failed to save startup command', 'error');
        }
      })
      .catch(error => {
        submitButton.textContent = originalButtonText;
        submitButton.disabled = false;
        showToast(error.message || error.error || 'Failed to save startup command', 'error');
      });
    });

    dockerImageForm.addEventListener('submit', function(e) {
      e.preventDefault();

      const submitButton = dockerImageForm.querySelector('button[type="submit"]');
      const originalButtonText = submitButton.textContent;
      submitButton.textContent = 'Updating...';
      submitButton.disabled = true;

      // Prepare form data
      const formData = new FormData(dockerImageForm);

      // Submit via fetch (CSRF token will be added automatically by csrf.js)
      fetch('/server/<%= server.UUID %>/startup/docker-image', {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || ''
        },
        body: formData
      })
      .then(response => {
        if (response.ok) {
          return response.json().catch(() => ({ success: true }));
        } else {
          return response.json().then(data => Promise.reject(data));
        }
      })
      .then(data => {
        submitButton.textContent = originalButtonText;
        submitButton.disabled = false;

        if (data.success !== false) {
          showToast('Docker image updated successfully! Server will be restarted if it was running.', 'success');
        } else {
          showToast(data.error || 'Failed to update Docker image', 'error');
        }
      })
      .catch(error => {
        submitButton.textContent = originalButtonText;
        submitButton.disabled = false;
        showToast(error.message || error.error || 'Failed to update Docker image', 'error');
      });
    });

    variablesForm.addEventListener('submit', function(e) {
      e.preventDefault();

      const submitButton = variablesForm.querySelector('button[type="submit"]');
      const originalButtonText = submitButton.textContent;
      submitButton.textContent = 'Saving...';
      submitButton.disabled = true;

      // Prepare form data as URL-encoded
      const formData = new FormData(variablesForm);
      const urlEncodedData = new URLSearchParams();

      // Convert FormData to URLSearchParams
      for (let [key, value] of formData.entries()) {
        urlEncodedData.append(key, value);
      }

      // Submit via fetch (CSRF token will be added automatically by csrf.js)
      fetch('/server/<%= server.UUID %>/startup/variables', {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/x-www-form-urlencoded',
          'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || ''
        },
        body: urlEncodedData
      })
      .then(response => {
        if (response.ok) {
          return response.json().catch(() => ({ success: true }));
        } else {
          return response.json().then(data => Promise.reject(data));
        }
      })
      .then(data => {
        submitButton.textContent = originalButtonText;
        submitButton.disabled = false;

        if (data.success !== false) {
          showToast('Variables saved successfully!', 'success');
        } else {
          showToast(data.error || 'Failed to save variables', 'error');
        }
      })
      .catch(error => {
        submitButton.textContent = originalButtonText;
        submitButton.disabled = false;
        showToast(error.message || error.error || 'Failed to save variables', 'error');
      });
    });
  });
</script>
