<%- include('../../layouts/user', { title: t('startup') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('startup') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= server.name %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
</header>

<div class="al-page-body">
  <% if (server.Suspended) { %>
  <div class="al-alert-warning mb-4" role="alert">
    <%- icon('triangle-alert', { class: 'size-4 shrink-0 mt-0.5', 'aria-hidden': 'true' }) %>
    <div class="min-w-0">
      <p class="al-alert-title"><%= t('serverSuspended') %></p>
      <p class="al-alert-body"><%= t('serverSuspendedDesc') %></p>
    </div>
  </div>
  <% } %>

  <!-- Startup Command -->
  <div class="al-form-card mb-4">
    <div class="al-card-header">
      <div class="min-w-0">
        <h2 class="al-card-title"><%= t('startupCommand') %></h2>
        <p class="al-card-subtitle"><%= t('startupCommandDesc') %></p>
      </div>
      <div class="al-card-header-actions">
        <% if (!server.allowStartupEdit) { %>
        <span class="al-badge al-badge-offline">
          <%- icon('circle-x', { class: 'size-3', strokeWidth: 2 }) %>
          <%= t('editingDisabled') %>
        </span>
        <% } else { %>
        <span class="al-badge al-badge-online">
          <%- icon('circle-check', { class: 'size-3', strokeWidth: 2 }) %>
          <%= t('editingEnabled') %>
        </span>
        <% } %>
      </div>
    </div>
    <form id="startupCommandForm">
      <%- include('../../partials/csrf') %>
      <div class="al-card-body">
        <%- include('../../partials/ui/form-field', {
          type: 'textarea', name: 'startCommand', id: 'startCommand',
          label: t('startupCommand'), value: server.StartCommand,
          readonly: !server.allowStartupEdit,
          helpText: server.allowStartupEdit ? t('startupCommandHint') : t('startupCommandDisabled'),
          cls: server.allowStartupEdit ? '' : 'opacity-50 cursor-not-allowed'
        }) %>
      </div>
      <div class="al-card-footer">
        <button type="submit" id="startupCommandSubmit" class="al-btn-primary <%= !server.allowStartupEdit ? 'opacity-50 cursor-not-allowed' : '' %> min-h-11" <%= !server.allowStartupEdit ? 'disabled' : '' %>>
          <span id="cmdSaveLabel"><%= t('saveCommand') %></span>
          <span id="cmdSavingLabel" style="display:none"><%= t('saving') %></span>
        </button>
        <span id="cmdSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
      </div>
    </form>
  </div>

  <!-- Docker Image -->
  <div class="al-form-card mb-4">
    <div class="al-card-header">
      <div class="min-w-0">
        <h2 class="al-card-title"><%= t('dockerImageLabel') %></h2>
        <p class="al-card-subtitle"><%= t('dockerImageDesc') %></p>
      </div>
      <div class="al-card-header-actions">
        <span class="al-badge al-badge-info">
          <%- icon('info', { class: 'size-3', strokeWidth: 2 }) %>
          <%= t('requiresRestart') %>
        </span>
      </div>
    </div>
    <form id="startupDockerForm">
      <%- include('../../partials/csrf') %>
      <div class="al-card-body">
        <%
          let currentDockerImage = '';
          try {
            const dockerImageObj = JSON.parse(server.dockerImage);
            currentDockerImage = Object.keys(dockerImageObj)[0];
          } catch (e) { currentDockerImage = ''; }

          let availableDockerImages = [];
          try {
            if (server.image && server.image.dockerImages) {
              const arr = JSON.parse(server.image.dockerImages);
              arr.forEach(function(obj) { Object.keys(obj).forEach(function(k) { availableDockerImages.push(k); }); });
            }
          } catch (e) { availableDockerImages = []; }

          const dockerOptions = availableDockerImages.map(function(image) {
            return { value: image, label: image, selected: image === currentDockerImage };
          });
        %>
        <%- include('../../partials/ui/form-field', {
          type: 'select', name: 'dockerImage', id: 'dockerImage',
          label: t('dockerImageLabel'), value: currentDockerImage,
          placeholder: dockerOptions.length ? '' : t('noDockerImages'),
          options: dockerOptions,
          helpText: t('dockerImageHint'),
          cls: 'min-h-11'
        }) %>
      </div>
      <div class="al-card-footer">
        <button type="submit" id="dockerSubmit" class="al-btn-primary min-h-11">
          <span id="dockerSaveLabel"><%= t('updateDockerImage') %></span>
          <span id="dockerSavingLabel" style="display:none"><%= t('updating') %></span>
        </button>
        <span id="dockerSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
      </div>
    </form>
  </div>

  <!-- Startup Variables -->
  <div class="al-form-card">
    <div class="al-card-header">
      <div class="min-w-0">
        <h2 class="al-card-title"><%= t('serverVariables') %></h2>
        <p class="al-card-subtitle"><%= t('serverVariablesDesc') %></p>
      </div>
    </div>
    <form id="startupVariablesForm">
      <%- include('../../partials/csrf') %>
      <div class="al-card-body">
        <div id="variablesContainer" class="space-y-4">
          <% if (serverVariables && serverVariables.length > 0) { %>
            <% serverVariables.forEach(function(variable) { %>
            <div class="al-panel">
              <div class="al-panel-head">
                <div>
                  <label class="al-form-label mb-1" for="var_<%= variable.env %>"><%= variable.name %></label>
                  <p class="text-xs al-text-muted"><%= t('environmentLabel') %>: <span class="font-mono"><%= variable.env %></span></p>
                </div>
                <div class="sm:w-2/3">
                  <% if (variable.type === 'boolean') { %>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" name="var_<%= variable.env %>" id="toggle_<%= variable.env %>" class="sr-only peer" <%= variable.value == true || variable.value === '1' || variable.value === 1 ? 'checked' : '' %>>
                      <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
                      <span class="ms-3 text-sm font-medium al-text-muted" id="label_<%= variable.env %>"><%= variable.value == true || variable.value === '1' || variable.value === 1 ? t('enabled') : t('disabled') %></span>
                    </label>
                  <% } else if (variable.type === 'number') { %>
                    <input type="number" name="var_<%= variable.env %>" id="var_<%= variable.env %>" value="<%= variable.value %>" class="al-input min-h-11" aria-label="<%= variable.name %>">
                  <% } else { %>
                    <input type="text" name="var_<%= variable.env %>" id="var_<%= variable.env %>" value="<%= variable.value %>" class="al-input min-h-11" aria-label="<%= variable.name %>">
                  <% } %>
                </div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <p class="al-text-muted"><%= t('noVariables') %></p>
          <% } %>
        </div>
      </div>
      <div class="al-card-footer">
        <button type="submit" id="variablesSubmit" class="al-btn-primary min-h-11">
          <span id="varSaveLabel"><%= t('saveVariables') %></span>
          <span id="varSavingLabel" style="display:none"><%= t('saving') %></span>
        </button>
        <span id="varSaved" class="text-xs" style="color:var(--theme-success);display:none"></span>
      </div>
    </form>
  </div>
</div>

<script nonce="<%- nonce %>">
(function() {
  var serverId = '<%= server.UUID %>';
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
  var serverVariables = <%- JSON.stringify(typeof serverVariables !== 'undefined' ? serverVariables : []) %>;
  var msg = <%- JSON.stringify({
    savedPrefix: t('savedTimeAgo'),
    saved: t('startupCommandSaved'),
    saveFailed: t('failedToSaveCommand'),
    dockerSaved: t('dockerImageUpdated'),
    dockerFailed: t('failedToUpdateDocker'),
    varsSaved: t('variablesSaved'),
    varsFailed: t('failedToSaveVariables'),
    enabled: t('enabled'),
    disabled: t('disabled')
  }) %>;

  function savedSpan(el) {
    var now = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    el.textContent = msg.savedPrefix + now;
    el.style.display = '';
    setTimeout(function() { el.style.display = 'none'; }, 3000);
  }

  // Startup command
  var cmdForm = document.getElementById('startupCommandForm');
  var cmdBtn = document.getElementById('startupCommandSubmit');
  var cmdSaveLabel = document.getElementById('cmdSaveLabel');
  var cmdSavingLabel = document.getElementById('cmdSavingLabel');
  var cmdSaved = document.getElementById('cmdSaved');
  var cmdSaving = false;

  cmdForm.addEventListener('submit', function(e) {
    e.preventDefault();
    if (cmdSaving) return;
    var cmd = document.getElementById('startCommand').value.trim();
    if (!cmd) return;
    cmdSaving = true;
    cmdBtn.disabled = true;
    cmdSaveLabel.style.display = 'none';
    cmdSavingLabel.style.display = '';
    fetch('/server/' + serverId + '/startup/command', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ startCommand: document.getElementById('startCommand').value })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success !== false) { savedSpan(cmdSaved); showToast(msg.saved, 'success'); }
      else showToast(d.error || msg.saveFailed, 'error');
    }).catch(function() { showToast(msg.saveFailed, 'error'); })
    .finally(function() {
      cmdSaving = false;
      cmdBtn.disabled = false;
      cmdSaveLabel.style.display = '';
      cmdSavingLabel.style.display = 'none';
    });
  });

  // Docker image
  var dockerForm = document.getElementById('startupDockerForm');
  var dockerBtn = document.getElementById('dockerSubmit');
  var dockerSaveLabel = document.getElementById('dockerSaveLabel');
  var dockerSavingLabel = document.getElementById('dockerSavingLabel');
  var dockerSaved = document.getElementById('dockerSaved');
  var dockerSaving = false;

  dockerForm.addEventListener('submit', function(e) {
    e.preventDefault();
    if (dockerSaving) return;
    var image = document.getElementById('dockerImage').value;
    if (!image) return;
    dockerSaving = true;
    dockerBtn.disabled = true;
    dockerSaveLabel.style.display = 'none';
    dockerSavingLabel.style.display = '';
    fetch('/server/' + serverId + '/startup/docker-image', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ dockerImage: image })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success !== false) { savedSpan(dockerSaved); showToast(msg.dockerSaved, 'success'); }
      else showToast(d.error || msg.dockerFailed, 'error');
    }).catch(function() { showToast(msg.dockerFailed, 'error'); })
    .finally(function() {
      dockerSaving = false;
      dockerBtn.disabled = false;
      dockerSaveLabel.style.display = '';
      dockerSavingLabel.style.display = 'none';
    });
  });

  // Variables
  var varForm = document.getElementById('startupVariablesForm');
  var varBtn = document.getElementById('variablesSubmit');
  var varSaveLabel = document.getElementById('varSaveLabel');
  var varSavingLabel = document.getElementById('varSavingLabel');
  var varSaved = document.getElementById('varSaved');
  var varSaving = false;

  varForm.addEventListener('submit', function(e) {
    e.preventDefault();
    if (varSaving) return;
    varSaving = true;
    varBtn.disabled = true;
    varSaveLabel.style.display = 'none';
    varSavingLabel.style.display = '';
    // Rebuild the full variable objects (the image defines the shape) with
    // current form values — multipart bodies would never parse server-side.
    var variables = serverVariables.map(function(variable) {
      var input = document.getElementById('var_' + variable.env);
      var value = variable.value;
      if (input) {
        if (variable.type === 'boolean') {
          value = input.checked;
        } else if (variable.type === 'number') {
          var parsed = Number(input.value);
          value = input.value !== '' && !isNaN(parsed) ? parsed : variable.value;
        } else {
          value = input.value;
        }
      }
      return Object.assign({}, variable, { value: value });
    });
    fetch('/server/' + serverId + '/startup/variables', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ variables: variables })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success !== false) { savedSpan(varSaved); showToast(msg.varsSaved, 'success'); }
      else showToast(d.error || msg.varsFailed, 'error');
    }).catch(function() { showToast(msg.varsFailed, 'error'); })
    .finally(function() {
      varSaving = false;
      varBtn.disabled = false;
      varSaveLabel.style.display = '';
      varSavingLabel.style.display = 'none';
    });
  });

  // Toggle variable labels
  document.querySelectorAll('#variablesContainer input[type="checkbox"]').forEach(function(cb) {
    cb.addEventListener('change', function() {
      var label = document.getElementById('label_' + this.name.replace('var_', ''));
      if (label) label.textContent = this.checked ? msg.enabled : msg.disabled;
    });
  });
})();
</script>
