<% if (isMobileViewport) { %>
<%- include('../../components/header', { title: 'Startup' }) %>
<main id="page-content">
    <%- include('../../components/template') %>
    <section class="px-4 py-5">
        <header class="mb-5">
            <%- include('../../components/serverHeader', { server: server, req: req }) %>
        </header>
        <%- include('../../components/installHeader') %>
        <%- include('../../components/serverTemplate') %>
        <div class="space-y-4 mt-4">

            <!-- Startup command -->
            <div data-animate-card class="rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 overflow-hidden">
                <div class="px-4 py-3 border-b border-neutral-200 dark:border-white/5 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-neutral-800 dark:text-white">Startup Command</p>
                        <p class="text-xs text-neutral-500 mt-0.5"><%= req.translations.startupCommandDesc || 'Customize the command used to start your server.' %></p>
                    </div>
                    <%
                        var isStartupEditAllowed = false;
                        try { isStartupEditAllowed = server.allowStartupEdit === true; } catch(e) {}
                    %>
                    <% if (!isStartupEditAllowed) { %>
                    <span class="inline-flex items-center rounded-md bg-red-50 dark:bg-red-500/10 px-2 py-1 text-xs font-medium text-red-700 dark:text-red-400">Editing disabled</span>
                    <% } else { %>
                    <span class="inline-flex items-center rounded-md bg-emerald-50 dark:bg-emerald-500/10 px-2 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400">Editing enabled</span>
                    <% } %>
                </div>
                <form id="startupForm" action="/api/servers/<%= server.shortID %>/startup" method="POST" enctype="application/x-www-form-urlencoded">
                    <%- include('../../components/csrf') %>
                    <div class="p-4">
                        <textarea id="startCommand" name="startCommand" rows="3"
                            class="w-full rounded-xl text-sm px-3 py-2 font-mono bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-white/5 text-neutral-800 dark:text-white focus:outline-none focus:ring-1 focus:ring-neutral-400 <%= !isStartupEditAllowed ? 'opacity-60 cursor-not-allowed' : '' %>"
                            <%= !isStartupEditAllowed ? 'readonly' : '' %>><%= server.startup || server.StartCommand || '' %></textarea>
                        <p class="text-xs text-neutral-500 mt-2">
                            <% if (!isStartupEditAllowed) { %>
                                Contact an administrator to enable startup command editing.
                            <% } else { %>
                                Use $ALVKT(VARIABLE_NAME) to reference environment variables.
                            <% } %>
                        </p>
                    </div>
                    <div class="px-4 py-3 bg-neutral-100 dark:bg-neutral-800 border-t border-neutral-200 dark:border-white/5">
                        <button type="submit" class="rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 text-sm font-medium transition hover:opacity-90 <%= !isStartupEditAllowed ? 'opacity-50 cursor-not-allowed' : '' %>" <%= !isStartupEditAllowed ? 'disabled' : '' %>><%= req.translations.saveCommand || 'Save Command' %></button>
                    </div>
                </form>
            </div>

            <!-- Docker image -->
            <div data-animate-card class="rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 overflow-hidden">
                <div class="px-4 py-3 border-b border-neutral-200 dark:border-white/5 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-neutral-800 dark:text-white">Docker Image</p>
                        <p class="text-xs text-neutral-500 mt-0.5"><%= req.translations.dockerImageDesc || 'Change the Docker image used by your server.' %></p>
                    </div>
                    <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-500/10 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-400">Requires restart</span>
                </div>
                <form id="dockerImageForm" action="/api/servers/<%= server.shortID %>/startup" method="POST" enctype="application/x-www-form-urlencoded">
                    <%- include('../../components/csrf') %>
                    <div class="p-4">
                        <%
                            var currentDockerImage = '';
                            try { currentDockerImage = Object.keys(JSON.parse(server.dockerImage || server.image))[0]; } catch(e) {}
                            var availableDockerImages = [];
                            try {
                                var imgSource = (server.image && server.image.dockerImages) ? server.image.dockerImages : server.dockerImage;
                                if (imgSource) {
                                    JSON.parse(imgSource).forEach(function(obj) {
                                        Object.keys(obj).forEach(function(k) { availableDockerImages.push(k); });
                                    });
                                }
                            } catch(e) {}
                            var dockerImageOptions = availableDockerImages.map(function(img) { return { value: img, label: img }; });
                            if (dockerImageOptions.length === 0) { dockerImageOptions = [{ value: '', label: 'No images available' }]; }
                        %>
                        <div><div><select name="dockerImage" class="rounded-lg border border-neutral-200 dark:border-neutral-600/30 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white w-full"><% dockerImageOptions.forEach(function(opt) { %><option value="<%= opt.value %>" <%= opt.value === currentDockerImage ? 'selected' : '' %>><%= opt.label %></option><% }); %></select></div></div>
                        <p class="text-xs text-neutral-500 mt-2">Changing the image will restart your server if it is running.</p>
                    </div>
                    <div class="px-4 py-3 bg-neutral-100 dark:bg-neutral-800 border-t border-neutral-200 dark:border-white/5">
                        <button type="submit" class="rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 text-sm font-medium transition hover:opacity-90">Update Image</button>
                    </div>
                </form>
            </div>

            <!-- Server variables -->
            <div data-animate-card class="rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 overflow-hidden">
                <div class="px-4 py-3 border-b border-neutral-200 dark:border-white/5">
                    <p class="text-sm font-medium text-neutral-800 dark:text-white">Server Variables</p>
                    <p class="text-xs text-neutral-500 mt-0.5"><%= req.translations.serverVariablesDesc || 'Configure environment variables for your server.' %></p>
                </div>
                <form id="variablesForm" action="/api/servers/<%= server.shortID %>/startup" method="POST" enctype="application/x-www-form-urlencoded">
                    <%- include('../../components/csrf') %>
                    <div class="p-4 space-y-4">
                        <% if (typeof serverVariables !== 'undefined' && serverVariables && serverVariables.length > 0) { %>
                            <% serverVariables.forEach(function(variable, index) { %>
                            <div class="rounded-xl bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-white/5 p-3">
                                <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-0.5"><%= variable.name %></label>
                                <p class="text-[10px] text-neutral-500 mb-2">ENV: <span class="font-mono"><%= variable.env %></span> &middot; type: <%= variable.type %></p>
                                <% if (variable.type === 'boolean') { %>
                                    <label class="flex items-center gap-2 text-sm text-neutral-700 dark:text-neutral-300"><input type="checkbox" name="var_<%= variable.env %>" <%= (variable.value == true || variable.value === '1' || variable.value === 1) ? 'checked' : '' %> class="w-4 h-4 rounded border-neutral-300 text-neutral-900 focus:ring-neutral-500"><%= (variable.value == true || variable.value === '1' || variable.value === 1) ? 'Enabled' : 'Disabled' %></label>
                                <% } else if (variable.type === 'number') { %>
                                    <div><input type="number" name="var_<%= variable.env %>" value="<%= variable.value %>" class="rounded-lg border border-neutral-200 dark:border-neutral-600/30 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white w-full focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30"></div>
                                <% } else { %>
                                    <div><input type="text" name="var_<%= variable.env %>" value="<%= variable.value %>" class="rounded-lg border border-neutral-200 dark:border-neutral-600/30 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white w-full focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-white/30"></div>
                                <% } %>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-xs text-neutral-500"><%= req.translations.noVariables || 'No variables available for this server.' %></p>
                        <% } %>
                    </div>
                    <div class="px-4 py-3 bg-neutral-100 dark:bg-neutral-800 border-t border-neutral-200 dark:border-white/5">
                        <button type="submit" class="rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 text-sm font-medium transition hover:opacity-90"><%= req.translations.saveVariables || 'Save Variables' %></button>
                    </div>
                </form>
            </div>

        </div>
    </section>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/footer') %>

