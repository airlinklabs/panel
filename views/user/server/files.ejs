    // Get all file checkboxes (excluding the select all checkbox itself)
    const fileCheckboxes = document.querySelectorAll('.file-checkbox:not(#selectAll)');

    fileCheckboxes.forEach(checkbox => {
        checkbox.checked = isChecked;
