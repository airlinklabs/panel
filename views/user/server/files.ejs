  async function confirmFileUpload(file) {
    if (!(file instanceof File)) {
      showToast('Invalid file selected', 'error');
      return;
    }

    const fileName = file.name;
    const fileSize = file.size;

    let uploadToast = window.showProgressToast ? window.showProgressToast(`Uploading ${fileName}…`, {
      group: 'upload:<%= server.UUID %>',
      autoCompleteAt100: false,
    }) : window.showLoadingToast('Uploading File');

    window.addEventListener('beforeunload', function handleUploadUnload() {
      if (uploadToast) {
        uploadToast.close();
        uploadToast = null;
      }
      window.removeEventListener('beforeunload', handleUploadUnload);
    });

    try {
    const MAX_FILE_SIZE = 100 * 1024 * 1024;
      if (fileSize > MAX_FILE_SIZE) {
        uploadToast.close();
        uploadToast = null;
        showToast('File is too large. Maximum size is 100MB', 'error');
        return;
      }

      // Use FormData instead of JSON for more reliable file uploads
      const formData = new FormData();
      formData.append('file', file);
      formData.append('path', '<%= currentPath %>');
      formData.append('fileName', fileName);

      uploadToast.setMessage(`Uploading ${fileName}… 0%`);

      try {
        // Use XMLHttpRequest for better progress tracking and reliability
        const xhr = new XMLHttpRequest();

        xhr.open('POST', `/server/<%= server.UUID %>/upload`, true);

        xhr.upload.onprogress = function(e) {
          if (uploadToast && e.lengthComputable) {
            uploadToast.setMessage(`Uploading ${fileName}…`);
          }
        };

        xhr.onload = function() {
          if (xhr.status >= 200 && xhr.status < 300) {
            if (uploadToast) {
              uploadToast.complete(true, `File ${fileName} uploaded.`);
              uploadToast = null;
            }
            setTimeout(() => {
              refreshFileList();
            }, 500);
          } else {
            let uploadFailToast = uploadToast;
            uploadToast = null;
            try {
              const errorData = JSON.parse(xhr.responseText);
              console.error('Upload error response:', errorData);

              let errorMessage = 'Failed to upload file';
              if (errorData.error) {
                errorMessage = errorData.error;
              } else if (errorData.details && errorData.details.error) {
                errorMessage = errorData.details.error;
              }

              uploadFailToast.close();
              uploadFailToast = null;
              showToast(errorMessage, 'error');
            } catch (e) {
              console.error('Error parsing error response:', e);
              uploadFailToast.close();
              uploadFailToast = null;
              showToast(`Failed to upload file: ${xhr.status} ${xhr.statusText}`, 'error');
            }
          }
        };

        xhr.onerror = function() {
          if (uploadToast) {
            uploadToast.close();
            uploadToast = null;
          }
          console.error('XHR error during upload');
          showToast('Connection error during file upload', 'error');
        };

        xhr.ontimeout = function() {
          if (uploadToast) {
            uploadToast.close();
            uploadToast = null;
          }
          console.error('XHR timeout during upload');
          showToast('Upload timed out. Try a smaller file.', 'error');
        };

        xhr.timeout = 300000;

        xhr.send(formData);
      } catch (error) {
        if (uploadToast) {
          uploadToast.close();
          uploadToast = null;
        }
        console.error('Error uploading file:', error);
         showToast('Something went wrong.', 'error');
      }
    } catch (error) {
      if (uploadToast) {
        uploadToast.close();
        uploadToast = null;
      }
      console.error('Error uploading file:', error);
      showToast('An error occurred while uploading the file', 'error');
    }
  }


