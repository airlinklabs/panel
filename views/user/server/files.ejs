<%- include('../../layouts/user', { title: t('files') }) %>

<%
function getFileIcon(category) {
  const iconNames = {
    'Configuration Files': 'file-code',
    'Documents': 'file-text',
    'Folder': 'folder',
    'Images': 'image',
    'No Category': 'file',
  };
  const name = iconNames[category] || 'file';
  return `<span class="al-file-icon size-6">${icon(name, { class: 'size-6' })}</span>`;
}

function isImageFile(filename) {
  const imageExtensions = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'svg', 'webp', 'tiff'];
  const extension = filename.split('.').pop().toLowerCase();
  return imageExtensions.includes(extension);
}

function escAttr(val) {
  return String(val)
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}
%>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name, url: '/server/' + server.UUID },
    { label: t('files') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('files') %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="inline-flex items-center gap-1.5">
        <%- icon('box', { class: 'h-3.5 w-3.5 shrink-0' }) %>
        <span class="truncate max-w-[140px]"><%= server.image?.name %></span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <%- icon('server', { class: 'h-3.5 w-3.5 shrink-0' }) %>
        <span class="truncate max-w-[100px]"><%= server.node?.name %></span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <%- icon('hash', { class: 'h-3.5 w-3.5 shrink-0' }) %>
        <span class="font-mono"><%= server.UUID.split('-')[0] %></span>
      </span>
    </p>
  </div>
  <div>
    <button id="createFile" type="button" class="al-btn-secondary">
      <%- icon('file-plus', { class: 'size-4' }) %>
      <%= t('newFile') %>
    </button>
    <button id="createFolder" type="button" class="al-btn-secondary">
      <%- icon('folder-plus', { class: 'size-4' }) %>
      <%= t('newFolder') %>
    </button>
    <button id="uploadFile" type="button" class="al-btn-secondary">
      <%- icon('upload', { class: 'size-4' }) %>
      <%= t('uploadFile') %>
    </button>
    <button id="pullFile" type="button" class="al-btn-secondary">
      <%- icon('download', { class: 'size-4' }) %>
      <%= t('pullFromUrl') %>
    </button>
    <button id="refreshFiles" type="button" class="al-btn-secondary">
      <%- icon('refresh-cw', { class: 'size-4' }) %>
      <%= t('refresh') %>
    </button>
  </div>
</header>

<div class="al-page-body">
  <!-- File Table -->
  <div class="al-file-panel">
    <!-- Breadcrumb path -->
    <nav class="al-file-pathbar" aria-label="<%= t('files') %>">
      <a class="al-file-path" href="./files">/home/container/</a>
      <%
        const currentPath = (typeof filesCurrentPath !== 'undefined' && filesCurrentPath) ? filesCurrentPath : '';
        if (currentPath) {
          const parts = currentPath.split('/').filter(Boolean);
          let buildPath = '';
          parts.forEach((part, index) => {
            buildPath += part;
            if (index < parts.length - 1) { %>
              <a href="./files?path=<%= buildPath %>" class="al-file-path"><%= part %></a><span class="al-file-path-sep">/</span>
            <% buildPath += '/';
            } else { %>
              <span class="al-file-path-current"><%= part %></span>
            <% }
          });
        }
      %>
    </nav>
    <!-- Search/filter -->
    <div class="al-file-search">
      <%- icon('search', { size: 14, class: 'shrink-0' }) %>
      <input id="fileSearchInput" type="text" placeholder="<%= t('filterFiles') %>"
        class="al-file-search-input"
        autocomplete="off" spellcheck="false"
        aria-label="<%= t('filterFiles') %>">
      <button type="button" id="clearFileSearch" class="al-file-search-clear hidden" aria-label="<%= t('clearSearchFilter') %>">
        <%- icon('x', { size: 12 }) %>
      </button>
    </div>
    <table class="al-table min-w-full">
      <thead class="al-table-head">
        <tr>
          <th class="al-table-th w-10" scope="col">
            <input type="checkbox" id="selectAll" class="al-form-checkbox file-checkbox" aria-label="<%= t('selectFileAll') %>">
          </th>
          <th class="al-table-th" scope="col"><%= t('name') %></th>
          <th class="al-table-th w-24" scope="col"><%= t('size') %></th>
          <th class="al-table-th w-32 hidden md:table-cell" scope="col"><%= t('modified') %></th>
        </tr>
      </thead>
      <tbody id="fileTableBody">
        <%- include('./files-rows') %>
      </tbody>
    </table>
  </div>
</div>

<!-- Floating Action Bar -->
<div id="floatingActionBar" class="al-file-actions translate-y-full">
  <div class="flex items-center gap-2.5">
    <%- icon('check-square', { size: 16, class: 'shrink-0' }) %>
    <span id="selectedFilesCount" class="text-sm font-medium" style="color:var(--theme-text-strong)"></span>
  </div>
  <div class="flex items-center gap-2">
    <button type="button" id="massRenameBtn" class="al-btn-secondary al-btn-sm">
      <%- icon('pencil', { size: 14, class: 'shrink-0' }) %>
      <%= t('rename') %>
    </button>
    <button type="button" id="massArchiveBtn" class="al-btn-primary al-btn-sm">
      <%- icon('file-archive', { size: 14, class: 'shrink-0' }) %>
      <%= t('archive') %>
    </button>
    <button type="button" id="massDeleteBtn" class="al-btn-danger al-btn-sm">
      <%- icon('trash-2', { size: 14, class: 'shrink-0' }) %>
      <%= t('delete') %>
    </button>
    <button type="button" id="dismissSelectionBtn" class="al-btn-ghost al-btn-icon-only ml-1" title="<%= t('deselectAll') %>" aria-label="<%= t('deselectAll') %>">
      <%- icon('x', { size: 14 }) %>
    </button>
  </div>
</div>

<!-- Modals -->

<!-- Create file / folder modal -->
<div id="createFileModal" class="al-sheet-overlay opacity-0 pointer-events-none">
  <div id="createFileModalPanel" class="al-sheet-panel w-full sm:max-w-md flex flex-col" role="dialog" aria-modal="true" aria-labelledby="createModalTitle" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:var(--theme-shadow-xl);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div class="min-w-0">
        <h2 id="createModalTitle" class="al-card-title"><%= t('newFile') %></h2>
        <p id="createModalHint" class="al-card-subtitle"><%= t('newFileDesc') %></p>
      </div>
      <button type="button" id="closeCreateFileModal" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <input type="text" id="FileName" data-mode="file" class="al-input font-mono" placeholder="<%= t('fileNamePlaceholder') %>" aria-label="<%= t('newFile') %>">
      <p id="fileNamePreview" class="mt-2 text-xs font-mono hidden"></p>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" id="cancelCreateFile" class="al-btn-secondary al-btn-sm">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="confirmCreateFile" class="al-btn-primary al-btn-sm">
        <%- icon('plus', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('create') %>
      </button>
    </div>
  </div>
</div>

<!-- Rename modal -->
<div id="renameModal" class="al-sheet-overlay opacity-0 pointer-events-none">
  <div id="renameModalPanel" class="al-sheet-panel w-full sm:max-w-md flex flex-col" role="dialog" aria-modal="true" aria-label="<%= t('rename') %>" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:var(--theme-shadow-xl);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div class="min-w-0">
        <h2 class="al-card-title"><%= t('rename') %></h2>
        <p class="al-card-subtitle"><%= t('renameDesc') %></p>
      </div>
      <button type="button" id="closeRenameModal" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <input type="text" id="newFileName" class="al-input font-mono" placeholder="<%= t('renamePlaceholder') %>" aria-label="<%= t('rename') %>">
      <p id="renamePreview" class="mt-2 text-xs font-mono hidden"></p>
      <input type="hidden" id="currentFileName">
      <input type="hidden" id="currentFilePath">
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" id="cancelRename" class="al-btn-secondary al-btn-sm">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="confirmRename" class="al-btn-primary al-btn-sm">
        <%- icon('pencil', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('rename') %>
      </button>
    </div>
  </div>
</div>

<!-- Pull file from URL modal -->
<div id="pullFileModal" class="al-sheet-overlay opacity-0 pointer-events-none">
  <div id="pullFileModalPanel" class="al-sheet-panel w-full sm:max-w-md flex flex-col" role="dialog" aria-modal="true" aria-labelledby="pullModalTitle" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:var(--theme-shadow-xl);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div class="min-w-0">
        <h2 id="pullModalTitle" class="al-card-title"><%= t('pullFileFromUrl') %></h2>
        <p class="al-card-subtitle"><%= t('pullFileDesc') %></p>
      </div>
      <button type="button" id="closePullFileModal" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <label for="pullUrlInput" class="al-form-label"><%= t('fileUrl') %></label>
      <input type="url" id="pullUrlInput" class="al-input w-full font-mono" placeholder="https://example.com/file.zip" autocomplete="off" spellcheck="false">
      <p id="pullUrlPreview" class="mt-2 text-xs font-mono hidden" style="color:var(--theme-text-muted)"></p>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" id="cancelPullFile" class="al-btn-secondary al-btn-sm">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="pullButton" class="al-btn-primary al-btn-sm">
        <%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %>
        <%= t('pull') %>
      </button>
    </div>
  </div>
</div>

<!-- Mass Delete Confirmation Modal -->
<div id="massDeleteModal" class="al-sheet-overlay opacity-0 pointer-events-none">
  <div id="massDeleteModalPanel" class="al-sheet-panel w-full sm:max-w-sm flex flex-col" role="alertdialog" aria-modal="true" aria-labelledby="massDeleteTitle" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); box-shadow:var(--theme-shadow-xl);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <p id="massDeleteTitle" class="al-card-title"><%= t('confirmMassDeletion') %></p>
      <button type="button" id="closeMassDeleteModal" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <p id="massDeleteMessage" class="text-xs leading-relaxed" style="color:var(--theme-text-muted)"></p>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" id="cancelMassDelete" class="al-btn-secondary al-btn-sm">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="confirmMassDelete" class="al-btn-danger al-btn-sm">
        <%- icon('trash-2', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('delete') %>
      </button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
  window.__serverUUID = '<%= server.UUID %>';
  window.__currentPath = '<%= (typeof filesCurrentPath !== "undefined" && filesCurrentPath) ? filesCurrentPath.replace(/'/g, "\\'") : "" %>';
</script>
<script nonce="<%- nonce %>" src="<%= assetUrl('/javascript/user/server/files.js') %>"></script>

<%- include('../../layouts/user-footer') %>
