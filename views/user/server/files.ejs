    if (e.key === 'Escape' && selectedFiles.length > 0) {
      document.querySelectorAll('.file-checkbox').forEach(cb => {
        cb.checked = false;
        cb.closest('tr')?.classList.remove('is-selected');
      });
      selectedFiles = [];
      updateSelectedFiles();
