          confirmLabel: '<%= req.translations.restartServer || "Restart Server" %>',
          onConfirm: async () => {
          const serverUUID = '<%= server.UUID %>';
          deliberateStop = true;
          logsAutoLoaded = false;
          installLogsLoaded = false;
          serverStopped = false;
          historyLoaded = false;
          setStatusText('Restarting', 'var(--theme-warning)');
          setStatusLog('Sending restart request...');
          updateStatusChart('warning', 0.1, 0.2);
          lockInput('Restarting container...');
          beginPower(restartButton, 'restart', 'Server rebooted. Back in action.');

          try {
              const r = await fetch(`/server/${serverUUID}/power/restart`, {
                  method: 'POST',
                  headers: { 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
              });
              const d = await r.json().catch(() => ({}));
              if (!r.ok) {
                  finishPower(false, (d && d.error) || 'Failed to restart the server.');
                  unlockInput();
                  return;
              }
              // A restart that lands on the capacity queue waits the same way
              // a start does; the lifecycle stream reports the stop → start.
              if (d.queued) {
                  setStatusText('Queued', 'var(--theme-warning)');
                  setStatusLog('Waiting for capacity...');
                  showQueueStatus(d.position, d.total, null);
                  return;
              }
              setStatusLog('Restarting server...', 'starting');
          } catch (e) {
              finishPower(false, "Restart didn't take. Try again?");
              unlockInput();
          }
          }
        });
    });
    <% } else { %>
    restartButton.addEventListener('click', () => {
        showToast('This server is suspended. Please contact an administrator for assistance.', 'error');
    });
    <% } %>

    const stopButton = document.getElementById('stopButton');
    <% if (!server.Suspended) { %>
    stopButton.addEventListener('click', () => {
        const serverUUID = '<%= server.UUID %>';
        window.modal.confirm({
          title: '<%= req.translations.confirmStopServer || "Stop server?" %>',
          body: '<%= req.translations.confirmStopDesc || "Everyone gets disconnected. You sure?" %>',
          danger: true,
          confirmLabel: '<%= req.translations.stopServer || "Stop Server" %>',
          onConfirm: async () => {

          deliberateStop = true;
          setStatusText('Stopping', 'var(--theme-danger)');
          setStatusLog('Sending stop command...');
          updateStatusChart('danger', 0.1, 0.2);
          beginPower(stopButton, 'stop', 'Server shut down.');

          try {
              const r = await fetch(`/server/${serverUUID}/power/stop`, {
                  method: 'POST',
                  headers: { 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
              });
              if (!r.ok) {
                  const d = await r.json().catch(() => ({}));
                  finishPower(false, (d && d.error) || "Couldn't stop the server. Try again?");
                  setStatusText('Online', 'var(--theme-success)');
                  updateStatusChart('success', 0.1, 0.2);
                  return;
              }
              // The daemon broadcasts the stop through the lifecycle stream;
              // the "stopped"/"killed" state finishes the action.
              setStatusLog('Stopping server...', 'stopping');
          } catch (e) {
              finishPower(false, "Couldn't stop the server. Try again?");
              setStatusText('Online', 'var(--theme-success)');
              updateStatusChart('success', 0.1, 0.2);
          }
          }
        });
    });
    <% } else { %>
    stopButton.addEventListener('click', () => {
        showToast('This server is suspended. Please contact an administrator for assistance.', 'error');
    });
    <% } %>

    window.ALMount(() => {
        const inputElement = document.getElementById('input');

        inputElement.addEventListener('keypress', function (event) {
            if (event.key === 'Enter') {
                sendCommand();
                clearGhostText();
            }
        });

        inputElement.addEventListener('keydown', function(event) {
            handleKeyUp(event);
        });

        <% if (typeof features !== 'undefined' && features && features.includes('auto-complete')) { %>
        // Lazy-load the autocomplete module only after the page is idle.
        // This keeps it off the critical path and away from parse/eval during load.
        inputElement.addEventListener('focus', function loadAutocomplete() {
            inputElement.removeEventListener('focus', loadAutocomplete);
            import('/js/mc-autocomplete.js').then(mod => {
                mod.fetchPlayersIfNeeded('<%= server.UUID %>');
                mod.initDesktop(inputElement);
            });
        }, { once: true });
        <% } %>
    });

    // Stubs so the keydown handler doesn't throw before the module loads.
    function clearGhostText() {
        const ghostTyped = document.getElementById('ghost-typed');
        const ghostSuggestion = document.getElementById('ghost-suggestion');
        if (ghostTyped) ghostTyped.textContent = '';
        if (ghostSuggestion) ghostSuggestion.textContent = '';
    }

    function copyServerIP() {
        const ipText = document.getElementById('server-ip-text').textContent.trim();
        navigator.clipboard.writeText(ipText).then(() => {
            document.getElementById('copy-icon').classList.add('hidden');
            document.getElementById('check-icon').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('copy-icon').classList.remove('hidden');
                document.getElementById('check-icon').classList.add('hidden');
            }, 2000);
        });
    }

    function formatBytes(bytes, decimals = 2) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const dm = decimals < 0 ? 0 : decimals;
        const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    function formatRam(bytes, decimals = 1) {
        if (bytes === 0) return '0 MB';
        const mb = bytes / (1024 * 1024);
        if (mb < 1024) return mb.toFixed(decimals) + ' MB';
        return (mb / 1024).toFixed(decimals) + ' GB';
    }

    function themeColor(name, alpha = 1) {
        const raw = getComputedStyle(document.documentElement).getPropertyValue('--theme-' + name).trim();
        const m = raw.match(/^#([0-9a-f]{6})$/i) || raw.match(/^#([0-9a-f]{3})$/i);
        if (m) {
            const h = m[1].length === 3 ? m[1].split('').map(c => c + c).join('') : m[1];
            return `rgba(${parseInt(h.slice(0, 2), 16)}, ${parseInt(h.slice(2, 4), 16)}, ${parseInt(h.slice(4, 6), 16)}, ${alpha})`;
        }
        return raw ? `color-mix(in srgb, ${raw} ${Math.round(alpha * 100)}%, transparent)` : 'transparent';
    }

    function getChartColors() {
        return {
            border: themeColor('border'),
            fill: themeColor('border', 0.35),
        };
    }

    function createBackgroundChart(canvasId, type = 'line') {
        const colors = getChartColors();
        return new Chart(document.getElementById(canvasId).getContext('2d'), {
                type: type,
                data: {
                    labels: [],
                    datasets: [{
                        data: [],
                        borderColor: colors.border,
                        backgroundColor: colors.fill,
                        borderWidth: 1,
                        pointRadius: 0,
                        fill: true,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false }
                    },
                    scales: {
                        x: { display: false },
                        y: { display: false }
                    },
                    animation: true
                }
            });
        }

    const statusChart = createBackgroundChart('statusChart');
    const ramChart = createBackgroundChart('ramChart');
    const cpuChart = createBackgroundChart('cpuChart');
    const diskChart = createBackgroundChart('diskChart', 'doughnut');

    function updateRamUsage(stats) {
    const ramStatsUsage = stats?.data?.memory?.usage || 0;
    const ramStatsLimit = stats?.data?.memory?.limit || <%- server.Memory %> * 1024 * 1024;
    let ramUsagePercent = Number(stats?.data?.memory?.percentage) || 0;
    const ramUsageInMB = ramStatsUsage / 1024 / 1024;
    const ramLimitInMB = ramStatsLimit / 1024 / 1024;

    if (isNaN(ramUsagePercent)) {
        ramUsagePercent = 0;
    }

    ramUsagePercent = Math.round(ramUsagePercent);

    const ramUsageText = `${ramUsagePercent}% (${formatRam(ramStatsUsage)} / ${formatRam(ramStatsLimit)})`;
    document.getElementById('ramUsage').textContent = ramUsageText;

    if (ramStatsUsage > 0) {
        updateChart(ramChart, ramUsagePercent);
    }
}

    function updateCpuUsage(stats) {
        let cpuUsagePercent = Number(stats?.data?.cpu?.percentage) || 0;

        if (isNaN(cpuUsagePercent)) {
            cpuUsagePercent = 0;
        }

        const cpuAllocPct = <%- server.Cpu %> || 100;
        const cores = Math.max(1, Math.round(cpuAllocPct / 100));
        const cpuOfAlloc = cpuAllocPct > 0
            ? Math.round(Math.min(100, (cpuUsagePercent / cpuAllocPct) * 100))
            : 0;

        document.getElementById('cpuUsage').textContent =
            `${cpuOfAlloc}% of ${cores} core${cores === 1 ? '' : 's'}`;

        if (cpuOfAlloc > 0) {
            updateChart(cpuChart, cpuOfAlloc);
        }
    }

    function updateDiskUsage(stats) {
        const DISK_LIMIT_MB = <%- typeof server !== 'undefined' && server.Storage ? server.Storage : 0 %>;
        const diskUsageRaw = parseFloat(stats.data.storage.usage) || 0;
        const diskEl = document.getElementById('diskUsage');
        if (!diskEl) return;
        if (DISK_LIMIT_MB <= 0) {
            diskEl.textContent = `${formatBytes(diskUsageRaw * 1024 * 1024)} used (unlimited disk)`;
            return;
        }
        const diskPct = Math.round(diskUsageRaw / DISK_LIMIT_MB * 100);
        diskEl.textContent = `${diskPct}% (${formatBytes(diskUsageRaw * 1024 * 1024)} / ${formatBytes(DISK_LIMIT_MB * 1024 * 1024)})`;
    }

    function updateStatus(stats) {
        if (lifecycleActive) return;
        const statusElement = document.getElementById('status');

        if (stats.data && stats.data.starting === true) {
            statusElement.textContent = 'Starting';
            statusElement.className = 'mt-1 text-lg font-medium tracking-tight leading-snug w-full';
            statusElement.style.color = 'var(--theme-warning)';
            updateStatusChart('warning', 0.1, 0.2);
        } else if (stats.data && stats.data.running === true) {
            statusElement.textContent = 'Online';
            statusElement.className = 'mt-1 text-lg font-medium tracking-tight leading-snug w-full';
            statusElement.style.color = 'var(--theme-success)';
            updateStatusChart('success', 0.1, 0.2);
        } else {
            statusElement.textContent = 'Offline';
            statusElement.className = 'mt-1 text-lg font-medium tracking-tight leading-snug w-full';
            statusElement.style.color = 'var(--theme-danger)';
            updateStatusChart('danger', 0.1, 0.2);
        }
        serverOnline = (stats.data && stats.data.running === true);
        updateLoadLogsButton();
    }

    function updateChart(chart, value) {
        chart.data.labels.push('');
        chart.data.datasets[0].data.push(value);

        if (chart.data.labels.length > 20) {
            chart.data.labels.shift();
            chart.data.datasets[0].data.shift();
        }

        const colors = getChartColors();
        chart.data.datasets[0].borderColor = colors.border;
        chart.data.datasets[0].backgroundColor = colors.fill;

        scheduleChartUpdate(chart);
    }

    // Coalesce chart re-renders onto a single requestAnimationFrame. The stats
    // stream can deliver many messages per second; calling chart.update() on
    // each one (with animation enabled) stalls the page.
    let chartUpdatePending = null;
    const chartsPendingUpdate = new Set();
    function scheduleChartUpdate(chart) {
        chartsPendingUpdate.add(chart);
        if (chartUpdatePending) return;
        chartUpdatePending = requestAnimationFrame(() => {
            chartUpdatePending = null;
            const charts = Array.from(chartsPendingUpdate);
            chartsPendingUpdate.clear();
            charts.forEach((c) => c.update());
        });
    }

    // When true, the lifecycle stream owns the status card — stats polling must not overwrite it.
    let lifecycleActive = false;
    let statusMsgFadeTimer = null;
    // True when the user (or a lifecycle event) deliberately stopped the server.
    // A stop with this flag set is never labeled a crash.
    let deliberateStop = false;
    let serverStopped = false;
    let logsAutoLoaded = false;
    let installLogsLoaded = false;

    // ── Crash vs. stop surfacing (S-2) ─────────────────────────────────────
    // Never fabricate: an exit code labels the crash precisely, 137 gets the
    // OOM hint, no exit code gets an honest "stopped unexpectedly" fallback.
    function crashReasonLabel(exitCode) {
        if (exitCode === 137) return '<%= req.translations.serverCrashedOom || "Server crashed (exit 137 — likely out of memory)" %>';
        if (typeof exitCode === 'number') return '<%= req.translations.serverCrashedExit || "Server crashed (exit " %>' + exitCode + ')';
        return null;
    }

    function surfaceStoppedState(data) {
        if (deliberateStop) { deliberateStop = false; return; }
        const reason = crashReasonLabel(data && data.exitCode);
        if (reason) {
            setStatusText(reason, 'var(--theme-danger)');
            updateStatusChart('danger', 0.1, 0.2);
            writeConsole('daemon', 'error', reason);
            showToast(reason, 'error');
        }
        const msgEl = document.getElementById('status-msg');
        if (msgEl) {
            const link = document.createElement('a');
            link.href = '/server/<%= server.UUID %>/logs';
            link.textContent = '<%= req.translations.openLogs || "Open logs" %>';
            link.className = 'underline underline-offset-2 hover:opacity-75';
            msgEl.textContent = '';
            msgEl.appendChild(link);
            msgEl.className = 'text-xs font-medium mt-0.5 leading-snug transition-all duration-300';
            msgEl.style.color = 'var(--theme-danger)';
            msgEl.classList.remove('opacity-0', 'translate-y-1', 'pointer-events-none');
        }
    }

    // Color map: lifecycle event type → text color token
    const statusColors = {
        pulling:  { cls: 'var(--theme-info)' },
        creating: { cls: 'var(--theme-info)' },
        starting: { cls: 'var(--theme-warning)' },
        started:  { cls: 'var(--theme-warning)' },
        stopping: { cls: 'var(--theme-warning)' },
        stopped:  { cls: 'var(--theme-danger)' },
        killed:   { cls: 'var(--theme-danger)' },
        error:    { cls: 'var(--theme-danger)' },
    };

    // Returns a clean, user-facing label for the status card.
    // Layer-level pulling detail is collapsed to "Pulling image".
    const statusCardLabels = {
        pulling:  'Pulling image',
        creating: 'Creating container',
        starting: 'Starting container',
        started:  'Starting server',
        stopping: 'Stopping server',
        stopped:  'Server stopped',
        killed:   'Server stopped',
        error:    'Error',
    };

    function statusLabel(type) {
        return statusCardLabels[type] || null;
    }

    // Updates the big status label (Online / Offline / Starting etc.)
    function setStatusText(text, colorVar) {
        const el = document.getElementById('status');
        if (!el) return;
        el.textContent = text;
        el.className = 'mt-1 text-lg font-medium tracking-tight leading-snug';
        el.style.color = colorVar;
    }

    // Shows a colored, animated lifecycle label in the status card.
    // The status card always shows the clean label (e.g. "Pulling image"),
    // never raw layer-level daemon output. Pass msg=null to fade out and release.
    function setStatusLog(msg, eventType) {
        const msgEl = document.getElementById('status-msg');
        if (!msgEl) return;

        if (statusMsgFadeTimer) { clearTimeout(statusMsgFadeTimer); statusMsgFadeTimer = null; }

        if (msg === null) {
            msgEl.classList.add('opacity-0', 'translate-y-1');
            statusMsgFadeTimer = setTimeout(() => {
                msgEl.textContent = '';
                msgEl.className = 'text-xs font-medium mt-0.5 leading-snug transition-all duration-300 opacity-0 translate-y-1 pointer-events-none';
                lifecycleActive = false;
                statusMsgFadeTimer = null;
            }, 300);
        } else {
            lifecycleActive = true;
            hideConsolePlaceholder();
            // Use the clean label — never raw layer output in the status card
            const label = statusLabel(eventType) || msg;
            const color = (statusColors[eventType] || { cls: 'text-neutral-500 dark:text-neutral-400' }).cls;
            msgEl.classList.add('opacity-0', 'translate-y-1');
            statusMsgFadeTimer = setTimeout(() => {
                msgEl.textContent = label;
                msgEl.className = `text-xs font-medium mt-0.5 leading-snug transition-all duration-300 ${color}`;
                void msgEl.offsetHeight;
                msgEl.classList.remove('opacity-0', 'translate-y-1');
                statusMsgFadeTimer = null;
            }, 150);
        }
    }

    function updateStatusChart(token, bgAlpha = 0.1, borderAlpha = 0.3) {
        statusChart.data.datasets[0].backgroundColor = themeColor(token, bgAlpha);
        statusChart.data.datasets[0].borderColor = themeColor(token, borderAlpha);
        statusChart.data.labels = [''];
        statusChart.data.datasets[0].data = [100];
        statusChart.update();
    }

    // Shows live queue details in the status card while a start is queued.
    function showQueueStatus(position, total, available) {
        const box = document.getElementById('queue-status');
        const posEl = document.getElementById('queue-position');
        const availEl = document.getElementById('queue-available');
        if (!box || !posEl || !availEl) return;
        posEl.textContent = `Queued — position ${position || '?'} of ${total || '?'}`;
        if (available && (typeof available.memoryMb === 'number' || typeof available.cpuPercent === 'number' || typeof available.diskMb === 'number')) {
            const parts = [];
            if (typeof available.memoryMb === 'number' && available.memoryMb > 0) parts.push(`${Math.round(available.memoryMb)} MB RAM`);
            if (typeof available.cpuPercent === 'number' && available.cpuPercent > 0) parts.push(`${Math.round(available.cpuPercent)}% CPU`);
            if (typeof available.diskMb === 'number' && available.diskMb > 0) parts.push(`${Math.round(available.diskMb)} MB disk`);
            availEl.textContent = parts.length ? 'Available: ' + parts.join(' · ') : '';
        } else {
            availEl.textContent = '';
        }
        box.classList.remove('hidden');
    }

    function hideQueueStatus() {
        const box = document.getElementById('queue-status');
        if (!box) return;
        box.classList.add('hidden');
    }

    // Function to set all stats to offline state
    function hideConsolePlaceholder() {}
    function showConsolePlaceholder() {}

    function setAllStatsOffline() {
        showConsolePlaceholder();
        serverOnline = false;
        updateLoadLogsButton();

        // Update RAM usage
        document.getElementById('ramUsage').textContent = `${Math.round(0)}% (0 MB / ${formatRam(<%- server.Memory %> * 1024 * 1024)})`;

        // Update CPU usage
        const cpuAllocPct = <%- server.Cpu %>;
        const cpuCores = (cpuAllocPct / 100).toFixed(1);
        document.getElementById('cpuUsage').textContent = `${Math.round(0)}% of ${cpuCores} core${cpuCores === '1.0' ? '' : 's'}`;

        // Update disk usage
        const diskLimitMB = <%- typeof server !== 'undefined' && server.Storage ? server.Storage : 0 %>;
        document.getElementById('diskUsage').textContent = diskLimitMB > 0
            ? `0% (0 Bytes / ${formatBytes(diskLimitMB * 1024 * 1024)})`
            : '0 bytes used (unlimited disk)';

        // Reset charts
        resetCharts();

        // The lifecycle stream owns the status card while an action is in
        // flight (starting/stopping/installing). Don't clobber it with a
        // generic offline state — the stats stream or the next lifecycle
        // event refreshes the card instead.
        if (lifecycleActive) return;

        // Update status display
        const statusElement = document.getElementById('status');
        statusElement.textContent = 'Offline';
        statusElement.className = 'mt-1 text-lg font-medium tracking-tight';
        statusElement.style.color = 'var(--theme-danger)';

        // Update status chart
        updateStatusChart('danger', 0.1, 0.2);
    }

    // Function to reset all charts
    function resetCharts() {
        // Reset RAM chart
        ramChart.data.labels = [];
        ramChart.data.datasets[0].data = [];
        ramChart.update();

        // Reset CPU chart
        cpuChart.data.labels = [];
        cpuChart.data.datasets[0].data = [];
        cpuChart.update();
    }

    function isValidJson(str) {
        try {
            JSON.parse(str);
        } catch {
            return false;
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════════
    // POWER ACTIONS — start / restart / stop
    //
    // One in-flight action at a time. The button stays loading until the
    // realtime stream reports the container back online ("started") or the
    // daemon broadcasts a completion state. A failsafe timer releases the
    // button if no event ever arrives so the UI never sticks.
    // ═══════════════════════════════════════════════════════════════
    let powerBtn = null;        // button currently loading
    let powerKind = null;       // 'start' | 'restart' | 'stop'
    let powerTimer = null;      // failsafe
    let powerToast = null;      // success toast for this action

    function forceReleasePower() {
        if (!powerBtn) return;
        const btn = powerBtn;
        powerBtn = null;
        powerKind = null;
        powerToast = null;
        if (powerTimer) { clearTimeout(powerTimer); powerTimer = null; }
        clearButtonLoading(btn);
        setStatusLog(null);
    }

    function beginPower(btn, kind, toastMsg) {
        forceReleasePower();
        powerBtn = btn;
        powerKind = kind;
        powerToast = toastMsg || null;
        setButtonLoading(btn, kind === 'start' ? 'Starting…' : kind === 'restart' ? 'Restarting…' : 'Stopping…');
        powerTimer = setTimeout(forceReleasePower, 90000);
    }

    function finishPower(ok, message) {
        if (!powerBtn) return;
        const btn = powerBtn;
        const toast = powerToast;
        powerBtn = null;
        powerKind = null;
        powerToast = null;
        if (powerTimer) { clearTimeout(powerTimer); powerTimer = null; }
        clearButtonLoading(btn);
        setStatusLog(null);
        hideQueueStatus();
        if (ok === false) {
            showToast(message || 'That operation failed.', 'error');
        } else {
            showToast(message || toast || 'Done.', 'success');
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // REALTIME — one shared /ws/realtime subscription replaces the old
    // per-page /status and /events sockets plus every polling loop. The
    // panel's daemon watchers fan state/stats/lifecycle/queue events onto
    // the bus; this page only renders what it subscribes to.
    // ═══════════════════════════════════════════════════════════════
    const rtServerUUID = '<%= server.UUID %>';
    const rt = window.alRealtime;
    const st = window.alState;

    function resubscribeRealtime() {
        if (!rt) return;
        rt.watch(rtServerUUID);
        rt.watchEvents(rtServerUUID);
    }

    // Level-1 lifecycle events hold the console input open (Waiting...)
    // while the container is being assembled/started.
    const lifecycleLocks = { pulling: 1, creating: 1, starting: 1 };

    function handleLifecycle(data) {
        if (!data || typeof data.type !== 'string') return;
        const { type, message } = data;

        setStatusLog(message, type);
        writeConsole('daemon', 'info', message);
        if (lifecycleLocks[type]) {
            // The queued start was granted and the daemon is building the
            // container — the queue box no longer applies.
            hideQueueStatus();
            lockInput('Waiting...');
        }

        if (type === 'started') {
            serverOnline = true;
            updateLoadLogsButton();
            unlockInput();
            setStatusLog(null);
            if (typeof term !== 'undefined') term.scrollToBottom();
            if (!logsAutoLoaded) { logsAutoLoaded = true; loadRecentLogs(false); }
            if (!socket || socket.readyState !== 1) forceReconnectConsole();
            finishPower(true);
        } else if (type === 'stopped' || type === 'killed') {
            serverOnline = false;
            updateLoadLogsButton();
            deliberateStop = true;
            serverStopped = true;
            setStatusLog(null);
            loadRecentLogs(false);
            if (powerKind === 'stop') finishPower(true);
        } else if (type === 'installing') {
            if (!installLogsLoaded) { installLogsLoaded = true; loadRecentLogs(false); }
        } else if (type === 'error') {
            serverOnline = false;
            updateLoadLogsButton();
            unlockInput();
            setStatusLog(null);
            finishPower(false, message || 'Something went wrong while the server was handling your request.');
        }
    }

    function finishPowerFailure(message) {
        setStatusText('Offline', 'var(--theme-danger)');
        updateStatusChart('danger', 0.1, 0.2);
        finishPower(false, message);
    }

    if (rt && st) {
        resubscribeRealtime();
        // The shared realtime socket reconnects on its own; re-issue the watch
        // guards after every reconnect so the daemon watchers restart here.
        rt.onStatusChange((status) => {
            if (status === 'connected') resubscribeRealtime();
        });

        // Daemon state → status card (Online / Offline / crash)
        st.observe('server:status:' + rtServerUUID, (snap) => {
            if (!snap || snap.status !== 'success' || !snap.data) return;
            const state = snap.data;
            if (state.running === false) {
                if (!lifecycleActive) {
                    setAllStatsOffline();
                    surfaceStoppedState(state);
                }
                return;
            }
            updateStatus({ data: state });
        });

        // Daemon stats → RAM / CPU / disk cards
        st.observe('server:stats:' + rtServerUUID, (snap) => {
            if (!snap || snap.status !== 'success' || !snap.data) return;
            updateRamUsage({ data: snap.data });
            updateCpuUsage({ data: snap.data });
            updateDiskUsage({ data: snap.data });
        });

        // Start queue position → status card
        st.observe('server:queue:' + rtServerUUID, (snap) => {
            if (!snap || !snap.data) return;
            const q = snap.data;
            if (q.queued && typeof q.position === 'number') {
                setStatusText('Queued', 'var(--theme-warning)');
                setStatusLog('Waiting for capacity...');
                showQueueStatus(q.position, q.total, q.available);
            } else {
                hideQueueStatus();
            }
        });

        // Streaming events — lifecycle messages must arrive on EVERY
        // occurrence (the terminal shows them all), so the raw bus is the
        // right surface rather than the last-value state cache.
        rt.subscribe((evt) => {
            if (!evt || typeof evt.type !== 'string') return;
            const rid = evt.resource && evt.resource.type === 'server' ? String(evt.resource.id) : null;
            if (rid && rid !== rtServerUUID) return;

            if (evt.type === 'server.lifecycle.changed') {
                handleLifecycle(evt.state);
                return;
            }

            if (evt.type === 'server.power.start.failed' || evt.type === 'server.start.failed') {
                const msg = (evt.error && evt.error.message) || (evt.state && evt.state.message) || null;
                finishPowerFailure(msg || 'The server couldn\'t start.');
                return;
            }

            if (evt.type === 'server.power.stop.failed') {
                const msg = (evt.error && evt.error.message) || null;
                finishPower(false, msg || 'Couldn\'t stop the server. Try again?');
                return;
            }

            if (evt.type === 'server.power.started') {
                setStatusText('Online', 'var(--theme-success)');
                updateStatusChart('success', 0.1, 0.2);
                if (powerKind === 'start' || powerKind === 'restart') {
                    finishPower(true);
                    if (!socket || socket.readyState !== 1) forceReconnectConsole();
                }
                return;
            }

            if (evt.type === 'server.power.stopped') {
                if (powerKind === 'stop') {
                    finishPower(true);
                    setAllStatsOffline();
                    setStatusText('Offline', 'var(--theme-danger)');
                    updateStatusChart('danger', 0.1, 0.2);
                    setStatusLog(null);
                }
            }
        });
    }

    // ═══════════════════════════════════════════════════════════════
    // MOBILE LAYOUT — separate terminal, charts, buttons
    // ═══════════════════════════════════════════════════════════════
    (function () {
        const mobileEl = document.getElementById('mobile-manage');
        if (!mobileEl) return;

        // Only init mobile terminal if the element exists and is visible
        const mobileTermEl = document.getElementById('mobile-terminal');
        if (!mobileTermEl) return;

        const mobileTerm = new Terminal({
            disableStdin: true,
            lineHeight: 1.3,
            fontFamily: 'Menlo, Monaco, Consolas, monospace',
            fontSize: 11,
            theme: termTheme,
            scrollback: 1000,
            convertEol: true
        });

        const mobileFitAddon = new FitAddon.FitAddon();
        mobileTerm.loadAddon(mobileFitAddon);
        const mobileWebLinksAddon = new WebLinksAddon.WebLinksAddon();
        mobileTerm.loadAddon(mobileWebLinksAddon);
        mobileTerm.open(mobileTermEl);

        function fitMobileTerminal() { mobileFitAddon.fit(); }
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () { requestAnimationFrame(fitMobileTerminal); });
        } else {
            setTimeout(fitMobileTerminal, 100);
        }
        window.alListener(window, 'resize', 'manage-mobile-term-resize', function () { requestAnimationFrame(fitMobileTerminal); });

        // Touch scroll for mobile terminal
        (function () {
            let touchStartY = 0;
            mobileTermEl.addEventListener('touchstart', function (e) { touchStartY = e.touches[0].clientY; }, { passive: true });
            mobileTermEl.addEventListener('touchmove', function (e) {
                const dy = touchStartY - e.touches[0].clientY;
                touchStartY = e.touches[0].clientY;
                e.preventDefault();
                e.stopPropagation();
                mobileTerm.scrollLines(Math.round(dy / 16));
            }, { passive: false });
        })();

        // Mobile charts
        const mobileStatusChart = createBackgroundChart('mobileStatusChart');
        const mobileRamChart = createBackgroundChart('mobileRamChart');
        const mobileCpuChart = createBackgroundChart('mobileCpuChart');
        const mobileDiskChart = createBackgroundChart('mobileDiskChart', 'doughnut');

        // Share the same WebSocket for stats — update mobile elements too
        const origUpdateRam = updateRamUsage;
        const origUpdateCpu = updateCpuUsage;
        const origUpdateDisk = updateDiskUsage;
        const origUpdateStatus = updateStatus;

        // Patch update functions to also update mobile elements
        const origSetStatusText = setStatusText;
        function patchedSetStatusText(text, colorVar) {
            origSetStatusText(text, colorVar);
            const el = document.getElementById('mobile-status');
            if (el) { el.textContent = text; el.className = 'mt-0.5 text-base font-semibold leading-tight'; el.style.color = colorVar; }
        }

        const origSetStatusLog = setStatusLog;
        function patchedSetStatusLog(msg, eventType) {
            origSetStatusLog(msg, eventType);
            const logEl = document.getElementById('mobile-status-log-text');
            if (!logEl) return;
            if (msg === null) { logEl.textContent = ''; logEl.classList.add('hidden'); return; }
            const label = (statusCardLabels[eventType] || msg);
            const color = (statusColors[eventType] || {}).cls || 'var(--theme-text-muted)';
            logEl.textContent = label;
            logEl.className = 'text-[10px] font-medium truncate';
            logEl.style.color = color;
            logEl.classList.remove('hidden');
        }

        // Override to also write to mobile terminal
        const origWriteConsole = writeConsole;
        function mobileWriteConsole(prefix, type, message) {
            origWriteConsole(prefix, type, message);
            const ansi = { system: '\x1b[33m', error: '\x1b[31m', info: '\x1b[34m', success: '\x1b[32m', normal: '\x1b[0m' };
            const color = ansi[type.toLowerCase()] || '\x1b[0m';
            const prefixText = (prefix && type !== 'normal') ? '[' + prefix + '] ' : '';
            mobileTerm.write(color + prefixText + '\x1b[37m' + message + '\x1b[0m\r\n');
        }

        // Mirror live RAM/CPU/disk updates to the mobile stats grid. These
        // were captured but never assigned before, so the mobile cards stayed
        // at their static "0%" / "--" placeholders.
        const origUpdateRamMobile = updateRamUsage;
        updateRamUsage = function (stats) {
            origUpdateRamMobile(stats);
            const el = document.getElementById('mobile-ramUsage');
            if (el) el.textContent = (document.getElementById('ramUsage') || {}).textContent || '0%';
            const pct = Number(stats?.data?.memory?.percentage) || 0;
            if (pct > 0) updateChart(mobileRamChart, Math.round(pct));
        };

        const origUpdateCpuMobile = updateCpuUsage;
        updateCpuUsage = function (stats) {
            origUpdateCpuMobile(stats);
            const el = document.getElementById('mobile-cpuUsage');
            if (el) el.textContent = (document.getElementById('cpuUsage') || {}).textContent || '0%';
            const pct = Number(stats?.data?.cpu?.percentage) || 0;
            if (pct > 0) updateChart(mobileCpuChart, Math.round(pct));
        };

        const origUpdateDiskMobile = updateDiskUsage;
        updateDiskUsage = function (stats) {
            origUpdateDiskMobile(stats);
            const el = document.getElementById('mobile-diskUsage');
            if (el) el.textContent = (document.getElementById('diskUsage') || {}).textContent || '--';
            const limitMB = <%- typeof server !== 'undefined' && server.Storage ? server.Storage : 0 %>;
            const usageMB = parseFloat(stats?.data?.storage?.usage) || 0;
            const pct = limitMB > 0 ? Math.round(usageMB / limitMB * 100) : 0;
            updateChart(mobileDiskChart, Math.min(100, pct));
        };

        // Mobile input handling
        const mobileInput = document.getElementById('mobile-input');
        if (mobileInput) {
            mobileInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    if (!consoleOwner) return;
                    const cmd = mobileInput.value.trim();
                    if (cmd && socket) {
                        mobileTerm.write('\u001b[1m\u001b[33m~ \u001b[0m' + cmd + '\r\n');
                        socket.send(JSON.stringify({ event: 'CMD', command: cmd }));
                        if (commandHistory.length === maxCommands) commandHistory.shift();
                        commandHistory.push(cmd);
                        currentCommandIndex = commandHistory.length;
                    }
                    mobileInput.value = '';
                }
            });
            mobileInput.addEventListener('keydown', handleKeyUp);
        }

        // Mobile copy IP
        window.copyMobileServerIP = function () {
            const ipText = document.getElementById('mobile-server-ip-text').textContent.trim();
            navigator.clipboard.writeText(ipText).then(function () {
                document.getElementById('mobile-copy-icon').classList.add('hidden');
                document.getElementById('mobile-check-icon').classList.remove('hidden');
                setTimeout(function () {
                    document.getElementById('mobile-copy-icon').classList.remove('hidden');
                    document.getElementById('mobile-check-icon').classList.add('hidden');
                }, 2000);
            });
        };

        // Mobile button handlers
        const mobileStartBtn = document.getElementById('mobileStartButton');
        const mobileRestartBtn = document.getElementById('mobileRestartButton');
        const mobileStopBtn = document.getElementById('mobileStopButton');

        if (mobileStartBtn) {
            <% if (!server.Suspended) { %>
            mobileStartBtn.addEventListener('click', function () { startButton.click(); });
            <% } %>
        }
        if (mobileRestartBtn) {
            <% if (!server.Suspended) { %>
            mobileRestartBtn.addEventListener('click', function () { restartButton.click(); });
            <% } %>
        }
        if (mobileStopBtn) {
            <% if (!server.Suspended) { %>
            mobileStopBtn.addEventListener('click', function () { stopButton.click(); });
            <% } %>
        }
    })();

  window.copyServerIP = copyServerIP;
  window.retryDaemonConnection = retryDaemonConnection;
})();
</script>
