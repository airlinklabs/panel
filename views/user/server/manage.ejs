// Reusable log loader — fetches saved daemon output from disk.
// showMarkers = true: wraps output with "N lines from disk" / "end of saved log" markers (manual button)
// showMarkers = false: writes lines directly (auto-load after start/install/stop)
// A newer call supersedes any older in-flight one, so a slow load can never
// write stale lines after fresher console output.
async function loadRecentLogs(showMarkers) {
    const serverId = window.location.pathname.split('/')[2];
    const ctrl = new AbortController();
    if (recentLogsController) recentLogsController.abort();
    recentLogsController = ctrl;
    logFetchControllers.add(ctrl);
    try {
        const r = await fetch('/server/' + serverId + '/logs/history', { credentials: 'same-origin', signal: ctrl.signal });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Failed to load logs');
        const lines = d.logs || [];
        if (lines.length === 0) return;
        if (showMarkers) {
            term.writeln('');
            term.writeln('\x1b[90m— ' + lines.length + ' lines from disk —\x1b[0m');
        }
        lines.forEach(l => term.writeln(l));
        if (showMarkers) {
            term.writeln('\x1b[90m— end of saved log —\x1b[0m');
        }
        term.scrollToBottom();
    } catch (err) {
        if (err && err.name === 'AbortError') return;
        term.writeln('\x1b[31mFailed to load log history: ' + (err.message || err) + '\x1b[0m');
    } finally {
        logFetchControllers.delete(ctrl);
        if (recentLogsController === ctrl) recentLogsController = null;
    }
}

// Intercept wheel events on the terminal so scrolling the console scrolls
// the terminal buffer rather than the page behind it.
(function () {
    const termEl = document.getElementById('terminal');
    if (!termEl) return;

    termEl.addEventListener('wheel', (e) => {
        e.preventDefault();
        e.stopPropagation();
        // xterm scrolls 3 lines per wheel tick by default; respect deltaMode
        const lines = e.deltaMode === 1 ? e.deltaY : Math.round(e.deltaY / 20);
        term.scrollLines(lines);
    }, { passive: false });

    // Touch: track touch start position and scroll terminal on move
    let touchStartY = 0;
    termEl.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
    }, { passive: true });

    termEl.addEventListener('touchmove', (e) => {
        const dy = touchStartY - e.touches[0].clientY;
        touchStartY = e.touches[0].clientY;
        e.preventDefault();
        e.stopPropagation();
        term.scrollLines(Math.round(dy / 16));
    }, { passive: false });
})();

    const maxCommands = 10;
    let commandHistory = [];
    let currentCommandIndex = -1;

    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const host = window.location.host;
    const path = '/console/<%= server.UUID %>';

    const socketUrl = `${protocol}//${host}${path}`;

    // Short-lived (60s) WS connect token — the browser never sees the node key.
    const _wsTokenCache = { serverId: null, promise: null, fetchedAt: 0 };
    function getWsConnectToken(serverId) {
        const fresh = Date.now() - _wsTokenCache.fetchedAt < 45000 && _wsTokenCache.serverId === serverId;
        if (!fresh) {
            _wsTokenCache.serverId = serverId;
            _wsTokenCache.promise = fetch('/server/' + encodeURIComponent(serverId) + '/ws-token', { credentials: 'same-origin' })
                .then((res) => { if (!res.ok) throw new Error('ws-token'); return res.json(); })
                .then((data) => data.token);
            _wsTokenCache.fetchedAt = Date.now();
        }
        return _wsTokenCache.promise;
    }

    let socket;

// In-flight log fetches get aborted on teardown so nothing writes after unload.
let recentLogsController = null;
const logFetchControllers = new Set();

let isReconnecting = false;
let reconnectAttempts = 0;
let maxReconnectAttempts = 10;
let reconnectInterval = 2000;
let reconnectTimer = null;
let wsErrorCount = 0;  // only show offline banner after sustained failures
let historyLoaded = false; // only fetch log history once per page load
let pageHidden = document.visibilityState === 'hidden';
let consoleOwner = false;

function connectWebSocket() {
    if (socket && (socket.readyState === WebSocket.CONNECTING || socket.readyState === WebSocket.OPEN)) {
        return;
    }

    if (reconnectTimer) {
        clearTimeout(reconnectTimer);
        reconnectTimer = null;
    }

    isReconnecting = true;

    if (socket) {
        try { socket.close(); } catch (e) { console.warn('WebSocket close failed:', e); }
        socket = null;
    }

    openConsoleSocket();
}

function forceReconnectConsole() {
    reconnectAttempts = 0;
    connectWebSocket();
}

function setDaemonOfflineBanner(offline) {
    const row = document.getElementById('daemonOfflineWarningRow');
    const mobileRow = document.getElementById('mobileDaemonOfflineWarning');
    if (row) row.classList.toggle('hidden', !offline);
    if (mobileRow) mobileRow.classList.toggle('hidden', !offline);
    if (offline) {
        lockInput('Console paused — daemon offline');
        writeConsole('system', 'error', 'Console paused — daemon offline');
    } else {
        unlockInput();
    }
}

// In-place daemon reconnection for the "Retry Connection" banners — reopens
// any socket that isn't connected instead of reloading the whole page. The
// status/stats/lifecycle streams live on the shared realtime socket, which
// reconnects on its own; this only needs to bring the console back.
function retryDaemonConnection() {
    if (!socket || socket.readyState !== WebSocket.OPEN) {
        forceReconnectConsole();
    }
    resubscribeRealtime();
}

async function openConsoleSocket() {
    try {
        const token = await getWsConnectToken('<%= server.UUID %>');
        socket = new WebSocket(socketUrl + '?token=' + encodeURIComponent(token));

        socket.onopen = () => {
            isReconnecting = false;
            reconnectAttempts = 0;
            reconnectInterval = 2000;
            wsErrorCount = 0;
            setDaemonOfflineBanner(false);

            if (!historyLoaded) {
                historyLoaded = true;
                const ctrl = new AbortController();
                logFetchControllers.add(ctrl);
                fetch(`/server/<%= server.UUID %>/logs/history`, { credentials: 'same-origin', signal: ctrl.signal })
                    .then((r) => { if (!r.ok) throw new Error(); return r.json(); })
                    .then((data) => {
                        const lines = data.logs || [];
                        lines.forEach((line) => term.write(maskPrompts(String(line)) + '\r\n'));
                    })
                    .catch(() => {})
                    .finally(() => logFetchControllers.delete(ctrl));
            }
        };

        socket.onmessage = handleWebSocketMessage;

        socket.onerror = () => {
            wsErrorCount++;
            if (wsErrorCount >= 3) {
                setDaemonOfflineBanner(true);
            }
        };

        socket.onclose = () => {
            socket = null;
            if (!isReconnecting && !serverStopped) {
                scheduleReconnect();
            }
        };
    } catch {
        socket = null;
        scheduleReconnect();
    }
}

function scheduleReconnect() {
    if (pageHidden) return;
    isReconnecting = true;
    reconnectAttempts++;

    const backoffTime = Math.min(30000, reconnectInterval * Math.pow(1.5, reconnectAttempts - 1));

    if (reconnectAttempts <= maxReconnectAttempts) {
        reconnectTimer = setTimeout(() => {
            connectWebSocket();
        }, backoffTime);
    } else {

        writeConsole('system', 'error', 'Maximum reconnect attempts reached. Please refresh the page.');
    }
}

// Background throttle — close the console socket while the tab is hidden,
// pause reconnect timers, and reconnect immediately when the tab returns.
pageHidden = document.visibilityState === 'hidden';
window.alListener(document, 'visibilitychange', 'manage-visibility', () => {
    pageHidden = document.visibilityState === 'hidden';
    if (pageHidden) {
        isReconnecting = false;
        if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
        if (socket) {
            try { socket.close(1000, 'page hidden'); } catch (e) { console.warn('WebSocket close failed:', e); }
            socket = null;
        }
    } else {
        isReconnecting = false;
        connectWebSocket();
        resubscribeRealtime();
    }
});

// Teardown on navigation — close every socket, cancel timers and abort any
// in-flight log fetches so nothing keeps running after unload.
function teardownPage() {
    if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
    if (statusMsgFadeTimer) { clearTimeout(statusMsgFadeTimer); statusMsgFadeTimer = null; }
    if (chartUpdatePending) { cancelAnimationFrame(chartUpdatePending); chartUpdatePending = null; }
    logFetchControllers.forEach((c) => c.abort());
    logFetchControllers.clear();
    if (socket) {
        try { socket.close(1000, 'page navigating'); } catch (e) {}
    }
    socket = null;
    if (window.alRealtime) {
        try { window.alRealtime.unwatch('<%= server.UUID %>'); } catch (e) {}
        try { window.alRealtime.unwatchEvents('<%= server.UUID %>'); } catch (e) {}
    }
}
window.alListener(window, 'beforeunload', 'manage-teardown-unload', teardownPage);
window.alListener(window, 'pagehide', 'manage-teardown-pagehide', teardownPage);

// Two-tab console guard — exactly one tab owns console input; every other
