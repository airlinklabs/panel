<%- include('../../layouts/user', { title: server.name || t('console') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('console') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= server.name %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
</header>

<div class="al-page-body">
  <% if (server.Suspended) { %>
  <div class="al-alert-warning mb-4" role="alert">
    <%- icon('triangle-alert', { class: 'size-4 shrink-0 mt-0.5', 'aria-hidden': 'true' }) %>
    <div class="min-w-0">
      <p class="al-alert-title"><%= t('serverSuspended') %></p>
      <p class="al-alert-body"><%= t('serverSuspendedDesc') %></p>
    </div>
  </div>
  <% } %>

  <!-- Power Controls -->
  <div class="flex flex-wrap gap-2 mb-4">
    <button id="startBtn" type="button"
      <%= server.Suspended ? 'disabled' : '' %>
      class="al-btn-success min-h-11">
      <%- icon('play', { class: 'w-4 h-4', strokeWidth: 2 }) %>
      <%= t('start') %>
    </button>
    <button id="restartBtn" type="button"
      <%= server.Suspended ? 'disabled' : '' %>
      class="al-btn-secondary min-h-11">
      <%- icon('refresh-cw', { class: 'w-4 h-4', strokeWidth: 2 }) %>
      <%= t('restart') %>
    </button>
    <button id="stopBtn" type="button"
      <%= server.Suspended ? 'disabled' : '' %>
      class="al-btn-danger min-h-11">
      <%- icon('square', { class: 'w-4 h-4', strokeWidth: 2 }) %>
      <%= t('stop') %>
    </button>
    <button id="killBtn" type="button"
      <%= server.Suspended ? 'disabled' : '' %>
      class="al-btn-danger-outline min-h-11">
      <%- icon('zap', { class: 'w-4 h-4', strokeWidth: 2 }) %>
      <%= t('kill') %>
    </button>
  </div>

  <!-- Console -->
  <div class="al-card al-card-flush">
    <div class="al-console-bar">
      <span class="al-console-label"><%= t('console') %></span>
      <span id="consoleStatus" class="al-console-status">--</span>
    </div>
    <div id="terminal-container" class="al-console-screen">
      <div id="terminal"></div>
    </div>
    <div class="al-console-inputbar">
      <p id="consoleReadOnlyNotice" class="al-console-notice hidden"><%= t('viewOnlyNotice') %></p>
      <input id="consoleInput" type="text" autocomplete="off"
        placeholder="<%= t('typeACommand') %>"
        aria-label="<%= t('typeACommand') %>"
        <%= server.Suspended ? 'disabled' : '' %>
        class="al-console-input">
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
(function() {
  var serverId = '<%= server.UUID %>';
  var suspended = <%= !!server.Suspended %>;
  var powerSent = <%- JSON.stringify({
    start: t('powerActionSent', { action: t('start') }),
    restart: t('powerActionSent', { action: t('restart') }),
    stop: t('powerActionSent', { action: t('stop') }),
    kill: t('powerActionSent', { action: t('kill') })
  }) %>;

  document.getElementById('startBtn').addEventListener('click', function() {
    powerAction('start');
  });
  document.getElementById('restartBtn').addEventListener('click', function() {
    powerAction('restart');
  });
  document.getElementById('stopBtn').addEventListener('click', function() {
    powerAction('stop');
  });
  document.getElementById('killBtn').addEventListener('click', function() {
    powerAction('kill');
  });

  function powerAction(action) {
    if (suspended) return;
    fetch('/server/' + serverId + '/power/' + action, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken }
    }).then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success !== false) showToast(powerSent[action], 'success');
      else showToast(d.error || '<%= t('commandFailed') %>', 'error');
    }).catch(function() { showToast('<%= t('requestFailed') %>', 'error'); });
  }
})();
</script>

<%- include('../../layouts/user-footer') %>
