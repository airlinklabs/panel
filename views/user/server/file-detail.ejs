<%- include('../../layouts/user', { title: (server.name || t('server')) + ' — ' + (file.name || t('files')) }) %>
<%
  var isDir = file.type === 'directory';
  var filePath = (parentPath === '/' ? '' : parentPath) + '/' + (file.name || '');
  var downloadHref = '/server/' + server.UUID + '/files/download' +
    filePath.split('/').map(encodeURIComponent).join('/');
  var filesHref = '/server/' + server.UUID + '/files?path=' + encodeURIComponent(parentPath || '/');
  function fmtSize(bytes) {
    var n = Number(bytes);
    if (!isFinite(n) || n < 0) return '—';
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
    if (n < 1024 * 1024 * 1024) return (n / 1024 / 1024).toFixed(1) + ' MB';
    return (n / 1024 / 1024 / 1024).toFixed(2) + ' GB';
  }
%>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name, url: '/server/' + server.UUID },
    { label: t('files'), url: filesHref },
    { label: file.name || '/' }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title break-all"><%= file.name || '/' %></h1>
    <p class="al-page-desc break-all"><%= filePath %></p>
  </div>
  <div>
    <a class="al-btn-secondary min-h-11" href="<%= filesHref %>">
      <%- icon('arrow-left', { class: 'size-4', strokeWidth: 2 }) %>
      <%= t('backToFiles') %>
    </a>
    <% if (!isDir) { %>
      <a class="al-btn-primary min-h-11" href="<%= downloadHref %>">
        <%- icon('download', { class: 'size-4', strokeWidth: 2 }) %>
        <%= t('download') %>
      </a>
    <% } %>
  </div>
</header>

<div class="al-page-body">
  <div class="al-card">
    <div class="flex items-center gap-4 mb-6 pb-6" style="border-bottom:1px solid var(--theme-border);">
      <div class="al-icon-tile al-icon-tile-lg shrink-0">
        <%- icon(isDir ? 'folder' : 'file', { class: 'w-6 h-6', strokeWidth: 1.5 }) %>
      </div>
      <div class="min-w-0">
        <p class="text-sm font-medium truncate al-text-strong"><%= file.name || '/' %></p>
        <p class="text-xs truncate al-text-muted"><%= parentPath === '/' ? '/' : parentPath %></p>
      </div>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
      <div>
        <dt class="al-section-label mb-1"><%= t('type') %></dt>
        <dd class="text-sm m-0 al-text-strong"><%= isDir ? t('directory') : t('fileLabel') %></dd>
      </div>
      <div>
        <dt class="al-section-label mb-1"><%= t('size') %></dt>
        <dd class="text-sm m-0 font-mono tabular-nums al-text-strong"><%= isDir ? '—' : fmtSize(file.size) %></dd>
      </div>
      <div>
        <dt class="al-section-label mb-1"><%= t('extension') %></dt>
        <dd class="text-sm m-0 font-mono al-text-strong"><%= file.extension ? '.' + String(file.extension).replace(/^\./, '') : '—' %></dd>
      </div>
      <div>
        <dt class="al-section-label mb-1"><%= t('category') %></dt>
        <dd class="text-sm m-0 al-text-strong"><%= file.category || '—' %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="al-section-label mb-1"><%= t('path') %></dt>
        <dd class="text-sm m-0 break-all font-mono al-text-strong"><%= filePath %></dd>
      </div>
    </dl>
  </div>
</div>

<%- include('../../layouts/user-footer') %>
