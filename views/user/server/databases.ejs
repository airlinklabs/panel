<%- include('../../layouts/user', { title: t('databases') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name || t('server'), url: '/server/' + server.UUID },
    { label: t('databases') }
  ] }) %>
</div>

<header class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= server.name || t('server') %></h1>
    <p class="al-page-desc flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if (server.node) { %><span class="inline-flex items-center gap-1"><%- icon('server', { class: 'w-3.5 h-3.5' }) %> <%= server.node.name %></span><% } %>
      <span class="inline-flex items-center gap-1"><%- icon('hash', { class: 'w-3.5 h-3.5' }) %> <span class="font-mono"><%= server.UUID %></span></span>
    </p>
  </div>
  <% if (hosts && hosts.length > 0) { %>
  <div>
    <button id="newDatabaseBtn" onclick="openAddDatabaseModal()" type="button" class="al-btn-primary min-h-11">
      <%- icon('plus', { class: 'w-4 h-4', strokeWidth: 1.5 }) %>
      <%= t('newDatabase') %>
    </button>
  </div>
  <% } %>
</header>

<!-- Database List -->
<div class="al-page-body" id="server-db-container">
  <% if (!hosts || hosts.length === 0) { %>
    <div class="al-alert-danger">
      <%- icon('database', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
      <div class="flex-1">
        <p class="al-alert-title"><%= t('noDbHostsConfigured') %></p>
        <p class="al-alert-body"><%= t('noDbHostsConfiguredDesc') %></p>
      </div>
    </div>
  <% } else if (!databases || databases.length === 0) { %>
    <%- include('../../partials/empty-state', {
      iconName: 'database',
      title: t('noDatabasesYet'),
      description: t('noDatabasesYetDesc'),
      action: '<button type="button" onclick="openAddDatabaseModal()" class="al-btn-primary min-h-11">' + icon('plus', { class: 'w-4 h-4', strokeWidth: 1.5 }) + ' ' + t('createDatabase') + '</button>'
    }) %>
  <% } else { %>
    <div class="mb-3">
      <span class="al-chip" data-db-count><%= databases.length %>/<%= typeof userDbLimit !== 'undefined' && userDbLimit > 0 ? userDbLimit : '∞' %> <%= t('databases').toLowerCase() %></span>
    </div>
    <div class="al-table-wrapper">
      <div class="overflow-x-auto">
        <table class="al-table al-table-card w-full sm:min-w-[900px]">
          <thead class="al-table-thead">
            <tr>
              <th scope="col" class="al-table-th w-48"><%= t('name') %></th>
              <th scope="col" class="al-table-th w-44"><%= t('host') %></th>
              <th scope="col" class="al-table-th"><%= t('connectionStringLabel') %></th>
              <th scope="col" class="al-table-th w-40"><%= t('usernameLabel') %></th>
              <th scope="col" class="al-table-th w-44"><%= t('passwordLabel') %></th>
              <th scope="col" class="al-table-th w-36 text-right"><%= t('actionsColumn') %></th>
            </tr>
          </thead>
          <tbody>
            <% databases.forEach(function(db) { %>
              <tr class="al-table-tr" data-db-id="<%= db.id %>" data-db-name="<%= db.databaseName %>">
                <td class="al-table-td" data-label="<%= t('name') %>">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-sm font-medium truncate max-w-[10rem]" style="color:var(--theme-text-strong)" title="<%= db.databaseName %>"><%= db.databaseName %></span>
                    <span class="al-chip shrink-0">MySQL</span>
                  </div>
                  <div class="text-[11px] mt-1 flex items-center gap-1.5" style="color:var(--theme-text-muted)">
                    <%- icon('calendar', { class: 'size-3 shrink-0' }) %>
                    <%= t('createdLabel') %> <%= db.createdAt ? new Date(db.createdAt).toLocaleDateString() + ' ' + new Date(db.createdAt).toLocaleTimeString() : '—' %>
                  </div>
                </td>
                <td class="al-table-td" data-label="<%= t('host') %>">
                  <div class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= db.host ? db.host.name : '—' %></div>
                  <div class="text-[11px] font-mono mt-0.5" style="color:var(--theme-text-muted)"><%= db.host ? db.host.host + ':' + db.host.port : '—' %></div>
                </td>
                <td class="al-table-td" data-label="<%= t('connectionStringLabel') %>">
                  <div class="flex items-center gap-1.5">
                    <span data-role="dsn" class="flex-1 min-w-0 break-all font-mono text-[11px]" style="color:var(--theme-text-strong)">mysql://<%= db.databaseUser %>:<%= db.databasePassword %>@<%= db.host ? db.host.host + ':' + db.host.port : '' %>/<%= db.databaseName %></span>
                    <button type="button" data-action="copy-dsn" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('copyConnectionString') %>">
                      <%- icon('copy', { class: 'w-4 h-4', strokeWidth: 1.5 }) %>
                    </button>
                  </div>
                </td>
                <td class="al-table-td" data-label="<%= t('usernameLabel') %>">
                  <div class="flex items-center gap-1.5">
                    <span data-role="user" class="flex-1 min-w-0 truncate font-mono text-xs" style="color:var(--theme-text-strong)"><%= db.databaseUser %></span>
                    <button type="button" data-action="copy-user" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('copyUsername') %>">
                      <%- icon('copy', { class: 'w-4 h-4', strokeWidth: 1.5 }) %>
                    </button>
                  </div>
                </td>
                <td class="al-table-td" data-label="<%= t('passwordLabel') %>">
                  <div class="flex items-center gap-1">
                    <span data-role="pass" class="hidden flex-1 min-w-0 truncate font-mono text-xs" style="color:var(--theme-text-strong)"><%= db.databasePassword %></span>
                    <span data-role="pass-mask" class="flex-1 min-w-0 truncate font-mono text-xs" style="color:var(--theme-text-strong)">••••••••••••••••</span>
                    <button type="button" data-action="toggle-pass" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('showPassword') %>">
                      <%- icon('eye', { class: 'w-4 h-4', strokeWidth: 1.5 }) %>
                    </button>
                    <button type="button" data-action="copy-pass" class="al-btn-ghost al-btn-icon-only shrink-0" aria-label="<%= t('copyPassword') %>">
                      <%- icon('copy', { class: 'w-4 h-4', strokeWidth: 1.5 }) %>
                    </button>
                  </div>
                </td>
                <td class="al-table-td whitespace-nowrap text-right" data-label="<%= t('actionsColumn') %>">
                  <div class="flex items-center justify-end gap-1.5">
                    <button type="button" data-action="rotate" data-db-id="<%= db.id %>" data-db-name="<%= db.databaseName %>"
                      class="al-btn-secondary al-btn-sm min-h-11">
                      <%- icon('refresh-cw', { class: 'w-3.5 h-3.5', strokeWidth: 2 }) %>
                      <%= t('rotate') %>
                    </button>
                    <button type="button" data-action="delete" data-db-id="<%= db.id %>" data-db-name="<%= db.databaseName %>"
                      class="al-btn-danger al-btn-icon-only"
                      aria-label="<%= t('deleteDatabaseAria') %>">
                      <%- icon('trash-2', { class: 'w-4 h-4', strokeWidth: 1.5 }) %>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>

<!-- Create Database Modal -->
<div id="addDatabaseModal" class="al-sheet-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="addDatabaseModalTitle">
  <div class="al-sheet-panel w-full sm:max-w-md flex flex-col rounded-2xl shadow-xl" style="background:var(--theme-bg-card);">
    <div class="al-sheet-header">
      <div class="min-w-0">
        <h3 id="addDatabaseModalTitle" class="al-card-title"><%= t('createDatabase') %></h3>
        <p class="al-card-subtitle"><%= t('dbProvisionHint') %></p>
      </div>
      <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" data-close-db-modal aria-label="<%= t('close') %>"><%- icon('x', { class: 'w-5 h-5' }) %></button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4">
      <div class="al-form-field">
        <label for="dbHostSelect" class="al-form-label"><%= t('databaseHostLabel') %></label>
        <select id="dbHostSelect" class="al-form-select">
          <% if (hosts) { hosts.forEach(function(host) { %>
            <option value="<%= host.id %>"><%= host.name %> (<%= host.host %>:<%= host.port %>)</option>
          <% }); } %>
        </select>
      </div>
    </div>
    <div class="al-sheet-footer justify-end">
      <button type="button" data-close-db-modal class="al-btn-secondary al-btn-sm min-h-11"><%= t('cancel') %></button>
      <button type="button" id="confirmAddDatabase" class="al-btn-primary al-btn-sm min-h-11">
        <%- icon('plus', { class: 'w-3.5 h-3.5', strokeWidth: 1.5 }) %><span><%= t('createDatabaseBtn') %></span>
      </button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
(function() {
  var serverId = '<%= server.UUID %>';
  var T = <%- JSON.stringify({
    selectDbHost: t('selectDbHost'),
    databaseCreated: t('databaseCreated'),
    failedCreateDatabase: t('failedCreateDatabase'),
    requestFailed: t('requestFailed'),
    copied: t('copied'),
    showPassword: t('showPassword'),
    hidePassword: t('hidePassword'),
    rotate: t('rotate'),
    rotatePasswordTitle: t('rotatePasswordTitle'),
    rotatePasswordConfirm: t('rotatePasswordConfirm'),
    passwordRotated: t('passwordRotated'),
    deleteDatabaseTitle: t('deleteDatabaseTitle'),
    deleteDatabaseConfirm: t('deleteDatabaseConfirm'),
    databaseDeleted: t('databaseDeleted'),
    delete: t('delete')
  }) %>;

  // Modal open/close
  var modal = document.getElementById('addDatabaseModal');
  window.openAddDatabaseModal = function() {
    modal.style.display = 'flex';
    document.getElementById('dbHostSelect').focus();
  };
  function closeModal() { modal.style.display = 'none'; }
  window.closeAddDatabaseModal = closeModal;
  document.querySelectorAll('[data-close-db-modal]').forEach(function(btn) { btn.addEventListener('click', closeModal); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

  // Create database
  document.getElementById('confirmAddDatabase').addEventListener('click', async function() {
    var hostId = document.getElementById('dbHostSelect').value;
    if (!hostId) { showToast(T.selectDbHost, 'error'); return; }
    var btn = this;
    btn.disabled = true;
    try {
      var response = await fetch('/server/' + serverId + '/databases', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ hostId: hostId })
      });
      var result = await response.json().catch(function() { return {}; });
      if (response.ok && result.success !== false) {
        showToast(T.databaseCreated, 'success');
        closeModal();
        window.location.reload();
      } else {
        showToast(result.error || T.failedCreateDatabase, 'error');
      }
    } catch(e) {
      showToast(T.requestFailed, 'error');
    } finally { btn.disabled = false; }
  });

  // Copy, toggle, rotate, delete actions
  document.getElementById('server-db-container').addEventListener('click', async function(e) {
    var btn = e.target.closest('[data-action]');
    if (!btn) return;
    var action = btn.dataset.action;

    if (action === 'toggle-pass') {
      var row = btn.closest('tr');
      var pass = row.querySelector('[data-role="pass"]');
      var mask = row.querySelector('[data-role="pass-mask"]');
      var revealed = pass.classList.toggle('hidden') === false;
      mask.classList.toggle('hidden', revealed);
      btn.setAttribute('aria-label', revealed ? T.hidePassword : T.showPassword);
    }

    if (action === 'copy-dsn' || action === 'copy-user' || action === 'copy-pass') {
      var row = btn.closest('tr');
      var role = action === 'copy-dsn' ? 'dsn' : (action === 'copy-user' ? 'user' : 'pass');
      var text = row.querySelector('[data-role="' + role + '"]').textContent;
      navigator.clipboard.writeText(text).then(function() { showToast(T.copied, 'success'); });
    }

    if (action === 'rotate') {
      var dbId = btn.dataset.dbId;
      await new Promise(function(resolve) {
        window.modal.confirm({
          title: T.rotatePasswordTitle,
          body: T.rotatePasswordConfirm,
          confirmLabel: T.rotate,
          onConfirm: resolve
        });
      });
      var response = await fetch('/server/' + serverId + '/databases/' + dbId + '/rotate-password', { method: 'POST', headers: { 'x-csrf-token': csrfToken } });
      var result = await response.json().catch(function() { return {}; });
      if (result.success !== false) { showToast(T.passwordRotated, 'success'); window.location.reload(); }
      else showToast(result.error || T.requestFailed, 'error');
    }

    if (action === 'delete') {
      var dbId = btn.dataset.dbId;
      var dbName = btn.dataset.dbName;
      await new Promise(function(resolve) {
        window.modal.confirm({
          title: T.deleteDatabaseTitle.replace('{{name}}', dbName),
          body: T.deleteDatabaseConfirm,
          danger: true,
          confirmLabel: T.delete,
          onConfirm: resolve
        });
      });
      var response = await fetch('/server/' + serverId + '/databases/' + dbId, { method: 'DELETE' });
      var result = await response.json().catch(function() { return {}; });
      if (result.success !== false) { showToast(T.databaseDeleted, 'success'); window.location.reload(); }
      else showToast(result.error || T.requestFailed, 'error');
    }
  });
})();
</script>

<%- include('../../layouts/user-footer') %>
