<%- include('../../components/header', { title: 'Databases' }) %>

<main class="h-screen m-auto text-neutral-800 dark:text-white">
  <div class="flex h-full">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/template') %>
    </div>
    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-16 pb-0 lg:pb-0">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Servers', href: '/' },
        { label: server.name, href: '/server/' + server.UUID },
        { label: 'Databases' }
      ] }) %>
      <!-- Page Header: title + meta left, buttons right -->
      <div class="px-4 sm:px-8 pt-4">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <!-- Server meta: image · node · id -->
            <div class="flex items-center gap-3 mt-1.5 flex-wrap">
              <div class="flex items-center gap-1.5">
                <%- icon('box', { class: 'h-3 w-3 shrink-0' }) %>
                <span class="text-[11px] truncate max-w-[140px]" style="color:var(--theme-text-muted)"><%= server.image.name %></span>
              </div>
              <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
              <div class="flex items-center gap-1.5">
                <%- icon('database', { class: 'h-3 w-3 shrink-0' }) %>
                <span class="text-[11px] truncate" style="color:var(--theme-text-muted)"><%= userDbCount %>/<%= typeof userDbLimit !== 'undefined' && userDbLimit > 0 ? userDbLimit : '∞' %> databases</span>
              </div>
              <% if (typeof userDbLimit !== 'undefined' && userDbLimit > 0) { %>
              <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
              <div class="flex items-center gap-1.5">
                <%- icon('shield-check', { class: 'h-3 w-3 shrink-0' }) %>
                <span class="text-[11px]" style="color:var(--theme-text-muted)">account limit</span>
              </div>
              <% } %>
              <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
              <div class="flex items-center gap-1.5">
                <%- icon('server', { class: 'h-3 w-3 shrink-0' }) %>
                <span class="text-[11px] truncate max-w-[100px]" style="color:var(--theme-text-muted)"><%= server.node.name %></span>
              </div>
              <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
              <div class="flex items-center gap-1.5">
                <%- icon('hash', { class: 'h-3 w-3 shrink-0' }) %>
                <span class="text-[11px] font-mono" style="color:var(--theme-text-muted)"><%= server.UUID.split('-')[0] %></span>
              </div>
            </div>
          </div>
          <% if (hosts.length > 0) { %>
          <div class="flex gap-2 shrink-0">
            <button onclick="openAddDatabaseModal()" type="button"
                class="al-btn-primary block rounded-xl px-3 py-2 text-center text-sm font-medium shadow-lg transition duration-300">
                <%- icon('plus', { class: 'size-4 inline-flex mr-1 mb-0.5', strokeWidth: 1.5 }) %>
                <%= req.translations.newDatabase || 'New Database' %>
            </button>
          </div>
          <% } %>
        </div>
      </div>

      <%- include('../../components/installHeader') %>

      <!-- Server Template -->
      <%- include('../../components/serverTemplate') %>

      <div id="server-page-body">

      <!-- Databases -->
      <div class="px-6 space-y-4">
        <% if (hosts.length === 0) { %>
          <div class="al-alert-danger mb-5">
            <%- icon('database', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
            <div class="flex-1">
              <p class="font-medium"><%= req.translations.noDbHostsConfigured || 'No database hosts configured' %></p>
              <p class="text-xs opacity-70 mt-0.5"><%= req.translations.noDbHostsConfiguredDesc || 'An administrator must add a database host before you can create databases.' %></p>
            </div>
          </div>
        <% } else if (databases.length === 0) { %>
          <div class="al-card rounded-lg shadow">
            <div class="p-10 text-center">
              <%- icon('database', { class: 'mx-auto h-12 w-12', style: 'color:var(--theme-text-muted)' }) %>
              <h3 class="mt-3 text-sm font-medium" style="color:var(--theme-text-strong)"><%= req.translations.noDatabasesYet || 'No databases yet' %></h3>
              <p class="mt-1 text-sm" style="color:var(--theme-text-muted)"><%= req.translations.noDatabasesYetDesc || 'Create a database to use with your server.' %></p>
              <button type="button" onclick="openAddDatabaseModal()" class="al-btn-primary inline-flex items-center gap-1.5 mt-5 rounded-xl px-4 py-2 text-sm font-medium">
                <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                <%= req.translations.createDatabase || 'Create Database' %>
              </button>
            </div>
          </div>
        <% } else { %>
          <div class="al-card rounded-xl overflow-hidden p-0">
            <% databases.forEach((db, i) => { %>
            <div class="px-4 sm:px-5 py-4<%= i > 0 ? ' border-t' : '' %>" data-db-id="<%= db.id %>" style="border-color:var(--theme-border)">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="text-sm font-semibold font-mono" style="color:var(--theme-text-strong)"><%= db.databaseName %></h3>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium font-mono" style="background:var(--theme-accent-subtle);color:var(--theme-accent)">@ <%= db.host.host %>:<%= db.host.port %></span>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)">MySQL</span>
                  </div>
                  <div class="flex items-center gap-x-4 gap-y-1 mt-1.5 flex-wrap text-[11px]" style="color:var(--theme-text-muted)">
                    <span class="flex items-center gap-1">
                      <%- icon('calendar', { class: 'w-3 h-3' }) %>
                      <%= req.translations.createdLabel || 'Created:' %> <%= new Date(db.createdAt).toLocaleString() %>
                    </span>
                    <span class="flex items-center gap-1">
                      <%- icon('server', { class: 'w-3 h-3' }) %>
                      <%= req.translations.hostLabel || 'Host:' %> <%= db.host.name %>
                    </span>
                  </div>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  <button type="button" onclick="rotatePassword(<%= db.id %>)"
                    class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2"
                    style="color:var(--theme-accent);background:var(--theme-accent-subtle)">
                    <%- icon('refresh', { class: 'w-3 h-3' }) %>
                    <%= req.translations.rotatePassword || 'Rotate password' %>
                  </button>
                  <button onclick="deleteDatabase(<%= db.id %>)" type="button" class="al-btn-ghost p-1.5 -mr-1.5" style="color:var(--theme-danger);" aria-label="<%= req.translations.deleteDatabaseAria || 'Delete database' %>">
                    <%- icon('trash-2', { size: 15 }) %>
                  </button>
                </div>
              </div>

              <!-- Credentials -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 mt-4">
                <div>
                  <p class="text-[11px] font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= req.translations.usernameLabel || 'Username' %></p>
                  <div class="flex items-center gap-1.5 rounded-lg px-3 py-2" style="background:var(--theme-bg-secondary)">
                    <span id="db-user-<%= db.id %>" class="flex-1 min-w-0 truncate font-mono text-xs" style="color:var(--theme-text-strong)"><%= db.databaseUser %></span>
                    <button type="button" onclick="copyText('<%= db.databaseUser %>')" class="al-btn-ghost p-1 -mr-1.5 shrink-0" aria-label="<%= req.translations.copyUsername || 'Copy username' %>">
                      <%- icon('copy', { size: 14 }) %>
                    </button>
                  </div>
                </div>
                <div>
                  <p class="text-[11px] font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= req.translations.passwordLabel || 'Password' %></p>
                  <div class="flex items-center gap-1.5 rounded-lg px-3 py-2" style="background:var(--theme-bg-secondary)">
                    <span id="db-pass-<%= db.id %>" class="hidden flex-1 min-w-0 truncate font-mono text-xs" style="color:var(--theme-text-strong);display:none"><%= db.databasePassword %></span>
                    <span id="db-pass-mask-<%= db.id %>" class="flex-1 min-w-0 truncate font-mono text-xs" style="color:var(--theme-text-strong)">••••••••••••••••</span>
                    <button type="button" onclick="togglePassword(<%= db.id %>)" class="al-btn-ghost p-1 -mr-1.5 shrink-0" aria-label="<%= req.translations.showPassword || 'Show password' %>">
                      <%- icon('eye', { size: 14 }) %>
                    </button>
                    <button type="button" onclick="copyText(document.getElementById('db-pass-<%= db.id %>').textContent)" class="al-btn-ghost p-1 -mr-1.5 shrink-0" aria-label="<%= req.translations.copyPassword || 'Copy password' %>">
                      <%- icon('copy', { size: 14 }) %>
                    </button>
                  </div>
                </div>
                <div class="md:col-span-2">
                  <p class="text-[11px] font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= req.translations.connectionString || 'Connection string' %></p>
                  <div class="flex items-center gap-1.5 rounded-lg px-3 py-2" style="background:var(--theme-bg-secondary)">
                    <span id="db-dsn-<%= db.id %>" class="flex-1 min-w-0 truncate font-mono text-[11px]" style="color:var(--theme-text-strong)">
                      mysql://<%= db.databaseUser %>:<%= db.databasePassword %>@<%= db.host.host %>:<%= db.host.port %>/<%= db.databaseName %>
                    </span>
                    <button type="button" onclick="copyText(document.getElementById('db-dsn-<%= db.id %>').textContent)" class="al-btn-ghost p-1 -mr-1.5 shrink-0" aria-label="<%= req.translations.copyConnectionString || 'Copy connection string' %>">
                      <%- icon('copy', { size: 14 }) %>
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
        <% } %>
      </div>
      </div>
    </div>
  </div>
</main>

<!-- Add Database Modal -->
<div id="addDatabaseModal" class="al-sheet-overlay fixed inset-0 z-50 hidden items-center justify-center" aria-hidden="true">
  <div class="absolute inset-0 bg-transparent" aria-hidden="true" onclick="closeAddDatabaseModal()"></div>
  <div id="addDatabasePanel" class="al-sheet-panel relative w-full max-w-md mx-4 rounded-2xl shadow-2xl p-6" role="dialog" aria-modal="true" aria-labelledby="addDatabaseTitle" tabindex="-1" style="background:var(--theme-bg-card); border:1px solid var(--theme-border)">
    <div class="flex items-center justify-between mb-5">
      <h3 id="addDatabaseTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= req.translations.createDatabase || 'Create Database' %></h3>
      <button type="button" onclick="closeAddDatabaseModal()" class="al-btn-ghost p-1.5 -mr-1.5" aria-label="Close">
        <%- icon('x', { class: 'w-4 h-4' }) %>
      </button>
    </div>
    <div class="space-y-4">
      <div>
        <label class="al-label"><%= req.translations.databaseHostLabel || 'Database host' %></label>
        <select id="dbHostSelect" class="al-input w-full">
          <% hosts.forEach(host => { %>
            <option value="<%= host.id %>"><%= host.name %> (<%= host.host %>:<%= host.port %>)</option>
          <% }); %>
        </select>
        <p class="mt-1.5 text-[11px]" style="color:var(--theme-text-muted)"><%= req.translations.dbProvisionHint || 'A database, user and password will be provisioned on this host.' %></p>
      </div>
      <div class="flex gap-2 pt-1">
        <button type="button" onclick="closeAddDatabaseModal()" class="al-btn-secondary flex-1 inline-flex items-center gap-1.5">
          <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>
          <%= req.translations.cancel || 'Cancel' %>
        </button>
        <button type="button" id="confirmAddDatabase" class="al-btn-primary flex-1 inline-flex items-center gap-1.5">
          <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
          <%= req.translations.createDatabaseBtn || 'Create database' %>
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../../components/toast') %>

<script nonce="<%- nonce %>">
const t = <%= JSON.stringify(req.translations) %>;
const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
const serverId = '<%= server.UUID %>';

const { showToast } = typeof createToastSystem === 'function' ? createToastSystem() : { showToast: (m) => console.warn('[databases]', m) };

function getFocusableElements(panel) {
  return Array.from((panel || document).querySelectorAll('a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'))
    .filter((el) => !el.disabled && el.offsetParent !== null);
}

let lastAddModalFocus = null;

window.openAddDatabaseModal = () => {
  lastAddModalFocus = document.activeElement;
  document.getElementById('dbHostSelect').value = document.querySelector('#dbHostSelect option')?.value || '';
  Animate.openModal(document.getElementById('addDatabaseModal'), document.getElementById('addDatabasePanel'));
  const focusable = getFocusableElements(document.getElementById('addDatabasePanel'));
  (focusable[0] || document.getElementById('addDatabasePanel')).focus();
};

window.closeAddDatabaseModal = () => {
  Animate.closeModal(document.getElementById('addDatabaseModal'), document.getElementById('addDatabasePanel'));
  if (lastAddModalFocus) lastAddModalFocus.focus();
};

document.addEventListener('keydown', (e) => {
  const modal = document.getElementById('addDatabaseModal');
  if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
    e.preventDefault();
    closeAddDatabaseModal();
    return;
  }
  if (e.key === 'Tab' && !modal.classList.contains('hidden')) {
    const focusable = getFocusableElements(document.getElementById('addDatabasePanel'));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }
});

document.getElementById('confirmAddDatabase')?.addEventListener('click', async () => {
  const hostId = document.getElementById('dbHostSelect').value;
  if (!hostId) {
    showToast(t.selectDbHost || 'Select a database host.', 'error');
    return;
  }
  const btn = document.getElementById('confirmAddDatabase');
  btn.disabled = true;
  try {
    const response = await fetch('/server/' + serverId + '/databases', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'csrf-token': csrfToken },
      body: JSON.stringify({ hostId }),
    });
    const result = await response.json();
    if (response.ok && result.success) {
      showToast(t.databaseCreated || 'Database created.', 'success');
      closeAddDatabaseModal();
      window.location.reload();
    } else {
      showToast(result.error || t.failedCreateDatabase || 'Failed to create database.', 'error');
    }
  } catch {
    showToast(t.requestFailed || 'Request failed. Try again?', 'error');
  } finally {
    btn.disabled = false;
  }
});

window.copyText = (text) => {
  navigator.clipboard.writeText(text).then(
    () => showToast(t.copiedToClipboard || 'Copied to clipboard.', 'success'),
    () => showToast(t.couldNotCopy || 'Could not copy.', 'error'),
  );
};

window.togglePassword = (id) => {
  const pass = document.getElementById('db-pass-' + id);
  const mask = document.getElementById('db-pass-mask-' + id);
  const hidden = pass.style.display === 'none';
  pass.style.display = hidden ? 'flex' : 'none';
  mask.style.display = hidden ? 'none' : 'flex';
};

window.rotatePassword = async (id) => {
  window.modal.confirm({
    title: t.rotatePasswordTitle || 'Rotate password',
    body: t.rotatePasswordConfirm || 'Generate a new password for this database user? Existing connections will be dropped.',
    confirmLabel: t.rotate || 'Rotate',
    onConfirm: async () => {
      try {
        const response = await fetch(`/server/${serverId}/databases/${id}/rotate-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'csrf-token': csrfToken },
        });
        const result = await response.json();
        if (response.ok && result.success) {
          const passEl = document.getElementById('db-pass-' + id);
          passEl.textContent = result.password;
          const dsnEl = document.getElementById('db-dsn-' + id);
          dsnEl.textContent = dsnEl.textContent.replace(/:[^@]+@/, ':' + result.password + '@');
          showToast(t.passwordRotated || 'Password rotated.', 'success');
        } else {
          showToast(result.error || t.failedRotatePassword || 'Failed to rotate password.', 'error');
        }
      } catch {
        showToast(t.requestFailed || 'Request failed. Try again?', 'error');
      }
    },
  });
};

window.deleteDatabase = async (id) => {
  window.modal.confirm({
    title: t.deleteDatabaseTitle || 'Delete database',
    body: t.deleteDatabaseConfirm || 'This will permanently delete the database and its user from the host. This cannot be undone.',
    danger: true,
    confirmLabel: t.delete || 'Delete',
    onConfirm: async () => {
      try {
        const response = await fetch(`/server/${serverId}/databases/${id}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'csrf-token': csrfToken },
        });
        const result = await response.json();
        if (response.ok && result.success) {
          showToast(t.databaseDeleted || 'Database deleted.', 'success');
          window.location.reload();
        } else {
          showToast(result.error || t.failedDeleteDatabase || 'Failed to delete database.', 'error');
        }
      } catch {
        showToast(t.requestFailed || 'Request failed. Try again?', 'error');
      }
    },
  });
};
</script>

<%- include('../../components/footer') %>
