<%- include('../../components/header', { title: 'Activity' }) %>
<%- include('../../components/serverFeatures') %>

<% if (isMobileViewport) { %>
<main id="page-content" class="">
  <%- include('../../components/template') %>

  <div class="px-4 pt-5">
    <div class="mb-4">
      <div class="flex items-start justify-between gap-3">
        <%- include('../../components/serverHeader') %>
      </div>
      <div class="px-0 mt-1">
        <%- include('../../components/loadingPopup') %>
      </div>
    </div>

    <%- include('../../components/serverTemplate') %>

    <%- include('../../components/installHeader') %>

    <div class="mt-3">
      <nav class="flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 mb-3">
        <a href="/server/<%= server.UUID %>" class="hover:text-neutral-800 dark:hover:text-white transition">Server</a>
        <%- icon('chevron-right', { class: 'w-3 h-3 shrink-0' }) %>
        <span class="text-neutral-800 dark:text-white font-medium">Activity</span>
      </nav>

      <div data-animate-card class="rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-4">
        <p class="text-sm font-medium text-neutral-800 dark:text-white mb-3">Activity Log</p>

        <% if (typeof activities !== 'undefined' && activities.length > 0) { %>
          <div class="space-y-0">
            <% activities.forEach((activity, idx) => { %>
              <div class="flex gap-3 <%= idx < activities.length - 1 ? 'pb-3 mb-3 border-b border-neutral-100 dark:border-white/5' : '' %>" style="--i:<%= idx %>">
                <div class="relative shrink-0">
                  <div class="w-8 h-8 rounded-full bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-neutral-600/30 flex items-center justify-center">
                    <% if (activity.action === 'start') { %>
                      <%- icon('play', { class: 'w-3.5 h-3.5 text-emerald-500' }) %>
                    <% } else if (activity.action === 'stop') { %>
                      <%- icon('square', { class: 'w-3.5 h-3.5 text-red-500' }) %>
                    <% } else if (activity.action === 'restart') { %>
                      <%- icon('refresh-cw', { class: 'w-3.5 h-3.5 text-amber-500' }) %>
                    <% } else if (activity.action === 'install') { %>
                      <%- icon('download', { class: 'w-3.5 h-3.5 text-blue-500' }) %>
                    <% } else { %>
                      <%- icon('activity', { class: 'w-3.5 h-3.5 text-neutral-400' }) %>
                    <% } %>
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-medium text-neutral-800 dark:text-white capitalize"><%= activity.action %></p>
                  <% if (activity.detail) { %>
                    <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5 truncate"><%= activity.detail %></p>
                  <% } %>
                  <p class="text-[10px] text-neutral-400 dark:text-neutral-500 mt-0.5">
                    <% if (activity.user) { %><span class="font-medium"><%= activity.user %></span> · <% } %>
                    <%= new Date(activity.timestamp).toLocaleString() %>
                  </p>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="py-8 text-center">
            <%- icon('activity', { size: 16, class: 'text-neutral-400 mx-auto mb-2' }) %>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">No activity recorded yet.</p>
          </div>
        <% } %>

        <% if (typeof hasMore !== 'undefined' && hasMore) { %>
          <div class="mt-3 text-center">
            <button id="load-more-btn" type="button" onclick="loadMore()" class="rounded-xl border border-neutral-200 dark:border-neutral-700/40 bg-white dark:bg-neutral-800 px-4 py-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-700 transition active:scale-95">
              Load more
            </button>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</main>

<% } else { %>
<main class="h-screen m-auto text-neutral-800 dark:text-white">
  <div class="flex h-screen">
    <div class="w-60 h-full">
      <%- include('../../components/template') %>
    </div>

    <div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-16">
      <div class="px-8 pt-4">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <%- include('../../components/serverHeader') %>
            <div class="flex items-center gap-3 mt-1.5 flex-wrap">
              <div class="flex items-center gap-1.5">
                <%- icon('box', { class: 'h-3 w-3 text-neutral-400 shrink-0' }) %>
                <span class="text-[11px] text-neutral-500 dark:text-neutral-400 truncate max-w-[140px]"><%= server.image ? server.image.name : 'Unknown' %></span>
              </div>
              <span class="text-neutral-300 dark:text-neutral-600 text-[11px]">·</span>
              <div class="flex items-center gap-1.5">
                <%- icon('server', { class: 'h-3 w-3 text-neutral-400 shrink-0' }) %>
                <span class="text-[11px] text-neutral-500 dark:text-neutral-400 truncate max-w-[100px]"><%= server.node ? server.node.name : 'Unknown' %></span>
              </div>
              <span class="text-neutral-300 dark:text-neutral-600 text-[11px]">·</span>
              <div class="flex items-center gap-1.5">
                <%- icon('hash', { class: 'h-3 w-3 text-neutral-400 shrink-0' }) %>
                <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400"><%= server.UUID.split('-')[0] %></span>
              </div>
            </div>
          </div>
        </div>

        <% if (server.Suspended) { %>
        <div class="mt-3 bg-red-500/10 border border-red-500/20 rounded-xl px-4 py-3 flex items-center gap-3">
          <%- icon('triangle-alert', { class: 'h-5 w-5 shrink-0 text-red-500' }) %>
          <div>
            <p class="text-sm font-medium text-red-500"><%= req.translations.serverSuspended || "This server's been grounded. Reach out to your admin if you think that's a mistake." %></p>
          </div>
        </div>
        <% } %>

        <div id="daemonOfflineWarningRow" class="<% if (typeof serverStatus === 'undefined' || !serverStatus.daemonOffline) { %>hidden<% } %> mt-3">
          <div id="daemonOfflineWarning" class="data-animate-card bg-red-500/10 border border-red-500/20 rounded-xl px-4 py-3 flex items-center gap-3">
            <%- icon('triangle-alert', { class: 'h-5 w-5 shrink-0 text-red-500' }) %>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-red-500"><%= (typeof serverStatus !== 'undefined' && serverStatus.error) ? serverStatus.error : 'This node isn\'t talking to us right now. Check the daemon.' %></p>
            </div>
            <button onclick="window.location.reload()" class="shrink-0 px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white text-xs font-medium rounded-xl transition">
              Retry Connection
            </button>
          </div>
        </div>
      </div>

      <%- include('../../components/serverTemplate') %>
      <%- include('../../components/installHeader') %>

      <div class="px-8 mt-4 pb-8">
        <nav class="flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 mb-4">
          <a href="/server/<%= server.UUID %>" class="hover:text-neutral-800 dark:hover:text-white transition">Server</a>
          <%- icon('chevron-right', { class: 'w-3 h-3 shrink-0' }) %>
          <span class="text-neutral-800 dark:text-white font-medium">Activity</span>
        </nav>

        <div data-animate-card class="bg-neutral-50 dark:bg-neutral-800 rounded-2xl border border-neutral-200 dark:border-white/5 p-5">
          <div class="flex items-center justify-between mb-5">
            <div>
              <p class="text-sm font-medium text-neutral-800 dark:text-white">Activity Log</p>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">Recent actions on this server.</p>
            </div>
          </div>

          <% if (typeof activities !== 'undefined' && activities.length > 0) { %>
            <div class="relative">
              <div class="absolute left-4 top-0 bottom-0 w-px bg-neutral-200 dark:bg-white/5"></div>
              <div class="space-y-0">
                <% activities.forEach((activity, idx) => { %>
                  <div class="relative flex gap-4 pb-5 <%= idx === activities.length - 1 ? 'pb-0' : '' %>" style="--i:<%= idx %>">
                    <div class="relative z-10 shrink-0">
                      <div class="w-8 h-8 rounded-full bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-neutral-600/30 flex items-center justify-center">
                        <% if (activity.action === 'start') { %>
                          <%- icon('play', { class: 'w-3.5 h-3.5 text-emerald-500' }) %>
                        <% } else if (activity.action === 'stop') { %>
                          <%- icon('square', { class: 'w-3.5 h-3.5 text-red-500' }) %>
                        <% } else if (activity.action === 'restart') { %>
                          <%- icon('refresh-cw', { class: 'w-3.5 h-3.5 text-amber-500' }) %>
                        <% } else if (activity.action === 'install') { %>
                          <%- icon('download', { class: 'w-3.5 h-3.5 text-blue-500' }) %>
                        <% } else { %>
                          <%- icon('activity', { class: 'w-3.5 h-3.5 text-neutral-400' }) %>
                        <% } %>
                      </div>
                    </div>
                    <div class="min-w-0 flex-1 pt-1">
                      <div class="flex items-center gap-2">
                        <p class="text-sm font-medium text-neutral-800 dark:text-white capitalize"><%= activity.action %></p>
                        <% if (activity.user) { %>
                          <span class="text-[11px] text-neutral-500 dark:text-neutral-400">by <span class="font-medium text-neutral-700 dark:text-neutral-300"><%= activity.user %></span></span>
                        <% } %>
                      </div>
                      <% if (activity.detail) { %>
                        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5"><%= activity.detail %></p>
                      <% } %>
                      <p class="text-[11px] text-neutral-400 dark:text-neutral-500 mt-1"><%= new Date(activity.timestamp).toLocaleString() %></p>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } else { %>
            <div class="py-12 text-center">
              <%- icon('activity', { size: 16, class: 'text-neutral-400 mx-auto mb-2' }) %>
              <p class="text-sm text-neutral-500 dark:text-neutral-400">No activity recorded yet.</p>
              <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">Actions like starting, stopping, and restarting will appear here.</p>
            </div>
          <% } %>

          <% if (typeof hasMore !== 'undefined' && hasMore) { %>
            <div class="mt-5 text-center">
              <button id="load-more-btn" type="button" onclick="loadMore()" class="rounded-xl border border-neutral-200 dark:border-neutral-700/40 bg-white dark:bg-neutral-800 px-4 py-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-700 transition active:scale-95">
                Load more
              </button>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</main>
<% } %>

<%- include('../../components/toast') %>
<%- include('../../components/modal') %>

<script nonce="<%- nonce %>">
document.addEventListener('DOMContentLoaded', () => {
  let page = <%= typeof page !== 'undefined' ? page : 1 %>;
  const serverUUID = '<%= server.UUID %>';

  window.loadMore = async function() {
    const btn = document.getElementById('load-more-btn');
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Loading...';

    try {
      page++;
      const res = await fetch(`/server/${serverUUID}/activity?page=${page}`, { headers: { 'Accept': 'application/json' } });
      const data = await res.json();

      if (res.ok && data.activities && data.activities.length > 0) {
        const container = document.querySelector('#backup-codes') ? null : document.querySelector('[data-animate-card] > div:last-child') || document.querySelector('[data-animate-card]');
        const timeline = document.querySelector('.space-y-0');

        if (timeline) {
          data.activities.forEach(activity => {
            const actionColors = {
              start: 'text-emerald-500',
              stop: 'text-red-500',
              restart: 'text-amber-500',
              install: 'text-blue-500'
            };
            const actionIcons = {
              start: 'play',
              stop: 'square',
              restart: 'refresh-cw',
              install: 'download'
            };
            const icon = actionIcons[activity.action] || 'activity';
            const color = actionColors[activity.action] || 'text-neutral-400';

            const item = document.createElement('div');
            item.className = 'relative flex gap-4 pb-5';
            item.innerHTML = `
              <div class="relative z-10 shrink-0">
                <div class="w-8 h-8 rounded-full bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-neutral-600/30 flex items-center justify-center">
                  <%- %><span class="${color}"><!-- icon placeholder --></span>
                </div>
              </div>
              <div class="min-w-0 flex-1 pt-1">
                <div class="flex items-center gap-2">
                  <p class="text-sm font-medium text-neutral-800 dark:text-white capitalize">${activity.action}</p>
                  ${activity.user ? `<span class="text-[11px] text-neutral-500 dark:text-neutral-400">by <span class="font-medium text-neutral-700 dark:text-neutral-300">${activity.user}</span></span>` : ''}
                </div>
                ${activity.detail ? `<p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">${activity.detail}</p>` : ''}
                <p class="text-[11px] text-neutral-400 dark:text-neutral-500 mt-1">${new Date(activity.timestamp).toLocaleString()}</p>
              </div>
            `;
            timeline.appendChild(item);
          });
        }

        if (!data.hasMore) {
          btn.parentElement?.remove();
        } else {
          btn.disabled = false;
          btn.textContent = 'Load more';
        }
      } else {
        btn.parentElement?.remove();
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Load more';
      showToast('Failed to load more activities', 'error');
    }
  };
});
</script>

<%- include('../../components/footer') %>
