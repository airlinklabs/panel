<%- include('../../components/header', { title: req.translations.adminOverviewTitle || 'Overview' }) %>

<style>
  #page-content.admin-overview-bg {
    position: relative;
    isolation: isolate;
  }
  #page-content.admin-overview-bg::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: var(--vcode-bg, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    pointer-events: none;
    opacity: 0.5;
  }
  html.dark #page-content.admin-overview-bg::before {
    filter: invert(1);
    opacity: 0.4;
  }
</style>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="admin-overview-bg flex-1 overflow-y-auto pt-0 pb-12"<% if (vcodeBg) { %> style="--vcode-bg: url('<%= vcodeBg %>');"<% } %> x-data="adminOverview()">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Overview' }
      ] }) %>
      <div class="al-page-header">
        <h1 class="al-page-title"><%= req.translations.adminOverviewTitle || 'Overview' %></h1>
        <p class="al-page-desc"><%= req.translations.adminOverviewText || 'Panel information and credits.' %></p>
      </div>
      <div class="al-page-body">

        <!-- Stats grid -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
          <%- include('../../components/ui/stat-card', { label: req.translations.totalRegisteredUsers || 'Registered Users', value: userCount, href: '/admin/users', iconName: 'users' }) %>
          <%- include('../../components/ui/stat-card', { label: 'Online Servers', value: instanceCount, href: '/admin/servers', iconName: 'server' }) %>
          <%- include('../../components/ui/stat-card', { label: 'Connected Nodes', value: nodeCount, href: '/admin/nodes', iconName: 'network' }) %>
          <%- include('../../components/ui/stat-card', { label: 'Available Images', value: imageCount, href: '/admin/images', iconName: 'box' }) %>
        </div>

        <!-- Panel info + update card -->
        <div class="al-card p-4 mb-5">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2.5">
              <img src="/assets/logo.svg" class="h-8 w-8 rounded-xl shrink-0" alt="Airlink" style="background:var(--theme-logo-bg);">
              <div>
                <p class="text-[13px] font-medium" style="color:var(--theme-text-strong);">Airlink Panel <span class="font-bold"><%= airlinkCodename %></span></p>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded-md" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border); color:var(--theme-text-muted);">v<span class="current-version"></span></span>
                  <span class="text-[10px]" style="color:var(--theme-text-muted);"><%= process.env.NODE_ENV %></span>
                </div>
              </div>
            </div>
            <div class="flex gap-1.5">
              <button type="button" id="checkUpdateBtn" class="al-btn-secondary" @click="checkUpdate()">
                <%- icon('refresh-cw', { size: 14, class: 'shrink-0' }) %>
                Check for Updates
              </button>
              <button type="button" id="performUpdateBtn" class="hidden al-btn-secondary" @click="performUpdate()">
                <%- icon('download', { size: 14, class: 'shrink-0' }) %>
                <%= req.translations.update || 'Update' %>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
            <div class="rounded-xl p-3" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">
              <p class="text-[11px] font-medium mb-2" style="color:var(--theme-text-muted);">API Response Time</p>
              <div class="flex items-center justify-between mb-1.5">
                <span id="apiLatency" class="text-[13px] font-mono" style="color:var(--theme-text);">-- ms</span>
              </div>
              <div class="w-full rounded-full h-1.5" style="background:var(--theme-border);">
                <div id="latencyBar" class="h-1.5 rounded-full transition-all duration-300" style="width: 0%; background:var(--theme-text-muted);"></div>
              </div>
            </div>

            <div class="rounded-xl p-3" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border);">
              <p class="text-[11px] font-medium mb-2" style="color:var(--theme-text-muted);">Update Status</p>
              <p class="text-[11px] mb-2"><%= req.translations.sysInfoText %> <span class="font-medium" style="color:var(--theme-text);" id="current-version-inline"></span></p>
              <div id="updateStatus" class="text-[13px] hidden rounded-lg p-2.5" style="background:var(--theme-bg-secondary);"></div>
              <div id="updateInfo" class="mt-2.5 hidden"></div>
            </div>
          </div>
        </div>

        <!-- Resources -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
          <a href="https://discord.gg/BybfXms7JZ" class="group al-card hover:border-[var(--theme-border-accent)] transition-colors">
            <div class="flex items-center gap-2 mb-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" style="color:var(--theme-text-muted);" viewBox="0 0 127.14 96.36" fill="currentColor">
                <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z" />
              </svg>
              <p class="text-[13px] font-medium" style="color:var(--theme-text);">Discord</p>
            </div>
            <p class="text-[11px]" style="color:var(--theme-text-muted);">Community support and discussions</p>
          </a>

          <a href="https://airlinklabs.xyz/" target="_blank" rel="noopener noreferrer" class="group al-card hover:border-[var(--theme-border-accent)] transition-colors">
            <div class="flex items-center gap-2 mb-1.5">
              <%- icon('book-open', { size: 14, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
              <p class="text-[13px] font-medium" style="color:var(--theme-text);">Docs</p>
            </div>
            <p class="text-[11px]" style="color:var(--theme-text-muted);">Usage and configuration guides</p>
          </a>

          <a href="https://github.com/airlinklabs" class="group al-card hover:border-[var(--theme-border-accent)] transition-colors">
            <div class="flex items-center gap-2 mb-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" style="color:var(--theme-text-muted);" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              <p class="text-[13px] font-medium" style="color:var(--theme-text);">GitHub</p>
            </div>
            <p class="text-[11px]" style="color:var(--theme-text-muted);">Source code and contributions</p>
          </a>

          <a href="https://ko-fi.com/airlinklabs#checkoutModal" class="group al-card hover:border-[var(--theme-border-accent)] transition-colors">
            <div class="flex items-center gap-2 mb-1.5">
              <%- icon('credit-card', { size: 14, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
              <p class="text-[13px] font-medium" style="color:var(--theme-text);">Support</p>
            </div>
            <p class="text-[11px]" style="color:var(--theme-text-muted);">Fund Airlink development</p>
          </a>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../../components/footer') %>

<div id="page-data" style="display:none"
  data-airlink-version="<%= airlinkVersion %>"
  data-running-latest-version="<%= req.translations.runningLatestVersion %>"
></div>

<script nonce="<%- nonce %>">
function adminOverview() {
  return {
    UPDATE_RELOAD_DELAY_MS: 5000,
    UPDATE_CHECK_DELAY_MS: 220,
    API_LATENCY_POLL_INTERVAL_MS: 30000,
    LATENCY_GOOD_THRESHOLD_MS: 100,
    LATENCY_WARNING_THRESHOLD_MS: 300,
    LATENCY_MAX_MS: 500,

    init() {
      var pageData = document.getElementById('page-data').dataset;
      var currentVersion = pageData.airlinkVersion;
      var runningLatestVersion = pageData.runningLatestVersion;

      document.querySelectorAll('.current-version').forEach(el => el.textContent = currentVersion);
      var versionInline = document.getElementById('current-version-inline');
      if (versionInline) versionInline.textContent = currentVersion;

      this._runningLatestVersion = runningLatestVersion;

      this.measureApiLatency();
      setInterval(() => this.measureApiLatency(), this.API_LATENCY_POLL_INTERVAL_MS);
    },

    fadeIn(el) {
      el.style.transition = 'none';
      el.style.opacity = '0';
      el.style.transform = 'translateY(4px)';
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          el.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
          setTimeout(() => {
            el.style.transition = '';
            el.style.opacity = '';
            el.style.transform = '';
          }, this.UPDATE_CHECK_DELAY_MS);
        });
      });
    },

    async checkUpdate() {
      var self = this;
      var statusDiv = document.getElementById('updateStatus');
      statusDiv.innerHTML = '<span class="text-neutral-500">Checking...</span>';
      statusDiv.classList.remove('hidden');

      try {
        var response = await fetch('/admin/check-update');
        var data = await response.json();
        var updateBtn = document.getElementById('performUpdateBtn');
        var updateInfo = document.getElementById('updateInfo');

        if (data.hasUpdate) {
          statusDiv.innerHTML = '<span class="text-amber-600 dark:text-amber-400">Update available — v' + data.latestVersion + '</span>';
          self.fadeIn(statusDiv);
          updateBtn.classList.remove('hidden');
          updateBtn.classList.add('inline-flex');
          self.fadeIn(updateBtn);
          if (data.updateInfo) {
            updateInfo.innerHTML = '<p class="text-xs text-neutral-500">' + data.updateInfo + '</p>';
            updateInfo.classList.remove('hidden');
            self.fadeIn(updateInfo);
          }
        } else {
          statusDiv.innerHTML = '<span class="text-emerald-600 dark:text-emerald-400">' + (self._runningLatestVersion || 'Running latest version') + '</span>';
          self.fadeIn(statusDiv);
          updateBtn.classList.add('hidden');
          updateInfo.classList.add('hidden');
        }
      } catch (error) {
        statusDiv.innerHTML = '<span class="text-red-500">Failed to check for updates.</span>';
        self.fadeIn(statusDiv);
      }
    },

    performUpdate() {
      var self = this;
      window.modal.confirm({
        title: 'Install Update',
        body: 'The panel will perform the update and restart the server.',
        confirmLabel: 'Install',
        danger: false,
        onConfirm: async () => {
          var statusDiv = document.getElementById('updateStatus');
          statusDiv.innerHTML = '<span class="text-neutral-500">Installing...</span>';
          self.fadeIn(statusDiv);
          try {
            var response = await fetch('/admin/perform-update', { method: 'POST' });
            var data = await response.json();
            showToast(data.message || 'Update complete. Restarting.', 'success');
            statusDiv.innerHTML = '<span class="text-emerald-600 dark:text-emerald-400">Update successful. Restarting...</span>';
            self.fadeIn(statusDiv);
            setTimeout(() => window.location.reload(), self.UPDATE_RELOAD_DELAY_MS);
          } catch (error) {
            statusDiv.innerHTML = '<span class="text-red-500">Update failed.</span>';
            self.fadeIn(statusDiv);
            showToast('Update failed. Check the logs.', 'error');
          }
        }
      });
    },

    async measureApiLatency() {
      try {
        var start = performance.now();
        var response = await fetch('/api/v1/ping');
        var latency = Math.round(performance.now() - start);
        if (response.ok) {
          document.getElementById('apiLatency').textContent = latency + ' ms';
          var bar = document.getElementById('latencyBar');
          bar.style.width = Math.min((latency / this.LATENCY_MAX_MS) * 100, 100) + '%';
          bar.classList.remove('bg-emerald-500', 'bg-amber-500', 'bg-red-500', 'bg-neutral-400', 'dark:bg-neutral-500');
          if (latency < this.LATENCY_GOOD_THRESHOLD_MS) bar.classList.add('bg-emerald-500');
          else if (latency < this.LATENCY_WARNING_THRESHOLD_MS) bar.classList.add('bg-amber-500');
          else bar.classList.add('bg-red-500');
        }
      } catch (error) {
        document.getElementById('apiLatency').textContent = 'Error';
      }
    }
  };
}
</script>
