<%- include('../../layouts/admin', { title: 'Activity Log' }) %>

<%- include('../../partials/flash-messages') %>

<div class="px-4 sm:px-6 lg:px-8 pt-4">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: 'Activity Log' }
  ] }) %>

  <div class="flex items-start justify-between gap-4 mt-4">
    <div>
      <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong)">Activity Log</h1>
      <p class="text-sm mt-1" style="color:var(--theme-text-muted)"><%= total || 0 %> actions recorded</p>
    </div>
  </div>

  <form method="GET" action="/admin/activity" class="al-card mt-5">
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div>
        <label class="al-label" for="category">Category</label>
        <select id="category" name="category" class="al-input">
          <option value="">All Categories</option>
          <option value="server" <%= filters?.category === 'server' ? 'selected' : '' %>>Server</option>
          <option value="file" <%= filters?.category === 'file' ? 'selected' : '' %>>File</option>
          <option value="backup" <%= filters?.category === 'backup' ? 'selected' : '' %>>Backup</option>
          <option value="database" <%= filters?.category === 'database' ? 'selected' : '' %>>Database</option>
          <option value="user" <%= filters?.category === 'user' ? 'selected' : '' %>>User</option>
          <option value="node" <%= filters?.category === 'node' ? 'selected' : '' %>>Node</option>
          <option value="image" <%= filters?.category === 'image' ? 'selected' : '' %>>Image</option>
          <option value="apikey" <%= filters?.category === 'apikey' ? 'selected' : '' %>>API Key</option>
        </select>
      </div>
      <div>
        <label class="al-label" for="actor">Actor</label>
        <input id="actor" name="actor" type="text" value="<%= filters?.actor || '' %>" class="al-input" placeholder="Username">
      </div>
      <div>
        <label class="al-label" for="from">From</label>
        <input id="from" name="from" type="date" value="<%= filters?.from || '' %>" class="al-input">
      </div>
      <div>
        <label class="al-label" for="to">To</label>
        <input id="to" name="to" type="date" value="<%= filters?.to || '' %>" class="al-input">
      </div>
      <div class="flex items-end gap-2">
        <button type="submit" class="al-btn-primary flex-1">Filter</button>
        <a href="/admin/activity" class="al-btn-secondary">Reset</a>
      </div>
    </div>
  </form>

  <div class="al-card mt-5">
    <h2 class="al-card-header">Recent Activity</h2>
    <div class="p-5">
      <% if (!logs || logs.length === 0) { %>
        <p class="text-sm" style="color:var(--theme-text-muted)">No matching activity logs.</p>
      <% } else { %>
        <% var groups = []; %>
        <% logs.forEach(function(log) {
          var day = new Date(log.createdAt).toDateString();
          var existing = groups.find(function(g) { return g.day === day; });
          if (existing) existing.items.push(log); else groups.push({ day: day, items: [log] });
        }); %>
        <div class="space-y-6">
          <% groups.forEach(function(group) { %>
            <div>
              <div class="text-xs font-medium uppercase tracking-wider mb-2" style="color:var(--theme-text-muted)"><%= new Date(group.items[0].createdAt).toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) %></div>
              <div class="space-y-2">
                <% group.items.forEach(function(log) {
                  var meta = log.metadata || { label: log.event, category: 'other' };
                  var catColors = {
                    server: '#6366f1', file: '#0ea5e9', backup: '#f59e0b', database: '#10b981',
                    user: '#a855f7', node: '#06b6d4', image: '#ec4899', apikey: '#8b5cf6',
                    other: '#6b7280'
                  };
                  var catColor = catColors[meta.category] || catColors.other;
                %>
                  <div class="rounded-xl border p-4" style="border-color:color-mix(in srgb, var(--theme-border, #e5e5e5) 60%, transparent);">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                      <div class="min-w-0">
                        <p class="text-sm font-medium truncate flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full shrink-0" style="background:<%= catColor %>"></span>
                          <span class="truncate"><%= meta.label || log.event %></span>
                          <span class="font-mono text-xs px-1.5 py-0.5 rounded hidden sm:inline" style="background:color-mix(in srgb, <%- catColor %> 12%, transparent); color:<%- catColor %>"><%= log.event %></span>
                        </p>
                        <p class="text-xs mt-1" style="color:var(--theme-text-muted)">
                          <span class="font-medium" style="color:var(--theme-text-strong)"><%= log.actor ? log.actor.username : 'System' %></span>
                          <% if (log.server) { %> &middot; <a href="/admin/servers/<%= log.server.UUID %>" class="underline decoration-dotted underline-offset-2"><%= log.server.name %></a><% } %>
                          &middot; <%- new Date(log.createdAt).toLocaleString() %>
                          <% if (log.ip) { %> &middot; <span class="font-mono"><%= log.ip %></span><% } %>
                        </p>
                      </div>
                      <% if (log.metadata && Object.keys(log.metadata).length > 0) { %>
                        <button type="button" class="al-btn-secondary text-xs shrink-0 activity-toggle" data-meta-id="<%= log.id %>">Details</button>
                      <% } %>
                    </div>
                    <% if (log.metadata && Object.keys(log.metadata).length > 0) { %>
                      <div id="activity-meta-<%= log.id %>" class="hidden mt-3">
                        <pre class="text-xs font-mono break-all rounded-lg p-3 overflow-x-auto whitespace-pre-wrap" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border); color:var(--theme-text-muted)"><%- JSON.stringify(log.metadata, null, 2) %></pre>
                      </div>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>

        <% if (totalPages > 1) { %>
          <% var qs = [];
             if (filters?.event) qs.push('event=' + encodeURIComponent(filters.event));
             if (filters?.server) qs.push('server=' + encodeURIComponent(filters.server));
             if (filters?.actor) qs.push('actor=' + encodeURIComponent(filters.actor));
             if (filters?.category) qs.push('category=' + encodeURIComponent(filters.category));
             if (filters?.from) qs.push('from=' + encodeURIComponent(filters.from));
             if (filters?.to) qs.push('to=' + encodeURIComponent(filters.to)); %>
          <div class="flex items-center justify-between mt-5">
            <a href="/admin/activity?page=<%= Math.max(page - 1, 1) %><%= qs.map(function(q) { return '&' + q; }).join('') %>" class="al-btn-secondary <%= page <= 1 ? 'pointer-events-none opacity-40' : '' %>">Prev</a>
            <span class="text-sm" style="color:var(--theme-text-muted)">Page <%= page %> of <%= totalPages %></span>
            <a href="/admin/activity?page=<%= Math.min(page + 1, totalPages) %><%= qs.map(function(q) { return '&' + q; }).join('') %>" class="al-btn-secondary <%= page >= totalPages ? 'pointer-events-none opacity-40' : '' %>">Next</a>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
(function() {
  document.querySelectorAll('.activity-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var meta = document.getElementById('activity-meta-' + btn.dataset.metaId);
      if (!meta) return;
      var open = meta.classList.toggle('hidden');
      btn.textContent = open ? 'Details' : 'Hide';
    });
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
