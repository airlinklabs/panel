<%- include('../../layouts/admin', { title: t('adminRadarTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbRadar') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('adminRadarTitle') %></h1>
    <p class="al-page-desc"><%= t('radarDesc') %></p>
  </div>
  <div>
    <a href="/admin/radar/scripts" class="al-btn-secondary">
      <%- icon('file-code', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('scripts') %></span>
    </a>
  </div>
</div>

<div class="al-page-body" data-al-tabs data-tabs-default="scans" data-tabs-hash>

  <div role="tablist" class="flex gap-1 mb-6 flex-wrap">
    <button type="button" role="tab" aria-selected="true" aria-controls="panel-scans" id="tab-scans" data-tab="scans" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('scan', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('scans') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-virustotal" id="tab-virustotal" data-tab="virustotal" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('bug', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('virusTotal') %></button>
  </div>

  <!-- Scans Tab -->
  <div id="panel-scans" role="tabpanel" aria-labelledby="tab-scans" data-tab-panel="scans" class="tab-panel space-y-5">
    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('serverScanTitle') %></p>
          <p class="al-card-header-desc"><%= t('serverScanDesc') %></p>
        </div>
      </div>
      <div class="al-card-body">
        <div class="al-form-field max-w-md">
          <label for="scanServerId" class="al-form-label"><%= t('serverId') %></label>
          <div class="flex flex-wrap items-center gap-2">
            <input type="text" id="scanServerId" placeholder="<%= t('enterServerIdPlaceholder') %>" class="al-form-input flex-1 min-w-[12rem]">
            <button type="button" id="scanBtn" class="al-btn-primary">
              <%- icon('scan', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('scanAction') %></span>
            </button>
          </div>
        </div>
        <div id="scanResult" class="mt-4 hidden"></div>
      </div>
    </div>

    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('scanHistoryTitle') %></p>
      </div>
      <div class="al-card-body">
        <div id="scanHistory" class="text-sm al-text-muted"><%= t('noRecentScans') %></div>
      </div>
    </div>
  </div>

  <!-- VirusTotal Tab -->
  <div id="panel-virustotal" role="tabpanel" aria-labelledby="tab-virustotal" data-tab-panel="virustotal" class="tab-panel space-y-5" hidden>
    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('virusTotalSettingsTitle') %></p>
      </div>
      <div class="al-card-body space-y-5">
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('enableVtScanning') %></p>
            <p class="al-setting-desc"><%= t('enableVtScanningDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="vtEnabled" class="sr-only peer" aria-label="<%= t('enableVtScanning') %>" <%= settings.virusTotalApiKey ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>

        <div class="al-form-field max-w-sm">
          <label for="vtApiKey" class="al-form-label"><%= t('vtApiKeyLabel') %></label>
          <div class="flex items-center gap-2">
            <input type="password" id="vtApiKey" value="<%= settings.virusTotalApiKey || '' %>" placeholder="<%= t('vtPasteKey') %>" autocomplete="off" class="al-form-input flex-1 min-w-0 font-mono">
            <button type="button" class="al-btn-secondary al-btn-sm shrink-0" onclick="var inp=document.getElementById('vtApiKey');var btn=this;if(inp.type==='password'){inp.type='text';btn.textContent='<%= t('hide') %>';}else{inp.type='password';btn.textContent='<%= t('show') %>';}"><%= t('show') %></button>
          </div>
          <% if (settings.virusTotalApiKey) { %><p class="al-form-help" style="color:var(--theme-success)"><%= t('apiKeyConfigured') %></p><% } %>
        </div>

        <div>
          <button type="button" id="vtSaveBtn" class="al-btn-primary">
            <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('saveSettings') %></span>
          </button>
        </div>
      </div>
    </div>

    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('vtHashScanTitle') %></p>
          <p class="al-card-header-desc"><%= t('vtHashScanDesc') %></p>
        </div>
      </div>
      <div class="al-card-body">
        <div class="al-form-field max-w-lg">
          <label for="vtHashInput" class="al-form-label"><%= t('fileHash') %></label>
          <div class="flex flex-wrap items-center gap-2">
            <input type="text" id="vtHashInput" placeholder="<%= t('vtHashPlaceholder') %>" class="al-form-input flex-1 min-w-[12rem] font-mono">
            <button type="button" id="vtScanBtn" class="al-btn-primary">
              <%- icon('search', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('lookUpAction') %></span>
            </button>
          </div>
        </div>
        <div id="vtScanResult" class="mt-4 hidden"></div>
      </div>
    </div>
  </div>

</div>

<script nonce="<%- nonce %>">
(function() {
  var csrfToken = '<%= csrfToken %>';
  var msgScanning = <%- JSON.stringify(t('scanningInProgress')) %>;
  var msgScanOk = <%- JSON.stringify(t('scanCompleteNoThreats')) %>;
  var msgScanFailed = <%- JSON.stringify(t('scanFailedMsg')) %>;
  var msgScanRequestFailed = <%- JSON.stringify(t('scanRequestFailed')) %>;
  var msgEnterServerId = <%- JSON.stringify(t('enterServerId')) %>;
  var msgVtSaved = <%- JSON.stringify(t('vtSettingsSaved')) %>;
  var msgSaveFailed = <%- JSON.stringify(t('failedToSave')) %>;
  var msgEnterHash = <%- JSON.stringify(t('enterFileHash')) %>;
  var msgLookingUp = <%- JSON.stringify(t('lookingUp')) %>;
  var msgMalicious = <%- JSON.stringify(t('maliciousDetected')) %>;
  var msgFileFlagged = <%- JSON.stringify(t('fileFlagged')) %>;
  var msgClean = <%- JSON.stringify(t('scanClean')) %>;
  var msgNoThreats = <%- JSON.stringify(t('noThreatsFound')) %>;
  var msgLookupFailed = <%- JSON.stringify(t('lookupFailed')) %>;

  // Scan server
  var scanBtn = document.getElementById('scanBtn');
  if (scanBtn) {
    scanBtn.addEventListener('click', function() {
      var serverId = document.getElementById('scanServerId')?.value?.trim();
      if (!serverId) { showToast(msgEnterServerId, 'error'); return; }
      var resultEl = document.getElementById('scanResult');
      resultEl.classList.remove('hidden');
      resultEl.innerHTML = '<p class="al-text-muted">' + msgScanning + '</p>';
      fetch('/admin/radar/scan/' + serverId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      }).then(function(r) { return r.json(); }).then(function(res) {
        if (res.success) {
          resultEl.innerHTML = '<div class="al-alert-success"><p class="al-alert-title">' + msgScanOk + '</p></div>';
        } else {
          resultEl.innerHTML = '<div class="al-alert-danger"><p class="al-alert-title">' + (res.message || msgScanFailed) + '</p></div>';
        }
      }).catch(function() {
        resultEl.innerHTML = '<div class="al-alert-danger"><p class="al-alert-title">' + msgScanRequestFailed + '</p></div>';
      });
    });
  }

  // VT settings save
  var vtSaveBtn = document.getElementById('vtSaveBtn');
  if (vtSaveBtn) {
    vtSaveBtn.addEventListener('click', function() {
      fetch('/admin/radar/virustotal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({
          enabled: document.getElementById('vtEnabled')?.checked || false,
          apiKey: document.getElementById('vtApiKey')?.value || '',
        }),
      }).then(function(r) { return r.json(); }).then(function(res) {
        if (res.success) { showToast(msgVtSaved, 'success'); }
        else { showToast(res.message || msgSaveFailed, 'error'); }
      }).catch(function() { showToast(msgSaveFailed, 'error'); });
    });
  }

  // VT hash scan
  var vtScanBtn = document.getElementById('vtScanBtn');
  if (vtScanBtn) {
    vtScanBtn.addEventListener('click', function() {
      var hash = document.getElementById('vtHashInput')?.value?.trim();
      if (!hash) { showToast(msgEnterHash, 'error'); return; }
      var resultEl = document.getElementById('vtScanResult');
      resultEl.classList.remove('hidden');
      resultEl.innerHTML = '<p class="al-text-muted">' + msgLookingUp + '</p>';
      fetch('/admin/radar/virustotal/scan/' + encodeURIComponent(hash), {
        method: 'GET',
        headers: { 'Accept': 'application/json' },
      }).then(function(r) { return r.json(); }).then(function(data) {
        if (data.malicious) {
          resultEl.innerHTML = '<div class="al-alert-danger"><p class="al-alert-title">' + msgMalicious + '</p><p class="al-alert-body">' + (data.message || msgFileFlagged) + '</p></div>';
        } else {
          resultEl.innerHTML = '<div class="al-alert-success"><p class="al-alert-title">' + msgClean + '</p><p class="al-alert-body">' + (data.message || msgNoThreats) + '</p></div>';
        }
      }).catch(function() {
        resultEl.innerHTML = '<div class="al-alert-danger"><p class="al-alert-title">' + msgLookupFailed + '</p></div>';
      });
    });
  }
})();
</script>

<%- include('../../layouts/admin-footer') %>
