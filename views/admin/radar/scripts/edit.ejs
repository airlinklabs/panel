<%- include('../../../layouts/admin', { title: t('editRadarScriptTitle') }) %>

<%- include('../../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbRadar'), url: '/admin/servers#radar' },
    { label: t('scripts'), url: '/admin/radar/scripts' },
    { label: (typeof script !== 'undefined' && script && script.name) ? script.name : t('editScriptCrumb') }
  ] }) %>
</div>

<%
  var s = (typeof script !== 'undefined' && script && typeof script === 'object') ? script : {};
  var scriptId = typeof req !== 'undefined' && req.params ? req.params.id : '';
  var patternsJson = JSON.stringify(Array.isArray(s.patterns) ? s.patterns : [], null, 2);
  var patternsJsonEsc = patternsJson.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
%>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('editScriptTitle') %></h1>
    <p class="al-page-desc"><%= s.description || t('editScriptDesc') %></p>
  </div>
  <div>
    <a href="/admin/radar/scripts" class="al-btn-secondary">
      <%- icon('arrow-left', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('back') %></span>
    </a>
  </div>
</div>

<div class="al-page-body">
  <form id="scriptForm" class="max-w-3xl space-y-5">
    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('details') %></p>
      </div>
      <div class="al-card-body space-y-4">
        <%- include('../../../partials/ui/form-field', {
          type: 'text', name: 'name', id: 'scriptName',
          label: t('name'), value: s.name || '', required: true, maxlength: 120
        }) %>
        <%- include('../../../partials/ui/form-field', {
          type: 'textarea', name: 'description', id: 'scriptDescription',
          label: t('description'), rows: 2, maxlength: 500, value: (s.description || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        }) %>
        <%- include('../../../partials/ui/form-field', {
          type: 'text', name: 'version', id: 'scriptVersion',
          label: t('version'), value: s.version || '1.0.0', maxlength: 20, wrapperCls: 'max-w-[10rem]',
          cls: 'font-mono'
        }) %>
        <% if (s.filename) { %>
        <p class="text-xs font-mono al-text-muted break-all"><%= s.filename %></p>
        <% } %>
      </div>
    </div>

    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('patternsTitle') %></p>
      </div>
      <div class="al-card-body">
        <%- include('../../../partials/ui/form-field', {
          type: 'textarea', name: 'patterns', id: 'scriptPatterns',
          label: t('patternsJsonLabel'), value: patternsJsonEsc,
          helpText: t('patternsHelp'), cls: 'font-mono text-xs leading-relaxed min-h-[20rem]'
        }) %>
        <p id="patternsError" class="al-form-error-msg mt-2 hidden"></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="al-btn-primary">
        <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('saveChanges') %></span>
      </button>
      <a href="/admin/radar/scripts" class="al-btn-secondary"><%= t('cancel') %></a>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
(function() {
  var csrfToken = '<%= csrfToken %>';
  var scriptId = '<%= scriptId %>';
  var form = document.getElementById('scriptForm');
  var errEl = document.getElementById('patternsError');
  var msgNameRequired = <%- JSON.stringify(t('nameRequired')) %>;
  var msgInvalidJson = <%- JSON.stringify(t('patternsInvalidJson')) %>;
  var msgNotArray = <%- JSON.stringify(t('patternsNotArray')) %>;
  var msgSaved = <%- JSON.stringify(t('scriptSaved')) %>;
  var msgSaveFailed = <%- JSON.stringify(t('scriptSaveFailed')) %>;
  var msgSomethingWrong = <%- JSON.stringify(t('somethingWentWrong')) %>;

  function showError(msg) {
    errEl.textContent = msg;
    errEl.classList.remove('hidden');
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    errEl.classList.add('hidden');

    var name = document.getElementById('scriptName').value.trim();
    if (!name) { showToast(msgNameRequired, 'error'); return; }

    var patterns;
    try {
      patterns = JSON.parse(document.getElementById('scriptPatterns').value);
    } catch (err) {
      showError(msgInvalidJson.replace('{{error}}', err.message));
      return;
    }
    if (!Array.isArray(patterns)) {
      showError(msgNotArray);
      return;
    }

    var body = {
      name: name,
      description: document.getElementById('scriptDescription').value.trim(),
      version: document.getElementById('scriptVersion').value.trim() || '1.0.0',
      patterns: patterns,
    };

    fetch('/admin/radar/scripts/' + encodeURIComponent(scriptId), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      body: JSON.stringify(body),
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.success) {
          showToast(msgSaved, 'success');
          window.location.href = '/admin/radar/scripts';
        } else {
          showToast(res.message || msgSaveFailed, 'error');
        }
      })
      .catch(function() { showToast(msgSomethingWrong, 'error'); });
  });
})();
</script>

<%- include('../../../layouts/admin-footer') %>
