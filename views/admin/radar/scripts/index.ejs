<%- include('../../../layouts/admin', { title: t('radarScriptsTitle') }) %>

<%- include('../../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbRadar'), url: '/admin/radar' },
    { label: t('scripts') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('radarScriptsTitle') %></h1>
    <p class="al-page-desc"><%= t('radarScriptsDesc') %></p>
  </div>
  <div class="flex gap-2 shrink-0">
    <a href="/admin/radar" class="al-btn-secondary">
      <%- icon('arrow-left', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('back') %></span>
    </a>
    <a href="/admin/radar/scripts/create" class="al-btn-primary">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('newScriptBtn') %></span>
    </a>
  </div>
</div>

<div class="al-page-body">
  <%
    var list = (typeof scripts !== 'undefined' && Array.isArray(scripts)) ? scripts : [];
  %>
  <% if (list.length === 0) { %>
    <%- include('../../../partials/empty-state', {
      iconName: 'file-code',
      title: t('noScriptsYet'),
      description: t('noScriptsYetDesc'),
      action: '<a href="/admin/radar/scripts/create" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + '<span>' + t('newScriptBtn') + '</span></a>'
    }) %>
  <% } else { %>
  <div class="al-table-wrapper">
    <table class="al-table al-table-card">
      <colgroup>
        <col style="min-width:240px">
        <col style="min-width:160px">
        <col style="min-width:100px">
        <col style="min-width:160px">
      </colgroup>
      <thead class="al-table-thead">
        <tr>
          <th scope="col" class="al-table-th pl-6"><%= t('name') %></th>
          <th scope="col" class="al-table-th col-hide"><%= t('description') %></th>
          <th scope="col" class="al-table-th col-hide"><%= t('version') %></th>
          <th scope="col" class="al-table-th"><%= t('actions') %></th>
        </tr>
      </thead>
      <tbody class="al-table-tbody">
        <% let scriptIdx = 0; list.forEach(function(s) { %>
        <tr class="al-table-tr" style="--i:<%= scriptIdx++ %>">
          <td class="al-table-td pl-6" data-label="<%= t('name') %>">
            <p class="al-table-cell-strong"><%= s.name || s.id %></p>
            <% if (s.filename) { %><p class="text-xs mt-0.5 font-mono al-text-muted"><%= s.filename %></p><% } %>
          </td>
          <td class="al-table-td col-hide" data-label="<%= t('description') %>">
            <p class="text-xs max-w-sm truncate al-text-muted"><%= s.description || '—' %></p>
          </td>
          <td class="al-table-td col-hide text-sm al-text-muted" data-label="<%= t('version') %>">v<%= s.version || '1.0.0' %></td>
          <td class="al-table-td" data-label="<%= t('actions') %>">
            <div class="flex items-center gap-2">
              <a href="/admin/radar/scripts/edit/<%= encodeURIComponent(s.id) %>" class="al-btn-secondary al-btn-sm">
                <%- icon('pencil', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= t('edit') %></span>
              </a>
              <button type="button" class="al-btn-danger-outline al-btn-sm js-delete-script"
                data-id="<%= encodeURIComponent(s.id) %>" data-name="<%= s.name || s.id %>">
                <%- icon('trash-2', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= t('delete') %></span>
              </button>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script nonce="<%- nonce %>">
(function() {
  var csrfToken = '<%= csrfToken %>';
  var msgDeleted = <%- JSON.stringify(t('scriptDeleted')) %>;
  var msgDeleteFailed = <%- JSON.stringify(t('scriptDeleteFailed')) %>;
  var msgSomethingWrong = <%- JSON.stringify(t('somethingWentWrong')) %>;
  var titleConfirm = <%- JSON.stringify(t('deleteScriptTitle')) %>;
  var labelConfirm = <%- JSON.stringify(t('delete')) %>;

  document.querySelectorAll('.js-delete-script').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = btn.dataset.id;
      var name = btn.dataset.name;
      if (!id) return;
      var body = <%- JSON.stringify(t('deleteScriptBody')) %>.replace('{{name}}', name);
      var run = function() {
        fetch('/admin/radar/scripts/' + id + '/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        })
          .then(function(r) { return r.json(); })
          .then(function(res) {
            if (res.success) { showToast(msgDeleted, 'success'); window.location.reload(); }
            else { showToast(res.message || msgDeleteFailed, 'error'); }
          })
          .catch(function() { showToast(msgSomethingWrong, 'error'); });
      };
      if (window.modal && window.modal.confirm) {
        window.modal.confirm({
          title: titleConfirm,
          body: body,
          danger: true,
          confirmLabel: labelConfirm,
          onConfirm: run,
        });
      } else if (window.confirm(body)) {
        run();
      }
    });
  });
})();
</script>

<%- include('../../../layouts/admin-footer') %>
