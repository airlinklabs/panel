<%- include('../../layouts/admin', { title: t('newMount') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('mountsTitle'), url: '/admin/mounts' },
    { label: t('newMount') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('newMount') %></h1>
    <p class="al-page-desc"><%= t('newMountDesc') %></p>
  </div>
  <div>
    <a href="/admin/mounts" class="al-btn-secondary"><%= t('backToMounts') %></a>
  </div>
</div>

<div class="al-page-body space-y-5">
  <div id="mountError" class="al-alert-danger hidden" role="alert"></div>

  <form id="mountForm" class="al-card space-y-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="md:col-span-2">
        <label for="mountName" class="al-form-label flex items-center gap-1.5">
          <%- icon('tag', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('mountName') %>
        </label>
        <input id="mountName" name="name" class="al-form-input w-full" placeholder="<%= t('mountNamePlaceholder') %>" required>
      </div>
      <div>
        <label for="mountSource" class="al-form-label flex items-center gap-1.5">
          <%- icon('hard-drive', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('mountSource') %>
        </label>
        <input id="mountSource" name="source" class="al-form-input w-full font-mono text-xs" placeholder="/data/shared/plugins" required>
        <p class="al-form-help"><%= t('mountSourceHelp') %></p>
      </div>
      <div>
        <label for="mountTarget" class="al-form-label flex items-center gap-1.5">
          <%- icon('folder', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('mountTarget') %>
        </label>
        <input id="mountTarget" name="target" class="al-form-input w-full font-mono text-xs" placeholder="/home/container/plugins" required>
        <p class="al-form-help"><%= t('mountTargetHelp') %></p>
      </div>
    </div>
    <label class="al-form-check" for="mountReadOnly">
      <input id="mountReadOnly" name="readOnly" type="checkbox" class="al-form-checkbox">
      <span class="al-form-check-label"><%= t('mountReadOnlyLabel') %></span>
    </label>
    <div class="flex justify-end gap-2 pt-2">
      <a href="/admin/mounts" class="al-btn-secondary"><%= t('cancel') %></a>
      <button type="submit" id="mountSubmit" class="al-btn-primary">
        <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
        <span id="mountSubmitText"><%= t('mountCreateBtn') %></span>
      </button>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
var csrfToken = <%- JSON.stringify(csrfToken) %>;
(function() {
  var form = document.getElementById('mountForm');
  var errEl = document.getElementById('mountError');
  var submitBtn = document.getElementById('mountSubmit');
  var submitText = document.getElementById('mountSubmitText');
  var messages = {
    required: <%- JSON.stringify(t('errorAllFieldsRequired')) %>,
    creating: <%- JSON.stringify(t('mountCreating')) %>,
    created: <%- JSON.stringify(t('mountCreated')) %>,
    createFailed: <%- JSON.stringify(t('mountCreateFailed')) %>,
    network: <%- JSON.stringify(t('networkError')) %>,
    submit: <%- JSON.stringify(t('mountCreateBtn')) %>
  };
  var saving = false;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (saving) return;
    var name = form.elements.name.value.trim();
    var source = form.elements.source.value.trim();
    var target = form.elements.target.value.trim();
    if (!name || !source || !target) {
      errEl.textContent = messages.required;
      errEl.classList.remove('hidden');
      return;
    }
    errEl.classList.add('hidden');
    saving = true;
    submitBtn.disabled = true;
    submitText.textContent = messages.creating;
    fetch('/admin/mounts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      body: JSON.stringify({ name: name, source: source, target: target, readOnly: form.elements.readOnly.checked }),
    }).then(function(res) {
      if (res.ok) {
        showToast(messages.created, 'success');
        window.location.href = '/admin/mounts';
      } else {
        return res.json().catch(function() { return { error: messages.createFailed }; }).then(function(data) {
          errEl.textContent = data.error || data.message || messages.createFailed;
          errEl.classList.remove('hidden');
        });
      }
    }).catch(function() {
      errEl.textContent = messages.network;
      errEl.classList.remove('hidden');
    }).finally(function() {
      saving = false;
      submitBtn.disabled = false;
      submitText.textContent = messages.submit;
    });
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
