<%- include('../../components/header', { title: 'Mounts' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [ { label: 'Admin' }, { label: 'Mounts' } ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Mounts</h1>
          <p class="al-page-desc">Host directories that can be bind-mounted into server containers.</p>
        </div>
        <button type="button" id="newMountBtn" class="al-btn-primary shrink-0" hx-get="/admin/mounts/new" hx-target="#mountCreateForm" hx-swap="none" hx-on::after-request="if(event.detail.xhr.status===200){const d=document.getElementById('mountCreateForm');window.modal.show({title:'New mount',bodyNode:d,panelClass:'max-w-lg'})}"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>New mount</button>
      </div>

      <div class="al-page-body">
        <div id="admin-mounts-status"></div>
        <%- include('../../fragments/admin/mounts/mount-list', { mounts }) %>
      </div>
    </div>
  </div>
</main>

<div id="mountCreateForm" class="hidden"></div>

<%- include('../../components/footer') %>
