<%- include('../../layouts/admin', { title: t('mountsTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('mountsTitle') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('mountsTitle') %></h1>
    <p class="al-page-desc"><%= t('mountsPageDesc') %></p>
  </div>
  <div>
    <a href="/admin/mounts/new" class="al-btn-primary">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('newMount') %>
    </a>
  </div>
</div>

<div class="al-page-body">
  <% if (mounts.length === 0) { %>
    <%- include('../../partials/empty-state', {
      iconName: 'folder',
      title: t('noMountsYet'),
      description: t('noMountsYetDesc'),
      action: '<a href="/admin/mounts/new" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }).toString() + ' ' + t('newMount') + '</a>'
    }) %>
  <% } else { %>
  <div class="al-card al-card-flush">
    <table class="al-table">
      <colgroup>
        <col style="min-width:160px">
        <col style="min-width:200px">
        <col style="min-width:200px">
        <col style="min-width:110px">
        <col style="min-width:110px">
      </colgroup>
      <thead class="al-table-thead">
        <tr>
          <th scope="col" class="al-table-th"><%= t('mountName') %></th>
          <th scope="col" class="al-table-th"><%= t('mountSource') %></th>
          <th scope="col" class="al-table-th"><%= t('mountTarget') %></th>
          <th scope="col" class="al-table-th"><%= t('mountMode') %></th>
          <th scope="col" class="al-table-th"><%= t('mountActions') %></th>
        </tr>
      </thead>
      <tbody>
        <% mounts.forEach(function(m) { %>
        <tr class="al-table-tr" data-mount-id="<%= m.id %>">
          <td class="al-table-td">
            <span class="al-table-cell-strong"><%= m.name %></span>
          </td>
          <td class="al-table-td">
            <code class="al-chip al-chip-mono max-w-full truncate" title="<%= m.source %>"><%= m.source %></code>
          </td>
          <td class="al-table-td">
            <code class="al-chip al-chip-mono max-w-full truncate" title="<%= m.target %>"><%= m.target %></code>
          </td>
          <td class="al-table-td">
            <span class="<%= m.readOnly ? 'al-badge al-badge-warning' : 'al-badge al-badge-online' %>">
              <%= m.readOnly ? t('mountReadOnlyMode') : t('mountReadWrite') %>
            </span>
          </td>
          <td class="al-table-td">
            <button
              type="button"
              class="al-btn-ghost al-btn-icon-only"
              style="color:var(--theme-danger);"
              aria-label="<%= t('mountDeleteAria') %>"
              onclick="deleteMount(<%= m.id %>, <%- JSON.stringify(m.name) %>)">
              <%- icon('trash-2', { size: 16 }) %>
            </button>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script nonce="<%- nonce %>">
var csrfToken = <%- JSON.stringify(csrfToken) %>;

function deleteMount(id, name) {
  modal.confirm({
    title: <%- JSON.stringify(t('mountDeleteTitle')) %>,
    body: <%- JSON.stringify(t('mountDeleteConfirm')) %>.replace('{{name}}', name),
    danger: true,
    confirmLabel: <%- JSON.stringify(t('delete')) %>,
    onConfirm: async function() {
      var loader = showProgressToast(<%- JSON.stringify(t('mountDeleting')) %>);
      try {
        var res = await fetch('/admin/mounts/' + id, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        var data = await res.json();
        if (data.success !== false) {
          loader.complete(true, <%- JSON.stringify(t('mountDeleted')) %>);
          var row = document.querySelector('[data-mount-id="' + id + '"]');
          if (row) row.remove();
          if (document.querySelectorAll('[data-mount-id]').length === 0) {
            window.location.reload();
          }
        } else {
          loader.close();
          showToast(data.error || data.message || <%- JSON.stringify(t('mountDeleteFailed')) %>, 'error');
        }
      } catch(e) {
        loader.close();
        showToast(<%- JSON.stringify(t('mountDeleteFailed')) %>, 'error');
      }
    }
  });
}
</script>

<%- include('../../layouts/admin-footer') %>
