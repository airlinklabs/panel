<%- include('../../components/header', { title: 'Images' }) %>

<style>
  ::-webkit-scrollbar { display: none; }
  .field-label { font-size: 11px; font-weight: 500; color: var(--theme-text-muted, #737373); display: block; margin-bottom: 5px; }
  html.dark .field-label { color: var(--theme-text, #a3a3a3); }
  .field-input {
    width: 100%; border-radius: 9px; border: 1px solid var(--theme-border, #e5e5e5);
    background: var(--theme-bg-input, #fafafa); padding: 8px 12px;
    font-size: 13px; color: var(--theme-text-strong, #171717); outline: none;
    transition: border-color 0.15s; box-sizing: border-box; font-family: inherit;
  }
  html.dark .field-input { background: var(--theme-bg-hover, rgba(255,255,255,0.04)); border-color: var(--theme-border-subtle, rgba(255,255,255,0.1)); color: var(--theme-text, #e5e5e5); }
  .field-input:focus { border-color: var(--theme-border, #a3a3a3); }
  html.dark .field-input:focus { border-color: var(--theme-border-subtle, rgba(255,255,255,0.25)); }
  .field-input::placeholder { color: var(--theme-text-placeholder, #a3a3a3); }
  html.dark .field-input::placeholder { color: var(--theme-text-muted, #525252); }
</style>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/template') %></div>
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Images' }
      ] }) %>

      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Images</h1>
          <p class="al-page-desc">Manage server images installed on this panel</p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button id="uploadBtn" type="button" class="al-btn-secondary"><%- icon('upload', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.uploadJson || 'Upload JSON' %></button>
          <button onclick="openCreate()" type="button" class="al-btn-secondary"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>New Image</button>
          <a href="/admin/images/store" class="al-btn-secondary">Browse Store</a>
        </div>
      </div>

      <div class="al-page-body">
      <div class="flex items-center border-b" style="border-color:var(--theme-border);">
        <button type="button" id="tab-btn-installed" data-tab="installed" class="px-3 py-2 mr-4 text-sm font-medium rounded-lg transition">Installed <span id="tabCountInstalled" class="ml-1 text-xs text-neutral-400"><%= images.length %></span></button>
        <button type="button" id="tab-btn-approvals" data-tab="approvals" class="px-3 py-2 mr-4 text-sm font-medium rounded-lg transition">Approvals <% if (pending && pending.length > 0) { %><span id="tabCountApprovals" class="ml-1 text-xs font-semibold" style="color:var(--theme-warning);"><%= pending.length %></span><% } %></button>
        <a href="/admin/images/store" class="px-3 py-2 mr-4 text-sm font-medium rounded-lg transition">Store</a>
      </div>

      <div id="tab-panel-installed" class="mt-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="text-sm" style="color:var(--theme-text-muted);"><span id="installedImagesCount"><%= images.length %></span> image<%= images.length !== 1 ? 's' : '' %> installed on this panel</div>
        </div>

      <div id="installedEmptyState" class="flex flex-col items-center justify-center py-24 text-center <%= images.length === 0 ? '' : 'hidden' %>">
        <p class="text-sm text-neutral-500">No images installed yet.</p>
        <a href="/admin/images/store" class="mt-4 al-btn-secondary inline-flex items-center gap-1.5"><%- icon('store', { class: 'size-4', strokeWidth: 1.5 }) %>Browse Store</a>
      </div>

      <div id="installedTableSection" class="<%= images.length === 0 ? 'hidden' : '' %>">

      <div class="mt-5 mb-1">
        <input id="imageFilterInput" type="text" placeholder="Filter images…" aria-label="Search images" class="al-input w-56">
      </div>

      <div class="overflow-x-auto shadow-sm rounded-xl mt-3 border" style="border-color:var(--theme-border)">
        <table class="al-table min-w-full">
          <colgroup>
            <col style="min-width:240px">
            <col style="min-width:160px">
            <col style="min-width:140px">
            <col style="min-width:220px">
          </colgroup>
          <thead class="al-table-head">
            <tr>
              <th class="al-table-th py-3.5 pl-6 pr-3">Name</th>
              <th class="al-table-th px-3 py-3.5 col-hide">Author</th>
              <th class="al-table-th px-3 py-3.5 col-hide">Created</th>
              <th class="al-table-th px-3 py-3.5">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y" style="border-color:var(--theme-border)" id="tableBody">
            <% let imgIdx = 0; images.forEach(function(image) { %>
            <tr class="al-table-tr transition-colors cursor-pointer img-row"
                style="--i:<%= imgIdx++ %>"
                data-search="<%= (image.name + ' ' + (image.author||'')).toLowerCase() %>"
                onclick="handleRowClick(event, '/admin/images/edit/<%= image.id %>')">
              <td class="al-table-td whitespace-nowrap py-4 pl-6 pr-3 font-medium" style="color:var(--theme-text-strong)"><%= image.name %></td>
              <td class="al-table-td whitespace-nowrap px-3 py-4 col-hide"><%= image.author || '—' %></td>
              <td class="al-table-td whitespace-nowrap px-3 py-4 col-hide"><%= new Date(image.createdAt).toLocaleDateString() %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <div class="flex gap-2">
                  <a href="/admin/images/edit/<%= image.id %>" onclick="event.stopPropagation()" class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition inline-flex items-center gap-1.5"><%- icon('pencil', { class: 'size-4', strokeWidth: 1.5 }) %>Edit</a>
                  <a href="/admin/images/export/<%= image.id %>" onclick="event.stopPropagation()" class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition inline-flex items-center gap-1.5"><%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %>Export</a>
                  <button  onclick="event.stopPropagation(); openDelete('<%= image.id %>', '<%= image.name %>')" type="button" class="al-btn-danger" aria-label="Delete image <%= image.name %>">
                    <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <div id="noResults" class="hidden py-10 text-center text-sm text-neutral-500 dark:text-neutral-400 bg-white dark:bg-neutral-800/20"><%= req.translations.noImagesMatch || 'No images match your search.' %></div>
      </div>
      </div>
      </div>

      <div id="tab-panel-approvals" class="hidden">
        <div class="mt-5 space-y-4" id="pendingApprovalsList">
          <% if (pending.length === 0) { %>
          <div class="flex flex-col items-center justify-center py-20 text-center">
            <div class="w-12 h-12 rounded-full bg-emerald-600/10 flex items-center justify-center mb-4">
              <%- icon('check', { class: 'w-6 h-6', style: 'color:var(--theme-text-muted)' }) %>
            </div>
            <p class="text-sm font-medium" style="color:var(--theme-text-strong)">No images waiting for review.</p>
            <p class="text-sm mt-1" style="color:var(--theme-text-muted)">User submissions will appear here for approval.</p>
          </div>
          <% } else { pending.forEach(function(image) { %>
          <div class="rounded-xl border p-5 pending-card" data-pending-image="<%= image.id %>" style="border-color:var(--theme-border); background:var(--theme-bg-card);">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h3 class="text-sm font-semibold truncate" style="color:var(--theme-text-strong)"><%= image.name %></h3>
                  <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset bg-amber-600/10 text-amber-600 ring-amber-600/20 dark:bg-amber-400/10 dark:text-amber-400 dark:ring-amber-400/20">Pending</span>
                </div>
                <% if (image.description) { %><p class="text-sm mt-1 line-clamp-2" style="color:var(--theme-text-muted)"><%= image.description %></p><% } %>
                <% if (image.creator) { %>
                <p class="text-xs mt-2" style="color:var(--theme-text-muted)">Submitted by <span class="font-medium" style="color:var(--theme-text-strong)"><%= image.creator.username || image.creator.email %></span> &middot; <%= new Date(image.createdAt).toLocaleString() %></p>
                <% } %>
                <div class="flex flex-wrap gap-4 mt-3 text-xs" style="color:var(--theme-text-muted)">
                  <span class="inline-flex items-center gap-1.5"><%- icon('terminal', { class: 'size-3.5', strokeWidth: 1.5 }) %><code style="font-family:ui-monospace,monospace;color:var(--theme-text-strong)"><%= image.startup || '' %></code></span>
                  <span class="inline-flex items-center gap-1.5"><%- icon('container', { class: 'size-3.5', strokeWidth: 1.5 }) %><code style="font-family:ui-monospace,monospace;color:var(--theme-text-strong)"><%= image.dockerImages || '[]' %></code></span>
                </div>
              </div>
              <div class="flex gap-2 shrink-0">
                <a href="/admin/images/edit/<%= image.id %>" class="al-btn-ghost inline-flex items-center gap-1.5 text-xs"><%- icon('external-link', { class: 'size-4', strokeWidth: 1.5 }) %>View</a>
                <button type="button" class="al-btn-primary inline-flex items-center gap-1.5 px-3 py-1.5 text-xs" data-approve-image="<%= image.id %>"><%- icon('check', { class: 'size-4', strokeWidth: 1.5 }) %>Approve</button>
                <button type="button" class="al-btn-danger inline-flex items-center gap-1.5 px-3 py-1.5 text-xs" data-reject-image="<%= image.id %>"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Reject</button>
              </div>
            </div>
          </div>
          <% }); } %>
        </div>
      </div>
      </div>
    </div>
  </div>
</main>

<!-- Reject modal -->
<div id="rejectModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">
  <div class="al-sheet-panel rounded-2xl max-w-md w-full will-change-transform shadow-xl" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Reject image</h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)" id="rejectImageName"></p>
      </div>
      <button type="button" class="al-btn-ghost p-2 rounded-lg flex items-center justify-center shrink-0" data-close-reject aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="px-6 py-4">
      <label class="field-label" for="rejectReason">Reason <span class="text-neutral-400 font-normal">(shown to the user)</span></label>
      <textarea id="rejectReason" class="al-input w-full" rows="3" placeholder="e.g. Missing startup exit detection or required docker image."></textarea>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" class="al-btn-secondary px-4 py-2 text-xs font-medium" data-close-reject>Cancel</button>
      <button type="button" id="confirmReject" class="al-btn-danger px-4 py-2 text-xs font-medium inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3.5', strokeWidth: 1.5 }) %>Reject
      </button>
    </div>
  </div>
</div>

<div id="page-data" style="display:none"
  data-approve-confirm="Approve this image? It will become available to all users."
  data-approved="Image approved."
  data-rejected="Image rejected."
  data-error="Something went wrong."
></div>

<!-- Upload modal -->
<div id="uploadImageModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">
  <div id="uploadImageModalPanel" class="al-sheet-panel rounded-2xl max-w-md w-full will-change-transform shadow-xl max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Upload Image</h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)">Select a Pterodactyl egg JSON file to install.</p>
      </div>
      <button type="button" onclick="closeUploadImageModal()" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4">
      <div class="flex gap-1 p-1 rounded-xl mb-4" style="background:var(--theme-bg-secondary)">
        <button type="button" id="uploadModeFile" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400" style="color:var(--theme-text-strong); background:var(--theme-bg-card);">Upload file</button>
        <button type="button" id="uploadModeUrl" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400" style="color:var(--theme-text-muted);">Import from URL</button>
      </div>
      <div id="uploadFileSection">
        <div class="mb-4">
          <label for="imageFileInput" class="w-full px-3 py-6 border-2 border-dashed rounded-xl focus:outline-none focus:ring-2 transition text-center cursor-pointer block" id="imageDropZone" style="border-color:var(--theme-border); color:var(--theme-text-strong);">
            <%- icon('upload', { class: 'w-10 h-10 mx-auto mb-2', fill: 'currentColor', strokeWidth: 1 }) %>
            <p style="color:var(--theme-text-muted)">Drag & drop a JSON file here or click to browse</p>
          </label>
          <input type="file" id="imageFileInput" class="hidden" accept=".json">
        </div>
      <div id="imageFilePreview" class="hidden">
        <div class="flex items-center p-3 rounded-xl" style="background:var(--theme-bg-secondary);">
          <%- icon('file-json', { class: 'w-6 h-6 mr-3', style: 'color:var(--theme-text-muted)' }) %>
          <div class="flex-1 truncate">
            <p id="imageSelectedFileName" class="font-medium truncate" style="color:var(--theme-text-strong)"></p>
            <p id="imageSelectedFileSize" class="text-sm" style="color:var(--theme-text-muted)"></p>
          </div>
          <button type="button" onclick="removeSelectedImageFile()" class="ml-2" aria-label="Remove selected file" style="color:var(--theme-text-muted)">
            <%- icon('x', { class: 'w-5 h-5' }) %>
          </button>
        </div>
      </div>
      </div>
      <div id="importUrlSection" class="hidden">
        <label class="field-label" for="importUrlInput">Image URL</label>
        <input id="importUrlInput" type="url" placeholder="https://raw.githubusercontent.com/…/egg.json" class="al-input w-full">
        <p class="mt-2 text-xs" style="color:var(--theme-text-muted)">Fetch a Pterodactyl egg JSON from a raw URL and install it as an image.</p>
      </div>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" onclick="closeUploadImageModal()" class="al-btn-secondary px-4 py-2 text-xs font-medium inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        Cancel
      </button>
      <button type="button" id="imageUploadButton" class="al-btn-primary px-3 py-2 text-sm font-medium inline-flex items-center gap-1.5" disabled>
        <%- icon('upload', { class: 'size-4', strokeWidth: 1.5 }) %>
        Upload
      </button>
      <button type="button" id="importUrlSubmit" class="al-btn-primary hidden px-3 py-2 text-sm font-medium inline-flex items-center gap-1.5">
        <%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %>
        Fetch &amp; Import
      </button>
    </div>
  </div>
</div>

<!-- Create content — hosted inside the shared window.modal shell -->
<div id="createContent" style="display:none;">
  <form action="/admin/images/create" method="POST" class="flex flex-col gap-4">
    <div class="grid grid-cols-2 gap-3">
      <div class="col-span-2"><label class="field-label">Name <span class="text-red-500">*</span></label><input class="field-input" type="text" name="name" required placeholder="e.g. Minecraft Java"></div>
      <div><label class="field-label">Author</label><input class="field-input" type="text" name="author" placeholder="e.g. github.com/you"></div>
      <div><label class="field-label">Author Name</label><input class="field-input" type="text" name="authorName" placeholder="Your Name"></div>
      <div class="col-span-2"><label class="field-label">Startup Command <span class="text-red-500">*</span></label><input class="field-input" type="text" name="startup" required placeholder="java -Xms128M -jar server.jar" style="font-family:ui-monospace,monospace;font-size:12px;"></div>
      <div class="col-span-2"><label class="field-label">Description</label><textarea class="field-input" name="description" rows="2" placeholder="What does this image run?" style="resize:none;"></textarea></div>
    </div>
    <div class="flex gap-2 pt-1">
      <button type="button" onclick="closeCreate()" class="flex-1 py-2 rounded-xl border border-neutral-200 dark:border-neutral-700 text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition inline-flex items-center justify-center gap-1.5"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Cancel</button>
      <button type="submit" class="flex-1 py-2 rounded-xl border border-neutral-800/20 bg-white hover:bg-neutral-200 text-neutral-800 dark:bg-neutral-900 dark:hover:bg-neutral-800 dark:text-white text-sm font-medium shadow-lg transition inline-flex items-center justify-center gap-1.5"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.createAndEdit || 'Create & Edit' %></button>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
  (function() {
    var tabs = ['installed', 'approvals'];

    function active(k) {
      tabs.forEach(function(key) {
        var btn = document.getElementById('tab-btn-' + key);
        var panel = document.getElementById('tab-panel-' + key);
        var isActive = key === k;
        btn.classList.toggle('bg-neutral-900', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('dark:bg-white', isActive);
        btn.classList.toggle('dark:text-black', isActive);
        btn.classList.toggle('text-neutral-400', !isActive);
        btn.classList.toggle('hover:text-neutral-600', !isActive);
        btn.classList.toggle('dark:hover:text-neutral-300', !isActive);
        panel.classList.toggle('hidden', !isActive);
      });
    }

    tabs.forEach(function(key) {
      document.getElementById('tab-btn-' + key).addEventListener('click', function() {
        active(key);
      });
    });

    var hashTab = window.location.hash.replace('#', '');
    active(tabs.indexOf(hashTab) !== -1 ? hashTab : 'installed');
  })();
</script>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-images.js?v=6"></script>
<script nonce="<%- nonce %>" src="/javascript/admin/admin-image-approvals.js?v=2"></script>

<%- include('../../components/footer') %>
