<%- include('../../components/header', { title: 'Images' }) %>

<style>
  ::-webkit-scrollbar { display: none; }
</style>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <div id="page-content" x-data="imageManager()" class="flex-1 overflow-y-auto pt-0 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Images' }
      ] }) %>

      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Images</h1>
          <p class="al-page-desc">Manage server images installed on this panel</p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button @click="openUploadImageModal()" type="button" class="al-btn-secondary"><%- icon('upload', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.uploadJson || 'Upload JSON' %></button>
          <button @click="openCreate()" type="button" class="al-btn-secondary"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>New Image</button>
          <a href="/admin/images#store" class="al-btn-secondary">Browse Store</a>
        </div>
      </div>

      <div class="al-page-body" data-al-tabs data-tabs-default="installed" data-tabs-hash>
      <div role="tablist" class="flex gap-1 mb-6">
        <button type="button" id="tab-btn-installed" data-tab="installed" role="tab" aria-selected="true" tabindex="0" aria-controls="tab-panel-installed" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('box', { class: 'size-4', strokeWidth: 1.5 }) %>Installed <span id="tabCountInstalled" class="ml-1 text-xs" style="color:var(--theme-text-muted)"><%= images.length %></span></button>
        <button type="button" id="tab-btn-approvals" data-tab="approvals" role="tab" aria-selected="false" tabindex="-1" aria-controls="tab-panel-approvals" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('clock', { class: 'size-4', strokeWidth: 1.5 }) %>Approvals <% if (pending && pending.length > 0) { %><span id="tabCountApprovals" class="ml-1 text-xs font-semibold" style="color:var(--theme-warning);"><%= pending.length %></span><% } %></button>
        <button type="button" id="tab-btn-store" data-tab="store" role="tab" aria-selected="false" tabindex="-1" aria-controls="tab-panel-store" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('store', { class: 'size-4', strokeWidth: 1.5 }) %>Store</button>
      </div>

      <div id="tab-panel-installed" role="tabpanel" aria-labelledby="tab-btn-installed" data-tab-panel="installed" class="mt-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="text-sm" style="color:var(--theme-text-muted);"><span id="installedImagesCount"><%= images.length %></span> image<%= images.length !== 1 ? 's' : '' %> installed on this panel</div>
        </div>

      <div id="installedEmptyState" class="flex flex-col items-center justify-center py-24 text-center <%= images.length === 0 ? '' : 'hidden' %>">
        <p class="text-sm" style="color:var(--theme-text-muted)">No images installed yet.</p>
        <a href="/admin/images#store" class="mt-4 al-btn-secondary inline-flex items-center gap-1.5"><%- icon('store', { class: 'size-4', strokeWidth: 1.5 }) %>Browse Store</a>
      </div>

      <%- include('../../fragments/admin/images/image-table', { images, settings, req }) %>
      </div>

      <div id="tab-panel-approvals" role="tabpanel" aria-labelledby="tab-btn-approvals" data-tab-panel="approvals" hidden>
        <%- include('../../fragments/admin/images/pending-approvals', { pending, settings, req }) %>
      </div>

      <div id="tab-panel-store" role="tabpanel" aria-labelledby="tab-btn-store" data-tab-panel="store" data-tab-src="/admin/images/store/panel" hidden></div>
      </div>
    </div>
  </div>
</main>

<!-- Reject modal -->
<div id="rejectModal" x-data="imageReject()" x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center" style="display:none" @keydown.escape.window="if(open) close()" @image-reject-show.window="show($event.detail.id, $event.detail.name)">
  <div class="al-sheet-panel rounded-2xl max-w-md w-full will-change-transform shadow-xl" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Reject image</h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)" x-text="rejectName"></p>
      </div>
      <button type="button" class="al-btn-ghost p-2 rounded-lg flex items-center justify-center shrink-0" @click="close()" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="px-6 py-4">
      <label class="al-label" for="rejectReason">Reason <span class="font-normal" style="color:var(--theme-text-muted)">(shown to the user)</span></label>
      <textarea x-model="reason" class="al-input w-full" rows="3" placeholder="e.g. Missing startup exit detection or required docker image."></textarea>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" class="al-btn-secondary px-4 py-2 text-xs font-medium" @click="close()">Cancel</button>
      <button type="button" @click="confirm()" class="al-btn-danger px-4 py-2 text-xs font-medium inline-flex items-center gap-2" :disabled="submitting">
        <%- icon('x', { class: 'size-3.5', strokeWidth: 1.5 }) %><span x-text="submitting ? 'Rejecting…' : 'Reject'">Reject</span>
      </button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
function imageReject() {
  return {
    open: false,
    rejectId: null,
    rejectName: '',
    reason: '',
    submitting: false,
    show(id, name) {
      this.rejectId = id;
      this.rejectName = name;
      this.reason = '';
      this.open = true;
    },
    close() { this.open = false; this.rejectId = null; },
    async confirm() {
      if (this.submitting || !this.rejectId) return;
      this.submitting = true;
      try {
        const res = await fetch('/admin/images/reject/' + this.rejectId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason: this.reason }),
        });
        const data = await res.json();
        this.close();
        if (data.error) { showToast(data.error, 'error'); }
        else { showToast(data.message || 'Image rejected.', 'success'); window.location.reload(); }
      } catch (e) { this.close(); showToast('Something went wrong.', 'error'); }
      finally { this.submitting = false; }
    }
  };
}
</script>

<div id="page-data" style="display:none"
  data-approve-confirm="Approve this image? It will become available to all users."
  data-approved="Image approved."
  data-rejected="Image rejected."
  data-error="Something went wrong."
></div>

<!-- Upload modal -->
<div id="uploadImageModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">
  <div id="uploadImageModalPanel" class="al-sheet-panel rounded-2xl max-w-md w-full will-change-transform shadow-xl max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Upload Image</h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)">Select a Pterodactyl egg JSON file to install.</p>
      </div>
      <button type="button" @click="closeUploadImageModal()" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4">
      <div class="flex gap-1 p-1 rounded-xl mb-4" style="background:var(--theme-bg-secondary)">
        <button type="button" id="uploadModeFile" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)]" style="color:var(--theme-text-strong); background:var(--theme-bg-card);">Upload file</button>
        <button type="button" id="uploadModeUrl" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)]" style="color:var(--theme-text-muted);">Import from URL</button>
      </div>
      <div id="uploadFileSection">
        <div class="mb-4">
          <label for="imageFileInput" class="w-full px-3 py-6 border-2 border-dashed rounded-xl focus:outline-none focus:ring-2 transition text-center cursor-pointer block" id="imageDropZone" style="border-color:var(--theme-border); color:var(--theme-text-strong);">
            <%- icon('upload', { class: 'w-10 h-10 mx-auto mb-2', fill: 'currentColor', strokeWidth: 1 }) %>
            <p style="color:var(--theme-text-muted)">Drag & drop a JSON file here or click to browse</p>
          </label>
          <input type="file" id="imageFileInput" class="hidden" accept=".json">
        </div>
      <div id="imageFilePreview" class="hidden">
        <div class="flex items-center p-3 rounded-xl" style="background:var(--theme-bg-secondary);">
          <%- icon('file-json', { class: 'w-6 h-6 mr-3', style: 'color:var(--theme-text-muted)' }) %>
          <div class="flex-1 truncate">
            <p id="imageSelectedFileName" class="font-medium truncate" style="color:var(--theme-text-strong)"></p>
            <p id="imageSelectedFileSize" class="text-sm" style="color:var(--theme-text-muted)"></p>
          </div>
          <button type="button" @click="removeSelectedImageFile()" class="ml-2" aria-label="Remove selected file" style="color:var(--theme-text-muted)">
            <%- icon('x', { class: 'w-5 h-5' }) %>
          </button>
        </div>
      </div>
      </div>
      <div id="importUrlSection" class="hidden">
        <label class="al-label" for="importUrlInput">Image URL</label>
        <input id="importUrlInput" type="url" placeholder="https://raw.githubusercontent.com/…/egg.json" class="al-input w-full">
        <p class="mt-2 text-xs" style="color:var(--theme-text-muted)">Fetch a Pterodactyl egg JSON from a raw URL and install it as an image.</p>
      </div>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" @click="closeUploadImageModal()" class="al-btn-secondary px-4 py-2 text-xs font-medium inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        Cancel
      </button>
      <button type="button" id="imageUploadButton" class="al-btn-primary px-3 py-2 text-sm font-medium inline-flex items-center gap-1.5" disabled>
        <%- icon('upload', { class: 'size-4', strokeWidth: 1.5 }) %>
        Upload
      </button>
      <button type="button" id="importUrlSubmit" class="al-btn-primary hidden px-3 py-2 text-sm font-medium inline-flex items-center gap-1.5">
        <%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %>
        Fetch &amp; Import
      </button>
    </div>
  </div>
</div>

<!-- Create content — hosted inside the shared window.modal shell -->
<div id="createContent" style="display:none;">
  <form onsubmit="submitCreateImage(event); return false;" class="flex flex-col gap-4">
      <div class="grid grid-cols-2 gap-3">
      <div class="col-span-2"><label class="al-label">Name <span style="color:var(--theme-danger)">*</span></label><input class="al-input" type="text" name="name" required placeholder="e.g. Minecraft Java"></div>
      <div><label class="al-label">Author</label><input class="al-input" type="text" name="author" placeholder="e.g. github.com/you"></div>
      <div><label class="al-label">Author Name</label><input class="al-input" type="text" name="authorName" placeholder="Your Name"></div>
      <div class="col-span-2"><label class="al-label">Startup Command <span style="color:var(--theme-danger)">*</span></label><input class="al-input" type="text" name="startup" required placeholder="java -Xms128M -jar server.jar" style="font-family:ui-monospace,monospace;font-size:12px;"></div>
      <div class="col-span-2"><label class="al-label">Description</label><textarea class="al-input" name="description" rows="2" placeholder="What does this image run?" style="resize:none;"></textarea></div>
    </div>
    <div class="flex gap-2 pt-1">
      <button type="button" @click="closeCreate()" class="flex-1 py-2 rounded-xl border text-sm font-medium hover:bg-[var(--theme-bg-hover)] transition inline-flex items-center justify-center gap-1.5" style="border-color:var(--theme-border);color:var(--theme-text)"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>Cancel</button>
      <button type="submit" class="flex-1 py-2 rounded-xl border text-sm font-medium shadow-lg hover:bg-[var(--theme-bg-hover)] transition inline-flex items-center justify-center gap-1.5" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text-strong)"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.createAndEdit || 'Create & Edit' %></button>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
function imageManager() {
  let _deleteId = null;

  function esc(str) {
    return String(str == null ? "" : str).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  function imageRowHtml(image) {
    return '<tr class="al-table-tr transition-colors cursor-pointer img-row" data-search="' +
      esc((image.name + " " + (image.author || "")).toLowerCase()) +
      '" @click="handleRowClick(event, \'/admin/images/edit/' + image.id + '\')">' +
      '<td class="al-table-td whitespace-nowrap py-4 pl-6 pr-3 font-medium" style="color:var(--theme-text-strong)">' + esc(image.name) + '</td>' +
      '<td class="al-table-td whitespace-nowrap px-3 py-4 col-hide">' + esc(image.author || "—") + '</td>' +
      '<td class="al-table-td whitespace-nowrap px-3 py-4 col-hide">' + esc(new Date(image.createdAt).toLocaleDateString()) + '</td>' +
      '<td class="whitespace-nowrap px-3 py-4 text-sm"><div class="flex gap-2">' +
      '<a href="/admin/images/edit/' + image.id + '" onclick="event.stopPropagation()" class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition inline-flex items-center gap-1.5">' + (window.alIcon ? alIcon("pencil", "size-4") : "") + 'Edit</a>' +
      '<a href="/admin/images/export/' + image.id + '" onclick="event.stopPropagation()" class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition inline-flex items-center gap-1.5">' + (window.alIcon ? alIcon("download", "size-4") : "") + 'Export</a>' +
      '<button onclick="event.stopPropagation(); openDelete(\'' + image.id + '\', \'' + esc(image.name).replace(/'/g, "\\'") + '\')" type="button" class="al-btn-danger" aria-label="Delete image ' + esc(image.name) + '">' + (window.alIcon ? alIcon("trash-2", "size-4") : "") + '</button>' +
      '</div></td></tr>';
  }

  function formatImageFileSize(bytes) {
    if (bytes === 0) return "0 Bytes";
    const sizes = ["Bytes", "KB", "MB", "GB"];
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return parseFloat((bytes / Math.pow(1024, i)).toFixed(2)) + " " + sizes[i];
  }

  function setUploadMode(mode) {
    const isUrl = mode === "url";
    const fileBtn = document.getElementById("uploadModeFile");
    const urlBtn = document.getElementById("uploadModeUrl");
    const fileSection = document.getElementById("uploadFileSection");
    const urlSection = document.getElementById("importUrlSection");
    const uploadBtn = document.getElementById("imageUploadButton");
    const submitBtn = document.getElementById("importUrlSubmit");
    const active = "color:var(--theme-text-strong); background:var(--theme-bg-card);";
    const idle = "color:var(--theme-text-muted);";
    if (fileBtn) fileBtn.setAttribute("style", isUrl ? idle : active);
    if (urlBtn) urlBtn.setAttribute("style", isUrl ? active : idle);
    if (fileSection) fileSection.classList.toggle("hidden", isUrl);
    if (urlSection) urlSection.classList.toggle("hidden", !isUrl);
    if (uploadBtn) uploadBtn.classList.toggle("hidden", isUrl);
    if (submitBtn) submitBtn.classList.toggle("hidden", !isUrl);
  }

  return {
    init() {
      const self = this;
      window.submitCreateImage = (e) => self.submitCreateImage(e);
      window.openDelete = (id, name) => self.openDelete(id, name);
      window.removeSelectedImageFile = () => self.removeSelectedImageFile();
      setUploadMode("file");
      const dropZone = document.getElementById("imageDropZone");
      const fileInput = document.getElementById("imageFileInput");
      const uploadButton = document.getElementById("imageUploadButton");
      if (dropZone) {
        dropZone.addEventListener("dragover", function (e) {
          e.preventDefault();
          dropZone.style.background = "var(--theme-bg-hover)";
          dropZone.style.borderColor = "var(--theme-accent)";
        });
        dropZone.addEventListener("dragleave", function (e) {
          e.preventDefault();
          dropZone.style.background = "";
          dropZone.style.borderColor = "var(--theme-border)";
        });
        dropZone.addEventListener("drop", (e) => {
          e.preventDefault();
          dropZone.style.background = "";
          dropZone.style.borderColor = "var(--theme-border)";
          if (e.dataTransfer.files.length > 0) this.handleImageFileSelection(e.dataTransfer.files[0]);
        });
      }
      if (fileInput) {
        fileInput.addEventListener("change", (e) => {
          if (e.target.files.length > 0) this.handleImageFileSelection(e.target.files[0]);
        });
      }
      if (uploadButton) {
        uploadButton.addEventListener("click", () => this.confirmImageUpload());
      }
      const importUrlSubmit = document.getElementById("importUrlSubmit");
      if (importUrlSubmit) {
        importUrlSubmit.addEventListener("click", async () => {
          const url = document.getElementById("importUrlInput").value.trim();
          if (!url) { showToast("Enter a URL.", "error"); return; }
          const btn = importUrlSubmit;
          btn.disabled = true; btn.classList.add("opacity-60");
          try {
            const r = await fetch("/admin/images/import-url", {
              method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ url }),
            });
            const d = await r.json();
            if (r.ok && d.success) {
              showToast(d.message || "Image imported.", "success");
              this.renderImageTable();
              this.closeUploadImageModal();
            } else { showToast(d.error || "Import failed.", "error"); }
          } catch { showToast("Import failed.", "error"); }
          finally { btn.disabled = false; btn.classList.remove("opacity-60"); }
        });
      }
      document.getElementById("uploadModeFile").addEventListener("click", () => setUploadMode("file"));
      document.getElementById("uploadModeUrl").addEventListener("click", () => {
        setUploadMode("url");
        document.getElementById("importUrlInput").focus();
      });
    },
    handleRowClick(e, url) {
      if (!e.target.closest("button,a")) window.location = url;
    },
    openCreate() {
      window.modal.show({
        title: "New Image",
        bodyNode: document.getElementById("createContent"),
        panelClass: "max-w-xl",
      });
    },
    closeCreate() { window.modal.close(); },
    openDelete(id, name) {
      _deleteId = id;
      window.modal.confirm({
        title: "Delete image?",
        body: '"' + name + '" will be permanently removed.',
        danger: true, confirmLabel: "Delete",
        onConfirm: () => this.deleteImage(),
      });
    },
    async renderImageTable() {
      const res = await fetch("/admin/images/list");
      const data = await res.json();
      const tbody = document.getElementById("tableBody");
      if (!data.success) return;
      const emptyState = document.getElementById("installedEmptyState");
      const tableSection = document.getElementById("installedTableSection");
      if (emptyState) emptyState.classList.toggle("hidden", data.images.length > 0);
      if (tableSection) tableSection.classList.toggle("hidden", data.images.length === 0);
      if (!tbody) return;
      const searchInput = document.getElementById("imageFilterInput");
      const q = searchInput ? searchInput.value.toLowerCase().trim() : "";
      tbody.innerHTML = data.images.map(imageRowHtml).join("");
      let n = 0;
      tbody.querySelectorAll(".img-row").forEach(function (r) {
        const match = !q || r.dataset.search.includes(q);
        r.style.display = match ? "" : "none";
        if (match) n++;
      });
      const noResults = document.getElementById("noResults");
      if (noResults) noResults.classList.toggle("hidden", data.images.length === 0 || n > 0 || !q);
      const installedCountEl = document.getElementById("tabCountInstalled");
      if (installedCountEl) installedCountEl.textContent = data.images.length;
      const installedTextEl = document.getElementById("installedImagesCount");
      if (installedTextEl) installedTextEl.textContent = data.images.length;
      if (window.alTableScan) alTableScan(tbody);
    },
    async deleteImage() {
      if (!_deleteId) return;
      const res = await fetch("/admin/images/delete/" + _deleteId, { method: "DELETE" });
      if (res.ok) { showToast("Image deleted.", "success"); await this.renderImageTable(); }
      else { showToast("Failed.", "error"); }
    },
    openUploadImageModal() {
      setUploadMode("file");
      const modal = document.getElementById("uploadImageModal");
      if (!modal) return;
      modal.classList.remove("opacity-0", "pointer-events-none");
      Animate.openModal(modal, document.getElementById("uploadImageModalPanel"));
      this.removeSelectedImageFile();
      const fileInput = document.getElementById("imageFileInput");
      if (fileInput) fileInput.value = "";
    },
    closeUploadImageModal() {
      const modal = document.getElementById("uploadImageModal");
      if (!modal) return;
      Animate.closeModal(modal, document.getElementById("uploadImageModalPanel"), function () {
        modal.classList.add("opacity-0", "pointer-events-none");
      });
    },
    removeSelectedImageFile() {
      window.selectedImageFile = null;
      const preview = document.getElementById("imageFilePreview");
      const dropZone = document.getElementById("imageDropZone");
      const btn = document.getElementById("imageUploadButton");
      if (preview) preview.classList.add("hidden");
      if (dropZone) dropZone.classList.remove("hidden");
      if (btn) btn.disabled = true;
    },
    handleImageFileSelection(file) {
      if (!file) return;
      window.selectedImageFile = file;
      document.getElementById("imageSelectedFileName").textContent = file.name;
      document.getElementById("imageSelectedFileSize").textContent = formatImageFileSize(file.size);
      document.getElementById("imageFilePreview").classList.remove("hidden");
      document.getElementById("imageDropZone").classList.add("hidden");
      document.getElementById("imageUploadButton").disabled = false;
    },
    confirmImageUpload() {
      if (!window.selectedImageFile) { showToast("Select a JSON file to upload.", "error"); return; }
      const file = window.selectedImageFile;
      this.closeUploadImageModal();
      const self = this;
      const r = new FileReader();
      r.onload = function (e) {
        try { JSON.parse(e.target.result); } catch { showToast("Invalid JSON.", "error"); return; }
        const xhr = new XMLHttpRequest();
        xhr.open("POST", "/admin/images/upload", true);
        xhr.setRequestHeader("Content-Type", "application/json");
        xhr.onload = () => {
          if (xhr.status === 200) { showToast("Image uploaded.", "success"); self.renderImageTable(); }
          else { showToast("Upload failed.", "error"); }
        };
        xhr.onerror = () => showToast("Upload failed.", "error");
        xhr.send(e.target.result);
      };
      r.readAsText(file);
    },
    submitCreateImage(e) {
      const form = e.target;
      const data = Object.fromEntries(new FormData(form));
      if (!data.name || !data.startup) { showToast("Name and startup command are required.", "error"); return; }
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || "";
      fetch("/admin/images/create", {
        method: "POST",
        headers: { "Content-Type": "application/json", "CSRF-Token": csrfToken },
        body: JSON.stringify(data),
      }).then(r => r.json()).then(result => {
        if (result.success !== false) {
          showToast("Image created.", "success");
          this.closeCreate();
          this.renderImageTable();
        } else { showToast(result.error || result.message || "Failed to create image.", "error"); }
      }).catch(() => { showToast("Network error.", "error"); });
    }
  };
}
</script>

