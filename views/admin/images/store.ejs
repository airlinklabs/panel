<%- include('../../components/header', { title: 'Image Store' }) %>

<% if (isMobileViewport) { %>
<style>
  .store-badge { display:inline-flex;align-items:center;padding:2px 8px;border-radius:9999px;font-size:10px;font-weight:500;white-space:nowrap; }
  .cat-game        { background:#ede9fe; color:#6d28d9; }
  .cat-application { background:#e0f2fe; color:#0369a1; }
  .cat-generic     { background:#dcfce7; color:#15803d; }
  .dark .cat-game        { background:rgba(139,92,246,0.15); color:#a78bfa; }
  .dark .cat-application { background:rgba(14,165,233,0.15);  color:#38bdf8; }
  .dark .cat-generic     { background:rgba(34,197,94,0.15);   color:#4ade80; }
  .sk { border-radius:10px; animation:sk-pulse 1.4s ease-in-out infinite; }
  html:not(.dark) .sk { background:#f0f0f0; }
  html.dark .sk { background:rgba(255,255,255,0.05); }
  @keyframes sk-pulse { 0%,100%{opacity:1} 50%{opacity:0.35} }
  .cat-btn-active  { background:#171717 !important; color:#fff !important; border-color:transparent !important; }
  .dark .cat-btn-active { background:#fff !important; color:#0a0a0a !important; }
</style>

<main id="page-content" class="">
  <%- include('../../components/template') %>
  <%- include('../../components/toast') %>

  <div class="px-4 py-5">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="text-base font-medium text-neutral-800 dark:text-white">Image Store</h1>
        <p class="text-xs text-neutral-500 mt-0.5">Community images, cached server-side.</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="refreshCatalogue()" title="Refresh" id="refreshBtn"
          class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
          <%- icon('refresh-cw', { size: 16, class: 'shrink-0' }) %>
        </button>
        <a href="/admin/images" class="text-xs text-neutral-500 flex items-center gap-1">
          <%- icon('chevron-left', { class: 'w-3.5 h-3.5' }) %>Back
        </a>
      </div>
    </div>

    <div class="relative mb-3">
      <%- icon('search', { class: 'absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none' }) %>
      <input id="searchInput" type="text" placeholder="Search images…"
        class="w-full pl-9 pr-4 py-2.5 text-sm rounded-xl border border-neutral-200 dark:border-neutral-700/50
               bg-white dark:bg-neutral-800/50 text-neutral-800 dark:text-white
               placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition">
    </div>

    <div id="catBar" class="flex gap-1.5 mb-2 overflow-x-auto pb-1">
      <button data-cat="all"         class="cat-btn store-badge bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 border border-transparent cursor-pointer shrink-0">All</button>
      <button data-cat="game"        class="cat-btn store-badge bg-white dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700/50 cursor-pointer shrink-0">Games</button>
      <button data-cat="application" class="cat-btn store-badge bg-white dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700/50 cursor-pointer shrink-0">Apps</button>
      <button data-cat="generic"     class="cat-btn store-badge bg-white dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700/50 cursor-pointer shrink-0">Generic</button>
    </div>

    <div id="groupBar" class="flex gap-1.5 mb-3 overflow-x-auto pb-1"></div>

    <div class="flex items-center gap-2 mb-3 min-h-[20px]">
      <span id="statusText" class="text-xs text-neutral-400">Loading catalogue…</span>
      <span id="loadingDot" class="inline-block w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse shrink-0"></span>
    </div>

    <div id="skeletons" class="space-y-2">
      <% for (let i = 0; i < 6; i++) { %>
      <div data-animate-card class="rounded-xl border border-neutral-200 dark:border-neutral-700/30 p-4 flex flex-col gap-2.5 bg-white dark:bg-neutral-800">
        <div class="sk h-4 w-2/3"></div>
        <div class="sk h-3 w-full"></div>
        <div class="sk h-3 w-3/4"></div>
      </div>
      <% } %>
    </div>

    <div id="sections" class="hidden space-y-6"></div>

    <div id="emptyState" class="hidden py-16 flex flex-col items-center text-center">
      <%- icon('search', { class: 'w-9 h-9 text-neutral-300 dark:text-neutral-600 mb-2' }) %>
      <p class="text-sm font-medium text-neutral-500">No images match</p>
    </div>
  </div>
</main>

<div id="installModal" class="hidden fixed inset-0 z-modal-backdrop bg-black/50 flex items-end">
  <div class="bg-white dark:bg-neutral-900 border-t border-neutral-200 dark:border-neutral-700 rounded-t-2xl w-full p-5">
    <h2 class="text-sm font-semibold text-neutral-800 dark:text-white mb-0.5" id="modalTitle">Install image</h2>
    <p class="text-xs text-neutral-500 mb-4" id="modalSubtitle">Add this image to your panel.</p>
    <div id="modalError" class="hidden mb-3 rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-4 py-3">
      <p class="text-xs text-red-600 dark:text-red-400" id="modalErrorText"></p>
    </div>
    <div class="flex gap-3">
      <button onclick="closeModal()" class="flex-1 py-2.5 rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 text-neutral-700 dark:text-white text-sm font-medium transition">Cancel</button>
      <button id="confirmBtn" onclick="confirmInstall()" class="flex-1 py-2.5 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-sm font-medium transition">Install</button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
const CAT_COLORS = { game:'cat-game', application:'cat-application', generic:'cat-generic' };
const CAT_LABELS = { game:'Game', application:'App', generic:'Generic' };

let allImages=[], activeCat='all', activeGroup='all', searchQuery='', pendingEgg=null;

async function loadCatalogue() {
  setStatus('Loading catalogue…', true);
  try {
    const res = await fetch('/admin/images/store/catalogue');
    if (!res.ok) throw new Error(`${res.status}`);
    const data = await res.json();
    allImages = data.images || [];
    const skel = document.getElementById('skeletons');
    if (skel) skel.remove();
    buildGroupBar(); render();
    const age = data.builtAt ? Math.round((Date.now()-data.builtAt)/60000) : 0;
    setStatus(`${allImages.length} images · ${age < 1 ? 'fresh' : age+'m old'}`, false);
  } catch(err) { setStatus('Failed to load catalogue.', false); }
}

function buildGroupBar() {
  const bar = document.getElementById('groupBar');
  const groups = [...new Set(allImages.filter(i=>activeCat==='all'||i.category===activeCat).map(i=>i.group))].sort();
  bar.innerHTML = '';
  bar.appendChild(mkGroupBtn('all','All',activeGroup==='all'));
  groups.forEach(g => bar.appendChild(mkGroupBtn(g,cap(g),activeGroup===g)));
}

function mkGroupBtn(val,label,active) {
  const b = document.createElement('button');
  b.dataset.group = val;
  b.className = `store-badge cursor-pointer transition shrink-0 ${active ? 'bg-neutral-800 dark:bg-neutral-200 text-white dark:text-neutral-900 border border-transparent' : 'bg-white dark:bg-neutral-800/60 text-neutral-500 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700/40'}`;
  b.textContent = label;
  b.addEventListener('click',()=>{ activeGroup=val; buildGroupBar(); render(); });
  return b;
}

function applyFilters() {
  const q = searchQuery.trim().toLowerCase();
  return allImages.filter(img => {
    if (activeCat!=='all' && img.category!==activeCat) return false;
    if (activeGroup!=='all' && img.group!==activeGroup) return false;
    if (q) { const hay=`${img.name} ${img.description} ${img.readme} ${img.author} ${img.group}`.toLowerCase(); if(!hay.includes(q)) return false; }
    return true;
  });
}

function render() {
  const visible = applyFilters();
  const sections = document.getElementById('sections');
  const empty = document.getElementById('emptyState');
  sections.innerHTML = '';
  if (visible.length===0 && allImages.length>0) { sections.classList.add('hidden'); empty.classList.remove('hidden'); return; }
  empty.classList.add('hidden'); sections.classList.remove('hidden');
  const isGrouped = !searchQuery.trim() && activeGroup==='all';
  if (isGrouped) {
    const grouped = new Map();
    visible.forEach(img => { if(!grouped.has(img.group)) grouped.set(img.group,[]); grouped.get(img.group).push(img); });
    [...grouped.entries()].sort((a,b)=>a[0].localeCompare(b[0])).forEach(([g,imgs])=>sections.appendChild(buildSection(cap(g),imgs)));
  } else {
    sections.appendChild(buildSection(null,visible));
  }
}

function buildSection(title, images) {
  const wrap = document.createElement('div');
  if (title) {
    const h = document.createElement('div');
    h.className = 'flex items-center gap-2 mb-2';
    h.innerHTML = `<h2 class="text-xs font-semibold text-neutral-600 dark:text-neutral-400 uppercase tracking-wider">${esc(title)}</h2><span class="text-xs text-neutral-400">${images.length}</span><div class="flex-1 h-px bg-neutral-100 dark:bg-neutral-800"></div>`;
    wrap.appendChild(h);
  }
  const list = document.createElement('div');
  list.className = 'space-y-2';
  images.forEach(img => list.appendChild(buildCard(img)));
  wrap.appendChild(list);
  return wrap;
}

function buildCard(img) {
  const color = CAT_COLORS[img.category]||'bg-neutral-100 text-neutral-600';
  const label = CAT_LABELS[img.category]||img.category;
  const desc = (img.readme&&img.readme.length>20?img.readme:img.description)||'';
  const short = desc.length>90 ? desc.slice(0,88)+'…' : desc;
  const el = document.createElement('div');
  el.className = 'rounded-xl border border-neutral-200 dark:border-neutral-800/40 bg-white dark:bg-neutral-800 p-4 flex flex-col gap-2 transition hover:bg-neutral-50 dark:hover:bg-neutral-700/20';
  el.innerHTML = `
    <div class="flex items-start justify-between gap-2">
      <p class="text-sm font-medium text-neutral-800 dark:text-white leading-snug">${esc(img.name)}</p>
      <span class="store-badge ${color} shrink-0">${label}</span>
    </div>
    ${img.subGroup&&img.subGroup!==img.group?`<p class="text-[10px] text-neutral-400 font-mono">${esc(img.subGroup)}</p>`:''}
    ${short?`<p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">${esc(short)}</p>`:''}
    <button class="install-btn mt-1 w-full py-2 rounded-xl border border-neutral-200 dark:border-neutral-800/40 bg-white dark:bg-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-700/30 text-neutral-700 dark:text-neutral-300 text-xs font-medium transition">Install</button>`;
  el.querySelector('.install-btn').addEventListener('click',()=>openModal(img));
  return el;
}

function setStatus(msg,loading) {
  document.getElementById('statusText').textContent=msg;
  const dot=document.getElementById('loadingDot');
  if(dot) dot.style.display=loading?'':'none';
}

document.getElementById('searchInput').addEventListener('input',function(){ searchQuery=this.value; render(); });

document.querySelectorAll('.cat-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    activeCat=btn.dataset.cat; activeGroup='all';
    document.querySelectorAll('.cat-btn').forEach(b=>{
      const on=b.dataset.cat===activeCat;
      b.className=`cat-btn store-badge cursor-pointer transition shrink-0 ${on?'bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 border border-transparent':'bg-white dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700/50'}`;
    });
    buildGroupBar(); render();
  });
});

function openModal(img) {
  pendingEgg={name:img.name,egg:img.egg};
  document.getElementById('modalTitle').textContent=`Install "${img.name}"`;
  document.getElementById('modalSubtitle').textContent=img.subGroup?`from ${img.subGroup}`:'Add this image to your panel.';
  document.getElementById('modalError').classList.add('hidden');
  const btn=document.getElementById('confirmBtn'); btn.disabled=false; btn.textContent='Install';
  document.getElementById('installModal').classList.remove('hidden');
}
function closeModal() { document.getElementById('installModal').classList.add('hidden'); pendingEgg=null; }
document.getElementById('installModal').addEventListener('click',e=>{ if(e.target===document.getElementById('installModal')) closeModal(); });

async function confirmInstall() {
  if(!pendingEgg) return;
  const btn=document.getElementById('confirmBtn'); btn.disabled=true; btn.textContent='Installing…';
  document.getElementById('modalError').classList.add('hidden');
  try {
    const res=await fetch('/admin/images/store/install',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(pendingEgg.egg)});
    const body=await res.json();
    if(!res.ok){ document.getElementById('modalErrorText').textContent=body.error||'Failed.'; document.getElementById('modalError').classList.remove('hidden'); btn.disabled=false; btn.textContent='Install'; return; }
    closeModal(); showToast(`"${pendingEgg.name}" installed. Nice.`,'success');
  } catch(err){ document.getElementById('modalErrorText').textContent=err.message||'Network error.'; document.getElementById('modalError').classList.remove('hidden'); btn.disabled=false; btn.textContent='Install'; }
}

async function refreshCatalogue() {
  document.getElementById('refreshBtn').disabled=true; setStatus('Refreshing…',true);
  try { await fetch('/admin/images/store/refresh',{method:'POST'}); allImages=[]; document.getElementById('sections').innerHTML=''; document.getElementById('groupBar').innerHTML=''; await loadCatalogue(); }
  finally { document.getElementById('refreshBtn').disabled=false; }
}

function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function cap(s){ return s.replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase()); }

loadCatalogue();
</script>

<% } else { %>
<%- include('../../components/toast') %>

<style>
  ::-webkit-scrollbar { display: none; }
  .modal-overlay {
    position: fixed; inset: 0; z-index: var(--z-modal-backdrop);
    background: var(--theme-overlay, rgba(0,0,0,0.5));
    display: flex; align-items: center; justify-content: center; padding: 16px;
    opacity: 0; pointer-events: none; transition: opacity 0.25s;
  }
  .modal-overlay.open { opacity: 1; pointer-events: auto; }
  .modal-box {
    background: var(--theme-bg-card, #fff); border: 1px solid var(--theme-border, #e5e5e5); border-radius: 12px;
    width: 100%; max-width: 780px; height: 560px; max-height: calc(100vh - 40px);
    display: flex; flex-direction: column;
    transform: scale(0.96); opacity: 0;
    transition: transform 0.25s, opacity 0.25s;
    overflow: hidden;
  }
  html.dark .modal-box { background: var(--theme-bg-card, #1c1c1c); border-color: var(--theme-border-subtle, rgba(255,255,255,0.08)); }
  .modal-overlay.open .modal-box { transform: scale(1); opacity: 1; }
  .modal-box.narrow { max-width: 520px; height: 500px; }
  .modal-two-col { display: flex; flex: 1; overflow: hidden; min-height: 0; }
  .modal-left {
    width: 260px; min-width: 200px; flex-shrink: 0;
    border-right: 1px solid var(--theme-border, #e5e5e5);
    overflow-y: auto; padding: 18px;
    display: flex; flex-direction: column; gap: 10px;
  }
  html.dark .modal-left { border-right-color: var(--theme-border-subtle, rgba(255,255,255,0.06)); }
  .modal-right { flex: 1; min-width: 0; overflow-y: auto; padding: 18px; }
  .modal-single-body { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .md-body { font-size: 12.5px; line-height: 1.75; color: var(--theme-text-muted, #525252); }
  html.dark .md-body { color: var(--theme-text-muted, #737373); }
  .md-body h1, .md-body h2 { font-size: 13px; font-weight: 600; color: var(--theme-text-strong, #171717); margin: 0 0 6px; }
  html.dark .md-body h1, html.dark .md-body h2 { color: var(--theme-text, #e5e5e5); }
  .md-body h3 { font-size: 12px; font-weight: 600; color: var(--theme-text-muted, #525252); margin: 10px 0 3px; }
  html.dark .md-body h3 { color: var(--theme-text, #a3a3a3); }
  .md-body p { margin: 0 0 8px; }
  .md-body a { color: var(--theme-accent, #7c3aed); text-decoration: none; }
  .md-body a:hover { text-decoration: underline; }
  .md-body code { font-family: ui-monospace,monospace; font-size: 11px; background: var(--theme-bg-secondary, #f4f4f5); padding: 1px 5px; border-radius: 4px; color: var(--theme-text-muted, #3f3f46); }
  html.dark .md-body code { background: var(--theme-bg-hover, rgba(255,255,255,0.07)); color: var(--theme-text-strong, #d4d4d4); }
  .md-body pre { background: var(--theme-bg-secondary, #f4f4f5); border: 1px solid var(--theme-border, #e5e5e5); border-radius: 8px; padding: 10px 12px; overflow-x: auto; margin: 0 0 8px; }
  html.dark .md-body pre { background: var(--theme-bg-hover, rgba(255,255,255,0.04)); border-color: var(--theme-border-subtle, rgba(255,255,255,0.07)); }
  .md-body pre code { background: none; padding: 0; }
  .md-body ul, .md-body ol { padding-left: 16px; margin: 0 0 8px; }
  .md-body li { margin-bottom: 2px; }
  .md-body hr { border: none; border-top: 1px solid var(--theme-border, #e5e5e5); margin: 10px 0; }
  html.dark .md-body hr { border-top-color: var(--theme-border-subtle, rgba(255,255,255,0.06)); }
  .md-body strong { color: var(--theme-text-strong, #171717); }
  html.dark .md-body strong { color: var(--theme-text, #e5e5e5); }
  .sub-row {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 7px 10px; border-radius: 8px; cursor: pointer;
    border: 1px solid var(--theme-border, #e5e5e5);
    transition: background 0.12s, border-color 0.12s; margin-bottom: 4px;
  }
  html.dark .sub-row { border-color: var(--theme-border-subtle, rgba(255,255,255,0.07)); }
  .sub-row:hover { background: var(--theme-bg-secondary, #f5f5f5); border-color: var(--theme-border-strong, #d4d4d4); }
  html.dark .sub-row:hover { background: var(--theme-bg-hover, rgba(255,255,255,0.04)); border-color: var(--theme-border-subtle, rgba(255,255,255,0.13)); }
  .sk { border-radius: 8px; animation: sk-pulse 1.4s ease-in-out infinite; }
  html:not(.dark) .sk { background: var(--theme-bg-secondary, #f0f0f0); }
  html.dark .sk { background: var(--theme-bg-hover, rgba(255,255,255,0.05)); }
  @keyframes sk-pulse { 0%,100%{opacity:1} 50%{opacity:0.35} }
  .vtog { display: flex; gap: 1px; background: var(--theme-bg-secondary, #f5f5f5); border: 1px solid var(--theme-border, #e5e5e5); border-radius: 10px; padding: 2px; }
  html.dark .vtog { background: var(--theme-bg-hover, rgba(255,255,255,0.04)); border-color: var(--theme-border-subtle, rgba(255,255,255,0.08)); }
  .vtog button { padding: 4px 14px; border-radius: 8px; font-size: 12px; font-weight: 500; cursor: pointer; border: none; background: transparent; color: var(--theme-text-muted, #737373); transition: background 0.12s, color 0.12s; }
  html.dark .vtog button { color: var(--theme-text-muted, #525252); }
  .vtog button.active { background: var(--theme-bg-card, #fff); color: var(--theme-text-strong, #171717); box-shadow: 0 1px 3px var(--theme-shadow-sm, rgba(0,0,0,0.07)); }
  html.dark .vtog button.active { background: var(--theme-bg-hover, rgba(255,255,255,0.1)); color: var(--theme-text, #e5e5e5); }
  .grp-row {
    display: flex; align-items: center;
    padding: 11px 16px; cursor: pointer;
    transition: background 0.1s;
  }
  .grp-row:hover { background: var(--theme-bg-input, #f9fafb); }
  html.dark .grp-row:hover { background: var(--theme-bg-hover, rgba(255,255,255,0.025)); }
  .cat-game        { background: var(--theme-info-bg, #ede9fe); color: var(--theme-info-text, #6d28d9); }
  .cat-application { background: var(--theme-info-bg, #e0f2fe); color: var(--theme-info-text, #0369a1); }
  .cat-generic     { background: var(--theme-success-bg, #dcfce7); color: var(--theme-success-text, #15803d); }
  html.dark .cat-game        { background: var(--theme-info-bg, rgba(139,92,246,0.15)); color: var(--theme-info, #a78bfa); }
  html.dark .cat-application { background: var(--theme-info-bg, rgba(14,165,233,0.15)); color: var(--theme-info, #38bdf8); }
  html.dark .cat-generic     { background: var(--theme-success-bg, rgba(34,197,94,0.15)); color: var(--theme-success, #4ade80); }
  .err-box { background: var(--theme-danger-bg, rgba(239,68,68,0.08)); border: 1px solid var(--theme-danger-border, rgba(239,68,68,0.2)); border-radius: 9px; padding: 10px 12px; }
  .err-txt { font-size: 11px; color: var(--theme-danger, #dc2626); }
  html.dark .err-txt { color: var(--theme-danger, #f87171); }
  @media (max-width: 640px) {
    .modal-box { height: auto; max-height: calc(100vh - 40px); }
    .modal-two-col { flex-direction: column; }
    .modal-left { width: 100%; border-right: none; border-bottom: 1px solid var(--theme-border, #e5e5e5); }
    html.dark .modal-left { border-bottom-color: var(--theme-border-subtle, rgba(255,255,255,0.06)); }
    .col-hide { display: none; }
  }
  @media (min-width: 641px) { .col-hide-desktop { display: none; } }
</style>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="w-60 h-full"><%- include('../../components/template') %></div>
    <div id="page-content" class="flex-1 p-6 overflow-y-auto pt-16">

      <div class="sm:flex sm:items-center px-8 pt-4">
        <%- include('../../components/pageTitle', { title: 'Image Store', description: 'Browse and install images from the Pterodactyl community' }) %>
        <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
          <button id="refreshBtn" onclick="doRefresh()" type="button" class="al-ui-button">Refresh</button>
        </div>
      </div>

      <div class="mx-8 mt-6 flex border-b border-neutral-200 dark:border-neutral-800">
        <a href="/admin/images" class="px-1 py-2.5 mr-5 text-sm font-medium text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 border-b-2 border-transparent -mb-px transition">Installed</a>
        <span class="px-1 py-2.5 text-sm font-medium text-neutral-800 dark:text-white border-b-2 border-neutral-800 dark:border-white -mb-px">Store</span>
      </div>

      <div class="mx-8 mt-5 flex items-center justify-between gap-3 flex-wrap mb-1">
        <div class="flex items-center gap-3">
          <input id="imageFilterInput" type="text" placeholder="Search…" class="w-52 al-input">
          <span id="statusText" class="text-xs text-neutral-400 dark:text-neutral-500 whitespace-nowrap"></span>
        </div>
        <div class="vtog">
          <button id="btnAll" onclick="setView('all')">All</button>
          <button id="btnApp" class="active" onclick="setView('app')">By App</button>
        </div>
      </div>

      <div id="loadingEl" class="m-8 space-y-2">
        <% for(let i=0;i<8;i++){%><div class="sk h-11 w-full"></div><%}%>
      </div>
      <div id="errorEl" style="display:none" class="mx-8 mt-6 py-16 text-center">
        <p class="text-sm text-neutral-500">Failed to load catalogue.</p>
        <button onclick="loadCatalogue()" class="mt-3 text-xs text-neutral-400 underline cursor-pointer bg-transparent border-none">Retry</button>
      </div>
      <div id="emptyEl" style="display:none" class="mx-8 mt-6 py-16 text-center">
        <p class="text-sm text-neutral-500">No images match your search.</p>
      </div>

      <div id="allView" style="display:none" class="overflow-x-auto shadow-sm rounded-xl m-8 border border-neutral-200 dark:border-neutral-800/40">
        <table class="min-w-full divide-y divide-neutral-200 dark:divide-white/10">
          <thead class="bg-neutral-50 dark:bg-neutral-800/50">
            <tr>
              <th class="py-3.5 pl-6 pr-3 text-left text-sm font-medium text-neutral-800 dark:text-white">Name</th>
              <th class="px-3 py-3.5 text-left text-sm font-medium text-neutral-800 dark:text-white col-hide">Category</th>
              <th class="px-3 py-3.5 text-left text-sm font-medium text-neutral-800 dark:text-white col-hide">Author</th>
              <th class="px-3 py-3.5 text-left text-sm font-medium text-neutral-800 dark:text-white">Actions</th>
            </tr>
          </thead>
          <tbody id="allBody" class="divide-y divide-neutral-100 dark:divide-white/5 bg-white dark:bg-neutral-800"></tbody>
        </table>
      </div>

      <div id="appView" style="display:none" class="m-8 space-y-3"></div>
    </div>
  </div>
</main>

<div class="modal-overlay" id="groupOverlay">
  <div class="modal-box">
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-200 dark:border-white/5 flex-shrink-0">
      <div class="flex items-center gap-2 min-w-0">
        <p id="grpTitle" class="text-sm font-semibold text-neutral-800 dark:text-white truncate"></p>
        <span id="grpCount" class="text-xs text-neutral-400 dark:text-neutral-500 whitespace-nowrap"></span>
      </div>
      <button onclick="closeGroup()" class="ml-3 shrink-0 w-7 h-7 flex items-center justify-center rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-400 transition">
        <%- icon('x', { size: 16, class: 'shrink-0' }) %>
      </button>
    </div>
    <div class="modal-two-col">
      <div class="modal-left">
        <p class="text-[10px] font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">Images</p>
        <div id="grpSubList"></div>
      </div>
      <div class="modal-right">
        <p class="text-[10px] font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-3">README</p>
        <div id="grpReadme" class="md-body"></div>
      </div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="eggOverlay">
  <div class="modal-box narrow">
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-200 dark:border-white/5 flex-shrink-0">
      <div class="flex items-center gap-2 min-w-0">
        <p id="eggTitle" class="text-sm font-semibold text-neutral-800 dark:text-white truncate"></p>
        <span id="eggCat" class="text-[10px] font-medium px-2 py-0.5 rounded-full whitespace-nowrap"></span>
      </div>
      <button onclick="closeEgg()" class="ml-3 shrink-0 w-7 h-7 flex items-center justify-center rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-400 transition">
        <%- icon('x', { size: 16, class: 'shrink-0' }) %>
      </button>
    </div>
    <div class="modal-single-body">
      <p id="eggDesc" class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed"></p>
      <p id="eggAuthor" class="text-[11px] text-neutral-400 dark:text-neutral-500"></p>
      <div class="flex-1 overflow-y-auto">
        <p class="text-[10px] font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-2">README</p>
        <div id="eggReadme" class="md-body"></div>
      </div>
      <div id="eggErr" style="display:none" class="err-box"><p id="eggErrTxt" class="err-txt"></p></div>
      <button id="eggInstallBtn" onclick="confirmInstall()" type="button"
        class="w-full al-ui-button-primary mt-auto">
        Install
      </button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>" src="/js/admin/image-store.js"></script>
<% } %>

<%- include('../../components/footer') %>
