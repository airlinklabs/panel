<%- include('../../components/header', { title: 'Image Store' }) %>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Images', href: '/admin/images' },
        { label: 'Store' }
      ] }) %>

      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Image Store</h1>
          <p class="al-page-desc">Browse and install images from the Pterodactyl community</p>
        </div>
      </div>

      <div class="al-page-body">
        <div class="flex">
          <a href="/admin/images" class="px-3 py-2 mr-4 text-sm font-medium transition hover:text-[var(--theme-text)]" style="color:var(--theme-text-muted)">Installed</a>
          <span class="px-3 py-2 text-sm font-medium rounded-lg" style="background:var(--theme-primary);color:var(--theme-accent-text)">Store</span>
        </div>

        <%- include('./store-panel') %>

      </div>

    </div>
  </div>
</main>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-image-store.js?v=9"></script>

<%- include('../../components/footer') %>
