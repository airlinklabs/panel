<%- include('../../layouts/admin', { title: t('imageApprovalsTitle') }) %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbImages'), url: '/admin/images' },
    { label: t('approvals') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('imageApprovalsTitle') %></h1>
    <p class="al-page-desc"><%= t('imageApprovalsDesc') %></p>
  </div>
  <div>
    <a href="/admin/images" class="al-btn-secondary">
      <%- icon('arrow-left', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('backToImages') %>
    </a>
  </div>
</div>

<div class="al-page-body">
  <div>
    <% if (!pending || pending.length === 0) { %>
      <%- include('../../partials/empty-state', {
        iconName: 'check',
        title: t('noImagesWaiting'),
        description: t('userSubmissionsAppear')
      }) %>
    <% } else { %>
      <div id="pendingApprovalsList" class="space-y-3">
        <% pending.forEach(function(image) { %>
        <div class="pending-card al-card" data-pending-image="<%= image.id %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="flex items-center gap-1.5">
                <h3 class="text-[13px] font-semibold truncate" style="color:var(--theme-text-strong)"><%= image.name %></h3>
                <span class="al-badge al-badge-warning"><%= t('pending') %></span>
              </div>
              <% if (image.description) { %><p class="text-[13px] mt-1" style="color:var(--theme-text-muted)"><%= image.description %></p><% } %>
              <% if (image.creator) { %>
              <p class="text-[11px] mt-1.5" style="color:var(--theme-text-muted)">
                <%= t('submittedBy') %> <span class="font-medium" style="color:var(--theme-text-strong)"><%= image.creator.username || image.creator.email %></span>
                &middot; <%= new Date(image.createdAt).toLocaleString() %>
              </p>
              <% } %>
              <div class="flex flex-wrap gap-3 mt-2 text-[11px]" style="color:var(--theme-text-muted)">
                <span class="inline-flex items-center gap-1.5"><%- icon('terminal', { class: 'size-3', strokeWidth: 1.5 }) %><code style="font-family:ui-monospace,monospace;color:var(--theme-text-strong)"><%= image.startup || '' %></code></span>
                <span class="inline-flex items-center gap-1.5"><%- icon('container', { class: 'size-3', strokeWidth: 1.5 }) %><code style="font-family:ui-monospace,monospace;color:var(--theme-text-strong)"><%= image.dockerImages || '[]' %></code></span>
              </div>
            </div>
            <div class="flex gap-1.5 shrink-0">
              <a href="/admin/images/edit/<%= image.id %>" class="al-btn-ghost al-btn-sm">
                <%- icon('external-link', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('view') %>
              </a>
              <button type="button" class="al-btn-primary al-btn-sm" data-approve-image="<%= image.id %>">
                <%- icon('check', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('approve') %>
              </button>
              <button type="button" class="al-btn-danger al-btn-sm" data-reject-image="<%= image.id %>" data-reject-name="<%= image.name %>">
                <%- icon('x', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('reject') %>
              </button>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<!-- Reject modal -->
<div id="rejectModal" class="al-sheet-overlay opacity-0 pointer-events-none">
  <div class="al-sheet-panel rounded-2xl max-w-md w-full will-change-transform shadow-xl" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div>
        <h2 class="text-[13px] font-semibold" style="color:var(--theme-text-strong)"><%= t('rejectImage') %></h2>
        <p class="text-[11px] mt-0.5" style="color:var(--theme-text-muted)" id="rejectImageName"></p>
      </div>
      <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" data-close-reject aria-label="<%= t('ariaClose') %>">
        <%- icon('x', { class: 'h-4 w-4', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="px-5 py-3">
      <label class="al-form-label" for="rejectReason"><%= t('reason') %> <span class="font-normal" style="color:var(--theme-text-muted)">(<%= t('reasonHint') %>)</span></label>
      <textarea id="rejectReason" class="al-input w-full" rows="3" placeholder="<%= t('rejectReasonPlaceholder') %>"></textarea>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" class="al-btn-secondary al-btn-sm" data-close-reject><%= t('cancel') %></button>
      <button type="button" id="confirmReject" class="al-btn-danger al-btn-sm">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('reject') %>
      </button>
    </div>
  </div>
</div>

<div id="page-data" style="display:none"
  data-approve-confirm="<%= t('approveImageConfirm') %>"
  data-approved="<%= t('imageApproved') %>"
  data-rejected="<%= t('imageRejected') %>"
  data-error="<%= t('somethingWentWrong') %>"
></div>

<script nonce="<%- nonce %>">
(function() {
  var approvals = imageApprovals();
  if (approvals && typeof approvals.init === 'function') {
    document.addEventListener('DOMContentLoaded', function() { approvals.init(); });
  }
})();

function imageApprovals() {
  var pd = document.getElementById('page-data') ? document.getElementById('page-data').dataset : {};
  return {
    pendingRejectId: null,
    init: function() {
      var self = this;
      var rejectModal = document.getElementById('rejectModal');
      var openReject = function(id, name) {
        self.pendingRejectId = id;
        document.getElementById('rejectImageName').textContent = name;
        rejectModal.classList.remove('opacity-0', 'pointer-events-none');
      };
      var closeReject = function() {
        rejectModal.classList.add('opacity-0', 'pointer-events-none');
        self.pendingRejectId = null;
      };

      document.querySelectorAll('[data-close-reject]').forEach(function(btn) {
        btn.addEventListener('click', closeReject);
      });

      document.querySelectorAll('[data-approve-image]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          window.modal.confirm({
            title: pd.approveConfirm,
            body: pd.approveConfirm,
            danger: false,
            confirmLabel: <%- JSON.stringify(t('approve')) %>,
            onConfirm: async function() {
              var id = btn.dataset.approveImage;
              try {
                var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
                var response = await fetch('/api/v2/admin/images/' + id + '/approve', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken }
                });
                var data = await response.json();
                if (data.error) {
                  showToast(data.error, 'error');
                } else {
                  showToast(data.message || pd.approved, 'success');
                  window.location.reload();
                }
              } catch (error) {
                showToast(pd.error, 'error');
              }
            }
          });
        });
      });

      document.querySelectorAll('[data-reject-image]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          openReject(btn.dataset.rejectImage, btn.dataset.rejectName || btn.closest('.pending-card') ? btn.closest('.pending-card').querySelector('h3').textContent : '');
        });
      });

      document.getElementById('confirmReject').addEventListener('click', async function() {
        if (self.pendingRejectId == null) return;
        var id = self.pendingRejectId;
        var reason = document.getElementById('rejectReason').value;
        try {
          var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
          var response = await fetch('/api/v2/admin/images/' + id + '/reject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
            body: JSON.stringify({ reason: reason }),
          });
          var data = await response.json();
          closeReject();
          if (data.error) {
            showToast(data.error, 'error');
          } else {
            showToast(data.message || pd.rejected, 'success');
            window.location.reload();
          }
        } catch (error) {
          closeReject();
          showToast(pd.error, 'error');
        }
      });
    }
  };
}
</script>

<%- include('../../layouts/admin-footer') %>
