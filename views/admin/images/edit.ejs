<%- include('../../components/header', { title: 'Edit Image' }) %>

<% if (isMobileViewport) { %>
<main id="page-content" class="">
  <%- include('../../components/template') %>

  <div class="px-4 pt-5 pb-8">
    <div class="mb-5">
      <a href="/admin/images" class="inline-flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 mb-3 hover:text-neutral-700 dark:hover:text-neutral-200 transition">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to Images
      </a>
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h1 class="text-base font-medium text-neutral-800 dark:text-white truncate">Edit Image: <%= image.name %></h1>
          <p class="mt-0.5 text-xs text-neutral-500">Edit the image configuration or export it as JSON.</p>
        </div>
        <a href="/admin/images/export/<%= image.id %>"
          class="shrink-0 rounded-xl bg-neutral-100 dark:bg-neutral-800/80 border border-neutral-200 dark:border-white/5 px-3 py-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700/80 transition">
          Export JSON
        </a>
      </div>
    </div>

    <% if (req.query.success) { %>
      <div data-animate-card class="rounded-xl bg-green-500/10 border border-green-500/20 px-4 py-3 mb-5 flex items-center gap-3">
        <svg class="h-4 w-4 text-green-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <div>
          <p class="text-sm font-medium text-green-400">Image updated successfully</p>
          <p class="text-xs text-green-400/60 mt-0.5">Your changes have been saved.</p>
        </div>
      </div>
    <% } %>

    <div class="mb-4 flex gap-1 overflow-x-auto border-b border-neutral-200 dark:border-white/10">
      <button type="button" data-mobile-tab="general" class="mobile-tab px-3 py-2 text-sm font-medium border-b-2">General</button>
      <button type="button" data-mobile-tab="settings" class="mobile-tab px-3 py-2 text-sm font-medium border-b-2">Settings</button>
      <button type="button" data-mobile-tab="raw" class="mobile-tab px-3 py-2 text-sm font-medium border-b-2">Raw JSON</button>
    </div>

    <div class="space-y-4">
      <div id="mobileTabGeneral" class="rounded-xl bg-neutral-50 dark:bg-neutral-800/20 border border-neutral-200 dark:border-white/5 p-4">
        <h2 class="text-sm font-semibold text-neutral-800 dark:text-white mb-4">Basic Information</h2>
        <div class="space-y-3">
          <div class="flex flex-col gap-1">
            <label for="name" class="text-sm font-medium text-neutral-700 dark:text-neutral-400">Name</label>
            <input type="text" id="name" name="name" value="<%= image.name %>"
              class="w-full rounded-xl border border-neutral-800/10 dark:border-white/5 bg-neutral-400/10 dark:bg-neutral-600/20 px-4 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-white/30 focus:outline-none focus:ring-1 focus:ring-neutral-800/20 dark:focus:ring-white/10">
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="flex flex-col gap-1">
              <label for="author" class="text-sm font-medium text-neutral-700 dark:text-neutral-400">Author</label>
              <input type="text" id="author" name="author" value="<%= image.author %>"
                class="w-full rounded-xl border border-neutral-800/10 dark:border-white/5 bg-neutral-400/10 dark:bg-neutral-600/20 px-4 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-white/30 focus:outline-none focus:ring-1 focus:ring-neutral-800/20 dark:focus:ring-white/10">
            </div>
            <div class="flex flex-col gap-1">
              <label for="authorName" class="text-sm font-medium text-neutral-700 dark:text-neutral-400">Author Name</label>
              <input type="text" id="authorName" name="authorName" value="<%= image.authorName %>"
                class="w-full rounded-xl border border-neutral-800/10 dark:border-white/5 bg-neutral-400/10 dark:bg-neutral-600/20 px-4 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-white/30 focus:outline-none focus:ring-1 focus:ring-neutral-800/20 dark:focus:ring-white/10">
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <label for="startup" class="text-sm font-medium text-neutral-700 dark:text-neutral-400">Startup Command</label>
            <input type="text" id="startup" name="startup" value="<%= image.startup %>"
              class="w-full rounded-xl border border-neutral-800/10 dark:border-white/5 bg-neutral-400/10 dark:bg-neutral-600/20 px-4 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-white/30 focus:outline-none focus:ring-1 focus:ring-neutral-800/20 dark:focus:ring-white/10">
          </div>
          <div class="flex flex-col gap-1">
            <label for="description" class="text-sm font-medium text-neutral-700 dark:text-neutral-400">Description</label>
            <textarea id="description" name="description" rows="3"
              class="w-full rounded-xl border border-neutral-800/10 dark:border-white/5 bg-neutral-400/10 dark:bg-neutral-600/20 px-4 py-2.5 text-sm text-neutral-800 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-white/30 focus:outline-none focus:ring-1 focus:ring-neutral-800/20 dark:focus:ring-white/10 resize-none"><%= image.description %></textarea>
          </div>
        </div>
      </div>

      <div id="mobileTabSettings" class="hidden rounded-xl bg-neutral-50 dark:bg-neutral-800/20 border border-neutral-200 dark:border-white/5 overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3 border-b border-neutral-200 dark:border-white/5">
          <div>
            <h2 class="text-sm font-semibold text-neutral-800 dark:text-white">Required Ports</h2>
            <p class="text-xs text-neutral-500 mt-0.5">Users get these ports; admins can add more on servers.</p>
          </div>
          <button type="button" id="addPortRequirement"
            class="shrink-0 rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800 px-3 py-2 text-xs font-medium text-neutral-700 dark:text-neutral-300">
            Add
          </button>
        </div>
        <div class="p-4">
          <div id="portRequirementsList" class="space-y-3"></div>
          <button id="saveSettingsButton" type="button"
            class="mt-4 w-full rounded-xl bg-neutral-950 dark:bg-white text-white dark:text-neutral-900 px-4 py-3 text-sm font-medium hover:bg-neutral-800 dark:hover:bg-neutral-100 transition">
            Save Settings
          </button>
        </div>
      </div>

      <div id="mobileTabRaw" class="hidden rounded-xl bg-neutral-50 dark:bg-neutral-800/20 border border-neutral-200 dark:border-white/5 p-4">
        <h2 class="text-sm font-semibold text-neutral-800 dark:text-white mb-1">JSON Configuration</h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-3">Edit the JSON directly. Keep the format valid.</p>
        <div id="jsonEditor" class="w-full h-64 border border-neutral-200 dark:border-white/5 rounded-xl overflow-hidden"></div>
        <button id="saveButton" type="button"
          class="mt-4 w-full rounded-xl bg-neutral-950 dark:bg-white text-white dark:text-neutral-900 px-4 py-3 text-sm font-medium hover:bg-neutral-800 dark:hover:bg-neutral-100 transition">
          Save Changes
        </button>
      </div>
    </div>
  </div>
</main>

<%- include('../../components/toast') %>

<script nonce="<%- nonce %>" src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.36.1/min/vs/loader.min.js"></script>
<script nonce="<%- nonce %>">
  require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.36.1/min/vs' }});
  require(['vs/editor/editor.main'], function() {
    const tabPanels = {
      general: document.getElementById('mobileTabGeneral'),
      settings: document.getElementById('mobileTabSettings'),
      raw: document.getElementById('mobileTabRaw'),
    };

    function activateMobileTab(name) {
      Object.entries(tabPanels).forEach(([key, panel]) => {
        panel.classList.toggle('hidden', key !== name);
      });
      document.querySelectorAll('.mobile-tab').forEach(button => {
        const active = button.dataset.mobileTab === name;
        button.classList.toggle('border-neutral-900', active);
        button.classList.toggle('dark:border-white', active);
        button.classList.toggle('text-neutral-900', active);
        button.classList.toggle('dark:text-white', active);
        button.classList.toggle('border-transparent', !active);
        button.classList.toggle('text-neutral-500', !active);
      });
      if (name === 'raw') editor.layout();
    }

    const editor = monaco.editor.create(document.getElementById('jsonEditor'), {
      value: `<%- imageJson.replace(/\n/g, '\\n').replace(/"/g, '\\"') %>`,
      language: 'json',
      theme: document.documentElement.classList.contains('dark') ? 'vs-dark' : 'vs',
      automaticLayout: true,
      minimap: { enabled: false },
      scrollBeyondLastLine: false,
      fontSize: 13,
      tabSize: 2,
      lineNumbers: 'off',
      folding: false,
    });
    activateMobileTab('general');

    function getPayload() { return JSON.parse(editor.getValue()); }
    function setPayload(payload) { editor.setValue(JSON.stringify(payload, null, 2)); }
    function escapeHtml(value) { return String(value).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

    function getPortRequirements() {
      try { const payload = getPayload(); return Array.isArray(payload.portRequirements) ? payload.portRequirements : []; } catch { return []; }
    }

    function renderPortRequirements() {
      const list = document.getElementById('portRequirementsList');
      const ports = getPortRequirements();
      list.innerHTML = '';
      if (!ports.length) {
        list.innerHTML = '<p class="text-xs text-neutral-400">No required ports. Servers can be created without port bindings unless an admin adds ports.</p>';
        return;
      }
      ports.forEach((port, index) => {
        const row = document.createElement('div');
        row.className = 'rounded-xl border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800/50 p-3 space-y-2';
        row.innerHTML = `
          <label class="block text-xs text-neutral-500">Port name<input data-port-req="${index}" data-field="name" value="${escapeHtml(port.name || '')}" class="mt-1 w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-neutral-50 dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white"></label>
          <label class="block text-xs text-neutral-500">Internal port<input data-port-req="${index}" data-field="internalPort" type="number" min="1" max="65535" value="${escapeHtml(port.internalPort || '')}" class="mt-1 w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-neutral-50 dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white"></label>
          <button type="button" data-port-req-remove="${index}" class="w-full rounded-xl border border-red-200 dark:border-red-900/30 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-red-500">Remove</button>`;
        list.appendChild(row);
      });
      list.querySelectorAll('[data-port-req-remove]').forEach(button => {
        button.addEventListener('click', () => {
          const payload = getPayload();
          payload.portRequirements = getPortRequirements();
          payload.portRequirements.splice(Number(button.dataset.portReqRemove), 1);
          setPayload(payload);
          renderPortRequirements();
        });
      });
    }

    document.querySelectorAll('.mobile-tab').forEach(button => {
      button.addEventListener('click', () => {
        if (button.dataset.mobileTab === 'settings') renderPortRequirements();
        activateMobileTab(button.dataset.mobileTab);
      });
    });

    document.getElementById('addPortRequirement').addEventListener('click', () => {
      const payload = getPayload();
      const ports = getPortRequirements();
      ports.push({ name: `Port ${ports.length + 1}`, internalPort: 25565 });
      payload.portRequirements = ports;
      setPayload(payload);
      renderPortRequirements();
    });

    document.getElementById('saveSettingsButton').addEventListener('click', function() {
      try {
        const payload = getPayload();
        const ports = getPortRequirements();
        document.querySelectorAll('[data-port-req]').forEach(input => {
          const index = Number(input.dataset.portReq);
          const field = input.dataset.field;
          ports[index][field] = field === 'internalPort' ? Number(input.value) : input.value;
        });
        payload.portRequirements = ports.filter(port => port.name && port.internalPort);
        fetch('/admin/images/edit/<%= image.id %>', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(response => {
          if (response.ok) { setPayload(payload); renderPortRequirements(); showToast('Settings saved. Looking good.', 'success'); }
          else { return response.json().then(data => { throw new Error(data.error || 'Failed to update image'); }); }
        })
        .catch(error => { showToast(error.message || 'Failed to update image', 'error'); });
      } catch (error) { showToast('Invalid JSON: ' + error.message, 'error'); }
    });

    document.getElementById('saveButton').addEventListener('click', function() {
      try {
        const jsonValue = editor.getValue();
        const parsed = JSON.parse(jsonValue);
        document.getElementById('name').value = parsed.name || '';
        document.getElementById('author').value = parsed.author || '';
        document.getElementById('authorName').value = parsed.authorName || '';
        document.getElementById('startup').value = parsed.startup || '';
        document.getElementById('description').value = parsed.description || '';
        fetch('/admin/images/edit/<%= image.id %>', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: jsonValue
        })
        .then(response => {
          if (response.ok) { window.location.href = '/admin/images/edit/<%= image.id %>?success=true'; }
          else { return response.json().then(data => { throw new Error(data.error || 'Failed to update image'); }); }
        })
        .catch(error => { showToast(error.message || 'Failed to update image', 'error'); });
      } catch (error) { showToast('Invalid JSON: ' + error.message, 'error'); }
    });

    const formFields = ['name', 'author', 'authorName', 'startup', 'description'];
    formFields.forEach(field => {
      document.getElementById(field).addEventListener('change', function() {
        try { const parsed = JSON.parse(editor.getValue()); parsed[field] = this.value; editor.setValue(JSON.stringify(parsed, null, 2)); }
        catch (error) { showToast('Invalid JSON: ' + error.message, 'error'); }
      });
    });
  });
</script>

<% } else { %>
<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="w-60 shrink-0">
      <%- include('../../components/template') %>
    </div>
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">

      <div class="px-8 pt-5 flex items-start justify-between">
        <div>
          <h1 class="text-base font-medium text-neutral-800 dark:text-white"><%= image.name || 'Edit Image' %></h1>
          <p class="mt-0.5 text-sm text-neutral-500">Edit egg configuration, variables, Docker images, and install scripts.</p>
        </div>
        <div class="flex gap-2 shrink-0 ml-4">
          <a href="/admin/images/export/<%= image.id %>"
            class="px-3 py-2 text-sm font-medium rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition">
            Export
          </a>
          <a href="/admin/images"
            class="px-3 py-2 text-sm font-medium rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition">
            Back
          </a>
        </div>
      </div>

      <% if (req.query.success) { %>
        <div data-animate-card class="mx-8 mt-5 px-4 py-3 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800/30 text-sm text-green-700 dark:text-green-400">
          Changes saved successfully.
        </div>
      <% } %>

      <div class="px-8 mt-6">
        <div class="flex gap-0.5 mb-6 border-b border-neutral-200 dark:border-neutral-700/40">
          <button type="button" data-tab="general" class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors -mb-px border-b-2">General</button>
          <button type="button" data-tab="docker" class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors -mb-px border-b-2">Docker Images</button>
          <button type="button" data-tab="variables" class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors -mb-px border-b-2">Variables</button>
          <button type="button" data-tab="install" class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors -mb-px border-b-2">Install Script</button>
          <button type="button" data-tab="settings" class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors -mb-px border-b-2">Settings</button>
          <button type="button" data-tab="raw" class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors -mb-px border-b-2">Raw JSON</button>
        </div>

        <!-- General tab -->
        <div data-tab-form="general" class="tab-form space-y-5">
          <div data-animate-card class="flex flex-col bg-neutral-50 dark:bg-white/[0.03] rounded-xl border border-neutral-200 dark:border-white/5">
            <h2 class="text-[13px] font-medium text-neutral-800 dark:text-white px-5 py-3.5 bg-neutral-100 dark:bg-white/5 rounded-t-xl border-b border-neutral-200 dark:border-white/5">Basics</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 px-5 py-5">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Name</label>
                <input type="text" id="field-name" value="<%= image.name || '' %>"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Author</label>
                <input type="text" id="field-author" value="<%= image.author || '' %>"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition">
              </div>
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Description</label>
                <textarea id="field-description" rows="2"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition resize-none"><%= image.description || '' %></textarea>
              </div>
            </div>
          </div>
          <div data-animate-card class="flex flex-col bg-neutral-50 dark:bg-white/[0.03] rounded-xl border border-neutral-200 dark:border-white/5">
            <h2 class="text-[13px] font-medium text-neutral-800 dark:text-white px-5 py-3.5 bg-neutral-100 dark:bg-white/5 rounded-t-xl border-b border-neutral-200 dark:border-white/5">Process</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 px-5 py-5">
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Startup Command</label>
                <input type="text" id="field-startup" value="<%= image.startup || '' %>" placeholder="e.g. java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white font-mono focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition">
                <p class="mt-1.5 text-xs text-neutral-400">Use <code class="font-mono bg-neutral-100 dark:bg-neutral-800 px-1 rounded">{{VARIABLE_NAME}}</code> to reference egg variables.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Stop Command</label>
                <input type="text" id="field-stop" value="<%= image.stop || 'stop' %>" placeholder="stop"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white font-mono focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition">
                <p class="mt-1.5 text-xs text-neutral-400">Command sent to the container to stop it gracefully.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Startup Done Signal</label>
                <input type="text" id="field-startup-done" value="<%= image.startup_done || '' %>" placeholder="e.g. For help, type"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white font-mono focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition">
                <p class="mt-1.5 text-xs text-neutral-400">String in the server output that means the server finished starting.</p>
              </div>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="button" id="save-general"
              class="px-5 py-2.5 text-sm font-medium rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-100 transition">
              Save Changes
            </button>
          </div>
        </div>

        <!-- Docker Images tab -->
        <div data-tab-form="docker" class="tab-form space-y-5 hidden">
          <div data-animate-card class="flex flex-col bg-neutral-50 dark:bg-white/[0.03] rounded-xl border border-neutral-200 dark:border-white/5">
            <div class="flex items-center justify-between px-5 py-3.5 bg-neutral-100 dark:bg-white/5 rounded-t-xl border-b border-neutral-200 dark:border-white/5">
              <h2 class="text-[13px] font-medium text-neutral-800 dark:text-white">Docker Images</h2>
              <button type="button" id="add-docker-image"
                class="px-3 py-1.5 text-xs font-medium rounded-lg border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition">
                Add Image
              </button>
            </div>
            <div class="px-5 py-4">
              <p class="text-xs text-neutral-500 mb-4">Each entry maps a display label to a Docker image reference. The label is what users see in dropdowns.</p>
              <div id="docker-images-list" class="space-y-2"></div>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="button" id="save-docker"
              class="px-5 py-2.5 text-sm font-medium rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-100 transition">
              Save Changes
            </button>
          </div>
        </div>

        <!-- Variables tab -->
        <div data-tab-form="variables" class="tab-form space-y-5 hidden">
          <div data-animate-card class="flex flex-col bg-neutral-50 dark:bg-white/[0.03] rounded-xl border border-neutral-200 dark:border-white/5">
            <div class="flex items-center justify-between px-5 py-3.5 bg-neutral-100 dark:bg-white/5 rounded-t-xl border-b border-neutral-200 dark:border-white/5">
              <h2 class="text-[13px] font-medium text-neutral-800 dark:text-white">Egg Variables</h2>
              <button type="button" id="add-variable"
                class="px-3 py-1.5 text-xs font-medium rounded-lg border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition">
                Add Variable
              </button>
            </div>
            <div class="px-5 py-4">
              <p class="text-xs text-neutral-500 mb-4">Variables are injected as environment variables into the container. <code class="font-mono bg-neutral-100 dark:bg-neutral-800 px-1 rounded">env_variable</code> is the name used in the startup command and Docker environment.</p>
              <div id="variables-list" class="space-y-3"></div>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="button" id="save-variables"
              class="px-5 py-2.5 text-sm font-medium rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-100 transition">
              Save Changes
            </button>
          </div>
        </div>

        <!-- Install Script tab -->
        <div data-tab-form="install" class="tab-form space-y-5 hidden">
          <div data-animate-card class="flex flex-col bg-neutral-50 dark:bg-white/[0.03] rounded-xl border border-neutral-200 dark:border-white/5">
            <h2 class="text-[13px] font-medium text-neutral-800 dark:text-white px-5 py-3.5 bg-neutral-100 dark:bg-white/5 rounded-t-xl border-b border-neutral-200 dark:border-white/5">Installation Script</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 px-5 py-5">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Container Image</label>
                <input type="text" id="field-install-container" placeholder="e.g. eclipse-temurin:21-jdk-jammy"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white font-mono focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition">
                <p class="mt-1.5 text-xs text-neutral-400">Docker image the install script runs inside.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Entrypoint</label>
                <input type="text" id="field-install-entrypoint" placeholder="bash"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white font-mono focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition">
                <p class="mt-1.5 text-xs text-neutral-400">Shell that executes the script (usually <code class="font-mono">bash</code>).</p>
              </div>
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">Script</label>
                <textarea id="field-install-script" rows="16" placeholder="#!/bin/bash&#10;# Install script runs inside the container&#10;apt update && apt install -y curl"
                  class="w-full rounded-xl border border-neutral-200 dark:border-white/5 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-800 dark:text-white font-mono focus:outline-none focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-600 transition resize-y"></textarea>
                <p class="mt-1.5 text-xs text-neutral-400">Files are placed in <code class="font-mono bg-neutral-100 dark:bg-neutral-800 px-1 rounded">/mnt/server</code> inside the install container. The script runs as root.</p>
              </div>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="button" id="save-install"
              class="px-5 py-2.5 text-sm font-medium rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-100 transition">
              Save Changes
            </button>
          </div>
        </div>

        <!-- Settings tab -->
        <div data-tab-form="settings" class="tab-form space-y-5 hidden">
          <div data-animate-card class="flex flex-col bg-neutral-50 dark:bg-white/[0.03] rounded-xl border border-neutral-200 dark:border-white/5">
            <div class="flex items-center justify-between px-5 py-3.5 bg-neutral-100 dark:bg-white/5 rounded-t-xl border-b border-neutral-200 dark:border-white/5">
              <h2 class="text-[13px] font-medium text-neutral-800 dark:text-white">Required Ports</h2>
              <button type="button" id="add-port-requirement"
                class="px-3 py-1.5 text-xs font-medium rounded-lg border border-neutral-200 dark:border-white/10 bg-white dark:bg-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition">
                Add Port
              </button>
            </div>
            <div class="px-5 py-4">
              <p class="text-xs text-neutral-500 mb-4">Each entry is shown when creating servers. Users get exactly these required ports; admins can add more.</p>
              <div id="port-requirements-list" class="space-y-2"></div>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="button" id="save-settings"
              class="px-5 py-2.5 text-sm font-medium rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-100 transition">
              Save Changes
            </button>
          </div>
        </div>

        <!-- Raw JSON tab -->
        <div data-tab-form="raw" class="tab-form space-y-5 hidden">
          <div data-animate-card class="flex flex-col bg-neutral-50 dark:bg-white/[0.03] rounded-xl border border-neutral-200 dark:border-white/5">
            <h2 class="text-[13px] font-medium text-neutral-800 dark:text-white px-5 py-3.5 bg-neutral-100 dark:bg-white/5 rounded-t-xl border-b border-neutral-200 dark:border-white/5">Raw JSON</h2>
            <div class="px-5 py-5">
              <p class="text-xs text-neutral-500 mb-4">Edit the complete egg JSON directly. Must be valid JSON — the editor will warn on errors. Saving here overwrites all tab values.</p>
              <div id="json-editor" class="w-full h-[480px] rounded-xl border border-neutral-200 dark:border-neutral-700 overflow-hidden"></div>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="button" id="save-raw"
              class="px-5 py-2.5 text-sm font-medium rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-100 transition">
              Save Raw JSON
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../../components/toast') %>

<script nonce="<%- nonce %>" src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.36.1/min/vs/loader.min.js"></script>

<div id="page-data" style="display:none"
  data-image="<%- JSON.stringify({
    id: image.id,
    name: image.name || '',
    description: image.description || '',
    author: image.author || '',
    startup: image.startup || '',
    stop: image.stop || 'stop',
    startup_done: image.startup_done || '',
    docker_images: image.dockerImages || {},
    variables: image.variables || [],
    scripts: image.scripts || {},
    info: image.info || {},
    meta: image.meta || {},
    portRequirements: image.portRequirements || []
  }) %>"
></div>

<script nonce="<%- nonce %>" src="/js/admin/image-edit.js"></script>
<% } %>

<%- include('../../components/footer') %>
