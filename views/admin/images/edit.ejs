<%- include('../../layouts/admin', { title: t('adminEditImageTitle') }) %>

<div class="px-4 sm:px-6 lg:px-8 pt-4">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbImages'), url: '/admin/images' },
    { label: image.name || t('adminEditImageTitle') }
  ] }) %>

  <div class="flex items-start justify-between gap-4 mt-4">
    <div>
      <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong)"><%= image.name || t('adminEditImageTitle') %></h1>
      <p class="text-sm mt-1" style="color:var(--theme-text-muted)"><%= t('adminEditImageText') %></p>
    </div>
    <div class="flex gap-2 shrink-0 items-center">
      <button type="button" id="tab-save-btn" class="al-btn-primary">
        <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('save') %>
      </button>
      <button type="button" id="tab-reset-btn" class="al-btn-secondary">
        <%- icon('rotate-ccw', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('reset') %>
      </button>
      <a href="/admin/images/export/<%= image.id %>" class="al-btn-secondary"><%= t('export') %></a>
      <a href="/admin/images" class="al-btn-secondary"><%= t('back') %></a>
    </div>
  </div>

  <% if (req.query && req.query.success) { %>
    <div class="mt-4 px-4 py-3 rounded-xl text-sm" style="background:var(--theme-success-bg);border:1px solid color-mix(in srgb, var(--theme-success) 25%, transparent);color:var(--theme-success)">
      <%= t('changesSaved') %>
    </div>
  <% } %>

  <div class="mt-5" data-al-tabs data-tabs-default="general" data-tabs-hash>
    <div role="tablist" class="flex gap-1 mb-6">
      <button type="button" role="tab" aria-selected="true" aria-controls="panel-general" id="tab-general" data-tab="general" tabindex="0" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2">
        <%- icon('layout-grid', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('general') %>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-docker" id="tab-docker" data-tab="docker" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2">
        <%- icon('container', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('dockerImages') %>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-variables" id="tab-variables" data-tab="variables" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2">
        <%- icon('variable', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('variables') %>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-install" id="tab-install" data-tab="install" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2">
        <%- icon('terminal', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('installScript') %>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-settings" id="tab-settings" data-tab="settings" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2">
        <%- icon('settings', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('settings') %>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-raw" id="tab-raw" data-tab="raw" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2">
        <%- icon('file-json', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('rawJson') %>
      </button>
    </div>

    <!-- General tab -->
    <div id="panel-general" role="tabpanel" aria-labelledby="tab-general" data-tab-panel="general" class="tab-panel space-y-5">
      <div class="al-card">
        <div class="al-card-header">
          <h2 class="al-card-title"><%= t('basics') %></h2>
        </div>
        <div class="al-card-body">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="al-form-field">
              <label for="field-name" class="al-form-label"><%= t('name') %></label>
              <input type="text" id="field-name" value="<%= image.name || '' %>" class="al-form-input">
            </div>
            <div class="al-form-field">
              <label for="field-author" class="al-form-label"><%= t('author') %></label>
              <input type="text" id="field-author" value="<%= image.author || '' %>" class="al-form-input">
            </div>
            <div class="sm:col-span-2 al-form-field">
              <label for="field-description" class="al-form-label"><%= t('description') %></label>
              <textarea id="field-description" rows="2" class="al-form-textarea"><%= image.description || '' %></textarea>
            </div>
          </div>
        </div>
      </div>

      <div class="al-card">
        <div class="al-card-header">
          <h2 class="al-card-title"><%= t('process') %></h2>
        </div>
        <div class="al-card-body">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2 al-form-field">
              <label for="field-startup" class="al-form-label"><%= t('startupCommand') %></label>
              <input type="text" id="field-startup" value="<%= image.startup || '' %>" placeholder="e.g. java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}" class="al-form-input font-mono">
              <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)">Use <code class="font-mono px-1 rounded" style="background:var(--theme-bg-secondary)">{{VARIABLE_NAME}}</code> to reference egg variables.</p>
            </div>
            <div class="al-form-field">
              <label for="field-stop" class="al-form-label"><%= t('stopCommand') %></label>
              <input type="text" id="field-stop" value="<%= image.stop || 'stop' %>" placeholder="stop" class="al-form-input font-mono">
              <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)"><%= t('stopCommandHint') %></p>
            </div>
            <div class="al-form-field">
              <label for="field-startup-done" class="al-form-label"><%= t('startupDoneSignal') %></label>
              <input type="text" id="field-startup-done" value="<%= image.startup_done || '' %>" placeholder="e.g. For help, type" class="al-form-input font-mono">
              <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)"><%= t('startupDoneSignalHint') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Docker Images tab -->
    <div id="panel-docker" role="tabpanel" aria-labelledby="tab-docker" data-tab-panel="docker" class="tab-panel space-y-5" hidden>
      <div class="al-card">
        <div class="al-card-header flex items-center justify-between">
          <h2 class="al-card-title"><%= t('dockerImages') %></h2>
          <button type="button" id="add-docker-image" class="al-btn-secondary px-3 py-1.5 text-xs font-medium">
            <%- icon('plus', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('addImage') %>
          </button>
        </div>
        <div class="al-card-body">
          <p class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= t('dockerImagesDesc') %></p>
          <div id="docker-images-list" class="space-y-2"></div>
        </div>
      </div>
    </div>

    <!-- Variables tab -->
    <div id="panel-variables" role="tabpanel" aria-labelledby="tab-variables" data-tab-panel="variables" class="tab-panel space-y-5" hidden>
      <div class="al-card">
        <div class="al-card-header flex items-center justify-between">
          <h2 class="al-card-title"><%= t('eggVariables') %></h2>
          <button type="button" id="add-variable" class="al-btn-secondary px-3 py-1.5 text-xs font-medium">
            <%- icon('plus', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('addVariable') %>
          </button>
        </div>
        <div class="al-card-body">
          <p class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= t('variablesDesc') %></p>
          <div id="variables-list" class="space-y-3"></div>
        </div>
      </div>
    </div>

    <!-- Install Script tab -->
    <div id="panel-install" role="tabpanel" aria-labelledby="tab-install" data-tab-panel="install" class="tab-panel space-y-5" hidden>
      <div class="al-card">
        <div class="al-card-header">
          <h2 class="al-card-title"><%= t('installationScript') %></h2>
        </div>
        <div class="al-card-body">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="al-form-field">
              <label for="field-install-container" class="al-form-label"><%= t('containerImage') %></label>
              <input type="text" id="field-install-container" placeholder="e.g. eclipse-temurin:21-jdk-jammy" class="al-form-input font-mono">
              <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)"><%= t('containerImageHint') %></p>
            </div>
            <div class="al-form-field">
              <label for="field-install-entrypoint" class="al-form-label"><%= t('entrypoint') %></label>
              <input type="text" id="field-install-entrypoint" placeholder="bash" class="al-form-input font-mono">
              <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)"><%= t('entrypointHint') %></p>
            </div>
            <div class="sm:col-span-2 al-form-field">
              <label for="field-install-script" class="al-form-label"><%= t('script') %></label>
              <textarea id="field-install-script" rows="16" placeholder="#!/bin/bash&#10;# Install script runs inside the container&#10;apt update && apt install -y curl" class="al-form-input font-mono resize-y"></textarea>
              <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)"><%= t('scriptHint') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Settings tab -->
    <div id="panel-settings" role="tabpanel" aria-labelledby="tab-settings" data-tab-panel="settings" class="tab-panel space-y-5" hidden>
      <div class="al-card">
        <div class="al-card-header flex items-center justify-between">
          <h2 class="al-card-title"><%= t('requiredPorts') %></h2>
          <button type="button" id="add-port-requirement" class="al-btn-secondary px-3 py-1.5 text-xs font-medium">
            <%- icon('plus', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('addPort') %>
          </button>
        </div>
        <div class="al-card-body">
          <p class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= t('requiredPortsDesc') %></p>
          <div id="port-requirements-list" class="space-y-2"></div>
        </div>
      </div>
    </div>

    <!-- Raw JSON tab -->
    <div id="panel-raw" role="tabpanel" aria-labelledby="tab-raw" data-tab-panel="raw" class="tab-panel space-y-5" hidden>
      <div class="al-card">
        <div class="al-card-header">
          <h2 class="al-card-title"><%= t('rawJson') %></h2>
        </div>
        <div class="al-card-body">
          <p class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= t('rawJsonDesc') %></p>
          <div id="json-editor" class="w-full h-[480px] rounded-xl border overflow-hidden" style="border-color:var(--theme-border)"></div>
        </div>
      </div>
    </div>

    <script nonce="<%- nonce %>">
    (function(){
      var saveBtn = document.getElementById('tab-save-btn');
      var resetBtn = document.getElementById('tab-reset-btn');
      function rebind(id) {
        if (window.tabHandlers && saveBtn) {
          saveBtn.onclick = window.tabHandlers[id] || null;
          saveBtn.textContent = (window.tabLabels && window.tabLabels[id]) || 'Save';
        }
        if (window.tabResetHandlers && resetBtn) {
          resetBtn.onclick = window.tabResetHandlers[id] || null;
        }
      }
      window._rebindTabHandlers = function() {
        var active = document.querySelector('.tab-btn[aria-selected="true"]');
        if (active) rebind(active.dataset.tab);
      };
      document.addEventListener('al:tabs-change', function(e) {
        var name = e.detail && e.detail.name;
        if (name) rebind(name);
      });
      window._rebindTabHandlers();
    })();
    </script>
  </div>
</div>

<script nonce="<%- nonce %>" src="<%= assetUrl('/monaco/vs/loader.js') %>"></script>

<script id="page-data" type="application/json" nonce="<%- nonce %>">
<%- JSON.stringify({
  id: image.id,
  name: image.name || '',
  description: image.description || '',
  author: image.author || '',
  startup: image.startup || '',
  stop: image.stop || 'stop',
  startup_done: image.startup_done || '',
  docker_images: image.dockerImages || {},
  variables: image.variables || [],
  scripts: image.scripts || {},
  info: image.info || {},
  meta: image.meta || {},
  portRequirements: image.portRequirements || []
}) %>
</script>

<script nonce="<%- nonce %>">
(function() {
  var editor = imageEditor();
  if (editor && typeof editor.init === 'function') {
    document.addEventListener('DOMContentLoaded', function() { editor.init(); });
  }
})();

function imageEditor() {
  var MONACO_FONT_SIZE = 13;
  var MONACO_TAB_SIZE = 2;
  var DEFAULT_PORT = 25565;
  var originalData = null;
  var monacoEditor = null;

  var pageEl = document.getElementById('page-data');
  var imageData = JSON.parse(pageEl.textContent.trim());
  var imageId = imageData.id;
  originalData = JSON.parse(JSON.stringify(imageData));

  var state = {
    name: imageData.name,
    description: imageData.description,
    author: imageData.author,
    startup: imageData.startup,
    stop: imageData.stop,
    startup_done: imageData.startup_done,
    docker_images: imageData.docker_images,
    variables: imageData.variables,
    scripts: imageData.scripts,
    info: imageData.info,
    meta: imageData.meta,
    portRequirements: imageData.portRequirements,
  };

  function escHtml(str) { return window.escHtml ? window.escHtml(str) : String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function renderDockerImages() {
    var list = document.getElementById('docker-images-list');
    list.innerHTML = '';
    var entries = Object.entries(state.docker_images);
    if (entries.length === 0) {
      list.innerHTML = '<p class="text-xs" style="color:var(--theme-text-muted)">No Docker images configured. Click Add Image to add one.</p>';
      return;
    }
    entries.forEach(function(pair, idx) {
      var label = pair[0], image = pair[1];
      var row = document.createElement('div');
      row.className = 'flex gap-2 items-center';
      row.innerHTML =
        '<input data-docker-label="' + idx + '" type="text" value="' + escHtml(label) + '" placeholder="Label (e.g. java 21)"' +
        ' class="w-40 shrink-0 al-form-input font-mono">' +
        '<input data-docker-image="' + idx + '" type="text" value="' + escHtml(image) + '" placeholder="Image ref (e.g. ghcr.io/ptero-eggs/yolks:java_21)"' +
        ' class="flex-1 al-form-input font-mono">' +
        '<button data-docker-remove="' + idx + '" type="button"' +
        ' class="al-btn-ghost px-3 py-2 text-xs text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition shrink-0">' +
        'Remove</button>';
      list.appendChild(row);
    });
    list.querySelectorAll('[data-docker-remove]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = parseInt(btn.dataset.dockerRemove);
        var keys = Object.keys(state.docker_images);
        delete state.docker_images[keys[idx]];
        renderDockerImages();
      });
    });
  }

  function renderVariables() {
    var list = document.getElementById('variables-list');
    list.innerHTML = '';
    if (!state.variables.length) {
      list.innerHTML = '<p class="text-xs" style="color:var(--theme-text-muted)">No variables defined. Click Add Variable to add one.</p>';
      return;
    }
    state.variables.forEach(function(v, idx) {
      var card = document.createElement('div');
      card.className = 'al-card';
      card.innerHTML =
        '<div class="al-card-body">' +
        '<div class="flex items-center justify-between mb-3">' +
          '<span class="text-xs font-medium" style="color:var(--theme-text-muted)">#' + (idx + 1) + '</span>' +
          '<button data-var-remove="' + idx + '" type="button" class="text-xs text-red-500 hover:text-red-400 transition">Remove</button>' +
        '</div>' +
        '<div class="grid grid-cols-2 gap-3">' +
          '<div class="al-form-field"><label class="al-form-label">Name</label>' +
            '<input data-var-field="' + idx + '" data-field="name" type="text" value="' + escHtml(v.name || '') + '" class="al-form-input"></div>' +
          '<div class="al-form-field"><label class="al-form-label">Env Variable</label>' +
            '<input data-var-field="' + idx + '" data-field="env_variable" type="text" value="' + escHtml(v.env_variable || '') + '" placeholder="SERVER_JARFILE" class="al-form-input font-mono"></div>' +
          '<div class="al-form-field"><label class="al-form-label">Default Value</label>' +
            '<input data-var-field="' + idx + '" data-field="default_value" type="text" value="' + escHtml(v.default_value || '') + '" class="al-form-input font-mono"></div>' +
          '<div class="al-form-field"><label class="al-form-label">Field Type</label>' +
            '<select data-var-field="' + idx + '" data-field="field_type" class="al-form-select">' +
              '<option value="text"' + ((v.field_type || 'text') === 'text' ? ' selected' : '') + '>text</option>' +
              '<option value="number"' + (v.field_type === 'number' ? ' selected' : '') + '>number</option>' +
            '</select></div>' +
          '<div class="col-span-2 al-form-field"><label class="al-form-label">Description</label>' +
            '<input data-var-field="' + idx + '" data-field="description" type="text" value="' + escHtml(v.description || '') + '" class="al-form-input"></div>' +
          '<div class="col-span-2 al-form-field"><label class="al-form-label">Validation Rules</label>' +
            '<input data-var-field="' + idx + '" data-field="rules" type="text" value="' + escHtml(v.rules || '') + '" placeholder="required|string|between:3,15" class="al-form-input font-mono"></div>' +
          '<div class="col-span-2 flex items-center gap-4">' +
            '<label class="flex items-center gap-2 text-xs cursor-pointer" style="color:var(--theme-text-muted)">' +
              '<input data-var-field="' + idx + '" data-field="user_viewable" type="checkbox"' + (v.user_viewable !== false ? ' checked' : '') +
              ' class="rounded"> User viewable</label>' +
            '<label class="flex items-center gap-2 text-xs cursor-pointer" style="color:var(--theme-text-muted)">' +
              '<input data-var-field="' + idx + '" data-field="user_editable" type="checkbox"' + (v.user_editable !== false ? ' checked' : '') +
              ' class="rounded"> User editable</label>' +
          '</div>' +
        '</div>' +
        '</div>';
      list.appendChild(card);
    });
    list.querySelectorAll('[data-var-remove]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.variables.splice(parseInt(btn.dataset.varRemove), 1);
        renderVariables();
      });
    });
  }

  function renderPortRequirements() {
    var list = document.getElementById('port-requirements-list');
    list.innerHTML = '';
    if (!state.portRequirements.length) {
      list.innerHTML = '<p class="text-xs" style="color:var(--theme-text-muted)">No required ports.</p>';
      return;
    }
    state.portRequirements.forEach(function(port, idx) {
      var row = document.createElement('div');
      row.className = 'grid grid-cols-1 sm:grid-cols-[1fr_140px_auto] gap-2 items-end';
      row.innerHTML =
        '<label class="text-xs" style="color:var(--theme-text-muted)">Port name<input data-port-req="' + idx + '" data-field="name" value="' + escHtml(port.name || '') + '"' +
        ' class="mt-1 w-full al-form-input"></label>' +
        '<label class="text-xs" style="color:var(--theme-text-muted)">Internal port<input data-port-req="' + idx + '" data-field="internalPort" type="number" min="1" max="65535" value="' + escHtml(port.internalPort || '') + '"' +
        ' class="mt-1 w-full al-form-input"></label>' +
        '<button type="button" data-port-req-remove="' + idx + '" class="al-btn-ghost px-3 py-2 text-xs text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition">Remove</button>';
      list.appendChild(row);
    });
    list.querySelectorAll('[data-port-req-remove]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.portRequirements.splice(Number(btn.dataset.portReqRemove), 1);
        renderPortRequirements();
      });
    });
  }

  function renderRawEditor() {
    if (monacoEditor) {
      monacoEditor.setValue(buildExportJson());
      return;
    }
    try {
      require.config({ paths: { vs: '/monaco/vs' } });
      require(['vs/editor/editor.main'], function() {
        monacoEditor = monaco.editor.create(document.getElementById('json-editor'), {
          value: buildExportJson(),
          language: 'json',
          theme: document.documentElement.classList.contains('dark') ? 'vs-dark' : 'vs',
          automaticLayout: true,
          minimap: { enabled: false },
          scrollBeyondLastLine: false,
          fontSize: MONACO_FONT_SIZE,
          tabSize: MONACO_TAB_SIZE,
        });
      });
    } catch (e) {
      console.error('Monaco init error:', e);
    }
  }

  function buildExportJson() {
    return JSON.stringify({
      meta: { version: 'PTDL_v2', ...state.meta },
      name: state.name, description: state.description, author: state.author, startup: state.startup,
      config: { stop: state.stop, startup: { done: state.startup_done }, files: {}, logs: {} },
      docker_images: state.docker_images, variables: state.variables,
      scripts: { installation: state.scripts.installation || null }, portRequirements: state.portRequirements,
    }, null, 2);
  }

  async function savePayload(payload) {
    try {
      var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
      var r = await fetch('/api/v2/admin/images/' + imageId, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify(payload),
      });
      var data = await r.json();
      if (data.success) {
        showToast('Saved.', 'success');
        window.location.reload();
      } else {
        showToast(data.error || 'Failed to save.', 'error');
      }
    } catch (e) {
      showToast('Network error.', 'error');
    }
  }

  async function saveState() {
    var payload = {
      meta: { version: 'PTDL_v2', ...state.meta },
      name: state.name, description: state.description, author: state.author, startup: state.startup,
      config: { stop: state.stop, startup: { done: state.startup_done }, files: {}, logs: {} },
      docker_images: state.docker_images, variables: state.variables,
      scripts: { installation: state.scripts.installation || null }, info: state.info, portRequirements: state.portRequirements,
    };
    await savePayload(payload);
  }

  return {
    init: function() {
      document.getElementById('field-name').value = state.name;
      document.getElementById('field-description').value = state.description;
      document.getElementById('field-author').value = state.author;
      document.getElementById('field-startup').value = state.startup;
      document.getElementById('field-stop').value = state.stop;
      document.getElementById('field-startup-done').value = state.startup_done;
      var installScript = state.scripts.installation || {};
      document.getElementById('field-install-container').value = installScript.container || '';
      document.getElementById('field-install-entrypoint').value = installScript.entrypoint || 'bash';
      document.getElementById('field-install-script').value = installScript.script || '';
      renderDockerImages();
      document.getElementById('add-docker-image').addEventListener('click', function() {
        state.docker_images[''] = '';
        renderDockerImages();
      });
      renderVariables();
      document.getElementById('add-variable').addEventListener('click', function() {
        state.variables.push({ name: '', description: '', env_variable: '', default_value: '', user_viewable: true, user_editable: true, rules: '', field_type: 'text' });
        renderVariables();
      });
      renderPortRequirements();
      document.getElementById('add-port-requirement').addEventListener('click', function() {
        state.portRequirements.push({ name: 'Port ' + (state.portRequirements.length + 1), internalPort: DEFAULT_PORT });
        renderPortRequirements();
      });
      document.getElementById('tab-raw').addEventListener('click', renderRawEditor);

      window.tabHandlers = window.tabHandlers || {};
      window.tabLabels = window.tabLabels || {};
      window.tabResetHandlers = window.tabResetHandlers || {};

      window.tabHandlers['general'] = async function() {
        state.name = document.getElementById('field-name').value.trim();
        state.description = document.getElementById('field-description').value;
        state.author = document.getElementById('field-author').value.trim();
        state.startup = document.getElementById('field-startup').value.trim();
        state.stop = document.getElementById('field-stop').value.trim();
        state.startup_done = document.getElementById('field-startup-done').value.trim();
        await saveState();
      };
      window.tabLabels['general'] = 'Save';
      window.tabResetHandlers['general'] = function() {
        state.name = originalData.name;
        state.description = originalData.description;
        state.author = originalData.author;
        state.startup = originalData.startup;
        state.stop = originalData.stop;
        state.startup_done = originalData.startup_done;
        document.getElementById('field-name').value = state.name;
        document.getElementById('field-description').value = state.description;
        document.getElementById('field-author').value = state.author;
        document.getElementById('field-startup').value = state.startup;
        document.getElementById('field-stop').value = state.stop;
        document.getElementById('field-startup-done').value = state.startup_done;
      };

      window.tabHandlers['docker'] = async function() {
        var newImages = {};
        document.querySelectorAll('[data-docker-label]').forEach(function(labelInput, idx) {
          var imageInput = document.querySelector('[data-docker-image="' + idx + '"]');
          var label = labelInput.value.trim();
          var img = imageInput.value.trim();
          if (label && img) newImages[label] = img;
        });
        state.docker_images = newImages;
        await saveState();
      };
      window.tabLabels['docker'] = 'Save';
      window.tabResetHandlers['docker'] = function() {
        state.docker_images = JSON.parse(JSON.stringify(originalData.docker_images));
        renderDockerImages();
      };

      window.tabHandlers['variables'] = async function() {
        document.querySelectorAll('[data-var-field]').forEach(function(input) {
          var idx = parseInt(input.dataset.varField);
          var field = input.dataset.field;
          if (!state.variables[idx]) return;
          if (input.type === 'checkbox') {
            state.variables[idx][field] = input.checked;
          } else {
            state.variables[idx][field] = input.value;
          }
        });
        await saveState();
      };
      window.tabLabels['variables'] = 'Save';
      window.tabResetHandlers['variables'] = function() {
        state.variables = JSON.parse(JSON.stringify(originalData.variables));
        renderVariables();
      };

      window.tabHandlers['install'] = async function() {
        state.scripts.installation = {
          container: document.getElementById('field-install-container').value.trim(),
          entrypoint: document.getElementById('field-install-entrypoint').value.trim() || 'bash',
          script: document.getElementById('field-install-script').value,
        };
        await saveState();
      };
      window.tabLabels['install'] = 'Save';
      window.tabResetHandlers['install'] = function() {
        var orig = originalData.scripts.installation || {};
        state.scripts.installation = { container: orig.container || '', entrypoint: orig.entrypoint || 'bash', script: orig.script || '' };
        document.getElementById('field-install-container').value = state.scripts.installation.container;
        document.getElementById('field-install-entrypoint').value = state.scripts.installation.entrypoint;
        document.getElementById('field-install-script').value = state.scripts.installation.script;
      };

      window.tabHandlers['settings'] = async function() {
        document.querySelectorAll('[data-port-req]').forEach(function(input) {
          var idx = Number(input.dataset.portReq);
          var field = input.dataset.field;
          state.portRequirements[idx][field] = field === 'internalPort' ? Number(input.value) : input.value;
        });
        state.portRequirements = state.portRequirements.filter(function(p) { return p.name && p.internalPort; });
        await saveState();
      };
      window.tabLabels['settings'] = 'Save';
      window.tabResetHandlers['settings'] = function() {
        state.portRequirements = JSON.parse(JSON.stringify(originalData.portRequirements));
        renderPortRequirements();
      };

      window.tabHandlers['raw'] = async function() {
        if (!monacoEditor) return;
        var parsed;
        try { parsed = JSON.parse(monacoEditor.getValue()); }
        catch (e) { showToast('Invalid JSON: ' + e.message, 'error'); return; }
        await savePayload(parsed);
      };
      window.tabLabels['raw'] = 'Save';
      window.tabResetHandlers['raw'] = function() {
        if (monacoEditor) {
          monacoEditor.setValue(buildExportJson());
        }
      };

      if (window._rebindTabHandlers) window._rebindTabHandlers();
    }
  };
}
</script>

<%- include('../../layouts/admin-footer') %>
