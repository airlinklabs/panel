<!-- Search + Refresh -->
<div class="flex items-center gap-3 mt-5 mb-2">
  <div class="relative flex-1 max-w-xs min-w-0">
    <input id="image-store-search-input" type="text" placeholder="<%= t('storeSearchImages') %>" aria-label="<%= t('ariaSearchImages') %>" class="al-input w-full pl-3 pr-3" autocomplete="off">
  </div>
  <span id="countLabel" class="text-xs font-medium px-2 py-1 rounded-md shrink-0" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)"></span>
  <span id="statusText" class="text-xs shrink-0" style="color:var(--theme-text-muted)"></span>
  <button id="refreshBtnLoad" onclick="doRefresh()" type="button" class="al-btn-secondary al-btn-icon-only shrink-0" title="<%= t('storeRefreshCatalogue') %>" aria-label="<%= t('storeRefreshCatalogue') %>">
    <%- icon('refresh-cw', { size: 14 }) %>
  </button>
</div>

<!-- Loading skeleton -->
<div id="loadingEl" class="overflow-hidden rounded-xl mt-3 border" style="border-color:var(--theme-border)">
  <% for(var i=0;i<8;i++){%>
  <div class="flex items-center gap-4 px-6 py-4" style="border-bottom:1px solid var(--theme-border)">
    <div class="h-3 rounded-md bg-[var(--theme-bg-secondary)] flex-1 max-w-[30%]" style="position:relative;overflow:hidden"><div style="position:absolute;inset:0;background:linear-gradient(90deg,transparent 0%,var(--theme-skeleton-shine) 50%,transparent 100%);"></div></div>
    <div class="h-3 rounded-md bg-[var(--theme-bg-secondary)] w-16" style="position:relative;overflow:hidden"><div style="position:absolute;inset:0;background:linear-gradient(90deg,transparent 0%,var(--theme-skeleton-shine) 50%,transparent 100%)"></div></div>
    <div class="h-3 rounded-md bg-[var(--theme-bg-secondary)] w-24 ml-auto" style="position:relative;overflow:hidden"><div style="position:absolute;inset:0;background:linear-gradient(90deg,transparent 0%,var(--theme-skeleton-shine) 50%,transparent 100%)"></div></div>
    <div class="h-8 w-20 rounded-lg bg-[var(--theme-bg-secondary)]" style="position:relative;overflow:hidden"><div style="position:absolute;inset:0;background:linear-gradient(90deg,transparent 0%,var(--theme-skeleton-shine) 50%,transparent 100%)"></div></div>
  </div>
  <% } %>
</div>

<!-- Error state -->
<div id="errorEl" style="display:none">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
      <%- icon('alert-triangle', { class: 'w-6 h-6', style: 'color:var(--theme-text-muted)' }) %>
    </div>
    <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('storeCouldntLoad') %></h3>
    <p class="text-sm mt-1" style="color:var(--theme-text-muted)"><%= t('storeCheckConnection') %></p>
    <button type="button" onclick="loadCatalogue()" class="mt-4 al-btn-secondary"><%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('storeRetry') %></button>
  </div>
</div>

<!-- Empty state -->
<div id="emptyEl" style="display:none">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
      <%- icon('inbox', { class: 'w-6 h-6', style: 'color:var(--theme-text-muted)' }) %>
    </div>
    <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('storeNoImagesFound') %></h3>
    <p id="emptyTxt" class="text-sm mt-1 max-w-xs" style="color:var(--theme-text-muted)"></p>
  </div>
</div>

<!-- List table -->
<div id="listEl" style="display:none;box-shadow:0 0 0 1px var(--theme-border)" class="overflow-x-auto rounded-xl mt-3">
  <table class="al-table" style="table-layout:auto">
    <colgroup>
      <col style="min-width:200px">
      <col style="min-width:90px">
      <col style="min-width:90px">
      <col style="min-width:180px">
    </colgroup>
    <thead class="al-table-head">
      <tr>
        <th class="al-table-th sortable-th" style="min-width:200px" aria-sort="ascending">
          <button type="button" class="sortable-btn" data-sort="app" aria-label="<%= t('ariaSortByApp') %>"><%= t('storeAppHeader') %> <span id="sortApp" class="text-[10px] ml-1 align-middle" aria-hidden="true">&#9650;</span></button>
        </th>
        <th class="al-table-th sortable-th col-hide" style="min-width:90px" aria-sort="none">
          <button type="button" class="sortable-btn" data-sort="type" aria-label="<%= t('ariaSortByType') %>"><%= t('storeTypeHeader') %> <span id="sortType" class="text-[10px] ml-1 align-middle" aria-hidden="true"></span></button>
        </th>
        <th class="al-table-th sortable-th col-hide" style="min-width:90px" aria-sort="none">
          <button type="button" class="sortable-btn" data-sort="author" aria-label="<%= t('ariaSortByImages') %>"><%= t('storeImagesHeader') %> <span id="sortAuthor" class="text-[10px] ml-1 align-middle" aria-hidden="true"></span></button>
        </th>
        <th class="al-table-th sortable-th col-hide" style="min-width:160px" aria-sort="none">
          <button type="button" class="sortable-btn" data-sort="desc" aria-label="<%= t('ariaSortByDescription') %>"><%= t('storeDescriptionHeader') %> <span id="sortDesc" class="text-[10px] ml-1 align-middle" aria-hidden="true"></span></button>
        </th>
      </tr>
    </thead>
    <tbody id="listBody" class="divide-y" style="border-color:var(--theme-border)"></tbody>
  </table>
</div>

<!-- Group drill-down -->
<template id="groupTpl">
  <div class="modal-sheet" style="height:540px;">
    <div class="flex items-center gap-2 mb-3">
      <p id="grpCount" class="text-xs shrink-0" style="color:var(--theme-text-muted)"></p>
    </div>
    <div class="modal-two-col">
      <div class="modal-left">
        <p class="text-[10px] font-semibold uppercase tracking-wider" style="color:var(--theme-text-muted)"><%= t('storeImagesLabel') %></p>
        <div id="grpSubList" class="space-y-1.5"></div>
      </div>
      <div class="modal-right">
        <p class="text-[10px] font-semibold uppercase tracking-wider mb-3" style="color:var(--theme-text-muted)"><%= t('storeReadmeLabel') %></p>
        <div id="grpReadme" class="md-body"></div>
      </div>
    </div>
  </div>
</template>

<!-- Image detail / install -->
<template id="eggTpl">
  <div class="modal-sheet" style="height:480px;">
    <div class="space-y-1 mb-3">
      <span id="eggCat" class="text-[10px] font-medium px-2 py-0.5 rounded-full inline-flex items-center gap-1.5 ring-1 ring-inset"></span>
      <p id="eggDesc" class="text-xs leading-relaxed" style="color:var(--theme-text-muted)"></p>
      <p id="eggAuthor" class="text-[11px]" style="color:var(--theme-text-muted)"></p>
    </div>
    <div class="modal-single-body">
      <div class="flex-1 overflow-y-auto min-h-0">
        <p class="text-[10px] font-semibold uppercase tracking-wider mb-2" style="color:var(--theme-text-muted)"><%= t('storeReadmeLabel') %></p>
        <div id="eggReadme" class="md-body"></div>
      </div>
      <div id="eggErr" style="display:none" class="err-box"><p id="eggErrTxt" class="err-txt"></p></div>
      <button id="eggInstallBtn" onclick="confirmInstall()" type="button" class="al-btn-primary w-full" style="flex-shrink:0"><%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('storeInstallBtn') %></button>
    </div>
  </div>
</template>
