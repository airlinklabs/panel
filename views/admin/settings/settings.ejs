                <div class="flex items-stretch gap-0">
                  <input type="number" id="defaultMaxMemoryDisplay" min="1"
                    value="<%= settings.defaultMaxMemory >= 1024 ? Math.round(settings.defaultMaxMemory / 1024) : settings.defaultMaxMemory %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="defaultMaxMemoryDisplay" data-hidden="defaultMaxMemory"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultMaxCpu') %> <span class="font-normal" style="color:var(--theme-text-muted)">(%)</span></label>
                <input type="number" id="defaultMaxCpu" value="<%= settings.defaultMaxCpu %>" min="50" max="10000"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultMaxStorage') %></label>
                <input type="hidden" id="defaultMaxStorage" value="<%= settings.defaultMaxStorage %>">
                <div class="flex items-stretch gap-0">
                  <input type="number" id="defaultMaxStorageDisplay" min="1"
                    value="<%= settings.defaultMaxStorage >= 1024 ? Math.round(settings.defaultMaxStorage / 1024) : settings.defaultMaxStorage %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="defaultMaxStorageDisplay" data-hidden="defaultMaxStorage"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultMaxDatabases') %></label>
                <input type="number" id="defaultMaxDatabases" value="<%= settings.defaultMaxDatabases %>" min="0" max="100000"
                  class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('defaultUnlimited') %></p>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultOverallocMemory') %></label>
                <input type="number" id="defaultOverallocateMemory" value="<%= settings.defaultOverallocateMemory %>" min="0" max="10000"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultOverallocDisk') %></label>
                <input type="number" id="defaultOverallocateDisk" value="<%= settings.defaultOverallocateDisk %>" min="0" max="10000"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultOverallocCpu') %></label>
                <input type="number" id="defaultOverallocateCpu" value="<%= settings.defaultOverallocateCpu %>" min="0" max="10000"
                  class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('appliedToNewNodes') %></p>
              </div>
            </div>
          </div>

        </div>

        <!-- ── SECURITY ────────────────────────────────────────────────────── -->
        <div id="panel-security" role="tabpanel" aria-labelledby="tab-security" data-tab-panel="security" class="tab-panel space-y-5" hidden>

          <!-- Registration -->
          <div class="al-card">
            <h2 class="al-card-header"><%= t('securityTitle') %></h2>
            <div class="p-4 flex items-center justify-between">
              <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('allowPublicRegistration') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('allowPublicRegistrationDesc') %></p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="allowRegistration" class="sr-only peer" aria-label="<%= t('allowPublicRegistration') %>" <%= settings.allowRegistration ? 'checked' : '' %>>
                <div class="al-toggle-track">
                  <div class="al-toggle-dot"></div>
                </div>
              </label>
            </div>
          </div>

          <!-- VirusTotal -->
          <div class="al-card">
            <h2 class="al-card-header">VirusTotal</h2>
            <div class="p-4">
              <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('virusTotalApiKey') %></label>
              <div class="relative max-w-sm" x-data="{ show: false }">
                <input :type="show ? 'text' : 'password'" id="vtKeyInput" value="<%= settings.virusTotalApiKey || '' %>" placeholder="<%= t('pasteYourKey') %>" autocomplete="off"
                  class="al-input pr-16 font-mono">
                <button type="button" @click="show = !show"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-xs hover:text-[var(--theme-text)] transition" style="color:var(--theme-text-muted)" x-text="show ? '<%= t('hide') %>' : '<%= t('show') %>'"><%= t('show') %></button>
              </div>
              <% if (settings.virusTotalApiKey) { %><p class="mt-1.5 text-xs" style="color:var(--theme-success)"><%= t('keyIsSet') %></p><% } %>
              <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)"><%= t('usedToScanUploadedFiles') %> <a href="https://www.virustotal.com" target="_blank" class="underline hover:text-[var(--theme-text)] transition">virustotal.com</a>.</p>
            </div>
          </div>

          <!-- Rate limiting -->
          <div class="al-card">
            <h2 class="al-card-header"><%= t('rateLimiting') %></h2>
            <div class="p-4 space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('enableRateLimitingLabel') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('limitRequestsPerMinutePerIp') %></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="rateLimitEnabled" class="sr-only peer" aria-label="<%= t('enableRateLimitingLabel') %>" <%= settings.rateLimitEnabled ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('requestsPerMinuteLabel') %></label>
                <input type="number" id="rateLimitRpm" value="<%= settings.rateLimitRpm %>" min="1" max="10000"
                  class="al-input w-48">
              </div>
            </div>
          </div>

          <!-- Login protection -->
          <div class="al-card">
            <h2 class="al-card-header"><%= t('loginProtection') %></h2>
            <p class="text-xs px-5 pt-3" style="color:var(--theme-text-muted)"><%= t('loginProtectionDesc') %></p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 p-4">
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('maxFailedAttemptsBeforeLockout') %></label>
                <input type="number" id="loginMaxAttempts" value="<%= settings.loginMaxAttempts ?? 5 %>" min="1" max="100"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('lockoutDurationMinutes') %></label>
                <input type="number" id="loginLockoutMinutes" value="<%= settings.loginLockoutMinutes ?? 15 %>" min="1" max="1440"
                  class="al-input">
              </div>
            </div>
          </div>

          <!-- Network -->
          <div class="al-card">
            <h2 class="al-card-header"><%= t('network') %></h2>
            <div class="p-4 space-y-5">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('behindReverseProxy') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('behindReverseProxyDesc') %></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="behindReverseProxy" class="sr-only peer" aria-label="<%= t('behindReverseProxy') %>" <%= settings.behindReverseProxy ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('enforceDaemonHttps') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('enforceDaemonHttpsDesc') %></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="enforceDaemonHttps" class="sr-only peer" aria-label="<%= t('enforceDaemonHttps') %>" <%= settings.enforceDaemonHttps ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('require2faForAdmins') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('require2faForAdminsDesc') %></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="require2faForAdmins" class="sr-only peer" aria-label="<%= t('require2faForAdmins') %>" <%= settings.require2faForAdmins ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('hashApiKeysAtRest') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('hashApiKeysAtRestDesc') %> <strong class="" style="color:var(--theme-warning)"><%= t('hashApiKeysWarning') %></strong></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="hashApiKeys" class="sr-only peer" aria-label="<%= t('hashApiKeysAtRest') %>" <%= settings.hashApiKeys ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <!-- SMTP / Email -->
          <div class="al-card">
            <div class="relative">
              <h2 class="al-card-header"><%= t('emailSmtp') %></h2>
              <button type="button" id="smtpTestBtn"
                class="absolute right-4 top-1/2 -translate-y-1/2 inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-[var(--theme-bg-hover)] transition" style="color:var(--theme-text);border-color:var(--theme-border)">
                <%- icon('zap', { class: 'w-3.5 h-3.5' }) %>
                <%= t('testConnection') %>
              </button>
            </div>
            <p class="text-xs px-4 pt-2" style="color:var(--theme-text-muted)"><%= t('usedToSendTransactionalEmail') %></p>
            <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('smtpHost') %></label>
                <input type="text" id="smtpHost" value="<%= settings.smtpHost || '' %>" placeholder="smtp.example.com" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('smtpPort') %></label>
                <input type="number" id="smtpPort" value="<%= settings.smtpPort ?? 587 %>" min="1" max="65535" class="al-input w-full sm:w-48">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('smtpUsername') %></label>
                <input type="text" id="smtpUser" value="<%= settings.smtpUser || '' %>" placeholder="apikey" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('smtpPassword') %></label>
                <div class="relative" x-data="{ show: false }">
                  <input :type="show ? 'text' : 'password'" id="smtpPassword" value="<%= settings.smtpPassword || '' %>" placeholder="••••••••" autocomplete="off" class="al-input pr-16">
                  <button type="button" @click="show = !show"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-xs hover:text-[var(--theme-text)] transition" style="color:var(--theme-text-muted)" x-text="show ? '<%= t('hide') %>' : '<%= t('show') %>'"><%= t('show') %></button>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('fromAddress') %></label>
                <input type="text" id="smtpFrom" value="<%= settings.smtpFrom || '' %>" placeholder="noreply@example.com" autocomplete="off" class="al-input">
              </div>
              <div class="flex items-center justify-between sm:items-end">
                <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('useSslTls') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('useSslTlsDesc') %></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="smtpSecure" class="sr-only peer" aria-label="<%= t('useSslTls') %>" <%= settings.smtpSecure ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('emailCooldownSeconds') %></label>
                <input type="number" id="emailCooldown" value="<%= settings.emailCooldown ?? 30 %>" min="0" max="3600"
                  class="al-input w-48">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('emailCooldownDesc') %></p>
              </div>
            </div>
            <p id="smtpTestResult" class="px-4 pb-4 text-xs hidden"></p>
          </div>

          <!-- S3 / Storage -->
          <div class="al-card">
            <div class="relative">
              <h2 class="al-card-header"><%= t('storageS3Compatible') %></h2>
              <button type="button" id="s3TestBtn"
                class="absolute right-4 top-1/2 -translate-y-1/2 inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-[var(--theme-bg-hover)] transition" style="color:var(--theme-text);border-color:var(--theme-border)">
                <%- icon('zap', { class: 'w-3.5 h-3.5' }) %>
                <%= t('testConnection') %>
              </button>
            </div>
            <p class="text-xs px-4 pt-2" style="color:var(--theme-text-muted)"><%= t('s3Desc') %></p>
            <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex items-center justify-between sm:items-end sm:col-span-2">
                <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('enableS3Backups') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('enableS3BackupsDesc') %></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="s3Enabled" class="sr-only peer" aria-label="<%= t('enableS3Backups') %>" <%= settings.s3Enabled ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('endpointUrl') %></label>
                <input type="text" id="s3Endpoint" value="<%= settings.s3Endpoint || '' %>" placeholder="https://<account>.r2.cloudflarestorage.com or https://minio.local:9000" autocomplete="off" class="al-input">
                <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('leaveEmptyForAwsDefault') %></p>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('region') %></label>
                <input type="text" id="s3Region" value="<%= settings.s3Region || '' %>" placeholder="us-east-1" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('bucket') %></label>
                <input type="text" id="s3Bucket" value="<%= settings.s3Bucket || '' %>" placeholder="airlink-backups" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('accessKey') %></label>
                <input type="text" id="s3AccessKey" value="<%= settings.s3AccessKey || '' %>" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('secretKey') %></label>
                <div class="relative" x-data="{ show: false }">
                  <input :type="show ? 'text' : 'password'" id="s3SecretKey" value="<%= settings.s3SecretKey || '' %>" placeholder="••••••••" autocomplete="off" class="al-input pr-16">
                  <button type="button" @click="show = !show"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-xs hover:text-[var(--theme-text)] transition" style="color:var(--theme-text-muted)" x-text="show ? '<%= t('hide') %>' : '<%= t('show') %>'"><%= t('show') %></button>
                </div>
              </div>
              <div class="flex items-center justify-between sm:items-end sm:col-span-2">
                <div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('pathStyleUrls') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('pathStyleUrlsDesc') %></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="s3PathStyle" class="sr-only peer" aria-label="<%= t('pathStyleUrls') %>" <%= settings.s3PathStyle ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
            <p id="s3TestResult" class="px-4 pb-4 text-xs hidden"></p>
          </div>

          <!-- IP banning -->
          <div class="al-card">
            <h2 class="al-card-header"><%= t('ipBanning') %></h2>
            <div class="p-4">
              <label for="banIpInput" class="text-xs font-medium mb-2 block" style="color:var(--theme-text-muted)"><%= t('banIpLabel') %></label>
              <div class="flex gap-3 mb-4">
                <input type="text" id="banIpInput" placeholder="192.168.1.1" aria-describedby="banIpHint"
                  class="al-input flex-1 max-w-xs">
                <button type="button" id="banIpBtn" class="al-btn-danger"><%- icon('ban', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('banIpButton') %></button>
              </div>
              <p id="banIpHint" class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= t('enterIpToBan') %></p>
              <div id="bannedIpList" class="space-y-2">
                <% let banned = []; try { banned = JSON.parse(settings.bannedIps || '[]'); } catch (e) { /* ignore malformed JSON */ } %>
                <% if (banned.length === 0) { %>
                <p class="text-sm" style="color:var(--theme-text-muted)"><%= t('noBannedIps') %></p>
                <% } else { %>
                <% banned.forEach(function(ip) { %>
                <div class="flex items-center justify-between rounded-xl border px-4 py-2.5" style="border-color:var(--theme-border);background:var(--theme-bg-secondary)">
                  <span class="text-sm font-mono" style="color:var(--theme-text)"><%= ip %></span>
                  <button type="button" class="unban-btn text-xs hover:text-[var(--theme-danger)] transition inline-flex items-center gap-1.5" data-ip="<%= ip %>" style="color:var(--theme-danger)"><%- icon('shield-check', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('unban') %></button>
                </div>
                <% }); } %>
              </div>
            </div>
          </div>

        </div>

        <!-- ── FEATURES ───────────────────────────────────────────────────── -->
