              <div>
                <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultServerLimit') %></label>
                <input type="number" id="defaultServerLimit" value="<%= settings.defaultServerLimit %>" min="0" max="100"
