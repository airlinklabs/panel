                  <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('require2faForAllUsers') %></p>
                  <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('require2faForAllUsersDesc') %></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="twoFactorRequired" class="sr-only peer" aria-label="<%= t('require2faForAllUsers') %>" <%= settings.twoFactorRequired ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header"><%= t('serverFeatures') %></h2>
