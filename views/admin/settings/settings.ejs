<%- include('../../components/header', { title: 'Settings' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/template') %></div>

    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Settings' }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Settings</h1>
          <p class="al-page-desc">Manage your panel configuration.</p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <button type="button" id="tab-save-btn" class="al-btn-primary">Save</button>
          <button type="button" id="tab-reset-btn" class="al-btn-secondary">Reset</button>
        </div>
      </div>

      <div class="al-page-body">

        <!-- Tab bar -->
        <div role="tablist" class="flex gap-1 mb-6">
          <button type="button" role="tab" aria-selected="true" aria-controls="panel-appearance" id="tab-appearance" data-tab="appearance" class="tab-btn px-4 py-2.5 text-sm font-medium transition">Appearance</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="panel-servers" id="tab-servers" data-tab="servers" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition">Servers</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="panel-security" id="tab-security" data-tab="security" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition">Security</button>
        </div>

        <!-- ── APPEARANCE ──────────────────────────────────────────────────── -->
        <div id="panel-appearance" role="tabpanel" aria-labelledby="tab-appearance" data-tab-panel="appearance" class="tab-panel space-y-5 hidden">
          <form id="form-appearance" enctype="multipart/form-data">

          <!-- Branding -->
          <div class="al-card">
            <h2 class="al-card-header">Branding</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 p-4">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Site title</label>
                <input type="text" name="title" value="<%= settings.title %>"
                  class="al-input">
              </div>
              <div>
                <label for="logo-input" class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Logo</label>
                <input type="file" id="logo-input" name="logo" accept="image/*"
                  class="al-input file:mr-3 file:py-1 file:px-2 file:rounded-lg file:border-0 file:text-xs file:bg-neutral-200 dark:file:bg-neutral-600 file:text-neutral-700 dark:file:text-neutral-300">
                <% if (settings.logo) { %>
                <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="Logo" class="h-8 mt-2 object-contain">
                <% } %>
              </div>
              <div>
                <label for="favicon-input" class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Favicon</label>
                <input type="file" id="favicon-input" name="favicon" accept=".ico,.png,.jpg,.jpeg"
                  class="al-input file:mr-3 file:py-1 file:px-2 file:rounded-lg file:border-0 file:text-xs file:bg-neutral-200 dark:file:bg-neutral-600 file:text-neutral-700 dark:file:text-neutral-300">
                <p class="text-xs text-neutral-400 mt-1">PNG or JPG auto-converted to .ico</p>
              </div>
            </div>
          </div>

          <!-- Themes -->
          <div class="al-card">
            <h2 class="al-card-header">Themes</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4">
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-white mb-1">Light mode</p>
                <p class="text-xs text-neutral-500 mb-3">Applied when the panel is in light mode.</p>
                <div class="space-y-2">
                  <% const lightVal = settings.lightTheme || 'default'; %>
                  <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= lightVal === 'default' ? 'al-radio-active' : 'hover:border-neutral-300' %>" style="<%= lightVal !== 'default' ? 'border-color:var(--theme-border)' : '' %>">
                    <input type="radio" name="lightTheme" value="default" class="sr-only" <%= lightVal === 'default' ? 'checked' : '' %>>
                    <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= lightVal === 'default' ? 'al-radio-ring-active' : '' %>" style="<%= lightVal !== 'default' ? 'border-color:var(--theme-text-muted)' : '' %>">
                      <% if (lightVal === 'default') { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
                    </span>
                    <span class="text-sm text-neutral-700 dark:text-neutral-300 flex-1">Default</span>
                    <span class="text-xs" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px">built-in</span>
                  </label>
                  <% allThemes.filter(t => t.name !== 'default').forEach(function(theme) { %>
                  <% const ltv = theme.lightPath || theme.path; %>
                  <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= lightVal === ltv ? 'al-radio-active' : 'hover:border-neutral-300' %>" style="<%= lightVal !== ltv ? 'border-color:var(--theme-border)' : '' %>">
                    <input type="radio" name="lightTheme" value="<%= ltv %>" class="sr-only" <%= lightVal === ltv ? 'checked' : '' %>>
                    <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= lightVal === ltv ? 'al-radio-ring-active' : '' %>" style="<%= lightVal !== ltv ? 'border-color:var(--theme-text-muted)' : '' %>">
                      <% if (lightVal === ltv) { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
                    </span>
                    <div class="flex-1 min-w-0">
                      <span class="text-sm text-neutral-700 dark:text-neutral-300 capitalize block"><%= theme.name.replace(/-/g,' ') %></span>
                      <% if (theme.author) { %><span class="text-xs text-neutral-400">by <%= theme.author %></span><% } %>
                    </div>
                    <span class="text-xs shrink-0" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px"><%= theme.builtin ? 'built-in' : 'custom' %></span>
                  </label>
                  <% }); %>
                </div>
              </div>
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-white mb-1">Dark mode</p>
                <p class="text-xs text-neutral-500 mb-3">Applied when the panel is in dark mode.</p>
                <div class="space-y-2">
                  <% const darkVal = settings.darkTheme || 'default'; %>
                  <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= darkVal === 'default' ? 'al-radio-active' : 'hover:border-neutral-300' %>" style="<%= darkVal !== 'default' ? 'border-color:var(--theme-border)' : '' %>">
                    <input type="radio" name="darkTheme" value="default" class="sr-only" <%= darkVal === 'default' ? 'checked' : '' %>>
                    <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= darkVal === 'default' ? 'al-radio-ring-active' : '' %>" style="<%= darkVal !== 'default' ? 'border-color:var(--theme-text-muted)' : '' %>">
                      <% if (darkVal === 'default') { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
                    </span>
                    <span class="text-sm text-neutral-700 dark:text-neutral-300 flex-1">Default</span>
                    <span class="text-xs" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px">built-in</span>
                  </label>
                  <% allThemes.filter(t => t.name !== 'default').forEach(function(theme) { %>
                  <% const dtv = theme.darkPath || theme.path; %>
                  <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= darkVal === dtv ? 'al-radio-active' : 'hover:border-neutral-300' %>" style="<%= darkVal !== dtv ? 'border-color:var(--theme-border)' : '' %>">
                    <input type="radio" name="darkTheme" value="<%= dtv %>" class="sr-only" <%= darkVal === dtv ? 'checked' : '' %>>
                    <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= darkVal === dtv ? 'al-radio-ring-active' : '' %>" style="<%= darkVal !== dtv ? 'border-color:var(--theme-text-muted)' : '' %>">
                      <% if (darkVal === dtv) { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
                    </span>
                    <div class="flex-1 min-w-0">
                      <span class="text-sm text-neutral-700 dark:text-neutral-300 capitalize block"><%= theme.name.replace(/-/g,' ') %></span>
                      <% if (theme.author) { %><span class="text-xs text-neutral-400">by <%= theme.author %></span><% } %>
                    </div>
                    <span class="text-xs shrink-0" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px"><%= theme.builtin ? 'built-in' : 'custom' %></span>
                  </label>
                  <% }); %>
                </div>
              </div>
            </div>
            <div class="p-5" style="border-top:1px solid var(--theme-border)">
              <div class="flex items-center justify-between mb-2">
                <p class="text-sm font-medium text-neutral-700 dark:text-white">Upload custom theme</p>
                <a href="/admin/settings/example-theme" class="text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">Download example</a>
              </div>
              <p class="text-xs text-neutral-500 mb-3">A .zip containing info.json, light.css, dark.css.</p>
              <label for="theme-file-input" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Upload theme file</label>
              <input type="file" id="theme-file-input" name="themeFile" accept=".zip"
                class="al-input file:mr-3 file:py-1 file:px-2 file:rounded-lg file:border-0 file:text-xs file:bg-neutral-200 dark:file:bg-neutral-600 file:text-neutral-700 dark:file:text-neutral-300">
            </div>
          </div>

          <!-- Auth page wallpapers -->
          <div class="al-card">
            <h2 class="al-card-header">Auth page wallpapers</h2>
            <p class="text-xs text-neutral-500 px-5 pt-2 pb-0">Background image on the login and register pages. Upload a file or paste a URL. Leave both blank to use the default.</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-4">
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-white mb-3">Login page</p>
                <% if (settings.loginWallpaper) { %>
                <img src="<%= settings.loginWallpaper %>" alt="" class="h-20 w-full object-cover rounded-xl border border-neutral-200 dark:border-white/5 mb-3">
                <% } %>
                <label for="login-wallpaper-file" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Upload file</label>
                <input type="file" id="login-wallpaper-file" name="loginWallpaperFile" accept="image/*"
                  class="al-input mb-2 file:mr-3 file:py-1 file:px-2 file:rounded-lg file:border-0 file:text-xs file:bg-neutral-200 dark:file:bg-neutral-600 file:text-neutral-700 dark:file:text-neutral-300">
                <label for="login-wallpaper-url" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Or paste a URL</label>
                <input type="text" id="login-wallpaper-url" name="loginWallpaperUrl" placeholder="https://…"
                  value="<%= (settings.loginWallpaper && settings.loginWallpaper.startsWith('http')) ? settings.loginWallpaper : '' %>"
                  class="al-input">
              </div>
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-white mb-3">Register page</p>
                <% if (settings.registerWallpaper) { %>
                <img src="<%= settings.registerWallpaper %>" alt="" class="h-20 w-full object-cover rounded-xl border border-neutral-200 dark:border-white/5 mb-3">
                <% } %>
                <label for="register-wallpaper-file" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Upload file</label>
                <input type="file" id="register-wallpaper-file" name="registerWallpaperFile" accept="image/*"
                  class="al-input mb-2 file:mr-3 file:py-1 file:px-2 file:rounded-lg file:border-0 file:text-xs file:bg-neutral-200 dark:file:bg-neutral-600 file:text-neutral-700 dark:file:text-neutral-300">
                <label for="register-wallpaper-url" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Or paste a URL</label>
                <input type="text" id="register-wallpaper-url" name="registerWallpaperUrl" placeholder="https://…"
                  value="<%= (settings.registerWallpaper && settings.registerWallpaper.startsWith('http')) ? settings.registerWallpaper : '' %>"
                  class="al-input">
              </div>
            </div>
          </div>

          </form>
        </div>

        <!-- ── SERVERS ─────────────────────────────────────────────────────── -->
        <div id="panel-servers" role="tabpanel" aria-labelledby="tab-servers" data-tab-panel="servers" class="tab-panel hidden space-y-5">

          <div class="al-card">
            <h2 class="al-card-header">User permissions</h2>
            <div class="p-4 space-y-5">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Allow users to create servers</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Users can create their own servers up to their limit.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="allowUserCreateServer" class="sr-only peer" aria-label="Allow users to create servers" <%= settings.allowUserCreateServer ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Allow users to delete servers</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Users can delete servers they own.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="allowUserDeleteServer" class="sr-only peer" aria-label="Allow users to delete servers" <%= settings.allowUserDeleteServer ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">File uploads</h2>
            <div class="p-4">
              <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Upload limit <span class="text-neutral-400 font-normal">(MB)</span></label>
              <div class="relative max-w-xs">
                <input type="number" id="uploadLimitInput" value="<%= settings.uploadLimit %>" min="1" max="10000"
                  class="al-input pr-12">
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs text-neutral-400 pointer-events-none">MB</span>
              </div>
              <p class="mt-1.5 text-xs text-neutral-500">Maximum file size users can upload via the file manager.</p>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Default limits</h2>
            <p class="text-xs text-neutral-500 px-5 pt-3">Applied to new users unless overridden per-user.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-4">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Server limit</label>
                <input type="number" id="defaultServerLimit" value="<%= settings.defaultServerLimit %>" min="0" max="100"
                  class="al-input">
                <p class="mt-1 text-xs text-neutral-500">0 = cannot create.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max memory</label>
                <input type="hidden" id="defaultMaxMemory" value="<%= settings.defaultMaxMemory %>">
                <div class="flex items-stretch gap-0">
                  <input type="number" id="defaultMaxMemoryDisplay" min="1"
                    value="<%= settings.defaultMaxMemory >= 1024 ? Math.round(settings.defaultMaxMemory / 1024) : settings.defaultMaxMemory %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="defaultMaxMemoryDisplay" data-hidden="defaultMaxMemory"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max CPU <span class="text-neutral-400 font-normal">(%)</span></label>
                <input type="number" id="defaultMaxCpu" value="<%= settings.defaultMaxCpu %>" min="50" max="10000"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max storage</label>
                <input type="hidden" id="defaultMaxStorage" value="<%= settings.defaultMaxStorage %>">
                <div class="flex items-stretch gap-0">
                  <input type="number" id="defaultMaxStorageDisplay" min="1"
                    value="<%= settings.defaultMaxStorage >= 1024 ? Math.round(settings.defaultMaxStorage / 1024) : settings.defaultMaxStorage %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="defaultMaxStorageDisplay" data-hidden="defaultMaxStorage"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- ── SECURITY ────────────────────────────────────────────────────── -->
        <div id="panel-security" role="tabpanel" aria-labelledby="tab-security" data-tab-panel="security" class="tab-panel hidden space-y-5">

          <!-- Registration -->
          <div class="al-card">
            <h2 class="al-card-header">Registration</h2>
            <div class="p-4 flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-white">Allow public registration</p>
                <p class="text-xs text-neutral-500 mt-0.5">When off, only admins can create new accounts.</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="allowRegistration" class="sr-only peer" aria-label="Allow public registration" <%= settings.allowRegistration ? 'checked' : '' %>>
                <div class="al-toggle-track">
                  <div class="al-toggle-dot"></div>
                </div>
              </label>
            </div>
          </div>

          <!-- VirusTotal -->
          <div class="al-card">
            <h2 class="al-card-header">VirusTotal</h2>
            <div class="p-4">
              <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">API key</label>
              <div class="relative max-w-sm">
                <input type="password" id="vtKeyInput" value="<%= settings.virusTotalApiKey || '' %>" placeholder="Paste your key" autocomplete="off"
                  class="al-input pr-16 font-mono">
                <button type="button" onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.textContent=i.type==='password'?'Show':'Hide';"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">Show</button>
              </div>
              <% if (settings.virusTotalApiKey) { %><p class="mt-1.5 text-xs text-emerald-600 dark:text-emerald-400">Key is set.</p><% } %>
              <p class="mt-1.5 text-xs text-neutral-500">Used to scan uploaded files. Get a free key at <a href="https://www.virustotal.com" target="_blank" class="underline hover:text-neutral-700 dark:hover:text-neutral-300 transition">virustotal.com</a>.</p>
            </div>
          </div>

          <!-- Rate limiting -->
          <div class="al-card">
            <h2 class="al-card-header">Rate limiting</h2>
            <div class="p-4 space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Enable rate limiting</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Limit requests per minute per IP address.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="rateLimitEnabled" class="sr-only peer" aria-label="Enable rate limiting" <%= settings.rateLimitEnabled ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Requests per minute</label>
                <input type="number" id="rateLimitRpm" value="<%= settings.rateLimitRpm %>" min="1" max="10000"
                  class="al-input w-48">
              </div>
            </div>
          </div>

          <!-- Login protection -->
          <div class="al-card">
            <h2 class="al-card-header">Login protection</h2>
            <p class="text-xs text-neutral-500 px-5 pt-3">After N failed attempts from a single account, that account is locked for the configured duration. Errors always say "invalid credentials" — the username is never revealed.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 p-4">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max failed attempts before lockout</label>
                <input type="number" id="loginMaxAttempts" value="<%= settings.loginMaxAttempts ?? 5 %>" min="1" max="100"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Lockout duration <span class="text-neutral-400 font-normal">(minutes)</span></label>
                <input type="number" id="loginLockoutMinutes" value="<%= settings.loginLockoutMinutes ?? 15 %>" min="1" max="1440"
                  class="al-input">
              </div>
            </div>
          </div>

          <!-- Network -->
          <div class="al-card">
            <h2 class="al-card-header">Network</h2>
            <div class="p-4 space-y-5">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Behind a reverse proxy</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Enable if Nginx, Caddy, or another proxy sits in front. Makes <code class="text-xs bg-neutral-200 dark:bg-neutral-700 px-1 rounded">req.ip</code> use the forwarded header so rate limiting and IP bans target the real client.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="behindReverseProxy" class="sr-only peer" aria-label="Behind a reverse proxy" <%= settings.behindReverseProxy ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Enforce HTTPS for daemon connections</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Panel contacts daemons over <code class="text-xs bg-neutral-200 dark:bg-neutral-700 px-1 rounded">https://</code>. Only enable if your daemons have TLS configured.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="enforceDaemonHttps" class="sr-only peer" aria-label="Enforce HTTPS for daemon connections" <%= settings.enforceDaemonHttps ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Hash API keys at rest</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Store API keys as SHA-256 hashes in the database. <strong class="text-amber-600 dark:text-amber-400">Enable before creating new keys — existing keys shown once.</strong></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="hashApiKeys" class="sr-only peer" aria-label="Hash API keys at rest" <%= settings.hashApiKeys ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <!-- SMTP / Email -->
          <div class="al-card">
            <div class="flex items-center justify-between px-5 pt-4">
              <h2 class="al-card-header !pt-0">Email (SMTP)</h2>
              <button type="button" id="smtpTestBtn"
                class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 px-3 py-1.5 text-xs font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
                <%- icon('zap', { class: 'w-3.5 h-3.5' }) %>
                Test connection
              </button>
            </div>
            <p class="text-xs text-neutral-500 px-5 pt-1">Used to send transactional email like password reset links.</p>
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">SMTP host</label>
                <input type="text" id="smtpHost" value="<%= settings.smtpHost || '' %>" placeholder="smtp.example.com" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Port</label>
                <input type="number" id="smtpPort" value="<%= settings.smtpPort ?? 587 %>" min="1" max="65535" class="al-input w-full sm:w-48">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Username</label>
                <input type="text" id="smtpUser" value="<%= settings.smtpUser || '' %>" placeholder="apikey" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Password</label>
                <div class="relative">
                  <input type="password" id="smtpPassword" value="<%= settings.smtpPassword || '' %>" placeholder="••••••••" autocomplete="off" class="al-input pr-16">
                  <button type="button" onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.textContent=i.type==='password'?'Show':'Hide';"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">Show</button>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">From address</label>
                <input type="text" id="smtpFrom" value="<%= settings.smtpFrom || '' %>" placeholder="noreply@example.com" autocomplete="off" class="al-input">
              </div>
              <div class="flex items-center justify-between sm:items-end">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Use SSL/TLS</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Implicit TLS (port 465). Off = STARTTLS (587).</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="smtpSecure" class="sr-only peer" aria-label="Use SSL/TLS" <%= settings.smtpSecure ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
            <p id="smtpTestResult" class="px-5 pb-5 text-xs hidden"></p>
          </div>

          <!-- S3 / Storage -->
          <div class="al-card">
            <div class="flex items-center justify-between px-5 pt-4">
              <h2 class="al-card-header !pt-0">Storage (S3-compatible)</h2>
              <button type="button" id="s3TestBtn"
                class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 px-3 py-1.5 text-xs font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
                <%- icon('zap', { class: 'w-3.5 h-3.5' }) %>
                Test connection
              </button>
            </div>
            <p class="text-xs text-neutral-500 px-5 pt-1">Offload backups to any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).</p>
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex items-center justify-between sm:items-end sm:col-span-2">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Enable S3 backups</p>
                  <p class="text-xs text-neutral-500 mt-0.5">New backups are uploaded to the bucket and removed from the node.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="s3Enabled" class="sr-only peer" aria-label="Enable S3 backups" <%= settings.s3Enabled ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Endpoint URL</label>
                <input type="text" id="s3Endpoint" value="<%= settings.s3Endpoint || '' %>" placeholder="https://<account>.r2.cloudflarestorage.com or https://minio.local:9000" autocomplete="off" class="al-input">
                <p class="text-xs text-neutral-500 mt-1">Leave empty for AWS S3 default endpoint.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Region</label>
                <input type="text" id="s3Region" value="<%= settings.s3Region || '' %>" placeholder="us-east-1" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Bucket</label>
                <input type="text" id="s3Bucket" value="<%= settings.s3Bucket || '' %>" placeholder="airlink-backups" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Access key</label>
                <input type="text" id="s3AccessKey" value="<%= settings.s3AccessKey || '' %>" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Secret key</label>
                <div class="relative">
                  <input type="password" id="s3SecretKey" value="<%= settings.s3SecretKey || '' %>" placeholder="••••••••" autocomplete="off" class="al-input pr-16">
                  <button type="button" onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.textContent=i.type==='password'?'Show':'Hide';"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">Show</button>
                </div>
              </div>
              <div class="flex items-center justify-between sm:items-end sm:col-span-2">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Path-style URLs</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Required for MinIO and most self-hosted S3 servers.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="s3PathStyle" class="sr-only peer" aria-label="Use path-style URLs" <%= settings.s3PathStyle ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
            <p id="s3TestResult" class="px-5 pb-5 text-xs hidden"></p>
          </div>

          <!-- IP banning -->
          <div class="al-card">
            <h2 class="al-card-header">IP banning</h2>
            <div class="p-4">
              <label for="banIpInput" class="text-xs font-medium text-neutral-500 dark:text-neutral-400 mb-2 block">IP Address</label>
              <div class="flex gap-3 mb-4">
                <input type="text" id="banIpInput" placeholder="192.168.1.1" aria-describedby="banIpHint"
                  class="al-input flex-1 max-w-xs">
                <button type="button" id="banIpBtn" class="al-btn-danger">Ban IP</button>
              </div>
              <p id="banIpHint" class="text-xs text-neutral-400 mb-4">Enter the IP address you want to ban from accessing the panel.</p>
              <div id="bannedIpList" class="space-y-2">
                <% let banned = []; try { banned = JSON.parse(settings.bannedIps || '[]'); } catch {} %>
                <% if (banned.length === 0) { %>
                <p class="text-sm text-neutral-400">No banned IPs.</p>
                <% } else { %>
                <% banned.forEach(function(ip) { %>
                <div class="flex items-center justify-between rounded-xl bg-neutral-100 dark:bg-neutral-800/40 border border-neutral-200 dark:border-white/5 px-4 py-2.5">
                  <span class="text-sm font-mono text-neutral-700 dark:text-neutral-300"><%= ip %></span>
                  <button type="button" class="unban-btn text-xs text-red-500 hover:text-red-700 dark:hover:text-red-400 transition" data-ip="<%= ip %>">Unban</button>
                </div>
                <% }); } %>
              </div>
            </div>
          </div>

        </div>

        <script nonce="<%- nonce %>">
        (function(){
          var tabBtns = document.querySelectorAll('.tab-btn');
          var tabPanels = document.querySelectorAll('.tab-panel');
          var tabList = document.querySelector('[role="tablist"]');
          var saveBtn = document.getElementById('tab-save-btn');
          var resetBtn = document.getElementById('tab-reset-btn');
          function activate(id) {
            tabBtns.forEach(function(btn) {
              var on = btn.dataset.tab === id;
              btn.setAttribute('aria-selected', on ? 'true' : 'false');
              btn.setAttribute('tabindex', on ? '0' : '-1');
            });
            tabPanels.forEach(function(p) { p.classList.toggle('hidden', p.dataset.tabPanel !== id); });
            rebind(id);
            try { localStorage.setItem('settings_tab', id); } catch {}
          }
          function rebind(id) {
            if (window.tabHandlers && saveBtn) {
              saveBtn.onclick = window.tabHandlers[id] || null;
              saveBtn.textContent = (window.tabLabels && window.tabLabels[id]) || 'Save';
            }
            if (window.tabResetHandlers && resetBtn) {
              resetBtn.onclick = window.tabResetHandlers[id] || null;
            }
          }
          window._rebindTabHandlers = function() {
            var active = document.querySelector('.tab-btn[aria-selected="true"]');
            if (active) rebind(active.dataset.tab);
          };
          tabBtns.forEach(function(btn) { btn.addEventListener('click', function() { activate(this.dataset.tab); }); });
          if (tabList) {
            tabList.addEventListener('keydown', function(e) {
              var tabs = Array.from(tabBtns);
              var currentIndex = tabs.findIndex(function(t) { return t === document.activeElement; });
              if (currentIndex === -1) return;
              var newIndex = currentIndex;
              if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); newIndex = (currentIndex + 1) % tabs.length; }
              else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); newIndex = (currentIndex - 1 + tabs.length) % tabs.length; }
              else if (e.key === 'Home') { e.preventDefault(); newIndex = 0; }
              else if (e.key === 'End') { e.preventDefault(); newIndex = tabs.length - 1; }
              if (newIndex !== currentIndex) { tabs[newIndex].focus(); activate(tabs[newIndex].dataset.tab); }
            });
          }
          var saved = null;
          try { saved = localStorage.getItem('settings_tab'); } catch {}
          activate(saved || 'appearance');
        })();
        </script>

      </div>
    </div>
  </div>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/modal') %>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-settings.js"></script>

<script nonce="<%- nonce %>">
(function() {
  var hasUnsavedChanges = false;

  document.querySelectorAll('input, select, textarea').forEach(function(el) {
    el.addEventListener('change', function() {
      hasUnsavedChanges = true;
    });
  });

  window.addEventListener('beforeunload', function(e) {
    if (hasUnsavedChanges) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  var forms = document.querySelectorAll('form');
  forms.forEach(function(form) {
    form.addEventListener('submit', function() {
      hasUnsavedChanges = false;
    });
  });
})();
</script>

<%- include('../../components/footer') %>
