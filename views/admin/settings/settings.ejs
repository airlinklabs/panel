<%- include('../../components/header', { title: 'Settings' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>

    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Settings' }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Settings</h1>
          <p class="al-page-desc">Manage your panel configuration.</p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <span id="autosave-indicator" class="text-xs font-medium transition-opacity duration-300 opacity-0" style="color:var(--theme-success);">Saved</span>
        </div>
      </div>

      <div class="al-page-body" data-al-tabs data-tabs-default="appearance" data-tabs-hash>

        <!-- Tab bar -->
        <div role="tablist" class="flex gap-1 mb-6">
          <button type="button" role="tab" aria-selected="true" aria-controls="panel-appearance" id="tab-appearance" data-tab="appearance" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('palette', { class: 'size-4', strokeWidth: 1.5 }) %>Appearance</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="panel-servers" id="tab-servers" data-tab="servers" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('server', { class: 'size-4', strokeWidth: 1.5 }) %>Servers</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="panel-security" id="tab-security" data-tab="security" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('shield', { class: 'size-4', strokeWidth: 1.5 }) %>Security</button>
        </div>

        <!-- ── APPEARANCE ──────────────────────────────────────────────────── -->
        <div id="panel-appearance" role="tabpanel" aria-labelledby="tab-appearance" data-tab-panel="appearance" class="tab-panel space-y-5">
          <form id="form-appearance" enctype="multipart/form-data" class="space-y-6">

          <!-- Branding -->
          <div class="al-card">
            <h2 class="al-card-header">Branding</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 p-4">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Site title</label>
                <input type="text" name="title" value="<%= settings.title %>"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Logo</label>
                <div class="flex items-center gap-2">
                  <button type="button" onclick="openUploadModal({ title: 'Upload logo', accept: 'image/*', onFile: function(f) { document.getElementById('logo-input')._selectedFile = f; document.getElementById('logo-label-name').textContent = f.name; document.getElementById('logo-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
                    <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %>Choose file
                  </button>
                  <span id="logo-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);">No file chosen</span>
                  <button type="button" id="logo-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('logo-input')._selectedFile=null;document.getElementById('logo-label-name').textContent='No file chosen';this.classList.add('hidden')">
                    <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
                  </button>
                </div>
                <input type="file" id="logo-input" name="logo" accept="image/*" class="hidden">
                <% if (settings.logo) { %>
                <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="Logo" class="h-8 mt-2 object-contain">
                <% } %>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Favicon</label>
                <div class="flex items-center gap-2">
                  <button type="button" onclick="openUploadModal({ title: 'Upload favicon', accept: '.ico,.png,.jpg,.jpeg', onFile: function(f) { document.getElementById('favicon-input')._selectedFile = f; document.getElementById('favicon-label-name').textContent = f.name; document.getElementById('favicon-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
                    <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %>Choose file
                  </button>
                  <span id="favicon-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);">No file chosen</span>
                  <button type="button" id="favicon-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('favicon-input')._selectedFile=null;document.getElementById('favicon-label-name').textContent='No file chosen';this.classList.add('hidden')">
                    <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
                  </button>
                </div>
                <input type="file" id="favicon-input" name="favicon" accept=".ico,.png,.jpg,.jpeg" class="hidden">
                <p class="text-xs mt-1" style="color:var(--theme-text-muted)">PNG or JPG auto-converted to .ico</p>
              </div>
            </div>
          </div>

          <!-- Themes -->
          <div class="al-card">
            <h2 class="al-card-header">Theme</h2>
            <p class="text-xs text-neutral-500 px-5 pt-2 pb-0">Select a theme for the panel. All users will see this theme.</p>
            <div class="p-4">
              <div class="space-y-2">
                <% const themeVal = settings.theme || 'dark'; %>
                <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= themeVal === 'light' ? 'al-radio-active' : 'hover:border-neutral-300' %>" style="<%= themeVal !== 'light' ? 'border-color:var(--theme-border)' : '' %>">
                  <input type="radio" name="theme" value="light" class="sr-only" <%= themeVal === 'light' ? 'checked' : '' %>>
                  <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= themeVal === 'light' ? 'al-radio-ring-active' : '' %>" style="<%= themeVal !== 'light' ? 'border-color:var(--theme-border)' : '' %>">
                    <% if (themeVal === 'light') { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
                  </span>
                  <span class="text-sm text-neutral-700 dark:text-neutral-300 flex-1">Light Mode</span>
                  <span class="text-xs" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px">built-in</span>
                </label>
                <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= themeVal === 'dark' ? 'al-radio-active' : 'hover:border-neutral-300' %>" style="<%= themeVal !== 'dark' ? 'border-color:var(--theme-border)' : '' %>">
                  <input type="radio" name="theme" value="dark" class="sr-only" <%= themeVal === 'dark' ? 'checked' : '' %>>
                  <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= themeVal === 'dark' ? 'al-radio-ring-active' : '' %>" style="<%= themeVal !== 'dark' ? 'border-color:var(--theme-border)' : '' %>">
                    <% if (themeVal === 'dark') { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
                  </span>
                  <span class="text-sm text-neutral-700 dark:text-neutral-300 flex-1">Dark Mode</span>
                  <span class="text-xs" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px">built-in</span>
                </label>
                <% allThemes.filter(t => t.name !== 'default' && t.name !== 'default-light' && t.name !== 'default-dark').forEach(function(theme) { %>
                <% const tv = theme.path || theme.lightPath; %>
                <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= themeVal === tv ? 'al-radio-active' : 'hover:border-neutral-300' %>" style="<%= themeVal !== tv ? 'border-color:var(--theme-border)' : '' %>">
                  <input type="radio" name="theme" value="<%= tv %>" class="sr-only" <%= themeVal === tv ? 'checked' : '' %>>
                  <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= themeVal === tv ? 'al-radio-ring-active' : '' %>" style="<%= themeVal !== tv ? 'border-color:var(--theme-border)' : '' %>">
                    <% if (themeVal === tv) { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
                  </span>
                  <div class="flex-1 min-w-0">
                    <span class="text-sm text-neutral-700 dark:text-neutral-300 capitalize block"><%= theme.name.replace(/-/g,' ') %></span>
                    <% if (theme.author) { %><span class="text-xs" style="color:var(--theme-text-muted)">by <%= theme.author %></span><% } %>
                  </div>
                  <span class="text-xs shrink-0" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px"><%= theme.builtin ? 'built-in' : 'custom' %></span>
                </label>
                <% }); %>
              </div>
            </div>
            <div class="p-5" style="border-top:1px solid var(--theme-border)">
              <div class="flex items-center justify-between mb-2">
                <p class="text-sm font-medium text-neutral-700 dark:text-white">Upload custom theme</p>
                <a href="/admin/settings/example-theme" class="text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">Download example</a>
              </div>
              <p class="text-xs text-neutral-500 mb-3">A .zip containing info.json, light.css, dark.css.</p>
              <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Upload theme file</label>
              <div class="flex items-center gap-2">
                <button type="button" onclick="openUploadModal({ title: 'Upload theme', accept: '.zip', onFile: function(f) { document.getElementById('theme-file-input')._selectedFile = f; document.getElementById('theme-label-name').textContent = f.name; document.getElementById('theme-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
                  <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %>Choose file
                </button>
                <span id="theme-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);">No file chosen</span>
                <button type="button" id="theme-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('theme-file-input')._selectedFile=null;document.getElementById('theme-label-name').textContent='No file chosen';this.classList.add('hidden')">
                  <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
                </button>
              </div>
              <input type="file" id="theme-file-input" name="themeFile" accept=".zip" class="hidden">
            </div>
          </div>

          <!-- Auth page wallpapers -->
          <div class="al-card">
            <h2 class="al-card-header">Auth page wallpapers</h2>
            <p class="text-xs text-neutral-500 px-5 pt-2 pb-0">Background image on the login and register pages. Upload a file or paste a URL. Leave both blank to use the default.</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-4">
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-white mb-3">Login page</p>
                <% if (settings.loginWallpaper) { %>
                <img src="<%= settings.loginWallpaper %>" alt="Login page wallpaper preview" class="h-20 w-full object-cover rounded-xl border border-neutral-200 dark:border-white/5 mb-3">
                <% } %>
                <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Upload file</label>
                <div class="flex items-center gap-2 mb-2">
                  <button type="button" onclick="openUploadModal({ title: 'Upload login wallpaper', accept: 'image/*', onFile: function(f) { document.getElementById('login-wallpaper-file')._selectedFile = f; document.getElementById('login-wp-label-name').textContent = f.name; document.getElementById('login-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
                    <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %>Choose file
                  </button>
                  <span id="login-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);">No file chosen</span>
                  <button type="button" id="login-wp-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('login-wallpaper-file')._selectedFile=null;document.getElementById('login-wp-label-name').textContent='No file chosen';this.classList.add('hidden')">
                    <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
                  </button>
                </div>
                <input type="file" id="login-wallpaper-file" name="loginWallpaperFile" accept="image/*" class="hidden">
                <label for="login-wallpaper-url" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Or paste a URL</label>
                <input type="text" id="login-wallpaper-url" name="loginWallpaperUrl" placeholder="https://…"
                  value="<%= (settings.loginWallpaper && settings.loginWallpaper.startsWith('http')) ? settings.loginWallpaper : '' %>"
                  class="al-input">
              </div>
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-white mb-3">Register page</p>
                <% if (settings.registerWallpaper) { %>
                <img src="<%= settings.registerWallpaper %>" alt="Register page wallpaper preview" class="h-20 w-full object-cover rounded-xl border border-neutral-200 dark:border-white/5 mb-3">
                <% } %>
                <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Upload file</label>
                <div class="flex items-center gap-2 mb-2">
                  <button type="button" onclick="openUploadModal({ title: 'Upload register wallpaper', accept: 'image/*', onFile: function(f) { document.getElementById('register-wallpaper-file')._selectedFile = f; document.getElementById('register-wp-label-name').textContent = f.name; document.getElementById('register-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
                    <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %>Choose file
                  </button>
                  <span id="register-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);">No file chosen</span>
                  <button type="button" id="register-wp-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('register-wallpaper-file')._selectedFile=null;document.getElementById('register-wp-label-name').textContent='No file chosen';this.classList.add('hidden')">
                    <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
                  </button>
                </div>
                <input type="file" id="register-wallpaper-file" name="registerWallpaperFile" accept="image/*" class="hidden">
                <label for="register-wallpaper-url" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Or paste a URL</label>
                <input type="text" id="register-wallpaper-url" name="registerWallpaperUrl" placeholder="https://…"
                  value="<%= (settings.registerWallpaper && settings.registerWallpaper.startsWith('http')) ? settings.registerWallpaper : '' %>"
                  class="al-input">
              </div>
            </div>
          </div>

          <!-- Panel wallpaper -->
          <div class="al-card">
            <h2 class="al-card-header">Panel wallpaper</h2>
            <p class="text-xs text-neutral-500 px-5 pt-2 pb-0">Background image behind the panel content. Upload a file or paste a URL. Leave both blank to use the plain theme background. The Overview and Credits pages keep their own backgrounds.</p>
            <div class="p-4">
              <% if (settings.panelWallpaper) { %>
              <img src="<%= settings.panelWallpaper %>" alt="Panel wallpaper preview" class="h-20 w-full object-cover rounded-xl border border-neutral-200 dark:border-white/5 mb-3">
              <% } %>
              <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Upload file</label>
              <div class="flex items-center gap-2 mb-2">
                <button type="button" onclick="openUploadModal({ title: 'Upload panel wallpaper', accept: 'image/*', onFile: function(f) { document.getElementById('panel-wallpaper-file')._selectedFile = f; document.getElementById('panel-wp-label-name').textContent = f.name; document.getElementById('panel-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
                  <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %>Choose file
                </button>
                <span id="panel-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);">No file chosen</span>
                <button type="button" id="panel-wp-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('panel-wallpaper-file')._selectedFile=null;document.getElementById('panel-wp-label-name').textContent='No file chosen';this.classList.add('hidden')">
                  <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
                </button>
              </div>
              <input type="file" id="panel-wallpaper-file" name="panelWallpaperFile" accept="image/*" class="hidden">
              <label for="panel-wallpaper-url" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1.5">Or paste a URL</label>
              <input type="text" id="panel-wallpaper-url" name="panelWallpaperUrl" placeholder="https://…"
                value="<%= (settings.panelWallpaper && settings.panelWallpaper.startsWith('http')) ? settings.panelWallpaper : '' %>"
                class="al-input">
            </div>
          </div>

          </form>
        </div>

        <!-- ── SERVERS ─────────────────────────────────────────────────────── -->
        <div id="panel-servers" role="tabpanel" aria-labelledby="tab-servers" data-tab-panel="servers" class="tab-panel space-y-5" hidden>

          <div class="al-card">
            <h2 class="al-card-header">User permissions</h2>
            <div class="p-4 space-y-5">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Allow users to create servers</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Users can create their own servers up to their limit.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="allowUserCreateServer" class="sr-only peer" aria-label="Allow users to create servers" <%= settings.allowUserCreateServer ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Allow users to delete servers</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Users can delete servers they own.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="allowUserDeleteServer" class="sr-only peer" aria-label="Allow users to delete servers" <%= settings.allowUserDeleteServer ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Allow users to submit images</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Users can submit custom images for admin approval. Approved images appear in the create-server flow.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="allowUserCreateImages" class="sr-only peer" aria-label="Allow users to submit images" <%= settings.allowUserCreateImages ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Show onboarding tutorial</p>
                  <p class="text-xs text-neutral-500 mt-0.5">New users get a short 3-step tutorial after their first login.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="onboardingEnabled" class="sr-only peer" aria-label="Show onboarding tutorial" <%= settings.onboardingEnabled ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">File uploads</h2>
            <div class="p-4">
              <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Upload limit <span class="font-normal" style="color:var(--theme-text-muted)">(MB)</span></label>
              <div class="relative max-w-xs">
                <input type="number" id="uploadLimitInput" value="<%= settings.uploadLimit %>" min="1" max="10000"
                  class="al-input pr-12">
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs pointer-events-none" style="color:var(--theme-text-muted)">MB</span>
              </div>
              <p class="mt-1.5 text-xs text-neutral-500">Maximum file size users can upload via the file manager.</p>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Default limits</h2>
            <p class="text-xs text-neutral-500 px-5 pt-3">Applied to new users unless overridden per-user.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-4">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Server limit</label>
                <input type="number" id="defaultServerLimit" value="<%= settings.defaultServerLimit %>" min="0" max="100"
                  class="al-input">
                <p class="mt-1 text-xs text-neutral-500">0 = cannot create.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max memory</label>
                <input type="hidden" id="defaultMaxMemory" value="<%= settings.defaultMaxMemory %>">
                <div class="flex items-stretch gap-0">
                  <input type="number" id="defaultMaxMemoryDisplay" min="1"
                    value="<%= settings.defaultMaxMemory >= 1024 ? Math.round(settings.defaultMaxMemory / 1024) : settings.defaultMaxMemory %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="defaultMaxMemoryDisplay" data-hidden="defaultMaxMemory"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max CPU <span class="font-normal" style="color:var(--theme-text-muted)">(%)</span></label>
                <input type="number" id="defaultMaxCpu" value="<%= settings.defaultMaxCpu %>" min="50" max="10000"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max storage</label>
                <input type="hidden" id="defaultMaxStorage" value="<%= settings.defaultMaxStorage %>">
                <div class="flex items-stretch gap-0">
                  <input type="number" id="defaultMaxStorageDisplay" min="1"
                    value="<%= settings.defaultMaxStorage >= 1024 ? Math.round(settings.defaultMaxStorage / 1024) : settings.defaultMaxStorage %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="defaultMaxStorageDisplay" data-hidden="defaultMaxStorage"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max databases</label>
                <input type="number" id="defaultMaxDatabases" value="<%= settings.defaultMaxDatabases %>" min="0" max="100000"
                  class="al-input">
                <p class="mt-1 text-xs text-neutral-500">0 = unlimited.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Default overalloc memory (%)</label>
                <input type="number" id="defaultOverallocateMemory" value="<%= settings.defaultOverallocateMemory %>" min="0" max="10000"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Default overalloc disk (%)</label>
                <input type="number" id="defaultOverallocateDisk" value="<%= settings.defaultOverallocateDisk %>" min="0" max="10000"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Default overalloc CPU (%)</label>
                <input type="number" id="defaultOverallocateCpu" value="<%= settings.defaultOverallocateCpu %>" min="0" max="10000"
                  class="al-input">
                <p class="mt-1 text-xs text-neutral-500">Applied to new nodes.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- ── SECURITY ────────────────────────────────────────────────────── -->
        <div id="panel-security" role="tabpanel" aria-labelledby="tab-security" data-tab-panel="security" class="tab-panel space-y-5" hidden>

          <!-- Registration -->
          <div class="al-card">
            <h2 class="al-card-header">Registration</h2>
            <div class="p-4 flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-white">Allow public registration</p>
                <p class="text-xs text-neutral-500 mt-0.5">When off, only admins can create new accounts.</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="allowRegistration" class="sr-only peer" aria-label="Allow public registration" <%= settings.allowRegistration ? 'checked' : '' %>>
                <div class="al-toggle-track">
                  <div class="al-toggle-dot"></div>
                </div>
              </label>
            </div>
          </div>

          <!-- VirusTotal -->
          <div class="al-card">
            <h2 class="al-card-header">VirusTotal</h2>
            <div class="p-4">
              <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">API key</label>
              <div class="relative max-w-sm">
                <input type="password" id="vtKeyInput" value="<%= settings.virusTotalApiKey || '' %>" placeholder="Paste your key" autocomplete="off"
                  class="al-input pr-16 font-mono">
                <button type="button" onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.textContent=i.type==='password'?'Show':'Hide';"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">Show</button>
              </div>
              <% if (settings.virusTotalApiKey) { %><p class="mt-1.5 text-xs text-emerald-700 dark:text-emerald-400">Key is set.</p><% } %>
              <p class="mt-1.5 text-xs text-neutral-500">Used to scan uploaded files. Get a free key at <a href="https://www.virustotal.com" target="_blank" class="underline hover:text-neutral-700 dark:hover:text-neutral-300 transition">virustotal.com</a>.</p>
            </div>
          </div>

          <!-- Rate limiting -->
          <div class="al-card">
            <h2 class="al-card-header">Rate limiting</h2>
            <div class="p-4 space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Enable rate limiting</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Limit requests per minute per IP address.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="rateLimitEnabled" class="sr-only peer" aria-label="Enable rate limiting" <%= settings.rateLimitEnabled ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Requests per minute</label>
                <input type="number" id="rateLimitRpm" value="<%= settings.rateLimitRpm %>" min="1" max="10000"
                  class="al-input w-48">
              </div>
            </div>
          </div>

          <!-- Login protection -->
          <div class="al-card">
            <h2 class="al-card-header">Login protection</h2>
            <p class="text-xs text-neutral-500 px-5 pt-3">After N failed attempts from a single account, that account is locked for the configured duration. Errors always say "invalid credentials" — the username is never revealed.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 p-4">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Max failed attempts before lockout</label>
                <input type="number" id="loginMaxAttempts" value="<%= settings.loginMaxAttempts ?? 5 %>" min="1" max="100"
                  class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Lockout duration <span class="font-normal" style="color:var(--theme-text-muted)">(minutes)</span></label>
                <input type="number" id="loginLockoutMinutes" value="<%= settings.loginLockoutMinutes ?? 15 %>" min="1" max="1440"
                  class="al-input">
              </div>
            </div>
          </div>

          <!-- Network -->
          <div class="al-card">
            <h2 class="al-card-header">Network</h2>
            <div class="p-4 space-y-5">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Behind a reverse proxy</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Enable if Nginx, Caddy, or another proxy sits in front. Makes <code class="text-xs bg-neutral-200 dark:bg-neutral-700 px-1 rounded">req.ip</code> use the forwarded header so rate limiting and IP bans target the real client.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="behindReverseProxy" class="sr-only peer" aria-label="Behind a reverse proxy" <%= settings.behindReverseProxy ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Enforce HTTPS for daemon connections</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Panel contacts daemons over <code class="text-xs bg-neutral-200 dark:bg-neutral-700 px-1 rounded">https://</code>. Only enable if your daemons have TLS configured.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="enforceDaemonHttps" class="sr-only peer" aria-label="Enforce HTTPS for daemon connections" <%= settings.enforceDaemonHttps ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Require 2FA for administrators</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Admin accounts with 2FA disabled are redirected to set it up before accessing the admin panel.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="require2faForAdmins" class="sr-only peer" aria-label="Require two-factor authentication for administrators" <%= settings.require2faForAdmins ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Hash API keys at rest</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Store API keys as SHA-256 hashes in the database. <strong class="text-amber-700 dark:text-yellow-400">Enable before creating new keys — existing keys shown once.</strong></p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="hashApiKeys" class="sr-only peer" aria-label="Hash API keys at rest" <%= settings.hashApiKeys ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <!-- SMTP / Email -->
          <div class="al-card">
            <div class="relative">
              <h2 class="al-card-header">Email (SMTP)</h2>
              <button type="button" id="smtpTestBtn"
                class="absolute right-4 top-1/2 -translate-y-1/2 inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 px-3 py-1.5 text-xs font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
                <%- icon('zap', { class: 'w-3.5 h-3.5' }) %>
                Test connection
              </button>
            </div>
            <p class="text-xs text-neutral-500 px-4 pt-2">Used to send transactional email like password reset links.</p>
            <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">SMTP host</label>
                <input type="text" id="smtpHost" value="<%= settings.smtpHost || '' %>" placeholder="smtp.example.com" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Port</label>
                <input type="number" id="smtpPort" value="<%= settings.smtpPort ?? 587 %>" min="1" max="65535" class="al-input w-full sm:w-48">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Username</label>
                <input type="text" id="smtpUser" value="<%= settings.smtpUser || '' %>" placeholder="apikey" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Password</label>
                <div class="relative">
                  <input type="password" id="smtpPassword" value="<%= settings.smtpPassword || '' %>" placeholder="••••••••" autocomplete="off" class="al-input pr-16">
                  <button type="button" onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.textContent=i.type==='password'?'Show':'Hide';"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">Show</button>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">From address</label>
                <input type="text" id="smtpFrom" value="<%= settings.smtpFrom || '' %>" placeholder="noreply@example.com" autocomplete="off" class="al-input">
              </div>
              <div class="flex items-center justify-between sm:items-end">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Use SSL/TLS</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Implicit TLS (port 465). Off = STARTTLS (587).</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="smtpSecure" class="sr-only peer" aria-label="Use SSL/TLS" <%= settings.smtpSecure ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
            <p id="smtpTestResult" class="px-4 pb-4 text-xs hidden"></p>
          </div>

          <!-- S3 / Storage -->
          <div class="al-card">
            <div class="relative">
              <h2 class="al-card-header">Storage (S3-compatible)</h2>
              <button type="button" id="s3TestBtn"
                class="absolute right-4 top-1/2 -translate-y-1/2 inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 px-3 py-1.5 text-xs font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
                <%- icon('zap', { class: 'w-3.5 h-3.5' }) %>
                Test connection
              </button>
            </div>
            <p class="text-xs text-neutral-500 px-4 pt-2">Offload backups to any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).</p>
            <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex items-center justify-between sm:items-end sm:col-span-2">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Enable S3 backups</p>
                  <p class="text-xs text-neutral-500 mt-0.5">New backups are uploaded to the bucket and removed from the node.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="s3Enabled" class="sr-only peer" aria-label="Enable S3 backups" <%= settings.s3Enabled ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Endpoint URL</label>
                <input type="text" id="s3Endpoint" value="<%= settings.s3Endpoint || '' %>" placeholder="https://<account>.r2.cloudflarestorage.com or https://minio.local:9000" autocomplete="off" class="al-input">
                <p class="text-xs text-neutral-500 mt-1">Leave empty for AWS S3 default endpoint.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Region</label>
                <input type="text" id="s3Region" value="<%= settings.s3Region || '' %>" placeholder="us-east-1" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Bucket</label>
                <input type="text" id="s3Bucket" value="<%= settings.s3Bucket || '' %>" placeholder="airlink-backups" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Access key</label>
                <input type="text" id="s3AccessKey" value="<%= settings.s3AccessKey || '' %>" autocomplete="off" class="al-input">
              </div>
              <div>
                <label class="block text-sm font-medium text-neutral-700 dark:text-white mb-2">Secret key</label>
                <div class="relative">
                  <input type="password" id="s3SecretKey" value="<%= settings.s3SecretKey || '' %>" placeholder="••••••••" autocomplete="off" class="al-input pr-16">
                  <button type="button" onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.textContent=i.type==='password'?'Show':'Hide';"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">Show</button>
                </div>
              </div>
              <div class="flex items-center justify-between sm:items-end sm:col-span-2">
                <div>
                  <p class="text-sm font-medium text-neutral-700 dark:text-white">Path-style URLs</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Required for MinIO and most self-hosted S3 servers.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
                  <input type="checkbox" id="s3PathStyle" class="sr-only peer" aria-label="Use path-style URLs" <%= settings.s3PathStyle ? 'checked' : '' %>>
                  <div class="al-toggle-track">
                    <div class="al-toggle-dot"></div>
                  </div>
                </label>
              </div>
            </div>
            <p id="s3TestResult" class="px-4 pb-4 text-xs hidden"></p>
          </div>

          <!-- IP banning -->
          <div class="al-card">
            <h2 class="al-card-header">IP banning</h2>
            <div class="p-4">
              <label for="banIpInput" class="text-xs font-medium mb-2 block" style="color:var(--theme-text-muted)">IP Address</label>
              <div class="flex gap-3 mb-4">
                <input type="text" id="banIpInput" placeholder="192.168.1.1" aria-describedby="banIpHint"
                  class="al-input flex-1 max-w-xs">
                <button type="button" id="banIpBtn" class="al-btn-danger"><%- icon('ban', { class: 'size-4', strokeWidth: 1.5 }) %>Ban IP</button>
              </div>
              <p id="banIpHint" class="text-xs mb-4" style="color:var(--theme-text-muted)">Enter the IP address you want to ban from accessing the panel.</p>
              <div id="bannedIpList" class="space-y-2">
                <% let banned = []; try { banned = JSON.parse(settings.bannedIps || '[]'); } catch (e) { /* ignore malformed JSON */ } %>
                <% if (banned.length === 0) { %>
                <p class="text-sm" style="color:var(--theme-text-muted)">No banned IPs.</p>
                <% } else { %>
                <% banned.forEach(function(ip) { %>
                <div class="flex items-center justify-between rounded-xl bg-neutral-100 dark:bg-neutral-800/40 border border-neutral-200 dark:border-white/5 px-4 py-2.5">
                  <span class="text-sm font-mono text-neutral-700 dark:text-neutral-300"><%= ip %></span>
                  <button type="button" class="unban-btn text-xs text-red-500 hover:text-red-700 dark:hover:text-red-400 transition inline-flex items-center gap-1.5" data-ip="<%= ip %>"><%- icon('shield-check', { class: 'size-3', strokeWidth: 1.5 }) %>Unban</button>
                </div>
                <% }); } %>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</main>


<script nonce="<%- nonce %>" src="/javascript/admin/admin-settings.js?v=6"></script>

<%- include('../../components/footer') %>
