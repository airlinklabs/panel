<%- include('../../layouts/admin', { title: t('adminSettingsTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('settings') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('adminSettingsTitle') %></h1>
    <p class="al-page-desc"><%= t('adminSettingsText') %></p>
  </div>
  <div>
    <span id="autosave-indicator" class="text-xs font-medium transition-opacity duration-300 opacity-0" style="color:var(--theme-success);"><%= t('settingsSaved') %></span>
    <button type="button" onclick="saveActiveTab()" class="al-btn-primary">
      <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %>
      <span><%= t('saveChanges') %></span>
    </button>
  </div>
</div>

<div class="al-page-body" data-al-tabs data-tabs-default="appearance" data-tabs-hash>

  <!-- Tab bar -->
  <div role="tablist" class="flex gap-1 mb-6 flex-wrap">
    <button type="button" role="tab" aria-selected="true" aria-controls="panel-appearance" id="tab-appearance" data-tab="appearance" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('palette', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('theme') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-servers" id="tab-servers" data-tab="servers" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('server', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('navServers') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-security" id="tab-security" data-tab="security" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('shield', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('securityTitle') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-features" id="tab-features" data-tab="features" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('toggle-left', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('features') %></button>
  </div>

  <!-- ── APPEARANCE ──────────────────────────────────────────────────── -->
  <div id="panel-appearance" role="tabpanel" aria-labelledby="tab-appearance" data-tab-panel="appearance" class="tab-panel space-y-5">
    <form id="form-appearance" enctype="multipart/form-data" class="space-y-5">

    <!-- Branding -->
    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('siteTitle') %></p>
      </div>
      <div class="al-card-body grid grid-cols-1 sm:grid-cols-3 gap-5">
        <%- include('../../partials/ui/form-field', {
          type: 'text', name: 'title', id: 'setting-title',
          label: t('siteTitleLabel'), value: settings.title || ''
        }) %>

        <div class="al-form-field">
          <label for="logo-input" class="al-form-label"><%= t('logoLabel') %></label>
          <div class="flex items-center gap-2">
            <button type="button" onclick="openUploadModal({ title: '<%= t('uploadLogo') %>', accept: 'image/*', onFile: function(f) { document.getElementById('logo-input')._selectedFile = f; document.getElementById('logo-label-name').textContent = f.name; document.getElementById('logo-clear').classList.remove('hidden'); }})" class="al-btn-secondary al-btn-sm">
              <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= t('chooseFile') %></span>
            </button>
            <span id="logo-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
            <button type="button" id="logo-clear" class="hidden al-btn-ghost al-btn-icon-only" style="color:var(--theme-text-muted);" aria-label="<%= t('clearFile') %>" onclick="document.getElementById('logo-input')._selectedFile=null;document.getElementById('logo-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
              <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
            </button>
          </div>
          <input type="file" id="logo-input" name="logo" accept="image/*" class="hidden">
          <% if (settings.logo) { %>
          <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="<%= t('logoAlt') %>" class="h-8 mt-2 object-contain">
          <% } %>
        </div>

        <div class="al-form-field">
          <label for="favicon-input" class="al-form-label"><%= t('faviconLabel') %></label>
          <div class="flex items-center gap-2">
            <button type="button" onclick="openUploadModal({ title: '<%= t('uploadFavicon') %>', accept: '.ico,.png,.jpg,.jpeg', onFile: function(f) { document.getElementById('favicon-input')._selectedFile = f; document.getElementById('favicon-label-name').textContent = f.name; document.getElementById('favicon-clear').classList.remove('hidden'); }})" class="al-btn-secondary al-btn-sm">
              <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= t('chooseFile') %></span>
            </button>
            <span id="favicon-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
            <button type="button" id="favicon-clear" class="hidden al-btn-ghost al-btn-icon-only" style="color:var(--theme-text-muted);" aria-label="<%= t('clearFile') %>" onclick="document.getElementById('favicon-input')._selectedFile=null;document.getElementById('favicon-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
              <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
            </button>
          </div>
          <input type="file" id="favicon-input" name="favicon" accept=".ico,.png,.jpg,.jpeg" class="hidden">
          <p class="al-form-help"><%= t('faviconHint') %></p>
        </div>
      </div>
    </div>

    <!-- Themes -->
    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('theme') %></p>
          <p class="al-card-header-desc"><%= t('themeDesc') %></p>
        </div>
      </div>
      <div class="al-card-body">
        <div class="space-y-3">
          <% const themeVal = settings.theme || 'dark'; %>
          <label class="al-setting-row cursor-pointer <%= themeVal === 'light' ? 'al-radio-active' : '' %>">
            <input type="radio" name="theme" value="light" class="sr-only" <%= themeVal === 'light' ? 'checked' : '' %>>
            <span class="al-setting-copy flex items-center gap-3">
              <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= themeVal === 'light' ? 'al-radio-ring-active' : '' %>" style="<%= themeVal !== 'light' ? 'border-color:var(--theme-border)' : '' %>">
                <% if (themeVal === 'light') { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
              </span>
              <span class="al-setting-title"><%= t('lightMode') %></span>
            </span>
            <span class="al-setting-control"><span class="al-chip"><%= t('builtIn') %></span></span>
          </label>
          <label class="al-setting-row cursor-pointer <%= themeVal === 'dark' ? 'al-radio-active' : '' %>">
            <input type="radio" name="theme" value="dark" class="sr-only" <%= themeVal === 'dark' ? 'checked' : '' %>>
            <span class="al-setting-copy flex items-center gap-3">
              <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= themeVal === 'dark' ? 'al-radio-ring-active' : '' %>" style="<%= themeVal !== 'dark' ? 'border-color:var(--theme-border)' : '' %>">
                <% if (themeVal === 'dark') { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
              </span>
              <span class="al-setting-title"><%= t('darkMode') %></span>
            </span>
            <span class="al-setting-control"><span class="al-chip"><%= t('builtIn') %></span></span>
          </label>
        </div>

        <div class="al-panel mt-5">
          <div class="al-panel-head">
            <div class="min-w-0">
              <p class="al-setting-title"><%= t('uploadCustomTheme') %></p>
              <p class="al-form-help mt-1"><%= t('themeFileHint') %></p>
            </div>
            <a href="/admin/settings/example-theme" class="al-btn-link al-btn-sm shrink-0"><span><%= t('downloadExample') %></span></a>
          </div>
          <div class="al-form-field mt-4">
            <label for="theme-file-input" class="al-form-label"><%= t('uploadThemeFile') %></label>
            <div class="flex items-center gap-2">
              <button type="button" onclick="openUploadModal({ title: '<%= t('uploadCustomTheme') %>', accept: '.zip', onFile: function(f) { document.getElementById('theme-file-input')._selectedFile = f; document.getElementById('theme-label-name').textContent = f.name; document.getElementById('theme-clear').classList.remove('hidden'); }})" class="al-btn-secondary al-btn-sm">
                <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= t('chooseFile') %></span>
              </button>
              <span id="theme-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
              <button type="button" id="theme-clear" class="hidden al-btn-ghost al-btn-icon-only" style="color:var(--theme-text-muted);" aria-label="<%= t('clearFile') %>" onclick="document.getElementById('theme-file-input')._selectedFile=null;document.getElementById('theme-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
                <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
              </button>
            </div>
            <input type="file" id="theme-file-input" name="themeFile" accept=".zip" class="hidden">
          </div>
        </div>
      </div>
    </div>

    <!-- Auth page wallpapers -->
    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('authPageWallpapers') %></p>
          <p class="al-card-header-desc"><%= t('authWallpaperDesc') %></p>
        </div>
      </div>
      <div class="al-card-body grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <p class="al-setting-title mb-3"><%= t('loginTitle') %></p>
          <% if (settings.loginWallpaper) { %>
           <img src="<%= settings.loginWallpaper %>" alt="<%= t('loginWallpaperAlt') %>" class="h-20 w-full object-cover rounded-xl mb-3">
          <% } %>
          <div class="al-form-field">
            <label for="login-wallpaper-file" class="al-form-label"><%= t('uploadFile') %></label>
            <div class="flex items-center gap-2">
              <button type="button" onclick="openUploadModal({ title: '<%= t('loginTitle') %>', accept: 'image/*', onFile: function(f) { document.getElementById('login-wallpaper-file')._selectedFile = f; document.getElementById('login-wp-label-name').textContent = f.name; document.getElementById('login-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary al-btn-sm">
                <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= t('chooseFile') %></span>
              </button>
              <span id="login-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
              <button type="button" id="login-wp-clear" class="hidden al-btn-ghost al-btn-icon-only" style="color:var(--theme-text-muted);" aria-label="<%= t('clearFile') %>" onclick="document.getElementById('login-wallpaper-file')._selectedFile=null;document.getElementById('login-wp-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
                <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
              </button>
            </div>
            <input type="file" id="login-wallpaper-file" name="loginWallpaperFile" accept="image/*" class="hidden">
          </div>
          <%- include('../../partials/ui/form-field', {
            type: 'text', name: 'loginWallpaperUrl', id: 'login-wallpaper-url',
            label: t('orPasteUrl'), placeholder: t('imageUrlPlaceholder'), cls: 'mt-4',
            value: (settings.loginWallpaper && settings.loginWallpaper.startsWith('http')) ? settings.loginWallpaper : ''
          }) %>
        </div>
        <div>
          <p class="al-setting-title mb-3"><%= t('registerTitle') %></p>
          <% if (settings.registerWallpaper) { %>
           <img src="<%= settings.registerWallpaper %>" alt="<%= t('registerWallpaperAlt') %>" class="h-20 w-full object-cover rounded-xl mb-3">
          <% } %>
          <div class="al-form-field">
            <label for="register-wallpaper-file" class="al-form-label"><%= t('uploadFile') %></label>
            <div class="flex items-center gap-2">
              <button type="button" onclick="openUploadModal({ title: '<%= t('registerTitle') %>', accept: 'image/*', onFile: function(f) { document.getElementById('register-wallpaper-file')._selectedFile = f; document.getElementById('register-wp-label-name').textContent = f.name; document.getElementById('register-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary al-btn-sm">
                <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= t('chooseFile') %></span>
              </button>
              <span id="register-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
              <button type="button" id="register-wp-clear" class="hidden al-btn-ghost al-btn-icon-only" style="color:var(--theme-text-muted);" aria-label="<%= t('clearFile') %>" onclick="document.getElementById('register-wallpaper-file')._selectedFile=null;document.getElementById('register-wp-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
                <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
              </button>
            </div>
            <input type="file" id="register-wallpaper-file" name="registerWallpaperFile" accept="image/*" class="hidden">
          </div>
          <%- include('../../partials/ui/form-field', {
            type: 'text', name: 'registerWallpaperUrl', id: 'register-wallpaper-url',
            label: t('orPasteUrl'), placeholder: t('imageUrlPlaceholder'), cls: 'mt-4',
            value: (settings.registerWallpaper && settings.registerWallpaper.startsWith('http')) ? settings.registerWallpaper : ''
          }) %>
        </div>
      </div>
    </div>

    <!-- Panel wallpaper -->
    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('panelWallpaper') %></p>
          <p class="al-card-header-desc"><%= t('panelWallpaperDesc') %></p>
        </div>
      </div>
      <div class="al-card-body">
        <% if (settings.panelWallpaper) { %>
         <img src="<%= settings.panelWallpaper %>" alt="<%= t('panelWallpaperAlt') %>" class="h-20 w-full object-cover rounded-xl mb-3">
        <% } %>
        <div class="al-form-field">
          <label for="panel-wallpaper-file" class="al-form-label"><%= t('uploadFile') %></label>
          <div class="flex items-center gap-2">
            <button type="button" onclick="openUploadModal({ title: '<%= t('panelWallpaper') %>', accept: 'image/*', onFile: function(f) { document.getElementById('panel-wallpaper-file')._selectedFile = f; document.getElementById('panel-wp-label-name').textContent = f.name; document.getElementById('panel-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary al-btn-sm">
              <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= t('chooseFile') %></span>
            </button>
            <span id="panel-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
            <button type="button" id="panel-wp-clear" class="hidden al-btn-ghost al-btn-icon-only" style="color:var(--theme-text-muted);" aria-label="<%= t('clearFile') %>" onclick="document.getElementById('panel-wallpaper-file')._selectedFile=null;document.getElementById('panel-wp-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
              <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
            </button>
          </div>
          <input type="file" id="panel-wallpaper-file" name="panelWallpaperFile" accept="image/*" class="hidden">
        </div>
        <%- include('../../partials/ui/form-field', {
          type: 'text', name: 'panelWallpaperUrl', id: 'panel-wallpaper-url',
          label: t('orPasteUrl'), placeholder: t('imageUrlPlaceholder'), cls: 'mt-4',
          value: (settings.panelWallpaper && settings.panelWallpaper.startsWith('http')) ? settings.panelWallpaper : ''
        }) %>
      </div>
    </div>

    </form>
  </div>

  <!-- ── SERVERS ─────────────────────────────────────────────────────── -->
  <div id="panel-servers" role="tabpanel" aria-labelledby="tab-servers" data-tab-panel="servers" class="tab-panel space-y-5" hidden>

    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('navServers') %></p>
      </div>
      <div class="al-card-body">
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('allowCreateServers') %></p>
            <p class="al-setting-desc"><%= t('allowCreateServersDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="allowUserCreateServer" class="sr-only peer" aria-label="<%= t('allowCreateServers') %>" <%= settings.allowUserCreateServer ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('allowDeleteServers') %></p>
            <p class="al-setting-desc"><%= t('allowDeleteServersDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="allowUserDeleteServer" class="sr-only peer" aria-label="<%= t('allowDeleteServers') %>" <%= settings.allowUserDeleteServer ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('allowSubmitImages') %></p>
            <p class="al-setting-desc"><%= t('allowSubmitImagesDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="allowUserCreateImages" class="sr-only peer" aria-label="<%= t('allowSubmitImages') %>" <%= settings.allowUserCreateImages ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
      </div>
    </div>

    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('uploadLimit') %></p>
      </div>
      <div class="al-card-body">
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'uploadLimit', id: 'uploadLimitInput',
          label: t('uploadLimitLabel') + ' <span class="font-normal" style="color:var(--theme-text-muted)">(MB)</span>',
          value: settings.uploadLimit, min: '1', max: '10000',
          wrapperCls: 'max-w-xs', helpText: t('uploadLimitDesc')
        }) %>
      </div>
    </div>

    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('defaultLimits') %></p>
          <p class="al-card-header-desc"><%= t('defaultLimitsDesc') %></p>
        </div>
      </div>
      <div class="al-card-body grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'defaultServerLimit', id: 'defaultServerLimit',
          label: t('defaultServerLimit'), value: settings.defaultServerLimit, min: '0', max: '100',
          helpText: t('defaultCannotCreate')
        }) %>
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'defaultMaxMemory', id: 'defaultMaxMemory',
          label: t('defaultMaxMemory'), value: settings.defaultMaxMemory, min: '1'
        }) %>
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'defaultMaxCpu', id: 'defaultMaxCpu',
          label: t('defaultMaxCpu') + ' <span class="font-normal" style="color:var(--theme-text-muted)">(%)</span>',
          value: settings.defaultMaxCpu, min: '50', max: '10000'
        }) %>
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'defaultMaxStorage', id: 'defaultMaxStorage',
          label: t('defaultMaxStorage'), value: settings.defaultMaxStorage, min: '1'
        }) %>
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'defaultMaxDatabases', id: 'defaultMaxDatabases',
          label: t('defaultMaxDatabases'), value: settings.defaultMaxDatabases, min: '0', max: '100000',
          helpText: t('defaultUnlimited')
        }) %>
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'defaultOverallocateMemory', id: 'defaultOverallocateMemory',
          label: t('defaultOverallocMemory'), value: settings.defaultOverallocateMemory, min: '0', max: '10000'
        }) %>
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'defaultOverallocateDisk', id: 'defaultOverallocateDisk',
          label: t('defaultOverallocDisk'), value: settings.defaultOverallocateDisk, min: '0', max: '10000'
        }) %>
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'defaultOverallocateCpu', id: 'defaultOverallocateCpu',
          label: t('defaultOverallocCpu'), value: settings.defaultOverallocateCpu, min: '0', max: '10000',
          helpText: t('appliedToNewNodes')
        }) %>
      </div>
    </div>

  </div>

  <!-- ── SECURITY ────────────────────────────────────────────────────── -->
  <div id="panel-security" role="tabpanel" aria-labelledby="tab-security" data-tab-panel="security" class="tab-panel space-y-5" hidden>

    <!-- Registration -->
    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('securityTitle') %></p>
      </div>
      <div class="al-card-body">
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('allowPublicRegistration') %></p>
            <p class="al-setting-desc"><%= t('allowPublicRegistrationDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="allowRegistration" class="sr-only peer" aria-label="<%= t('allowPublicRegistration') %>" <%= settings.allowRegistration ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
      </div>
    </div>

    <!-- VirusTotal -->
    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('virusTotalTitle') %></p>
          <p class="al-card-header-desc"><%= t('virusTotalScanHint') %></p>
        </div>
      </div>
      <div class="al-card-body">
        <div class="al-form-field max-w-sm">
          <label for="vtKeyInput" class="al-form-label"><%= t('virusTotalApiKey') %></label>
          <div class="flex items-center gap-2">
            <input type="password" id="vtKeyInput" value="<%= settings.virusTotalApiKey || '' %>" placeholder="<%= t('fieldPasteKey') %>" autocomplete="off" class="al-form-input flex-1 min-w-0 font-mono">
            <button type="button" class="al-btn-secondary al-btn-sm shrink-0" onclick="var inp=document.getElementById('vtKeyInput');var btn=this;if(inp.type==='password'){inp.type='text';btn.textContent='<%= t('hide') %>';}else{inp.type='password';btn.textContent='<%= t('show') %>';}"><%= t('show') %></button>
          </div>
