<%- include('../../layouts/admin', { title: t('adminSettingsTitle') }) %>

<%- include('../../partials/flash-messages') %>

<%- include('../../partials/ui/breadcrumb', { items: [
  { label: t('admin'), url: '/admin' },
  { label: t('settings') }
] }) %>

<div class="al-page-header flex items-start justify-between gap-4">
  <div>
    <h1 class="al-page-title"><%= t('adminSettingsTitle') %></h1>
    <p class="al-page-desc"><%= t('adminSettingsText') %></p>
  </div>
  <div class="flex gap-2 shrink-0 items-center">
    <span id="autosave-indicator" class="text-xs font-medium transition-opacity duration-300 opacity-0" style="color:var(--theme-success);"><%= t('settingsSaved') %></span>
    <button type="button" onclick="saveActiveTab()" class="al-btn-primary inline-flex items-center gap-1.5">
      <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %>
      <%= t('saveChanges') %>
    </button>
  </div>
</div>

<div class="al-page-body" data-al-tabs data-tabs-default="appearance" data-tabs-hash>

  <!-- Tab bar -->
  <div role="tablist" class="flex gap-1 mb-6">
    <button type="button" role="tab" aria-selected="true" aria-controls="panel-appearance" id="tab-appearance" data-tab="appearance" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('palette', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('theme') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-servers" id="tab-servers" data-tab="servers" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('server', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('navServers') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-security" id="tab-security" data-tab="security" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('shield', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('securityTitle') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-features" id="tab-features" data-tab="features" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('toggle-left', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('features') %></button>
  </div>

  <!-- ── APPEARANCE ──────────────────────────────────────────────────── -->
  <div id="panel-appearance" role="tabpanel" aria-labelledby="tab-appearance" data-tab-panel="appearance" class="tab-panel space-y-5">
    <form id="form-appearance" enctype="multipart/form-data" class="space-y-6">

    <!-- Branding -->
    <div class="al-card">
      <h2 class="al-card-header"><%= t('siteTitle') %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 p-4">
        <div>
          <label for="setting-title" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('siteTitleLabel') %></label>
          input id="setting-title" type="text" name="title" value="<%= settings.title %>" class="al-input">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('logoLabel') %></label>
          <div class="flex items-center gap-2">
            <button type="button" onclick="openUploadModal({ title: '<%= t('uploadLogo') %>', accept: 'image/*', onFile: function(f) { document.getElementById('logo-input')._selectedFile = f; document.getElementById('logo-label-name').textContent = f.name; document.getElementById('logo-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
              <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('chooseFile') %>
            </button>
            <span id="logo-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
            <button type="button" id="logo-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('logo-input')._selectedFile=null;document.getElementById('logo-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
              <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
            </button>
          </div>
          <input type="file" id="logo-input" name="logo" accept="image/*" class="hidden">
          <% if (settings.logo) { %>
          <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="<%= t('logoAlt') %>" class="h-8 mt-2 object-contain">
          <% } %>
        </div>
        <div>
          <label class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('faviconLabel') %></label>
          <div class="flex items-center gap-2">
            <button type="button" onclick="openUploadModal({ title: '<%= t('uploadFavicon') %>', accept: '.ico,.png,.jpg,.jpeg', onFile: function(f) { document.getElementById('favicon-input')._selectedFile = f; document.getElementById('favicon-label-name').textContent = f.name; document.getElementById('favicon-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
              <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('chooseFile') %>
            </button>
            <span id="favicon-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
            <button type="button" id="favicon-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('favicon-input')._selectedFile=null;document.getElementById('favicon-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
              <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
            </button>
          </div>
          <input type="file" id="favicon-input" name="favicon" accept=".ico,.png,.jpg,.jpeg" class="hidden">
          <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('faviconHint') %></p>
        </div>
      </div>
    </div>

    <!-- Themes -->
    <div class="al-card">
      <h2 class="al-card-header"><%= t('theme') %></h2>
      <p class="text-xs px-5 pt-2 pb-0" style="color:var(--theme-text-muted)"><%= t('themeDesc') %></p>
      <div class="p-4">
        <div class="space-y-2">
          <% const themeVal = settings.theme || 'dark'; %>
          <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= themeVal === 'light' ? 'al-radio-active' : 'hover:border-[var(--theme-border)]' %>" style="<%= themeVal !== 'light' ? 'border-color:var(--theme-border)' : '' %>">
            <input type="radio" name="theme" value="light" class="sr-only" <%= themeVal === 'light' ? 'checked' : '' %>>
            <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= themeVal === 'light' ? 'al-radio-ring-active' : '' %>" style="<%= themeVal !== 'light' ? 'border-color:var(--theme-border)' : '' %>">
              <% if (themeVal === 'light') { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
            </span>
            <p class="text-sm flex-1" style="color:var(--theme-text)"><%= t('lightMode') %></p>
            <span class="text-xs" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px"><%= t('builtIn') %></span>
          </label>
          <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition <%= themeVal === 'dark' ? 'al-radio-active' : 'hover:border-[var(--theme-border)]' %>" style="<%= themeVal !== 'dark' ? 'border-color:var(--theme-border)' : '' %>">
            <input type="radio" name="theme" value="dark" class="sr-only" <%= themeVal === 'dark' ? 'checked' : '' %>>
            <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 <%= themeVal === 'dark' ? 'al-radio-ring-active' : '' %>" style="<%= themeVal !== 'dark' ? 'border-color:var(--theme-border)' : '' %>">
              <% if (themeVal === 'dark') { %><span class="w-2.5 h-2.5 rounded-full al-radio-dot-active"></span><% } %>
            </span>
            <p class="text-sm flex-1" style="color:var(--theme-text)"><%= t('darkMode') %></p>
            <span class="text-xs" style="color:var(--theme-text-muted);background:var(--theme-bg-secondary);padding:0.125rem 0.5rem;border-radius:9999px"><%= t('builtIn') %></span>
          </label>
        </div>
      </div>
      <div class="p-5" style="border-top:1px solid var(--theme-border)">
        <div class="flex items-center justify-between mb-2">
          <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('uploadCustomTheme') %></p>
          <a href="/admin/settings/example-theme" class="text-xs hover:text-[var(--theme-text)] transition" style="color:var(--theme-text-muted)"><%= t('downloadExample') %></a>
        </div>
        <p class="text-xs mb-3" style="color:var(--theme-text-muted)"><%= t('themeFileHint') %></p>
        <label class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= t('uploadThemeFile') %></label>
        <div class="flex items-center gap-2">
          <button type="button" onclick="openUploadModal({ title: '<%= t('uploadCustomTheme') %>', accept: '.zip', onFile: function(f) { document.getElementById('theme-file-input')._selectedFile = f; document.getElementById('theme-label-name').textContent = f.name; document.getElementById('theme-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
            <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('chooseFile') %>
          </button>
          <span id="theme-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
          <button type="button" id="theme-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('theme-file-input')._selectedFile=null;document.getElementById('theme-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
            <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
          </button>
        </div>
        <input type="file" id="theme-file-input" name="themeFile" accept=".zip" class="hidden">
      </div>
    </div>

    <!-- Auth page wallpapers -->
    <div class="al-card">
      <h2 class="al-card-header"><%= t('authPageWallpapers') %></h2>
      <p class="text-xs px-5 pt-2 pb-0" style="color:var(--theme-text-muted)"><%= t('authWallpaperDesc') %></p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-4">
        <div>
          <p class="text-sm font-medium mb-3" style="color:var(--theme-text-strong)"><%= t('login') %></p>
          <% if (settings.loginWallpaper) { %>
           <img src="<%= settings.loginWallpaper %>" alt="Login wallpaper" class="h-20 w-full object-cover rounded-xl mb-3" style="border-color:var(--theme-border)">
          <% } %>
          <label class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= t('uploadFile') %></label>
          <div class="flex items-center gap-2 mb-2">
            <button type="button" onclick="openUploadModal({ title: '<%= t('login') %>', accept: 'image/*', onFile: function(f) { document.getElementById('login-wallpaper-file')._selectedFile = f; document.getElementById('login-wp-label-name').textContent = f.name; document.getElementById('login-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
              <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('chooseFile') %>
            </button>
            <span id="login-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
            <button type="button" id="login-wp-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('login-wallpaper-file')._selectedFile=null;document.getElementById('login-wp-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
              <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
            </button>
          </div>
          <input type="file" id="login-wallpaper-file" name="loginWallpaperFile" accept="image/*" class="hidden">
          <label for="login-wallpaper-url" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= t('orPasteUrl') %></label>
          <input type="text" id="login-wallpaper-url" name="loginWallpaperUrl" placeholder="https://..."
            value="<%= (settings.loginWallpaper && settings.loginWallpaper.startsWith('http')) ? settings.loginWallpaper : '' %>"
            class="al-input">
        </div>
        <div>
          <p class="text-sm font-medium mb-3" style="color:var(--theme-text-strong)"><%= t('register') %></p>
          <% if (settings.registerWallpaper) { %>
           <img src="<%= settings.registerWallpaper %>" alt="Register wallpaper" class="h-20 w-full object-cover rounded-xl mb-3" style="border-color:var(--theme-border)">
          <% } %>
          <label class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= t('uploadFile') %></label>
          <div class="flex items-center gap-2 mb-2">
            <button type="button" onclick="openUploadModal({ title: '<%= t('register') %>', accept: 'image/*', onFile: function(f) { document.getElementById('register-wallpaper-file')._selectedFile = f; document.getElementById('register-wp-label-name').textContent = f.name; document.getElementById('register-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
              <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('chooseFile') %>
            </button>
            <span id="register-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
            <button type="button" id="register-wp-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('register-wallpaper-file')._selectedFile=null;document.getElementById('register-wp-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
              <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
            </button>
          </div>
          <input type="file" id="register-wallpaper-file" name="registerWallpaperFile" accept="image/*" class="hidden">
          <label for="register-wallpaper-url" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= t('orPasteUrl') %></label>
          <input type="text" id="register-wallpaper-url" name="registerWallpaperUrl" placeholder="https://..."
            value="<%= (settings.registerWallpaper && settings.registerWallpaper.startsWith('http')) ? settings.registerWallpaper : '' %>"
            class="al-input">
        </div>
      </div>
    </div>

    <!-- Panel wallpaper -->
    <div class="al-card">
      <h2 class="al-card-header"><%= t('panelWallpaper') %></h2>
      <p class="text-xs px-5 pt-2 pb-0" style="color:var(--theme-text-muted)"><%= t('panelWallpaperDesc') %></p>
      <div class="p-4">
        <% if (settings.panelWallpaper) { %>
         <img src="<%= settings.panelWallpaper %>" alt="Panel wallpaper" class="h-20 w-full object-cover rounded-xl mb-3" style="border-color:var(--theme-border)">
        <% } %>
        <label class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= t('uploadFile') %></label>
        <div class="flex items-center gap-2 mb-2">
          <button type="button" onclick="openUploadModal({ title: '<%= t('panelWallpaper') %>', accept: 'image/*', onFile: function(f) { document.getElementById('panel-wallpaper-file')._selectedFile = f; document.getElementById('panel-wp-label-name').textContent = f.name; document.getElementById('panel-wp-clear').classList.remove('hidden'); }})" class="al-btn-secondary text-xs px-3 py-2 inline-flex items-center gap-1.5">
            <%- icon('upload', { class: 'size-3.5', strokeWidth: 1.5 }) %><%= t('chooseFile') %>
          </button>
          <span id="panel-wp-label-name" class="text-xs truncate max-w-[120px]" style="color:var(--theme-text-muted);"><%= t('noFileChosen') %></span>
          <button type="button" id="panel-wp-clear" class="hidden w-6 h-6 rounded flex items-center justify-center hover:opacity-75" style="color:var(--theme-text-muted);" onclick="document.getElementById('panel-wallpaper-file')._selectedFile=null;document.getElementById('panel-wp-label-name').textContent='<%= t('noFileChosen') %>';this.classList.add('hidden')">
            <%- icon('x', { class: 'size-3', strokeWidth: 2 }) %>
          </button>
        </div>
        <input type="file" id="panel-wallpaper-file" name="panelWallpaperFile" accept="image/*" class="hidden">
        <label for="panel-wallpaper-url" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted)"><%= t('orPasteUrl') %></label>
        <input type="text" id="panel-wallpaper-url" name="panelWallpaperUrl" placeholder="https://..."
          value="<%= (settings.panelWallpaper && settings.panelWallpaper.startsWith('http')) ? settings.panelWallpaper : '' %>"
          class="al-input">
      </div>
    </div>

    </form>
  </div>

  <!-- ── SERVERS ─────────────────────────────────────────────────────── -->
  <div id="panel-servers" role="tabpanel" aria-labelledby="tab-servers" data-tab-panel="servers" class="tab-panel space-y-5" hidden>

    <div class="al-card">
      <h2 class="al-card-header"><%= t('navServers') %></h2>
      <div class="p-4 space-y-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('allowCreateServers') %></p>
            <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('allowCreateServersDesc') %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="allowUserCreateServer" class="sr-only peer" aria-label="<%= t('allowCreateServers') %>" <%= settings.allowUserCreateServer ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('allowDeleteServers') %></p>
            <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('allowDeleteServersDesc') %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="allowUserDeleteServer" class="sr-only peer" aria-label="<%= t('allowDeleteServers') %>" <%= settings.allowUserDeleteServer ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('allowSubmitImages') %></p>
            <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('allowSubmitImagesDesc') %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="allowUserCreateImages" class="sr-only peer" aria-label="<%= t('allowSubmitImages') %>" <%= settings.allowUserCreateImages ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
      </div>
    </div>

    <div class="al-card">
      <h2 class="al-card-header"><%= t('uploadLimit') %></h2>
      <div class="p-4">
        <label for="uploadLimitInput" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('uploadLimitLabel') %> <span class="font-normal" style="color:var(--theme-text-muted)">(MB)</span></label>
        <div class="relative max-w-xs">
          <input type="number" id="uploadLimitInput" value="<%= settings.uploadLimit %>" min="1" max="10000" class="al-input pr-12">
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs pointer-events-none" style="color:var(--theme-text-muted)">MB</span>
        </div>
        <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)"><%= t('uploadLimitDesc') %></p>
      </div>
    </div>

    <div class="al-card">
      <h2 class="al-card-header"><%= t('defaultLimits') %></h2>
      <p class="text-xs px-5 pt-3" style="color:var(--theme-text-muted)"><%= t('defaultLimitsDesc') %></p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-4">
        <div>
          <label for="defaultServerLimit" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultServerLimit') %></label>
          <input type="number" id="defaultServerLimit" value="<%= settings.defaultServerLimit %>" min="0" max="100" class="al-input">
          <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('defaultCannotCreate') %></p>
        </div>
        <div>
          <label for="defaultMaxMemory" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultMaxMemory') %></label>
          <input type="number" id="defaultMaxMemory" value="<%= settings.defaultMaxMemory %>" min="1" class="al-input">
        </div>
        <div>
          <label for="defaultMaxCpu" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultMaxCpu') %> <span class="font-normal" style="color:var(--theme-text-muted)">(%)</span></label>
          <input type="number" id="defaultMaxCpu" value="<%= settings.defaultMaxCpu %>" min="50" max="10000" class="al-input">
        </div>
        <div>
          <label for="defaultMaxStorage" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultMaxStorage') %></label>
          <input type="number" id="defaultMaxStorage" value="<%= settings.defaultMaxStorage %>" min="1" class="al-input">
        </div>
        <div>
          <label for="defaultMaxDatabases" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultMaxDatabases') %></label>
          <input type="number" id="defaultMaxDatabases" value="<%= settings.defaultMaxDatabases %>" min="0" max="100000" class="al-input">
          <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('defaultUnlimited') %></p>
        </div>
        <div>
          <label for="defaultOverallocateMemory" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultOverallocMemory') %></label>
          <input type="number" id="defaultOverallocateMemory" value="<%= settings.defaultOverallocateMemory %>" min="0" max="10000" class="al-input">
        </div>
        <div>
          <label for="defaultOverallocateDisk" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultOverallocDisk') %></label>
          <input type="number" id="defaultOverallocateDisk" value="<%= settings.defaultOverallocateDisk %>" min="0" max="10000" class="al-input">
        </div>
        <div>
          <label for="defaultOverallocateCpu" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%= t('defaultOverallocCpu') %></label>
          <input type="number" id="defaultOverallocateCpu" value="<%= settings.defaultOverallocateCpu %>" min="0" max="10000" class="al-input">
          <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('appliedToNewNodes') %></p>
        </div>
      </div>
    </div>

  </div>

