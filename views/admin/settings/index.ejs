<script nonce="<%- nonce %>">
(function() {
  var csrfToken = '<%= csrfToken %>';
  var msgSettingsSaved = <%- JSON.stringify(t('settingsSaved')) %>;
  var msgSaveFailed = <%- JSON.stringify(t('settingsSaveFailed')) %>;
  var msgSmtpOk = <%- JSON.stringify(t('smtpTestOk')) %>;
  var msgSmtpFail = <%- JSON.stringify(t('smtpTestFail')) %>;
  var msgSmtpError = <%- JSON.stringify(t('smtpTestError')) %>;
  var msgS3Ok = <%- JSON.stringify(t('s3TestOk')) %>;
  var msgS3Fail = <%- JSON.stringify(t('s3TestFail')) %>;
  var msgS3Error = <%- JSON.stringify(t('s3TestError')) %>;
  var msgBanFailed = <%- JSON.stringify(t('banIpFailed')) %>;
  var msgUnbanFailed = <%- JSON.stringify(t('unbanIpFailed')) %>;

  function collectSettings() {
    return {
      title: document.querySelector('[name="title"]')?.value || '',
      theme: (document.querySelector('[name="theme"]:checked') || {}).value || 'dark',
      allowUserCreateServer: document.getElementById('allowUserCreateServer')?.checked || false,
      allowUserDeleteServer: document.getElementById('allowUserDeleteServer')?.checked || false,
      allowUserCreateImages: document.getElementById('allowUserCreateImages')?.checked || false,
      uploadLimit: parseInt(document.getElementById('uploadLimitInput')?.value || '10', 10),
      defaultServerLimit: parseInt(document.getElementById('defaultServerLimit')?.value || '0', 10),
      defaultMaxMemory: parseInt(document.getElementById('defaultMaxMemory')?.value || '512', 10),
      defaultMaxCpu: parseInt(document.getElementById('defaultMaxCpu')?.value || '100', 10),
      defaultMaxStorage: parseInt(document.getElementById('defaultMaxStorage')?.value || '10240', 10),
      defaultMaxDatabases: parseInt(document.getElementById('defaultMaxDatabases')?.value || '0', 10),
      defaultOverallocateMemory: parseInt(document.getElementById('defaultOverallocateMemory')?.value || '0', 10),
      defaultOverallocateDisk: parseInt(document.getElementById('defaultOverallocateDisk')?.value || '0', 10),
      defaultOverallocateCpu: parseInt(document.getElementById('defaultOverallocateCpu')?.value || '0', 10),
      allowRegistration: document.getElementById('allowRegistration')?.checked || false,
      virusTotalApiKey: document.getElementById('vtKeyInput')?.value || '',
      rateLimitEnabled: document.getElementById('rateLimitEnabled')?.checked || false,
      rateLimitRpm: parseInt(document.getElementById('rateLimitRpm')?.value || '60', 10),
      loginMaxAttempts: parseInt(document.getElementById('loginMaxAttempts')?.value || '5', 10),
      loginLockoutMinutes: parseInt(document.getElementById('loginLockoutMinutes')?.value || '15', 10),
      behindReverseProxy: document.getElementById('behindReverseProxy')?.checked || false,
      enforceDaemonHttps: document.getElementById('enforceDaemonHttps')?.checked || false,
      require2faForAdmins: document.getElementById('require2faForAdmins')?.checked || false,
      hashApiKeys: document.getElementById('hashApiKeys')?.checked || false,
      smtpHost: document.getElementById('smtpHost')?.value || '',
      smtpPort: parseInt(document.getElementById('smtpPort')?.value || '587', 10),
      smtpUser: document.getElementById('smtpUser')?.value || '',
      smtpPassword: document.getElementById('smtpPassword')?.value || '',
      smtpFrom: document.getElementById('smtpFrom')?.value || '',
      smtpSecure: document.getElementById('smtpSecure')?.checked || false,
      emailCooldown: parseInt(document.getElementById('emailCooldown')?.value || '30', 10),
      s3Enabled: document.getElementById('s3Enabled')?.checked || false,
      s3Endpoint: document.getElementById('s3Endpoint')?.value || '',
      s3Region: document.getElementById('s3Region')?.value || '',
      s3Bucket: document.getElementById('s3Bucket')?.value || '',
      s3AccessKey: document.getElementById('s3AccessKey')?.value || '',
      s3SecretKey: document.getElementById('s3SecretKey')?.value || '',
      s3PathStyle: document.getElementById('s3PathStyle')?.checked || false,
      twoFactorRequired: document.getElementById('twoFactorRequired')?.checked || false,
      sftpEnabled: document.getElementById('sftpEnabled')?.checked || false,
      backupsEnabled: document.getElementById('backupsEnabled')?.checked || false,
      schedulesEnabled: document.getElementById('schedulesEnabled')?.checked || false,
      databasesEnabled: document.getElementById('databasesEnabled')?.checked || false,
      fileManagerEnabled: document.getElementById('fileManagerEnabled')?.checked || false,
      consoleEnabled: document.getElementById('consoleEnabled')?.checked || false,
      playerTrackingEnabled: document.getElementById('playerTrackingEnabled')?.checked || false,
      scannerEnabled: document.getElementById('scannerEnabled')?.checked || false,
    };
  }

  window.saveActiveTab = function() {
    var data = collectSettings();
    var indicator = document.getElementById('autosave-indicator');
    fetch('/admin/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      body: JSON.stringify(data),
    }).then(function(r) { return r.json(); }).then(function(res) {
      if (res.success) {
        if (indicator) { indicator.style.opacity = '1'; setTimeout(function() { indicator.style.opacity = '0'; }, 2000); }
        showToast(msgSettingsSaved, 'success');
      } else {
        showToast(res.message || msgSaveFailed, 'error');
      }
    }).catch(function() { showToast(msgSaveFailed, 'error'); });
  };

  // SMTP test
  var smtpTestBtn = document.getElementById('smtpTestBtn');
  if (smtpTestBtn) {
    smtpTestBtn.addEventListener('click', function() {
      var resultEl = document.getElementById('smtpTestResult');
      resultEl.classList.add('hidden');
      fetch('/admin/settings/smtp/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({
          host: document.getElementById('smtpHost')?.value,
          port: document.getElementById('smtpPort')?.value,
          user: document.getElementById('smtpUser')?.value,
          password: document.getElementById('smtpPassword')?.value,
          secure: document.getElementById('smtpSecure')?.checked,
        }),
      }).then(function(r) { return r.json(); }).then(function(res) {
        resultEl.classList.remove('hidden');
        resultEl.textContent = res.success ? msgSmtpOk : (res.message || msgSmtpFail);
        resultEl.style.color = res.success ? 'var(--theme-success)' : 'var(--theme-danger)';
      }).catch(function() {
        resultEl.classList.remove('hidden');
        resultEl.textContent = msgSmtpError;
        resultEl.style.color = 'var(--theme-danger)';
      });
    });
  }

  // S3 test
  var s3TestBtn = document.getElementById('s3TestBtn');
  if (s3TestBtn) {
    s3TestBtn.addEventListener('click', function() {
      var resultEl = document.getElementById('s3TestResult');
      resultEl.classList.add('hidden');
      fetch('/admin/settings/s3/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({
          endpoint: document.getElementById('s3Endpoint')?.value,
          region: document.getElementById('s3Region')?.value,
          bucket: document.getElementById('s3Bucket')?.value,
          accessKey: document.getElementById('s3AccessKey')?.value,
          secretKey: document.getElementById('s3SecretKey')?.value,
          pathStyle: document.getElementById('s3PathStyle')?.checked,
        }),
      }).then(function(r) { return r.json(); }).then(function(res) {
        resultEl.classList.remove('hidden');
        resultEl.textContent = res.success ? msgS3Ok : (res.message || msgS3Fail);
        resultEl.style.color = res.success ? 'var(--theme-success)' : 'var(--theme-danger)';
      }).catch(function() {
        resultEl.classList.remove('hidden');
        resultEl.textContent = msgS3Error;
        resultEl.style.color = 'var(--theme-danger)';
      });
    });
  }

  // Ban IP
  var banIpBtn = document.getElementById('banIpBtn');
  if (banIpBtn) {
    banIpBtn.addEventListener('click', function() {
      var ip = document.getElementById('banIpInput')?.value?.trim();
      if (!ip) return;
      fetch('/admin/settings/ban-ip', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({ ip: ip }),
      }).then(function(r) { return r.json(); }).then(function(res) {
        if (res.success) { window.location.reload(); }
        else { showToast(res.message || msgBanFailed, 'error'); }
      }).catch(function() { showToast(msgBanFailed, 'error'); });
    });
  }

  // Unban IP
  document.querySelectorAll('.unban-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var ip = this.dataset.ip;
      fetch('/admin/settings/unban-ip', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({ ip: ip }),
      }).then(function(r) { return r.json(); }).then(function(res) {
        if (res.success) { window.location.reload(); }
        else { showToast(res.message || msgUnbanFailed, 'error'); }
      }).catch(function() { showToast(msgUnbanFailed, 'error'); });
    });
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
