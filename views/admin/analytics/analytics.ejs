<%- include('../../components/header', { title: t('adminAnalyticsTitle') }) %>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>

    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: t('admin') },
        { label: t('breadcrumbAnalytics') }
      ] }) %>
      <div class="al-page-header">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="al-page-title"><%= t('adminAnalyticsTitle') %></h1>
            <p class="al-page-desc"><%= t('analyticsLiveDesc') %></p>
          </div>
          <button type="button" id="refreshBtn"
            class="al-btn-secondary flex items-center gap-1.5 px-3 py-2 text-sm font-medium transition">
            <%- icon('refresh-cw', { id: 'refreshIcon', class: 'w-4 h-4', strokeWidth: 1.5 }) %>
            <%= t('analyticsRefreshBtn') %>
          </button>
        </div>
      </div>

      <div class="al-page-body" data-al-tabs data-tabs-default="servers" data-tabs-hash>
        <!-- Tab bar -->
        <div class="flex gap-1 mb-6 flex-wrap" role="tablist">
          <button type="button" id="tab-servers"  aria-controls="panel-servers"  data-tab="servers"  tabindex="0"  class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="true"><%- icon('server', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('analyticsTabServers') %></button>
          <button type="button" id="tab-nodes"    aria-controls="panel-nodes"    data-tab="nodes"    tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="false"><%- icon('network', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('analyticsTabNodes') %></button>
          <button type="button" id="tab-activity" aria-controls="panel-activity" data-tab="activity" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="false"><%- icon('activity', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('analyticsTabActivity') %></button>
          <button type="button" id="tab-logs"     aria-controls="panel-logs"     data-tab="logs"     tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="false"><%- icon('scroll-text', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('analyticsTabLogs') %></button>
          <% if (user.role === 'owner') { %>
          <button type="button" id="tab-system"   aria-controls="panel-system"   data-tab="system"   tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="false"><%- icon('shield-alert', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('analyticsTabSystem') %></button>
          <% } %>
        </div>

        <!-- Loading state -->
        <div id="loading-state" class="flex items-center gap-3 py-12" style="color:var(--theme-text-muted)">
          <%- icon('loader-circle', { class: 'animate-spin w-5 h-5', strokeWidth: 2 }) %>
          <span class="text-sm"><%= t('analyticsLoadingData') %></span>
        </div>

        <!-- ── SERVERS ─────────────────────────────────────────────────────── -->
        <div id="panel-servers" data-tab-panel="servers" role="tabpanel" aria-labelledby="tab-servers" class="tab-panel space-y-6">

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsTotalServers') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-total">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)" id="sv-suspended-label"></p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsAllocatedRam') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-ram">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('analyticsAcrossAllServers') %></p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsAllocatedCpu') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-cpu">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('analyticsTotalAllocation') %></p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsAllocatedDisk') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-storage">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('analyticsTotalAllocation') %></p>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

            <!-- Top images -->
            <div class="al-card p-5">
              <p class="text-sm font-medium mb-4" style="color:var(--theme-text-strong)"><%= t('analyticsImagesInUse') %></p>
              <div id="sv-images" class="space-y-3"></div>
            </div>

            <!-- Heaviest servers -->
            <div class="al-card overflow-hidden">
              <h2 class="al-card-header"><%= t('analyticsHighestAllocated') %></h2>
              <div class="divide-y divide-[var(--theme-border)]" id="sv-heavy"></div>
            </div>

          </div>
        </div>

        <!-- ── NODES ──────────────────────────────────────────────────────── -->
        <div id="panel-nodes" data-tab-panel="nodes" role="tabpanel" aria-labelledby="tab-nodes" class="tab-panel space-y-4" hidden>

          <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsNodesLabel') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="nd-total">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsOnlineLabel') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-success)" id="nd-online">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsOfflineLabel') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-danger)" id="nd-offline">—</p>
            </div>
          </div>

          <div id="nd-list" class="space-y-3"></div>
        </div>

        <!-- ── ACTIVITY ────────────────────────────────────────────────────── -->
        <div id="panel-activity" data-tab-panel="activity" role="tabpanel" aria-labelledby="tab-activity" class="tab-panel space-y-6" hidden>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsUsersLabel') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-users">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)" id="ac-admins-label"></p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsImagesInstalled') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-images">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('analyticsInLibrary') %></p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsLogins30d') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-logins">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('analyticsPanelSessions') %></p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsAvgPerDay') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-avg">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('analyticsLoginsPerDay') %></p>
            </div>
          </div>

          <!-- Login chart -->
          <div class="al-card p-5">
            <p class="text-sm font-medium mb-4" style="color:var(--theme-text-strong)"><%= t('analyticsLoginActivity30d') %></p>
            <div class="relative h-44">
              <canvas id="loginChart"></canvas>
            </div>
          </div>

          <!-- Recent logins -->
          <div class="al-card overflow-hidden">
            <h2 class="al-card-header"><%= t('analyticsRecentLogins') %></h2>
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm divide-y divide-[var(--theme-border)]">
                <thead style="background:var(--theme-bg-secondary)">
                  <tr>
                    <th class="px-5 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('analyticsUserId') %></th>
                    <th class="px-5 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('ipAddress') %></th>
                    <th class="px-5 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('activityTime') %></th>
                  </tr>
                </thead>
                <tbody id="ac-logins-table" class="divide-y divide-[var(--theme-border)]"></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ── ACTIVITY LOGS ──────────────────────────────────────────────── -->
        <div id="panel-logs" data-tab-panel="logs" role="tabpanel" aria-labelledby="tab-logs" class="tab-panel space-y-6" hidden>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsTotalEvents') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="log-total">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsLast24h') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-info)" id="log-24h">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsLast7days') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-success)" id="log-7d">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsCategoriesLabel') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="log-categories">—</p>
            </div>
          </div>

          <!-- Events over time chart -->
          <div class="al-card p-5">
            <p class="text-sm font-medium mb-4" style="color:var(--theme-text-strong)"><%= t('analyticsEvents30d') %></p>
            <div class="relative h-44">
              <canvas id="activityChart"></canvas>
            </div>
          </div>

          <!-- Filters -->
          <div class="al-card p-4">
            <div class="flex flex-wrap gap-3 items-center">
              <select id="log-filter-category" class="al-select text-sm px-3 py-1.5">
                <option value=""><%= t('analyticsAllCategoriesFilter') %></option>
                <option value="user_action"><%= t('analyticsUserAction') %></option>
                <option value="system_error"><%= t('analyticsSystemError') %></option>
                <option value="security"><%= t('analyticsSecurity') %></option>
                <option value="server_lifecycle"><%= t('analyticsServerLifecycle') %></option>
              </select>
              <select id="log-filter-severity" class="al-select text-sm px-3 py-1.5">
                <option value=""><%= t('analyticsAllSeverities') %></option>
                <option value="info"><%= t('analyticsSeverityInfo') %></option>
                <option value="warning"><%= t('analyticsSeverityWarning') %></option>
                <option value="error"><%= t('analyticsSeverityError') %></option>
                <option value="critical"><%= t('analyticsSeverityCritical') %></option>
              </select>
              <input id="log-filter-search" type="text" placeholder="<%= t('analyticsSearchEvents') %>" class="al-input text-sm px-3 py-1.5" />
              <button id="log-filter-apply" class="al-btn-primary text-sm px-3 py-1.5"><%= t('analyticsApplyBtn') %></button>
            </div>
          </div>

          <!-- Activity feed -->
          <div class="al-card overflow-hidden">
            <h2 class="al-card-header"><%= t('analyticsRecentActivityLog') %></h2>
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm divide-y divide-[var(--theme-border)]">
                <thead style="background:var(--theme-bg-secondary)">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('activityTime') %></th>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('activityUser') %></th>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('activityAction') %></th>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('activityCategory') %></th>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('analyticsSeverityLabel') %></th>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('activityIP') %></th>
                  </tr>
                </thead>
                <tbody id="log-feed-table" class="divide-y divide-[var(--theme-border)]"></tbody>
              </table>
            </div>
            <div id="log-pagination" class="flex items-center justify-between px-5 py-3 border-t border-[var(--theme-border)]"></div>
          </div>
        </div>

        <!-- ── SYSTEM LOGS (owner-only) ──────────────────────────────────── -->
        <% if (user.role === 'owner') { %>
        <div id="panel-system" data-tab-panel="system" role="tabpanel" aria-labelledby="tab-system" class="tab-panel space-y-6" hidden>

          <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsTotalSystemLogs') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sys-total">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsLast24h') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-info)" id="sys-24h">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label"><%= t('analyticsComponentsLabel') %></p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sys-components">—</p>
            </div>
          </div>

          <!-- Severity breakdown chart -->
          <div class="al-card p-5">
            <p class="text-sm font-medium mb-4" style="color:var(--theme-text-strong)"><%= t('analyticsSystemLogsBySeverity') %></p>
            <div class="relative h-44">
              <canvas id="systemChart"></canvas>
            </div>
          </div>

          <!-- Filters -->
          <div class="al-card p-4">
            <div class="flex flex-wrap gap-3 items-center">
              <select id="sys-filter-severity" class="al-select text-sm px-3 py-1.5">
                <option value=""><%= t('analyticsAllSeverities') %></option>
                <option value="warning"><%= t('analyticsSeverityWarning') %></option>
                <option value="error"><%= t('analyticsSeverityError') %></option>
                <option value="critical"><%= t('analyticsSeverityCritical') %></option>
              </select>
              <select id="sys-filter-component" class="al-select text-sm px-3 py-1.5">
                <option value=""><%= t('analyticsAllComponents') %></option>
                <option value="api"><%= t('analyticsApiComponent') %></option>
                <option value="daemon"><%= t('analyticsDaemonComponent') %></option>
                <option value="database"><%= t('analyticsDatabaseComponent') %></option>
                <option value="redis"><%= t('analyticsRedisComponent') %></option>
                <option value="scheduler"><%= t('analyticsSchedulerComponent') %></option>
              </select>
              <input id="sys-filter-search" type="text" placeholder="<%= t('analyticsSearchLogs') %>" class="al-input text-sm px-3 py-1.5" />
              <button id="sys-filter-apply" class="al-btn-primary text-sm px-3 py-1.5"><%= t('analyticsApplyBtn') %></button>
            </div>
          </div>

          <!-- System log table -->
          <div class="al-card overflow-hidden">
            <h2 class="al-card-header"><%= t('analyticsSystemLogsTitle') %></h2>
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm divide-y divide-[var(--theme-border)]">
                <thead style="background:var(--theme-bg-secondary)">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('activityTime') %></th>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('analyticsSeverityLabel') %></th>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('analyticsComponentLabel') %></th>
                    <th class="px-4 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('analyticsMessageLabel') %></th>
                  </tr>
                </thead>
                <tbody id="sys-log-table" class="divide-y divide-[var(--theme-border)]"></tbody>
              </table>
            </div>
            <div id="sys-pagination" class="flex items-center justify-between px-5 py-3 border-t border-[var(--theme-border)]"></div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</main>


<script nonce="<%- nonce %>" src="/vendor/chart.js/dist/chart.js"></script>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-analytics.js?v=6"></script>

<%- include('../../components/footer') %>
