<%- include('../../components/header', { title: 'Analytics' }) %>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/template') %></div>

    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Analytics' }
      ] }) %>
      <div class="al-page-header">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="al-page-title">Analytics</h1>
            <p class="al-page-desc">Live data from the database and connected daemons.</p>
          </div>
          <button type="button" id="refreshBtn"
            class="al-btn-secondary flex items-center gap-1.5 px-3 py-2 text-sm font-medium transition">
            <%- icon('refresh-cw', { id: 'refreshIcon', class: 'w-4 h-4', strokeWidth: 1.5 }) %>
            Refresh
          </button>
        </div>
      </div>

      <div class="al-page-body">
        <!-- Tab bar -->
        <div class="flex gap-1 mb-6" role="tablist">
          <button type="button" id="tab-servers"  aria-controls="panel-servers"  data-tab="servers"  tabindex="0"  class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="true"><%- icon('server', { class: 'size-4', strokeWidth: 1.5 }) %>Servers</button>
          <button type="button" id="tab-nodes"    aria-controls="panel-nodes"    data-tab="nodes"    tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="false"><%- icon('network', { class: 'size-4', strokeWidth: 1.5 }) %>Nodes</button>
          <button type="button" id="tab-activity" aria-controls="panel-activity" data-tab="activity" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="false"><%- icon('activity', { class: 'size-4', strokeWidth: 1.5 }) %>Activity</button>
        </div>

        <!-- Loading state -->
        <div id="loading-state" class="flex items-center gap-3 py-12" style="color:var(--theme-text-muted)">
          <%- icon('loader-circle', { class: 'animate-spin w-5 h-5', strokeWidth: 2 }) %>
          <span class="text-sm">Loading analytics…</span>
        </div>

        <!-- ── SERVERS ─────────────────────────────────────────────────────── -->
        <div id="panel-servers" data-tab-panel="servers" role="tabpanel" aria-labelledby="tab-servers" class="tab-panel hidden space-y-6">

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Total servers</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-total">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)" id="sv-suspended-label"></p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Allocated RAM</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-ram">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)">across all servers</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Allocated CPU</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-cpu">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)">total allocation</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Allocated disk</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-storage">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)">total allocation</p>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

            <!-- Top images -->
            <div class="al-card p-5">
              <p class="text-sm font-medium mb-4" style="color:var(--theme-text-strong)">Images in use</p>
              <div id="sv-images" class="space-y-3"></div>
            </div>

            <!-- Heaviest servers -->
            <div class="al-card overflow-hidden">
              <h2 class="al-card-header">Highest allocated servers</h2>
              <div class="divide-y divide-neutral-100 dark:divide-white/5" id="sv-heavy"></div>
            </div>

          </div>
        </div>

        <!-- ── NODES ──────────────────────────────────────────────────────── -->
        <div id="panel-nodes" data-tab-panel="nodes" role="tabpanel" aria-labelledby="tab-nodes" class="tab-panel hidden space-y-4">

          <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Nodes</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="nd-total">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Online</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-success)" id="nd-online">—</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Offline</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-danger)" id="nd-offline">—</p>
            </div>
          </div>

          <div id="nd-list" class="space-y-3"></div>
        </div>

        <!-- ── ACTIVITY ────────────────────────────────────────────────────── -->
        <div id="panel-activity" data-tab-panel="activity" role="tabpanel" aria-labelledby="tab-activity" class="tab-panel hidden space-y-6">

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Users</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-users">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)" id="ac-admins-label"></p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Images installed</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-images">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)">in library</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Logins (30d)</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-logins">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)">panel sessions</p>
            </div>
            <div class="al-card px-4 py-4">
              <p class="al-section-label">Avg/day</p>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-avg">—</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted)">logins per day</p>
            </div>
          </div>

          <!-- Login chart -->
          <div class="al-card p-5">
            <p class="text-sm font-medium mb-4" style="color:var(--theme-text-strong)">Login activity — last 30 days</p>
            <div class="relative h-44">
              <canvas id="loginChart"></canvas>
            </div>
          </div>

          <!-- Recent logins -->
          <div class="al-card overflow-hidden">
            <h2 class="al-card-header">Recent logins</h2>
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm divide-y divide-neutral-100 dark:divide-white/5">
                <thead class="bg-neutral-100/60 dark:bg-white/[0.02]">
                  <tr>
                    <th class="px-5 py-3 text-left text-xs font-medium text-neutral-500">User ID</th>
                    <th class="px-5 py-3 text-left text-xs font-medium text-neutral-500">IP Address</th>
                    <th class="px-5 py-3 text-left text-xs font-medium text-neutral-500">Time</th>
                  </tr>
                </thead>
                <tbody id="ac-logins-table" class="divide-y divide-neutral-100 dark:divide-white/5"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../components/toast') %>

<script nonce="<%- nonce %>" src="/vendor/chartjs/chart.umd.js"></script>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-analytics.js?v=5"></script>

<%- include('../../components/footer') %>
