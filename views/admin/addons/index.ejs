<%- include('../../layouts/admin', { title: t('addonsTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('addonsTitle') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('addonsTitle') %></h1>
    <p class="al-page-desc"><%= t('addonsDesc') %></p>
  </div>
  <div>
    <button id="reloadBtn" type="button" class="al-btn-secondary">
      <%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('reloadAddons') %></span>
    </button>
  </div>
</div>

<div class="al-page-body">
  <nav class="al-segmented mb-5" role="group" aria-label="<%= t('addonsViews') %>">
    <a href="/admin/addons" class="al-segmented-btn" aria-current="page"><%= t('installedTab') %><span class="ml-1 text-xs al-text-muted"><%= addons ? addons.length : 0 %></span></a>
    <a href="/admin/addons/store" class="al-segmented-btn"><%= t('storeTab') %></a>
  </nav>

  <% if (addons && addons.length > 0) { %>
  <div class="al-form-field mb-4 max-w-sm">
    <label for="addonSearchInput" class="al-form-label"><%= t('searchAddonsLabel') %></label>
    <input id="addonSearchInput" type="search" placeholder="<%= t('addonSearchPlaceholder') %>" aria-label="<%= t('addonSearchAria') %>" class="al-form-input">
  </div>

  <div class="al-table-wrapper">
    <table class="al-table al-table-card">
      <colgroup>
        <col style="min-width:240px">
        <col style="min-width:160px">
        <col style="min-width:120px">
        <col style="min-width:200px">
      </colgroup>
      <thead class="al-table-thead">
        <tr>
          <th scope="col" class="al-table-th pl-6"><%= t('name') %></th>
          <th scope="col" class="al-table-th col-hide"><%= t('version') %></th>
          <th scope="col" class="al-table-th col-hide"><%= t('status') %></th>
          <th scope="col" class="al-table-th"><%= t('actions') %></th>
        </tr>
      </thead>
      <tbody class="al-table-tbody">
        <% let addonIdx = 0; addons.forEach(function(addon) { %>
        <tr class="al-table-tr addon-row"
            style="--i:<%= addonIdx++ %>"
            data-slug="<%= addon.slug %>"
            data-search="<%= (addon.name + ' ' + (addon.description||'') + ' ' + (addon.author||'')).toLowerCase() %>">
          <td class="al-table-td pl-6" data-label="<%= t('name') %>">
            <p class="al-table-cell-strong"><%= addon.name %></p>
            <% if (addon.description) { %><p class="text-xs mt-0.5 max-w-xs truncate" style="color:var(--theme-text-muted)"><%= addon.description %></p><% } %>
          </td>
          <td class="al-table-td col-hide" data-label="<%= t('version') %>">v<%= addon.version %><% if (addon.author) { %> &middot; <%= addon.author %><% } %></td>
          <td class="al-table-td col-hide" data-label="<%= t('status') %>">
            <% if (addon.enabled) { %>
            <span class="al-badge al-badge-online"><%= t('enabled') %></span>
            <% } else { %>
            <span class="al-badge al-badge-neutral"><%= t('disabled') %></span>
            <% } %>
          </td>
          <td class="al-table-td" data-label="<%= t('actions') %>">
            <div class="flex flex-wrap gap-2">
              <a href="/admin/addons/<%= addon.slug %>" class="al-btn-secondary al-btn-sm"><span><%= t('configure') %></span></a>
              <button data-action="toggle" data-slug="<%= addon.slug %>" data-enable="<%= !addon.enabled %>" type="button" class="al-btn-secondary al-btn-sm">
                <span><%= addon.enabled ? t('disable') : t('enable') %></span>
              </button>
              <button data-action="uninstall" data-slug="<%= addon.slug %>" data-name="<%= addon.name %>" type="button"
                class="al-btn-danger al-btn-icon-only" aria-label="<%= t('uninstallAria', { name: addon.name }) %>">
                <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <div id="addonNoResults" class="hidden py-10 text-sm al-table-empty"><%= t('noAddonResults') %></div>
  </div>
  <% } else { %>
    <%- include('../../partials/empty-state', {
      iconName: 'puzzle',
      title: t('noAddonsInstalled'),
      action: '<a href="/admin/addons/store" class="al-btn-secondary">' + icon('store', { class: 'size-4', strokeWidth: 1.5 }).toString() + '<span>' + t('browseStore') + '</span></a>'
    }) %>
  <% } %>
</div>

<script nonce="<%- nonce %>">
(function() {
  var csrfToken = '<%= csrfToken %>';
  var msgReloading = <%- JSON.stringify(t('addonReloading')) %>;
  var msgReloaded = <%- JSON.stringify(t('addonReloaded')) %>;
  var msgActionFailed = <%- JSON.stringify(t('actionFailed')) %>;
  var msgApplying = <%- JSON.stringify(t('applyingChanges')) %>;
  var msgUpdated = <%- JSON.stringify(t('addonUpdated')) %>;
  var msgRemoving = <%- JSON.stringify(t('removingFiles')) %>;
  var msgUninstalled = <%- JSON.stringify(t('addonUninstalled')) %>;
  var msgWentWrong = <%- JSON.stringify(t('somethingWentWrong')) %>;
  var msgUninstallTitle = <%- JSON.stringify(t('uninstallAddonTitle')) %>;
  var msgUninstallBody = <%- JSON.stringify(t('uninstallAddonBody')) %>;
  var msgUninstallAction = <%- JSON.stringify(t('uninstall')) %>;

  document.getElementById('reloadBtn').addEventListener('click', function() {
    showProgressToast(msgReloading);
    fetch('/admin/addons/reload', { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken } })
      .then(function(r) { return r.json(); }).then(function(data) {
        showToast(data.message || (data.success ? msgReloaded : msgActionFailed), data.success ? 'success' : 'error');
        if (data.success) window.location.reload();
      }).catch(function() { showToast(msgWentWrong, 'error'); });
  });

  var addonSearchInput = document.getElementById('addonSearchInput');
  if (addonSearchInput) {
    addonSearchInput.addEventListener('input', function() {
      var q = this.value.toLowerCase().trim();
      var visible = 0;
      document.querySelectorAll('.addon-row').forEach(function(row) {
        var match = !q || row.dataset.search.includes(q);
        row.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      var noResults = document.getElementById('addonNoResults');
      if (noResults) noResults.classList.toggle('hidden', visible > 0 || !q);
    });
  }

  document.querySelectorAll('[data-action="toggle"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var slug = this.dataset.slug;
      var enable = this.dataset.enable === 'true';
      showProgressToast(msgApplying);
      fetch('/admin/addons/toggle/' + slug, {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({ enabled: enable.toString() }),
      }).then(function(r) { return r.json(); }).then(function(data) {
        if (data.success) { showToast(msgUpdated, 'success'); window.location.reload(); }
        else showToast(data.message || msgActionFailed, 'error');
      }).catch(function() { showToast(msgWentWrong, 'error'); });
    });
  });

  document.querySelectorAll('[data-action="uninstall"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var slug = this.dataset.slug;
      var name = this.dataset.name;
      window.modal && window.modal.confirm
        ? window.modal.confirm({
            title: msgUninstallTitle,
            body: msgUninstallBody.replace('{{name}}', name),
            danger: true, confirmLabel: msgUninstallAction,
            onConfirm: function() {
              showProgressToast(msgRemoving);
              fetch('/admin/addons/uninstall/' + slug, { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }, body: JSON.stringify({ slug: slug }) })
                .then(function(r) { return r.json(); }).then(function(data) {
                  if (data.success) { showToast(msgUninstalled, 'success'); window.location.reload(); }
                  else showToast(data.message || msgActionFailed, 'error');
                }).catch(function() { showToast(msgWentWrong, 'error'); });
            }
          })
        : null;
    });
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
