<%- include('../../components/header', { title: 'Addon Store' }) %>
<%- include('../../components/toast') %>

<style>
  ::-webkit-scrollbar { display: none; }

  .modal-overlay {
    position: fixed; inset: 0; z-index: var(--z-modal-backdrop);
    background: var(--theme-overlay, rgba(0,0,0,0.5));
    display: flex; align-items: center; justify-content: center; padding: 16px;
    opacity: 0; pointer-events: none; transition: opacity 0.25s;
  }
  .modal-overlay.open { opacity: 1; pointer-events: auto; }
  .modal-box {
    background: var(--theme-bg-card, #fff); border: 1px solid var(--theme-border, #e5e5e5); border-radius: 12px;
    width: 100%; max-width: 680px; height: 520px; max-height: calc(100vh - 40px);
    display: flex; flex-direction: column;
    transform: scale(0.96); opacity: 0;
    transition: transform 0.25s, opacity 0.25s; overflow: hidden;
  }
  html.dark .modal-box { background: var(--theme-bg-card, #1c1c1c); border-color: var(--theme-border-subtle, rgba(255,255,255,0.08)); }
  .modal-overlay.open .modal-box { transform: scale(1); opacity: 1; }
  .modal-two-col { display: flex; flex: 1; overflow: hidden; min-height: 0; }
  .modal-left { width: 280px; min-width: 220px; flex-shrink: 0; border-right: 1px solid var(--theme-border, #e5e5e5); overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  html.dark .modal-left { border-right-color: var(--theme-border-subtle, rgba(255,255,255,0.06)); }
  .modal-right { flex: 1; min-width: 0; overflow-y: auto; padding: 18px; }

  .sb-working { background: var(--theme-success-bg, rgba(34,197,94,0.1)); color: var(--theme-success-text, #15803d); }
  .sb-beta    { background: var(--theme-warning-bg, rgba(234,179,8,0.1)); color: var(--theme-warning-text, #a16207); }
  .sb-wip     { background: var(--theme-warning-bg, rgba(249,115,22,0.1)); color: var(--theme-warning-text, #c2410c); }
  .sb-inst    { background: var(--theme-info-bg, rgba(99,102,241,0.1)); color: var(--theme-info-text, #4338ca); }
  html.dark .sb-working { background: var(--theme-success-bg, rgba(34,197,94,0.12)); color: var(--theme-success, #4ade80); }
  html.dark .sb-beta    { background: var(--theme-warning-bg, rgba(234,179,8,0.12)); color: var(--theme-warning, #facc15); }
  html.dark .sb-wip     { background: var(--theme-warning-bg, rgba(249,115,22,0.12)); color: var(--theme-warning, #fb923c); }
  html.dark .sb-inst    { background: var(--theme-info-bg, rgba(99,102,241,0.15)); color: var(--theme-info, #a5b4fc); }

  .cat-game        { background: var(--theme-info-bg, #ede9fe); color: var(--theme-info-text, #6d28d9); }
  .cat-application { background: var(--theme-info-bg, #e0f2fe); color: var(--theme-info-text, #0369a1); }
  .cat-generic     { background: var(--theme-success-bg, #dcfce7); color: var(--theme-success-text, #15803d); }
  html.dark .cat-game        { background: var(--theme-info-bg, rgba(139,92,246,0.15)); color: var(--theme-info, #a78bfa); }
  html.dark .cat-application { background: var(--theme-info-bg, rgba(14,165,233,0.15)); color: var(--theme-info, #38bdf8); }
  html.dark .cat-generic     { background: var(--theme-success-bg, rgba(34,197,94,0.15)); color: var(--theme-success, #4ade80); }

  .s-tag { font-size: 11px; color: var(--theme-text-muted, #737373); background: var(--theme-bg-secondary, #f5f5f5); border: 1px solid var(--theme-border, #e5e5e5); border-radius: 99px; padding: 2px 9px; white-space: nowrap; cursor: pointer; transition: all 0.1s; }
  html.dark .s-tag { color: var(--theme-text-muted, #525252); background: var(--theme-bg-hover, rgba(255,255,255,0.04)); border-color: var(--theme-border-subtle, rgba(255,255,255,0.07)); }
  .s-tag.on { background: var(--theme-border, #e5e5e5); color: var(--theme-text-strong, #171717); border-color: var(--theme-border-strong, #d4d4d4); }
  html.dark .s-tag.on { background: var(--theme-bg-hover, rgba(255,255,255,0.1)); color: var(--theme-text-strong, #d4d4d4); border-color: var(--theme-border-subtle, rgba(255,255,255,0.13)); }

  .md-body { font-size: 12.5px; line-height: 1.75; color: var(--theme-text-muted, #525252); }
  html.dark .md-body { color: var(--theme-text-muted, #737373); }
  .md-body h1, .md-body h2 { font-size: 13px; font-weight: 600; color: var(--theme-text-strong, #171717); margin: 0 0 6px; }
  html.dark .md-body h1, html.dark .md-body h2 { color: var(--theme-text, #e5e5e5); }
  .md-body h3 { font-size: 12px; font-weight: 600; color: var(--theme-text-muted, #525252); margin: 10px 0 3px; }
  html.dark .md-body h3 { color: var(--theme-text, #a3a3a3); }
  .md-body p { margin: 0 0 8px; }
  .md-body a { color: var(--theme-accent, #7c3aed); text-decoration: none; }
  .md-body a:hover { text-decoration: underline; }
  .md-body code { font-family: ui-monospace,monospace; font-size: 11px; background: var(--theme-bg-secondary, #f4f4f5); padding: 1px 5px; border-radius: 4px; color: var(--theme-text-muted, #3f3f46); }
  html.dark .md-body code { background: var(--theme-bg-hover, rgba(255,255,255,0.07)); color: var(--theme-text-strong, #d4d4d4); }
  .md-body pre { background: var(--theme-bg-secondary, #f4f4f5); border: 1px solid var(--theme-border, #e5e5e5); border-radius: 8px; padding: 10px 12px; overflow-x: auto; margin: 0 0 8px; }
  html.dark .md-body pre { background: var(--theme-bg-hover, rgba(255,255,255,0.04)); border-color: var(--theme-border-subtle, rgba(255,255,255,0.07)); }
  .md-body pre code { background: none; padding: 0; }
  .md-body ul, .md-body ol { padding-left: 16px; margin: 0 0 8px; }
  .md-body li { margin-bottom: 2px; }
  .md-body hr { border: none; border-top: 1px solid var(--theme-border, #e5e5e5); margin: 10px 0; }
  html.dark .md-body hr { border-top-color: var(--theme-border-subtle, rgba(255,255,255,0.06)); }
  .md-body strong { color: var(--theme-text-strong, #171717); }
  html.dark .md-body strong { color: var(--theme-text, #e5e5e5); }

  .term-box { background: var(--theme-bg-input, #f9fafb); border: 1px solid var(--theme-border, #e5e5e5); border-radius: 9px; padding: 12px; display: none; }
  html.dark .term-box { background: var(--theme-bg-card, rgba(255,255,255,0.03)); border-color: var(--theme-border-subtle, rgba(255,255,255,0.07)); }
  .term-log { font-family: ui-monospace,monospace; font-size: 11px; color: var(--theme-text-muted, #737373); line-height: 1.6; max-height: 120px; overflow-y: auto; margin-top: 8px; }
  .term-log .l-step  { color: var(--theme-text, #a3a3a3); }
  .term-log .l-cmd   { color: var(--theme-text-muted, #737373); font-weight: 500; }
  .term-log .l-output{ color: var(--theme-text, #a3a3a3); }
  .term-log .l-ok    { color: var(--theme-success-text, #15803d); }
  html.dark .term-log .l-ok  { color: var(--theme-success, #4ade80); }
  .term-log .l-err   { color: var(--theme-danger, #dc2626); }
  html.dark .term-log .l-err { color: var(--theme-danger, #f87171); }
  .prog-track { height: 2px; background: var(--theme-border, #e5e5e5); border-radius: 99px; overflow: hidden; margin: 6px 0 2px; }
  html.dark .prog-track { background: var(--theme-border-subtle, rgba(255,255,255,0.07)); }
  .prog-fill { height: 100%; background: var(--theme-text, #a3a3a3); border-radius: 99px; transition: width 0.3s ease; width: 0%; }

  .sk { border-radius: 8px; animation: sk-pulse 1.4s ease-in-out infinite; }
  html:not(.dark) .sk { background: var(--theme-bg-secondary, #f0f0f0); }
  html.dark .sk { background: var(--theme-bg-hover, rgba(255,255,255,0.05)); }
  @keyframes sk-pulse { 0%,100%{opacity:1} 50%{opacity:0.35} }

  .err-box { background: var(--theme-danger-bg, rgba(239,68,68,0.08)); border: 1px solid var(--theme-danger-border, rgba(239,68,68,0.2)); border-radius: 9px; padding: 10px 12px; }
  .err-txt { font-size: 11px; color: var(--theme-danger, #dc2626); }
  html.dark .err-txt { color: var(--theme-danger, #f87171); }

  .s-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    min-width: 0;
  }
  .s-card:hover {
    border-color: rgba(255,255,255,0.11);
    box-shadow: 0 4px 24px rgba(0,0,0,0.25);
  }
  .s-icon {
    width: 36px; height: 36px; min-width: 36px;
    border-radius: 9px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; flex-shrink: 0;
  }
  .s-icon img { width: 20px; height: 20px; object-fit: contain; display: block; }
  .s-icon svg { width: 16px; height: 16px; flex-shrink: 0; }
  .s-badge {
    font-size: 10px; font-weight: 500; line-height: 1;
    padding: 3px 7px; border-radius: 99px; white-space: nowrap; flex-shrink: 0;
  }
  .s-badge-working   { background: rgba(34,197,94,0.12);  color: #4ade80; }
  .s-badge-beta      { background: rgba(234,179,8,0.12);  color: #facc15; }
  .s-badge-wip       { background: rgba(249,115,22,0.12); color: #fb923c; }
  .s-badge-installed { background: rgba(99,102,241,0.15); color: #a5b4fc; }
  .s-skeleton {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 14px; height: 156px;
    animation: sk-pulse 1.6s ease-in-out infinite;
  }
  .s-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 1023px) { .s-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 639px)  { .s-grid { grid-template-columns: 1fr; } }

  .m-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: var(--z-modal-backdrop);
    display: flex; align-items: center; justify-content: center;
    padding: 16px;
    opacity: 0; pointer-events: none;
    transition: opacity 0.18s;
  }
  .m-overlay.open { opacity: 1; pointer-events: auto; }
  .m-dialog {
    background: #141414;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    width: 100%; max-width: 580px;
    max-height: 86vh;
    display: flex; flex-direction: column;
    transform: translateY(8px) scale(0.99);
    transition: transform 0.18s cubic-bezier(0.23,1,0.32,1);
    overflow: hidden;
  }
  .m-overlay.open .m-dialog { transform: none; }
  .m-head    { padding: 20px 20px 0; flex-shrink: 0; }
  .m-actions { display: flex; gap: 8px; margin-top: 16px; }
  .m-tabs {
    display: flex; flex-shrink: 0;
    padding: 0 20px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin-top: 14px;
  }
  .m-tab {
    padding: 9px 14px;
    font-size: 12px; font-weight: 500; color: #525252;
    background: none; border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px; cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
  }
  .m-tab.on { color: #e5e5e5; border-bottom-color: #e5e5e5; }
  .m-tab:hover:not(.on) { color: #a3a3a3; }
  .m-body { flex: 1; overflow-y: auto; padding: 20px; }
  .m-pane { display: none; }
  .m-pane.on { display: block; }

  .m-terminal {
    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px; padding: 14px;
    margin-bottom: 16px;
  }
  .m-term-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .m-term-label { font-size: 11px; font-weight: 500; color: #d4d4d4; }
  .m-term-pct   { font-size: 10px; color: #404040; font-family: ui-monospace, monospace; }
  .m-term-track { height: 2px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden; }
  .m-term-fill  { height: 100%; background: #525252; border-radius: 99px; transition: width 0.3s ease; width: 0%; }
  .m-term-log   {
    margin-top: 12px; max-height: 160px; overflow-y: auto;
    font-family: ui-monospace, 'SF Mono', monospace;
    font-size: 11px; display: flex; flex-direction: column; gap: 3px;
  }
  .l-step   { color: #525252; }
  .l-cmd    { color: #737373; }
  .l-output { color: #404040; white-space: pre-wrap; word-break: break-all; }
  .l-ok     { color: #4ade80; }
  .l-err    { color: #f87171; }

  .m-cmd-list {
    background: #0d0d0d;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px; padding: 12px 14px;
  }
  .m-cmd-list code {
    font-family: ui-monospace, 'SF Mono', monospace;
    font-size: 11px; color: #737373; display: block; line-height: 1.9;
  }
  .m-note {
    display: flex; gap: 10px; align-items: flex-start;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px; padding: 11px 13px; margin-top: 12px;
    font-size: 11px; color: #525252; line-height: 1.65;
  }
  .m-note svg { flex-shrink: 0; margin-top: 1px; }

  .btn-install {
    display: inline-flex; align-items: center; gap: 6px;
    background: #fff; color: #0a0a0a;
    border: none; border-radius: 9px; padding: 8px 16px;
    font-size: 12px; font-weight: 500;
    cursor: pointer; flex: 1; justify-content: center;
    transition: background 0.12s; white-space: nowrap;
  }
  .btn-install:hover:not(:disabled) { background: #e5e5e5; }
  .btn-install:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-install svg { width: 13px; height: 13px; flex-shrink: 0; }
  .btn-remove {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(239,68,68,0.1); color: #f87171;
    border: 1px solid rgba(239,68,68,0.18);
    border-radius: 9px; padding: 8px 16px;
    font-size: 12px; font-weight: 500;
    cursor: pointer; flex: 1; justify-content: center;
    transition: background 0.12s; white-space: nowrap;
  }
  .btn-remove:hover:not(:disabled) { background: rgba(239,68,68,0.18); }
  .btn-remove:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-remove svg { width: 13px; height: 13px; flex-shrink: 0; }
  .btn-gh {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    color: #737373; border-radius: 9px; padding: 8px 16px;
    font-size: 12px; font-weight: 500;
    cursor: pointer; text-decoration: none;
    transition: background 0.12s, color 0.12s;
  }
  .btn-gh:hover { background: rgba(255,255,255,0.08); color: #d4d4d4; }
  .btn-gh svg { width: 13px; height: 13px; flex-shrink: 0; }

  .feat-row { display: flex; gap: 8px; align-items: flex-start; padding: 3px 0; font-size: 12px; color: #737373; }
  .feat-dot { width: 4px; height: 4px; border-radius: 50%; background: #404040; flex-shrink: 0; margin-top: 7px; }

  html:not(.dark) .s-card {
    background: #ffffff;
    border-color: #e5e5e5;
  }
  html:not(.dark) .s-card:hover {
    border-color: #d4d4d4;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }
  html:not(.dark) .s-icon {
    background: #f5f5f5;
    border-color: #e5e5e5;
  }
  html:not(.dark) .s-tag {
    color: #737373;
    background: #f5f5f5;
    border-color: #e5e5e5;
  }
  html:not(.dark) .s-skeleton {
    background: #f5f5f5;
    border-color: #e5e5e5;
  }

  html:not(.dark) .m-dialog {
    background: #ffffff;
    border-color: #e5e5e5;
  }
  html:not(.dark) .m-tabs {
    border-bottom-color: #e5e5e5;
  }
  html:not(.dark) .m-tab {
    color: #a3a3a3;
  }
  html:not(.dark) .m-tab.on {
    color: #171717;
    border-bottom-color: #171717;
  }
  html:not(.dark) .m-tab:hover:not(.on) {
    color: #525252;
  }
  html:not(.dark) .m-terminal {
    background: #f5f5f5;
    border-color: #e5e5e5;
  }
  html:not(.dark) .m-term-label { color: #171717; }
  html:not(.dark) .m-term-pct   { color: #a3a3a3; }
  html:not(.dark) .m-term-track { background: #e5e5e5; }
  html:not(.dark) .m-term-fill  { background: #a3a3a3; }
  html:not(.dark) .l-step   { color: #a3a3a3; }
  html:not(.dark) .l-cmd    { color: #737373; }
  html:not(.dark) .l-output { color: #a3a3a3; }

  html:not(.dark) .m-cmd-list {
    background: #f5f5f5;
    border-color: #e5e5e5;
  }
  html:not(.dark) .m-cmd-list code { color: #737373; }

  html:not(.dark) .m-note {
    background: #fafafa;
    border-color: #e5e5e5;
    color: #737373;
  }

  html:not(.dark) .btn-gh {
    background: #f5f5f5;
    border-color: #e5e5e5;
    color: #525252;
  }
  html:not(.dark) .btn-gh:hover {
    background: #ebebeb;
    color: #171717;
  }

  html:not(.dark) .btn-install {
    background: #171717;
    color: #ffffff;
  }
  html:not(.dark) .btn-install:hover:not(:disabled) {
    background: #333333;
  }

  html:not(.dark) .feat-row { color: #525252; }
  html:not(.dark) .feat-dot { background: #d4d4d4; }

  html:not(.dark) .m-head p,
  html:not(.dark) .m-head h2,
  html:not(.dark) .m-head span { color: #171717; }
  html:not(.dark) .m-head p.text-neutral-500,
  html:not(.dark) .m-head span.text-neutral-500 { color: #737373; }

  @media (max-width: 640px) {
    .modal-box { height: auto; max-height: calc(100vh - 40px); }
    .modal-two-col { flex-direction: column; }
    .modal-left { width: 100%; border-right: none; border-bottom: 1px solid var(--theme-border, #e5e5e5); }
    html.dark .modal-left { border-bottom-color: var(--theme-border-subtle, rgba(255,255,255,0.06)); }
    .col-hide { display: none; }
  }
</style>

<% if (isMobileViewport) { %>
<main id="page-content" class="">
  <%- include('../../components/template') %>

  <div class="px-4 py-5">
    <div class="px-4 pt-6 pb-0 flex items-center justify-between">
      <div>
        <h1 class="text-base font-medium text-neutral-800 dark:text-white">Addons</h1>
        <p class="mt-0.5 text-sm text-neutral-500">Manage installed addons and browse the store</p>
      </div>
    </div>

    <div class="px-4 mt-5">
      <div class="flex border-b border-neutral-200 dark:border-neutral-800 mb-6">
        <a href="/admin/addons" class="px-4 py-2.5 text-sm font-medium text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 border-b-2 border-transparent -mb-px transition">
          Installed <span class="ml-1 text-xs text-neutral-500"><%= addons ? addons.length : 0 %></span>
        </a>
        <a href="/admin/addons/store" class="px-4 py-2.5 text-sm font-medium text-neutral-800 dark:text-white border-b-2 border-neutral-800 dark:border-white -mb-px">Store</a>
      </div>

      <div class="flex items-center gap-3 mb-6 flex-wrap">
        <input id="searchInput" type="text" placeholder="<%= req.translations.searchAddons || 'Search addons...' %>"
          class="al-input rounded-xl w-52" />
        <div id="tagFilters" class="flex gap-2 flex-wrap"></div>
      </div>

      <div id="storeLoading" class="s-grid">
        <div class="s-skeleton"></div><div class="s-skeleton"></div><div class="s-skeleton"></div>
        <div class="s-skeleton"></div><div class="s-skeleton"></div><div class="s-skeleton"></div>
      </div>

      <div id="storeError" style="display:none;" class="py-16 text-center">
        <%- icon('triangle-alert', { class: 'w-9 h-9 text-neutral-800 mx-auto mb-3', strokeWidth: 1 }) %>
        <p id="storeErrorMsg" class="text-sm text-neutral-600"></p>
        <button onclick="loadStore()" class="mt-3 text-xs text-neutral-700 hover:text-neutral-400 transition underline">Retry</button>
      </div>

      <div id="storeGrid" class="s-grid" style="display:none;"></div>

      <div id="storeEmpty" style="display:none;" class="py-16 text-center">
        <p class="text-sm text-neutral-600">No addons match your search.</p>
        <button id="clearSearch" class="mt-3 text-xs text-neutral-700 hover:text-neutral-400 transition underline">Clear</button>
      </div>
    </div>
  </div>
</main>

<div class="m-overlay" id="mOverlay">
  <div class="m-dialog">
    <div class="m-head">
      <div style="display:flex;align-items:flex-start;gap:14px;">
        <div class="s-icon" id="mIcon" style="width:40px;height:40px;min-width:40px;border-radius:10px;"></div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap;">
            <span id="mName" style="font-size:14px;font-weight:600;color:#fff;"></span>
            <span id="mStatus" class="s-badge"></span>
          </div>
          <p id="mMeta" style="font-size:11px;color:#525252;margin-top:3px;"></p>
        </div>
        <button id="mClose" style="flex-shrink:0;width:24px;height:24px;border-radius:6px;background:rgba(255,255,255,0.06);border:none;display:flex;align-items:center;justify-content:center;color:#525252;cursor:pointer;">
          <%- icon('x', { size: 16, class: 'shrink-0' }) %>
        </button>
      </div>
      <div class="m-actions">
        <button id="mActionBtn" class="btn-install">
          <%- icon('download', { size: 16, class: 'shrink-0' }) %>
          <span id="mActionLabel"><%= req.translations.install || 'Install' %></span>
        </button>
        <a id="mGhBtn" href="#" target="_blank" rel="noopener noreferrer" class="btn-gh">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"/></svg>
          GitHub
        </a>
      </div>
    </div>

    <div class="m-tabs">
      <button class="m-tab on" data-tab="overview">Overview</button>
      <button class="m-tab" data-tab="install">Installation</button>
      <button class="m-tab" data-tab="reviews">Reviews</button>
    </div>

    <div class="m-body">
      <div class="m-pane on" id="m-pane-overview">
        <p id="mDesc" style="font-size:13px;color:#737373;line-height:1.7;margin-bottom:18px;"></p>
        <div id="mFeatures"></div>
      </div>
      <div class="m-pane" id="m-pane-install">
        <div id="mTerminal" class="m-terminal" style="display:none;">
          <div class="m-term-head">
            <span class="m-term-label" id="mTermLabel">Starting...</span>
            <span class="m-term-pct" id="mTermPct">0%</span>
          </div>
          <div class="m-term-track"><div class="m-term-fill" id="mTermBar"></div></div>
          <div class="m-term-log" id="mTermLog"></div>
        </div>
        <div id="mCmdGuide"></div>
      </div>
      <div class="m-pane" id="m-pane-reviews">
        <p style="font-size:12px;color:#404040;margin-bottom:16px;line-height:1.6;">Reviews are powered by GitHub Discussions on the addons repository.</p>
        <div id="mGiscus"></div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
(function () {
  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function show(id)     { const el = document.getElementById(id); if (el) el.style.display = ''; }
  function hide(id)     { const el = document.getElementById(id); if (el) el.style.display = 'none'; }
  function showGrid(id) { const el = document.getElementById(id); if (el) el.style.display = 'grid'; }

  function badgeClass(status) {
    if (status === 'beta') return 's-badge s-badge-beta';
    if (status === 'wip')  return 's-badge s-badge-wip';
    return 's-badge s-badge-working';
  }

  let allAddons    = [];
  const INSTALLED  = new Set(<%- JSON.stringify((addons || []).map(a => a.slug)) %>);
  let currentAddon = null;
  let activeTag    = null;

  const pd = document.getElementById('page-data').dataset;
  const defaultAddonIconHtml = pd.defaultAddonIcon || '';
  const githubIconHtml = pd.githubIcon || '';
  const infoIconHtml = pd.infoIcon || '';

  async function loadStore() {
    hide('storeError');
    hide('storeGrid');
    hide('storeEmpty');
    showGrid('storeLoading');

    try {
      const listRes  = await fetch('/admin/addons/store/list');
      const listData = await listRes.json();

      if (!listData.success) throw new Error(listData.message || 'Failed to load');

      allAddons = listData.addons || [];

      buildTagFilters();
      render(filtered());
    } catch (err) {
      hide('storeLoading');
      const msg = err.message || '';
      const isRateLimit = msg.toLowerCase().includes('rate') || msg.toLowerCase().includes('403') || msg.toLowerCase().includes('429');
      const displayMsg = isRateLimit
        ? 'GitHub rate limit reached. Wait a few minutes and try again.'
        : (msg || 'Failed to load addon store.');
      document.getElementById('storeErrorMsg').textContent = displayMsg;
      const errorEl = document.getElementById('storeError');
      errorEl.style.display = '';
      errorEl.style.opacity = '0';
      errorEl.style.transform = 'translateY(6px)';
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          errorEl.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
          errorEl.style.opacity = '1';
          errorEl.style.transform = 'translateY(0)';
          setTimeout(function() { errorEl.style.transition = ''; }, 220);
        });
      });
    }
  }

  function buildTagFilters() {
    const counts = {};
    allAddons.forEach(a => (a.tags || []).forEach(t => { counts[t] = (counts[t] || 0) + 1; }));
    const top = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 8).map(e => e[0]);
    const el  = document.getElementById('tagFilters');
    el.innerHTML = '';
    top.forEach(tag => {
      const btn = document.createElement('button');
      btn.textContent   = tag;
      btn.className     = 's-tag';
      btn.style.cssText = 'cursor:pointer;transition:background 0.12s,color 0.12s,border-color 0.12s;';
      btn.addEventListener('click', () => {
        activeTag = activeTag === tag ? null : tag;
        el.querySelectorAll('button').forEach(b => {
          const on = b.textContent === activeTag;
          b.style.background  = on ? 'rgba(255,255,255,0.1)'  : 'rgba(255,255,255,0.04)';
          b.style.color       = on ? '#e5e5e5'                : '#525252';
          b.style.borderColor = on ? 'rgba(255,255,255,0.14)' : 'rgba(255,255,255,0.06)';
        });
        render(filtered());
      });
      el.appendChild(btn);
    });
  }

  function filtered() {
    const q = (document.getElementById('searchInput').value || '').toLowerCase().trim();
    return allAddons.filter(a => {
      const matchQ = !q || (a.name || '').toLowerCase().includes(q) || (a.description || '').toLowerCase().includes(q);
      const matchT = !activeTag || (a.tags || []).includes(activeTag);
      return matchQ && matchT;
    });
  }

  function render(list) {
    hide('storeLoading');
    const grid = document.getElementById('storeGrid');

    if (!list.length) {
      hide('storeGrid');
      show('storeEmpty');
      return;
    }

    hide('storeEmpty');
    grid.innerHTML = '';

    list.forEach(addon => {
      const installed = INSTALLED.has(addon.id);
      const card      = document.createElement('div');
      card.className  = 's-card';
      card.style.opacity = '0';
      card.style.transform = 'translateY(6px)';

      const tagsHtml = (addon.tags || []).slice(0, 3).map(t => `<span class="s-tag">${esc(t)}</span>`).join('');
      const badge    = installed ? 's-badge s-badge-installed' : badgeClass(addon.status);
      const badgeTxt = installed ? 'Installed' : (addon.status || 'working');

      card.innerHTML = `
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;">
          <div class="s-icon" data-icon-id="${esc(addon.id)}">
            ${defaultAddonIconHtml}
          </div>
          <span class="${badge}">${esc(badgeTxt)}</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;flex:1;min-width:0;">
          <p style="font-size:13px;font-weight:600;color:#e5e5e5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(addon.name)}</p>
          <p style="font-size:12px;color:#525252;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">${esc(addon.description)}</p>
        </div>
        ${tagsHtml ? `<div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:auto;">${tagsHtml}</div>` : ''}`;

      if (addon.icon) {
        const iconEl = card.querySelector('[data-icon-id]');
        const img    = new Image();
        img.style.cssText = 'width:20px;height:20px;object-fit:contain;display:block;';
        img.onload = () => { iconEl.innerHTML = ''; iconEl.appendChild(img); };
        img.src = addon.icon;
      }

      card.addEventListener('click', () => openModal(addon));
      grid.appendChild(card);
      const i = grid.children.length - 1;
      setTimeout(function() {
        card.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
        setTimeout(function() { card.style.transition = ''; card.style.opacity = ''; card.style.transform = ''; }, 220);
      }, i * 35);
    });

    showGrid('storeGrid');
  }

  document.getElementById('searchInput').addEventListener('input', () => render(filtered()));
  document.getElementById('clearSearch').addEventListener('click', () => {
    document.getElementById('searchInput').value = '';
    activeTag = null;
    document.querySelectorAll('#tagFilters button').forEach(b => {
      b.style.background  = 'rgba(255,255,255,0.04)';
      b.style.color       = '#525252';
      b.style.borderColor = 'rgba(255,255,255,0.06)';
    });
    render(filtered());
  });

  function openModal(addon) {
    currentAddon = addon;
    const inst   = INSTALLED.has(addon.id);

    const iconEl = document.getElementById('mIcon');
    iconEl.innerHTML = defaultAddonIconHtml;
    if (addon.icon) {
      const img = new Image();
      img.style.cssText = 'width:20px;height:20px;object-fit:contain;display:block;';
      img.onload = () => { iconEl.innerHTML = ''; iconEl.appendChild(img); };
      img.src = addon.icon;
    }

    document.getElementById('mName').textContent = addon.name || '';
    const statusEl       = document.getElementById('mStatus');
    statusEl.textContent = inst ? 'Installed' : (addon.status || 'working');
    statusEl.className   = inst ? 's-badge s-badge-installed' : badgeClass(addon.status);
    document.getElementById('mMeta').textContent = 'by ' + (addon.author || 'Unknown') + (addon.version ? ' · v' + addon.version : '');
    document.getElementById('mDesc').textContent = addon.longDescription || addon.description || 'No description available.';
    document.getElementById('mGhBtn').href       = addon.github || ('https://github.com/airlinklabs/addons/tree/main/' + addon.id);

    const featEl = document.getElementById('mFeatures');
    featEl.innerHTML = '';
    if ((addon.features || []).length) {
      const lbl = document.createElement('p');
      lbl.style.cssText = 'font-size:10px;color:#404040;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;';
      lbl.textContent = 'Features';
      featEl.appendChild(lbl);
      addon.features.forEach(f => {
        const row     = document.createElement('div');
        row.className = 'feat-row';
        row.innerHTML = '<div class="feat-dot"></div><span>' + esc(f) + '</span>';
        featEl.appendChild(row);
      });
    }

    const guideEl = document.getElementById('mCmdGuide');
    guideEl.innerHTML = '';

    if (addon.installRepo) {
      const repoLine = document.createElement('div');
      repoLine.style.cssText = 'font-size:11px;color:#525252;margin-bottom:12px;display:flex;align-items:center;gap:6px;';
      repoLine.innerHTML = githubIconHtml
        + '<span style="font-family:ui-monospace,monospace;">' + esc(addon.installRepo) + '</span>'
        + '<span style="color:#404040;"> @ ' + esc(addon.installBranch || 'main') + '</span>';
      guideEl.appendChild(repoLine);
    }

    const commands = addon.installCommands || {};
    const keys     = Object.keys(commands).sort((a, b) => Number(a) - Number(b));
    if (keys.length) {
      const lbl = document.createElement('p');
      lbl.style.cssText = 'font-size:10px;color:#404040;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px;';
      lbl.textContent = 'Commands';
      guideEl.appendChild(lbl);
      const block     = document.createElement('div');
      block.className = 'm-cmd-list';
      keys.forEach(k => {
        const c       = document.createElement('code');
        c.textContent = k + '.  ' + commands[k];
        block.appendChild(c);
      });
      guideEl.appendChild(block);
    }

    if (addon.installNote) {
      const note     = document.createElement('div');
      note.className = 'm-note';
      note.innerHTML = infoIconHtml + '<span>' + esc(addon.installNote) + '</span>';
      guideEl.appendChild(note);
    }

    setActionBtn(inst);
    switchTab('overview');
    hide('mTerminal');
    document.getElementById('mTermLog').innerHTML = '';

    document.getElementById('mOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('mOverlay').classList.remove('open');
    document.body.style.overflow = '';
    document.getElementById('mGiscus').innerHTML = '';
    currentAddon = null;
  }

  function setActionBtn(installed) {
    const btn = document.getElementById('mActionBtn');
    const lbl = document.getElementById('mActionLabel');
    const ico = document.getElementById('mActionIcon');
    if (installed) {
      btn.className   = 'btn-remove';
      ico.innerHTML   = '<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>';
      lbl.textContent = 'Uninstall';
    } else {
      btn.className   = 'btn-install';
      ico.innerHTML   = '<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>';
      lbl.textContent = 'Install';
    }
    btn.disabled = false;
  }

  function switchTab(name) {
    document.querySelectorAll('.m-tab').forEach(t => t.classList.toggle('on', t.dataset.tab === name));
    document.querySelectorAll('.m-pane').forEach(p => p.classList.toggle('on', p.id === 'm-pane-' + name));
  }

  document.querySelectorAll('.m-tab').forEach(t => t.addEventListener('click', () => {
    switchTab(t.dataset.tab);
    if (t.dataset.tab === 'reviews' && currentAddon) loadGiscus(currentAddon);
  }));

  document.getElementById('mClose').addEventListener('click', closeModal);
  document.getElementById('mOverlay').addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  function loadGiscus(addon) {
    const c = document.getElementById('mGiscus');
    c.innerHTML = '';
    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.setAttribute('data-repo', 'airlinklabs/addons');
    s.setAttribute('data-repo-id', '');
    s.setAttribute('data-category', 'General');
    s.setAttribute('data-category-id', '');
    s.setAttribute('data-mapping', 'specific');
    s.setAttribute('data-term', addon.name || addon.id);
    s.setAttribute('data-reactions-enabled', '1');
    s.setAttribute('data-emit-metadata', '0');
    s.setAttribute('data-input-position', 'bottom');
    s.setAttribute('data-theme', 'dark');
    s.setAttribute('data-lang', 'en');
    s.setAttribute('data-loading', 'lazy');
    s.crossOrigin = 'anonymous';
    s.async = true;
    c.appendChild(s);
  }

  document.getElementById('mActionBtn').addEventListener('click', async function () {
    if (!currentAddon) return;
    const btn  = document.getElementById('mActionBtn');
    const slug = currentAddon.id;

    if (INSTALLED.has(slug)) {
      btn.disabled = true;
      document.getElementById('mActionLabel').textContent = 'Removing...';
      try {
        const res  = await fetch('/admin/addons/store/uninstall', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug }),
        });
        const data = await res.json();
        if (data.success) {
          INSTALLED.delete(slug);
          showToast(data.message, 'success');
          closeModal();
          render(filtered());
        } else {
          showToast(data.message || 'Failed to uninstall', 'error');
          setActionBtn(true);
        }
      } catch {
        showToast('Something went wrong.', 'error');
        setActionBtn(true);
      }
      return;
    }

    switchTab('install');
    const terminal  = document.getElementById('mTerminal');
    const termBar   = document.getElementById('mTermBar');
    const termLabel = document.getElementById('mTermLabel');
    const termPct   = document.getElementById('mTermPct');
    const termLog   = document.getElementById('mTermLog');

    terminal.style.display = '';
    termLog.innerHTML      = '';
    termBar.style.width    = '0%';
    termLabel.textContent  = 'Starting...';
    termPct.textContent    = '0%';
    btn.disabled           = true;
    document.getElementById('mActionLabel').textContent = 'Installing...';

    function logLine(text, cls) {
      const d = document.createElement('div');
      if (cls) d.className = cls;
      d.textContent = text;
      termLog.appendChild(d);
      termLog.scrollTop = termLog.scrollHeight;
    }

    function setProgress(pct, label) {
      termBar.style.width  = pct + '%';
      termPct.textContent  = pct + '%';
      if (label) termLabel.textContent = label;
    }

    try {
      const res = await fetch('/admin/addons/store/install', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });

      const ct = res.headers.get('content-type') || '';
      if (!res.ok || ct.includes('application/json')) {
        const data = await res.json();
        logLine('Error: ' + (data.message || 'Server error'), 'l-err');
        termLabel.textContent = 'Failed';
        showToast(data.message || 'Install failed', 'error');
        setActionBtn(false);
        return;
      }

      const reader     = res.body.getReader();
      const decoder    = new TextDecoder();
      let buf          = '';
      const totalSteps = Object.keys(currentAddon.installCommands || {}).length + 3;
      let done         = 0;

      outer: while (true) {
        const { done: end, value } = await reader.read();
        if (end) break;
        buf += decoder.decode(value, { stream: true });
        const parts = buf.split('\n\n');
        buf = parts.pop();

        for (const part of parts) {
          const raw = part.replace(/^data:\s*/m, '').trim();
          if (!raw) continue;
          let evt;
          try { evt = JSON.parse(raw); } catch { continue; }

          if (evt.type === 'step') {
            done++;
            setProgress(Math.min(Math.round(done / totalSteps * 85), 85), evt.step || 'Running...');
            logLine('> ' + (evt.step || '') + (evt.cmd ? ': ' + evt.cmd : ''), 'l-step');
          } else if (evt.type === 'cmd') {
            done++;
            setProgress(Math.min(Math.round(done / totalSteps * 85), 85), evt.step || 'Running...');
            logLine('$ ' + evt.cmd, 'l-cmd');
          } else if (evt.type === 'output') {
            logLine(evt.output, 'l-output');
          } else if (evt.type === 'done') {
            setProgress(100, 'Installed');
            logLine(evt.message, 'l-ok');
            INSTALLED.add(slug);
            setActionBtn(true);
            showToast(evt.message, 'success');
            render(filtered());
            break outer;
          } else if (evt.type === 'error') {
            logLine('Error: ' + evt.message, 'l-err');
            termLabel.textContent = 'Failed';
            showToast(evt.message, 'error');
            setActionBtn(false);
            break outer;
          }
        }
      }
    } catch (err) {
      logLine('Error: ' + err.message, 'l-err');
      termLabel.textContent = 'Failed';
      showToast('Installation failed', 'error');
      setActionBtn(false);
    }
  });

  loadStore();
})();
</script>

<% } else { %>
<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="w-60 h-full"><%- include('../../components/template') %></div>
    <div id="page-content" class="flex-1 p-6 overflow-y-auto pt-16">

      <div class="sm:flex sm:items-center px-8 pt-4">
        <%- include('../../components/pageTitle', { title: 'Addons', description: 'Browse and install addons from the community store' }) %>
      </div>

      <div class="mx-8 mt-6 flex border-b border-neutral-200 dark:border-neutral-800">
        <a href="/admin/addons" class="px-1 py-2.5 mr-5 text-sm font-medium text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 border-b-2 border-transparent -mb-px transition">Installed <span class="ml-1 text-xs"><%= addons ? addons.length : 0 %></span></a>
        <span class="px-1 py-2.5 text-sm font-medium text-neutral-800 dark:text-white border-b-2 border-neutral-800 dark:border-white -mb-px">Store</span>
      </div>

      <div class="mx-8 mt-5 flex items-center gap-3 flex-wrap mb-1">
        <input id="addonStoreFilterInput" type="text" placeholder="Search addons…" class="w-52 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 px-3 py-2 text-sm text-neutral-800 dark:text-white placeholder-neutral-400 dark:placeholder-neutral-500 focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 outline-none focus:border-neutral-400 dark:focus:border-neutral-600 transition">
        <div id="tagFilters" class="flex gap-2 flex-wrap"></div>
        <span id="statusText" class="text-xs text-neutral-400 dark:text-neutral-500 ml-auto whitespace-nowrap"></span>
      </div>

      <div id="loadingEl" class="m-8 space-y-2"><% for(let i=0;i<8;i++){%><div class="sk h-11 w-full"></div><%}%></div>
      <div id="errorEl" style="display:none" class="mx-8 mt-6 py-16 text-center"><p id="errorMsg" class="text-sm text-neutral-500"></p><button onclick="loadStore()" class="mt-3 text-xs text-neutral-400 underline cursor-pointer bg-transparent border-none">Retry</button></div>
      <div id="emptyEl" style="display:none" class="mx-8 mt-6 py-16 text-center"><p class="text-sm text-neutral-500">No addons match your search.</p><button id="clearSearch" class="mt-3 text-xs text-neutral-400 underline cursor-pointer bg-transparent border-none">Clear</button></div>

      <div id="tableWrap" style="display:none" class="overflow-x-auto shadow-sm rounded-xl m-8 border border-neutral-200 dark:border-neutral-800/40">
        <table class="min-w-full divide-y divide-neutral-200 dark:divide-white/10">
          <thead class="bg-neutral-50 dark:bg-neutral-800/50">
            <tr>
              <th class="py-3.5 pl-6 pr-3 text-left text-sm font-medium text-neutral-800 dark:text-white">Name</th>
              <th class="px-3 py-3.5 text-left text-sm font-medium text-neutral-800 dark:text-white col-hide">Author</th>
              <th class="px-3 py-3.5 text-left text-sm font-medium text-neutral-800 dark:text-white col-hide">Status</th>
              <th class="px-3 py-3.5 text-left text-sm font-medium text-neutral-800 dark:text-white">Actions</th>
            </tr>
          </thead>
          <tbody id="tableBody" class="divide-y divide-neutral-100 dark:divide-white/5 bg-white dark:bg-neutral-800"></tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<div class="modal-overlay" id="detailOverlay">
  <div class="modal-box">
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-200 dark:border-white/5 flex-shrink-0">
      <div class="flex items-center gap-2 min-w-0">
        <p id="dlgName" class="text-sm font-semibold text-neutral-800 dark:text-white truncate"></p>
        <span id="dlgStatus" class="text-[10px] font-medium px-2 py-0.5 rounded-full whitespace-nowrap"></span>
      </div>
      <div class="flex items-center gap-2 ml-3 shrink-0">
        <a id="dlgGh" href="#" target="_blank" rel="noopener" class="rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 px-3 py-1.5 text-xs font-medium transition flex items-center gap-1.5">
          <%- icon('external-link', { size: 12, class: 'shrink-0' }) %>
          GitHub
        </a>
        <button onclick="closeDetail()" class="w-7 h-7 flex items-center justify-center rounded-xl hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-400 transition">
          <%- icon('x', { size: 16, class: 'shrink-0' }) %>
        </button>
      </div>
    </div>
    <div class="modal-two-col">
      <div class="modal-left">
        <p id="dlgMeta" class="text-[11px] text-neutral-400 dark:text-neutral-500"></p>
        <p id="dlgDesc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed"></p>
        <div id="dlgFeats" class="flex flex-col gap-1"></div>
        <div class="mt-auto flex flex-col gap-2 pt-2">
          <div id="termBox" class="term-box">
            <div class="flex justify-between items-center">
              <span id="termLabel" class="text-[11px] font-medium text-neutral-600 dark:text-neutral-300">Starting…</span>
              <span id="termPct" class="text-[10px] text-neutral-400 font-mono">0%</span>
            </div>
            <div class="prog-track"><div id="progFill" class="prog-fill"></div></div>
            <div id="termLog" class="term-log"></div>
          </div>
          <div id="dlgErr" style="display:none" class="err-box"><p id="dlgErrTxt" class="err-txt"></p></div>
          <button id="actionBtn" type="button"
            class="w-full rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 py-2.5 text-sm font-medium transition">
            Install
          </button>
        </div>
      </div>
      <div class="modal-right">
        <p class="text-[10px] font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-3">About</p>
        <div id="dlgLong" class="md-body"></div>
      </div>
    </div>
  </div>
</div>

<div id="page-data" style="display:none"
  data-installed-slugs="<%- JSON.stringify((addons||[]).map(a=>a.slug)) %>"
  data-default-addon-icon="<%- icon('puzzle', { class: 's-icon-svg', style: 'width:16px;height:16px;color:#404040;', strokeWidth: 1.5 }) %>"
  data-github-icon="<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor' style='width:11px;height:11px;flex-shrink:0;'><path d='M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z'/></svg>"
  data-info-icon="<%- icon('info', { style: 'width:13px;height:13px;color:#525252;', strokeWidth: 1.5 }) %>"
></div>

<script nonce="<%- nonce %>" src="/js/admin/addons-store.js"></script>
<% } %>

<%- include('../../components/footer') %>
