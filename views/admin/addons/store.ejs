<%- include('../../components/header', { title: 'Addon Store' }) %>
<%- include('../../components/toast') %>

<style>
  ::-webkit-scrollbar { display: none; }
</style>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/template') %></div>
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Addons', href: '/admin/addons' },
        { label: 'Store' }
      ] }) %>

      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Addon Store</h1>
          <p class="al-page-desc">Browse and install addons from the community</p>
        </div>
      </div>

      <div class="al-page-body">
        <div class="flex" style="border-bottom:1px solid var(--theme-border)">
          <a href="/admin/addons" class="px-1 py-2.5 mr-5 text-sm font-medium text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 border-b-2 border-transparent -mb-px transition">Installed <% if (typeof addons !== 'undefined') { %><span class="ml-1 text-xs text-neutral-400"><%= addons.length %></span><% } %></a>
          <span class="px-1 py-2.5 text-sm font-medium text-neutral-800 dark:text-white border-b-2 border-neutral-800 dark:border-white -mb-px">Store</span>
        </div>

        <div class="flex flex-col items-center justify-center py-24 text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border);">
            <%- icon('package', { class: 'w-6 h-6', style: 'color:var(--theme-text-muted)' }) %>
          </div>
          <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)">Coming Soon</h3>
          <p class="text-sm mt-1 max-w-xs" style="color:var(--theme-text-muted)">The addon store is under development. Check back later for community addons and extensions.</p>
          <a href="/admin/addons" class="mt-5 al-btn-secondary">Back to Addons</a>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('../../components/footer') %>
