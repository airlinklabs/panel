<%- include('../../layouts/admin', { title: t('addonStoreTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('addonsTitle'), url: '/admin/addons' },
    { label: t('storeTab') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('addonStoreTitle') %></h1>
    <p class="al-page-desc"><%= t('addonStoreDesc') %></p>
  </div>
</div>

<div class="al-page-body">
  <nav class="al-segmented mb-5" role="group" aria-label="<%= t('addonsViews') %>">
    <a href="/admin/addons" class="al-segmented-btn"><%= t('installedTab') %><span class="ml-1 text-xs al-text-muted"><%= typeof addons !== 'undefined' && addons ? addons.length : 0 %></span></a>
    <a href="/admin/addons/store" class="al-segmented-btn" aria-current="page"><%= t('storeTab') %></a>
  </nav>

  <div id="storeContent">
    <%- include('../../partials/empty-state', {
      iconName: 'package',
      title: t('addonStoreTitle'),
      description: t('addonStoreEmptyDesc'),
      action: '<a href="/admin/addons" class="al-btn-secondary">' + t('backToAddons') + '</a>'
    }) %>
  </div>
</div>

<%- include('../../layouts/admin-footer') %>
