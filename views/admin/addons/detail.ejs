<%- include('../../layouts/admin', { title: addon.name || t('addonFallbackTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('addonsTitle'), url: '/admin/addons' },
    { label: addon.name || t('addonFallbackTitle') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= addon.name || t('addonFallbackTitle') %></h1>
    <p class="al-page-desc"><%= addon.description || '' %></p>
    <div class="flex flex-wrap items-center gap-3 mt-2">
      <% if (addon.version) { %><span class="text-xs" style="color:var(--theme-text-muted)">v<%= addon.version %></span><% } %>
      <% if (addon.author) { %><span class="text-xs" style="color:var(--theme-text-muted)"><%= t('byAuthor', { author: addon.author }) %></span><% } %>
      <% if (addon.enabled) { %>
      <span class="al-badge al-badge-online"><%= t('enabled') %></span>
      <% } else { %>
      <span class="al-badge al-badge-neutral"><%= t('disabled') %></span>
      <% } %>
    </div>
  </div>
  <div>
    <a href="/admin/addons" class="al-btn-secondary">
      <%- icon('arrow-left', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('back') %></span>
    </a>
    <button type="button" id="addonToggleBtn" class="al-btn-secondary" data-slug="<%= addon.slug %>" data-enabled="<%= addon.enabled %>">
      <%- icon(addon.enabled ? 'pause' : 'play', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= addon.enabled ? t('disable') : t('enable') %></span>
    </button>
    <button type="button" id="addonUninstallBtn" class="al-btn-danger" data-slug="<%= addon.slug %>" data-name="<%= addon.name %>">
      <%- icon('trash-2', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('uninstall') %></span>
    </button>
  </div>
</div>

<div class="al-page-body space-y-5">

  <% if (addon.settings && Object.keys(addon.settings).length > 0) { %>
  <!-- Settings -->
  <div class="al-card">
    <div class="al-card-header">
      <p class="al-card-header-title"><%= t('settings') %></p>
    </div>
    <div class="al-card-body">
      <form id="addonSettingsForm" class="space-y-4">
        <% Object.entries(addon.settings).forEach(function([key, value]) { %>
        <div class="al-form-field max-w-md">
          <label class="al-form-label"><%= key %></label>
          <% if (typeof value === 'boolean') { %>
          <label class="al-setting-row">
            <span class="al-setting-copy"><span class="al-setting-title"><%= key %></span></span>
            <span class="al-setting-control">
              <input type="checkbox" name="<%= key %>" class="sr-only peer" <%= value ? 'checked' : '' %>>
              <span class="al-toggle-track"><span class="al-toggle-dot"></span></span>
            </span>
          </label>
          <% } else { %>
          <input type="text" name="<%= key %>" value="<%= value %>" class="al-form-input">
          <% } %>
        </div>
        <% }); %>
        <button type="submit" class="al-btn-primary">
          <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('saveSettings') %></span>
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <% if (addon.capabilities && addon.capabilities.length > 0) { %>
  <!-- Capabilities -->
  <div class="al-card">
    <div class="al-card-header">
      <p class="al-card-header-title"><%= t('capabilities') %></p>
    </div>
    <div class="al-card-body">
      <% addon.capabilities.forEach(function(cap) { %>
      <div class="al-setting-row">
        <div class="al-setting-copy">
          <p class="al-setting-title"><%= cap.name || cap %></p>
          <% if (cap.description) { %><p class="al-setting-desc"><%= cap.description %></p><% } %>
        </div>
        <label class="al-setting-control">
          <input type="checkbox" class="sr-only peer capability-toggle" data-slug="<%= addon.slug %>" data-capability="<%= cap.name || cap %>" aria-label="<%= cap.name || cap %>" <%= cap.enabled ? 'checked' : '' %>>
          <span class="al-toggle-track"><span class="al-toggle-dot"></span></span>
        </label>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <% if (addon.commands && addon.commands.length > 0) { %>
  <!-- Commands -->
  <div class="al-card">
    <div class="al-card-header">
      <p class="al-card-header-title"><%= t('commands') %></p>
    </div>
    <div class="al-card-body">
      <div class="flex flex-wrap gap-2">
        <% addon.commands.forEach(function(cmd) { %>
        <button type="button" class="al-btn-secondary addon-command-btn" data-slug="<%= addon.slug %>" data-command="<%= cmd.name || cmd %>">
          <%- icon('terminal', { class: 'size-3.5', strokeWidth: 1.5 }) %><span><%= cmd.name || cmd %></span>
        </button>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>

</div>

<script nonce="<%- nonce %>">
(function() {
  var csrfToken = '<%= csrfToken %>';
  var msgApplying = <%- JSON.stringify(t('applyingChanges')) %>;
  var msgUpdated = <%- JSON.stringify(t('addonUpdated')) %>;
  var msgRemoving = <%- JSON.stringify(t('removingFiles')) %>;
  var msgUninstalled = <%- JSON.stringify(t('addonUninstalled')) %>;
  var msgWentWrong = <%- JSON.stringify(t('somethingWentWrong')) %>;
  var msgActionFailed = <%- JSON.stringify(t('addonActionFailed')) %>;
  var msgSaved = <%- JSON.stringify(t('settingsSaved')) %>;
  var msgSaveFailed = <%- JSON.stringify(t('failedToSave')) %>;
  var msgCapability = <%- JSON.stringify(t('capabilityUpdated')) %>;
  var msgUninstallTitle = <%- JSON.stringify(t('uninstallAddonTitle')) %>;
  var msgUninstallBody = <%- JSON.stringify(t('uninstallAddonBody')) %>;
  var msgUninstallAction = <%- JSON.stringify(t('uninstall')) %>;
  var msgRunning = <%- JSON.stringify(t('runningCommand')) %>;
  var msgCommandDone = <%- JSON.stringify(t('commandCompleted')) %>;
  var msgCommandFailed = <%- JSON.stringify(t('commandFailed')) %>;

  // Toggle
  var toggleBtn = document.getElementById('addonToggleBtn');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', function() {
      var slug = this.dataset.slug;
      var enabled = this.dataset.enabled === 'true';
      showProgressToast(msgApplying);
      fetch('/admin/addons/toggle/' + slug, {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({ enabled: (!enabled).toString() }),
      }).then(function(r) { return r.json(); }).then(function(data) {
        if (data.success) { showToast(msgUpdated, 'success'); window.location.reload(); }
        else showToast(data.message || msgActionFailed, 'error');
      }).catch(function() { showToast(msgWentWrong, 'error'); });
    });
  }

  // Uninstall
  var uninstallBtn = document.getElementById('addonUninstallBtn');
  if (uninstallBtn) {
    uninstallBtn.addEventListener('click', function() {
      var slug = this.dataset.slug;
      var name = this.dataset.name;
      window.modal && window.modal.confirm
        ? window.modal.confirm({
            title: msgUninstallTitle,
            body: msgUninstallBody.replace('{{name}}', name),
            danger: true, confirmLabel: msgUninstallAction,
            onConfirm: function() {
              showProgressToast(msgRemoving);
              fetch('/admin/addons/uninstall/' + slug, { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken } })
                .then(function(r) { return r.json(); }).then(function(data) {
                  if (data.success) { showToast(msgUninstalled, 'success'); window.location.href = '/admin/addons'; }
                  else showToast(data.message || msgActionFailed, 'error');
                }).catch(function() { showToast(msgWentWrong, 'error'); });
            }
          })
        : null;
    });
  }

  // Settings form
  var settingsForm = document.getElementById('addonSettingsForm');
  if (settingsForm) {
    settingsForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var formData = new FormData(this);
      var data = {};
      formData.forEach(function(val, key) { data[key] = val; });
      document.querySelectorAll('#addonSettingsForm input[type="checkbox"]').forEach(function(cb) {
        data[cb.name] = cb.checked;
      });
      var slug = toggleBtn ? toggleBtn.dataset.slug : '';
      fetch('/admin/addons/settings/' + slug, {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify(data),
      }).then(function(r) { return r.json(); }).then(function(res) {
        if (res.success) { showToast(msgSaved, 'success'); }
        else { showToast(res.message || msgSaveFailed, 'error'); }
      }).catch(function() { showToast(msgSaveFailed, 'error'); });
    });
  }

  // Capability toggles
  document.querySelectorAll('.capability-toggle').forEach(function(cb) {
    cb.addEventListener('change', function() {
      var slug = this.dataset.slug;
      var capability = this.dataset.capability;
      fetch('/admin/addons/capability/' + slug, {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({ capability: capability, enabled: this.checked }),
      }).then(function(r) { return r.json(); }).then(function(res) {
        if (res.success) { showToast(msgCapability, 'success'); }
        else { showToast(res.message || msgActionFailed, 'error'); }
      }).catch(function() { showToast(msgActionFailed, 'error'); });
    });
  });

  // Command buttons
  document.querySelectorAll('.addon-command-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var slug = this.dataset.slug;
      var command = this.dataset.command;
      showProgressToast(msgRunning.replace('{{command}}', command));
      fetch('/admin/addons/command/' + slug + '/' + command, {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      }).then(function(r) { return r.json(); }).then(function(data) {
        if (data.success) { showToast(msgCommandDone.replace('{{command}}', command), 'success'); }
        else { showToast(data.message || msgCommandFailed.replace('{{command}}', command), 'error'); }
      }).catch(function() { showToast(msgCommandFailed.replace('{{command}}', command), 'error'); });
    });
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
