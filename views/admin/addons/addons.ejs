<%- include('../../components/header', { title: 'Addons' }) %>
<%- include('../../components/loadingPopup') %>

<style>
  ::-webkit-scrollbar { display: none; }
</style>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <div id="page-content" x-data="addonManager()" class="flex-1 overflow-y-auto pt-0 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Addons' }
      ] }) %>

      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Addons</h1>
          <p class="al-page-desc">Manage installed addons and browse the store</p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button id="reloadBtn" type="button" class="al-btn-secondary"><%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %>Reload</button>
        </div>
      </div>

      <div class="al-page-body">
      <div class="flex">
        <span class="px-3 py-2 mr-4 text-sm font-medium rounded-lg" style="background:var(--theme-primary);color:var(--theme-accent-text)">Installed <span class="ml-1 text-xs" style="color:var(--theme-text-muted)"><%= addons ? addons.length : 0 %></span></span>
        <a href="/admin/addons/store" class="px-3 py-2 text-sm font-medium" style="color:var(--theme-text-muted)">Store</a>
      </div>

      <% if (!addonTableExists) { %>
      <div class="mt-5 rounded-xl bg-amber-600/20 dark:bg-amber-800/10 px-4 py-4 border-0 flex items-start gap-3" style="border-color:var(--theme-warning)">
        <%- icon('triangle-alert', { size: 20, class: 'mt-0.5 shrink-0', style: 'color:var(--theme-warning)' }) %>
        <div>
          <p class="text-sm font-medium" style="color:var(--theme-warning);">Database migration required</p>
          <p class="mt-1 text-xs" style="color:var(--theme-warning);opacity:0.8;">Run <code class="px-1 py-0.5 rounded font-mono bg-amber-500/10 dark:bg-amber-400/10">npm run migrate:dev</code> then restart.</p>
        </div>
      </div>
      <% } %>

      <% if (addons && addons.length > 0) { %>
      <div class="mt-5 mb-1">
        <input id="addonSearchInput" type="text" placeholder="Filter addons…" aria-label="Search addons" class="al-input w-56">
      </div>
      <div class="overflow-x-auto shadow-sm rounded-xl mt-3 border" style="border-color:var(--theme-border)">
        <table class="al-table min-w-full">
          <colgroup>
            <col style="min-width:240px">
            <col style="min-width:160px">
            <col style="min-width:120px">
            <col style="min-width:200px">
          </colgroup>
          <thead class="al-table-head">
            <tr>
              <th class="al-table-th py-3.5 pl-6 pr-3">Name</th>
              <th class="al-table-th px-3 py-3.5 col-hide">Version</th>
              <th class="al-table-th px-3 py-3.5 col-hide">Status</th>
              <th class="al-table-th px-3 py-3.5">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y" style="border-color:var(--theme-border)">
            <% let addonIdx = 0; addons.forEach(function(addon) { %>
            <tr class="al-table-tr transition-colors addon-row"
                style="--i:<%= addonIdx++ %>"
                data-slug="<%= addon.slug %>"
                data-search="<%= (addon.name + ' ' + (addon.description||'') + ' ' + (addon.author||'')).toLowerCase() %>">
              <td class="al-table-td whitespace-nowrap py-4 pl-6 pr-3">
                <p class="font-medium" style="color:var(--theme-text-strong)"><%= addon.name %></p>
                <% if (addon.description) { %><p class="text-xs mt-0.5 max-w-xs truncate" style="color:var(--theme-text-muted)"><%= addon.description %></p><% } %>
              </td>
              <td class="al-table-td whitespace-nowrap px-3 py-4 col-hide">v<%= addon.version %><% if (addon.author) { %> · <%= addon.author %><% } %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm col-hide">
                <% if (addon.hasDisabledPh) { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-warning-bg);color:var(--theme-warning);--tw-ring-color:color-mix(in srgb, var(--theme-warning) 25%, transparent);">Not enabled</span>
                <% } else if (addon.enabled) { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-success-bg);color:var(--theme-success);--tw-ring-color:color-mix(in srgb, var(--theme-success) 25%, transparent);">Enabled</span>
                <% } else { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted);box-shadow:inset 0 0 0 1px var(--theme-border)">Disabled</span>
                <% } %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <div class="flex gap-2">
                  <button  @click="toggleAddon('<%= addon.slug %>', <%= !addon.enabled %>)" type="button"
                    class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition">
                    <%= addon.enabled ? 'Disable' : 'Enable' %>
                  </button>
                  <button  @click="confirmUninstall('<%= addon.slug %>', '<%= addon.name %>')" type="button"
                    class="al-btn-danger" aria-label="Uninstall <%= addon.name %>">
                    <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <div id="addonNoResults" class="hidden py-10 text-center text-sm" style="background:var(--theme-bg-card);color:var(--theme-text-muted)">No addons match your search.</div>
      </div>
      <% } else { %>
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <p class="text-sm" style="color:var(--theme-text-muted)"><% if (addonTableExists) { %>No addons installed<% } else { %>Migration required<% } %></p>
        <% if (addonTableExists) { %>
        <a href="/admin/addons/store" class="mt-4 al-btn-secondary inline-flex items-center gap-1.5"><%- icon('store', { class: 'size-4', strokeWidth: 1.5 }) %>Browse Store</a>
        <% } %>
      </div>
      <% } %>
      </div>
    </div>
  </div>
</main>

<script nonce="<%- nonce %>">
function addonManager() {
  const BADGE_ENABLED = 'status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-emerald-600/20 dark:ring-emerald-400/20';
  const BADGE_DISABLED = 'status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset bg-neutral-100 dark:bg-white/5 text-neutral-600 dark:text-neutral-300 ring-neutral-300 dark:ring-white/10';
  return {
    init() {
      document.getElementById('reloadBtn').addEventListener('click', () => {
        showLoadingPopup('Reloading addons…', 'Please wait…');
        fetch('/api/v2/admin/addons/reload', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
          .then(r => r.json()).then(data => { hideLoadingPopup(); showToast(data.message || (data.success ? 'Reloaded' : 'Failed'), data.success ? 'success' : 'error'); })
          .catch(() => { hideLoadingPopup(); showToast('Something went wrong.', 'error'); });
      });
      const addonSearchInput = document.getElementById('addonSearchInput');
      if (addonSearchInput) {
        addonSearchInput.addEventListener('input', function() {
          const q = this.value.toLowerCase().trim();
          let visible = 0;
          document.querySelectorAll('.addon-row').forEach(row => {
            const match = !q || row.dataset.search.includes(q);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
          });
          const noResults = document.getElementById('addonNoResults');
          if (noResults) noResults.classList.toggle('hidden', visible > 0 || !q);
        });
      }
    },
    toggleAddon(slug, enable) {
      showLoadingPopup('Updating addon…', 'Applying changes…');
      fetch('/api/v2/admin/addons/' + slug + '/toggle', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: enable.toString() }),
      }).then(r => r.json()).then(data => {
        hideLoadingPopup();
        if (data.success) { showToast('Addon updated', 'success'); this.updateRow(slug, enable); }
        else showToast(data.message || 'Failed', 'error');
      }).catch(() => { hideLoadingPopup(); showToast('Something went wrong.', 'error'); });
    },
    updateRow(slug, enabled) {
      const row = document.querySelector('[data-slug="' + slug + '"]');
      if (!row) return;
      const badge = row.querySelector('.status-badge');
      if (badge) {
        badge.className = enabled ? BADGE_ENABLED : BADGE_DISABLED;
        badge.textContent = enabled ? 'Enabled' : 'Disabled';
      }
      const btn = row.querySelector('.toggle-btn');
      if (btn) { btn.textContent = enabled ? 'Disable' : 'Enable'; btn.onclick = () => this.toggleAddon(slug, !enabled); }
    },
    confirmUninstall(slug, name) {
      window.modal && window.modal.confirm
        ? window.modal.confirm({ title: 'Uninstall Addon', body: 'Uninstall "' + name + '"? This cannot be undone.', danger: true, confirmLabel: 'Uninstall', onConfirm: () => this.uninstall(slug) })
        : this.uninstall(slug);
    },
    uninstall(slug) {
      showLoadingPopup('Uninstalling…', 'Removing files…');
      fetch('/api/v2/admin/addons/' + slug + '/uninstall', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug }) })
        .then(r => r.json()).then(data => {
          hideLoadingPopup();
          if (data.success) { showToast('Uninstalled', 'success'); const r = document.querySelector('[data-slug="' + slug + '"]'); if (r) r.remove(); }
          else showToast(data.message || 'Failed', 'error');
        }).catch(() => { hideLoadingPopup(); showToast('Something went wrong.', 'error'); });
    }
  };
}
</script>

<%- include('../../components/footer') %>
