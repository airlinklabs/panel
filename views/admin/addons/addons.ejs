<%- include('../../components/header', { title: 'Addons' }) %>
<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>

<style>
  ::-webkit-scrollbar { display: none; }
  @media (max-width: 640px) { .col-hide { display: none; } }
</style>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/template') %></div>
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Addons' }
      ] }) %>

      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title">Addons</h1>
          <p class="al-page-desc">Manage installed addons and browse the store</p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button id="reloadBtn" type="button" class="al-btn-secondary"><%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %>Reload</button>
        </div>
      </div>

      <div class="al-page-body">
      <div class="flex">
        <span class="px-3 py-2 mr-4 text-sm font-medium text-white dark:text-black bg-neutral-900 dark:bg-white rounded-lg">Installed <span class="ml-1 text-xs text-neutral-400"><%= addons ? addons.length : 0 %></span></span>
        <a href="/admin/addons/store" class="px-3 py-2 text-sm font-medium text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition">Store</a>
      </div>

      <% if (!addonTableExists) { %>
      <div class="mt-5 rounded-xl bg-amber-600/20 dark:bg-amber-800/10 px-4 py-4 border border-neutral-800/20 flex items-start gap-3">
        <%- icon('triangle-alert', { size: 20, class: 'mt-0.5 shrink-0 text-amber-400' }) %>
        <div>
          <p class="text-sm font-medium" style="color:var(--theme-warning);">Database migration required</p>
          <p class="mt-1 text-xs" style="color:var(--theme-warning);opacity:0.8;">Run <code class="px-1 py-0.5 rounded font-mono bg-amber-500/10 dark:bg-amber-400/10">npm run migrate:dev</code> then restart.</p>
        </div>
      </div>
      <% } %>

      <% if (addons && addons.length > 0) { %>
      <div class="mt-5 mb-1">
        <input id="addonSearchInput" type="text" placeholder="Filter addons…" class="al-input w-56">
      </div>
      <div class="overflow-x-auto shadow-sm rounded-xl mt-3 border" style="border-color:var(--theme-border)">
        <table class="al-table min-w-full">
          <thead class="al-table-head">
            <tr>
              <th class="al-table-th py-3.5 pl-6 pr-3">Name</th>
              <th class="al-table-th px-3 py-3.5 col-hide">Version</th>
              <th class="al-table-th px-3 py-3.5 col-hide">Status</th>
              <th class="al-table-th px-3 py-3.5">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y" style="border-color:var(--theme-border)">
            <% let addonIdx = 0; addons.forEach(function(addon) { %>
            <tr class="al-table-tr transition-colors addon-row"
                style="--i:<%= addonIdx++ %>"
                data-slug="<%= addon.slug %>"
                data-search="<%= (addon.name + ' ' + (addon.description||'') + ' ' + (addon.author||'')).toLowerCase() %>">
              <td class="al-table-td whitespace-nowrap py-4 pl-6 pr-3">
                <p class="font-medium" style="color:var(--theme-text-strong)"><%= addon.name %></p>
                <% if (addon.description) { %><p class="text-xs mt-0.5 max-w-xs truncate" style="color:var(--theme-text-muted)"><%= addon.description %></p><% } %>
              </td>
              <td class="al-table-td whitespace-nowrap px-3 py-4 col-hide">v<%= addon.version %><% if (addon.author) { %> · <%= addon.author %><% } %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm col-hide">
                <% if (addon.hasDisabledPh) { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-warning-bg);color:var(--theme-warning);--tw-ring-color:color-mix(in srgb, var(--theme-warning) 25%, transparent);">Not enabled</span>
                <% } else if (addon.enabled) { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-success-bg);color:var(--theme-success);--tw-ring-color:color-mix(in srgb, var(--theme-success) 25%, transparent);">Enabled</span>
                <% } else { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset bg-neutral-100 dark:bg-white/5 text-neutral-600 dark:text-neutral-300 ring-neutral-300 dark:ring-white/10">Disabled</span>
                <% } %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <div class="flex gap-2">
                  <button  onclick="toggleAddon('<%= addon.slug %>', <%= !addon.enabled %>)" type="button"
                    class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition">
                    <%= addon.enabled ? 'Disable' : 'Enable' %>
                  </button>
                  <button  onclick="confirmUninstall('<%= addon.slug %>', '<%= addon.name %>')" type="button"
                    class="al-btn-danger">
                    <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <div id="addonNoResults" class="hidden py-10 text-center text-sm text-neutral-500 dark:text-neutral-400 bg-white dark:bg-neutral-800/20">No addons match your search.</div>
      </div>
      <% } else { %>
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <p class="text-sm text-neutral-500"><% if (addonTableExists) { %>No addons installed<% } else { %>Migration required<% } %></p>
        <% if (addonTableExists) { %>
        <a href="/admin/addons/store"><button type="button" class="mt-4 al-btn-secondary"><%- icon('store', { class: 'size-4', strokeWidth: 1.5 }) %>Browse Store</button></a>
        <% } %>
      </div>
      <% } %>
      </div>
    </div>
  </div>
</main>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-addons.js"></script>

<%- include('../../components/footer') %>
