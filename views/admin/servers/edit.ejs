<%- include('../../components/header', { title: 'Edit Server' }) %>

<script nonce="<%- nonce %>">
const serverEditNames = {
  listA: ["Charged","Fiery","Mystical","Dark","Angry","Enchanted","Blazing","Cursed","Frozen","Swift","Ancient","Wicked","Luminous","Vengeful","Radiant","Thunderous","Shadow","Frost","Vibrant","Spectral","Nether","Ender","Caving","Toxic","Haunted","Radiant","Ghostly"],
  listB: ["Creeper","Dragon","Zombie","Ghoul","Enderman","Skeleton","Wither","Magma Cube","Blaze","Witch","Slime","Spider","Phantom","Villager","Pillager","Vindicator","Drowned","Illager","Ender Dragon","Husk","Stray","Ravager","Piglin","Hoglin","Shulker","Warden"],
  generate() {
    let a, b;
    do { a = this.listA[Math.floor(Math.random() * this.listA.length)]; b = this.listB[Math.floor(Math.random() * this.listB.length)]; } while (a === b);
    return a + ' ' + b;
  }
};
function serverEditPage() {
  return {
    allowStartupEdit: <%= server.allowStartupEdit ? 'true' : 'false' %>,
    suspended: <%= server.Suspended ? 'true' : 'false' %>,
    generateName() { document.getElementById('serverName').value = serverEditNames.generate(); }
  };
}
</script>

<div x-data="serverEditPage()">
<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Servers', href: '/admin/servers' },
        { label: server.name }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= server.name %></h1>
          <p class="al-page-desc"><%= req.translations.adminManageServer || 'Rename, reassign, or remove this server.' %></p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <button type="submit" form="editServerForm" class="al-btn-primary"><%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %>Save changes</button>
          <a href="/admin/servers" class="al-btn-secondary">Back to Servers</a>
        </div>
      </div>

      <div class="al-page-body space-y-5">
        <form id="editServerForm" class="space-y-5">
          <div class="al-card">
            <h2 class="al-card-header">General</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="serverName" class="al-label"><%= req.translations.name %>:</label>
                <div class="flex items-center gap-2">
                  <input id="serverName" name="name" value="<%= server.name %>" class="al-input flex-1">
                  <button type="button" @click="generateName()" class="w-9 h-9 shrink-0 flex items-center justify-center rounded-xl transition hover:bg-[var(--theme-bg-hover)]" style="color:var(--theme-text-muted);background:var(--theme-bg-input);border:1px solid var(--theme-border-input)">
                    <%- icon('dices', { size: 15 }) %>
                  </button>
                </div>
              </div>
              <div>
                <label for="serverDescription" class="al-label">
                  <%- icon('file-text', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.description %>:</label>
                <input id="serverDescription" name="description" value="<%= server.description || '' %>" class="al-input" placeholder="Server description">
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Server Configuration</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="serverOwner" class="al-label">
                  <%- icon('user', { size: 14, class: 'shrink-0' }) %>
                  Owner:</label>
                <select id="serverOwner" name="ownerId" class="hidden">
                  <% users.forEach(userOption => { %>
                    <option value="<%= userOption.id %>" <%= userOption.id === server.ownerId ? 'selected' : '' %>><%= userOption.username %></option>
                  <% }); %>
                </select>
                <div class="custom-select mt-2" data-for="serverOwner"></div>
              </div>

              <div>
                <label for="serverNode" class="al-label">
                  <%- icon('server', { size: 14, class: 'shrink-0' }) %>
                  Node:</label>
                <select id="serverNode" name="nodeId" class="hidden">
                  <% nodes.forEach(node => { %>
                    <option value="<%= node.id %>" <%= node.id === server.nodeId ? 'selected' : '' %>><%= node.name %> (<%= node.address %>)</option>
                  <% }); %>
                </select>
                <div class="custom-select mt-2" data-for="serverNode"></div>
              </div>

              <div>
                <label for="serverImage" class="al-label">
                  <%- icon('box', { size: 14, class: 'shrink-0' }) %>
                  Image:</label>
                <select id="serverImage" name="imageId" class="hidden">
                  <% images.forEach(image => { %>
                    <option value="<%= image.id %>" <%= image.id === server.imageId ? 'selected' : '' %> data-port-requirements='<%= image.portRequirements || "[]" %>'><%= image.name %></option>
                  <% }); %>
                </select>
                <div class="custom-select mt-2" data-for="serverImage"></div>
              </div>

              <div>
                <label class="al-label">
                  <%- icon('radio-tower', { size: 14, class: 'shrink-0' }) %>
                  Ports:</label>
                <input type="hidden" id="serverPorts" name="Ports">
                <button type="button" id="assignPortsBtn" class="al-btn-secondary mt-2 w-full">
                  <%- icon('radio-tower', { size: 14, class: 'shrink-0' }) %>
                  Assign ports
                </button>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Resource Allocation</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="al-label">
                  <%- icon('memory-stick', { size: 14, class: 'shrink-0' }) %>
                  Memory:
                </label>
                <input type="hidden" id="serverMemory" name="Memory" value="<%= server.Memory %>">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverMemoryDisplay" type="number" min="1"
                    value="<%= server.Memory >= 1024 ? Math.round(server.Memory / 1024) : server.Memory %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="serverMemoryDisplay" data-hidden="serverMemory"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
                <p class="text-xs" style="color:var(--theme-text-muted)">Min 128 MB</p>
              </div>

              <div>
                <label class="al-label">
                  <%- icon('memory-stick', { size: 14, class: 'shrink-0' }) %>
                  Swap:
                </label>
                <input type="hidden" id="serverSwap" name="Swap" value="<%= server.Swap ?? 0 %>">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverSwapDisplay" type="number" min="-1"
                    value="<%= server.Swap && server.Swap >= 1024 ? Math.round(server.Swap / 1024) : (server.Swap ?? 0) %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="serverSwapDisplay" data-hidden="serverSwap"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
                <p class="text-xs" style="color:var(--theme-text-muted)">0 = no swap, -1 = unlimited</p>
              </div>

              <div>
                <label class="al-label">
                  <%- icon('cpu', { size: 14, class: 'shrink-0' }) %>
                  CPU:
                </label>
                <input type="hidden" id="serverCPU" name="Cpu" value="<%= server.Cpu %>">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverCPUDisplay" type="number" min="0.5" step="0.5" value="<%= (server.Cpu / 100).toFixed(1) %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="serverCPUDisplay" data-hidden="serverCPU"
                    data-units="100:Cores,1:%" data-default-unit="Cores">Cores</button>
                </div>
                <p class="text-xs" style="color:var(--theme-text-muted)">1 core = 100%</p>
              </div>

              <div>
                <label class="al-label">
                  <%- icon('database', { size: 14, class: 'shrink-0' }) %>
                  Storage:
                </label>
                <input type="hidden" id="serverStorage" name="Storage" value="<%= server.Storage %>">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverStorageDisplay" type="number" min="1"
                    value="<%= server.Storage >= 1024 ? Math.round(server.Storage / 1024) : server.Storage %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="serverStorageDisplay" data-hidden="serverStorage"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
                <p class="text-xs" style="color:var(--theme-text-muted)">Min 128 MB</p>
              </div>
              <div>
                <label class="al-label">
                  <%- icon('layers', { size: 14, class: 'shrink-0' }) %>
                  Database limit:
                </label>
                <input id="serverDatabaseLimit" name="databaseLimit" type="number" min="0" value="<%= server.databaseLimit ?? 5 %>" class="al-input mt-2 mb-1">
                <p class="text-xs" style="color:var(--theme-text-muted)">0 = unlimited databases</p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Backups</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="al-label">
                  <%- icon('database-backup', { size: 14, class: 'shrink-0' }) %>
                  Backup limit:
                </label>
                <input id="serverBackupLimit" name="backupLimit" type="number" min="0" value="<%= server.backupLimit ?? 5 %>" class="al-input mt-2">
                <p class="text-xs" style="color:var(--theme-text-muted)">0 = unlimited backups</p>
              </div>
              <div>
                <label for="backupIgnoreList" class="al-label">
                  <%- icon('filter', { size: 14, class: 'shrink-0' }) %>
                  Backup ignore list:
                </label>
                <textarea id="backupIgnoreList" name="backupIgnoreList" rows="4" class="al-input mt-2" placeholder="cache/%0A*.log%0A.backup"><%-
                  (() => {
                    try {
                      const raw = server.backupIgnoreList || '';
                      if (raw.trim().startsWith('[')) {
                        const parsed = JSON.parse(raw);
                        return Array.isArray(parsed) ? parsed.join('\n') : raw;
                      }
                      return raw;
                    } catch { return server.backupIgnoreList || ''; }
                  })()
                %></textarea>
                <p class="text-xs" style="color:var(--theme-text-muted)">One glob pattern per line (e.g. <code>cache/</code>, <code>*.log</code>).</p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Mounts</h2>
            <p class="mb-4 text-xs" style="color:var(--theme-text-muted)">Attach host directories to this server's container. Define mounts in the Admin → Mounts page.</p>
            <div class="space-y-2">
              <% (mounts || []).forEach(m => { %>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="mountIds" value="<%= m.id %>" class="al-input h-4 w-4" <%= (serverMounts||[]).some(sm => sm.mountId === m.id) ? 'checked' : '' %>>
                  <span class="text-sm" style="color:var(--theme-text-strong)"><%= m.name %> <span class="text-xs" style="color:var(--theme-text-muted)"><%= m.source %> → <%= m.target %> (<%= m.readOnly ? 'ro' : 'rw' %>)</span></span>
                </label>
              <% }) %>
            </div>
            <% if (!(mounts || []).length) { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted)">No mounts available.</p>
            <% } %>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Startup Configuration</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="startCommand" class="al-label">
                  <%- icon('terminal', { size: 14, class: 'shrink-0' }) %>
                  Startup Command:</label>
                <textarea id="startCommand" name="StartCommand" rows="3" class="al-input"><%= server.StartCommand %></textarea>
              </div>
              <div>
                <div class="rounded-lg p-4" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
                  <div class="flex flex-col md:flex-row md:items-center justify-between">
                    <div class="flex items-center mb-2 md:mb-0">
                      <div class="flex-shrink-0 mr-3">
                        <%- icon('pencil', { size: 24, style: 'color:var(--theme-accent)' }) %>
                      </div>
                      <div>
                        <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)">Startup Command Permissions</h3>
                        <p class="text-xs" style="color:var(--theme-text-muted)">When enabled, users can modify the startup command for this server.</p>
                      </div>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" name="allowStartupEdit" id="allowStartupEdit" class="sr-only peer" value="true" x-model="allowStartupEdit">
                      <div class="al-toggle-track">
                        <div class="al-toggle-dot"></div>
                      </div>
                      <span class="ms-3 al-page-desc text-sm" x-text="allowStartupEdit ? 'Enabled' : 'Disabled'"><%= server.allowStartupEdit ? 'Enabled' : 'Disabled' %></span>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Server Status</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <div class="flex items-center gap-3 mb-4">
                  <span id="serverStatusCircle" class="inline-flex items-center justify-center h-8 w-8 rounded-full"
                    style="<%= server.Suspended ? 'background:var(--theme-danger-bg);color:var(--theme-danger)' : 'background:var(--theme-success-bg);color:var(--theme-success)' %>">
                    <% if (server.Suspended) { %>
                      <%- icon('x-circle', { size: 20, class: 'shrink-0' }) %>
                    <% } else { %>
                      <%- icon('check-circle', { size: 20, class: 'shrink-0' }) %>
                    <% } %>
                  </span>
                  <div>
                    <p class="text-sm font-medium" style="color:var(--theme-text)">Status: <span id="serverStatusText" style="<%= server.Suspended ? 'color:var(--theme-danger)' : 'color:var(--theme-success)' %>"><%= server.Suspended ? 'Suspended' : 'Active' %></span></p>
                    <p class="text-xs" style="color:var(--theme-text-muted)">Server ID: <%= server.UUID %></p>
                  </div>
                </div>

                <div class="rounded-lg p-4" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
                  <div class="flex flex-col md:flex-row md:items-center justify-between">
                    <div class="flex items-center mb-2 md:mb-0">
                      <div class="flex-shrink-0 mr-3">
                        <%- icon('triangle-alert', { size: 24, style: 'color:var(--theme-warning)' }) %>
                      </div>
                      <div>
                        <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)">Server Suspension</h3>
                        <p class="text-xs" style="color:var(--theme-text-muted)">When enabled, the server will be suspended and stopped. Users will not be able to start the server while it's suspended.</p>
                      </div>
                    </div>
                    <label for="suspendServer" class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" name="Suspended" id="suspendServer" aria-label="Server suspension" class="sr-only peer" value="true" x-model="suspended">
                      <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
                      <span id="suspendServerLabel" class="ms-3 text-sm font-medium" style="color:var(--theme-text)" x-text="suspended ? 'Suspended' : 'Active'"><%= server.Suspended ? 'Suspended' : 'Active' %></span>
                    </label>
                  </div>
                </div>
              </div>

              <div>
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center justify-center h-8 w-8 rounded-full"
                    style="background:var(--theme-info-bg);color:var(--theme-info)">
                    <%- icon('calendar', { size: 20, class: 'shrink-0' }) %>
                  </span>
                  <div>
                    <p class="text-sm font-medium" style="color:var(--theme-text)">Created</p>
                    <p class="text-xs" style="color:var(--theme-text-muted)"><%= new Date(server.createdAt).toLocaleString() %></p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Server Transfer</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center justify-center h-8 w-8 rounded-full" style="background:color-mix(in srgb, var(--theme-accent) 12%, transparent); color:var(--theme-accent)">
                    <%- icon('arrow-right-left', { size: 20, class: 'shrink-0' }) %>
                  </span>
                  <div>
                    <p class="text-sm font-medium" style="color:var(--theme-text)">Transfer Server</p>
                    <p class="text-xs" style="color:var(--theme-text-muted)">Move this server to a different node</p>
                  </div>
                </div>
                <button type="button" id="transferServerBtn" class="al-btn-secondary w-full" <%= server.Installing ? 'disabled' : '' %>>
                  <%- icon('arrow-right-left', { size: 14, class: 'shrink-0' }) %>
                  Transfer to another node
                </button>
                <% if (server.Installing) { %>
                  <p class="text-xs mt-2" style="color:var(--theme-warning)">Server is currently installing and cannot be transferred.</p>
                <% } %>
              </div>
              <div>
                <div id="transferStatus" class="hidden rounded-lg p-4" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
                  <div class="flex items-center gap-2">
                    <div class="animate-spin rounded-full h-4 w-4 border-2 border-t-transparent" style="border-color:var(--theme-accent); border-top-color:transparent"></div>
                    <span id="transferStatusText" class="text-sm font-medium">Transfer in progress...</span>
                  </div>
                  <p id="transferStatusDetail" class="text-xs mt-2" style="color:var(--theme-text-muted)"></p>
                </div>
              </div>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</main>
</div><!-- /x-data -->

<%- include('../../components/portsAllocator') %>
<%- include('../../components/loadingPopup') %>

<!-- Transfer Modal -->
<div id="transferModal" class="al-sheet-overlay fixed inset-0 z-50 hidden">
  <div class="flex items-end sm:items-center justify-center min-h-screen p-0 sm:p-4">
    <div class="fixed inset-0" id="transferModalBackdrop"></div>
    <div id="transferModalPanel" class="al-sheet-panel relative border rounded-2xl shadow-lg max-w-lg w-full max-h-[85vh] flex flex-col overflow-hidden" style="background:var(--theme-bg-card); border-color:var(--theme-border);">

      <div class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
        <div>
          <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong);">Transfer Server</h3>
          <p class="text-xs mt-0.5" style="color:var(--theme-text-muted);">Move "<%= server.name %>" to another node</p>
        </div>
        <button type="button" onclick="closeTransferModal()" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close">
          <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
        </button>
      </div>

      <div class="px-6 py-4 overflow-y-auto max-h-[70vh]">
        <div class="space-y-4">
          <div>
            <label class="al-label">
              <%- icon('server', { size: 14, class: 'shrink-0' }) %>
              Destination Node:
            </label>
            <select id="transferTargetNode" class="al-input w-full">
              <option value="">Select a node...</option>
              <% nodes.forEach(node => { %>
                <% if (node.id !== server.nodeId) { %>
                  <option value="<%= node.id %>" data-address="<%= node.address %>"><%= node.name %> (<%= node.address %>)</option>
                <% } %>
              <% }); %>
            </select>
          </div>

          <div>
            <label class="al-label">
              <%- icon('radio-tower', { size: 14, class: 'shrink-0' }) %>
              Ports:
            </label>
            <div id="transferPortsContainer" class="space-y-2">
              <p class="text-xs" style="color:var(--theme-text-muted)">Select a node first to see available ports.</p>
            </div>
            <button type="button" id="addTransferPortBtn" class="al-btn-secondary mt-2 w-full hidden">
              <%- icon('plus', { size: 14, class: 'shrink-0' }) %>
              Add port
            </button>
          </div>

          <div class="rounded-lg p-3" style="background:var(--theme-bg-secondary);border:1px solid var(--theme-border)">
            <div class="flex items-start gap-2">
              <%- icon('info', { size: 16, class: 'shrink-0 mt-0.5', style: 'color:var(--theme-accent)' }) %>
              <div>
                <p class="text-xs font-medium" style="color:var(--theme-text-strong);">What happens during transfer?</p>
                <ul class="text-xs mt-1 space-y-1" style="color:var(--theme-text-muted);">
                  <li>1. Server is stopped on the current node</li>
                  <li>2. Files are archived and streamed to the destination</li>
                  <li>3. Server is restored and installed on the new node</li>
                  <li>4. Server is started on the destination node</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex gap-2 px-6 py-4 border-t justify-end" style="border-color:var(--theme-border);">
        <button type="button" onclick="closeTransferModal()" class="al-btn-secondary">Cancel</button>
        <button type="button" id="confirmTransferBtn" class="al-btn-primary" disabled>
          <%- icon('arrow-right-left', { size: 14, class: 'shrink-0' }) %>
          Transfer Server
        </button>
      </div>
    </div>
  </div>
</div>

<style>
#editServerForm .al-card { overflow: visible; }
#editServerForm .al-card-header { border-radius: 12px 12px 0 0; overflow: hidden; margin-bottom: 16px; }
</style>

<script nonce="<%- nonce %>">
  const form = document.getElementById('editServerForm');
    const suspendServerToggle    = document.getElementById('suspendServer');
    const suspendServerLabel     = document.getElementById('suspendServerLabel');
    const serverNodeSelect = document.getElementById('serverNode');
    const serverImageSelect = document.getElementById('serverImage');
    const serverPortsInput = document.getElementById('serverPorts');
    let nodesData = {};
    let availablePorts = [];
    let assignedPorts = <%- JSON.stringify((() => { try { return JSON.parse(server.Ports || '[]'); } catch { return []; } })()) %>.map((port, index) => {
      const portStr = port.Port || '';
      const parts = portStr.split(':');
      return {
        name: port.name || `Port ${index + 1}`,
        internalPort: port.internalPort || parseInt(parts[1]) || parseInt(parts[0]) || 0,
        externalPort: port.externalPort || parseInt(parts[0]) || 0,
        primary: Boolean(port.primary || index === 0),
      };
    });

    async function fetchNodesData() {
      const response = await fetch('/admin/nodes/list');
      const nodes = await response.json();
      nodes.forEach(node => {
        let ports = [];
        try { ports = JSON.parse(node.allocatedPorts || '[]'); } catch (e) {
          console.warn('[servers/edit] Failed to parse allocated ports for node', node.id, e);
        }
        nodesData[node.id] = { ...node, parsedPorts: ports };
      });
      updatePortsForSelectedNode();
    }

    function updatePortsForSelectedNode() {
      const node = nodesData[serverNodeSelect.value];
      if (!node) return;
      const usedPorts = new Set();
      (node.servers || []).forEach(server => {
        if (server.id === <%= server.id %>) return;
        try {
          JSON.parse(server.Ports || '[]').forEach(portInfo => {
            const external = portInfo.externalPort || parseInt(String(portInfo.Port || '').split(':')[0]);
            if (!isNaN(external)) usedPorts.add(external);
          });
        } catch (e) {
          console.warn('[servers/edit] Failed to parse used ports for server', server.id, e);
        }
      });
      availablePorts = (node.parsedPorts || [])
        .filter(port => !usedPorts.has(port) || assignedPorts.some(item => Number(item.externalPort) === port))
        .map(port => ({ port, label: `${node.address}:${port}` }));
      ensureMinimumPortRows();
      syncPortsButton();
    }

    function getPortRequirements() {
      const selectedOption = serverImageSelect.options[serverImageSelect.selectedIndex];
      try { return JSON.parse(selectedOption.getAttribute('data-port-requirements') || '[]'); } catch { return []; }
    }

    function ensureMinimumPortRows() {
      const requirements = getPortRequirements();
      const DEFAULT_PORT = 25565;
      while (assignedPorts.length < requirements.length) {
        const req = requirements[assignedPorts.length] || {};
        assignedPorts.push({
          name: req.name || `Port ${assignedPorts.length + 1}`,
          internalPort: req.internalPort || DEFAULT_PORT,
          externalPort: availablePorts.find(item => !assignedPorts.some(port => port.externalPort === item.port))?.port || '',
          primary: assignedPorts.length === 0
        });
      }
      serverPortsInput.value = JSON.stringify(assignedPorts);
    }

    function syncPortsButton() {
      serverPortsInput.value = JSON.stringify(assignedPorts);
      document.getElementById('assignPortsBtn').textContent = assignedPorts.length ? `Assign ports (${assignedPorts.length})` : 'Assign ports';
    }

    function renderPortRows() {
      if (!window.PortsAllocator) return;
      PortsAllocator.open({
        requirements: getPortRequirements(),
        assignedPorts: assignedPorts,
        availablePorts: availablePorts,
        onSave: function (rows) {
          assignedPorts = rows;
          syncPortsButton();
        }
      });
    }
    document.getElementById('assignPortsBtn').addEventListener('click', renderPortRows);
    serverNodeSelect.addEventListener('change', updatePortsForSelectedNode);
    serverImageSelect.addEventListener('change', () => { ensureMinimumPortRows(); syncPortsButton(); });
    fetchNodesData();

    suspendServerToggle.addEventListener('change', function() {
      const checked = this.checked;
      const action = checked ? 'suspend' : 'unsuspend';

      // Suspending stops the server and blocks the owner — confirm first.
      // Unsuspending is a safe reversal, so it goes through immediately.
      if (!checked) return doSuspend(action, this);

      // Optimistically revert the toggle; only flip it back on confirm.
      this.checked = false;
      window.modal.confirm({
        title: 'Suspend server?',
        body: 'The server will be stopped and the owner will not be able to start it. You can unsuspend at any time.',
        danger: true, confirmLabel: 'Suspend',
        onConfirm: function () {
          suspendServerToggle.checked = true;
          doSuspend('suspend', suspendServerToggle);
        },
      });
    });

    async function doSuspend(action, toggle) {
      try {
        const response = await fetch('/admin/servers/<%= server.id %>/' + action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
          body: JSON.stringify({}),
        });

        if (!response.ok) {
          throw new Error((await response.json()).error || 'Request failed');
        }

        suspendServerLabel.textContent = action === 'suspend' ? 'Suspended' : 'Active';
        const statusText = document.getElementById('serverStatusText');
        if (statusText) {
          statusText.textContent = action === 'suspend' ? 'Suspended' : 'Active';
          statusText.style.color = action === 'suspend' ? 'var(--theme-danger)' : 'var(--theme-success)';
        }
        const statusCircle = document.getElementById('serverStatusCircle');
        if (statusCircle) {
          statusCircle.className = 'inline-flex items-center justify-center h-8 w-8 rounded-full';
          statusCircle.style.background = action === 'suspend' ? 'var(--theme-danger-bg)' : 'var(--theme-success-bg)';
          statusCircle.style.color = action === 'suspend' ? 'var(--theme-danger)' : 'var(--theme-success)';
          statusCircle.innerHTML = window.alIcon ? (action === 'suspend' ? window.alIcon('x-circle', 'size-5 shrink-0') : window.alIcon('check-circle', 'size-5 shrink-0')) : '';
        }
      } catch (err) {
        toggle.checked = action === 'unsuspend';
        suspendServerLabel.textContent = action === 'suspend' ? 'Active' : 'Suspended';
        showToast('Failed to ' + action + ' server: ' + (err.message || 'unknown error'), 'error');
      }
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      data.ports = assignedPorts;
      data.mountIds = formData.getAll('mountIds').map(v => parseInt(v, 10));

      // Handle checkbox values
      if (!formData.has('allowStartupEdit')) {
        data.allowStartupEdit = 'false';
      }

      if (!formData.has('Suspended')) {
        data.Suspended = 'false';
      }

      const loader = showLoadingPopup('Updating Server', 'Processing server update...');
      loader.updateProgress(20, 'Sending server configuration...');

      try {
        const response = await fetch('/admin/servers/edit/<%= server.id %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok) {
          loader.updateProgress(100, 'Server updated successfully!');
          setTimeout(() => {
            loader.close();
            showToast('Server updated successfully!', 'success');
            setTimeout(() => {
              window.location.href = '/admin/servers';
            }, 1000);
          }, 500);
        } else {
          loader.close();
          showToast('Failed to update server: ' + (result.error || 'Unknown error'), 'error');
        }
      } catch (error) {
        loader.close();
        showToast('Failed to update server: ' + error.message, 'error');
      }
    });
</script>

<script nonce="<%- nonce %>">
  // ── Transfer Logic ─────────────────────────────────────────────────────
  (function() {
    const transferBtn = document.getElementById('transferServerBtn');
    const transferModal = document.getElementById('transferModal');
    const transferModalBackdrop = document.getElementById('transferModalBackdrop');
    const transferModalPanel = document.getElementById('transferModalPanel');
    const transferTargetNode = document.getElementById('transferTargetNode');
    const transferPortsContainer = document.getElementById('transferPortsContainer');
    const addTransferPortBtn = document.getElementById('addTransferPortBtn');
    const confirmTransferBtn = document.getElementById('confirmTransferBtn');
    const transferStatusDiv = document.getElementById('transferStatus');
    const transferStatusText = document.getElementById('transferStatusText');
    const transferStatusDetail = document.getElementById('transferStatusDetail');

    let transferPorts = [];
    let nodesData = {};
    let pollInterval = null;

    const DEFAULT_PORT = 25565;

    const statusSteps = {
      'pending': { text: 'Queued...' },
      'stopping': { text: 'Stopping server on source node...' },
      'archiving': { text: 'Archiving server files...' },
      'transferring': { text: 'Streaming data to destination...' },
      'restoring': { text: 'Restoring files on destination...' },
      'installing': { text: 'Installing server on destination...' },
      'updating-db': { text: 'Updating database records...' },
      'starting': { text: 'Starting server on destination...' },
      'completed': { text: 'Transfer complete!' },
      'failed': { text: 'Transfer failed' },
    };

    async function fetchNodesData() {
      try {
        const response = await fetch('/admin/nodes/list');
        const nodes = await response.json();
        nodes.forEach(node => {
          let ports = [];
          try { ports = JSON.parse(node.allocatedPorts || '[]'); } catch (e) {
            console.warn('[servers/edit] Failed to parse allocated ports for node', node.id, e);
          }
          // Also include ports from allocation table
          if (node.allocations && Array.isArray(node.allocations)) {
            node.allocations.forEach(a => {
              if (!ports.includes(a.port)) ports.push(a.port);
            });
          }
          nodesData[node.id] = { ...node, parsedPorts: ports.sort((a,b) => a-b) };
        });
      } catch (err) {
        console.error('[servers/edit] Failed to fetch nodes:', err);
      }
    }

    function getUsedPortsForNode(nodeId) {
      const node = nodesData[nodeId];
      if (!node) return new Set();
      const used = new Set();
      (node.servers || []).forEach(server => {
        // Skip the current server being transferred
        if (server.id === <%= server.id %>) return;
        try {
          JSON.parse(server.Ports || '[]').forEach(portInfo => {
            const external = portInfo.externalPort || parseInt(String(portInfo.Port || '').split(':')[0]);
            if (!isNaN(external)) used.add(external);
          });
        } catch (e) {
          console.warn('[servers/edit] Failed to parse used ports for server', server.id, e);
        }
      });
      return used;
    }

    function renderTransferPorts() {
      const nodeId = transferTargetNode.value;
      if (!nodeId) return;
      const node = nodesData[nodeId];
      if (!node) return;

      const usedPorts = getUsedPortsForNode(parseInt(nodeId));
      const availablePorts = (node.parsedPorts || [])
        .filter(port => !usedPorts.has(port) || transferPorts.some(p => p.externalPort === port));

      if (transferPorts.length === 0) {
        // Initialize with current server ports
        try {
          transferPorts = JSON.parse(<%- JSON.stringify(server.Ports || '[]') %>).map((p, i) => ({
            name: p.name || 'Port ' + (i + 1),
            internalPort: p.internalPort || parseInt(String(p.Port || '').split(':')[1]) || parseInt(String(p.Port || '').split(':')[0]) || DEFAULT_PORT,
            externalPort: p.externalPort || parseInt(String(p.Port || '').split(':')[0]) || DEFAULT_PORT,
            primary: Boolean(p.primary || i === 0),
          }));
        } catch {
          transferPorts = [{ name: 'Port 1', internalPort: DEFAULT_PORT, externalPort: DEFAULT_PORT, primary: true }];
        }
      }

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
      }

      let html = '';
      transferPorts.forEach((port, idx) => {
        const portOptions = availablePorts.map(p =>
          `<option value="${p}" ${p === port.externalPort ? 'selected' : ''}>${escapeHtml(node.address)}:${p}</option>`
        ).join('');

        html += `
          <div class="flex items-center gap-2 transfer-port-row" data-idx="${idx}">
            <select class="al-input flex-1 transfer-port-select" data-idx="${idx}">
              ${portOptions}
            </select>
            <input type="number" class="al-input w-20 transfer-port-internal" data-idx="${idx}" value="${port.internalPort}" placeholder="Internal">
            <label class="flex items-center gap-1 text-xs shrink-0">
              <input type="checkbox" class="transfer-port-primary" data-idx="${idx}" ${port.primary ? 'checked' : ''}> Primary
            </label>
            <button type="button" onclick="removeTransferPort(${idx})" class="al-btn-ghost p-2 shrink-0" style="color:var(--theme-danger);" aria-label="Remove port">
              <%- icon('x', { size: 14 }) %>
            </button>
          </div>
        `;
      });

      transferPortsContainer.innerHTML = html || '<p class="text-xs text-neutral-500">No ports configured.</p>';
      addTransferPortBtn.classList.toggle('hidden', transferPorts.length === 0);
      updateConfirmButton();
    }

    window.removeTransferPort = function(idx) {
      transferPorts.splice(idx, 1);
      renderTransferPorts();
    };

    function collectPortsFromUI() {
      const selects = document.querySelectorAll('.transfer-port-select');
      const internals = document.querySelectorAll('.transfer-port-internal');
      const primaries = document.querySelectorAll('.transfer-port-primary');
      transferPorts = [];
      selects.forEach((sel, i) => {
        transferPorts.push({
          name: 'Port ' + (i + 1),
          externalPort: parseInt(sel.value) || 0,
          internalPort: parseInt(internals[i]?.value) || parseInt(sel.value) || DEFAULT_PORT,
          primary: primaries[i]?.checked || false,
        });
      });
    }

    function updateConfirmButton() {
      const nodeId = transferTargetNode.value;
      const hasPorts = transferPorts.length > 0 && transferPorts.every(p => p.externalPort > 0);
      confirmTransferBtn.disabled = !nodeId || !hasPorts;
    }

    // Event listeners
    transferBtn.addEventListener('click', function() {
      transferModal.classList.remove('hidden');
      transferModal.classList.add('flex');
      if (typeof Animate !== 'undefined') Animate.openModal(transferModal, transferModalPanel);
    });

    window.closeTransferModal = function() {
      if (typeof Animate !== 'undefined') {
        Animate.closeModal(transferModal, transferModalPanel, () => {
          transferModal.classList.add('hidden');
          transferModal.classList.remove('flex');
        });
      } else {
        transferModal.classList.add('hidden');
        transferModal.classList.remove('flex');
      }
    };

    transferTargetNode.addEventListener('change', function() {
      transferPorts = []; // Reset ports when node changes
      renderTransferPorts();
      updateConfirmButton();
    });

    addTransferPortBtn.addEventListener('click', function() {
      collectPortsFromUI();
      const nodeId = transferTargetNode.value;
      const node = nodesData[nodeId];
      if (!node) return;
      const usedPorts = getUsedPortsForNode(parseInt(nodeId));
      const usedByTransfer = new Set(transferPorts.map(p => p.externalPort));
      const nextPort = (node.parsedPorts || []).find(p => !usedPorts.has(p) && !usedByTransfer.has(p));
      transferPorts.push({
        name: 'Port ' + (transferPorts.length + 1),
        externalPort: nextPort || DEFAULT_PORT,
        internalPort: nextPort || DEFAULT_PORT,
        primary: false,
      });
      renderTransferPorts();
    });

    confirmTransferBtn.addEventListener('click', async function() {
      collectPortsFromUI();
      const nodeId = transferTargetNode.value;
      if (!nodeId || transferPorts.length === 0) return;

      confirmTransferBtn.disabled = true;
      confirmTransferBtn.textContent = 'Starting transfer...';

      try {
        const response = await fetch('/admin/servers/<%= server.id %>/transfer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
          body: JSON.stringify({ targetNodeId: parseInt(nodeId), ports: transferPorts }),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || 'Failed to start transfer');
        }

        closeTransferModal();
        startTransferPolling();
        showToast('Transfer started!', 'success');
      } catch (err) {
        showToast('Failed to start transfer: ' + (err.message || 'unknown error'), 'error');
        confirmTransferBtn.disabled = false;
        confirmTransferBtn.innerHTML = '<%- icon("arrow-right-left", { size: 14, class: "shrink-0" }) %>Transfer Server';
      }
    });

    function startTransferPolling() {
      transferStatusDiv.classList.remove('hidden');
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(pollTransferStatus, 3000);
      pollTransferStatus();
    }

    async function pollTransferStatus() {
      try {
        const response = await fetch('/admin/servers/<%= server.id %>/transfer/status');
        const state = await response.json();

        if (state.status === 'idle') {
          transferStatusDiv.classList.add('hidden');
          clearInterval(pollInterval);
          return;
        }

        const step = statusSteps[state.status] || { text: state.status };
        transferStatusText.textContent = step.text;
        transferStatusDetail.textContent = state.error || '';

        if (state.status === 'completed') {
          clearInterval(pollInterval);
          transferStatusText.textContent = 'Transfer complete!';
          transferStatusDetail.textContent = '';
          showToast('Transfer complete!', 'success');
        } else if (state.status === 'failed') {
          clearInterval(pollInterval);
        }
      } catch (err) {
        console.warn('[servers/edit] Transfer poll failed:', err);
      }
    }

    // Check on page load if a transfer is in progress
    fetch('/admin/servers/<%= server.id %>/transfer/status')
      .then(r => r.json())
      .then(state => {
        if (state.status && state.status !== 'idle' && state.status !== 'completed' && state.status !== 'failed') {
          startTransferPolling();
        }
      })
      .catch(err => console.warn('[servers/edit] Failed to check transfer status:', err));

    fetchNodesData();
  })();
</script>


