<%- include('../../layouts/admin', { title: t('adminServersTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin' },
    { label: t('breadcrumbServers') }
  ] }) %>
</div>

<div class="al-page-header flex items-start justify-between gap-4">
  <div>
    <h1 class="al-page-title"><%= t('adminServersTitle') %></h1>
    <p class="al-page-desc"><%= t('adminServersText') %></p>
  </div>
  <div class="flex gap-2 shrink-0 items-center">
    <a href="/admin/servers/create" class="al-btn al-btn-primary inline-flex items-center gap-1.5">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
      <%= t('createNewServer') %>
    </a>
  </div>
</div>

<div class="al-page-body">

  <div data-al-tabs data-tabs-default="servers" data-tabs-hash>

    <!-- Tab bar -->
    <div role="tablist" class="al-segmented mb-6 flex-wrap max-w-full">
      <button type="button" role="tab" id="tab-servers" data-tab="servers" aria-controls="panel-servers" aria-selected="true" tabindex="0" class="al-segmented-btn"><%- icon('server', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('adminServersTitle') %></button>
      <button type="button" role="tab" id="tab-queue" data-tab="queue" aria-controls="panel-queue" aria-selected="false" tabindex="-1" class="al-segmented-btn"><%- icon('list-ordered', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('breadcrumbQueue') %></button>
      <% if (showRadar) { %>
      <button type="button" role="tab" id="tab-radar" data-tab="radar" aria-controls="panel-radar" aria-selected="false" tabindex="-1" class="al-segmented-btn"><%- icon('radar', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('adminRadarTitle') %></button>
      <% } %>
    </div>

    <!-- ── Servers ─────────────────────────────────────────────────── -->
    <div id="panel-servers" role="tabpanel" aria-labelledby="tab-servers" data-tab-panel="servers" class="tab-panel">

  <!-- Sentinel — watched to know when toolbar scrolls off screen -->
  <div id="toolbarSentinel" class="h-px w-full" aria-hidden="true"></div>

  <!-- Bulk toolbar -->
  <div id="bulkToolbarRow" class="no-anim" style="display:grid;grid-template-rows:0fr;transition:grid-template-rows 0.36s cubic-bezier(0.16,1,0.3,1)">
    <div style="min-height:0;overflow:hidden">
      <div id="bulkToolbarContent" class="mb-3 pb-0.5" style="opacity:0;transition:opacity 0.28s ease">
        <div class="al-card al-card-flush">
          <div class="flex items-center gap-2 p-2.5">
            <span class="selection-count text-[13px] font-medium mr-1" style="color:var(--theme-text);"><%= t('selected') %></span>
            <div class="h-3.5 w-px mx-1" style="background:var(--theme-border);"></div>
            <button type="button" onclick="bulkDelete()"
              class="al-btn-danger ml-auto">
              <%- icon('trash-2', { size: 14, class: 'shrink-0' }) %>
              <%= t('delete') %>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating pill — fixed below topbar when toolbar scrolls off screen -->
  <div id="floatingToolbar"
    style="position:fixed;top:72px;left:50%;transform:translateX(-50%) translateY(-10px);z-index:40;opacity:0;pointer-events:none;transition:opacity 0.22s ease,transform 0.22s cubic-bezier(0.16,1,0.3,1)">
    <div class="al-card al-card-flush shadow-xl">
      <div class="flex items-center gap-2 p-2.5">
        <span class="selection-count text-[13px] font-medium mr-1" style="color:var(--theme-text);"><%= t('selected') %></span>
        <div class="h-3.5 w-px mx-1" style="background:var(--theme-border);"></div>
        <button type="button" onclick="bulkDelete()"
          class="al-btn-danger ml-auto">
          <%- icon('trash-2', { size: 14, class: 'shrink-0' }) %>
          <%= t('delete') %>
        </button>
      </div>
    </div>
  </div>

  <!-- Server table -->
  <div class="al-table-wrapper" id="serverTable">
    <% if (!servers || servers.length === 0) { %>
      <%- include('../../partials/empty-state', {
        iconName: 'server',
        title: t('noServersYet'),
        description: t('createFirstServer'),
        action: '<a href="/admin/servers/create" class="al-btn-primary">' + icon('plus', { class: 'w-3.5 h-3.5' }).toString() + ' ' + t('createNewServer') + '</a>'
      }) %>
    <% } else { %>
    <table class="al-table">
      <colgroup>
        <col style="min-width:40px">
        <col style="min-width:220px">
        <col style="min-width:140px">
        <col style="min-width:120px">
        <col style="min-width:100px">
        <col style="min-width:160px">
      </colgroup>
      <thead class="al-table-thead">
        <tr>
          <th scope="col" class="al-table-th w-10"></th>
          <th scope="col" class="al-table-th"><%= t('name') %></th>
          <th scope="col" class="al-table-th"><%= t('Owner') %></th>
          <th scope="col" class="al-table-th"><%= t('Node') %></th>
          <th scope="col" class="al-table-th"><%= t('Status') %></th>
          <th scope="col" class="al-table-th"></th>
        </tr>
      </thead>
      <tbody class="al-table-tbody">
        <% let srvIdx = 0; servers.forEach(function(server) { %>
        <tr style="--i:<%= srvIdx++ %>" class="al-table-tr cursor-pointer server-row" data-id="<%= server.id %>" data-uuid="<%= server.UUID %>">
          <td class="al-table-td w-10">
            <label class="al-form-check-label">
              <input type="checkbox" class="server-checkbox al-form-checkbox cursor-pointer"
                value="<%= server.id %>" data-uuid="<%= server.UUID %>" data-edit-id="<%= server.id %>" data-name="<%= server.name %>">
            </label>
          </td>
          <td class="al-table-td">
            <div class="flex items-center gap-2">
              <span class="shrink-0">
                <% if (server.Suspended) { %>
                  <span class="al-dot-offline"></span>
                <% } else { %>
                  <span class="al-dot-online"></span>
                <% } %>
              </span>
              <div>
                <div class="font-medium truncate max-w-[200px] text-[13px]" style="color:var(--theme-text-strong);"><%= server.name %></div>
                <div class="text-[10px] font-mono mt-0.5" style="color:var(--theme-text-muted);"><%= server.UUID %></div>
              </div>
            </div>
          </td>
          <td class="al-table-td">
            <a href="/admin/users/edit/<%= server.owner.id %>" class="flex items-center gap-1.5 group" onclick="event.stopPropagation()">
              <img loading="lazy" decoding="async" class="h-5 w-5 rounded-md object-cover shrink-0"
                src="<%= server.owner.avatar ? server.owner.avatar : '/avatar/' + encodeURIComponent(server.owner.username) %>" alt="<%= server.owner.username %>">
              <span class="font-medium text-[13px] group-hover:underline truncate max-w-[120px]" style="color:var(--theme-text-strong);"><%= server.owner.username %></span>
            </a>
          </td>
          <td class="al-table-td">
            <a href="/admin/nodes" class="font-medium text-[13px] hover:underline truncate max-w-[120px]" style="color:var(--theme-text-strong);" onclick="event.stopPropagation()"><%= server.node.name %></a>
          </td>
          <td class="al-table-td">
            <span class="<%= server.Suspended ? 'al-badge-warning' : 'al-badge-online' %>">
              <%= server.Suspended ? t('suspended') : t('enabled') %>
            </span>
          </td>
          <td class="al-table-td">
            <div class="flex items-center gap-1.5">
              <a href="/server/<%= server.UUID %>" onclick="event.stopPropagation()" title="<%= t('openConsole') %>" aria-label="<%= t('openConsole') %>"
                class="al-btn-ghost al-btn-icon-only">
                <%- icon('external-link', { size: 16, class: 'shrink-0' }) %>
              </a>
              <a href="/admin/servers/edit/<%= server.id %>" onclick="event.stopPropagation()" title="<%= t('edit') %>" aria-label="<%= t('editServer') %>"
                class="al-btn-ghost al-btn-icon-only">
                <%- icon('pencil', { size: 16, class: 'shrink-0' }) %>
              </a>
              <button type="button" onclick="event.stopPropagation(); deleteServer('<%= server.id %>', '<%= server.name %>')" title="<%= t('delete') %>" aria-label="<%= t('deleteServer') %>"
                class="al-btn-ghost al-btn-icon-only" style="color:var(--theme-danger);">
                <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>

    </div><!-- /#panel-servers -->

    <!-- ── Queue ───────────────────────────────────────────────────── -->
    <div id="panel-queue" role="tabpanel" aria-labelledby="tab-queue" data-tab-panel="queue" class="tab-panel space-y-5" hidden>
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="min-w-0">
          <p class="al-section-title"><%= t('queueManagementTitle') %></p>
          <p class="al-page-desc"><%= t('queueManagementDesc') %></p>
        </div>
        <button type="button" id="refreshBtn" class="al-btn-secondary shrink-0">
          <%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %>
          <%= t('refresh') %>
        </button>
      </div>

      <div class="al-card al-card-flush">
        <div class="al-card-header">
          <span class="al-card-header-title"><%= t('queueCardTitle') %></span>
        </div>
        <table class="al-table">
          <thead class="al-table-thead">
            <tr>
              <th scope="col" class="al-table-th"><%= t('serverColumn') %></th>
              <th scope="col" class="al-table-th"><%= t('node') %></th>
              <th scope="col" class="al-table-th"><%= t('user') %></th>
              <th scope="col" class="al-table-th"><%= t('queuePosition') %></th>
              <th scope="col" class="al-table-th"><%= t('queuePriority') %></th>
              <th scope="col" class="al-table-th"><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody id="queueTableBody">
            <% if (entries && entries.length > 0) { %>
              <% entries.forEach(function(entry) { %>
                <tr class="al-table-tr" data-server-id="<%= entry.serverId %>">
                  <td class="al-table-td"><span class="al-table-cell-strong font-mono text-xs"><%= entry.serverId %></span></td>
                  <td class="al-table-td">#<%= entry.nodeId %></td>
                  <td class="al-table-td">#<%= entry.userId %></td>
                  <td class="al-table-td tabular-nums"><%= entry.position %> / <%= entry.total %></td>
                  <td class="al-table-td">
                    <% if (entry.priority) { %>
                      <span class="al-badge al-badge-warning"><%- icon('zap', { size: 10, class: 'shrink-0' }) %> <%= t('queuePriorityHigh') %></span>
                    <% } else { %>
                      <span class="al-badge al-badge-neutral"><%= t('queuePriorityNormal') %></span>
                    <% } %>
                  </td>
                  <td class="al-table-td">
                    <div class="flex gap-2">
                      <button class="al-btn-secondary al-btn-sm kick-btn" data-server-id="<%= entry.serverId %>"><%= t('queueKick') %></button>
                      <button class="al-btn-secondary al-btn-sm ban-btn" data-user-id="<%= entry.userId %>"><%= t('queueBan') %></button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="6" class="al-table-empty al-table-td"><%= t('queueEmpty') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (showRadar) { %>
    <!-- ── Radar ───────────────────────────────────────────────────── -->
    <div id="panel-radar" role="tabpanel" aria-labelledby="tab-radar" data-tab-panel="radar" class="tab-panel space-y-5" hidden>
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="min-w-0">
          <p class="al-section-title"><%= t('adminRadarTitle') %></p>
          <p class="al-page-desc"><%= t('radarDesc') %></p>
        </div>
        <a href="/admin/radar/scripts" class="al-btn-secondary shrink-0">
          <%- icon('file-code', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('scripts') %></span>
        </a>
      </div>

      <!-- Server scan -->
      <div class="al-card">
        <div class="al-card-header">
          <div class="min-w-0">
            <p class="al-card-header-title"><%= t('serverScanTitle') %></p>
            <p class="al-card-header-desc"><%= t('serverScanDesc') %></p>
          </div>
        </div>
        <div class="al-card-body">
          <div class="al-form-field max-w-md">
            <label for="scanServerId" class="al-form-label"><%= t('serverId') %></label>
            <div class="flex flex-wrap items-center gap-2">
              <input type="text" id="scanServerId" placeholder="<%= t('enterServerIdPlaceholder') %>" class="al-form-input flex-1 min-w-[12rem]">
              <button type="button" id="scanBtn" class="al-btn-primary">
                <%- icon('scan', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('scanAction') %></span>
              </button>
            </div>
          </div>
          <div id="scanResult" class="mt-4 hidden"></div>
        </div>
      </div>

      <!-- Scan history -->
      <div class="al-card">
        <div class="al-card-header">
          <p class="al-card-header-title"><%= t('scanHistoryTitle') %></p>
        </div>
        <div class="al-card-body">
          <div id="scanHistory" class="text-sm al-text-muted"><%= t('noRecentScans') %></div>
        </div>
      </div>

      <!-- VirusTotal hash scan -->
      <div class="al-card">
        <div class="al-card-header">
          <div class="min-w-0">
            <p class="al-card-header-title"><%= t('vtHashScanTitle') %></p>
            <p class="al-card-header-desc"><%= t('vtHashScanDesc') %></p>
          </div>
        </div>
        <div class="al-card-body">
          <div class="al-form-field max-w-lg">
            <label for="vtHashInput" class="al-form-label"><%= t('fileHash') %></label>
            <div class="flex flex-wrap items-center gap-2">
              <input type="text" id="vtHashInput" placeholder="<%= t('vtHashPlaceholder') %>" class="al-form-input flex-1 min-w-[12rem] font-mono">
              <button type="button" id="vtScanBtn" class="al-btn-primary">
                <%- icon('search', { class: 'size-4', strokeWidth: 1.5 }) %><span><%= t('lookUpAction') %></span>
              </button>
            </div>
          </div>
          <div id="vtScanResult" class="mt-4 hidden"></div>
        </div>
      </div>
    </div>
    <% } %>

  </div><!-- /data-al-tabs -->

<script nonce="<%- nonce %>">
(function() {
  const sm = {
    sentinelVisible: true,

    init() {
      window._smInstance = this;
      const observer = new IntersectionObserver((entries) => {
        this.sentinelVisible = entries[0].isIntersecting;
        if (this.getChecked().length > 0) {
          this.setFloatingVisible(!this.sentinelVisible);
        }
      }, { threshold: 0 });
      observer.observe(document.getElementById('toolbarSentinel'));

      document.querySelectorAll('.server-checkbox').forEach((cb) => {
        cb.addEventListener('change', () => {
          if (window.animateCheckbox) window.animateCheckbox(cb);
          this.updateToolbar();
        });
      });

      document.querySelectorAll('.server-row').forEach((row) => {
        row.addEventListener('click', (e) => {
          if (['A', 'BUTTON', 'INPUT', 'LABEL'].includes(e.target.tagName) || e.target.closest('a, button, label')) return;
          var cb = row.querySelector('.server-checkbox');
          cb.checked = !cb.checked;
          if (window.animateCheckbox) window.animateCheckbox(cb);
          this.updateToolbar();
        });
      });

      this.updateToolbar();
      this.staggerRows();
    },

    getChecked() { return Array.from(document.querySelectorAll('.server-checkbox:checked')); },

    setFloatingVisible(show) {
      const el = document.getElementById('floatingToolbar');
      if (show) { el.style.opacity = '1'; el.style.transform = 'translateX(-50%) translateY(0)'; el.style.pointerEvents = 'auto'; }
      else { el.style.opacity = '0'; el.style.transform = 'translateX(-50%) translateY(-10px)'; el.style.pointerEvents = 'none'; }
    },

    showInlineToolbar() {
      document.getElementById('bulkToolbarRow').style.gridTemplateRows = '1fr';
      requestAnimationFrame(() => { document.getElementById('bulkToolbarContent').style.opacity = '1'; });
    },

    hideInlineToolbar() {
      document.getElementById('bulkToolbarContent').style.opacity = '0';
      setTimeout(() => { document.getElementById('bulkToolbarRow').style.gridTemplateRows = '0fr'; }, 80);
    },

    updateToolbar() {
      const checked = this.getChecked();
      document.querySelectorAll('.selection-count').forEach((el) => { el.textContent = checked.length + ' ' + (window.__i18n.selected || 'selected'); });
      if (checked.length > 0) { this.showInlineToolbar(); this.setFloatingVisible(!this.sentinelVisible); }
      else { this.hideInlineToolbar(); this.setFloatingVisible(false); }
    },

    bulkDelete() {
      const checked = this.getChecked();
      if (!checked.length) return;
      const count = checked.length;
      const msg = count === 1
        ? (window.__i18n.deleteServerConfirm || 'Delete this server? All data will be permanently removed.')
        : (window.__i18n.deleteServersConfirmCount || 'Delete {count} servers? All data will be permanently removed.').replace('{count}', count);
      window.modal.confirm({
        title: count === 1
          ? (window.__i18n.deleteServer || 'Delete Server')
          : (window.__i18n.deleteServersTitleCount || 'Delete {count} Servers').replace('{count}', count),
        body: msg, danger: true, confirmLabel: window.__i18n.delete || 'Delete',
        onConfirm: () => {
          const ids = checked.map((cb) => cb.value);
          let chain = Promise.resolve(), failed = false;
          ids.forEach((id) => { chain = chain.then(() => fetch('/api/v2/admin/servers/' + id, { method: 'DELETE' }).then((r) => { if (!r.ok) failed = true; })); });
          chain.then(() => {
            if (failed) { showToast(window.__i18n.someServersFailedToDelete || 'Some servers failed to delete.', 'error'); return; }
            showToast(window.__i18n.serversDeleted || 'Servers deleted.', 'success'); window.location.reload();
          }).catch((err) => { console.error('Bulk delete error:', err); showToast(window.__i18n.failedToDeleteServers || 'Failed to delete servers.', 'error'); });
        }
      });
    },

    deleteServer(id, name) {
      window.modal.confirm({
        title: window.__i18n.deleteServer || 'Delete Server',
        body: (window.__i18n.deleteServerConfirmNamed || 'Delete "{name}"? All data will be permanently removed.').replace('{name}', name),
        danger: true, confirmLabel: window.__i18n.delete || 'Delete',
        onConfirm: async () => {
          try {
            const r = await fetch('/api/v2/admin/servers/' + id, { method: 'DELETE' });
            if (!r.ok) throw new Error('Failed');
            showToast(window.__i18n.serverDeleted || 'Server deleted.', 'success');
            window.location.reload();
          } catch (err) {
            showToast(window.__i18n.failedToDeleteServer || 'Failed to delete server.', 'error');
          }
        }
      });
    },

    staggerRows() {
      var _rootStyle = getComputedStyle(document.documentElement);
      var _dur = _rootStyle.getPropertyValue('--dur-default').trim() || '0.22s';
      var _ease = _rootStyle.getPropertyValue('--ease-standard').trim() || 'ease';
      const rows = document.querySelectorAll('#serverTable tbody tr');
      rows.forEach((row, i) => {
        row.style.opacity = '0'; row.style.transform = 'translateY(4px)'; row.style.transition = 'none';
        setTimeout(() => {
          row.style.transition = 'opacity ' + _dur + ' ' + _ease + ', transform ' + _dur + ' ' + _ease;
          row.style.opacity = '1'; row.style.transform = 'translateY(0)';
          setTimeout(() => { row.style.transition = ''; row.style.opacity = ''; row.style.transform = ''; }, 240);
        }, 60 + i * 28);
      });
    },
  };

  sm.init();

  window.bulkDelete = function() { sm.bulkDelete(); };
  window.deleteServer = function(id, name) { sm.deleteServer(id, name); };
})();
</script>

<script nonce="<%- nonce %>">
(function() {
  document.getElementById('refreshBtn').addEventListener('click', function() {
    window.location.reload();
  });

  document.querySelectorAll('.kick-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var serverId = btn.dataset.serverId;
      if (!confirm('<%= t('queueKickConfirm') %>'.replace('{{id}}', serverId))) return;
      try {
        var resp = await fetch('/admin/queue/' + encodeURIComponent(serverId) + '/kick', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        var data = await resp.json();
        if (data.removed) {
          btn.closest('tr').remove();
        }
      } catch (e) {
        showToast('<%= t('queueKickFailed') %>', 'error');
      }
    });
  });

  document.querySelectorAll('.ban-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var userId = btn.dataset.userId;
      if (!confirm('<%= t('queueBanConfirm') %>'.replace('{{id}}', userId))) return;
      try {
        var resp = await fetch('/admin/queue/users/' + encodeURIComponent(userId) + '/ban', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ minutes: 30 })
        });
        var data = await resp.json();
        if (data.banned) {
          showToast('<%= t('queueBanSuccess') %>', 'success');
        }
      } catch (e) {
        showToast('<%= t('queueBanFailed') %>', 'error');
      }
    });
  });
})();
</script>

<% if (showRadar) { %>
<script nonce="<%- nonce %>">
(function() {
  var csrfToken = '<%= csrfToken %>';
  var msgScanning = <%- JSON.stringify(t('scanningInProgress')) %>;
  var msgScanOk = <%- JSON.stringify(t('scanCompleteNoThreats')) %>;
  var msgScanFailed = <%- JSON.stringify(t('scanFailedMsg')) %>;
  var msgScanRequestFailed = <%- JSON.stringify(t('scanRequestFailed')) %>;
  var msgEnterServerId = <%- JSON.stringify(t('enterServerId')) %>;
  var msgEnterHash = <%- JSON.stringify(t('enterFileHash')) %>;
  var msgLookingUp = <%- JSON.stringify(t('lookingUp')) %>;
  var msgMalicious = <%- JSON.stringify(t('maliciousDetected')) %>;
  var msgFileFlagged = <%- JSON.stringify(t('fileFlagged')) %>;
  var msgClean = <%- JSON.stringify(t('scanClean')) %>;
  var msgNoThreats = <%- JSON.stringify(t('noThreatsFound')) %>;
  var msgLookupFailed = <%- JSON.stringify(t('lookupFailed')) %>;

  // Scan server
  var scanBtn = document.getElementById('scanBtn');
  if (scanBtn) {
    scanBtn.addEventListener('click', function() {
      var serverId = document.getElementById('scanServerId')?.value?.trim();
      if (!serverId) { showToast(msgEnterServerId, 'error'); return; }
      var resultEl = document.getElementById('scanResult');
      resultEl.classList.remove('hidden');
      resultEl.innerHTML = '<p class="al-text-muted">' + msgScanning + '</p>';
      fetch('/admin/radar/scan/' + serverId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      }).then(function(r) { return r.json(); }).then(function(res) {
        if (res.success) {
          resultEl.innerHTML = '<div class="al-alert-success"><p class="al-alert-title">' + msgScanOk + '</p></div>';
        } else {
          resultEl.innerHTML = '<div class="al-alert-danger"><p class="al-alert-title">' + (res.message || msgScanFailed) + '</p></div>';
        }
      }).catch(function() {
        resultEl.innerHTML = '<div class="al-alert-danger"><p class="al-alert-title">' + msgScanRequestFailed + '</p></div>';
      });
    });
  }

  // VT hash scan
  var vtScanBtn = document.getElementById('vtScanBtn');
  if (vtScanBtn) {
    vtScanBtn.addEventListener('click', function() {
      var hash = document.getElementById('vtHashInput')?.value?.trim();
      if (!hash) { showToast(msgEnterHash, 'error'); return; }
      var resultEl = document.getElementById('vtScanResult');
      resultEl.classList.remove('hidden');
      resultEl.innerHTML = '<p class="al-text-muted">' + msgLookingUp + '</p>';
      fetch('/admin/radar/virustotal/scan/' + encodeURIComponent(hash), {
        method: 'GET',
        headers: { 'Accept': 'application/json' },
      }).then(function(r) { return r.json(); }).then(function(data) {
        if (data.malicious) {
          resultEl.innerHTML = '<div class="al-alert-danger"><p class="al-alert-title">' + msgMalicious + '</p><p class="al-alert-body">' + (data.message || msgFileFlagged) + '</p></div>';
        } else {
          resultEl.innerHTML = '<div class="al-alert-success"><p class="al-alert-title">' + msgClean + '</p><p class="al-alert-body">' + (data.message || msgNoThreats) + '</p></div>';
        }
      }).catch(function() {
        resultEl.innerHTML = '<div class="al-alert-danger"><p class="al-alert-title">' + msgLookupFailed + '</p></div>';
      });
    });
  }
})();
</script>
<% } %>

</div>

<%- include('../../layouts/admin-footer') %>
