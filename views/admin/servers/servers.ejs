<%- include('../../components/header', { title: 'Servers' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>

    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12" x-data="serverManager()">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Servers' }
      ] }) %>

      <!-- Page header -->
      <%- include('../../components/ui/page-header', {
        title: req.translations.adminServersTitle,
        description: req.translations.adminServersText,
        actions: '<a href="/admin/servers/create" class="al-btn-primary inline-flex items-center gap-1.5">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + req.translations.createNewServer + '</a>'
      }) %>

      <div class="al-page-body">

        <% if (req.query.err == "none") { %>
          <%- include('../../components/ui/alert', { type: 'success', message: req.translations.actionCompleted }) %>
        <% } %>

        <!-- Sentinel — watched to know when toolbar scrolls off screen -->
        <div id="toolbarSentinel" class="h-px w-full" aria-hidden="true"></div>

        <!-- Bulk toolbar -->
        <div id="bulkToolbarRow" class="no-anim" style="display:grid;grid-template-rows:0fr;transition:grid-template-rows 0.36s cubic-bezier(0.16,1,0.3,1)">
          <div style="min-height:0;overflow:hidden">
            <div id="bulkToolbarContent" class="mb-3 pb-0.5" style="opacity:0;transition:opacity 0.28s ease">
              <div class="al-card flex items-center gap-2 p-2.5">
                <span class="selection-count text-[13px] font-medium mr-1" style="color:var(--theme-text);">0 selected</span>
                <div class="h-3.5 w-px mx-1" style="background:var(--theme-border);"></div>
                <button type="button" @click="bulkRadarScan()"
                  class="al-btn-secondary text-[11px]">
                  <%- icon('radar', { size: 12, class: 'shrink-0' }) %>
                  Radar Scan
                </button>
                <button type="button" @click="bulkDelete()"
                  class="al-btn-danger text-[11px] ml-auto">
                  <%- icon('trash-2', { size: 12, class: 'shrink-0' }) %>
                  Delete
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating pill — fixed below topbar when toolbar scrolls off screen -->
        <div id="floatingToolbar"
          style="position:fixed;top:72px;left:50%;transform:translateX(-50%) translateY(-10px);z-index:40;opacity:0;pointer-events:none;transition:opacity 0.22s ease,transform 0.22s cubic-bezier(0.16,1,0.3,1)">
          <div class="al-card flex items-center gap-2 p-2.5 shadow-xl">
            <span class="selection-count text-[13px] font-medium mr-1" style="color:var(--theme-text);">0 selected</span>
            <div class="h-3.5 w-px mx-1" style="background:var(--theme-border);"></div>
            <button type="button" @click="bulkRadarScan()"
              class="al-btn-secondary text-[11px]">
              <%- icon('radar', { size: 12, class: 'shrink-0' }) %>
              Radar Scan
            </button>
            <button type="button" @click="bulkDelete()"
              class="al-btn-danger text-[11px] ml-auto">
              <%- icon('trash-2', { size: 12, class: 'shrink-0' }) %>
              Delete
            </button>
          </div>
        </div>

        <!-- Server table -->
        <div class="overflow-x-auto shadow-sm rounded-xl border" id="serverTable" style="border-color:var(--theme-border);">
          <% if (servers.length === 0) { %>
            <%- include('../../components/ui/empty-state', {
              iconName: 'server',
              title: 'No servers yet',
              description: 'Create your first server to get started.',
              action: '<a href="/admin/servers/create" class="al-btn-primary">' + req.translations.createNewServer + '</a>'
            }) %>
          <% } else { %>
          <table class="al-table">
            <colgroup>
              <col style="min-width:40px">
              <col style="min-width:220px">
              <col style="min-width:140px">
              <col style="min-width:120px">
              <col style="min-width:160px">
              <col style="min-width:100px">
              <col style="min-width:160px">
            </colgroup>
            <thead class="al-table-head">
              <tr>
                <th scope="col" class="al-table-th w-10"></th>
                <th scope="col" class="al-table-th"><%= req.translations.name %></th>
                <th scope="col" class="al-table-th"><%= req.translations.Owner %></th>
                <th scope="col" class="al-table-th"><%= req.translations.Node %></th>
                <th scope="col" class="al-table-th"><%= req.translations.connection %></th>
                <th scope="col" class="al-table-th"><%= req.translations.Status %></th>
                <th scope="col" class="al-table-th"></th>
              </tr>
            </thead>
            <tbody>
              <% let srvIdx = 0; servers.forEach(function(server) { %>
              <tr style="--i:<%= srvIdx++ %>" class="al-table-tr cursor-pointer server-row" data-id="<%= server.id %>" data-uuid="<%= server.UUID %>">
                <td class="al-table-td w-10">
                  <input type="checkbox" class="server-checkbox rounded cursor-pointer" style="border-color:var(--theme-border-input);color:var(--theme-text-strong);background:var(--theme-bg-secondary)"
                    value="<%= server.id %>" data-uuid="<%= server.UUID %>" data-edit-id="<%= server.id %>" data-name="<%= server.name %>">
                </td>
                <td class="al-table-td">
                  <div class="flex items-center gap-2">
                    <span class="shrink-0">
                      <% if (server.Suspended) { %>
                        <span class="al-dot-offline"></span>
                      <% } else { %>
                        <span class="al-dot-online"></span>
                      <% } %>
                    </span>
                    <div>
                      <div class="font-medium truncate max-w-[200px] text-[13px]" style="color:var(--theme-text-strong);"><%= server.name %></div>
                      <div class="text-[10px] font-mono mt-0.5" style="color:var(--theme-text-muted);"><%= server.UUID %></div>
                    </div>
                  </div>
                </td>
                <td class="al-table-td">
                  <a href="/admin/users/view/<%= server.owner.id %>" class="flex items-center gap-1.5 group" onclick="event.stopPropagation()">
                    <img loading="lazy" decoding="async" class="h-5 w-5 rounded-md object-cover shrink-0"
                      src="<%= server.owner.avatar ? server.owner.avatar : '/avatar/' + encodeURIComponent(server.owner.username) %>" alt="<%= server.owner.username %>'s avatar">
                    <span class="font-medium text-[13px] group-hover:underline truncate max-w-[120px]" style="color:var(--theme-text-strong);"><%= server.owner.username %></span>
                  </a>
                </td>
                <td class="al-table-td">
                  <a href="/admin/node/<%= server.node.id %>/stats" class="font-medium text-[13px] hover:underline truncate max-w-[120px]" style="color:var(--theme-text-strong);" onclick="event.stopPropagation()"><%= server.node.name %></a>
                </td>
                <td class="al-table-td text-[13px]">
                  <%= server.node.address %>:<%= JSON.parse(server.Ports).filter(p => p.primary).map(p => p.externalPort || String(p.Port || '').split(':')[0]).pop() %>
                </td>
                <td class="al-table-td">
                  <span class="inline-flex items-center rounded-md px-1.5 py-0.5 text-[11px] font-medium ring-1 ring-inset"
                    style="<%= server.Suspended ? 'background:var(--theme-warning-bg);color:var(--theme-warning)' : 'background:var(--theme-success-bg);color:var(--theme-success)' %>">
                    <%= server.Suspended ? 'Suspended' : 'Enabled' %>
                  </span>
                </td>
                <td class="al-table-td">
                  <div class="flex items-center gap-1.5">
                    <a href="/server/<%= server.UUID %>" onclick="event.stopPropagation()" title="Open console" aria-label="Open console"
                      class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center">
                      <%- icon('external-link', { size: 16, class: 'shrink-0' }) %>
                    </a>
                    <a href="/admin/servers/edit/<%= server.id %>" onclick="event.stopPropagation()" title="Edit" aria-label="Edit server"
                      class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center">
                      <%- icon('pencil', { size: 16, class: 'shrink-0' }) %>
                    </a>
                    <button type="button" @click="event.stopPropagation(); deleteServer('<%= server.id %>', '<%= server.name %>')" title="Delete" aria-label="Delete server"
                      class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center" style="color:var(--theme-danger);">
                      <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
                    </button>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../../components/loadingPopup') %>

<!-- Radar scan modal -->
<div id="radarScanModal" class="al-sheet-overlay fixed inset-0 z-50 hidden">
  <div class="flex items-end sm:items-center justify-center min-h-screen p-0 sm:p-4">
    <div class="fixed inset-0" id="radarScanModalBackdrop"></div>
    <div id="radarScanPanel" class="al-sheet-panel relative border rounded-2xl shadow-lg max-w-2xl w-full max-h-[85vh] flex flex-col overflow-hidden" style="background:var(--theme-bg-card); border-color:var(--theme-border);">

      <div class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
        <div>
          <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong);" id="radarScanModalTitle">Radar Scan</h3>
          <p class="text-xs mt-0.5" style="color:var(--theme-text-muted);" id="radarScanModalSubtitle">Pick a script and scan the server volume</p>
        </div>
        <button type="button" @click="closeRadarScanModal()" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close">
          <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
        </button>
      </div>

      <!-- Picker phase -->
      <div id="radarPickerPhase" class="px-6 py-4 overflow-y-auto max-h-[70vh]">

        <!-- Scan mode toggle — only shown when VT key configured -->
        <div id="scanModeToggle" class="hidden mb-5">
          <p class="text-xs font-medium mb-2" style="color:var(--theme-text-muted);">Scan method</p>
          <div class="flex flex-col sm:flex-row gap-2">
            <button type="button" id="modeBuiltin" @click="setScanMode('builtin')"
              class="flex-1 flex items-center gap-2 px-3 py-3 sm:py-2.5 rounded-lg border-2 text-xs font-medium transition-all min-h-[44px]" style="border-color:var(--theme-border-accent); background:var(--theme-text-strong); color:var(--theme-accent-text);">
              <%- icon('radar', { size: 14, class: 'shrink-0' }) %>
              Built-in patterns
            </button>
            <button type="button" id="modeVT" @click="setScanMode('vt')"
              class="flex-1 flex items-center gap-2 px-3 py-3 sm:py-2.5 rounded-lg border-2 text-xs font-medium transition-all min-h-[44px]" style="border-color:var(--theme-border); background:var(--theme-bg-secondary); color:var(--theme-text-muted);">
              <%- icon('shield', { size: 14, class: 'shrink-0' }) %>
              VirusTotal file scan
            </button>
          </div>
        </div>

        <!-- Built-in script picker -->
        <div id="builtinPickerSection">
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 items-stretch sm:items-start">
            <div class="flex-1">
              <label class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted);" for="scriptSelect">Script</label>
              <select id="scriptSelect" class="cs-native">
                <option value="">Loading scripts...</option>
              </select>
              <div class="custom-select" data-for="scriptSelect"></div>
            </div>
            <div class="sm:pt-5">
              <button type="button" id="runScanButton" @click="runRadarScan()"
                class="al-btn-primary w-full sm:w-auto min-h-[44px]">
                <%- icon('radar', { size: 16, class: 'shrink-0' }) %>
                Run Scan
              </button>
            </div>
          </div>
          <p id="scriptDescription" class="mt-2 text-xs italic min-h-4" style="color:var(--theme-text-muted);"></p>
        </div>

        <!-- VT file scan -->
        <div id="vtScanSection" class="hidden">
          <div class="rounded-lg p-3 sm:p-4 mb-4 text-xs space-y-1" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border); color:var(--theme-text-muted);">
            <p>Zips <span class="font-mono" style="color:var(--theme-text);">plugins/</span>, <span class="font-mono" style="color:var(--theme-text);">mods/</span>, <span class="font-mono" style="color:var(--theme-text);">config/</span>, <span class="font-mono" style="color:var(--theme-text);">addons/</span>, <span class="font-mono" style="color:var(--theme-text);">datapacks/</span> and uploads to VirusTotal.</p>
            <p>Excludes world folders, logs, cache. Max 32 MB zip. Takes 30–120 seconds.</p>
            <p style="color:var(--theme-warning);">Free tier: 4 requests/min · 500/day. Do not use for automated scanning.</p>
          </div>
          <button type="button" id="runVtScanButton" @click="runVtFileScan()"
            class="al-btn-primary w-full sm:w-auto min-h-[44px]">
            <%- icon('shield', { size: 16, class: 'shrink-0' }) %>
            Upload to VirusTotal
          </button>
        </div>

      </div>

      <!-- Results phase -->
      <div id="radarResultsPhase" class="hidden">
        <div id="radarSummaryBar" class="px-6 py-3 border-t flex items-center gap-3 sm:gap-4 overflow-x-auto" style="border-color:var(--theme-border); background:var(--theme-bg-secondary);"></div>
        <div id="radarServerTabs" class="hidden border-b px-6 pt-3 flex gap-1 overflow-x-auto" style="border-color:var(--theme-border);"></div>
        <div id="radarResultsBody" class="px-6 py-4 max-h-60 sm:max-h-80 overflow-y-auto"></div>
      </div>

      <!-- Footer -->
      <div class="flex gap-2 px-6 py-4 border-t justify-end" style="border-color:var(--theme-border);">
        <button type="button" id="radarRescanBtn" class="hidden text-xs hover:underline min-h-[44px] flex items-center justify-center sm:justify-start" style="color:var(--theme-text-muted);" @click="resetRadarToPickerPhase()">
          <%- icon('arrow-left', { class: 'size-3.5 inline mr-1' }) %> Run another scan
        </button>
        <div class="sm:ml-auto">
          <button type="button" @click="closeRadarScanModal()"
            class="al-btn-secondary w-full sm:w-auto min-h-[44px]">
            <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>
            Close
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
function serverManager() {
  return {
    vtEnabled: false,
    scanMode: 'builtin',
    currentServerIds: [],
    radarServerNames: {},
    availableScripts: [],
    sentinelVisible: true,

    init() {
      window._smInstance = this;
      const observer = new IntersectionObserver((entries) => {
        this.sentinelVisible = entries[0].isIntersecting;
        if (this.getChecked().length > 0) {
          this.setFloatingVisible(!this.sentinelVisible);
        }
      }, { threshold: 0 });
      observer.observe(document.getElementById('toolbarSentinel'));

      document.querySelectorAll('.server-checkbox').forEach((cb) => {
        cb.addEventListener('change', () => {
          if (window.animateCheckbox) window.animateCheckbox(cb);
          this.updateToolbar();
        });
      });

      document.querySelectorAll('.server-row').forEach((row) => {
        row.addEventListener('click', (e) => {
          if (['A', 'BUTTON', 'INPUT'].includes(e.target.tagName) || e.target.closest('a, button')) return;
          var cb = row.querySelector('.server-checkbox');
          cb.checked = !cb.checked;
          if (window.animateCheckbox) window.animateCheckbox(cb);
          this.updateToolbar();
        });
      });

      fetch('/admin/radar/virustotal-enabled')
        .then((r) => r.json())
        .then((d) => {
          this.vtEnabled = d.enabled;
          if (this.vtEnabled) document.getElementById('scanModeToggle').classList.remove('hidden');
        })
        .catch((err) => console.error('Failed to fetch VT status:', err));

      document.getElementById('radarScanModalBackdrop').addEventListener('click', () => this.closeRadarScanModal());
      document.getElementById('scriptSelect').addEventListener('change', () => this.updateScriptDescription());

      this.updateToolbar();
      this.staggerRows();
    },

    getChecked() { return Array.from(document.querySelectorAll('.server-checkbox:checked')); },

    setFloatingVisible(show) {
      const el = document.getElementById('floatingToolbar');
      if (show) { el.style.opacity = '1'; el.style.transform = 'translateX(-50%) translateY(0)'; el.style.pointerEvents = 'auto'; }
      else { el.style.opacity = '0'; el.style.transform = 'translateX(-50%) translateY(-10px)'; el.style.pointerEvents = 'none'; }
    },

    flipSiblings(before) {
      const table = document.getElementById('serverTable');
      if (!table || !before) return;
      const after = table.getBoundingClientRect();
      const dy = before.top - after.top;
      if (Math.abs(dy) < 1) return;
      const _rootStyle = getComputedStyle(document.documentElement);
      var TOOLBAR_TRANSITION_MS = '0.36s ' + (_rootStyle.getPropertyValue('--ease-standard').trim() || 'cubic-bezier(0.4, 0, 0.2, 1)');
      table.style.transition = 'none';
      table.style.transform = 'translateY(' + dy + 'px)';
      requestAnimationFrame(() => {
        table.style.transition = 'transform ' + TOOLBAR_TRANSITION_MS;
        table.style.transform = 'translateY(0)';
        table.addEventListener('transitionend', function cleanup() {
          table.style.transition = ''; table.style.transform = '';
          table.removeEventListener('transitionend', cleanup);
        });
      });
    },

    showInlineToolbar() {
      const row = document.getElementById('bulkToolbarRow'), content = document.getElementById('bulkToolbarContent');
      const table = document.getElementById('serverTable'), before = table ? table.getBoundingClientRect() : null;
      row.style.gridTemplateRows = '1fr';
      requestAnimationFrame(() => { this.flipSiblings(before); setTimeout(() => { content.style.opacity = '1'; }, 40); });
    },

    hideInlineToolbar() {
      const row = document.getElementById('bulkToolbarRow'), content = document.getElementById('bulkToolbarContent');
      const table = document.getElementById('serverTable'), before = table ? table.getBoundingClientRect() : null;
      content.style.opacity = '0';
      setTimeout(() => { row.style.gridTemplateRows = '0fr'; requestAnimationFrame(() => { this.flipSiblings(before); }); }, 80);
    },

    updateToolbar() {
      const checked = this.getChecked();
      document.querySelectorAll('.selection-count').forEach((el) => { el.textContent = checked.length + ' selected'; });
      if (checked.length > 0) { this.showInlineToolbar(); this.setFloatingVisible(!this.sentinelVisible); }
      else { this.hideInlineToolbar(); this.setFloatingVisible(false); }
    },

    bulkRadarScan() {
      const checked = this.getChecked();
      if (!checked.length) return;
      const ids = checked.map((cb) => cb.value), names = {};
      checked.forEach((cb) => { names[cb.value] = cb.dataset.name || cb.value; });
      this.radarServerNames = names;
      const label = checked.length === 1 ? names[ids[0]] : checked.length + ' servers';
      this.openRadarScanModal(ids, label);
    },

    removeServerRows(ids) {
      const tbody = document.querySelector('#serverTable tbody');
      const rows = ids.map((id) => document.querySelector('#serverTable .server-row[data-id="' + id + '"]')).filter(Boolean);
      rows.reduce((p, row) => p.then(() => al.removeRow(row)), Promise.resolve()).then(() => {
        this.updateToolbar();
        if (tbody && !tbody.querySelector('.server-row')) al.showEmpty(tbody, 'No servers yet.', 7);
      });
    },

    bulkDelete() {
      const checked = this.getChecked();
      if (!checked.length) return;
      const msg = checked.length === 1 ? 'Delete this server? All data will be permanently removed.' : 'Delete ' + checked.length + ' servers? All data will be permanently removed.';
      window.modal.confirm({
        title: checked.length === 1 ? 'Delete Server' : 'Delete ' + checked.length + ' Servers', body: msg, danger: true, confirmLabel: 'Delete',
        onConfirm: () => {
          const ids = checked.map((cb) => cb.value);
          let chain = Promise.resolve(), failed = false;
          ids.forEach((id) => { chain = chain.then(() => fetch('/admin/server/delete/' + id, { method: 'POST' }).then((r) => { if (!r.ok) failed = true; })); });
          chain.then(() => {
            if (failed) { showToast('Some servers failed to delete.', 'error'); return; }
            showToast('Servers deleted.', 'success'); this.removeServerRows(ids);
          }).catch((err) => { console.error('Bulk delete error:', err); showToast('Failed to delete servers.', 'error'); });
        }
      });
    },

    deleteServer(id, name) {
      window.modal.confirm({
        title: 'Delete Server', body: 'Delete "' + name + '"? All data will be permanently removed.', danger: true, confirmLabel: 'Delete',
        onConfirm: async () => {
          const d = await window.api('/admin/server/delete/' + id, 'POST');
          if (d !== null) { showToast('Server deleted.', 'success'); this.removeServerRows([String(id)]); }
        }
      });
    },

    setScanMode(mode) {
      this.scanMode = mode;
      const builtinBtn = document.getElementById('modeBuiltin'), vtBtn = document.getElementById('modeVT');
      const active = 'flex-1 flex items-center gap-2 px-3 py-2.5 rounded-lg border-2 border-neutral-800 dark:border-white bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-xs font-medium transition-all';
      const inactive = 'flex-1 flex items-center gap-2 px-3 py-2.5 rounded-lg border-2 border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 text-xs font-medium transition-all hover:border-neutral-400 dark:hover:border-neutral-500';
      if (mode === 'builtin') { builtinBtn.className = active; vtBtn.className = inactive; document.getElementById('builtinPickerSection').classList.remove('hidden'); document.getElementById('vtScanSection').classList.add('hidden'); }
      else { vtBtn.className = active; builtinBtn.className = inactive; document.getElementById('vtScanSection').classList.remove('hidden'); document.getElementById('builtinPickerSection').classList.add('hidden'); }
    },

    openRadarScanModal(serverId, serverName) {
      this.currentServerIds = Array.isArray(serverId) ? serverId : [serverId];
      if (!Array.isArray(serverId)) this.radarServerNames = {};
      this.radarServerNames[Array.isArray(serverId) ? serverId[0] : serverId] = serverName;
      document.getElementById('radarScanModalTitle').textContent = this.currentServerIds.length === 1 ? 'Radar Scan: ' + serverName : 'Radar Scan: ' + this.currentServerIds.length + ' servers';
      document.getElementById('radarScanModalSubtitle').textContent = 'Pick a script and run a scan against the server volume';
      document.getElementById('radarResultsPhase').classList.add('hidden');
      document.getElementById('radarRescanBtn').classList.add('hidden');
      document.getElementById('radarPickerPhase').classList.remove('hidden');
      this.setScanMode('builtin');
      const m = document.getElementById('radarScanModal'); m.classList.remove('hidden'); m.classList.add('flex');
      Animate.openModal(m, document.getElementById('radarScanPanel'));
      this.fetchRadarScripts();
    },

    closeRadarScanModal() {
      const m = document.getElementById('radarScanModal'), p = document.getElementById('radarScanPanel');
      Animate.closeModal(m, p, () => { m.classList.add('hidden'); m.classList.remove('flex'); });
      this.currentServerIds = []; this.radarServerNames = {};
    },

    resetRadarToPickerPhase() {
      document.getElementById('radarResultsPhase').classList.add('hidden');
      document.getElementById('radarRescanBtn').classList.add('hidden');
      document.getElementById('radarPickerPhase').classList.remove('hidden');
      this.setScanMode(this.scanMode);
    },

    fetchRadarScripts() {
      const select = document.getElementById('scriptSelect'), runBtn = document.getElementById('runScanButton');
      select.innerHTML = '<option value="">Loading...</option>'; runBtn.disabled = true;
      fetch('/admin/radar/scripts').then((r) => r.json()).then((data) => {
        if (!data.success) { showToast('Failed to fetch scripts', 'error'); return; }
        this.availableScripts = data.scripts || []; select.innerHTML = '';
        if (!this.availableScripts.length) { select.innerHTML = '<option value="">No scripts available</option>'; document.getElementById('scriptDescription').textContent = 'No radar scripts found in storage/radar/'; return; }
        this.availableScripts.forEach((s) => { const opt = document.createElement('option'); opt.value = s.id; opt.textContent = s.name; select.appendChild(opt); });
        this.updateScriptDescription(); runBtn.disabled = false;
      }).catch(() => showToast('Failed to fetch scripts', 'error'));
    },

    updateScriptDescription() {
      const id = document.getElementById('scriptSelect').value;
      const script = this.availableScripts.find((s) => s.id === id);
      document.getElementById('scriptDescription').textContent = script ? script.description : '';
    },

    runRadarScan() {
      if (!this.currentServerIds.length) return;
      const scriptId = document.getElementById('scriptSelect').value;
      if (!scriptId) { showToast('Select a script first', 'error'); return; }
      const btn = document.getElementById('runScanButton');
      btn.disabled = true; btn.innerHTML = alIcon('loader-circle', 'animate-spin h-4 w-4') + ' Scanning...';
      Promise.all(this.currentServerIds.map((id) =>
        fetch('/admin/radar/scan/' + id, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ scriptId }) })
          .then((r) => r.json()).then((data) => ({ id, data }))
      )).then((allResults) => {
        if (this.currentServerIds.length > 1) {
          allResults.forEach((r) => { const name = this.radarServerNames[r.id] || r.id; if (!r.data.success) { showToast(name + ': scan failed', 'error'); } else { const count = (r.data.results && r.data.results.results || []).reduce((s, x) => s + (x.matches ? x.matches.length : 0), 0); showToast(name + ': ' + (count > 0 ? count + ' finding(s)' : 'clean'), count > 0 ? 'error' : 'success'); } });
          this.closeRadarScanModal(); return;
        }
        var single = allResults[0];
        if (!single.data.success) { showToast('Scan failed: ' + (single.data.error || 'Unknown error'), 'error'); }
        else { document.getElementById('radarPickerPhase').classList.add('hidden'); document.getElementById('radarResultsPhase').classList.remove('hidden'); document.getElementById('radarRescanBtn').classList.remove('hidden'); this.renderRadarResults(allResults); }
      }).catch((err) => { console.error('Radar scan error:', err); showToast('Failed to run radar scan', 'error'); })
        .finally(() => { btn.disabled = false; btn.innerHTML = alIcon('scan-search', 'w-4 h-4', { strokeWidth: 1.5 }) + ' Run Scan'; });
    },

    runVtFileScan() {
      if (!this.currentServerIds.length) return;
      const serverId = this.currentServerIds[0];
      const btn = document.getElementById('runVtScanButton');
      btn.disabled = true; btn.innerHTML = alIcon('loader-circle', 'animate-spin h-4 w-4') + ' Starting...';
      this.closeRadarScanModal();
      const p = window.loadingPopupSystem;
      p.open('VirusTotal Scan', 'default');
      p.setProgress(5, 'Requesting file archive from node...');
      p.addStep('Connecting to node');
      const steps = [
        { at: 3000, pct: 12, msg: 'Node zipping plugins, mods and config...', step: 'Archiving server files' },
        { at: 9000, pct: 24, msg: 'Uploading archive to VirusTotal...', step: 'Archive ready — uploading' },
        { at: 16000, pct: 36, msg: 'VirusTotal queuing analysis...', step: 'Upload complete' },
        { at: 26000, pct: 48, msg: 'Analysis in progress — checking signatures...', step: 'VT analysis started' },
        { at: 40000, pct: 60, msg: 'Running 70+ antivirus engines...', step: 'Scanning with multiple engines' },
        { at: 56000, pct: 72, msg: 'Collecting results...', step: 'Engines finishing up' },
        { at: 75000, pct: 82, msg: 'Waiting for final verdicts...', step: 'Collecting final results' },
      ];
      const timers = steps.map((s) => setTimeout(() => { p.setProgress(s.pct, s.msg); p.addStep(s.step); }, s.at));
      fetch('/admin/radar/vtscan/' + serverId, { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then((r) => r.json()).then((data) => {
          timers.forEach((t) => clearTimeout(t));
          if (!data.success) { p.setProgress(100, 'Scan failed'); p.addStep(data.error || 'VT scan failed', 'error'); p.setIcon('error'); showToast(data.error || 'VT scan failed', 'error'); setTimeout(() => p.close(), 3000); return; }
          p.setProgress(100, 'Scan complete'); p.addStep('Analysis complete', 'done'); p.setIcon('done');
          setTimeout(() => {
            p.close();
            document.getElementById('radarScanModalTitle').textContent = 'VirusTotal Scan: ' + (data.serverName || 'Server');
            document.getElementById('radarScanModalSubtitle').textContent = 'Results from VirusTotal analysis';
            document.getElementById('radarPickerPhase').classList.add('hidden');
            document.getElementById('radarResultsPhase').classList.remove('hidden');
            document.getElementById('radarRescanBtn').classList.remove('hidden');
            var m = document.getElementById('radarScanModal'); m.classList.remove('hidden'); m.classList.add('flex');
            Animate.openModal(m, document.getElementById('radarScanPanel'));
            this.renderVtFileScanResults(data);
          }, 800);
        }).catch((err) => {
          timers.forEach((t) => clearTimeout(t)); console.error('VT scan error:', err);
          p.setProgress(100, 'Request failed'); p.addStep('Network error', 'error'); p.setIcon('error');
          showToast('VT file scan failed', 'error'); setTimeout(() => p.close(), 3000);
        }).finally(() => { btn.disabled = false; btn.innerHTML = alIcon('shield-check', 'w-4 h-4', { strokeWidth: 1.5 }) + ' Upload to VirusTotal'; });
    },

    checkVirusTotal(hash, matchId) {
      var btn = document.querySelector('#' + matchId + ' .vt-btn'), resultEl = document.querySelector('.vt-result-' + matchId);
      if (!btn || !resultEl) return;
      btn.disabled = true; btn.textContent = '...';
      fetch('/admin/radar/virustotal', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ hash }) })
        .then((r) => r.json()).then((data) => {
          if (!data.success) { resultEl.innerHTML = '<span class="text-xs text-red-500">VT error: ' + window.escHtml(data.error) + '</span>'; }
          else if (!data.found) { resultEl.innerHTML = '<span class="text-xs text-neutral-400">Not in VirusTotal database</span>'; }
          else {
            var colour = data.malicious > 0 ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400';
            resultEl.innerHTML = '<div class="flex items-center gap-2 flex-wrap"><span class="text-xs font-medium ' + colour + '">' + data.malicious + '/' + data.total + ' engines detected</span>' + (data.name ? '<span class="text-xs text-neutral-400">' + window.escHtml(data.name) + '</span>' : '') + (data.firstSeen ? '<span class="text-xs text-neutral-400">first seen ' + data.firstSeen + '</span>' : '') + '<a href="' + data.vtLink + '" target="_blank" rel="noopener" class="text-xs text-blue-500 hover:underline">View on VT →</a></div>';
            btn.remove();
          }
          resultEl.classList.remove('hidden');
        }).catch(() => { resultEl.innerHTML = '<span class="text-xs text-red-500">Request failed</span>'; resultEl.classList.remove('hidden'); btn.disabled = false; btn.textContent = 'VT'; });
    },

    renderVtFileScanResults(data) {
      const summaryEl = document.getElementById('radarSummaryBar'), bodyEl = document.getElementById('radarResultsBody');
      document.getElementById('radarServerTabs').classList.add('hidden');
      if (data.pending) { summaryEl.innerHTML = '<span class="text-sm text-amber-600 dark:text-amber-400 font-medium">Analysis still processing on VT</span>'; bodyEl.innerHTML = '<div class="py-6 text-center"><p class="text-sm text-neutral-600 dark:text-neutral-300 mb-3">VT is still analysing. Check directly:</p><a href="' + data.vtLink + '" target="_blank" rel="noopener" class="text-sm text-blue-500 hover:underline break-all">' + window.escHtml(data.vtLink) + '</a></div>'; return; }
      const malCount = (data.maliciousEngines && data.maliciousEngines.length) || 0, total = data.totalEngines || 0;
      if (malCount === 0) { summaryEl.innerHTML = '<span class="inline-flex items-center gap-1.5 text-sm text-emerald-600 dark:text-emerald-400 font-medium">' + alIcon('circle-check', 'w-4 h-4') + 'Clean — 0/' + total + ' engines flagged</span><a href="' + data.vtLink + '" target="_blank" rel="noopener" class="ml-auto text-xs text-blue-500 hover:underline">Full report →</a>'; bodyEl.innerHTML = '<div class="py-8 text-center">' + alIcon('shield-check', 'w-8 h-8 mx-auto mb-3 text-emerald-400', { strokeWidth: 1 }) + '<p class="text-sm font-medium text-neutral-600 dark:text-neutral-300">No engines flagged anything</p><p class="text-xs text-neutral-400 mt-1">' + total + ' engines scanned the zip</p></div>'; return; }
      summaryEl.innerHTML = '<span class="inline-flex items-center gap-1.5 text-sm text-red-600 dark:text-red-400 font-medium">' + alIcon('triangle-alert', 'w-4 h-4') + malCount + '/' + total + ' engines flagged</span><a href="' + data.vtLink + '" target="_blank" rel="noopener" class="ml-auto text-xs text-blue-500 hover:underline">Full report →</a>';
      let html = '<div class="space-y-1">';
      data.maliciousEngines.forEach((e) => { html += '<div class="flex items-center justify-between px-3 py-2 rounded-lg bg-red-50 dark:bg-red-900/10 border border-red-100 dark:border-red-900/20"><span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">' + window.escHtml(e.engine) + '</span><span class="text-xs text-red-600 dark:text-red-400 font-mono">' + window.escHtml(e.result || 'flagged') + '</span></div>'; });
      html += '</div>'; bodyEl.innerHTML = html;
    },

    renderRadarResults(results) {
      const tabsEl = document.getElementById('radarServerTabs'), bodyEl = document.getElementById('radarResultsBody'), summaryEl = document.getElementById('radarSummaryBar');
      if (!results.length) { tabsEl.classList.add('hidden'); summaryEl.innerHTML = '<span class="text-sm text-neutral-500">No results returned.</span>'; bodyEl.innerHTML = ''; return; }
      if (results.length === 1) { tabsEl.classList.add('hidden'); this.renderSingleServerResults(results[0].data.results, bodyEl, summaryEl); }
      else {
        tabsEl.classList.remove('hidden'); tabsEl.innerHTML = '';
        results.forEach((r, i) => {
          const name = this.radarServerNames[r.id] || ('Server ' + r.id), count = this.countFindings(r.data.results);
          const tab = document.createElement('button'); tab.type = 'button'; tab.dataset.tabIndex = i;
          tab.className = 'tab-btn shrink-0 px-3 py-1.5 text-xs font-medium rounded-t-lg border border-b-0 transition-colors ' + (i === 0 ? 'bg-white dark:bg-neutral-800 border-neutral-200 dark:border-neutral-700/50 text-neutral-800 dark:text-white' : 'bg-neutral-50 dark:bg-neutral-800/40 border-transparent text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300');
          tab.innerHTML = window.escHtml(name) + (count > 0 ? ' <span class="ml-1 px-1.5 py-0.5 rounded-full text-xs bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400">' + count + '</span>' : ' <span class="ml-1 px-1.5 py-0.5 rounded-full text-xs bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400">clean</span>');
          tab.addEventListener('click', () => {
            tabsEl.querySelectorAll('.tab-btn').forEach((t) => { t.className = 'tab-btn shrink-0 px-3 py-1.5 text-xs font-medium rounded-t-lg border border-b-0 transition-colors bg-neutral-50 dark:bg-neutral-800/40 border-transparent text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300'; });
            tab.className = 'tab-btn shrink-0 px-3 py-1.5 text-xs font-medium rounded-t-lg border border-b-0 transition-colors bg-white dark:bg-neutral-800 border-neutral-200 dark:border-neutral-700/50 text-neutral-800 dark:text-white';
            this.renderSingleServerResults(results[i].data.results, bodyEl, summaryEl);
          });
          tabsEl.appendChild(tab);
        });
        this.renderSingleServerResults(results[0].data.results, bodyEl, summaryEl);
      }
    },

    countFindings(scanResults) {
      if (!scanResults || !scanResults.results) return 0;
      return scanResults.results.reduce((s, r) => s + (r.matches ? r.matches.length : 0), 0);
    },

    renderSingleServerResults(scanResults, bodyEl, summaryEl) {
      const total = this.countFindings(scanResults);
      const sevStyles = { critical: 'bg-red-100 dark:bg-red-900/20 text-red-600 dark:text-red-400', high: 'bg-orange-100 dark:bg-orange-900/20 text-orange-600 dark:text-orange-400', medium: 'bg-amber-100 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400', low: 'bg-yellow-100 dark:bg-yellow-900/20 text-yellow-600 dark:text-yellow-400' };
      if (total === 0) { summaryEl.innerHTML = '<span class="inline-flex items-center gap-1.5 text-sm text-emerald-600 dark:text-emerald-400 font-medium">' + alIcon('circle-check', 'w-4 h-4') + 'No suspicious files found</span>'; bodyEl.innerHTML = '<div class="py-8 text-center">' + alIcon('shield-check', 'w-8 h-8 mx-auto mb-3 text-emerald-400', { strokeWidth: 1 }) + '<p class="text-sm font-medium text-neutral-600 dark:text-neutral-300">All clear</p><p class="text-xs text-neutral-400 mt-1">No matches found for any pattern in this script</p></div>'; return; }
      const patternCount = scanResults.results.length;
      summaryEl.innerHTML = '<span class="inline-flex items-center gap-1.5 text-sm text-red-600 dark:text-red-400 font-medium">' + alIcon('triangle-alert', 'w-4 h-4') + total + ' finding' + (total !== 1 ? 's' : '') + ' across ' + patternCount + ' pattern' + (patternCount !== 1 ? 's' : '') + '</span>';
      let html = '<div class="space-y-3">';
      scanResults.results.forEach((result) => {
        const sev = result.severity || 'low', count = result.matches ? result.matches.length : 0;
        html += '<div class="rounded-lg border border-neutral-200 dark:border-neutral-700/50 overflow-hidden"><div class="flex items-center justify-between px-3 py-2 bg-neutral-50 dark:bg-neutral-800/60"><div class="min-w-0"><p class="text-xs font-medium text-neutral-700 dark:text-neutral-200">' + window.escHtml(result.pattern.description) + '</p><p class="text-xs text-neutral-400 font-mono mt-0.5 truncate">' + window.escHtml(result.pattern.pattern) + '</p></div><div class="ml-3 shrink-0 flex items-center gap-1.5"><span class="text-xs font-medium px-2 py-0.5 rounded-full ' + (sevStyles[sev] || sevStyles.low) + '">' + sev + '</span><span class="text-xs text-neutral-500">' + count + ' match' + (count !== 1 ? 'es' : '') + '</span></div></div><ul class="divide-y divide-neutral-100 dark:divide-neutral-700/30">';
        result.matches.forEach((match) => {
          const matchId = 'match-' + Math.random().toString(36).slice(2, 9);
          html += '<li class="px-3 py-1.5" id="' + matchId + '"><div class="flex items-center justify-between gap-4"><span class="text-xs font-mono text-neutral-600 dark:text-neutral-300 truncate">' + window.escHtml(match.path) + '</span><div class="flex items-center gap-2 shrink-0">';
          if (match.size) html += '<span class="text-xs text-neutral-400">' + this.formatBytes(match.size) + '</span>';
          if (match.hash && this.vtEnabled) { html += '<button type="button" onclick="window._sm.checkVirusTotal(\'' + window.escHtml(match.hash) + '\',\'' + matchId + '\')" class="vt-btn text-xs px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-600 text-neutral-500 dark:text-neutral-400 hover:border-blue-400 hover:text-blue-500 transition-colors font-medium">VT</button>'; }
          html += '</div></div><div class="vt-result-' + matchId + ' mt-1 hidden"></div></li>';
        });
        html += '</ul></div>';
      });
      html += '</div>'; bodyEl.innerHTML = html;
    },

    formatBytes(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
      if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' MB';
      return (bytes / 1073741824).toFixed(1) + ' GB';
    },

    staggerRows() {
      const _rootStyle = getComputedStyle(document.documentElement);
      var _dur = _rootStyle.getPropertyValue('--dur-default').trim() || '0.22s';
      var _ease = _rootStyle.getPropertyValue('--ease-standard').trim() || 'ease';
      const rows = document.querySelectorAll('#serverTable tbody tr');
      rows.forEach((row, i) => {
        row.style.opacity = '0'; row.style.transform = 'translateY(4px)'; row.style.transition = 'none';
        setTimeout(() => {
          row.style.transition = 'opacity ' + _dur + ' ' + _ease + ', transform ' + _dur + ' ' + _ease;
          row.style.opacity = '1'; row.style.transform = 'translateY(0)';
          setTimeout(() => { row.style.transition = ''; row.style.opacity = ''; row.style.transform = ''; }, 240);
        }, 60 + i * 28);
      });
    },
  };
}
</script>
<script nonce="<%- nonce %>">
  window._sm = { checkVirusTotal: function(hash, matchId) { if (window._smInstance) window._smInstance.checkVirusTotal(hash, matchId); } };
</script>

<%- include('../../components/footer') %>
