<%- include('../../components/header', { title: 'Servers' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/template') %>
    </div>

    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Servers' }
      ] }) %>

      <!-- Page header -->
      <%- include('../../components/ui/page-header', {
        title: req.translations.adminServersTitle,
        description: req.translations.adminServersText,
        actions: '<a href="/admin/servers/create" class="al-btn-primary inline-flex items-center gap-1.5">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + req.translations.createNewServer + '</a>'
      }) %>

      <div class="al-page-body">

        <% if (req.query.err == "none") { %>
          <%- include('../../components/ui/alert', { type: 'success', message: req.translations.actionCompleted }) %>
        <% } %>

        <!-- Sentinel — watched to know when toolbar scrolls off screen -->
        <div id="toolbarSentinel" class="h-px w-full" aria-hidden="true"></div>

        <!-- Bulk toolbar -->
        <div id="bulkToolbarRow" class="no-anim" style="display:grid;grid-template-rows:0fr;transition:grid-template-rows 0.36s cubic-bezier(0.16,1,0.3,1)">
          <div style="min-height:0;overflow:hidden">
            <div id="bulkToolbarContent" class="mb-4 pb-0.5" style="opacity:0;transition:opacity 0.28s ease">
              <div class="al-card flex items-center gap-2 p-3">
                <span class="selection-count text-sm font-medium mr-1" style="color:var(--theme-text);">0 selected</span>
                <div class="h-4 w-px mx-1" style="background:var(--theme-border);"></div>
                <button type="button" onclick="bulkRadarScan()"
                  class="al-btn-secondary text-xs">
                  <%- icon('radar', { size: 14, class: 'shrink-0' }) %>
                  Radar Scan
                </button>
                <button type="button" onclick="bulkDelete()"
                  class="al-btn-danger text-xs ml-auto">
                  <%- icon('trash-2', { size: 14, class: 'shrink-0' }) %>
                  Delete
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating pill — fixed below topbar when toolbar scrolls off screen -->
        <div id="floatingToolbar"
          style="position:fixed;top:72px;left:50%;transform:translateX(-50%) translateY(-10px);z-index:40;opacity:0;pointer-events:none;transition:opacity 0.22s ease,transform 0.22s cubic-bezier(0.16,1,0.3,1)">
          <div class="al-card flex items-center gap-2 p-3 shadow-xl">
            <span class="selection-count text-sm font-medium mr-1" style="color:var(--theme-text);">0 selected</span>
            <div class="h-4 w-px mx-1" style="background:var(--theme-border);"></div>
            <button type="button" onclick="bulkRadarScan()"
              class="al-btn-secondary text-xs">
              <%- icon('radar', { size: 14, class: 'shrink-0' }) %>
              Radar Scan
            </button>
            <button type="button" onclick="bulkDelete()"
              class="al-btn-danger text-xs ml-auto">
              <%- icon('trash-2', { size: 14, class: 'shrink-0' }) %>
              Delete
            </button>
          </div>
        </div>

        <!-- Server table -->
        <div class="overflow-x-auto shadow-sm rounded-xl border" id="serverTable" style="border-color:var(--theme-border);">
          <% if (servers.length === 0) { %>
            <%- include('../../components/ui/empty-state', {
              iconName: 'server',
              title: 'No servers yet',
              description: 'Create your first server to get started.',
              action: '<a href="/admin/servers/create" class="al-btn-primary">' + req.translations.createNewServer + '</a>'
            }) %>
          <% } else { %>
          <table class="al-table">
            <colgroup>
              <col style="min-width:40px">
              <col style="min-width:220px">
              <col style="min-width:140px">
              <col style="min-width:120px">
              <col style="min-width:160px">
              <col style="min-width:100px">
              <col style="min-width:160px">
            </colgroup>
            <thead class="al-table-head">
              <tr>
                <th scope="col" class="al-table-th w-10"></th>
                <th scope="col" class="al-table-th"><%= req.translations.name %></th>
                <th scope="col" class="al-table-th"><%= req.translations.Owner %></th>
                <th scope="col" class="al-table-th"><%= req.translations.Node %></th>
                <th scope="col" class="al-table-th"><%= req.translations.connection %></th>
                <th scope="col" class="al-table-th"><%= req.translations.Status %></th>
                <th scope="col" class="al-table-th"></th>
              </tr>
            </thead>
            <tbody>
              <% let srvIdx = 0; servers.forEach(function(server) { %>
              <tr style="--i:<%= srvIdx++ %>" class="al-table-tr cursor-pointer server-row" data-id="<%= server.id %>" data-uuid="<%= server.UUID %>">
                <td class="al-table-td w-10">
                  <input type="checkbox" class="server-checkbox rounded border-neutral-300 dark:border-neutral-600 text-neutral-800 dark:bg-neutral-700 cursor-pointer"
                    value="<%= server.id %>" data-uuid="<%= server.UUID %>" data-edit-id="<%= server.id %>" data-name="<%= server.name %>">
                </td>
                <td class="al-table-td">
                  <div class="flex items-center gap-3">
                    <span class="shrink-0">
                      <% if (server.Suspended) { %>
                        <span class="al-dot-offline"></span>
                      <% } else { %>
                        <span class="al-dot-online"></span>
                      <% } %>
                    </span>
                    <div>
                      <div class="font-medium truncate max-w-[200px]" style="color:var(--theme-text-strong);"><%= server.name %></div>
                      <div class="text-xs font-mono mt-0.5" style="color:var(--theme-text-muted);"><%= server.UUID %></div>
                    </div>
                  </div>
                </td>
                <td class="al-table-td">
                  <a href="/admin/users/view/<%= server.owner.id %>" class="flex items-center gap-2 group" onclick="event.stopPropagation()">
                    <img loading="lazy" decoding="async" class="h-6 w-6 rounded-md object-cover shrink-0"
                      src="<%= server.owner.avatar ? server.owner.avatar : '/avatar/' + encodeURIComponent(server.owner.username) %>" alt="<%= server.owner.username %>'s avatar">
                    <span class="font-medium group-hover:underline truncate max-w-[120px]" style="color:var(--theme-text-strong);"><%= server.owner.username %></span>
                  </a>
                </td>
                <td class="al-table-td">
                  <a href="/admin/node/<%= server.node.id %>/stats" class="font-medium hover:underline truncate max-w-[120px]" style="color:var(--theme-text-strong);" onclick="event.stopPropagation()"><%= server.node.name %></a>
                </td>
                <td class="al-table-td">
                  <%= server.node.address %>:<%= JSON.parse(server.Ports).filter(p => p.primary).map(p => p.externalPort || String(p.Port || '').split(':')[0]).pop() %>
                </td>
                <td class="al-table-td">
                  <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset
                    <%= server.Suspended ? 'bg-amber-600/10 text-amber-700 ring-amber-600/20 dark:bg-amber-400/10 dark:text-yellow-400 dark:ring-amber-400/20' : 'bg-emerald-600/10 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-400/10 dark:text-emerald-400 dark:ring-emerald-400/20' %>">
                    <%= server.Suspended ? 'Suspended' : 'Enabled' %>
                  </span>
                </td>
                <td class="al-table-td">
                  <div class="flex items-center gap-1.5">
                    <a href="/server/<%= server.UUID %>" onclick="event.stopPropagation()" title="Open console" aria-label="Open console"
                      class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center">
                      <%- icon('external-link', { size: 16, class: 'shrink-0' }) %>
                    </a>
                    <a href="/admin/servers/edit/<%= server.id %>" onclick="event.stopPropagation()" title="Edit" aria-label="Edit server"
                      class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center">
                      <%- icon('pencil', { size: 16, class: 'shrink-0' }) %>
                    </a>
                    <button type="button" onclick="event.stopPropagation(); deleteServer('<%= server.id %>', '<%= server.name %>')" title="Delete" aria-label="Delete server"
                      class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center" style="color:var(--theme-danger);">
                      <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
                    </button>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../../components/loadingPopup') %>

<!-- Radar scan modal -->
<div id="radarScanModal" class="al-sheet-overlay fixed inset-0 z-50 hidden">
  <div class="flex items-end sm:items-center justify-center min-h-screen p-0 sm:p-4">
    <div class="fixed inset-0" id="radarScanModalBackdrop"></div>
    <div id="radarScanPanel" class="al-sheet-panel relative border rounded-2xl shadow-lg max-w-2xl w-full max-h-[85vh] flex flex-col overflow-hidden" style="background:var(--theme-bg-card); border-color:var(--theme-border);">

      <div class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
        <div>
          <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong);" id="radarScanModalTitle">Radar Scan</h3>
          <p class="text-xs mt-0.5" style="color:var(--theme-text-muted);" id="radarScanModalSubtitle">Pick a script and scan the server volume</p>
        </div>
        <button type="button" onclick="closeRadarScanModal()" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="Close">
          <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
        </button>
      </div>

      <!-- Picker phase -->
      <div id="radarPickerPhase" class="px-6 py-4 overflow-y-auto max-h-[70vh]">

        <!-- Scan mode toggle — only shown when VT key configured -->
        <div id="scanModeToggle" class="hidden mb-5">
          <p class="text-xs font-medium mb-2" style="color:var(--theme-text-muted);">Scan method</p>
          <div class="flex flex-col sm:flex-row gap-2">
            <button type="button" id="modeBuiltin" onclick="setScanMode('builtin')"
              class="flex-1 flex items-center gap-2 px-3 py-3 sm:py-2.5 rounded-lg border-2 text-xs font-medium transition-all min-h-[44px]" style="border-color:var(--theme-border-accent); background:var(--theme-text-strong); color:var(--theme-accent-text);">
              <%- icon('radar', { size: 14, class: 'shrink-0' }) %>
              Built-in patterns
            </button>
            <button type="button" id="modeVT" onclick="setScanMode('vt')"
              class="flex-1 flex items-center gap-2 px-3 py-3 sm:py-2.5 rounded-lg border-2 text-xs font-medium transition-all min-h-[44px]" style="border-color:var(--theme-border); background:var(--theme-bg-secondary); color:var(--theme-text-muted);">
              <%- icon('shield', { size: 14, class: 'shrink-0' }) %>
              VirusTotal file scan
            </button>
          </div>
        </div>

        <!-- Built-in script picker -->
        <div id="builtinPickerSection">
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 items-stretch sm:items-start">
            <div class="flex-1">
              <label class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted);" for="scriptSelect">Script</label>
              <select id="scriptSelect" class="cs-native">
                <option value="">Loading scripts...</option>
              </select>
              <div class="custom-select" data-for="scriptSelect"></div>
            </div>
            <div class="sm:pt-5">
              <button type="button" id="runScanButton" onclick="runRadarScan()"
                class="al-btn-primary w-full sm:w-auto min-h-[44px]">
                <%- icon('radar', { size: 16, class: 'shrink-0' }) %>
                Run Scan
              </button>
            </div>
          </div>
          <p id="scriptDescription" class="mt-2 text-xs italic min-h-4" style="color:var(--theme-text-muted);"></p>
        </div>

        <!-- VT file scan -->
        <div id="vtScanSection" class="hidden">
          <div class="rounded-lg p-3 sm:p-4 mb-4 text-xs space-y-1" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border); color:var(--theme-text-muted);">
            <p>Zips <span class="font-mono" style="color:var(--theme-text);">plugins/</span>, <span class="font-mono" style="color:var(--theme-text);">mods/</span>, <span class="font-mono" style="color:var(--theme-text);">config/</span>, <span class="font-mono" style="color:var(--theme-text);">addons/</span>, <span class="font-mono" style="color:var(--theme-text);">datapacks/</span> and uploads to VirusTotal.</p>
            <p>Excludes world folders, logs, cache. Max 32 MB zip. Takes 30–120 seconds.</p>
            <p style="color:var(--theme-warning);">Free tier: 4 requests/min · 500/day. Do not use for automated scanning.</p>
          </div>
          <button type="button" id="runVtScanButton" onclick="runVtFileScan()"
            class="al-btn-primary w-full sm:w-auto min-h-[44px]">
            <%- icon('shield', { size: 16, class: 'shrink-0' }) %>
            Upload to VirusTotal
          </button>
        </div>

      </div>

      <!-- Results phase -->
      <div id="radarResultsPhase" class="hidden">
        <div id="radarSummaryBar" class="px-6 py-3 border-t flex items-center gap-3 sm:gap-4 overflow-x-auto" style="border-color:var(--theme-border); background:var(--theme-bg-secondary);"></div>
        <div id="radarServerTabs" class="hidden border-b px-6 pt-3 flex gap-1 overflow-x-auto" style="border-color:var(--theme-border);"></div>
        <div id="radarResultsBody" class="px-6 py-4 max-h-60 sm:max-h-80 overflow-y-auto"></div>
      </div>

      <!-- Footer -->
      <div class="flex gap-2 px-6 py-4 border-t justify-end" style="border-color:var(--theme-border);">
        <button type="button" id="radarRescanBtn" class="hidden text-xs hover:underline min-h-[44px] flex items-center justify-center sm:justify-start" style="color:var(--theme-text-muted);" onclick="resetRadarToPickerPhase()">
          <%- icon('arrow-left', { class: 'size-3.5 inline mr-1' }) %> Run another scan
        </button>
        <div class="sm:ml-auto">
          <button type="button" onclick="closeRadarScanModal()"
            class="al-btn-secondary w-full sm:w-auto min-h-[44px]">
            <%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %>
            Close
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-servers.js?v=5"></script>

<%- include('../../components/footer') %>
