<%- include('../../components/header', { title: 'Create Server' }) %>

<% if (isMobileViewport) { %>
<main id="page-content" class="">
  <%- include('../../components/template') %>

  <div class="px-4 py-5">
<div class="flex items-start justify-between mb-5">
        <div class="sm:flex-auto">
            <h1 class="text-base font-medium leading-6 text-neutral-800 dark:text-white"><%= req.translations.adminCreateServerTitle %></h1>
            <p class="mt-1 tracking-tight text-sm text-neutral-500"><%= req.translations.adminCreateServerText || 'Spin up something new. Naming it is half the fun.' %></p>
        </div>
      </div>

      <div id="nodeForm" class="mt-4 w-full">
        <div data-animate-card class="rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-white/5 p-5">
          <form id="createServerForm" method="POST" action="/admin/servers/create">
            <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">General</h2>
            <div class="grid grid-cols-1 gap-4 mb-6">
              <div>
                <label for="serverName" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('file', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.name %>:</label>
                <div class="flex items-center space-x-2">
                    <input id="serverName" name="name" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-100 dark:bg-neutral-600 placeholder:text-neutral-950/50 dark:placeholder:text-white/20 border border-neutral-800/10 dark:border-white/5" placeholder="<%= user.username %>'s server">
                    <div class="flex-shrink-0 p-2 mb-1 -ml-5" onclick="generateRandomName()" role="button" tabindex="0" aria-label="Generate random name" title="Generate random name">
                        <%- icon('refresh-cw', { size: 24, class: 'text-neutral-300' }) %>
                    </div>
                </div>
            </div>

              <div>
                <label for="serverDescription" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('file', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.description %>:</label>
                <input id="serverDescription" name="description" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-100 dark:bg-neutral-600 placeholder:text-neutral-950/50 dark:placeholder:text-white/20 border border-neutral-800/10 dark:border-white/5" placeholder="<%= user.username %>'s server description">
              </div>

              <div>
                <label for="serverUser" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('user', { size: 16, class: 'shrink-0' }) %>
                  <%= req.translations.user %>:</label>
                <select id="serverUser" name="ownerId" class="cs-select">
                  <% users.forEach(user => { %>
                    <option value="<%= user.id %>"><%= user.username %></option>
                  <% }); %>
                </select>
              </div>

              <div>
                <label for="serverNode" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('server', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.Node %>:
                </label>
                <div class="relative mt-2 mb-4">
                  <select id="serverNode" name="nodeId"
                          class="cs-select">
                    <% if (nodes.length > 0) { %>
                      <% nodes.forEach(node => { %>
                        <option value="<%= node.id %>"><%= node.name %></option>
                      <% }); %>
                    <% } else { %>
                      <option value="" disabled selected>No nodes available</option>
                    <% } %>
                  </select>
                </div>
              </div>
            </div>

            <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">Resources</h2>
            <div class="grid grid-cols-1 gap-4 mb-6">
              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('settings', { size: 14, class: 'shrink-0' }) %>
                  CPU:
                </label>
                <input type="hidden" id="serverCPU" name="Cpu" value="100">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverCPUDisplay" type="number" min="0.5" step="0.5" value="1" class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-100 dark:bg-neutral-600 border border-r-0 border-neutral-800/10 dark:border-white/5">
                  <select id="serverCPUUnit" class="cs-select cs-sm">
                    <option value="cores" selected>Cores</option>
                    <option value="percent">%</option>
                  </select>
                </div>
                <p class="text-xs text-neutral-400 mb-3">1 core = 100%</p>
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('server', { size: 14, class: 'shrink-0' }) %>
                  Memory:
                </label>
                <input type="hidden" id="serverMemory" name="Memory" value="1024">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverMemoryDisplay" type="number" min="1" value="1"
                    class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-100 dark:bg-neutral-600 border border-r-0 border-neutral-800/10 dark:border-white/5">
                  <select id="serverMemoryUnit" class="cs-select cs-sm">
                    <option value="1">MB</option>
                    <option value="1024" selected>GB</option>
                  </select>
                </div>
                <p class="text-xs text-neutral-400 mb-3">Min 128 MB</p>
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('database', { size: 14, class: 'shrink-0' }) %>
                  Storage:
                </label>
                <input type="hidden" id="serverStorage" name="Storage" value="20480">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverStorageDisplay" type="number" min="1" value="20"
                    class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-100 dark:bg-neutral-600 border border-r-0 border-neutral-800/10 dark:border-white/5">
                  <select id="serverStorageUnit" class="cs-select cs-sm">
                    <option value="1">MB</option>
                    <option value="1024" selected>GB</option>
                  </select>
                </div>
                <p class="text-xs text-neutral-400 mb-3">Min 128 MB</p>
              </div>
            </div>

            <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">Startup</h2>
            <div class="grid grid-cols-1 gap-4 mb-6">
              <div>
                <label for="serverImage" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('database', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.Image %>:</label>
                <select id="serverImage" name="imageId"
                        class="cs-select">
                  <% images.forEach(image => { %>
                    <option value="<%= image.id %>" data-docker-images='<%= image.dockerImages %>' data-variables='<%= image.variables %>' data-port-requirements='<%= image.portRequirements || "[]" %>'>
                      <%= image.name %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div>
                <label for="dockerImage" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('box', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.DockerImage %>:</label>
                <select id="dockerImage" name="dockerImage"
                        class="cs-select">
                  <option value="" disabled selected>Select a Docker image</option>
                </select>
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('cloud-download', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.Ports %>:</label>
                <input type="hidden" id="serverPorts" name="Ports">
          <button type="button" id="assignPortsBtn" class="mt-2 mb-4 w-full inline-flex items-center gap-2 rounded-xl bg-neutral-100 dark:bg-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-800 dark:text-white px-4 py-2.5 text-sm font-medium border border-neutral-200 dark:border-white/5 transition">
            <%- icon('cloud-download', { size: 14, class: 'shrink-0' }) %>
            Assign ports
          </button>
              </div>

              <div class="flex flex-col md:flex-row md:items-center justify-between rounded-xl p-4 mt-4">
                <div class="flex items-center mb-2 md:mb-0">
                  <div class="flex-shrink-0 mr-3">
                    <%- icon('pencil', { size: 24, class: 'text-blue-500' }) %>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-neutral-800 dark:text-white">Startup Command Permissions</h3>
                    <p class="text-xs text-neutral-600 dark:text-neutral-400">When enabled, users can modify the startup command for this server.</p>
                  </div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="allowStartupEdit" id="allowStartupEdit" class="sr-only peer" value="true">
                  <div class="w-11 h-6 bg-neutral-300 dark:bg-neutral-700 peer-focus:ring-2 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                  <span class="ms-3 text-sm font-medium text-neutral-600 dark:text-neutral-300" id="allowStartupEditLabel">Disabled</span>
                </label>
              </div>
            </div>

            <div class="collapsible-row no-anim" id="variablesSectionRow"><div><div id="variablesSection">
              <h2 class="text-neutral-700 dark:text-neutral-300 text-md font-semibold mb-4">Variables</h2>

              <div class="grid grid-cols-1 gap-4 mb-6" id="variablesContainer">
              </div>
            </div>
            </div></div>

            <div class="col-span-2">
                <button type="submit" class="w-full md:w-auto rounded-xl bg-neutral-950 dark:bg-white hover:bg-neutral-300 text-neutral-200 dark:text-neutral-800 px-3 py-2 text-sm font-medium shadow-md transition focus:outline focus:outline-2 focus:outline-offset-2">
                    <%= req.translations.create || 'Create server' %>
                  </button>
              </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<div id="portsModal" class="fixed inset-0 z-modal-backdrop hidden items-end sm:items-center justify-center bg-black/60 backdrop-blur-sm px-3 pb-3 pt-16 sm:p-4">
  <div id="portsModalPanel" class="w-full max-h-[88vh] overflow-clip rounded-2xl border border-neutral-200 dark:border-neutral-700/60 bg-white dark:bg-neutral-900 shadow-xl translate-y-full sm:translate-y-0 sm:scale-95 opacity-0 transition-all duration-300">
    <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-700/60 px-4 py-3">
      <h2 class="text-sm font-semibold text-neutral-800 dark:text-white">Assign ports</h2>
      <button type="button" id="closePortsModal" class="p-1 rounded-xl text-neutral-400 hover:text-neutral-800 dark:hover:text-white transition">
        <%- icon('x', { size: 16, class: 'shrink-0' }) %>
      </button>
    </div>
    <div class="max-h-[64vh] overflow-y-auto p-4">
      <div id="portsRows" class="space-y-3"></div>
      <button type="button" id="addPortRow" class="mt-4 w-full rounded-xl border border-neutral-200 dark:border-white/10 px-3 py-2.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/5 transition">Add port</button>
    </div>
    <div class="border-t border-neutral-200 dark:border-neutral-700/60 px-4 py-3">
      <button type="button" id="savePortsModal" class="w-full rounded-xl bg-neutral-950 dark:bg-white px-4 py-3 text-sm font-medium text-white dark:text-neutral-900 transition hover:bg-neutral-800 dark:hover:bg-neutral-100">Save ports</button>
    </div>
  </div>
</div>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>

<script nonce="<%- nonce %>" src="/js/admin/server-create.js"></script>

