<%- include('../../layouts/admin', { title: 'Admin Nodes' }) %>

<%- include('../../partials/flash-messages') %>

<nav aria-label="Breadcrumb" class="al-breadcrumb mb-6">
  <ol class="flex items-center text-sm gap-1">
    <li class="flex items-center">
      <span style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <a href="/admin/nodes" class="transition-colors hover:underline" style="color:var(--theme-text-muted);">Admin</a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <span style="color:var(--theme-text);">Nodes</span>
    </li>
  </ol>
</nav>

<div class="al-page-header flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="al-page-title">Nodes</h1>
    <p class="al-page-desc">Manage your infrastructure nodes and locations.</p>
  </div>
  <div class="flex gap-2 shrink-0 items-center">
    <a href="/admin/nodes#create" class="al-btn-secondary text-sm">
      <%- icon('map-pin', { class: 'size-4', strokeWidth: 1.5 }) %> Locations
    </a>
    <a href="/admin/nodes/create" class="al-btn-primary">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> Create Node
    </a>
  </div>
</div>

<div class="al-page-body" data-al-tabs data-tabs-default="nodes" data-tabs-hash>
  <div role="tablist" class="flex gap-1 mb-6">
    <button id="tab-btn-nodes" type="button" data-tab="nodes" role="tab" aria-selected="true" tabindex="0" aria-controls="tab-panel-nodes" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2">
      <%- icon('network', { class: 'size-4', strokeWidth: 1.5 }) %> Nodes
    </button>
    <button id="tab-btn-locations" type="button" data-tab="locations" role="tab" aria-selected="false" tabindex="-1" aria-controls="tab-panel-locations" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2">
      <%- icon('map-pin', { class: 'size-4', strokeWidth: 1.5 }) %> Locations
    </button>
  </div>

  <!-- Nodes Tab -->
  <div id="tab-panel-nodes" role="tabpanel" aria-labelledby="tab-btn-nodes" data-tab-panel="nodes">
    <div id="stats" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 mt-6">
      <div class="al-card">
        <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);">Total Nodes</h2>
        <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);" id="totalNodesTotal"><%= nodes.length %></p>
        <% if (nodes.length > 0) { %>
        <p class="text-xs mt-2" style="color:var(--theme-text-muted);">Online: <span id="onlineNodesTotal"><%= nodes.filter(n => n.status === 'Online').length %></span></p>
        <% } else { %>
        <p class="text-xs mt-2" style="color:var(--theme-text-muted);">No nodes available</p>
        <% } %>
      </div>
      <div class="al-card">
        <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);">Servers</h2>
        <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);" id="totalNodeInstancesTotal">
          <%= nodes.reduce((total, node) => total + (node._count ? node._count.servers : 0), 0) %>
        </p>
        <% const totalInstances = nodes.reduce((total, node) => total + (node._count ? node._count.servers : 0), 0); %>
        <% if (totalInstances > 0 && nodes.length > 0) { %>
        <p class="text-xs mt-2" style="color:var(--theme-text-muted);">
          Average density:
          <span id="avgNodeInstancesTotal"><%= (totalInstances / nodes.length).toFixed(2) %></span>
        </p>
        <% } else { %>
        <p class="text-xs mt-2" style="color:var(--theme-text-muted);">No servers available</p>
        <% } %>
      </div>
    </div>

    <!-- Daemon offline warning -->
    <% if (nodes.some(node => node.status === 'Offline')) { %>
    <div class="al-alert-danger mb-5">
      <%- icon('triangle-alert', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
      <div class="flex-1">
        <p class="font-medium">Connection Error</p>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)">One or more nodes are offline.</p>
      </div>
      <button type="button" id="retryConnectionBtn" class="shrink-0 px-3 py-1 text-xs rounded-lg transition-colors inline-flex items-center gap-1.5" style="background:var(--theme-danger-bg); color:var(--theme-danger);">
        <%- icon('refresh-cw', { class: 'size-3', strokeWidth: 1.5 }) %> Retry
      </button>
    </div>
    <% } %>

    <!-- Node table -->
    <div id="admin-nodes-table" class="overflow-x-auto shadow-sm rounded-xl border" style="border-color:var(--theme-border);">
      <% if (nodes.length === 0) { %>
        <%- include('../../partials/empty-state', {
          iconName: 'network',
          title: 'No nodes yet',
          description: 'Add a node to start hosting servers.',
          action: '<a href="/admin/nodes/create" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + ' Create Node</a>'
        }) %>
      <% } else { %>
      <table class="al-table w-full" style="table-layout:auto">
        <colgroup>
          <col style="min-width:170px">
          <col style="min-width:180px">
          <col style="min-width:80px">
          <col style="min-width:220px">
        </colgroup>
        <thead class="al-table-thead">
          <tr>
            <th scope="col" class="al-table-th sm:pl-6">Name</th>
            <th scope="col" class="al-table-th sm:pl-6">Connection</th>
            <th scope="col" class="al-table-th sm:pl-6">Instances</th>
            <th scope="col" class="al-table-th sm:pl-6">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% let nodeIdx = 0; nodes.forEach(function(node) { %>
          <tr data-node-id="<%= node.id %>" data-instances="<%= node._count ? node._count.servers : 0 %>" data-online="<%= node.status === 'Online' ? 'true' : '' %>" data-location="<%= node.locationId ? 'true' : '' %>" style="--i:<%= nodeIdx++ %>" class="al-table-row cursor-pointer" onclick="window.location='/admin/node/<%= node.id %>/stats'">
            <td class="al-table-td sm:pl-6">
              <div class="flex items-center">
                <div class="mr-5">
                  <% if (node.status === "Online") { %>
                    <span class="al-dot-online"></span>
                  <% } else if (node.status === "Offline") { %>
                    <span class="al-dot-offline group relative">
                      <% if (node.error) { %>
                      <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 -translate-y-1 w-48 text-xs rounded py-1 px-2 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 pointer-events-none z-10" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); color:var(--theme-text);">
                        <%= node.error %>
                      </div>
                      <% } %>
                    </span>
                  <% } else { %>
                    <span class="al-dot-warning"></span>
                  <% } %>
                </div>
                <div class="font-medium" style="color:var(--theme-text-strong);"><%= node.name %></div>
              </div>
            </td>
            <td class="al-table-td"><%= node.address %>:<%= node.port %>
              <div class="mt-1 ml-2 inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset"
                style="<%= node.versionRelease ? 'background:var(--theme-success-bg);color:var(--theme-success);box-shadow:inset 0 0 0 1px var(--theme-success)' : 'background:var(--theme-badge-neutral-bg);color:var(--theme-badge-neutral-text);box-shadow:inset 0 0 0 1px var(--theme-border)' %>">
                <%= node.versionRelease || 'Unknown' %>
              </div>
            </td>
            <td class="al-table-td"><%= node._count ? node._count.servers : 0 %></td>
            <td class="al-table-td">
              <div class="flex items-center gap-1.5">
                <a href="/admin/node/<%= node.id %>/configure"
                   title="Configure node" aria-label="Configure node"
                   class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center"
                   onclick="event.stopPropagation()">
                  <%- icon('settings', { size: 16, class: 'shrink-0' }) %>
                </a>
                <a href="/admin/node/<%= node.id %>" onclick="event.stopPropagation()" title="Edit node" aria-label="Edit node"
                   class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center">
                  <%- icon('pencil', { size: 16, class: 'shrink-0' }) %>
                </a>
                <button type="button"
                   title="Delete node" aria-label="Delete node"
                   class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center"
                   style="color:var(--theme-danger);"
                   data-node-id="<%= node.id %>"
                   onclick="deleteNode(this)">
                  <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
                </button>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <!-- Locations Tab -->
  <div id="tab-panel-locations" role="tabpanel" aria-labelledby="tab-btn-locations" data-tab-panel="locations" hidden>
    <div id="locations" class="mt-6 space-y-5">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold tracking-tight" style="color:var(--theme-text-strong);">Locations</h2>
          <p class="text-sm mt-0.5" style="color:var(--theme-text-muted);">Group nodes by region.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="al-card p-5 flex items-center gap-4">
          <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-accent) 12%, transparent); color:var(--theme-accent);">
            <%- icon('map-pin', { class: 'size-5' }) %>
          </div>
          <div>
            <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="totalLocationsCount"><%= locations.length %></p>
            <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Locations</p>
          </div>
        </div>
        <div class="al-card p-5 flex items-center gap-4">
          <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-info) 12%, transparent); color:var(--theme-info);">
            <%- icon('server', { class: 'size-5' }) %>
          </div>
          <div>
            <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="nodesAssignedTotal"><%= nodes.filter(n => n.locationId).length %></p>
            <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Nodes assigned</p>
          </div>
        </div>
        <div class="al-card p-5 flex items-center gap-4">
          <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-warning) 12%, transparent); color:var(--theme-warning);">
            <%- icon('network', { class: 'size-5' }) %>
          </div>
          <div>
            <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="nodesUnassignedTotal"><%= nodes.filter(n => !n.locationId).length %></p>
            <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Nodes without location</p>
          </div>
        </div>
      </div>

      <!-- Create location form -->
      <div class="al-card">
        <h3 class="al-card-header flex items-center gap-2"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> Create Location</h3>
        <div class="p-5">
          <div id="admin-locations-status"></div>
          <form id="createLocationForm" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div>
              <label class="al-label" for="locName">Name</label>
              <input id="locName" name="name" type="text" placeholder="US East" class="al-input" required>
            </div>
            <div>
              <label class="al-label" for="locCode">Short code</label>
              <input id="locCode" name="shortCode" type="text" placeholder="us-east" class="al-input" autocapitalize="off" spellcheck="false" required>
            </div>
            <div class="lg:col-span-2 flex items-end">
              <button type="button" id="submitLocationBtn" class="al-btn-primary w-full sm:w-auto">
                <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                <span id="locationBtnLabel">Create Location</span>
                <span id="locationBtnSaving" class="hidden">Creating...</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Locations list -->
      <div class="al-card">
        <h3 class="al-card-header flex items-center gap-2"><%- icon('map', { class: 'size-4', strokeWidth: 1.5 }) %> All Locations</h3>
        <div class="p-5">
          <div id="admin-locations-list">
            <% if (locations.length === 0) { %>
            <div class="text-center py-10">
              <div class="mx-auto mb-3 w-12 h-12 rounded-2xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-border) 35%, transparent); color:var(--theme-text-muted);">
                <%- icon('map-pin', { class: 'size-6', strokeWidth: 1.5 }) %>
              </div>
              <p class="text-sm font-medium" style="color:var(--theme-text-strong);">No locations yet</p>
              <p class="text-xs mt-1" style="color:var(--theme-text-muted);">Create a location to organize your nodes.</p>
            </div>
            <% } else { %>
              <% const byRegion = new Map(); locations.forEach(loc => {
                const region = loc.shortCode.split('-')[0] || 'Other';
                if (!byRegion.has(region)) byRegion.set(region, []);
                byRegion.get(region).push(loc);
              }); %>
              <% for (const [region, regionLocs] of byRegion) { %>
              <div class="mb-6 last:mb-0" data-region="<%= region %>">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-[11px] font-semibold uppercase tracking-widest" style="color:var(--theme-text-muted);"><%= region %></span>
                  <span class="h-px flex-1" style="background:var(--theme-border);"></span>
                  <span class="text-xs" style="color:var(--theme-text-muted);"><%= regionLocs.length %></span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                  <% regionLocs.forEach(loc => { %>
                  <div class="rounded-xl border p-4 flex items-center justify-between gap-3 transition-shadow hover:shadow-sm cursor-pointer" style="border-color:var(--theme-border); background:var(--theme-bg-card);" data-location-id="<%= loc.id %>" onclick="showLocationNodes('<%= loc.id %>')">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="shrink-0 w-2 h-2 rounded-full" style="background:<%= (loc._count && loc._count.nodes > 0) ? 'var(--theme-success)' : 'var(--theme-border)' %>;"></span>
                        <p class="font-medium text-sm truncate" style="color:var(--theme-text-strong);"><%= loc.name %></p>
                      </div>
                      <p class="text-xs mt-1.5 font-mono" style="color:var(--theme-text-muted);"><%= loc.shortCode %></p>
                      <p class="text-xs mt-1" style="color:var(--theme-text-muted);"><%= (loc._count && loc._count.nodes) || 0 %> <%= (loc._count && loc._count.nodes) === 1 ? 'node' : 'nodes' %></p>
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                      <button type="button"
                         class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors hover:opacity-75"
                         style="color:var(--theme-text-muted);"
                         aria-label="Edit location"
                         onclick="event.stopPropagation(); openLocationEdit(<%= loc.id %>, '<%= loc.name.replace(/'/g, "\\'") %>', '<%= loc.shortCode %>')">
                        <%- icon('pencil', { class: 'size-4', strokeWidth: 1.5 }) %>
                      </button>
                      <button type="button"
                         class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors hover:opacity-75"
                         style="color:var(--theme-danger);"
                         aria-label="Delete location"
                         data-location-id="<%= loc.id %>"
                         data-location-name="<%= loc.name.replace(/'/g, "\\'") %>"
                         onclick="event.stopPropagation(); deleteLocation(this)">
                        <%- icon('trash', { class: 'size-4', strokeWidth: 1.5 }) %>
                      </button>
                    </div>
                  </div>
                  <% }) %>
                </div>
              </div>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Location nodes drill-down panel -->
      <div id="location-nodes-panel" class="hidden">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <button type="button" id="back-to-locations" aria-label="Back to locations" class="w-8 h-8 rounded-lg flex items-center justify-center hover:opacity-75 transition" style="color:var(--theme-text-muted);">
              <%- icon('arrow-left', { class: 'size-4', strokeWidth: 2 }) %>
            </button>
            <div>
              <p class="text-sm font-semibold" style="color:var(--theme-text-strong);" id="loc-nodes-name"></p>
              <p class="text-xs" style="color:var(--theme-text-muted);" id="loc-nodes-info"></p>
            </div>
          </div>
        </div>
        <div id="loc-nodes-list" class="space-y-2"></div>
      </div>

    </div>
  </div>
</div>

<div id="page-data" style="display:none"></div>
<script nonce="<%- nonce %>">
  document.getElementById('page-data').dataset.nodes = '<%- JSON.stringify(nodes.map(n => ({ id: n.id, status: n.status || "Unknown" }))).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/</g, '\\x3c').replace(/>/g, '\\x3e') %>';
</script>
<script nonce="<%- nonce %>">
  window.__locationNodes = {
    <% locations.forEach(function(loc) { %>
      '<%= loc.id %>': [
        <% nodes.filter(function(n) { return n.locationId === loc.id; }).forEach(function(n) { %>
          { id: '<%= n.id %>', name: '<%= n.name.replace(/'/g, "\\'") %>', address: '<%= n.address %>', port: <%= n.port %>, status: '<%= n.status || "Unknown" %>', servers: <%= n._count ? n._count.servers : 0 %> },
        <% }); %>
      ],
    <% }); %>
  };
</script>
<script nonce="<%- nonce %>">
function handleRowClick(event, url) {
  if (!event.target.closest('button, a')) {
    window.location.href = url;
  }
}

function configure(nodeId) {
  fetch('/admin/node/' + nodeId + '/configure')
    .then(function(response) {
      if (!response.ok) throw new Error('Failed to fetch configure command');
      return response.json();
    })
    .then(function(data) {
      var popup = document.createElement('div');
      popup.style.display = 'none';
      popup.innerHTML =
        '<div class="flex justify-center items-center mb-6">' +
          '<%- icon("badge-check", { class: "text-emerald-500", width: 64, height: 64 }) %>' +
        '</div>' +
        '<p class="mb-4 text-neutral-600 dark:text-neutral-300 text-center">Run this command on the daemon machine to connect it to this panel:</p>' +
        '<pre class="bg-neutral-100 dark:bg-neutral-900 p-3 rounded-xl mb-4 overflow-x-auto"><code id="commandCode" class="text-emerald-500">' + data + '</code></pre>' +
        '<div class="flex justify-end">' +
          '<button id="copyBtn" class="bg-emerald-600 text-white px-4 py-2 rounded-xl mr-2 hover:bg-emerald-700 transition-colors">Copy</button>' +
          '<button id="doneBtn" class="bg-neutral-800 dark:bg-neutral-700 text-white px-4 py-2 rounded-xl hover:bg-neutral-700 dark:hover:bg-neutral-600 transition-colors">Close</button>' +
        '</div>';

      window.modal.show({
        title: 'Node Configured',
        bodyNode: popup,
        panelClass: 'max-w-xl',
      });

      var command = data;
      document.getElementById('copyBtn').addEventListener('click', function() {
        var copyBtn = this;
        navigator.clipboard.writeText(command)
          .then(function() {
            copyBtn.textContent = 'Copied!';
            setTimeout(function() { copyBtn.textContent = 'Copy'; }, 2000);
          });
      });
      document.getElementById('doneBtn').addEventListener('click', function() { window.modal.close(); });
    })
    .catch(function(error) {
      console.error(error);
      showToast('Failed to fetch configure command.', 'error');
    });
}

var csrfToken = '<%= csrfToken %>';

function deleteNode(btn) {
  var id = btn.dataset.nodeId;
  modal.confirm({
    title: 'Delete Node',
    body: 'Are you sure you want to delete this node?',
    danger: true,
    confirmLabel: 'Delete',
    onConfirm: async function() {
      var loader = showProgressToast('Deleting node...');
      try {
        var res = await fetch('/admin/node/' + id, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        var data = await res.json();
        if (data.success !== false) {
          loader.complete(true, 'Node deleted.');
          window.location.reload();
        } else {
          loader.close();
          showToast(data.error || 'Failed to delete node.', 'error');
        }
      } catch(e) {
        loader.close();
        showToast('Failed to delete node.', 'error');
      }
    }
  });
}

document.getElementById('submitLocationBtn').addEventListener('click', async function() {
  var name = document.getElementById('locName').value.trim();
  var shortCode = document.getElementById('locCode').value.trim();
  if (!name || !shortCode) return;
  var btn = this;
  var label = document.getElementById('locationBtnLabel');
  var saving = document.getElementById('locationBtnSaving');
  btn.disabled = true;
  label.classList.add('hidden');
  saving.classList.remove('hidden');
  try {
    var res = await fetch('/api/v2/admin/locations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      body: JSON.stringify({ name: name, shortCode: shortCode }),
    });
    var data = await res.json();
    if (res.ok) {
      showToast('Location created.', 'success');
      window.location.reload();
    } else {
      showToast((data.error && data.error.message) || 'Failed to create location.', 'error');
    }
  } catch (e) { showToast('Failed to create location.', 'error'); }
  btn.disabled = false;
  label.classList.remove('hidden');
  saving.classList.add('hidden');
});

function openLocationEdit(id, name, shortCode) {
  var body = document.createElement('div');
  body.innerHTML =
    '<form id="editLocationForm" class="flex flex-col gap-4">' +
      '<div>' +
        '<label class="al-label" for="editLocName">Name</label>' +
        '<input id="editLocName" name="name" type="text" value="' + name.replace(/"/g, '&quot;') + '" class="al-input" required>' +
      '</div>' +
      '<div>' +
        '<label class="al-label" for="editLocCode">Short code</label>' +
        '<input id="editLocCode" name="shortCode" type="text" value="' + shortCode.replace(/"/g, '&quot;') + '" class="al-input" autocapitalize="off" spellcheck="false" required>' +
      '</div>' +
      '<div class="flex justify-end gap-2 pt-1">' +
        '<button type="button" onclick="window.modal.close()" class="al-btn-secondary px-4 py-2 text-sm font-medium">Cancel</button>' +
        '<button type="submit" class="al-btn-primary px-4 py-2 text-sm font-medium">Save</button>' +
      '</div>' +
    '</form>';

  window.modal.show({
    title: 'Edit Location',
    bodyNode: body,
    panelClass: 'max-w-md',
  });

  body.querySelector('form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var nameVal = body.querySelector('#editLocName').value.trim();
    var codeVal = body.querySelector('#editLocCode').value.trim().toLowerCase();
    try {
      var res = await fetch('/api/v2/admin/locations/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({ name: nameVal, shortCode: codeVal }),
      });
      var data = await res.json();
      if (res.ok) {
        showToast('Location updated.', 'success');
        window.modal.close();
        window.location.reload();
      } else {
        showToast(data.message || 'Update failed.', 'error');
      }
    } catch(err) {
      showToast('Update failed.', 'error');
    }
  });
}

function deleteLocation(btn) {
  var id = btn.dataset.locationId;
  var name = btn.dataset.locationName;
  modal.confirm({
    title: 'Delete Location',
    body: 'Are you sure you want to delete "' + name + '"?',
    danger: true,
    confirmLabel: 'Delete',
    onConfirm: async function() {
      var loader = showProgressToast('Deleting location...');
      try {
        var res = await fetch('/api/v2/admin/locations/' + id, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        var data = await res.json();
        if (data.success !== false) {
          loader.complete(true, 'Location deleted.');
          var card = btn.closest('[data-location-id]');
          if (card) card.remove();
        } else {
          loader.close();
          showToast(data.error || 'Failed to delete location.', 'error');
        }
      } catch(e) {
        loader.close();
        showToast('Failed to delete location.', 'error');
      }
    }
  });
}
</script>
<script nonce="<%- nonce %>">
(function () {
  document.addEventListener('al:tabs-change', function (e) {
    if (e.detail && e.detail.name === 'locations') {
      var locEl = document.getElementById('locations');
      if (locEl) locEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
})();
</script>
<script nonce="<%- nonce %>">
(function () {
  var panel = document.getElementById('location-nodes-panel');
  var locList = document.getElementById('admin-locations-list');
  var locStats = document.querySelector('#locations .grid');
  var locHeader = document.querySelector('#locations .flex.items-center.justify-between');
  var createForm = document.querySelector('#locations .al-card:nth-child(3)');
  var backBtn = document.getElementById('back-to-locations');
  var locNodesName = document.getElementById('loc-nodes-name');
  var locNodesInfo = document.getElementById('loc-nodes-info');
  var locNodesList = document.getElementById('loc-nodes-list');

  function findLocationById(id) {
    var cards = locList.querySelectorAll('[data-location-id]');
    for (var i = 0; i < cards.length; i++) {
      if (cards[i].dataset.locationId === id) return cards[i];
    }
    return null;
  }

  window.showLocationNodes = function (locId) {
    var card = findLocationById(locId);
    if (!card) return;

    var nameEl = card.querySelector('.font-medium');
    var codeEl = card.querySelector('.font-mono');
    var locName = nameEl ? nameEl.textContent.trim() : '';
    var locCode = codeEl ? codeEl.textContent.trim() : '';
    var nodes = window.__locationNodes[locId] || [];

    locNodesName.textContent = locName + ' (' + locCode + ')';
    locNodesInfo.textContent = nodes.length + ' ' + (nodes.length === 1 ? 'node' : 'nodes');

    if (nodes.length === 0) {
      locNodesList.innerHTML =
        '<div class="text-center py-10">' +
          '<div class="mx-auto mb-3 w-12 h-12 rounded-2xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-border) 35%, transparent); color:var(--theme-text-muted);">' +
            '<%- icon("network", { class: "size-6", strokeWidth: 1.5 }) %>' +
          '</div>' +
          '<p class="text-sm font-medium" style="color:var(--theme-text-strong);">No nodes in this location</p>' +
          '<p class="text-xs mt-1" style="color:var(--theme-text-muted);">Assign a node to this location to see it here.</p>' +
        '</div>';
    } else {
      var html = '';
      nodes.forEach(function (n) {
        var dotClass = n.status === 'Online' ? 'al-dot-online' : (n.status === 'Offline' ? 'al-dot-offline' : 'al-dot-warning');
        var badgeBg = n.status === 'Online' ? 'var(--theme-success-bg)' : (n.status === 'Offline' ? 'var(--theme-danger-bg)' : 'var(--theme-warning-bg)');
        var badgeColor = n.status === 'Online' ? 'var(--theme-success)' : (n.status === 'Offline' ? 'var(--theme-danger)' : 'var(--theme-warning)');
        html +=
          '<a href="/admin/nodes/edit/' + n.id + '" class="block rounded-xl border p-4 flex items-center justify-between gap-3 transition-shadow hover:shadow-sm" style="border-color:var(--theme-border); background:var(--theme-bg-card); text-decoration:none;">' +
            '<div class="flex items-center gap-3 min-w-0">' +
              '<span class="' + dotClass + '"></span>' +
              '<div class="min-w-0">' +
                '<p class="font-medium text-sm truncate" style="color:var(--theme-text-strong);">' + n.name + '</p>' +
                '<p class="text-xs mt-0.5 font-mono" style="color:var(--theme-text-muted);">' + n.address + ':' + n.port + '</p>' +
              '</div>' +
            '</div>' +
            '<div class="flex items-center gap-2 shrink-0">' +
              '<span class="text-xs font-medium px-2 py-0.5 rounded-full" style="background:' + badgeBg + '; color:' + badgeColor + ';">' + n.status + '</span>' +
              '<span class="text-xs" style="color:var(--theme-text-muted);">' + n.servers + ' ' + (n.servers === 1 ? 'server' : 'servers') + '</span>' +
            '</div>' +
          '</a>';
      });
      locNodesList.innerHTML = html;
    }

    if (locStats) locStats.classList.add('hidden');
    if (locHeader) locHeader.classList.add('hidden');
    if (createForm) createForm.classList.add('hidden');
    locList.classList.add('hidden');
    panel.classList.remove('hidden');
  };

  backBtn.addEventListener('click', function () {
    panel.classList.add('hidden');
    locList.classList.remove('hidden');
    if (locStats) locStats.classList.remove('hidden');
    if (locHeader) locHeader.classList.remove('hidden');
    if (createForm) createForm.classList.remove('hidden');
  });
})();
</script>

