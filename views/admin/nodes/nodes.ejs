<script nonce="<%- nonce %>" src="/js/core/filter-sort.js"></script>
<script nonce="<%- nonce %>">
(function () {
  var table = document.getElementById('nodeTable');
  if (!table) return;
  var tbody = table.querySelector('tbody');
  var rows = Array.from(tbody.querySelectorAll('tr.node-row'));

  AlFilter.enableTableSort(table);

  AlFilter.buildFilterBar({
    container: document.getElementById('nodeFilterBar'),
    searchPlaceholder: 'Search nodes\u2026',
    filters: [
      { key: 'status', label: 'Status', defaultValue: 'all', currentValue: 'all', options: [
        { value: 'all', label: 'All statuses' },
        { value: 'online', label: 'Online' },
        { value: 'offline', label: 'Offline' }
      ]}
    ],
    onFilter: function (state) {
      var visible = 0;
      rows.forEach(function (row) {
        var show = AlFilter.matchesRow(row, state, ['name', 'connection', 'status']);
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      });
    }
  });

  // Lazy loading - progressive reveal for large lists
  if (rows.length > 25) {
    AlFilter.enableProgressiveReveal(tbody, { batchSize: 25, itemSelector: 'tr.node-row' });
  }
})();
</script>

<%- include('../../components/footer') %>
<% } %>
