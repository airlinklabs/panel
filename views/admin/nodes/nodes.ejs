<%- include('../../components/header', { title: 'Dashboard' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <!-- Content -->
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Nodes' }
      ] }) %>
      <%- include('../../components/ui/page-header', {
        title: req.translations.adminNodesTitle,
        description: req.translations.adminNodesText,
        actions: '<a href="#locations" class="al-btn-secondary text-sm">' + icon('map-pin', { class: 'size-4', strokeWidth: 1.5 }) + 'Locations</a>' +
                 '<button id="createButton" type="button" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + req.translations.createNewNode + '</button>'
      }) %>

      <div class="al-page-body" data-al-tabs data-tabs-default="nodes" data-tabs-hash>

        <div role="tablist" class="flex gap-1 mb-6">
          <button id="tab-btn-nodes" type="button" data-tab="nodes" role="tab" aria-selected="true" tabindex="0" aria-controls="tab-panel-nodes" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('network', { class: 'size-4', strokeWidth: 1.5 }) %>Nodes</button>
          <button id="tab-btn-locations" type="button" data-tab="locations" role="tab" aria-selected="false" tabindex="-1" aria-controls="tab-panel-locations" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('map-pin', { class: 'size-4', strokeWidth: 1.5 }) %>Locations</button>
        </div>

        <div id="tab-panel-nodes" role="tabpanel" aria-labelledby="tab-btn-nodes" data-tab-panel="nodes">

        <div id="stats" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 mt-6">
          <div class="al-card">
            <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);"><%= req.translations.totalNodes %></h2>
            <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);" id="totalNodesTotal"><%= nodes.length %></p>
            <% if (nodes.length > 0) { %>
            <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.onlineNodes %>: <span id="onlineNodesTotal"><%= nodes.filter(node => node.status === 'Online').length %></span></p>
            <% } else { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.noNodesAvailable || 'No nodes available' %></p>
            <% } %>
          </div>
          <div class="al-card">
            <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);">Servers</h2>
            <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);" id="totalNodeInstancesTotal">
              <%= nodes.reduce((total, node) => total + (node.instances ? node.instances.length : 0), 0) %>
            </p>
            <% const totalInstances = nodes.reduce((total, node) => total + (node.instances ? node.instances.length : 0), 0); %>
            <% if (totalInstances > 0 && nodes.length > 0) { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);">
                <%= req.translations.averageInstanceDensity %>:
                <span id="avgNodeInstancesTotal"><%= (totalInstances / nodes.length).toFixed(2) %></span>
              </p>
            <% } else { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.noInstancesAvailable %></p>
            <% } %>
          </div>
        </div>

        <!-- notifications -->
        <% if (req.query.err == "none") { %>
          <%- include('../../components/ui/alert', { type: 'success', message: req.translations.success + '!', detail: req.translations.actionCompleted }) %>
        <% } %>

        <!-- Daemon offline warning -->
        <% if (nodes.some(node => node.status === 'Offline')) { %>
          <div class="al-alert-danger mb-5">
            <%- icon('triangle-alert', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
            <div class="flex-1">
              <p class="font-medium">Connection Error</p>
              <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)">One or more nodes are offline. Some information may be unavailable.</p>
            </div>
            <button type="button" @click="refreshNodeStatuses()" class="shrink-0 px-3 py-1 text-xs rounded-lg transition-colors inline-flex items-center gap-1.5" style="background:var(--theme-danger-bg); color:var(--theme-danger);">
              <%- icon('refresh-cw', { class: 'size-3', strokeWidth: 1.5 }) %>
              Retry Connection
            </button>
          </div>
        <% } %>

        <!-- Table of nodes -->
        <%- include('../../fragments/admin/nodes/node-table', { nodes, locations, settings, req }) %>
        </div>

        <!-- Locations Tab -->
        <div id="tab-panel-locations" role="tabpanel" aria-labelledby="tab-btn-locations" data-tab-panel="locations" hidden>
        <div id="locations" class="mt-6 space-y-5">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-semibold tracking-tight" style="color:var(--theme-text-strong);">Locations</h2>
              <p class="text-sm mt-0.5" style="color:var(--theme-text-muted);">Group nodes by region.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-accent) 12%, transparent); color:var(--theme-accent);">
                <%- icon('map-pin', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="totalLocationsCount"><%= locations.length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Locations</p>
              </div>
            </div>
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-info) 12%, transparent); color:var(--theme-info);">
                <%- icon('server', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="nodesAssignedTotal"><%= nodes.filter(n => n.locationId).length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Nodes assigned</p>
              </div>
            </div>
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-warning) 12%, transparent); color:var(--theme-warning);">
                <%- icon('network', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="nodesUnassignedTotal"><%= nodes.filter(n => !n.locationId).length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Nodes without a location</p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h3 class="al-card-header flex items-center gap-2"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>Create Location</h3>
            <div class="p-5">
              <div id="admin-locations-status"></div>
              <form id="createLocationForm" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end"
                x-data="{ saving: false, name: '', shortCode: '', async submit() {
                  if (!this.name || !this.shortCode) return;
                  this.saving = true;
                  try {
                    const res = await fetch('/admin/locations', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json', 'HX-Request': 'true' },
                      body: JSON.stringify({ name: this.name, shortCode: this.shortCode }),
                    });
                    if (res.ok) {
                      const html = await res.text();
                      const target = document.getElementById('admin-locations-list');
                      if (target) {
                        const tmp = document.createElement('div');
                        tmp.innerHTML = html;
                        const frag = tmp.querySelector('#admin-locations-list');
                        if (frag) target.replaceWith(frag);
                      }
                      showToast('Location created.', 'success');
                      this.name = ''; this.shortCode = '';
                    } else {
                      const data = await res.json().catch(() => ({}));
                      showToast(data.error || data.message || 'Failed to create location.', 'error');
                    }
                  } catch (e) { showToast('Failed to create location.', 'error'); }
                  this.saving = false;
                }}">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                  <label class="al-label" for="locName">Name</label>
                  <input id="locName" name="name" type="text" placeholder="US East" class="al-input" required x-model="name">
                </div>
                <div>
                  <label class="al-label" for="locCode">Short code</label>
                  <input id="locCode" name="shortCode" type="text" placeholder="us-east" class="al-input" autocapitalize="off" spellcheck="false" required x-model="shortCode">
                </div>
                <div class="lg:col-span-2 flex items-end">
                  <button type="button" @click="submit()" class="al-btn-primary w-full sm:w-auto" :disabled="saving">
                    <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                    <span x-show="!saving">Create Location</span>
                    <span x-show="saving">Creating...</span>
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="al-card">
            <h3 class="al-card-header flex items-center gap-2"><%- icon('map', { class: 'size-4', strokeWidth: 1.5 }) %>All Locations</h3>
            <div class="p-5">
              <%- include('../../fragments/admin/locations/location-list', { locations }) %>
            </div>
          </div>
        </div>
        </div>

      </div>
    </div>
  </div>
</main>


<div id="page-data" style="display:none"></div>
<script nonce="<%- nonce %>">
  document.getElementById('page-data').dataset.nodes = '<%- JSON.stringify(nodes.map(n => ({ id: n.id, status: n.status }))).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/</g, '\\x3c').replace(/>/g, '\\x3e') %>';
</script>
<script nonce="<%- nonce %>" src="/javascript/admin/admin-nodes.js?v=9"></script>
<script nonce="<%- nonce %>">
(function () {
  document.addEventListener('al:tabs-change', function (e) {
    if (e.detail && e.detail.name === 'locations') {
      var locEl = document.getElementById('locations');
      if (locEl) locEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  var csrfToken = '<%= csrfToken %>';

  window.openLocationEdit = function(id, name, shortCode) {
    var body = document.createElement('div');
    body.innerHTML =
      '<form id="editLocationForm" class="flex flex-col gap-4">' +
        '<div>' +
          '<label class="al-label" for="editLocName">Name</label>' +
          '<input id="editLocName" name="name" type="text" value="' + name.replace(/"/g, '&quot;') + '" class="al-input" required>' +
        '</div>' +
        '<div>' +
          '<label class="al-label" for="editLocCode">Short code</label>' +
          '<input id="editLocCode" name="shortCode" type="text" value="' + shortCode.replace(/"/g, '&quot;') + '" class="al-input" autocapitalize="off" spellcheck="false" required>' +
        '</div>' +
        '<div class="flex justify-end gap-2 pt-1">' +
          '<button type="button" onclick="window.modal.close()" class="al-btn-secondary px-4 py-2 text-sm font-medium">Cancel</button>' +
          '<button type="submit" class="al-btn-primary px-4 py-2 text-sm font-medium">Save</button>' +
        '</div>' +
      '</form>';

    window.modal.show({
      title: 'Edit Location',
      bodyNode: body,
      panelClass: 'max-w-md',
    });

    body.querySelector('form').addEventListener('submit', async function(e) {
      e.preventDefault();
      var nameVal = body.querySelector('#editLocName').value.trim();
      var codeVal = body.querySelector('#editLocCode').value.trim().toLowerCase();
      try {
        var res = await fetch('/admin/location/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
          body: JSON.stringify({ name: nameVal, shortCode: codeVal }),
        });
        var data = await res.json();
        if (res.ok) {
          showToast('Location updated.', 'success');
          window.modal.close();
          htmx.ajax('GET', '/admin/nodes', { target: '#tab-panel-locations', swap: 'innerHTML' });
        } else {
          showToast(data.message || 'Update failed.', 'error');
        }
      } catch(err) {
        showToast('Update failed.', 'error');
      }
    });
  };

  window.openLocationNodes = function(id, name) {
    var overlay = document.createElement('div');
    overlay.className = 'al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center p-4';
    overlay.innerHTML =
      '<div class="al-sheet-panel rounded-2xl max-w-lg w-full max-h-[85vh] flex flex-col shadow-xl" style="background:var(--theme-bg-card);border:1px solid var(--theme-border);">' +
        '<div class="al-sheet-header" style="border-color:var(--theme-border)">' +
          '<div><p class="text-sm font-semibold" style="color:var(--theme-text-strong);">Nodes in ' + name.replace(/</g, '&lt;') + '</p></div>' +
          '<button type="button" data-close-location-nodes class="w-9 h-9 flex items-center justify-center rounded-lg hover:opacity-75 transition" style="color:var(--theme-text-muted);">' +
            '<%- icon("x", { class: "w-4 h-4", strokeWidth: 2 }) %>' +
          '</button>' +
        '</div>' +
        '<div class="flex-1 min-h-0 overflow-y-auto px-5 py-4" id="location-nodes-body">' +
          '<div class="flex items-center justify-center py-10"><div class="htmx-indicator size-6 border-2 rounded-full" style="border-color:var(--theme-border);border-top-color:var(--theme-accent);"></div></div>' +
        '</div>' +
      '</div>';
    document.body.appendChild(overlay);
    Animate.openModal(overlay, overlay.querySelector('.al-sheet-panel'));

    var close = function() { Animate.closeModal(overlay, overlay.querySelector('.al-sheet-panel'), function() { overlay.remove(); }); };
    overlay.querySelector('[data-close-location-nodes]').addEventListener('click', close);
    overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });

    fetch('/admin/location/' + id + '/nodes')
      .then(function(r) { return r.text(); })
      .then(function(html) {
        document.getElementById('location-nodes-body').innerHTML = html;
      });
  };
})();
</script>

<%- include('../../components/footer') %>
