<%- include('../../components/header', { title: 'Dashboard' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/template') %>
    </div>
    <!-- Content -->
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Nodes' }
      ] }) %>
      <%- include('../../components/ui/page-header', {
        title: req.translations.adminNodesTitle,
        description: req.translations.adminNodesText,
        actions: '<a href="#locations" class="al-btn-secondary text-sm">' + icon('map-pin', { class: 'size-4', strokeWidth: 1.5 }) + 'Locations</a>' +
                 '<button id="createButton" type="button" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + req.translations.createNewNode + '</button>'
      }) %>

      <div class="al-page-body">

        <div class="flex items-center border-b" style="border-color:var(--theme-border);">
          <button id="tab-btn-nodes" type="button" data-tab="nodes" class="px-3 py-2 mr-4 text-sm font-medium rounded-lg transition">Nodes</button>
          <button id="tab-btn-locations" type="button" data-tab="locations" class="px-3 py-2 text-sm font-medium rounded-lg transition">Locations</button>
        </div>

        <div id="tab-panel-nodes">

        <div id="stats" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 mt-6">
          <div class="al-card">
            <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);"><%= req.translations.totalNodes %></h2>
            <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);"><%= nodes.length %></p>
            <% if (nodes.length > 0) { %>
            <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.onlineNodes %>: <%= nodes.filter(node => node.status === 'Online').length %></p>
            <% } else { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.noNodesAvailable || 'No nodes available' %></p>
            <% } %>
          </div>
          <div class="al-card">
            <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);">Servers</h2>
            <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);">
              <%= nodes.reduce((total, node) => total + (node.instances ? node.instances.length : 0), 0) %>
            </p>
            <% const totalInstances = nodes.reduce((total, node) => total + (node.instances ? node.instances.length : 0), 0); %>
            <% if (totalInstances > 0 && nodes.length > 0) { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);">
                <%= req.translations.averageInstanceDensity %>:
                <%= (totalInstances / nodes.length).toFixed(2) %>
              </p>
            <% } else { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.noInstancesAvailable %></p>
            <% } %>
          </div>
        </div>

        <!-- notifications -->
        <% if (req.query.err == "none") { %>
          <%- include('../../components/ui/alert', { type: 'success', message: req.translations.success + '!', detail: req.translations.actionCompleted }) %>
        <% } %>

        <!-- Daemon offline warning -->
        <% if (nodes.some(node => node.status === 'Offline')) { %>
          <div class="al-alert-danger mb-5">
            <%- icon('triangle-alert', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
            <div class="flex-1">
              <p class="font-medium">Connection Error</p>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">One or more nodes are offline. Some information may be unavailable.</p>
            </div>
            <button type="button" onclick="window.location.reload()" class="shrink-0 px-3 py-1 text-xs rounded-lg transition-colors inline-flex items-center gap-1.5" style="background:var(--theme-danger-bg); color:var(--theme-danger);">
              <%- icon('refresh-cw', { class: 'size-3', strokeWidth: 1.5 }) %>
              Retry Connection
            </button>
          </div>
        <% } %>

        <!-- Table of nodes -->
        <div class="overflow-x-auto rounded-xl border" id="nodeTable" style="border-color:var(--theme-border);box-shadow:var(--theme-shadow-sm)">
          <% if (nodes.length === 0) { %>
            <%- include('../../components/ui/empty-state', {
              iconName: 'network',
              title: 'No nodes yet',
              description: 'Add a node to start hosting servers.',
              action: '<button id="createButtonEmpty" type="button" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + req.translations.createNewNode + '</button>'
            }) %>
          <% } else { %>
          <table class="al-table" style="table-layout:auto">
            <colgroup>
              <col style="min-width:170px">
              <col style="min-width:180px">
              <col style="min-width:80px">
              <col style="min-width:220px">
            </colgroup>
            <thead class="al-table-head">
              <tr>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.name %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.connection %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.instances %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.actions %></th>
              </tr>
            </thead>
            <tbody>
              <% let nodeIdx = 0; nodes.forEach(function(node) { %>
                <tr data-node-id="<%= node.id %>" style="--i:<%= nodeIdx++ %>" class="al-table-tr cursor-pointer" onclick="handleRowClick(event, '/admin/node/<%= node.id %>/stats')">
                  <td class="al-table-td sm:pl-6">
                    <div class="flex items-center">
                      <div class="mr-5">
                        <% if (node.status == "Online") { %>
                          <span class="al-dot-online"></span>
                        <% } else if (node.status == "Offline") { %>
                          <span class="al-dot-offline group relative">
                            <% if (node.error) { %>
                              <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 -translate-y-1 w-48 text-xs rounded py-1 px-2 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 pointer-events-none z-10" style="background:var(--theme-bg-card); border:1px solid var(--theme-border); color:var(--theme-text);">
                                <%= node.error %>
                              </div>
                            <% } %>
                          </span>
                        <% } else { %>
                          <span class="al-dot-warning"></span>
                        <% } %>
                      </div>
                      <div class="font-medium" style="color:var(--theme-text-strong);"><%= node.name %></div>
                    </div>
                  </td>
                  <td class="al-table-td"><%= node.address %>:<%= node.port %>
                    <div class="mt-1 ml-2 inline-flex items-center rounded-md
                    <%= node.versionRelease ? 'bg-emerald-600 text-white ring-emerald-700' : 'bg-neutral-200 text-neutral-700 dark:bg-neutral-300/20 dark:text-neutral-300 ring-neutral-300/40 dark:ring-neutral-400/20' %>
                    px-2 py-1 text-xs font-medium ring-1 ring-inset">
                      <%= node.versionRelease || (req.translations.unknown || 'unknown') %>
                    </div></td>
                  <td class="al-table-td"><%= node.instances ? node.instances.length : 0 %></td>
                  <td class="al-table-td">
                    <div class="flex gap-3 whitespace-nowrap">
                      <button  onclick="configure('<%= node.id %>')" type="button" class="al-btn-secondary text-xs"><%- icon('settings', { class: 'size-3', strokeWidth: 1.5 }) %>Configure</button>
                      <a href="./node/<%= node.id %>" class="al-btn-secondary text-xs inline-flex items-center gap-1"><%- icon('pencil', { class: 'size-3', strokeWidth: 1.5 }) %>Edit</a>
                      <button  onclick="deleteNode('<%= node.id %>')" type="button" class="al-btn-ghost" style="color:var(--theme-danger);" aria-label="Delete node">
                        <%- icon('trash-2', { size: 16 }) %>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>
        </div>

        <!-- Locations Tab -->
        <div id="tab-panel-locations" class="hidden">
        <div id="locations" class="mt-6 space-y-5">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-semibold tracking-tight" style="color:var(--theme-text-strong);">Locations</h2>
              <p class="text-sm mt-0.5" style="color:var(--theme-text-muted);">Group nodes by region.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-accent) 12%, transparent); color:var(--theme-accent);">
                <%- icon('map-pin', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);"><%= locations.length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Locations</p>
              </div>
            </div>
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-info) 12%, transparent); color:var(--theme-info);">
                <%- icon('server', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);"><%= nodes.filter(n => n.locationId).length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Nodes assigned</p>
              </div>
            </div>
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-warning) 12%, transparent); color:var(--theme-warning);">
                <%- icon('network', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);"><%= nodes.filter(n => !n.locationId).length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);">Nodes without a location</p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h3 class="al-card-header flex items-center gap-2"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>Create Location</h3>
            <div class="p-5">
              <form id="createLocationForm" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end" onsubmit="event.preventDefault();document.getElementById('createLocationBtn').click();">
                <div>
                  <label class="al-label" for="locName">Name</label>
                  <input id="locName" type="text" placeholder="US East" class="al-input">
                </div>
                <div>
                  <label class="al-label" for="locCode">Short code</label>
                  <input id="locCode" type="text" placeholder="us-east" class="al-input" autocapitalize="off" spellcheck="false">
                </div>
                <div class="lg:col-span-2 flex items-end">
                  <button id="createLocationBtn" type="button" class="al-btn-primary w-full sm:w-auto">
                    <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                    Create Location
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="al-card">
            <h3 class="al-card-header flex items-center gap-2"><%- icon('map', { class: 'size-4', strokeWidth: 1.5 }) %>All Locations</h3>
            <div class="p-5">
              <% if (locations.length === 0) { %>
                <div class="text-center py-10">
                  <div class="mx-auto mb-3 w-12 h-12 rounded-2xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-border) 35%, transparent); color:var(--theme-text-muted);">
                    <%- icon('map-pin', { class: 'size-6', strokeWidth: 1.5 }) %>
                  </div>
                  <p class="text-sm font-medium" style="color:var(--theme-text-strong);">No locations yet</p>
                  <p class="text-xs mt-1" style="color:var(--theme-text-muted);">Create your first location above to start grouping nodes by region.</p>
                </div>
              <% } else { %>
                <% const byRegion = new Map(); locations.forEach(loc => {
                     const region = loc.shortCode.split('-')[0] || 'Other';
                     if (!byRegion.has(region)) byRegion.set(region, []);
                     byRegion.get(region).push(loc);
                   });
                   for (const [region, locs] of byRegion) { %>
                  <div class="mb-6 last:mb-0">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="text-[11px] font-semibold uppercase tracking-widest" style="color:var(--theme-text-muted);"><%= region %></span>
                      <span class="h-px flex-1" style="background:var(--theme-border);"></span>
                      <span class="text-xs" style="color:var(--theme-text-muted);"><%= locs.length %></span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                      <% locs.forEach(loc => { %>
                        <div class="rounded-xl border p-4 flex items-center justify-between gap-3 transition-shadow hover:shadow-sm" style="border-color:var(--theme-border); background:var(--theme-bg-card);">
                          <div class="min-w-0">
                            <div class="flex items-center gap-2">
                              <span class="shrink-0 w-2 h-2 rounded-full" style="background:<%= loc._count.nodes > 0 ? 'var(--theme-success)' : 'var(--theme-border)' %>;"></span>
                              <p class="font-medium text-sm truncate" style="color:var(--theme-text-strong);"><%= loc.name %></p>
                            </div>
                            <p class="text-xs mt-1.5 font-mono" style="color:var(--theme-text-muted);"><%= loc.shortCode %></p>
                            <p class="text-xs mt-1" style="color:var(--theme-text-muted);"><%= loc._count.nodes %> node(s)</p>
                          </div>
                          <button type="button" class="delete-location-btn shrink-0 w-9 h-9 rounded-lg flex items-center justify-center transition-colors hover:bg-red-50 dark:hover:bg-red-950/30" data-id="<%= loc.id %>" data-name="<%= loc.name %>" aria-label="Delete location <%= loc.name %>">
                            <%- icon('trash', { class: 'size-4', strokeWidth: 1.5, style: 'color:var(--theme-danger);' }) %>
                          </button>
                        </div>
                      <% }); %>
                    </div>
                  </div>
                <% } %>
              <% } %>
            </div>
          </div>
        </div>
        </div>

      </div>
    </div>
  </div>
</main>


<div id="page-data" style="display:none"></div>
<script nonce="<%- nonce %>">
  document.getElementById('page-data').dataset.nodes = '<%- JSON.stringify(nodes.map(n => ({ id: n.id, status: n.status }))).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/</g, '\\x3c').replace(/>/g, '\\x3e') %>';
</script>
<script nonce="<%- nonce %>" src="/javascript/admin/admin-nodes.js?v=8"></script>
<script nonce="<%- nonce %>">
(function () {
  const toast = window.showToast || function (m) { console.warn('[locations]', m); };

  document.getElementById('createLocationBtn').addEventListener('click', async () => {
    const name = document.getElementById('locName').value.trim();
    const shortCode = document.getElementById('locCode').value.trim().toLowerCase();
    if (!name || !shortCode) { toast('Name and short code are required.', 'error'); return; }

    const r = await fetch('/admin/locations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
      body: JSON.stringify({ name, shortCode }),
    });
    const d = await r.json();
    if (r.ok) {
      toast('Location created.', 'success');
      setTimeout(() => window.location.reload(), 800);
    } else {
      toast(d.message || 'Failed to create location.', 'error');
    }
  });

  document.querySelectorAll('.delete-location-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      await new Promise(resolve => {
        window.modal.confirm({
          title: 'Delete location',
          body: 'Delete "' + btn.dataset.name + '"? Servers in it will lose their grouping.',
          danger: true,
          confirmLabel: 'Delete',
          onConfirm: resolve,
        });
      });
      const r = await fetch('/admin/location/' + btn.dataset.id, { method: 'DELETE', headers: { 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' } });
      const d = await r.json();
      if (r.ok) {
        toast('Location deleted.', 'success');
        setTimeout(() => window.location.reload(), 800);
      } else {
        toast(d.message || 'Failed to delete location.', 'error');
      }
    });
  });
})();
</script>
<script nonce="<%- nonce %>">
(function () {
  const btnNodes = document.getElementById('tab-btn-nodes');
  const btnLocs = document.getElementById('tab-btn-locations');
  const panelNodes = document.getElementById('tab-panel-nodes');
  const panelLocs = document.getElementById('tab-panel-locations');
  if (!btnNodes || !btnLocs || !panelNodes || !panelLocs) return;

  const ACTIVE = 'px-3 py-2 mr-4 text-sm font-medium text-white dark:text-black bg-neutral-900 dark:bg-white rounded-lg transition';
  const INACTIVE = 'px-3 py-2 mr-4 text-sm font-medium text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 rounded-lg transition';

  function activateTab(name, scroll) {
    const isLoc = name === 'locations';
    btnNodes.className = isLoc ? INACTIVE : ACTIVE;
    btnLocs.className = isLoc ? ACTIVE : INACTIVE;
    panelNodes.classList.toggle('hidden', isLoc);
    panelLocs.classList.toggle('hidden', !isLoc);
    if (scroll && isLoc) {
      const locEl = document.getElementById('locations');
      if (locEl) locEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  btnNodes.addEventListener('click', function () {
    activateTab('nodes');
    history.replaceState(null, '', '#nodes');
  });
  btnLocs.addEventListener('click', function () {
    activateTab('locations');
    history.replaceState(null, '', '#locations');
  });

  function handleHash() {
    if (window.location.hash === '#locations') activateTab('locations', true);
    else activateTab('nodes');
  }

  handleHash();
  window.addEventListener('hashchange', handleHash);
})();
</script>

<%- include('../../components/footer') %>
