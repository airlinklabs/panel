<%- include('../../layouts/admin', { title: t('nodeStatsTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbNodes'), url: '/admin/nodes' },
    { label: node.name }
  ] }) %>
</div>

<div class="al-page-header">
  <div class="min-w-0">
    <div class="flex items-center gap-3">
      <h1 class="al-page-title"><%= node.name %></h1>
      <% if (node.status === 'Online') { %>
        <span class="al-dot-online"></span>
      <% } else { %>
        <span class="al-dot-offline"></span>
      <% } %>
    </div>
    <p class="al-page-desc"><%= node.address %>:<%= node.port %><% if (node.versionRelease) { %> &middot; <%= node.versionRelease %><% } %></p>
  </div>
  <div>
    <a href="/admin/nodes" class="al-btn-secondary">
      <%- icon('arrow-left', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('back') %>
    </a>
    <a href="/admin/node/<%= node.id %>" class="al-btn-secondary">
      <%- icon('pencil', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('edit') %>
    </a>
  </div>
</div>

<div class="al-page-body">
  <!-- Resource gauges -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="al-card text-center">
      <p class="al-section-label"><%= t('ram') %></p>
      <p id="host-ram" class="text-2xl font-semibold al-text-strong">--</p>
      <p id="host-ram-detail" class="text-xs mt-1 al-text-muted">--</p>
    </div>
    <div class="al-card text-center">
      <p class="al-section-label"><%= t('cpu') %></p>
      <p id="host-cpu" class="text-2xl font-semibold al-text-strong">--</p>
      <p id="host-cpu-detail" class="text-xs mt-1 al-text-muted">--</p>
    </div>
    <div class="al-card text-center">
      <p class="al-section-label"><%= t('disk') %></p>
      <p id="host-disk" class="text-2xl font-semibold al-text-strong">--</p>
      <p id="host-disk-detail" class="text-xs mt-1 al-text-muted">--</p>
    </div>
    <div class="al-card text-center">
      <p class="al-section-label"><%= t('uptime') %></p>
      <p id="host-uptime" class="text-2xl font-semibold al-text-strong">--</p>
      <p class="text-xs mt-1 al-text-muted"><%= t('sinceBoot') %></p>
    </div>
  </div>

  <!-- Allocation bars -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="al-card">
      <div class="flex justify-between items-center mb-2">
        <p class="al-section-label mb-0"><%= t('ramAllocation') %></p>
        <p id="alloc-ram-pct" class="text-sm font-medium al-text-muted">--</p>
      </div>
      <div class="al-progress al-progress-success">
        <div id="alloc-ram-bar" class="al-progress-fill" style="width:0%"></div>
      </div>
      <p id="alloc-ram-text" class="text-xs mt-1.5 al-text-muted">--</p>
    </div>
    <div class="al-card">
      <div class="flex justify-between items-center mb-2">
        <p class="al-section-label mb-0"><%= t('cpuAllocation') %></p>
        <p id="alloc-cpu-pct" class="text-sm font-medium al-text-muted">--</p>
      </div>
      <div class="al-progress al-progress-info">
        <div id="alloc-cpu-bar" class="al-progress-fill" style="width:0%"></div>
      </div>
      <p id="alloc-cpu-text" class="text-xs mt-1.5 al-text-muted">--</p>
    </div>
    <div class="al-card">
      <div class="flex justify-between items-center mb-2">
        <p class="al-section-label mb-0"><%= t('diskAllocation') %></p>
        <p id="alloc-disk-pct" class="text-sm font-medium al-text-muted">--</p>
      </div>
      <div class="al-progress al-progress-warning">
        <div id="alloc-disk-bar" class="al-progress-fill" style="width:0%"></div>
      </div>
      <p id="alloc-disk-text" class="text-xs mt-1.5 al-text-muted">--</p>
    </div>
  </div>

  <!-- Counts -->
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="al-card text-center">
      <p class="al-section-label"><%= t('instances') %></p>
      <p id="count-instances" class="text-3xl font-semibold al-text-strong"><%= node._count ? node._count.servers : '--' %></p>
    </div>
    <div class="al-card text-center">
      <p class="al-section-label"><%= t('allocations') %></p>
      <p id="count-alloc" class="text-3xl font-semibold al-text-strong"><%= node._count ? node._count.allocations : '--' %></p>
    </div>
  </div>

  <!-- Charts -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="al-card">
      <h2 class="al-section-label"><%= t('ramUsage') %></h2>
      <div style="position:relative;height:220px"><canvas id="ramChart"></canvas></div>
    </div>
    <div class="al-card">
      <h2 class="al-section-label"><%= t('cpuUsage') %></h2>
      <div style="position:relative;height:220px"><canvas id="cpuChart"></canvas></div>
    </div>
  </div>
</div>

<div id="page-data" style="display:none"
  data-node-id="<%= node.id %>"
  data-stats="<%= JSON.stringify(stats.totalStats || stats || []) %>"
  data-host="<%= JSON.stringify(stats.host || {}) %>"
  data-ram="<%= node.ram || 0 %>"
  data-cpu="<%= node.cpu || 0 %>"
  data-disk="<%= node.disk || 0 %>"
  data-overalloc-mem="<%= node.overallocateMemory || 0 %>"
  data-overalloc-disk="<%= node.overallocateDisk || 0 %>"
  data-overalloc-cpu="<%= node.overallocateCpu || 0 %>"
  data-instances="<%= node._count ? node._count.servers : 0 %>"
  data-allocations="<%= node._count ? node._count.allocations : 0 %>"
></div>

<script nonce="<%- nonce %>" src="<%= assetUrl('/vendor/chart.js/dist/chart.umd.min.js') %>"></script>
<script nonce="<%- nonce %>">
(function() {
  var pd = document.getElementById('page-data').dataset;
  var hostData = JSON.parse(pd.host || '{}');
  var statsData = JSON.parse(pd.stats || '[]');
  var nodeRam = parseFloat(pd.ram) || 0;
  var nodeCpu = parseFloat(pd.cpu) || 0;
  var nodeDisk = parseFloat(pd.disk) || 0;

  // Populate host info
  if (hostData) {
    if (hostData.ram) document.getElementById('host-ram').textContent = hostData.ram;
    if (hostData.cpu) document.getElementById('host-cpu').textContent = hostData.cpu;
    if (hostData.disk) document.getElementById('host-disk').textContent = hostData.disk;
    if (hostData.uptime) document.getElementById('host-uptime').textContent = hostData.uptime;
    if (hostData.ramDetail) document.getElementById('host-ram-detail').textContent = hostData.ramDetail;
    if (hostData.cpuDetail) document.getElementById('host-cpu-detail').textContent = hostData.cpuDetail;
    if (hostData.diskDetail) document.getElementById('host-disk-detail').textContent = hostData.diskDetail;
  }

  // Charts
  if (typeof Chart !== 'undefined' && statsData.length > 0) {
    var themeColors = getComputedStyle(document.documentElement);

    function themeToken(name, fallback) {
      var v = themeColors.getPropertyValue(name).trim();
      return v || fallback;
    }

    // Chart.js cannot parse `color-mix(...)`, so resolve the translucent
    // fill through a probe element instead of hardcoding a hex.
    function themeFill(name, fallback) {
      var probe = document.createElement('div');
      probe.style.background = 'color-mix(in srgb, var(' + name + ') 12%, transparent)';
      probe.style.position = 'absolute';
      probe.style.visibility = 'hidden';
      document.body.appendChild(probe);
      var resolved = getComputedStyle(probe).backgroundColor;
      probe.remove();
      return resolved && resolved !== 'rgba(0, 0, 0, 0)' ? resolved : fallback;
    }

    var labels = statsData.map(function(s, i) { return i; });
    var ramData = statsData.map(function(s) { return s.memory || 0; });
    var cpuData = statsData.map(function(s) { return s.cpu || 0; });

    var chartOpts = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { display: false },
        y: { beginAtZero: true, max: 100, ticks: { callback: function(v) { return v + '%'; } } }
      },
      elements: { point: { radius: 0 }, line: { tension: 0.4, borderWidth: 2 } }
    };

    new Chart(document.getElementById('ramChart'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          data: ramData,
          borderColor: themeToken('--theme-success', '#22c55e'),
          backgroundColor: themeFill('--theme-success', 'rgba(34,197,94,0.12)'),
          fill: true
        }]
      },
      options: chartOpts
    });

    new Chart(document.getElementById('cpuChart'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          data: cpuData,
          borderColor: themeToken('--theme-info', '#3b82f6'),
          backgroundColor: themeFill('--theme-info', 'rgba(59,130,246,0.12)'),
          fill: true
        }]
      },
      options: chartOpts
    });
  }
})();
</script>

<%- include('../../layouts/admin-footer') %>
