<%- include('../../components/header', { title: 'Create Node' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12" x-data="nodeCreate()">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Nodes', href: '/admin/nodes' },
        { label: 'Create' }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= req.translations.adminCreateNodeTitle %></h1>
          <p class="al-page-desc"><%= req.translations.adminCreateNodeText || 'One more node and you\'ll have a proper fleet going.' %></p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <button id="createNodeBtn" type="button" class="al-btn-primary" @click="createNode()"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.create || 'Create Node' %></button>
          <a href="/admin/nodes" class="al-btn-secondary">Back to Nodes</a>
        </div>
      </div>

      <div id="nodeForm" class="al-page-body space-y-5">
        <form class="space-y-5">
          <div class="al-card">
            <h2 class="al-card-header">General</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="md:col-span-2">
                <label for="nodeName" class="al-label flex items-center gap-1.5">
                  <%- icon('tag', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.name %>
                </label>
                <input id="nodeName" class="al-input" placeholder="My node">
              </div>

              <div>
                <label for="nodeAddress" class="al-label flex items-center gap-1.5">
                  <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.addressIP %>
                </label>
                <input id="nodeAddress" class="al-input" placeholder="localhost">
              </div>

              <div>
                <label for="nodePort" class="al-label flex items-center gap-1.5">
                  <%- icon('radio-tower', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.daemonPort %>
                </label>
                <input id="nodePort" class="al-input" placeholder="3002">
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Resource Allocation</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <div>
                <label for="nodeRam" class="al-label flex items-center gap-1.5">
                  <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.ram %>
                </label>
                <input type="hidden" id="nodeRamValue" value="">
                <div class="flex gap-2 items-center">
                  <div class="flex items-stretch flex-1 gap-0">
                    <input id="nodeRam" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                    <button type="button" class="al-format-switcher" data-format-switcher
                      data-display="nodeRam" data-hidden="nodeRamValue"
                      data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
                  </div>
                  <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
                    <input type="checkbox" id="nodeRamAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
                  </label>
                </div>
              </div>

              <div>
                <label for="nodeDisk" class="al-label flex items-center gap-1.5">
                  <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.disk %>
                </label>
                <input type="hidden" id="nodeDiskValue" value="">
                <div class="flex gap-2 items-center">
                  <div class="flex items-stretch flex-1 gap-0">
                    <input id="nodeDisk" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                    <button type="button" class="al-format-switcher" data-format-switcher
                      data-display="nodeDisk" data-hidden="nodeDiskValue"
                      data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
                  </div>
                  <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
                    <input type="checkbox" id="nodeDiskAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
                  </label>
                </div>
              </div>

              <div>
                <label for="nodeProcessor" class="al-label flex items-center gap-1.5">
                  <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.cpu %>
                </label>
                <input type="hidden" id="nodeCpuValue" value="">
                <div class="flex gap-2 items-center">
                  <div class="flex items-stretch flex-1 gap-0">
                    <input id="nodeProcessor" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                    <button type="button" class="al-format-switcher" data-format-switcher
                      data-display="nodeProcessor" data-hidden="nodeCpuValue"
                      data-units="1:%,100:Cores" data-default-unit="Cores">Cores</button>
                  </div>
                  <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
                    <input type="checkbox" id="nodeProcessorAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
                  </label>
                </div>
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">1 core = 100%</p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Overallocation</h2>
            <p class="mb-4 text-xs" style="color:var(--theme-text-muted)">Allow servers to exceed node limits by this percentage (0 = strict).</p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <div>
                <label for="nodeOverallocateMemory" class="al-label flex items-center gap-1.5">
                  <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %>
                  Memory %
                </label>
                <input id="nodeOverallocateMemory" type="number" min="0" value="<%= settings.defaultOverallocateMemory ?? 0 %>" class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings.</p>
              </div>
              <div>
                <label for="nodeOverallocateDisk" class="al-label flex items-center gap-1.5">
                  <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %>
                  Disk %
                </label>
                <input id="nodeOverallocateDisk" type="number" min="0" value="<%= settings.defaultOverallocateDisk ?? 0 %>" class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings.</p>
              </div>
              <div>
                <label for="nodeOverallocateCpu" class="al-label flex items-center gap-1.5">
                  <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %>
                  CPU %
                </label>
                <input id="nodeOverallocateCpu" type="number" min="0" value="<%= settings.defaultOverallocateCpu ?? 0 %>" class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings.</p>
              </div>
            </div>
            <div class="mt-4">
              <label for="nodeLocation" class="al-label flex items-center gap-1.5">
                <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %>
                Location
              </label>
              <select id="nodeLocation" class="al-input">
                <option value="">No location</option>
                <% (locations || []).forEach(loc => { %>
                  <option value="<%= loc.id %>"><%= loc.name %> (<%= loc.shortCode %>)</option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Daemon Configuration</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="md:col-span-2">
                <label for="daemonKey" class="al-label"><%= req.translations.daemonKey || 'Daemon Key' %></label>
                <input id="daemonKey" class="al-input" placeholder="Leave blank to auto-generate">
                <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)">Optional. If left blank, a secure key will be generated automatically.</p>
              </div>

              <div class="md:col-span-2">
                <label for="allocatedPorts" class="al-label">Allocated Ports</label>
                <div class="space-y-2">
                  <div id="allocatedPortsList" class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2">
                    <!-- Port tags will be inserted here -->
                  </div>
                  <div class="flex gap-2">
                    <input id="newPortInput" type="text" placeholder="25565 or 25565-25570" class="al-input flex-1" @keypress.enter.prevent="addPortFromInput()">
                    <button id="addPortBtn" type="button" class="al-btn-primary" @click="addPortFromInput()">
                      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                      Add Port
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>

      <div id="nodeSetupPanel" class="hidden">
        <div class="max-w-xl mx-auto">
          <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4" style="background:color-mix(in srgb, var(--theme-success) 12%, transparent); color:var(--theme-success);">
              <%- icon('check-circle', { class: 'size-8', strokeWidth: 1.5 }) %>
            </div>
            <h2 class="text-xl font-semibold" style="color:var(--theme-text-strong);">Node created — one step left</h2>
            <p class="text-sm mt-2 max-w-md mx-auto" style="color:var(--theme-text-muted);">Run this command on the machine where the daemon will run. It connects the daemon to this panel.</p>
          </div>

          <div class="rounded-2xl border p-5" style="border-color:var(--theme-border); background:var(--theme-bg-secondary);">
            <p class="text-xs font-medium mb-3 flex items-center gap-1.5" style="color:var(--theme-text-muted);">
              <%- icon('terminal', { width: 13, height: 13, class: 'shrink-0' }) %>
              Run on the daemon machine
            </p>
            <div class="relative">
              <div id="daemonCliCommand" class="rounded-xl border p-4 pr-12 text-[13px] font-mono whitespace-nowrap overflow-x-auto cursor-text select-all" style="background:var(--theme-bg-input); border-color:var(--theme-border); color:var(--theme-text-strong);" tabindex="0" aria-label="Daemon connect command"></div>
              <button id="copyDaemonCli" type="button" class="absolute top-1/2 -translate-y-1/2 right-2 p-2 rounded-lg transition-colors hover:scale-105" style="color:var(--theme-text-muted);" aria-label="Copy command" @click="copyCliCommand()"><%- icon('copy', { class: 'size-4', strokeWidth: 1.5 }) %></button>
            </div>
            <p id="copyDaemonCliHint" class="mt-2 text-xs" style="color:var(--theme-text-muted);"></p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 mt-6">
            <button id="verifyDaemonBtn" type="button" class="al-btn-primary flex-1 justify-center" @click="verifyDaemon()">
              <%- icon('check', { class: 'size-4', strokeWidth: 1.5 }) %> I've done this — verify connection
            </button>
            <a href="/admin/nodes" class="al-btn-secondary flex-1 justify-center">Back to Nodes</a>
          </div>
          <p id="daemonVerifyResult" class="hidden mt-4 text-sm font-medium text-center"></p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../components/loadingPopup') %>

<style>
#nodeForm .al-card-header { border-radius: 12px 12px 0 0; overflow: hidden; margin-bottom: 16px; }
</style>

<script nonce="<%- nonce %>">
function nodeCreate() {
  return {
    allocatedPorts: [],
    _portEase: getComputedStyle(document.documentElement).getPropertyValue('--ease-standard').trim() || 'ease',
    PORT_MIN: 1024,
    PORT_MAX: 65535,
    ANIMATION_DURATION_MS: 200,
    PORT_STAGGER_MS: 30,
    PORT_OUT_DURATION_MS: 160,
    COPY_RESET_DELAY_MS: 1500,
    VERIFY_DELAY_MS: 1800,

    init() {
      this.renderAllocatedPorts();
      this.checkHashRoute();
      window.addEventListener('hashchange', () => this.checkHashRoute());
      ['nodeRam', 'nodeDisk', 'nodeProcessor'].forEach((id) => {
        const checkbox = document.getElementById(id + 'All');
        const input = document.getElementById(id);
        if (checkbox && input) {
          checkbox.addEventListener('change', function() {
            input.disabled = this.checked;
            if (this.checked) {
              input.value = '';
              input.dispatchEvent(new Event('input'));
            }
          });
        }
      });
    },

    renderAllocatedPorts() {
      const portsList = document.getElementById('allocatedPortsList');
      portsList.innerHTML = '';
      if (this.allocatedPorts.length === 0) {
        const emptyMessage = document.createElement('div');
        emptyMessage.className = 'col-span-4 text-sm italic';
        emptyMessage.style.color = 'var(--theme-text-muted)';
        emptyMessage.textContent = 'No ports allocated yet. Add ports that will be available for servers.';
        portsList.appendChild(emptyMessage);
        return;
      }
      this.allocatedPorts.forEach(port => {
        portsList.appendChild(this.buildPortTag(port));
      });
    },

    buildPortTag(port) {
      const portTag = document.createElement('div');
      portTag.dataset.port = port;
      portTag.className = 'flex items-center justify-between rounded-lg bg-neutral-800/10 dark:bg-neutral-700/20 px-3 py-1.5 text-sm';
      portTag.style.opacity = '0';
      portTag.style.transform = 'translateY(4px)';

      const portText = document.createElement('span');
      portText.className = 'text-neutral-800 dark:text-neutral-300';
      portText.textContent = port;

      const deleteBtn = document.createElement('button');
      deleteBtn.className = 'ml-2 text-neutral-500 hover:text-red-500 transition-colors';
      deleteBtn.innerHTML = alIcon('x', 'w-4 h-4', { strokeWidth: 1.5 });
      deleteBtn.onclick = (e) => {
        e.preventDefault();
        this.animatePortOut(portTag, () => this.removePort(port));
      };

      portTag.appendChild(portText);
      portTag.appendChild(deleteBtn);
      return portTag;
    },

    animatePortIn(el) {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          el.style.transition = 'opacity 0.18s ' + this._portEase + ', transform 0.18s ' + this._portEase;
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
          setTimeout(() => { el.style.transition = ''; }, this.ANIMATION_DURATION_MS);
        });
      });
    },

    animatePortOut(el, cb) {
      el.style.transition = 'opacity 0.15s ' + this._portEase + ', transform 0.15s ' + this._portEase;
      el.style.opacity = '0';
      el.style.transform = 'translateY(-4px)';
      setTimeout(cb, this.PORT_OUT_DURATION_MS);
    },

    addPort(input) {
      if (input.includes('-')) {
        const [start, end] = input.split('-').map(p => parseInt(p.trim()));
        if (isNaN(start) || isNaN(end) || start >= end || start < this.PORT_MIN || end > this.PORT_MAX) {
          showToast('Invalid port range. Format should be start-end (e.g., 25565-25570) with ports between ' + this.PORT_MIN + ' and ' + this.PORT_MAX + '.', 'error');
          return;
        }
        for (let port = start; port <= end; port++) {
          if (!this.allocatedPorts.includes(port)) this.allocatedPorts.push(port);
        }
      } else {
        const port = parseInt(input.trim());
        if (isNaN(port) || port < this.PORT_MIN || port > this.PORT_MAX) {
          showToast('Invalid port. Port must be between ' + this.PORT_MIN + ' and ' + this.PORT_MAX + '.', 'error');
          return;
        }
        if (!this.allocatedPorts.includes(port)) this.allocatedPorts.push(port);
      }

      this.allocatedPorts.sort((a, b) => a - b);
      this.renderAllocatedPorts();

      const tags = document.querySelectorAll('#allocatedPortsList > div[data-port]');
      tags.forEach((tag, i) => setTimeout(() => this.animatePortIn(tag), i * this.PORT_STAGGER_MS));
    },

    removePort(port) {
      this.allocatedPorts = this.allocatedPorts.filter(p => p !== port);
      this.renderAllocatedPorts();
      document.querySelectorAll('#allocatedPortsList > div[data-port]').forEach(tag => { tag.style.opacity = '1'; tag.style.transform = ''; });
    },

    addPortFromInput() {
      const input = document.getElementById('newPortInput').value.trim();
      if (input) {
        this.addPort(input);
        document.getElementById('newPortInput').value = '';
      }
    },

    gbValue(hiddenId) {
      const hidden = document.getElementById(hiddenId);
      if (hidden) {
        const v = parseFloat(hidden.value);
        if (!hidden.value || isNaN(v)) return '';
        return isFinite(v) ? String(Math.round(v / 1024 * 100) / 100) : '';
      }
      return '';
    },

    async createNode() {
      const ramAll = document.getElementById('nodeRamAll').checked;
      const diskAll = document.getElementById('nodeDiskAll').checked;
      const cpuAll = document.getElementById('nodeProcessorAll').checked;

      const nodeData = {
        name: document.getElementById('nodeName').value,
        ram: ramAll ? 'all' : this.gbValue('nodeRamValue'),
        cpu: cpuAll ? 'all' : document.getElementById('nodeCpuValue').value,
        disk: diskAll ? 'all' : this.gbValue('nodeDiskValue'),
        address: document.getElementById('nodeAddress').value,
        port: document.getElementById('nodePort').value,
        key: document.getElementById('daemonKey').value.trim(),
        allocatedPorts: JSON.stringify(this.allocatedPorts),
        overallocateMemory: document.getElementById('nodeOverallocateMemory').value,
        overallocateDisk: document.getElementById('nodeOverallocateDisk').value,
        overallocateCpu: document.getElementById('nodeOverallocateCpu').value,
        locationId: document.getElementById('nodeLocation').value
      };

      if (!nodeData.name || !nodeData.address || !nodeData.port) {
        showToast('Please fill in all required fields.', 'error');
        return;
      }

      if (!ramAll && !nodeData.ram) { showToast('RAM is required when not unlimited.', 'error'); return; }
      if (!diskAll && !nodeData.disk) { showToast('Disk is required when not unlimited.', 'error'); return; }
      if (!cpuAll && !nodeData.cpu) { showToast('CPU is required when not unlimited.', 'error'); return; }

      const loader = showLoadingPopup('Creating Node', 'Initializing node creation...');
      loader.updateProgress(20, 'Sending node configuration...');

      try {
        const response = await fetch('/admin/nodes/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(nodeData)
        });

        if (response.ok) {
          const data = await response.json();
          loader.updateProgress(100, 'Node created!');
          setTimeout(() => {
            loader.close();
            sessionStorage.setItem('airlink:newNode', JSON.stringify(data.node));
            window.location.hash = '#created';
          }, 500);
        } else {
          loader.close();
          const data = await response.json().catch(() => ({}));
          showToast(data.error || data.message || 'Failed to create node.', 'error');
        }
      } catch (error) {
        loader.close();
        console.error('Error creating node:', error);
        showToast('Error creating node. Try again.', 'error');
      }
    },

    showSetupPanel(node) {
      const form = document.getElementById('nodeForm');
      const panel = document.getElementById('nodeSetupPanel');
      form.classList.add('hidden');
      panel.classList.remove('hidden');

      const panelUrl = window.location.origin;
      const cli = 'configure --panel "' + panelUrl + '" --key "' + node.key + '"';
      document.getElementById('daemonCliCommand').textContent = cli;

      const copyHint = document.getElementById('copyDaemonCliHint');
      copyHint.textContent = 'Paste into a terminal on the machine where the daemon runs.';

      this._currentNode = node;
      this._currentCli = cli;
    },

    async copyCliCommand() {
      const copyCli = document.getElementById('copyDaemonCli');
      const copyHint = document.getElementById('copyDaemonCliHint');
      const cli = this._currentCli;
      const label = copyCli.innerHTML;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(cli);
        } else {
          const ta = document.createElement('textarea');
          ta.value = cli;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        copyCli.innerHTML = '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        copyHint.textContent = 'Copied!';
      } catch {
        copyHint.textContent = 'Could not copy. Select the command above and copy it manually.';
      }
      setTimeout(() => { copyCli.innerHTML = label; copyHint.textContent = 'Paste into a terminal on the machine where the daemon runs.'; }, this.COPY_RESET_DELAY_MS);
    },

    async verifyDaemon() {
      const node = this._currentNode;
      const btn = document.getElementById('verifyDaemonBtn');
      const result = document.getElementById('daemonVerifyResult');
      btn.disabled = true;
      btn.textContent = 'Checking...';
      result.classList.add('hidden');

      try {
        const res = await fetch('/admin/node/' + node.id + '/verify', { method: 'POST' });
        const d = await res.json().catch(() => ({}));
        result.classList.remove('hidden');
        if (d.connected) {
          result.style.color = 'var(--theme-success)';
          result.textContent = 'Daemon is live' + (d.version ? ' (' + d.version + ')' : '') + '. Key checks out — servers can now run on this node.';
          showToast('Daemon verified!', 'success');
          setTimeout(() => { window.location.href = '/admin/nodes?verified=' + node.id; }, this.VERIFY_DELAY_MS);
        } else {
          result.style.color = 'var(--theme-danger)';
          result.textContent = d.error || 'Could not reach the daemon. Check the address, port, and key.';
        }
      } catch {
        result.classList.remove('hidden');
        result.style.color = 'var(--theme-danger)';
        result.textContent = 'Verification failed. Check the address, port, and key, then try again.';
      } finally {
        btn.disabled = false;
        btn.textContent = 'I\'ve done this — verify connection';
      }
    },

    checkHashRoute() {
      if (window.location.hash === '#created') {
        const stored = sessionStorage.getItem('airlink:newNode');
        if (stored) {
          sessionStorage.removeItem('airlink:newNode');
          try {
            this.showSetupPanel(JSON.parse(stored));
          } catch {}
        }
      }
    }
  };
}
</script>

<%- include('../../components/footer') %>
