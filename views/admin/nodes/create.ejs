<%- include('../../components/header', { title: 'Dashboard' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/template') %>
    </div>
    <!-- Content -->
    <div id="page-content" class="flex-1 p-6 overflow-y-auto pt-16">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin', href: '/admin' },
        { label: 'Nodes', href: '/admin/nodes' },
        { label: 'Create' }
      ] }) %>
      <div class="al-page-header">
        <h1 class="al-page-title"><%= req.translations.adminCreateNodeTitle %></h1>
        <p class="al-page-desc"><%= req.translations.adminCreateNodeText || 'One more node and you\'ll have a proper fleet going.' %></p>
      </div>

      <div id="nodeForm" class="mt-6 px-8 w-full">
        <div class="al-card p-5">
          <form>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="nodeName" class="al-label">
                  <%- icon('tag', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.name %>:</label>
                <input id="nodeName" class="al-input" placeholder="My node">
              </div>

              <div>
                <label for="nodeRam" class="al-label">
                  <%- icon('chip', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.adminNodeRamLabel %>:</label>
                <input id="nodeRam" class="al-input" placeholder="This is only for information purposes.">
              </div>

              <div>
                <label for="nodeDisk" class="al-label">
                  <%- icon('database', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.adminNodeDiskLabel %>:</label>
                <input id="nodeDisk" class="al-input" placeholder="This is only for information purposes.">
              </div>

              <div>
                <label for="nodeProcessor" class="al-label">
                  <%- icon('cpu', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.adminNodeProcessorLabel %>:</label>
                <input id="nodeProcessor" class="al-input" placeholder="This is only for information purposes.">
              </div>

              <div>
                <label for="nodeAddress" class="al-label">
                  <%- icon('globe', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.adminNodeAddressLabel %>:</label>
                <input id="nodeAddress" class="al-input" placeholder="localhost">
              </div>

              <div>
                <label for="nodePort" class="al-label">
                  <%- icon('plug', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.adminNodePortLabel %>:</label>
                <input id="nodePort" class="al-input" placeholder="3002">
              </div>
            </div>
            <div class="mt-4 flex justify-end">
              <button id="createNodeBtn" type="button" class="al-btn-primary">
                <%= req.translations.create || 'Create' %>
              </button>
                    <%= req.translations.create || 'Create node' %>
                  </button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-node-create.js"></script>

<%- include('../../components/footer') %>