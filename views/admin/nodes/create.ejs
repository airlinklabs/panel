<%- include('../../components/header', { title: 'Create Node' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Nodes', href: '/admin/nodes' },
        { label: 'Create' }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= req.translations.adminCreateNodeTitle %></h1>
          <p class="al-page-desc"><%= req.translations.adminCreateNodeText || 'One more node and you\'ll have a proper fleet going.' %></p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <button id="createNodeBtn" type="button" class="al-btn-primary"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.create || 'Create Node' %></button>
          <a href="/admin/nodes" class="al-btn-secondary">Back to Nodes</a>
        </div>
      </div>

      <div id="nodeForm" class="al-page-body space-y-5">
        <form class="space-y-5">
          <div class="al-card">
            <h2 class="al-card-header">General</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="md:col-span-2">
                <label for="nodeName" class="al-label flex items-center gap-1.5">
                  <%- icon('tag', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.name %>
                </label>
                <input id="nodeName" class="al-input" placeholder="My node">
              </div>

              <div>
                <label for="nodeAddress" class="al-label flex items-center gap-1.5">
                  <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.addressIP %>
                </label>
                <input id="nodeAddress" class="al-input" placeholder="localhost">
              </div>

              <div>
                <label for="nodePort" class="al-label flex items-center gap-1.5">
                  <%- icon('radio-tower', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.daemonPort %>
                </label>
                <input id="nodePort" class="al-input" placeholder="3002">
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Resource Allocation</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <div>
                <label for="nodeRam" class="al-label flex items-center gap-1.5">
                  <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.ram %>
                </label>
                <input type="hidden" id="nodeRamValue" value="">
                <div class="flex gap-2 items-center">
                  <div class="flex items-stretch flex-1 gap-0">
                    <input id="nodeRam" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                    <button type="button" class="al-format-switcher" data-format-switcher
                      data-display="nodeRam" data-hidden="nodeRamValue"
                      data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
                  </div>
                  <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
                    <input type="checkbox" id="nodeRamAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
                  </label>
                </div>
              </div>

              <div>
                <label for="nodeDisk" class="al-label flex items-center gap-1.5">
                  <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.disk %>
                </label>
                <input type="hidden" id="nodeDiskValue" value="">
                <div class="flex gap-2 items-center">
                  <div class="flex items-stretch flex-1 gap-0">
                    <input id="nodeDisk" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                    <button type="button" class="al-format-switcher" data-format-switcher
                      data-display="nodeDisk" data-hidden="nodeDiskValue"
                      data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
                  </div>
                  <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
                    <input type="checkbox" id="nodeDiskAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
                  </label>
                </div>
              </div>

              <div>
                <label for="nodeProcessor" class="al-label flex items-center gap-1.5">
                  <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.cpu %>
                </label>
                <input type="hidden" id="nodeCpuValue" value="">
                <div class="flex gap-2 items-center">
                  <div class="flex items-stretch flex-1 gap-0">
                    <input id="nodeProcessor" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                    <button type="button" class="al-format-switcher" data-format-switcher
                      data-display="nodeProcessor" data-hidden="nodeCpuValue"
                      data-units="1:%,100:Cores" data-default-unit="Cores">Cores</button>
                  </div>
                  <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
                    <input type="checkbox" id="nodeProcessorAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
                  </label>
                </div>
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">1 core = 100%</p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Overallocation</h2>
            <p class="mb-4 text-xs" style="color:var(--theme-text-muted)">Allow servers to exceed node limits by this percentage (0 = strict).</p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <div>
                <label for="nodeOverallocateMemory" class="al-label flex items-center gap-1.5">
                  <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %>
                  Memory %
                </label>
                <input id="nodeOverallocateMemory" type="number" min="0" value="<%= settings.defaultOverallocateMemory ?? 0 %>" class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings.</p>
              </div>
              <div>
                <label for="nodeOverallocateDisk" class="al-label flex items-center gap-1.5">
                  <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %>
                  Disk %
                </label>
                <input id="nodeOverallocateDisk" type="number" min="0" value="<%= settings.defaultOverallocateDisk ?? 0 %>" class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings.</p>
              </div>
              <div>
                <label for="nodeOverallocateCpu" class="al-label flex items-center gap-1.5">
                  <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %>
                  CPU %
                </label>
                <input id="nodeOverallocateCpu" type="number" min="0" value="<%= settings.defaultOverallocateCpu ?? 0 %>" class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings.</p>
              </div>
            </div>
            <div class="mt-4">
              <label for="nodeLocation" class="al-label flex items-center gap-1.5">
                <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %>
                Location
              </label>
              <select id="nodeLocation" class="al-input">
                <option value="">No location</option>
                <% (locations || []).forEach(loc => { %>
                  <option value="<%= loc.id %>"><%= loc.name %> (<%= loc.shortCode %>)</option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Daemon Configuration</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="md:col-span-2">
                <label for="daemonKey" class="al-label"><%= req.translations.daemonKey || 'Daemon Key' %></label>
                <input id="daemonKey" class="al-input" placeholder="Leave blank to auto-generate">
                <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)">Optional. If left blank, a secure key will be generated automatically.</p>
              </div>

              <div class="md:col-span-2">
                <label for="allocatedPorts" class="al-label">Allocated Ports</label>
                <div class="space-y-2">
                  <div id="allocatedPortsList" class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2">
                    <!-- Port tags will be inserted here -->
                  </div>
                  <div class="flex gap-2">
                    <input id="newPortInput" type="text" placeholder="25565 or 25565-25570" class="al-input flex-1">
                    <button id="addPortBtn" type="button" class="al-btn-primary">
                      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                      Add Port
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>

      <div id="nodeSetupPanel" class="hidden">
        <div class="max-w-xl mx-auto">
          <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4" style="background:color-mix(in srgb, var(--theme-success) 12%, transparent); color:var(--theme-success);">
              <%- icon('check-circle', { class: 'size-8', strokeWidth: 1.5 }) %>
            </div>
            <h2 class="text-xl font-semibold" style="color:var(--theme-text-strong);">Node created — one step left</h2>
            <p class="text-sm mt-2 max-w-md mx-auto" style="color:var(--theme-text-muted);">Run this command on the machine where the daemon will run. It connects the daemon to this panel.</p>
          </div>

          <div class="rounded-2xl border p-5" style="border-color:var(--theme-border); background:var(--theme-bg-secondary);">
            <p class="text-xs font-medium mb-3 flex items-center gap-1.5" style="color:var(--theme-text-muted);">
              <%- icon('terminal', { width: 13, height: 13, class: 'shrink-0' }) %>
              Run on the daemon machine
            </p>
            <div class="relative">
              <div id="daemonCliCommand" class="rounded-xl border p-4 pr-12 text-[13px] font-mono whitespace-nowrap overflow-x-auto cursor-text select-all" style="background:var(--theme-bg-input); border-color:var(--theme-border); color:var(--theme-text-strong);" tabindex="0" aria-label="Daemon connect command"></div>
              <button id="copyDaemonCli" type="button" class="absolute top-1/2 -translate-y-1/2 right-2 p-2 rounded-lg transition-colors hover:scale-105" style="color:var(--theme-text-muted);" aria-label="Copy command"><%- icon('copy', { class: 'size-4', strokeWidth: 1.5 }) %></button>
            </div>
            <p id="copyDaemonCliHint" class="mt-2 text-xs" style="color:var(--theme-text-muted);"></p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 mt-6">
            <button id="verifyDaemonBtn" type="button" class="al-btn-primary flex-1 justify-center">
              <%- icon('check', { class: 'size-4', strokeWidth: 1.5 }) %> I've done this — verify connection
            </button>
            <a href="/admin/nodes" class="al-btn-secondary flex-1 justify-center">Back to Nodes</a>
          </div>
          <p id="daemonVerifyResult" class="hidden mt-4 text-sm font-medium text-center"></p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../components/loadingPopup') %>

<style>
#nodeForm .al-card-header { border-radius: 12px 12px 0 0; overflow: hidden; margin-bottom: 16px; }
</style>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-node-create.js?v=5"></script>

<%- include('../../components/footer') %>
