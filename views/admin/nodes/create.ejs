<%- include('../../layouts/admin', { title: t('adminCreateNodeTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbNodes'), url: '/admin/nodes' },
    { label: t('createNode') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('adminCreateNodeTitle') %></h1>
    <p class="al-page-desc"><%= t('adminCreateNodeText') %></p>
  </div>
  <div>
    <button type="button" onclick="createNode()" class="al-btn-primary" id="createNodeBtn">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('createNode') %>
    </button>
    <a href="/admin/nodes" class="al-btn-secondary"><%= t('backToNodes') %></a>
  </div>
</div>

<div id="nodeForm" class="al-page-body space-y-5">
  <form class="space-y-5" onsubmit="event.preventDefault(); createNode();">
    <div class="al-form-card">
      <h2 class="al-card-header"><%= t('general') %></h2>
      <div class="al-card-body grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="md:col-span-2">
          <label for="nodeName" class="al-label flex items-center gap-1.5">
            <%- icon('tag', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('name') %>
          </label>
          <input id="nodeName" class="al-input" placeholder="<%= t('nodeNamePlaceholder') %>" required>
        </div>
        <div>
          <label for="nodeAddress" class="al-label flex items-center gap-1.5">
            <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('nodeAddressLabel') %>
          </label>
          <input id="nodeAddress" class="al-input" placeholder="<%= t('nodeAddressPlaceholder') %>" required>
        </div>
        <div>
          <label for="nodePort" class="al-label flex items-center gap-1.5">
            <%- icon('radio-tower', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('daemonPort') %>
          </label>
          <input id="nodePort" class="al-input" placeholder="3001" type="number" min="1" max="65535" required>
        </div>
      </div>
    </div>

    <div class="al-form-card">
      <h2 class="al-card-header"><%= t('resourceAllocation') %></h2>
      <div class="al-card-body grid grid-cols-1 md:grid-cols-3 gap-5">
        <div>
          <label for="nodeRam" class="al-label flex items-center gap-1.5">
            <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('ram') %>
          </label>
          <input type="hidden" id="nodeRamValue" value="">
          <div class="flex gap-2 items-center">
            <div class="flex items-stretch flex-1 gap-0">
              <input id="nodeRam" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="<%= t('informationalOnly') %>">
              <button type="button" class="al-format-switcher" data-format-switcher
                data-display="nodeRam" data-hidden="nodeRamValue"
                data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
            </div>
            <label class="al-form-check-label flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0">
              <input type="checkbox" id="nodeRamAll" class="al-form-checkbox"> <%= t('all') %>
            </label>
          </div>
        </div>
        <div>
          <label for="nodeDisk" class="al-label flex items-center gap-1.5">
            <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('disk') %>
          </label>
          <input type="hidden" id="nodeDiskValue" value="">
          <div class="flex gap-2 items-center">
            <div class="flex items-stretch flex-1 gap-0">
              <input id="nodeDisk" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="<%= t('informationalOnly') %>">
              <button type="button" class="al-format-switcher" data-format-switcher
                data-display="nodeDisk" data-hidden="nodeDiskValue"
                data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
            </div>
            <label class="al-form-check-label flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0">
              <input type="checkbox" id="nodeDiskAll" class="al-form-checkbox"> <%= t('all') %>
            </label>
          </div>
        </div>
        <div>
          <label for="nodeProcessor" class="al-label flex items-center gap-1.5">
            <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('cpu') %>
          </label>
          <input type="hidden" id="nodeCpuValue" value="">
          <div class="flex gap-2 items-center">
            <div class="flex items-stretch flex-1 gap-0">
              <input id="nodeProcessor" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="<%= t('informationalOnly') %>">
              <button type="button" class="al-format-switcher" data-format-switcher
                data-display="nodeProcessor" data-hidden="nodeCpuValue"
                data-units="1:%,100:Cores" data-default-unit="Cores">Cores</button>
            </div>
            <label class="al-form-check-label flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0">
              <input type="checkbox" id="nodeProcessorAll" class="al-form-checkbox"> <%= t('all') %>
            </label>
          </div>
          <p class="al-form-help"><%= t('coreHint') %></p>
        </div>
      </div>
    </div>

    <div class="al-form-card">
      <h2 class="al-card-header"><%= t('overallocation') %></h2>
      <div class="al-card-body">
        <p class="al-form-help"><%= t('nodeOverallocationDesc') %></p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-4">
          <div>
            <label for="nodeOverallocateMemory" class="al-label flex items-center gap-1.5">
              <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('ram') %> %
            </label>
            <input id="nodeOverallocateMemory" type="number" min="0" value="<%= settings.defaultOverallocateMemory || 0 %>" class="al-input">
            <p class="al-form-help"><%= t('defaultFromGlobalSettings') %></p>
          </div>
          <div>
            <label for="nodeOverallocateDisk" class="al-label flex items-center gap-1.5">
              <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('disk') %> %
            </label>
            <input id="nodeOverallocateDisk" type="number" min="0" value="<%= settings.defaultOverallocateDisk || 0 %>" class="al-input">
            <p class="al-form-help"><%= t('defaultFromGlobalSettings') %></p>
          </div>
          <div>
            <label for="nodeOverallocateCpu" class="al-label flex items-center gap-1.5">
              <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('cpu') %> %
            </label>
            <input id="nodeOverallocateCpu" type="number" min="0" value="<%= settings.defaultOverallocateCpu || 0 %>" class="al-input">
            <p class="al-form-help"><%= t('defaultFromGlobalSettings') %></p>
          </div>
        </div>
        <div class="mt-4">
          <label for="nodeLocation" class="al-label flex items-center gap-1.5">
            <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %> <%= t('location') %>
          </label>
          <select id="nodeLocation" class="al-input">
            <option value=""><%= t('noLocation') %></option>
            <% (locations || []).forEach(function(loc) { %>
            <option value="<%= loc.id %>"><%= loc.name %> (<%= loc.shortCode %>)</option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>

    <div class="al-form-card">
      <h2 class="al-card-header"><%= t('daemonConfiguration') %></h2>
      <div class="al-card-body grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="md:col-span-2">
          <label for="daemonKey" class="al-label"><%= t('daemonKey') %></label>
          <input id="daemonKey" class="al-input" placeholder="<%= t('leaveBlankToAutoGenerate') %>">
          <p class="al-form-help"><%= t('daemonKeyOptionalDesc') %></p>
        </div>
        <div class="md:col-span-2">
          <label for="allocatedPorts" class="al-label"><%= t('allocatedPorts') %></label>
          <div class="space-y-2">
            <div id="allocatedPortsList" class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2"></div>
            <div class="flex gap-2">
              <input id="newPortInput" type="text" placeholder="<%= t('portRangeHint') %>" class="al-input flex-1">
              <button id="addPortBtn" type="button" class="al-btn-primary">
                <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('addPort') %>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<!-- Post-creation setup panel -->
<div id="nodeSetupPanel" class="hidden">
  <div class="max-w-xl mx-auto">
    <div class="text-center mb-8">
      <span class="al-icon-tile al-icon-tile-lg al-icon-tile-round al-icon-tile-success mx-auto mb-4"><%- icon('check-circle', { class: 'size-8', strokeWidth: 1.5 }) %></span>
      <h2 class="text-xl font-semibold al-text-strong"><%= t('nodeCreatedOneStepLeft') %></h2>
      <p class="text-sm mt-2 max-w-md mx-auto al-text-muted"><%= t('nodeCreatedRunCommand') %></p>
    </div>

    <div class="al-panel">
      <p class="text-xs font-medium mb-3 flex items-center gap-1.5 al-text-muted">
        <%- icon('terminal', { width: 13, height: 13, class: 'shrink-0' }) %> <%= t('runOnDaemonMachine') %>
      </p>
      <div class="relative">
        <div id="daemonCliCommand" class="al-code pr-12 cursor-text select-all" tabindex="0" aria-label="<%= t('daemonConnectCommandAria') %>"></div>
        <button id="copyDaemonCli" type="button" class="al-btn-ghost al-btn-icon-only absolute top-1/2 -translate-y-1/2 right-1" aria-label="<%= t('copyCommandAria') %>">
          <%- icon('copy', { class: 'size-4', strokeWidth: 1.5 }) %>
        </button>
      </div>
      <p id="copyDaemonCliHint" class="al-form-help"></p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 mt-6">
      <button id="verifyDaemonBtn" type="button" class="al-btn-primary flex-1 justify-center" onclick="verifyDaemon()">
        <%- icon('check', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('iveDoneThisVerify') %>
      </button>
      <a href="/admin/nodes" class="al-btn-secondary flex-1 justify-center"><%= t('backToNodes') %></a>
    </div>
    <p id="daemonVerifyResult" class="hidden mt-4 text-sm font-medium text-center"></p>
  </div>
</div>

<script nonce="<%- nonce %>">
var csrfToken = '<%= csrfToken %>';
var _currentNode = null;
var _currentCli = '';
var allocatedPorts = [];

function renderAllocatedPorts() {
  var portsList = document.getElementById('allocatedPortsList');
  portsList.innerHTML = '';
  if (allocatedPorts.length === 0) {
    var emptyMessage = document.createElement('div');
    emptyMessage.className = 'col-span-4 al-form-help mt-0';
    emptyMessage.textContent = window.__i18n.noPortsAllocated || 'No ports allocated yet. Add ports that will be available for servers.';
    portsList.appendChild(emptyMessage);
    return;
  }
  allocatedPorts.forEach(function(port) {
    var portTag = document.createElement('div');
    portTag.className = 'al-chip al-chip-mono justify-between w-full';
    portTag.dataset.port = port;
    var portText = document.createElement('span');
    portText.textContent = port;
    var deleteBtn = document.createElement('button');
    deleteBtn.type = 'button';
    deleteBtn.className = 'al-chip-remove';
    deleteBtn.setAttribute('aria-label', (window.__i18n.removePort || 'Remove port') + ' ' + port);
    deleteBtn.innerHTML = '<%- icon("x", { class: "w-3.5 h-3.5", strokeWidth: 1.5 }) %>';
    deleteBtn.onclick = function(e) {
      e.preventDefault();
      allocatedPorts = allocatedPorts.filter(function(p) { return p !== port; });
      renderAllocatedPorts();
    };
    portTag.appendChild(portText);
    portTag.appendChild(deleteBtn);
    portsList.appendChild(portTag);
  });
}

function addPort(input) {
  if (input.indexOf('-') !== -1) {
    var parts = input.split('-').map(function(p) { return parseInt(p.trim()); });
    var start = parts[0], end = parts[1];
    if (isNaN(start) || isNaN(end) || start >= end || start < 1024 || end > 65535) {
      showToast(window.__i18n.invalidPortRange || 'Invalid port range. Use format: 25565-25570 (1024-65535).', 'error');
      return;
    }
    for (var port = start; port <= end; port++) {
      if (allocatedPorts.indexOf(port) === -1) allocatedPorts.push(port);
    }
  } else {
    var port = parseInt(input.trim());
    if (isNaN(port) || port < 1024 || port > 65535) {
      showToast(window.__i18n.invalidPortValue || 'Invalid port. Must be between 1024 and 65535.', 'error');
      return;
    }
    if (allocatedPorts.indexOf(port) === -1) allocatedPorts.push(port);
  }
  allocatedPorts.sort(function(a, b) { return a - b; });
  renderAllocatedPorts();
}

document.getElementById('addPortBtn').addEventListener('click', function() {
  var input = document.getElementById('newPortInput').value.trim();
  if (input) { addPort(input); document.getElementById('newPortInput').value = ''; }
});
document.getElementById('newPortInput').addEventListener('keypress', function(e) {
  if (e.key === 'Enter') { e.preventDefault(); var input = this.value.trim(); if (input) { addPort(input); this.value = ''; } }
});

function gbValue(hiddenId) {
  var hidden = document.getElementById(hiddenId);
  if (hidden) {
    var v = parseFloat(hidden.value);
    if (!hidden.value || isNaN(v)) return '';
    return isFinite(v) ? String(Math.round(v / 1024 * 100) / 100) : '';
  }
  return '';
}

function createNode() {
  var ramAll = document.getElementById('nodeRamAll').checked;
  var diskAll = document.getElementById('nodeDiskAll').checked;
  var cpuAll = document.getElementById('nodeProcessorAll').checked;

  var nodeData = {
    name: document.getElementById('nodeName').value,
    ram: ramAll ? 0 : (parseInt(document.getElementById('nodeRamValue').value) || 0),
    cpu: cpuAll ? 0 : (parseInt(document.getElementById('nodeCpuValue').value) || 0),
    disk: diskAll ? 0 : (parseInt(document.getElementById('nodeDiskValue').value) || 0),
    address: document.getElementById('nodeAddress').value,
    port: parseInt(document.getElementById('nodePort').value) || 3001,
    key: document.getElementById('daemonKey').value.trim() || 'auto',
    allocatedPorts: JSON.stringify(allocatedPorts),
    overallocateMemory: parseInt(document.getElementById('nodeOverallocateMemory').value) || 0,
    overallocateDisk: parseInt(document.getElementById('nodeOverallocateDisk').value) || 0,
    overallocateCpu: parseInt(document.getElementById('nodeOverallocateCpu').value) || 0,
    locationId: document.getElementById('nodeLocation').value ? parseInt(document.getElementById('nodeLocation').value) : null
  };

  if (!nodeData.name || !nodeData.address) {
    showToast(window.__i18n.fillRequiredFields || 'Please fill in all required fields.', 'error');
    return;
  }

  var loader = showProgressToast(window.__i18n.initializingNodeCreation || 'Initializing node creation...');
  loader.setStage(window.__i18n.sendingNodeConfig || 'Sending node configuration...');

  fetch('/admin/nodes/create', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
    body: JSON.stringify(nodeData)
  })
  .then(function(response) {
    if (response.ok) return response.json();
    return response.json().then(function(d) { throw new Error(d.error || d.message || (window.__i18n.failedToCreateNode || 'Failed to create node.')); });
  })
  .then(function(data) {
    loader.complete(true, window.__i18n.nodeCreatedSuccess || 'Node created!');
    _currentNode = data.node;
    var panelUrl = window.location.origin;
    _currentCli = 'configure --panel "' + panelUrl + '" --key "' + data.node.key + '"';
    document.getElementById('nodeForm').classList.add('hidden');
    document.getElementById('nodeSetupPanel').classList.remove('hidden');
    document.getElementById('daemonCliCommand').textContent = _currentCli;
    document.getElementById('copyDaemonCliHint').textContent = window.__i18n.pasteIntoTerminal || 'Paste into a terminal on the machine where the daemon runs.';
  })
  .catch(function(error) {
    loader.close();
    showToast(error.message || (window.__i18n.errorCreatingNode || 'Error creating node. Try again.'), 'error');
  });
}

document.getElementById('copyDaemonCli').addEventListener('click', function() {
  var hint = document.getElementById('copyDaemonCliHint');
  var pasteHint = window.__i18n.pasteIntoTerminal || 'Paste into a terminal on the machine where the daemon runs.';
  function onCopied() {
    hint.textContent = window.__i18n.copied || 'Copied!';
    setTimeout(function() { hint.textContent = pasteHint; }, 2000);
  }
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(_currentCli).then(onCopied);
  } else {
    var ta = document.createElement('textarea');
    ta.value = _currentCli;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    ta.remove();
    onCopied();
  }
});

function verifyDaemon() {
  var node = _currentNode;
  if (!node) return;
  var btn = document.getElementById('verifyDaemonBtn');
  var result = document.getElementById('daemonVerifyResult');
  btn.disabled = true;
  btn.textContent = window.__i18n.checking || 'Checking...';
  result.classList.add('hidden');

  fetch('/admin/node/' + node.id + '/verify', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
  })
  .then(function(res) { return res.json(); })
  .then(function(d) {
    result.classList.remove('hidden');
    if (d.verified) {
      result.style.color = 'var(--theme-success)';
      result.textContent = (window.__i18n.daemonIsLiveResult || 'Daemon is live{version}. Key checks out — servers can now run on this node.')
        .replace('{version}', d.version ? ' (' + d.version + ')' : '');
      showToast(window.__i18n.daemonVerified || 'Daemon verified!', 'success');
      setTimeout(function() { window.location.href = '/admin/nodes?verified=' + node.id; }, 1800);
    } else {
      result.style.color = 'var(--theme-danger)';
      result.textContent = d.error || (window.__i18n.couldNotReachDaemon || 'Could not reach the daemon. Check the address, port, and key.');
    }
  })
  .catch(function() {
    result.classList.remove('hidden');
    result.style.color = 'var(--theme-danger)';
    result.textContent = window.__i18n.verificationFailed || 'Verification failed. Check the address, port, and key, then try again.';
  })
  .finally(function() {
    btn.disabled = false;
    btn.textContent = window.__i18n.iveDoneThisVerify || "I've done this — verify connection";
  });
}

// Initialize
renderAllocatedPorts();

// Resource "All" checkboxes
['nodeRam', 'nodeDisk', 'nodeProcessor'].forEach(function(id) {
  var checkbox = document.getElementById(id + 'All');
  var input = document.getElementById(id);
  if (checkbox && input) {
    checkbox.addEventListener('change', function() {
      input.disabled = this.checked;
      if (this.checked) { input.value = ''; input.dispatchEvent(new Event('input')); }
    });
  }
});
</script>

<%- include('../../layouts/admin-footer') %>
