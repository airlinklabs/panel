<%- include('../../components/header', { title: 'Edit Node' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <!-- Content -->
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12" x-data="nodeEditor()">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Nodes', href: '/admin/nodes' },
        { label: node.name }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= req.translations.adminEditNodeTitle %></h1>
          <p class="al-page-desc"><%= req.translations.adminEditNodeText %></p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <button id="updateNodeBtn" type="button" class="al-btn-primary" @click="updateNode()"><%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.update || 'Save changes' %></button>
          <a href="/admin/nodes" class="al-btn-secondary">Back to Nodes</a>
        </div>
      </div>

      <div id="nodeForm" class="al-page-body space-y-5">
        <form class="space-y-5">
          <div class="al-card">
            <h2 class="al-card-header">General</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="nodeName" class="al-label flex items-center gap-1.5">
                  <%- icon('tag', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.name %>
                </label>
                <input id="nodeName" value="<%= node.name %>" class="al-input" placeholder="My node">
              </div>

              <div>
                <label for="nodeAddress" class="al-label flex items-center gap-1.5">
                  <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.addressIP %>
                </label>
                <input id="nodeAddress" value="<%= node.address %>" class="al-input" placeholder="localhost">
              </div>

              <div>
                <label for="nodePort" class="al-label flex items-center gap-1.5">
                  <%- icon('radio-tower', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.daemonPort %>
                </label>
                <input id="nodePort" value="<%= node.port %>" class="al-input" placeholder="3002">
              </div>

              <div>
                <label for="nodeKey" class="al-label"><%= req.translations.daemonKey %></label>
                <input id="nodeKey" value="" class="al-input" placeholder="Use CLI to retrieve key" disabled>
                <p class="text-xs mt-1" style="color:var(--theme-text-muted)">Key is redacted for security. Use the configure command to view.</p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Resource Allocation</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <div>
                <label for="nodeRam" class="al-label flex items-center gap-1.5">
                  <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.ram %>
                </label>
                <% if (node.ram && isNaN(parseFloat(node.ram))) { %>
                  <input id="nodeRam" value="<%= node.ram %>" class="al-input" placeholder="Informational only">
                <% } else { %>
                  <input type="hidden" id="nodeRamValue" value="<%= node.ram ? Math.round(parseFloat(node.ram) * 1024) : '' %>">
                  <div class="flex items-stretch gap-0">
                    <input id="nodeRam" value="<%= node.ram %>" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                    <button type="button" class="al-format-switcher" data-format-switcher
                      data-display="nodeRam" data-hidden="nodeRamValue"
                      data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
                  </div>
                <% } %>
              </div>

              <div>
                <label for="nodeDisk" class="al-label flex items-center gap-1.5">
                  <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.disk %>
                </label>
                <% if (node.disk && isNaN(parseFloat(node.disk))) { %>
                  <input id="nodeDisk" value="<%= node.disk %>" class="al-input" placeholder="Informational only">
                <% } else { %>
                  <input type="hidden" id="nodeDiskValue" value="<%= node.disk ? Math.round(parseFloat(node.disk) * 1024) : '' %>">
                  <div class="flex items-stretch gap-0">
                    <input id="nodeDisk" value="<%= node.disk %>" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                    <button type="button" class="al-format-switcher" data-format-switcher
                      data-display="nodeDisk" data-hidden="nodeDiskValue"
                      data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
                  </div>
                <% } %>
              </div>

              <div>
                <label for="nodeProcessor" class="al-label flex items-center gap-1.5">
                  <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= req.translations.cpu %>
                </label>
                <input type="hidden" id="nodeCpuValue" value="<%= node.cpu %>">
                <div class="flex items-stretch gap-0">
                  <input id="nodeProcessor" value="" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="nodeProcessor" data-hidden="nodeCpuValue"
                    data-units="1:%,100:Cores" data-default-unit="Cores">Cores</button>
                </div>
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">1 core = 100%</p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Overallocation</h2>
            <p class="mb-4 text-xs" style="color:var(--theme-text-muted)">Allow servers to exceed node limits by this percentage (0 = strict).</p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <div>
                <label for="nodeOverallocateMemory" class="al-label flex items-center gap-1.5">
                  <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %>
                  Memory %
                </label>
                <input id="nodeOverallocateMemory" type="number" min="0" value="<%= node.overallocateMemory || 0 %>" class="al-input">
              </div>
              <div>
                <label for="nodeOverallocateDisk" class="al-label flex items-center gap-1.5">
                  <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %>
                  Disk %
                </label>
                <input id="nodeOverallocateDisk" type="number" min="0" value="<%= node.overallocateDisk || 0 %>" class="al-input">
              </div>
              <div>
                <label for="nodeOverallocateCpu" class="al-label flex items-center gap-1.5">
                  <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %>
                  CPU %
                </label>
                <input id="nodeOverallocateCpu" type="number" min="0" value="<%= node.overallocateCpu || 0 %>" class="al-input">
              </div>
            </div>
            <div class="mt-4">
              <label for="nodeLocation" class="al-label flex items-center gap-1.5">
                <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %>
                Location
              </label>
              <select id="nodeLocation" class="al-input">
                <option value="">No location</option>
                <% (locations || []).forEach(loc => { %>
                  <option value="<%= loc.id %>" <%= node.locationId === loc.id ? 'selected' : '' %>><%= loc.name %> (<%= loc.shortCode %>)</option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header">Allocated Ports</h2>
            <div class="space-y-2">
              <div id="allocatedPortsList" class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2">
                <!-- Port tags will be inserted here -->
              </div>
              <div class="flex gap-2">
                <input id="newPortInput" type="text" placeholder="25565 or 25565-25570" class="al-input flex-1" @keypress.enter.prevent="addPortFromInput()">
                <button id="addPortBtn" type="button" class="al-btn-primary" @click="addPortFromInput()">
                  <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                  Add Port
                </button>
              </div>
            </div>
          </div>
          <div class="al-card">
            <h2 class="al-card-header">Maintenance Mode</h2>
            <div class="p-4 rounded-xl border" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)">Put node into maintenance mode</h3>
                  <p class="text-xs mt-1" style="color:var(--theme-text-muted)">While enabled, no new servers may be created on this node and existing servers cannot be started or restarted.</p>
                </div>
                <label for="nodeMaintenanceMode" class="relative inline-flex items-center cursor-pointer shrink-0">
                  <input id="nodeMaintenanceMode" type="checkbox" class="sr-only peer" <%= node.maintenanceMode ? 'checked' : '' %> aria-label="Put node into maintenance mode">
                  <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
                </label>
              </div>
            </div>
          </div>

        </form>
      </div>

    </div>
  </div>
</main>


<%
  // Compute used ports from servers
  const usedPortsList = [];
  if (node.servers && node.servers.length > 0) {
    node.servers.forEach(function(server) {
      try {
        const ports = JSON.parse(server.Ports);
        ports.forEach(function(portInfo) {
          const port = parseInt(portInfo.Port.split(':')[0]);
          if (!isNaN(port)) usedPortsList.push(port);
        });
      } catch (e) {
        console.warn('[nodes/edit] Failed to parse ports for server', server.id, e);
      }
    });
  }
%>

<div id="page-data" style="display:none"
  data-node-id="<%= node.id %>"
  data-allocated-ports="<%- node.allocatedPorts || '[]' %>"
  data-used-ports="<%= JSON.stringify(usedPortsList) %>"
></div>

<script nonce="<%- nonce %>">
function nodeEditor() {
  return {
    allocatedPorts: [],
    usedPortsSet: new Set(),
    _portEase: getComputedStyle(document.documentElement).getPropertyValue('--ease-standard').trim() || 'ease',
    PORT_MIN: 1024,
    PORT_MAX: 65535,
    PORT_STAGGER_MS: 30,
    PORT_OUT_DURATION_MS: 160,

    init() {
      const pd = document.getElementById('page-data').dataset;
      this.allocatedPorts = JSON.parse(pd.allocatedPorts || '[]');
      this.usedPortsSet = new Set(JSON.parse(pd.usedPorts || '[]'));
      this.renderAllocatedPorts();
    },

    buildPortTag(port, usedPorts) {
      const isUsed = usedPorts.has(port);
      const portTag = document.createElement('div');
      portTag.dataset.port = port;
      portTag.className = 'flex items-center justify-between rounded-lg ' + (isUsed ? 'bg-amber-600/10 dark:bg-amber-700/20' : 'bg-neutral-800/10 dark:bg-neutral-700/20') + ' px-3 py-1.5 text-sm';
      portTag.style.opacity = '0';
      portTag.style.transform = 'translateY(4px)';

      const portText = document.createElement('span');
      portText.className = isUsed ? 'text-amber-600 dark:text-amber-400 flex items-center' : 'text-neutral-800 dark:text-neutral-300';
      if (isUsed) {
        portText.innerHTML = port + ' <span class="ml-2 text-xs bg-amber-600/20 text-amber-600 dark:text-amber-400 px-1.5 py-0.5 rounded">In use</span>';
      } else {
        portText.textContent = port;
      }

      const deleteBtn = document.createElement('button');
      deleteBtn.className = 'ml-2 text-neutral-500 hover:text-red-500 transition-colors';
      deleteBtn.innerHTML = alIcon('x', 'w-4 h-4', { strokeWidth: 1.5 });

      if (isUsed) {
        deleteBtn.disabled = true;
        deleteBtn.title = 'Cannot remove port that is in use by a server';
        deleteBtn.className += ' opacity-50 cursor-not-allowed';
      } else {
        deleteBtn.onclick = (e) => {
          e.preventDefault();
          this.animatePortOut(portTag, () => this.removePort(port));
        };
      }

      portTag.appendChild(portText);
      portTag.appendChild(deleteBtn);
      return portTag;
    },

    animatePortIn(el) {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          el.style.transition = 'opacity 0.18s ' + this._portEase + ', transform 0.18s ' + this._portEase;
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
          setTimeout(() => { el.style.transition = ''; }, 200);
        });
      });
    },

    animatePortOut(el, cb) {
      el.style.transition = 'opacity 0.15s ' + this._portEase + ', transform 0.15s ' + this._portEase;
      el.style.opacity = '0';
      el.style.transform = 'translateY(-4px)';
      setTimeout(cb, this.PORT_OUT_DURATION_MS);
    },

    addPort(input) {
      const usedPorts = this.usedPortsSet;
      if (input.includes('-')) {
        const [start, end] = input.split('-').map(p => parseInt(p.trim()));
        if (isNaN(start) || isNaN(end) || start >= end || start < this.PORT_MIN || end > this.PORT_MAX) {
          showToast('Invalid port range. Format should be start-end (e.g., 25565-25570) with ports between ' + this.PORT_MIN + ' and ' + this.PORT_MAX + '.', 'error');
          return;
        }
        for (let port = start; port <= end; port++) {
          if (!this.allocatedPorts.includes(port)) this.allocatedPorts.push(port);
        }
      } else {
        const port = parseInt(input.trim());
        if (isNaN(port) || port < this.PORT_MIN || port > this.PORT_MAX) {
          showToast('Invalid port. Port must be between ' + this.PORT_MIN + ' and ' + this.PORT_MAX + '.', 'error');
          return;
        }
        if (!this.allocatedPorts.includes(port)) this.allocatedPorts.push(port);
      }

      this.allocatedPorts.sort((a, b) => a - b);

      const portsList = document.getElementById('allocatedPortsList');
      portsList.innerHTML = '';
      this.allocatedPorts.forEach((port, i) => {
        const tag = this.buildPortTag(port, usedPorts);
        portsList.appendChild(tag);
        setTimeout(() => this.animatePortIn(tag), i * this.PORT_STAGGER_MS);
      });
    },

    removePort(port) {
      const usedPorts = this.usedPortsSet;
      if (usedPorts.has(port)) {
        showToast('Cannot remove port that is in use by a server', 'error');
        return;
      }

      this.allocatedPorts = this.allocatedPorts.filter(p => p !== Number(port));
      const portsList = document.getElementById('allocatedPortsList');
      portsList.innerHTML = '';
      if (this.allocatedPorts.length === 0) {
        const emptyMessage = document.createElement('div');
        emptyMessage.className = 'col-span-4 text-sm text-neutral-500 italic';
        emptyMessage.textContent = 'No ports allocated yet. Add ports that will be available for servers.';
        portsList.appendChild(emptyMessage);
        return;
      }
      const used = this.usedPortsSet;
      this.allocatedPorts.forEach((p) => {
        const tag = this.buildPortTag(p, used);
        portsList.appendChild(tag);
        tag.style.opacity = '1';
        tag.style.transform = '';
      });
    },

    addPortFromInput() {
      const input = document.getElementById('newPortInput').value.trim();
      if (input) {
        this.addPort(input);
        document.getElementById('newPortInput').value = '';
      }
    },

    renderAllocatedPorts() {
      const portsList = document.getElementById('allocatedPortsList');
      portsList.innerHTML = '';
      if (this.allocatedPorts.length === 0) {
        const emptyMessage = document.createElement('div');
        emptyMessage.className = 'col-span-4 text-sm text-neutral-500 italic';
        emptyMessage.textContent = 'No ports allocated yet. Add ports that will be available for servers.';
        portsList.appendChild(emptyMessage);
        return;
      }
      const usedPorts = this.usedPortsSet;
      this.allocatedPorts.forEach((port, i) => {
        const tag = this.buildPortTag(port, usedPorts);
        portsList.appendChild(tag);
        setTimeout(() => this.animatePortIn(tag), i * this.PORT_STAGGER_MS);
      });
    },

    gbValue(hiddenId, fallbackId) {
      const hidden = document.getElementById(hiddenId);
      if (hidden) {
        const v = parseFloat(hidden.value);
        if (hidden.value.trim() === '' || isNaN(v)) {
          showToast('Value is required.', 'error');
          return '';
        }
        return isFinite(v) ? String(Math.round(v / 1024 * 100) / 100) : '';
      }
      return document.getElementById(fallbackId).value;
    },

    async updateNode() {
      const pd = document.getElementById('page-data').dataset;
      const maintenanceInput = document.getElementById('nodeMaintenanceMode');
      const maintenanceMode = maintenanceInput ? maintenanceInput.checked : false;

      if (maintenanceInput) {
        try {
          await fetch('/admin/node/' + pd.nodeId + '/maintenance', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ maintenanceMode })
          });
        } catch (err) {
          console.error('Failed to save maintenance mode:', err);
          showToast('Failed to save maintenance mode.', 'error');
        }
      }

      const nodeData = {
        name: document.getElementById('nodeName').value,
        ram: this.gbValue('nodeRamValue', 'nodeRam'),
        cpu: document.getElementById('nodeCpuValue').value,
        disk: this.gbValue('nodeDiskValue', 'nodeDisk'),
        address: document.getElementById('nodeAddress').value,
        port: document.getElementById('nodePort').value,
        allocatedPorts: JSON.stringify(this.allocatedPorts),
        overallocateMemory: document.getElementById('nodeOverallocateMemory').value,
        overallocateDisk: document.getElementById('nodeOverallocateDisk').value,
        overallocateCpu: document.getElementById('nodeOverallocateCpu').value,
        locationId: document.getElementById('nodeLocation').value
      };

      if (!nodeData.ram) { showToast('RAM is required.', 'error'); return; }
      if (!nodeData.disk) { showToast('Disk is required.', 'error'); return; }

      try {
        const response = await fetch('/admin/node/' + pd.nodeId + '/edit', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(nodeData)
        });

        if (response.ok) {
          showToast('Node updated. Looking good.', 'success');
          setTimeout(() => {
            window.location.href = '/admin/nodes?err=none';
          }, 1000);
        } else {
          throw new Error('Failed to update node');
        }
      } catch (error) {
        showToast('Error updating node: ' + error, 'error');
      }
    }
  };
}
</script>

<%- include('../../components/footer') %>
