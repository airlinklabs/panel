<%- include('../../components/header', { title: t('adminDatabasesTitle') }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: req.translations.admin || 'Admin' },
        { label: req.translations.adminDatabasesTitle || 'Databases' }
      ] }) %>
      <%- include('../../components/ui/page-header', {
        title: t('adminDatabasesTitle'),
        description: t('adminDatabasesText'),
        actions: '<a href="/admin/databases/create" class="al-btn-primary inline-flex items-center gap-1.5">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + t('addDatabaseHost') + '</a>'
      }) %>

      <div class="al-page-body">

        <div class="mb-5 grid gap-4 md:grid-cols-2">
          <div class="al-card rounded-xl p-5">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('adminDbAutoHostTitle') %></h3>
                <p class="mt-1 text-xs leading-relaxed" style="color:var(--theme-text-muted)"><%= t('adminDbAutoHostDesc') %></p>
              </div>
              <button type="button" class="al-btn-primary shrink-0" id="autoHostBtn"
                hx-post="/api/v2/admin/databases/auto-host"
                hx-target="#admin-databases-list"
                hx-swap="outerHTML"
                hx-disabled-elt="this"
                hx-indicator="#auto-host-card-status">
                <%- icon('zap', { size: 15 }) %>
                <span class="ml-1.5"><%= req.translations.autoGenerate || 'Auto-generate' %></span>
              </button>
            </div>
            <p id="auto-host-card-status" class="htmx-indicator text-xs mt-2" style="color:var(--theme-text-muted)">Working…</p>
          </div>
          <div class="al-card rounded-xl p-5">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('adminDbAutoBucketTitle') %></h3>
                <p class="mt-1 text-xs leading-relaxed" style="color:var(--theme-text-muted)"><%= t('adminDbAutoBucketDesc') %></p>
              </div>
              <button type="button" class="al-btn-primary shrink-0" id="autoBucketBtn"
                hx-post="/api/v2/admin/databases/auto-bucket"
                hx-swap="none"
                hx-disabled-elt="this"
                hx-indicator="#auto-bucket-card-status">
                <%- icon('zap', { size: 15 }) %>
                <span class="ml-1.5"><%= req.translations.autoGenerate || 'Auto-generate' %></span>
              </button>
            </div>
            <p id="auto-bucket-card-status" class="htmx-indicator text-xs mt-2" style="color:var(--theme-text-muted)">Working…</p>
          </div>
        </div>

        <% if (req.query.err == "none") { %>
          <%- include('../../components/ui/alert', { type: 'success', message: t('databaseHostCreated'), detail: t('databaseHostCreatedDesc') }) %>
        <% } %>
        <% if (req.query.err == "missing_fields") { %>
          <%- include('../../components/ui/alert', { type: 'danger', message: t('missingFields'), detail: t('missingFieldsDesc') }) %>
        <% } %>
        <% if (req.query.err == "create_failed") { %>
          <%- include('../../components/ui/alert', { type: 'danger', message: t('createFailed'), detail: t('createFailedDesc') }) %>
        <% } %>

        <div id="admin-databases-status"></div>
        <%- include('../../fragments/admin/databases/host-list', { hosts }) %>
      </div>
    </div>
  </div>
</main>

<%- include('../../components/footer') %>
