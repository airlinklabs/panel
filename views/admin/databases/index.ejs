<%- include('../../layouts/admin', { title: t('databases') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('databases') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('databaseHostsTitle') %></h1>
    <p class="al-page-desc"><%= t('databaseHostsDesc') %></p>
  </div>
  <div>
    <a href="/admin/databases/create" class="al-btn-primary">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('addDatabaseHost') %>
    </a>
  </div>
</div>

<div class="al-page-body">

  <div class="mb-5 grid gap-4 md:grid-cols-2">
    <div class="al-card">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-sm font-semibold al-text-strong"><%= t('autoGenerateHost') %></h3>
          <p class="mt-1 text-xs leading-relaxed al-text-muted"><%= t('autoGenerateHostDesc') %></p>
        </div>
        <button type="button" class="al-btn-primary shrink-0" onclick="autoHost()">
          <%- icon('zap', { size: 15 }) %>
          <%= t('autoGenerateBtn') %>
        </button>
      </div>
    </div>
    <div class="al-card">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-sm font-semibold al-text-strong"><%= t('autoGenerateBucket') %></h3>
          <p class="mt-1 text-xs leading-relaxed al-text-muted"><%= t('autoGenerateBucketDesc') %></p>
        </div>
        <button type="button" class="al-btn-primary shrink-0" onclick="autoBucket()">
          <%- icon('zap', { size: 15 }) %>
          <%= t('autoGenerateBtn') %>
        </button>
      </div>
    </div>
  </div>

  <% if (hosts.length === 0) { %>
    <%- include('../../partials/empty-state', {
      iconName: 'database',
      title: t('noDatabaseHostsYet'),
      description: t('noDatabaseHostsYetDesc'),
      action: '<a href="/admin/databases/create" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }).toString() + ' ' + t('addDatabaseHost') + '</a>'
    }) %>
  <% } else { %>
  <div class="al-table-wrapper">
    <table class="al-table">
      <colgroup>
        <col style="min-width:160px">
        <col style="min-width:240px">
        <col style="min-width:90px">
        <col style="min-width:140px">
        <col style="min-width:160px">
      </colgroup>
      <thead class="al-table-thead">
        <tr>
          <th scope="col" class="al-table-th"><%= t('name') %></th>
          <th scope="col" class="al-table-th"><%= t('host') %></th>
          <th scope="col" class="al-table-th"><%= t('databases') %></th>
          <th scope="col" class="al-table-th"><%= t('created') %></th>
          <th scope="col" class="al-table-th"><%= t('actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% hosts.forEach(function(host) { %>
        <tr class="al-table-tr" data-host-id="<%= host.id %>">
          <td class="al-table-td">
            <span class="al-table-cell-strong"><%= host.name %></span>
          </td>
          <td class="al-table-td">
            <div class="flex items-center gap-2">
              <span class="al-dot"></span>
              <span class="font-mono text-xs"><%= host.host %>:<%= host.port %></span>
            </div>
            <div class="mt-1 ml-4 text-xs al-text-muted">
              <%= host.username %>
            </div>
            <div class="mt-1 ml-4 text-xs al-text-muted inline-flex items-center gap-1">
              <%- icon('network', { size: 12 }) %>
              <%= host.node ? host.node.name : t('dbHostAnyNode') %>
            </div>
          </td>
          <td class="al-table-td tabular-nums"><%= host._count ? host._count.databases : 0 %></td>
          <td class="al-table-td"><%= new Date(host.createdAt).toLocaleDateString() %></td>
          <td class="al-table-td">
            <div class="flex gap-2 whitespace-nowrap items-center">
              <button type="button" class="al-btn-secondary al-btn-sm" onclick="testConnection(<%= host.id %>, this)">
                <%- icon('play', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('test') %>
              </button>
              <button
                type="button"
                class="al-btn-ghost al-btn-icon-only"
                style="color:var(--theme-danger);"
                aria-label="<%= t('dbHostDeleteAria') %>"
                onclick="deleteHost(<%= host.id %>, <%- JSON.stringify(host.name) %>)">
                <%- icon('trash-2', { size: 16 }) %>
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script nonce="<%- nonce %>">
var csrfToken = <%- JSON.stringify(csrfToken) %>;
var msg = {
  autoHost: <%- JSON.stringify(t('autoGeneratingHost')) %>,
  autoBucket: <%- JSON.stringify(t('autoGeneratingBucket')) %>,
  hostGenerated: <%- JSON.stringify(t('dbHostGenerated')) %>,
  bucketGenerated: <%- JSON.stringify(t('dbHostBucketGenerated')) %>,
  bucketConfigured: <%- JSON.stringify(t('dbHostBucketConfigured')) %>,
  hostFailed: <%- JSON.stringify(t('dbHostAutoFailed')) %>,
  bucketFailed: <%- JSON.stringify(t('dbHostBucketFailed')) %>,
  network: <%- JSON.stringify(t('networkError')) %>,
  testing: <%- JSON.stringify(t('dbHostTesting')) %>,
  testOk: <%- JSON.stringify(t('dbHostTestSuccess')) %>,
  testFail: <%- JSON.stringify(t('dbHostTestFailed')) %>,
  unknown: <%- JSON.stringify(t('dbHostUnknownError')) %>,
  deleteTitle: <%- JSON.stringify(t('dbHostDeleteTitle')) %>,
  deleteBody: <%- JSON.stringify(t('dbHostDeleteConfirm')) %>,
  deleteLabel: <%- JSON.stringify(t('delete')) %>,
  deleting: <%- JSON.stringify(t('deletingHost')) %>,
  deleted: <%- JSON.stringify(t('dbHostDeleted')) %>,
  deleteFailed: <%- JSON.stringify(t('dbHostDeleteFailed')) %>
};

function autoHost() {
  var loader = showProgressToast(msg.autoHost);
  fetch('/admin/databases/auto-host', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success !== false) {
      loader.complete(true, msg.hostGenerated);
      window.location.reload();
    } else {
      loader.close();
      showToast(data.error || data.message || msg.hostFailed, 'error');
    }
  }).catch(function() {
    loader.close();
    showToast(msg.network, 'error');
  });
}

function autoBucket() {
  var loader = showProgressToast(msg.autoBucket);
  fetch('/admin/databases/auto-bucket', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success !== false) {
      loader.complete(true, msg.bucketGenerated);
      showToast(msg.bucketConfigured, 'success');
    } else {
      loader.close();
      showToast(data.error || data.message || msg.bucketFailed, 'error');
    }
  }).catch(function() {
    loader.close();
    showToast(msg.network, 'error');
  });
}

function testConnection(id, btn) {
  var original = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<%- icon("loader", { class: "size-3 animate-spin" }) %> ' + msg.testing;
  fetch('/admin/databases/' + id + '/test', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
  }).then(function(r) { return r.json(); }).then(function(data) {
    var result = data.data || data;
    if (result.connected) {
      showToast(msg.testOk, 'success');
    } else {
      showToast(msg.testFail.replace('{{error}}', result.error || msg.unknown), 'error');
    }
  }).catch(function() {
    showToast(msg.network, 'error');
  }).finally(function() {
    btn.disabled = false;
    btn.innerHTML = original;
  });
}

function deleteHost(id, name) {
  modal.confirm({
    title: msg.deleteTitle,
    body: msg.deleteBody.replace('{{name}}', name),
    danger: true,
    confirmLabel: msg.deleteLabel,
    onConfirm: async function() {
      var loader = showProgressToast(msg.deleting);
      try {
        var res = await fetch('/admin/databases/' + id, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        var data = await res.json();
        if (data.success !== false) {
          loader.complete(true, msg.deleted);
          var row = document.querySelector('[data-host-id="' + id + '"]');
          if (row) row.remove();
          if (document.querySelectorAll('[data-host-id]').length === 0) {
            window.location.reload();
          }
        } else {
          loader.close();
          showToast(data.error || data.message || msg.deleteFailed, 'error');
        }
      } catch(e) {
        loader.close();
        showToast(msg.deleteFailed, 'error');
      }
    }
  });
}
</script>

<%- include('../../layouts/admin-footer') %>
