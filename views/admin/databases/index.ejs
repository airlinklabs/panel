<%- include('../../layouts/admin', { title: 'Databases' }) %>

<%- include('../../partials/flash-messages') %>

<nav aria-label="Breadcrumb" class="al-breadcrumb mb-6">
  <ol class="flex items-center text-sm gap-1">
    <li class="flex items-center">
      <span style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <a href="/admin/overview" class="transition-colors hover:underline" style="color:var(--theme-text-muted);">Admin</a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <span style="color:var(--theme-text);">Databases</span>
    </li>
  </ol>
</nav>

<div class="al-page-header flex items-start justify-between gap-4">
  <div>
    <h1 class="al-page-title">Database Hosts</h1>
    <p class="al-page-desc">Manage database server connections for user-created databases.</p>
  </div>
  <div class="flex gap-2 shrink-0 items-center">
    <a href="/admin/databases/create" class="al-btn-primary">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> Add Database Host
    </a>
  </div>
</div>

<div class="al-page-body">

  <div class="mb-5 grid gap-4 md:grid-cols-2">
    <div class="al-card rounded-xl p-5">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Auto-Generate Host</h3>
          <p class="mt-1 text-xs leading-relaxed" style="color:var(--theme-text-muted)">Automatically configure a database host from available nodes.</p>
        </div>
        <button type="button" class="al-btn-primary shrink-0" onclick="autoHost()">
          <%- icon('zap', { size: 15 }) %>
          <span class="ml-1.5">Auto Generate</span>
        </button>
      </div>
    </div>
    <div class="al-card rounded-xl p-5">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Auto-Generate Bucket</h3>
          <p class="mt-1 text-xs leading-relaxed" style="color:var(--theme-text-muted)">Automatically configure an S3 bucket for database backups.</p>
        </div>
        <button type="button" class="al-btn-primary shrink-0" onclick="autoBucket()">
          <%- icon('zap', { size: 15 }) %>
          <span class="ml-1.5">Auto Generate</span>
        </button>
      </div>
    </div>
  </div>

  <% if (hosts.length === 0) { %>
    <%- include('../../partials/empty-state', {
      iconName: 'database',
      title: 'No database hosts yet',
      description: 'Add a database host to allow users to create databases for their servers.',
      action: '<a href="/admin/databases/create" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }).toString() + ' Add Database Host</a>'
    }) %>
  <% } else { %>
  <div class="overflow-x-auto rounded-xl border" style="border-color:var(--theme-border);box-shadow:var(--theme-shadow-sm)">
    <table class="al-table">
      <colgroup>
        <col style="min-width:160px">
        <col style="min-width:240px">
        <col style="min-width:90px">
        <col style="min-width:140px">
        <col style="min-width:160px">
      </colgroup>
      <thead class="al-table-head">
        <tr>
          <th scope="col" class="al-table-th sm:pl-6">Name</th>
          <th scope="col" class="al-table-th sm:pl-6">Host</th>
          <th scope="col" class="al-table-th sm:pl-6">Databases</th>
          <th scope="col" class="al-table-th sm:pl-6">Created</th>
          <th scope="col" class="al-table-th sm:pl-6">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% hosts.forEach(function(host) { %>
        <tr class="al-table-tr" data-host-id="<%= host.id %>">
          <td class="al-table-td sm:pl-6">
            <div class="font-medium" style="color:var(--theme-text-strong);"><%= host.name %></div>
          </td>
          <td class="al-table-td">
            <div class="flex items-center gap-2">
              <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background:var(--theme-text-placeholder); border:2px solid var(--theme-bg-card);"></span>
              <span><%= host.host %>:<%= host.port %></span>
            </div>
            <div class="mt-1 ml-2 inline-flex items-center rounded-md px-2 py-1 text-xs font-medium" style="color:var(--theme-text-muted)">
              <%= host.username %>
            </div>
            <div class="mt-1 ml-2 inline-flex items-center rounded-md px-2 py-1 text-xs font-medium" style="color:var(--theme-text-muted)">
              <%- icon('network', { size: 12, class: 'mr-1' }) %>
              <%= host.node ? host.node.name : 'Any node' %>
            </div>
          </td>
          <td class="al-table-td"><%= host._count ? host._count.databases : 0 %></td>
          <td class="al-table-td"><%= new Date(host.createdAt).toLocaleDateString() %></td>
          <td class="al-table-td">
            <div class="flex gap-3 whitespace-nowrap">
              <button type="button" class="al-btn-secondary text-xs" onclick="testConnection(<%= host.id %>, this)">
                <%- icon('play', { class: 'size-3', strokeWidth: 1.5 }) %> Test
              </button>
              <button
                type="button"
                class="al-btn-ghost"
                style="color:var(--theme-danger);"
                aria-label="Delete host"
                onclick="deleteHost(<%= host.id %>, '<%= host.name.replace(/'/g, "\\'") %>')">
                <%- icon('trash-2', { size: 16 }) %>
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script nonce="<%- nonce %>">
var csrfToken = '<%= csrfToken %>';

function autoHost() {
  var loader = showProgressToast('Auto-generating host...');
  fetch('/admin/databases/auto-host', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success !== false) {
      loader.complete(true, 'Host generated.');
      window.location.reload();
    } else {
      loader.close();
      showToast(data.error || data.message || 'Failed to auto-generate host.', 'error');
    }
  }).catch(function() {
    loader.close();
    showToast('Network error.', 'error');
  });
}

function autoBucket() {
  var loader = showProgressToast('Auto-generating bucket...');
  fetch('/admin/databases/auto-bucket', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success !== false) {
      loader.complete(true, 'Bucket generated.');
      showToast('Bucket configured.', 'success');
    } else {
      loader.close();
      showToast(data.error || data.message || 'Failed to auto-generate bucket.', 'error');
    }
  }).catch(function() {
    loader.close();
    showToast('Network error.', 'error');
  });
}

function testConnection(id, btn) {
  var original = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<%- icon("loader", { class: "size-3 animate-spin" }) %> Testing...';
  fetch('/admin/databases/' + id + '/test', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
  }).then(function(r) { return r.json(); }).then(function(data) {
    var result = data.data || data;
    if (result.connected) {
      showToast('Connection successful.', 'success');
    } else {
      showToast('Connection failed: ' + (result.error || 'Unknown error'), 'error');
    }
  }).catch(function() {
    showToast('Network error.', 'error');
  }).finally(function() {
    btn.disabled = false;
    btn.innerHTML = original;
  });
}

function deleteHost(id, name) {
  modal.confirm({
    title: 'Delete Database Host',
    body: 'Are you sure you want to delete "' + name + '"? All databases on this host will be lost.',
    danger: true,
    confirmLabel: 'Delete',
    onConfirm: async function() {
      var loader = showProgressToast('Deleting host...');
      try {
        var res = await fetch('/admin/databases/' + id, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        var data = await res.json();
        if (data.success !== false) {
          loader.complete(true, 'Host deleted.');
          var row = document.querySelector('[data-host-id="' + id + '"]');
          if (row) row.remove();
          if (document.querySelectorAll('[data-host-id]').length === 0) {
            window.location.reload();
          }
        } else {
          loader.close();
          showToast(data.error || data.message || 'Failed to delete host.', 'error');
        }
      } catch(e) {
        loader.close();
        showToast('Failed to delete host.', 'error');
      }
    }
  });
}
</script>

<%- include('../../layouts/admin-footer') %>
