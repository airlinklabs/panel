<%- include('../../layouts/admin', { title: t('addDatabaseHost') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('databases'), url: '/admin/databases' },
    { label: t('addDatabaseHost') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('addDatabaseHost') %></h1>
    <p class="al-page-desc"><%= t('addDatabaseHostDesc') %></p>
  </div>
  <div>
    <a href="/admin/databases" class="al-btn-secondary"><%= t('backToDatabases') %></a>
  </div>
</div>

<div class="al-page-body space-y-5">
  <div id="dbError" class="al-alert-danger hidden" role="alert"></div>

  <form id="hostForm" class="al-card space-y-5">
    <h2 class="al-card-header"><span class="al-card-header-title"><%= t('databaseConnection') %></span></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="md:col-span-2">
        <label for="hostName" class="al-form-label flex items-center gap-1.5">
          <%- icon('tag', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('dbHostName') %>
        </label>
        <input id="hostName" class="al-form-input" placeholder="<%= t('dbHostNamePlaceholder') %>" required>
      </div>

      <div>
        <label for="hostAddress" class="al-form-label flex items-center gap-1.5">
          <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('hostAddress') %>
        </label>
        <input id="hostAddress" class="al-form-input" placeholder="<%= t('dbHostAddressPlaceholder') %>" required>
      </div>

      <div>
        <label for="hostPort" class="al-form-label flex items-center gap-1.5">
          <%- icon('radio-tower', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('port') %>
        </label>
        <input id="hostPort" class="al-form-input" placeholder="5432" type="number">
      </div>

      <div>
        <label for="hostUser" class="al-form-label flex items-center gap-1.5">
          <%- icon('user', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('username') %>
        </label>
        <input id="hostUser" class="al-form-input" placeholder="postgres" autocomplete="off" required>
      </div>

      <div>
        <label for="hostPassword" class="al-form-label flex items-center gap-1.5">
          <%- icon('lock', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('password') %>
        </label>
        <input id="hostPassword" type="password" class="al-form-input" placeholder="••••••••" autocomplete="new-password" required>
      </div>

      <div class="md:col-span-2">
        <label for="hostNode" class="al-form-label flex items-center gap-1.5">
          <%- icon('network', { width: 14, height: 14, class: 'shrink-0' }) %>
          <%= t('node') %>
        </label>
        <select id="hostNode" class="al-form-select">
          <option value=""><%= t('dbHostAnyNodeUnscoped') %></option>
          <% (nodes || []).forEach(function(n) { %>
            <option value="<%= n.id %>"><%= n.name %></option>
          <% }); %>
        </select>
        <p class="al-form-help"><%= t('dbHostNodeHelp') %></p>
      </div>
    </div>

    <div class="flex justify-end gap-2 pt-2">
      <a href="/admin/databases" class="al-btn-secondary"><%= t('cancel') %></a>
      <button type="submit" id="hostSubmit" class="al-btn-primary">
        <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
        <span id="hostSubmitText"><%= t('saveHost') %></span>
      </button>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
var csrfToken = <%- JSON.stringify(csrfToken) %>;
(function() {
  var form = document.getElementById('hostForm');
  var errEl = document.getElementById('dbError');
  var submitBtn = document.getElementById('hostSubmit');
  var submitText = document.getElementById('hostSubmitText');
  var messages = {
    required: <%- JSON.stringify(t('errorAllFieldsRequired')) %>,
    saving: <%- JSON.stringify(t('saving')) %>,
    created: <%- JSON.stringify(t('databaseHostCreated')) %>,
    createFailed: <%- JSON.stringify(t('dbHostCreateFailed')) %>,
    network: <%- JSON.stringify(t('networkError')) %>,
    submit: <%- JSON.stringify(t('saveHost')) %>
  };
  var saving = false;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (saving) return;

    var name = document.getElementById('hostName').value.trim();
    var host = document.getElementById('hostAddress').value.trim();
    var port = parseInt(document.getElementById('hostPort').value) || 5432;
    var username = document.getElementById('hostUser').value.trim();
    var password = document.getElementById('hostPassword').value;
    var nodeId = document.getElementById('hostNode').value;

    if (!name || !host || !username || !password) {
      errEl.textContent = messages.required;
      errEl.classList.remove('hidden');
      return;
    }

    errEl.classList.add('hidden');
    saving = true;
    submitBtn.disabled = true;
    submitText.textContent = messages.saving;

    fetch('/admin/databases/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      body: JSON.stringify({ name: name, host: host, port: port, username: username, password: password, nodeId: nodeId || undefined }),
    }).then(function(res) {
      if (res.redirected || res.ok) {
        showToast(messages.created, 'success');
        window.location.href = '/admin/databases';
      } else {
        return res.json().catch(function() { return { error: messages.createFailed }; }).then(function(data) {
          errEl.textContent = data.error || data.message || messages.createFailed;
          errEl.classList.remove('hidden');
        });
      }
    }).catch(function() {
      errEl.textContent = messages.network;
      errEl.classList.remove('hidden');
    }).finally(function() {
      saving = false;
      submitBtn.disabled = false;
      submitText.textContent = messages.submit;
    });
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
