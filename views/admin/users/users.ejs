<%- include('../../components/header', { title: req.translations.adminUsersTitle || 'Users' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/template') %>
    </div>
    <!-- Content -->
    <div id="page-content" class="flex-1 overflow-y-auto pt-16">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin', href: '/admin' },
        { label: 'Users' }
      ] }) %>
      <%- include('../../components/ui/page-header', {
        title: req.translations.adminUsersTitle,
        description: req.translations.adminUsersText,
        actions: '<button id="createButton" type="button" class="al-btn-primary">' + req.translations.createNewUser + '</button>'
      }) %>

      <div class="al-page-body">

        <div id="stats" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div class="al-card">
            <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);"><%= req.translations.totalUsers %></h2>
            <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);"><%= users.length %></p>
            <% if (onlineUsers.size > 0) { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.onlineUsers || 'Online Users' %>: <%= onlineUsers.size %></p>
            <% } else { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.noUsersOnline || 'No Users Online' %></p>
            <% } %>
          </div>
          <div class="al-card">
            <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);"><%= req.translations.admins || 'Admins' %></h2>
              <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);"><%= users.filter(user => user.isAdmin).length %></p>
              <% if (onlineUsers.size > 0) { %>
                <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.onlineUsers || 'Online Admins' %>: <%= Array.from(onlineUsers).filter(username => users.some(user => user.username === username && user.isAdmin)).length %></p>
              <% } else { %>
                <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= req.translations.noUsersOnline || 'No Users Online' %></p>
              <% } %>
          </div>
        </div>

        <!-- notifications -->
        <% if (req.query.err == "none") { %>
          <%- include('../../components/ui/alert', { type: 'success', message: req.translations.success + '!', detail: req.translations.actionCompleted }) %>
        <% } %>

        <% if (users.length === 0) { %>
          <%- include('../../components/ui/empty-state', {
            iconName: 'users',
            title: req.translations.noUsersYet || 'No users yet',
            description: 'Create your first user to get started.',
            action: '<button id="createButtonEmpty" type="button" class="al-btn-primary"><span class="inline-flex items-center gap-1.5">' + icon('plus', { class: 'w-4 h-4' }) + ' Create user</span></button>'
          }) %>
        <% } else { %>

        <!-- Mobile card view -->
        <div class="lg:hidden space-y-2 mb-6">
          <% users.forEach(function(user) { %>
          <div class="al-card flex items-center gap-3">
            <div class="relative shrink-0">
              <img class="w-8 h-8 rounded-lg object-cover" src="<%= user.avatar ? user.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(user.username) %>" alt="<%= user.username %>">
              <% if (onlineUsers.has(user.username)) { %>
                <span class="absolute -bottom-0.5 -right-0.5 flex h-2.5 w-2.5">
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background:var(--theme-success); border:2px solid var(--theme-bg-card);"></span>
                </span>
              <% } else { %>
                <span class="absolute -bottom-0.5 -right-0.5 flex h-2.5 w-2.5">
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background:var(--theme-text-placeholder); border:2px solid var(--theme-bg-card);"></span>
                </span>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong);"><%= user.username %></p>
              <p class="text-xs truncate" style="color:var(--theme-text-muted);"><span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium ring-1 ring-inset <%= user.isAdmin ? 'bg-emerald-600/10 text-emerald-600 dark:text-emerald-400 ring-emerald-600/20' : 'bg-amber-600/10 text-amber-600 dark:text-amber-400 ring-amber-600/20' %>"><%= user.isAdmin ? 'Admin' : 'User' %></span></p>
            </div>
            <div class="flex items-center gap-2">
              <a href="/admin/users/view/<%= user.id %>/" class="al-btn-ghost" aria-label="View user"><%- icon('external-link', { size: 16 }) %></a>
              <a href="/admin/users/edit/<%= user.id %>/" class="al-btn-ghost" aria-label="Edit user"><%- icon('pencil', { size: 16 }) %></a>
              <button onclick="deleteUser('<%= user.id %>')" type="button" class="al-btn-ghost" style="color:var(--theme-danger);" aria-label="Delete user">
                <%- icon('trash-2', { size: 16 }) %>
              </button>
            </div>
          </div>
          <% }); %>
        </div>

        <!-- Desktop table -->
        <div class="hidden lg:block overflow-x-auto shadow-sm rounded-xl border" id="userTable" style="border-color:var(--theme-border);">
          <table class="al-table">
            <thead class="al-table-head">
              <tr>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.name %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.role %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.servers || 'Servers' %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.actions %></th>
              </tr>
            </thead>
            <tbody>
              <% let userIdx = 0; users.forEach(function(user) { %>
                <tr style="--i:<%= userIdx++ %>" class="al-table-tr cursor-pointer" tabindex="0" role="link" onclick="handleRowClick(event, '/admin/users/view/<%= user.id %>/')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();handleRowClick(event, '/admin/users/view/<%= user.id %>/');}">
                  <td class="al-table-td sm:pl-6">
                    <div class="flex items-center gap-3">
                      <div class="relative shrink-0">
                        <img class="h-8 w-8 rounded-lg object-cover" src="<%= user.avatar ? user.avatar : 'https://api.dicebear.com/9.x/thumbs/svg?seed=' + encodeURIComponent(user.username) %>" alt="<%= user.username %>">
                        <% if (onlineUsers.has(user.username)) { %>
                          <span class="absolute -bottom-0.5 -right-0.5 flex h-2.5 w-2.5">
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background:var(--theme-success); border:2px solid var(--theme-bg-card);"></span>
                          </span>
                        <% } else { %>
                          <span class="absolute -bottom-0.5 -right-0.5 flex h-2.5 w-2.5">
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background:var(--theme-text-placeholder); border:2px solid var(--theme-bg-card);"></span>
                          </span>
                        <% } %>
                      </div>
                      <div class="font-medium" style="color:var(--theme-text-strong);"><%= user.username %></div>
                    </div>
                  </td>
                  <td class="al-table-td">
                    <div class="mt-1 ml-2 inline-flex items-center rounded-md
                    <%= user.isAdmin ? 'bg-emerald-600/10 text-emerald-600 dark:text-emerald-400 ring-emerald-600/20' : 'bg-amber-600/10 text-amber-600 dark:text-amber-400 ring-amber-600/20' %>
                    px-2 py-1 text-xs font-medium ring-1 ring-inset">
                      <%= user.isAdmin ? 'Admin' : 'User' %>
                    </div></td>
                  <td class="al-table-td"><%= user.servers ? user.servers.length : 0 %></td>
                  <td class="al-table-td">
                    <div class="flex gap-3">
                      <a href="/admin/users/view/<%= user.id %>/" class="al-btn-secondary text-xs">View</a>
                      <a href="/admin/users/edit/<%= user.id %>/" class="al-btn-primary text-xs">Edit</a>
                      <button onclick="deleteUser('<%= user.id %>')" type="button" class="al-btn-ghost" style="color:var(--theme-danger);" aria-label="Delete user">
                        <%- icon('trash-2', { size: 16 }) %>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../../components/toast')%>

<div id="page-data" style="display:none"
  data-delete-user-title="<%= req.translations.deleteUser || 'Delete User' %>"
  data-delete-user-body="<%= req.translations.areYouSureDeleteUser || 'Are you sure you want to delete this user?' %>"
></div>

<script nonce="<%- nonce %>">
  document.addEventListener('DOMContentLoaded', function() {
    var emptyBtn = document.getElementById('createButtonEmpty');
    if (emptyBtn) {
      emptyBtn.addEventListener('click', function() {
        window.location.href = '/admin/users/create';
      });
    }
  });
</script>
<script nonce="<%- nonce %>" src="/javascript/admin/admin-users-users.js"></script>

<%- include('../../components/footer') %>
