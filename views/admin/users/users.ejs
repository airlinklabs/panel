<%- include('../../components/header', { title: req.translations.adminUsersTitle || 'Users' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <!-- Content -->
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Users' }
      ] }) %>
      <%- include('../../components/ui/page-header', {
        title: req.translations.adminUsersTitle,
        description: req.translations.adminUsersText,
        actions: '<button id="createButton" type="button" class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + req.translations.createNewUser + '</button>'
      }) %>

      <div class="al-page-body">

        <div id="stats" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
          <div class="al-card p-4">
            <h2 class="text-[11px] font-medium uppercase tracking-wide mb-1.5" style="color:var(--theme-text-muted);"><%= req.translations.totalUsers %></h2>
            <p class="text-xl font-semibold tabular-nums" style="color:var(--theme-text-strong);" id="totalUsersCount"><%= users.length %></p>
            <% if (onlineUsers.size > 0) { %>
              <p class="text-[11px] mt-1" style="color:var(--theme-text-muted);"><%= req.translations.onlineUsers || 'Online Users' %>: <%= onlineUsers.size %></p>
            <% } else { %>
              <p class="text-[11px] mt-1" style="color:var(--theme-text-muted);"><%= req.translations.noUsersOnline || 'No Users Online' %></p>
            <% } %>
          </div>
          <div class="al-card p-4">
            <h2 class="text-[11px] font-medium uppercase tracking-wide mb-1.5" style="color:var(--theme-text-muted);"><%= req.translations.admins || 'Admins' %></h2>
              <p class="text-xl font-semibold tabular-nums" style="color:var(--theme-text-strong);" id="adminUsersTotal"><%= users.filter(user => user.isAdmin).length %></p>
              <% if (onlineUsers.size > 0) { %>
                <p class="text-[11px] mt-1" style="color:var(--theme-text-muted);"><%= req.translations.onlineUsers || 'Online Admins' %>: <%= Array.from(onlineUsers).filter(username => users.some(user => user.username === username && user.isAdmin)).length %></p>
              <% } else { %>
                <p class="text-[11px] mt-1" style="color:var(--theme-text-muted);"><%= req.translations.noUsersOnline || 'No Users Online' %></p>
              <% } %>
          </div>
        </div>

        <!-- notifications -->
        <% if (req.query.err == "none") { %>
          <%- include('../../components/ui/alert', { type: 'success', message: req.translations.success + '!', detail: req.translations.actionCompleted }) %>
        <% } %>

        <% if (users.length === 0) { %>
          <%- include('../../components/ui/empty-state', {
            iconName: 'users',
            title: req.translations.noUsersYet || 'No users yet',
            description: 'Create your first user to get started.',
            action: '<button id="createButtonEmpty" type="button" class="al-btn-primary"><span class="inline-flex items-center gap-1.5">' + icon('plus', { class: 'w-3.5 h-3.5' }) + ' Create user</span></button>'
          }) %>
        <% } else { %>

        <!-- Mobile card view -->
        <div class="lg:hidden space-y-1.5 mb-5">
          <% users.forEach(function(user) { %>
          <div class="al-card flex items-center gap-2.5" data-user-id="<%= user.id %>" data-admin="<%= user.isAdmin %>">
            <div class="relative shrink-0">
              <img loading="lazy" decoding="async" class="w-7 h-7 rounded-lg object-cover" src="<%= user.avatar ? user.avatar : '/avatar/' + encodeURIComponent(user.username) %>" alt="<%= user.username %>">
              <% if (onlineUsers.has(user.username)) { %>
                <span class="absolute -bottom-0.5 -right-0.5 flex h-2 w-2">
                  <span class="relative inline-flex rounded-full h-2 w-2" style="background:var(--theme-success); border:2px solid var(--theme-bg-card);"></span>
                </span>
              <% } else { %>
                <span class="absolute -bottom-0.5 -right-0.5 flex h-2 w-2">
                  <span class="relative inline-flex rounded-full h-2 w-2" style="background:var(--theme-text-placeholder); border:2px solid var(--theme-bg-card);"></span>
                </span>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-[13px] font-medium truncate" style="color:var(--theme-text-strong);"><%= user.username %></p>
              <p class="text-[11px] truncate" style="color:var(--theme-text-muted);"><span class="inline-flex items-center rounded-md px-1.5 py-0.5 text-[10px] font-medium ring-1 ring-inset"
                style="<%= user.isAdmin ? 'background:var(--theme-accent);color:var(--theme-accent-text)' : 'background:var(--theme-bg-secondary);color:var(--theme-text-muted)' %>"><%= user.isAdmin ? (req.translations.admin || 'Admin') : (req.translations.user || 'User') %></span></p>
            </div>
            <div class="flex items-center gap-1">
              <a href="/admin/users/view/<%= user.id %>/" class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="View user"><%- icon('external-link', { size: 16, class: 'shrink-0' }) %></a>
              <a href="/admin/users/edit/<%= user.id %>/" class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Edit user"><%- icon('pencil', { size: 16, class: 'shrink-0' }) %></a>
              <button @click="deleteUser('<%= user.id %>')" type="button" class="al-btn-ghost p-2 min-w-[44px] min-h-[44px] flex items-center justify-center" style="color:var(--theme-danger);" aria-label="Delete user">
                <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
              </button>
            </div>
          </div>
          <% }); %>
        </div>

        <!-- Desktop table -->
        <div class="hidden lg:block overflow-x-auto shadow-sm rounded-xl border" id="userTable" style="border-color:var(--theme-border);">
          <table class="al-table">
            <colgroup>
              <col style="min-width:220px">
              <col style="min-width:100px">
              <col style="min-width:80px">
              <col style="min-width:200px">
            </colgroup>
            <thead class="al-table-head">
              <tr>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.name %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.role %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.servers || 'Servers' %></th>
                <th scope="col" class="al-table-th sm:pl-6"><%= req.translations.actions %></th>
              </tr>
            </thead>
            <tbody>
              <% let userIdx = 0; users.forEach(function(user) { %>
                <tr style="--i:<%= userIdx++ %>" class="al-table-tr cursor-pointer" tabindex="0" role="link" data-user-id="<%= user.id %>" data-admin="<%= user.isAdmin %>" @click="handleRowClick(event, '/admin/users/view/<%= user.id %>/')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();handleRowClick(event, '/admin/users/view/<%= user.id %>/');}">
                  <td class="al-table-td sm:pl-6">
                    <div class="flex items-center gap-2">
                      <div class="relative shrink-0">
                        <img loading="lazy" decoding="async" class="h-7 w-7 rounded-lg object-cover" src="<%= user.avatar ? user.avatar : '/avatar/' + encodeURIComponent(user.username) %>" alt="<%= user.username %>">
                        <% if (onlineUsers.has(user.username)) { %>
                          <span class="absolute -bottom-0.5 -right-0.5 flex h-2 w-2">
                            <span class="relative inline-flex rounded-full h-2 w-2" style="background:var(--theme-success); border:2px solid var(--theme-bg-card);"></span>
                          </span>
                        <% } else { %>
                          <span class="absolute -bottom-0.5 -right-0.5 flex h-2 w-2">
                            <span class="relative inline-flex rounded-full h-2 w-2" style="background:var(--theme-text-placeholder); border:2px solid var(--theme-bg-card);"></span>
                          </span>
                        <% } %>
                      </div>
                      <div class="font-medium text-[13px]" style="color:var(--theme-text-strong);"><%= user.username %></div>
                    </div>
                  </td>
                  <td class="al-table-td">
                    <div class="mt-1 ml-2 inline-flex items-center rounded-md
                    px-1.5 py-0.5 text-[11px] font-medium ring-1 ring-inset"
                    style="<%= user.isAdmin ? 'background:var(--theme-success-bg);color:var(--theme-success)' : 'background:var(--theme-bg-secondary);color:var(--theme-text-muted)' %>">
                      <%= user.isAdmin ? 'Admin' : 'User' %>
                    </div></td>
                  <td class="al-table-td text-[13px]"><%= user.servers ? user.servers.length : 0 %></td>
                  <td class="al-table-td">
                    <div class="flex items-center gap-1">
                      <a href="/admin/users/view/<%= user.id %>/" onclick="event.stopPropagation()" title="View" aria-label="View user"
                        class="al-btn-ghost p-1.5 min-w-[36px] min-h-[36px] flex items-center justify-center">
                        <%- icon('external-link', { size: 14, class: 'shrink-0' }) %>
                      </a>
                      <a href="/admin/users/edit/<%= user.id %>/" onclick="event.stopPropagation()" title="Edit" aria-label="Edit user"
                        class="al-btn-ghost p-1.5 min-w-[36px] min-h-[36px] flex items-center justify-center">
                        <%- icon('pencil', { size: 14, class: 'shrink-0' }) %>
                      </a>
                      <button @click="event.stopPropagation(); deleteUser('<%= user.id %>')" type="button" title="Delete" aria-label="Delete user"
                        class="al-btn-ghost p-1.5 min-w-[36px] min-h-[36px] flex items-center justify-center" style="color:var(--theme-danger);">
                        <%- icon('trash-2', { size: 14, class: 'shrink-0' }) %>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</main>


<div id="page-data" style="display:none"
  data-delete-user-title="<%= req.translations.deleteUser || 'Delete User' %>"
  data-delete-user-body="<%= req.translations.areYouSureDeleteUser || 'Are you sure you want to delete this user?' %>"
></div>

<script nonce="<%- nonce %>">
  const emptyBtn = document.getElementById('createButtonEmpty');
  if (emptyBtn) {
    emptyBtn.addEventListener('click', function() {
      window.location.href = '/admin/users/create';
    });
  }
</script>
<script nonce="<%- nonce %>" src="/javascript/admin/admin-users-users.js?v=5"></script>

<%- include('../../components/footer') %>
