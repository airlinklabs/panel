<%- include('../../components/header', { title: 'Overview' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Users', href: '/admin/users' },
        { label: req.translations.adminUserTitle || 'User' }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= req.translations.adminUserTitle %></h1>
          <p class="al-page-desc"><%= req.translations.adminUserText %></p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <a href="/admin/users/edit/<%= dataUser.id %>" class="al-btn-primary">
            <%- icon('pencil', { size: 16 }) %>
            <%= req.translations.editUser || 'Edit User' %>
          </a>
        </div>
      </div>
      <div class="al-page-body">
         <!-- User details will be displayed here -->
         <div class="rounded-xl p-6 shadow-lg border" style="background:var(--theme-bg-card);border-color:var(--theme-border)">
           <div class="flex items-center gap-4 mb-6 pb-6 border-b" style="border-color:var(--theme-border)">
             <img class="h-16 w-16 rounded-xl object-cover shrink-0 border" style="border-color:var(--theme-border)" src="<%= dataUser.avatar ? dataUser.avatar : '/avatar/' + encodeURIComponent(dataUser.username) %>" alt="<%= dataUser.username %>">
             <div>
                <p class="text-base font-semibold" style="color:var(--theme-text-strong)"><%= dataUser.username %></p>
                <p class="text-sm" style="color:var(--theme-text-muted)"><%= dataUser.email %></p>
             </div>
           </div>
           <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
             <div>
               <h2 class="text-lg font-medium border-b pb-2 mb-4" style="color:var(--theme-text-strong);border-color:var(--theme-border)">
                 <%= req.translations.userInformation || 'User Information' %>
               </h2>
               <div class="space-y-4">
                 <div>
                    <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= req.translations.username || 'Username' %></p>
                    <p class="mt-1 text-base font-medium" style="color:var(--theme-text-strong)"><%= dataUser.username %></p>
                 </div>
                 <div>
                    <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= req.translations.email || 'Email' %></p>
                    <p class="mt-1 text-base font-medium" style="color:var(--theme-text-strong)"><%= dataUser.email %></p>
                 </div>
                 <div>
                    <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= req.translations.role || 'Role' %></p>
                   <p class="mt-1">
                     <% const roleLabel = dataUser.role || (dataUser.isAdmin ? 'admin' : 'user'); %>
                     <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset
                       <%= ['owner','admin'].includes(roleLabel) ? '' : roleLabel === 'privileged' ? '' : '' %>"
                       style="<%= ['owner','admin'].includes(roleLabel) ? 'background:var(--theme-success-bg);color:var(--theme-success)' : roleLabel === 'privileged' ? 'background:var(--theme-info-bg);color:var(--theme-info)' : 'background:var(--theme-warning-bg);color:var(--theme-warning)' %>">
                       <%= roleLabel.charAt(0).toUpperCase() + roleLabel.slice(1) %>
                     </span>
                   </p>
                 </div>
                 <div>
                    <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= req.translations.description || 'Description' %></p>
                    <p class="mt-1 text-base font-medium" style="color:var(--theme-text-strong)"><%= dataUser.description || 'No description provided' %></p>
                 </div>
               </div>
             </div>
             <div>
               <h2 class="text-lg font-medium border-b pb-2 mb-4" style="color:var(--theme-text-strong);border-color:var(--theme-border)">
                 <%= req.translations.serverInformation || 'Server Information' %>
               </h2>
               <div class="space-y-4">
                 <div>
                    <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= req.translations.totalServers || 'Total Servers' %></p>
                    <p class="mt-1 text-base font-medium" style="color:var(--theme-text-strong)"><%= dataUser.servers ? dataUser.servers.length : 0 %></p>
                 </div>
               </div>
             </div>
           </div>
         </div>
       </div>
    </div>
  </div>
</main>
<%- include('../../components/footer') %>