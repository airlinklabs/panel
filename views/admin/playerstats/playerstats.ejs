<%- include('../../components/header', { title: 'Player Statistics' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <!-- Content -->
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12" x-data="playerStats()">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Player Statistics' }
      ] }) %>
      <div class="px-8 pt-4">
        <%- include('../../components/ui/page-header', {
          title: 'Player Statistics',
          description: 'View player statistics across all Minecraft servers',
          actions: '<button type="button" id="refreshBtn" class="al-btn-secondary" @click="fetchPlayerData()" @dblclick.prevent="triggerDataCollection()">' + icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) + ' Refresh Data</button>'
        }) %>
      </div>

       <!-- Error Message -->
      <% if (errorMessage && errorMessage.message) { %>
      <div class="rounded-xl bg-red-800/10 dark:bg-red-500/10 px-6 py-4 mt-8 mx-8">
        <div class="flex items-center">
          <%- icon('triangle-alert', { size: 20, class: 'mr-4 shrink-0', style: 'color:var(--theme-danger);' }) %>
          <div>
            <h3 class="text-sm font-medium" style="color:var(--theme-danger);">Error</h3>
            <p class="text-sm" style="color:var(--theme-danger);opacity:0.7;">
              <%= errorMessage.message %>
            </p>
          </div>
        </div>
      </div>
      <% } %>

       <div class="px-8 mt-6">
        <!-- Stats Cards -->
        <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Total Players Card -->
            <div class="rounded-xl px-4 py-4" style="background:var(--theme-bg-card);border:1px solid var(--theme-border)">
               <div class="flex items-center justify-between">
                 <dt class="truncate text-sm font-medium" style="color:var(--theme-text-muted)">Total Players</dt>
                   <div class="rounded-lg p-2" style="background:var(--theme-bg-secondary)">
                    <%- icon('users', { size: 20, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                  </div>
               </div>
               <dd id="totalPlayers" class="mt-3 text-3xl font-semibold tracking-tight" style="color:var(--theme-text-strong)">
                0
               </dd>
               <p class="mt-1 text-sm" style="color:var(--theme-text-muted)">Players across all servers</p>
            </div>

            <!-- Max Capacity Card -->
            <div class="rounded-xl px-4 py-4" style="background:var(--theme-bg-card);border:1px solid var(--theme-border)">
               <div class="flex items-center justify-between">
                 <dt class="truncate text-sm font-medium" style="color:var(--theme-text-muted)">Max Capacity</dt>
                   <div class="rounded-lg p-2" style="background:var(--theme-bg-secondary)">
                    <%- icon('database', { size: 20, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                  </div>
               </div>
               <dd id="maxCapacity" class="mt-3 text-3xl font-semibold tracking-tight" style="color:var(--theme-text-strong)">
                0
               </dd>
               <p class="mt-1 text-sm" style="color:var(--theme-text-muted)">Total player capacity</p>
            </div>

            <!-- Online Servers Card -->
            <div class="rounded-xl px-4 py-4" style="background:var(--theme-bg-card);border:1px solid var(--theme-border)">
               <div class="flex items-center justify-between">
                 <dt class="truncate text-sm font-medium" style="color:var(--theme-text-muted)">Online Servers</dt>
                   <div class="rounded-lg p-2" style="background:var(--theme-bg-secondary)">
                    <%- icon('server', { size: 20, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                  </div>
               </div>
               <dd id="onlineServers" class="mt-3 text-3xl font-semibold tracking-tight" style="color:var(--theme-text-strong)">
                0
               </dd>
               <p class="mt-1 text-sm" style="color:var(--theme-text-muted)">Servers currently online</p>
            </div>

            <!-- Utilization Card -->
            <div class="rounded-xl px-4 py-4" style="background:var(--theme-bg-card);border:1px solid var(--theme-border)">
               <div class="flex items-center justify-between">
                 <dt class="truncate text-sm font-medium" style="color:var(--theme-text-muted)">Utilization</dt>
                   <div class="rounded-lg p-2" style="background:var(--theme-bg-secondary)">
                    <%- icon('activity', { size: 20, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                  </div>
               </div>
               <dd id="utilization" class="mt-3 text-3xl font-semibold tracking-tight" style="color:var(--theme-text-strong)">
                0%
               </dd>
               <p class="mt-1 text-sm" style="color:var(--theme-text-muted)">Player capacity utilization</p>
            </div>
         </dl>

         <!-- Player Graph -->
          <div class="rounded-xl mt-8 p-6" style="background:var(--theme-bg-card);border:1px solid var(--theme-border);box-shadow:var(--theme-shadow-sm)">
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-lg font-semibold" style="color:var(--theme-text-strong)">Player Count History</h2>
              <div class="text-xs" style="color:var(--theme-text-muted)">Data collected every 5 minutes (last 48 hours)</div>
            </div>
            <div class="h-60">
              <canvas id="playerChart" class="w-full h-full"></canvas>
            </div>
            <div class="mt-2 text-xs text-center" style="color:var(--theme-text-muted)">
              <p><%= req.translations.refreshDataCollection || 'Double-click the Refresh button to manually trigger data collection' %></p>
            </div>
         </div>

         <!-- Server Table -->
          <div class="rounded-xl mt-8 p-6" style="background:var(--theme-bg-card);border:1px solid var(--theme-border);box-shadow:var(--theme-shadow-sm)">
            <h2 class="text-lg font-semibold mb-4" style="color:var(--theme-text-strong)">Server Player Counts</h2>
            <div class="overflow-x-auto">
              <table class="min-w-full" style="border-collapse:separate">
                <thead>
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color:var(--theme-text-muted)">Server</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color:var(--theme-text-muted)">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color:var(--theme-text-muted)">Players</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color:var(--theme-text-muted)">Version</th>
                  </tr>
                </thead>
                <tbody id="serverTableBody" class="divide-y divide-[var(--theme-border)]" style="background:var(--theme-bg-card)">
                  <tr>
                    <td colspan="4" class="px-6 py-4 text-center" style="color:var(--theme-text-muted)">Loading server data...</td>
                  </tr>
                </tbody>
              </table>
            </div>
         </div>
       </div>
    </div>
  </div>
</main>

<script nonce="<%- nonce %>" src="/vendor/chart.js/dist/chart.js"></script>

<script nonce="<%- nonce %>">
function playerStats() {
  return {
    DATA_COLLECTION_DELAY_MS: 1000,
    playerChart: null,
    unsubscribeRealtime: null,

    init() {
      var _rootStyle = getComputedStyle(document.documentElement);
      var CHART_TICK_COLOR = _rootStyle.getPropertyValue('--theme-text').trim() || '#FFFFFF';
      var CHART_GRID_COLOR = 'rgba(255, 255, 255, 0.1)';

      var ctx = document.getElementById('playerChart').getContext('2d');
      this.playerChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: [],
          datasets: [
            {
              label: 'Total Players',
              data: [],
              backgroundColor: 'rgba(163, 163, 163, 0.2)',
              borderColor: 'rgba(163, 163, 163, 1)',
              borderWidth: 2,
              fill: true,
              tension: 0.4,
              pointRadius: 2,
              pointBackgroundColor: 'rgba(163, 163, 163, 1)',
              pointBorderColor: '#fff',
              pointBorderWidth: 1,
              pointHoverRadius: 5,
              pointHoverBackgroundColor: '#fff',
              pointHoverBorderColor: 'rgba(163, 163, 163, 1)',
              pointHoverBorderWidth: 2,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: {
                color: CHART_TICK_COLOR,
              },
            },
            tooltip: {
              callbacks: {
                title: function (tooltipItems) {
                  return new Date(tooltipItems[0].label).toLocaleString();
                },
              },
            },
          },
          scales: {
            x: {
              ticks: {
                color: CHART_TICK_COLOR,
                maxRotation: 45,
                minRotation: 45,
                callback: function (value, index, values) {
                  if (index % 12 === 0) {
                    const date = new Date(this.getLabelForValue(value));
                    return (
                      date.toLocaleDateString() +
                      ' ' +
                      date.toLocaleTimeString([], {
                        hour: '2-digit',
                        minute: '2-digit',
                      })
                    );
                  }
                  return '';
                },
              },
              grid: {
                color: CHART_GRID_COLOR,
              },
            },
            y: {
              position: 'right',
              beginAtZero: true,
              ticks: {
                color: CHART_TICK_COLOR,
                padding: 10,
                font: {
                  weight: 'bold',
                },
              },
              grid: {
                color: CHART_GRID_COLOR,
              },
              title: {
                display: true,
                text: 'Players',
                color: CHART_TICK_COLOR,
                font: {
                  size: 12,
                },
              },
            },
          },
        },
      });

      this.fetchPlayerData();
      this.wirePlayerStatsRealtime();
    },

    async fetchPlayerData() {
      var self = this;
      try {
        var response = await fetch('/api/v2/admin/playerstats');
        var data = await response.json();

        if (data.error) {
          console.error('Error fetching player data:', data.error);
          showToast(data.error || 'Failed to load player data.', 'error');
          return;
        }

        document.getElementById('totalPlayers').textContent = data.totalPlayers;
        document.getElementById('maxCapacity').textContent = data.totalMaxPlayers;
        document.getElementById('onlineServers').textContent = data.onlineServers;

        var utilizationPercent =
          data.totalMaxPlayers > 0
            ? Math.round((data.totalPlayers / data.totalMaxPlayers) * 100)
            : 0;
        document.getElementById('utilization').textContent =
          `${utilizationPercent}%`;

        var tableBody = document.getElementById('serverTableBody');
        tableBody.innerHTML = '';

        if (data.servers.length === 0) {
          var row = document.createElement('tr');
          row.innerHTML = `<td colspan="4" class="px-6 py-4 text-center text-neutral-400">No servers found</td>`;
          tableBody.appendChild(row);
        } else {
          data.servers.forEach((server) => {
            var row = document.createElement('tr');
            row.className =
              'hover:bg-neutral-50 dark:hover:bg-white/5 transition-colors';

            var statusClass = server.online
              ? 'text-emerald-700 dark:text-emerald-200 bg-emerald-100 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/30'
              : 'text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800/30 border border-neutral-300 dark:border-neutral-700/30';
            var statusText = server.online ? 'Online' : 'Offline';

            var nameCell = document.createElement('td');
            nameCell.className = 'px-6 py-4 whitespace-nowrap';
            var nameWrap = document.createElement('div');
            nameWrap.className = 'flex items-center';
            var metaWrap = document.createElement('div');
            metaWrap.className = 'ml-4';
            var serverNameEl = document.createElement('div');
            serverNameEl.className =
              'text-sm font-medium text-neutral-800 dark:text-white';
            serverNameEl.textContent = server.serverName;
            var serverIdEl = document.createElement('div');
            serverIdEl.className = 'text-sm text-neutral-400';
            serverIdEl.textContent = server.serverId;
            metaWrap.appendChild(serverNameEl);
            metaWrap.appendChild(serverIdEl);
            nameWrap.appendChild(metaWrap);
            nameCell.appendChild(nameWrap);

            var statusCell = document.createElement('td');
            statusCell.className = 'px-6 py-4 whitespace-nowrap';
            var badge = document.createElement('span');
            badge.className =
              'px-2 inline-flex text-xs leading-5 font-semibold rounded-full ' +
              statusClass;
            badge.textContent = statusText;
            statusCell.appendChild(badge);

            var countCell = document.createElement('td');
            countCell.className =
              'px-6 py-4 whitespace-nowrap text-sm text-neutral-700 dark:text-white';
            countCell.textContent =
              server.playerCount + ' / ' + server.maxPlayers;

            var versionCell = document.createElement('td');
            versionCell.className =
              'px-6 py-4 whitespace-nowrap text-sm text-neutral-400';
            versionCell.textContent = server.version || 'Unknown';

            row.appendChild(nameCell);
            row.appendChild(statusCell);
            row.appendChild(countCell);
            row.appendChild(versionCell);

            tableBody.appendChild(row);
          });
        }

        if (data.historicalData && data.historicalData.length > 0) {
          var labels = data.historicalData.map((entry) =>
            new Date(entry.timestamp).toISOString(),
          );
          var playerCounts = data.historicalData.map(
            (entry) => entry.totalPlayers,
          );

          labels.push(new Date().toISOString());
          playerCounts.push(data.totalPlayers);

          self.playerChart.data.labels = labels;
          self.playerChart.data.datasets[0].data = playerCounts;
          self.playerChart.update();
        } else {
          var now = new Date().toISOString();

          self.playerChart.data.labels = [now];
          self.playerChart.data.datasets[0].data = [data.totalPlayers];
          self.playerChart.update();
        }
      } catch (error) {
        console.error('Error fetching player data:', error);
        showToast('Failed to load player data.', 'error');
      }
    },

    async triggerDataCollection() {
      var self = this;
      try {
        var response = await fetch('/api/v2/admin/playerstats/collect', {
          method: 'POST',
        });
        var data = await response.json();

        if (data.success) {
          showToast('Player statistics collected.', 'success');
          setTimeout(() => self.fetchPlayerData(), self.DATA_COLLECTION_DELAY_MS);
        } else {
          console.error('Error collecting player statistics:', data.error);
          showToast(data.error || 'Failed to collect statistics.', 'error');
        }
      } catch (error) {
        console.error('Error triggering data collection:', error);
        showToast('Failed to collect statistics.', 'error');
      }
    },

    wirePlayerStatsRealtime() {
      var self = this;
      if (self.unsubscribeRealtime) return;
      var rt = window.alRealtime;
      var st = window.alState;
      if (!rt || !st) {
        window.addEventListener('al:realtime-ready', function handler() {
          window.removeEventListener('al:realtime-ready', handler);
          self.wirePlayerStatsRealtime();
        });
        return;
      }
      self.unsubscribeRealtime = st.observe('admin:playerstats', function () {
        self.fetchPlayerData();
      });
    }
  };
}
</script>

<%- include('../../components/footer') %>
