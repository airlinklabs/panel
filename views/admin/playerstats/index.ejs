<%- include('../../layouts/admin', { title: t('playerStatsTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbPlayerStats') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('playerStatsTitle') %></h1>
    <p class="al-page-desc"><%= t('playerStatsDesc') %></p>
  </div>
  <div>
    <button type="button" id="refreshBtn" class="al-btn-secondary">
      <%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %>
      <%= t('playerStatsRefresh') %>
    </button>
  </div>
</div>

<div class="al-page-body">
  <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <div class="al-card">
      <div class="flex items-center justify-between">
        <dt class="truncate text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('totalPlayers') %></dt>
        <div class="rounded-lg p-2" style="background:var(--theme-bg-secondary)"><%- icon('users', { size: 20, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %></div>
      </div>
      <dd id="totalPlayers" class="mt-3 text-3xl font-semibold tracking-tight" style="color:var(--theme-text-strong)"><%= totalPlayers ?? 0 %></dd>
      <p class="mt-1 text-sm" style="color:var(--theme-text-muted)"><%= t('playersAcrossServers') %></p>
    </div>
    <div class="al-card">
      <div class="flex items-center justify-between">
        <dt class="truncate text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('maxCapacity') %></dt>
        <div class="rounded-lg p-2" style="background:var(--theme-bg-secondary)"><%- icon('database', { size: 20, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %></div>
      </div>
      <dd id="maxCapacity" class="mt-3 text-3xl font-semibold tracking-tight" style="color:var(--theme-text-strong)"><%= totalMaxPlayers ?? 0 %></dd>
      <p class="mt-1 text-sm" style="color:var(--theme-text-muted)"><%= t('totalPlayerCapacity') %></p>
    </div>
    <div class="al-card">
      <div class="flex items-center justify-between">
        <dt class="truncate text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('onlineServers') %></dt>
        <div class="rounded-lg p-2" style="background:var(--theme-bg-secondary)"><%- icon('server', { size: 20, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %></div>
      </div>
      <dd id="onlineServers" class="mt-3 text-3xl font-semibold tracking-tight" style="color:var(--theme-text-strong)"><%= onlineServers ?? 0 %></dd>
      <p class="mt-1 text-sm" style="color:var(--theme-text-muted)"><%= t('serversCurrentlyOnline') %></p>
    </div>
    <div class="al-card">
      <div class="flex items-center justify-between">
        <dt class="truncate text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('utilization') %></dt>
        <div class="rounded-lg p-2" style="background:var(--theme-bg-secondary)"><%- icon('activity', { size: 20, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %></div>
      </div>
      <dd id="utilization" class="mt-3 text-3xl font-semibold tracking-tight" style="color:var(--theme-text-strong)">
        <%= totalMaxPlayers > 0 ? Math.round((totalPlayers / totalMaxPlayers) * 100) : 0 %>%
      </dd>
      <p class="mt-1 text-sm" style="color:var(--theme-text-muted)"><%= t('playerCapacityUtilization') %></p>
    </div>
  </dl>

  <div class="al-card mt-6">
    <div class="al-card-header">
      <span class="al-card-header-title"><%= t('playerCountHistory') %></span>
      <span class="text-xs" style="color:var(--theme-text-muted)"><%= t('playerDataCollectedEvery5min') %></span>
    </div>
    <div class="h-60">
      <canvas id="playerChart" class="w-full h-full"></canvas>
    </div>
  </div>

  <div class="al-card al-card-flush mt-6">
    <div class="al-card-header">
      <span class="al-card-header-title"><%= t('serverPlayerCounts') %></span>
    </div>
    <table class="al-table">
      <thead class="al-table-thead">
        <tr>
          <th scope="col" class="al-table-th"><%= t('serverColumn') %></th>
          <th scope="col" class="al-table-th"><%= t('statusColumn') %></th>
          <th scope="col" class="al-table-th"><%= t('players') %></th>
          <th scope="col" class="al-table-th"><%= t('version') %></th>
        </tr>
      </thead>
      <tbody id="serverTableBody">
        <% if (servers && servers.length > 0) { %>
          <% servers.forEach(function(s) { %>
            <tr class="al-table-tr">
              <td class="al-table-td">
                <div class="al-table-cell-strong"><%= s.serverName %></div>
                <div class="text-xs" style="color:var(--theme-text-muted)"><%= s.serverId %></div>
              </td>
              <td class="al-table-td">
                <span class="<%= s.online ? 'al-badge al-badge-online' : 'al-badge al-badge-offline' %>">
                  <%= s.online ? t('online') : t('offline') %>
                </span>
              </td>
              <td class="al-table-td whitespace-nowrap"><%= s.playerCount %> / <%= s.maxPlayers %></td>
              <td class="al-table-td whitespace-nowrap" style="color:var(--theme-text-muted)"><%= s.version %></td>
            </tr>
          <% }); %>
        <% } %>
        <% if (!servers || servers.length === 0) { %>
          <tr><td colspan="4" class="al-table-empty al-table-td"><%= t('playerStatsLoading') %></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script nonce="<%- nonce %>" src="<%= assetUrl('/vendor/chart.js/dist/chart.umd.min.js') %>"></script>
<script nonce="<%- nonce %>">
(function() {
  var historicalData = <%- JSON.stringify(historicalData || []) %>;
  var totalPlayers = <%= totalPlayers || 0 %>;

  var rootStyle = getComputedStyle(document.documentElement);
  var token = function(name) { return rootStyle.getPropertyValue(name).trim(); };
  var withAlpha = function(color, alpha) {
    if (color && color.charAt(0) === '#') {
      var n = Math.round(alpha * 255).toString(16);
      return color + (n.length < 2 ? '0' + n : n);
    }
    return color;
  };

  var CHART_TICK_COLOR = token('--theme-text');
  var CHART_GRID_COLOR = token('--theme-border');
  var CHART_LINE_COLOR = token('--theme-text-muted');

  var ctx = document.getElementById('playerChart');
  if (ctx && historicalData.length > 0) {
    var labels = historicalData.map(function(e) { return new Date(e.timestamp).toISOString(); });
    var playerCounts = historicalData.map(function(e) { return e.totalPlayers; });
    labels.push(new Date().toISOString());
    playerCounts.push(totalPlayers);

    new Chart(ctx.getContext('2d'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: <%- JSON.stringify(t('totalPlayers')) %>,
          data: playerCounts,
          backgroundColor: withAlpha(CHART_LINE_COLOR, 0.2),
          borderColor: CHART_LINE_COLOR,
          borderWidth: 2,
          fill: true,
          tension: 0.4,
          pointRadius: 2,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { labels: { color: CHART_TICK_COLOR } } },
        scales: {
          x: { grid: { color: CHART_GRID_COLOR }, ticks: { color: CHART_TICK_COLOR, maxTicksLimit: 10 } },
          y: { position: 'right', beginAtZero: true, grid: { color: CHART_GRID_COLOR }, ticks: { color: CHART_TICK_COLOR } }
        }
      }
    });
  }

  document.getElementById('refreshBtn').addEventListener('click', function() {
    window.location.reload();
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
