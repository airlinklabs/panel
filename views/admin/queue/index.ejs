<%- include('../../layouts/admin', { title: t('queueManagementTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbQueue') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('queueManagementTitle') %></h1>
    <p class="al-page-desc"><%= t('queueManagementDesc') %></p>
  </div>
  <div>
    <button type="button" id="refreshBtn" class="al-btn-secondary">
      <%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %>
      <%= t('refresh') %>
    </button>
  </div>
</div>

<div class="al-page-body">
  <div class="al-card al-card-flush">
    <div class="al-card-header">
      <span class="al-card-header-title"><%= t('queueCardTitle') %></span>
    </div>
    <table class="al-table">
      <thead class="al-table-thead">
        <tr>
          <th scope="col" class="al-table-th"><%= t('serverColumn') %></th>
          <th scope="col" class="al-table-th"><%= t('node') %></th>
          <th scope="col" class="al-table-th"><%= t('user') %></th>
          <th scope="col" class="al-table-th"><%= t('queuePosition') %></th>
          <th scope="col" class="al-table-th"><%= t('queuePriority') %></th>
          <th scope="col" class="al-table-th"><%= t('actions') %></th>
        </tr>
      </thead>
      <tbody id="queueTableBody">
        <% if (entries && entries.length > 0) { %>
          <% entries.forEach(function(entry) { %>
            <tr class="al-table-tr" data-server-id="<%= entry.serverId %>">
              <td class="al-table-td"><span class="al-table-cell-strong font-mono text-xs"><%= entry.serverId %></span></td>
              <td class="al-table-td">#<%= entry.nodeId %></td>
              <td class="al-table-td">#<%= entry.userId %></td>
              <td class="al-table-td tabular-nums"><%= entry.position %> / <%= entry.total %></td>
              <td class="al-table-td">
                <% if (entry.priority) { %>
                  <span class="al-badge al-badge-warning"><%- icon('zap', { size: 10, class: 'shrink-0' }) %> <%= t('queuePriorityHigh') %></span>
                <% } else { %>
                  <span class="al-badge al-badge-neutral"><%= t('queuePriorityNormal') %></span>
                <% } %>
              </td>
              <td class="al-table-td">
                <div class="flex gap-2">
                  <button class="al-btn-secondary al-btn-sm kick-btn" data-server-id="<%= entry.serverId %>"><%= t('queueKick') %></button>
                  <button class="al-btn-secondary al-btn-sm ban-btn" data-user-id="<%= entry.userId %>"><%= t('queueBan') %></button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="6" class="al-table-empty al-table-td"><%= t('queueEmpty') %></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script nonce="<%- nonce %>">
(function() {
  document.getElementById('refreshBtn').addEventListener('click', function() {
    window.location.reload();
  });

  document.querySelectorAll('.kick-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var serverId = btn.dataset.serverId;
      if (!confirm('<%= t('queueKickConfirm') %>'.replace('{{id}}', serverId))) return;
      try {
        var resp = await fetch('/admin/queue/' + encodeURIComponent(serverId) + '/kick', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        var data = await resp.json();
        if (data.removed) {
          btn.closest('tr').remove();
        }
      } catch (e) {
        showToast('<%= t('queueKickFailed') %>', 'error');
      }
    });
  });

  document.querySelectorAll('.ban-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var userId = btn.dataset.userId;
      if (!confirm('<%= t('queueBanConfirm') %>'.replace('{{id}}', userId))) return;
      try {
        var resp = await fetch('/admin/queue/users/' + encodeURIComponent(userId) + '/ban', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ minutes: 30 })
        });
        var data = await resp.json();
        if (data.banned) {
          showToast('<%= t('queueBanSuccess') %>', 'success');
        }
      } catch (e) {
        showToast('<%= t('queueBanFailed') %>', 'error');
      }
    });
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
