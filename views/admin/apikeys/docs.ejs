<%- include('../../components/header', { title: 'API Documentation' }) %>

  <main class="h-screen m-auto">
    <div class="flex h-screen">
      <div class="w-60 h-full hidden lg:block">
        <%- include('../../components/template') %>
      </div>
      <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
        <%- include('../../components/ui/breadcrumb', { items: [
          { label: 'Admin' },
          { label: 'API Keys', href: '/admin/apikeys' },
          { label: 'Documentation' }
        ] }) %>
        <div class="sm:flex sm:items-center px-8 pt-4">
          <div class="sm:flex-auto">
            <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong)">API Documentation</h1>
            <p class="mt-1 tracking-tight text-sm" style="color:var(--theme-text-muted)">Comprehensive documentation for the AirLink API</p>
          </div>
          <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
            <div class="flex gap-2">
              <a href="/admin/apikeys"
                class="al-btn-primary">
                Manage API Keys
              </a>
            </div>
          </div>
        </div>

        <!-- API Key Selection for Testing -->
        <div class="px-8 mt-4">
          <div
            class="rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center gap-4" style="background:var(--theme-bg-secondary)">
            <div class="flex-grow">
              <label for="apiKeySelect" class="block text-sm font-medium mb-1" style="color:var(--theme-text-strong)">Select
                API Key for Testing</label>
              <select id="apiKeySelect" class="cs-native">
                <option value="">Select an API key...</option>
                <% apiKeys.forEach(key=> { %>
                  <% if (key.active) { %>
                    <option value="<%= key.key %>" data-permissions="<%= key.permissions %>">
                      <%= key.name %>
                    </option>
                    <% } %>
                      <% }); %>
              </select>
              <div class="custom-select" data-for="apiKeySelect"></div>
            </div>
            <div class="flex-shrink-0 self-end sm:self-center">
              <button type="button" id="saveApiKeyBtn"
                class="w-full md:w-auto rounded-xl hover:bg-[var(--theme-bg-hover)] px-3 py-2 text-sm font-medium shadow-md transition focus:outline focus:outline-2 focus:outline-offset-2 inline-flex items-center gap-1.5" style="background:var(--theme-primary);color:var(--theme-accent-text)"
                disabled>
                <%- icon('play', { class: 'size-4', strokeWidth: 1.5 }) %>
                Use for Testing
              </button>
            </div>
          </div>
        </div>

        <div class="px-8 mt-5">
          <div class="rounded-xl p-6" style="background:var(--theme-bg-secondary)">
            <div class="mb-6">
              <h2 class="text-lg font-semibold" style="color:var(--theme-text-strong)">Getting Started</h2>
              <p class="mt-2 text-sm" style="color:var(--theme-text)">To use the API, you need an API key with
                the appropriate permissions.</p>
              <p class="mt-2 text-sm" style="color:var(--theme-text)">All API requests must include an <code
                  class="px-1 py-0.5 rounded" style="background:var(--theme-bg-secondary)">Authorization</code> header with a
                Bearer token:</p>
              <pre
                class="mt-2 p-3 rounded-md overflow-x-auto" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong)"><code>Authorization: Bearer YOUR_API_KEY</code></pre>
            </div>

            <div class="mb-6">
              <h2 class="text-lg font-semibold" style="color:var(--theme-text-strong)">Response Format</h2>
              <p class="mt-2 text-sm" style="color:var(--theme-text)">All successful responses return a JSON
                object with a <code class="px-1 py-0.5 rounded" style="background:var(--theme-bg-secondary)">data</code> property
                containing the requested information.</p>
              <pre class="mt-2 p-3 rounded-md overflow-x-auto" style="background:var(--theme-bg-secondary);color:var(--theme-text-strong)"><code>{
  "data": {
    // Response data here
  }
}</code></pre>

              <p class="mt-4 text-sm" style="color:var(--theme-text)">Error responses include an <code
                  class="px-1 py-0.5 rounded" style="background:var(--theme-bg-secondary)">error</code> property with a
                description of the error.</p>
              <pre class="mt-2 p-3 rounded-md overflow-x-auto" style="background:var(--theme-bg-secondary);color:var(--theme-text)"><code>{
  "error": "Error message"
}</code></pre>
            </div>

            <div>
              <h2 class="text-lg font-semibold mb-4" style="color:var(--theme-text-strong)">API Endpoints</h2>

              <div class="space-y-8">
                <% apiEndpoints.forEach(category=> { %>
                  <div>
                    <h3
                      class="text-md font-medium border-b pb-2 mb-4" style="color:var(--theme-text-strong);border-color:var(--theme-border)">
                      <%= category.category %> Endpoints
                    </h3>

                    <div class="space-y-6">
                      <% category.endpoints.forEach(endpoint=> { %>
                        <div class="border rounded-xl overflow-hidden" style="border-color:var(--theme-border)">
                          <div class="px-4 py-3 flex items-center" style="background:var(--theme-bg-secondary)">
                            <span class="inline-flex items-center rounded-md
                            <% if (endpoint.method === 'GET') { %>
                              style="background:var(--theme-success-bg);color:var(--theme-success);--tw-ring-color:var(--theme-success)"
                            <% } else if (endpoint.method === 'POST') { %>
                              style="background:var(--theme-accent-subtle);color:var(--theme-accent);--tw-ring-color:var(--theme-accent)"
                            <% } else if (endpoint.method === 'PATCH') { %>
                              style="background:var(--theme-warning-bg);color:var(--theme-warning);--tw-ring-color:var(--theme-warning)"
                            <% } else if (endpoint.method === 'DELETE') { %>
                              style="background:var(--theme-danger-bg);color:var(--theme-danger);--tw-ring-color:var(--theme-danger)"
                            <% } %>
                            px-2 py-1 text-xs font-medium ring-1 ring-inset mr-2">
                              <%= endpoint.method %>
                            </span>
                            <code class="text-sm font-mono"><%= endpoint.path %></code>
                            <span class="ml-auto text-xs" style="color:var(--theme-text-muted)">Permission: <%= endpoint.permission %></span>
                          </div>

                          <div class="px-4 py-3">
                            <p class="text-sm" style="color:var(--theme-text)">
                              <%= endpoint.description %>
                            </p>

                            <% if (endpoint.requestExample) { %>
                              <div class="mt-3">
                                <h4 class="text-xs font-medium mb-1" style="color:var(--theme-text)">Request
                                  Body:</h4>
                                <pre
                                  class="p-3 rounded-md overflow-x-auto text-xs" style="background:var(--theme-bg-secondary);color:var(--theme-text)"><code><%= endpoint.requestExample %></code></pre>
                              </div>
                              <% } %>

                                <div class="mt-3">
                                  <h4 class="text-xs font-medium mb-1" style="color:var(--theme-text)">Response:
                                  </h4>
                                  <pre
                                    class="p-3 rounded-md overflow-x-auto text-xs" style="background:var(--theme-bg-secondary);color:var(--theme-text)"><code><%= endpoint.responseExample %></code></pre>
                                </div>

                                <!-- Test Endpoint Section -->
                                <div class="mt-4 pt-3 border-t" style="border-color:var(--theme-border)">
                                  <div class="flex justify-between items-center mb-2">
                                    <h4 class="text-sm font-medium" style="color:var(--theme-text)">Test Endpoint
                                    </h4>
                                    <% const dynamicParams = endpoint.path.match(/:([a-zA-Z0-9_]+)/g); if (dynamicParams) { %>
                                      <div class="flex items-center space-x-2 mb-2">
                                        <% dynamicParams.forEach(param => { 
                                          const paramName = param.replace(':', '');
                                        %>
                                          <input 
                                            type="text" 
                                            data-param-name="<%= paramName %>"
                                            class="inline-block w-12 rounded-md border text-xs px-2 py-1 shadow-sm focus:border-[var(--theme-border-accent)] focus:ring-[var(--theme-border-accent)]" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text-strong)"
                                            placeholder="<%= paramName %>"
                                          />
                                        <% }); %>
                                    
                                        <button type="button"
                                          class="test-endpoint-btn text-xs rounded-xl hover:bg-[var(--theme-bg-hover)] px-3 py-1 font-medium shadow-sm transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none"
                                          data-method="<%= endpoint.method %>" data-path="<%= endpoint.path %>"
                                          data-permission="<%= endpoint.permission %>"
                                          data-request="<%= endpoint.requestExample ? encodeURIComponent(endpoint.requestExample) : '' %>"
                                          disabled style="background:var(--theme-primary);color:var(--theme-accent-text)"
                                          Test
                                        </button>
                                      </div>
                                    <% } %>
                                    <% if (!dynamicParams) { %>
                                      <button type="button"
                                        class="test-endpoint-btn text-xs rounded-xl hover:bg-[var(--theme-bg-hover)] px-3 py-1 font-medium shadow-sm transition focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)] focus-visible:ring-offset-1 outline-none"
                                        data-method="<%= endpoint.method %>" data-path="<%= endpoint.path %>"
                                        data-permission="<%= endpoint.permission %>"
                                        data-request="<%= endpoint.requestExample ? encodeURIComponent(endpoint.requestExample) : '' %>"
                                        disabled style="background:var(--theme-primary);color:var(--theme-accent-text)"
                                        Test
                                      </button>
                                    <% } %>
                                  </div>

                                  <% if (endpoint.method !=='GET' ) { %>
                                    <div class="mb-2">
                                      <label
                                        class="block text-xs font-medium mb-1" style="color:var(--theme-text)">Request
                                        Body:</label>
                                      <textarea
                                        class="request-body block w-full rounded-md shadow-sm focus:border-[var(--theme-border-accent)] focus:ring-[var(--theme-border-accent)] text-xs h-24" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text-strong)"
                                        placeholder="Enter request body in JSON format"
                                        data-endpoint-path="<%= endpoint.path %>"><%= endpoint.requestExample ? endpoint.requestExample.trim() : '' %></textarea>
                                    </div>
                                    <% } %>

                                      <div class="response-container hidden">
                                        <div class="flex justify-between items-center mb-1">
                                          <label
                                            class="block text-xs font-medium" style="color:var(--theme-text)">Response:</label>
                                          <span class="response-status text-xs font-medium"></span>
                                        </div>
                                        <pre
                                          class="response-output p-3 rounded-md overflow-x-auto text-xs h-32 overflow-y-auto" style="background:var(--theme-bg-secondary);color:var(--theme-text)"><code>No response yet</code></pre>
                                      </div>
                                </div>
                          </div>
                        </div>
                        <% }); %>
                    </div>
                  </div>
                  <% }); %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script nonce="<%- nonce %>" src="/javascript/admin/admin-apikeys-docs.js?v=5"></script>

  <%- include('../../components/footer') %>