<%- include('../../components/header', { title: 'API Keys Management' }) %>

<style>
  .category-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.2s cubic-bezier(0.16,1,0.3,1), opacity 0.15s ease;
    opacity: 0;
  }
  .category-panel.open {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .category-panel > div {
    overflow: hidden;
    min-height: 0;
  }
</style>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'API Keys' }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= req.translations.apiKeysManagement || 'API Keys Management' %></h1>
          <p class="al-page-desc"><%= req.translations.apiKeysDesc || 'Create and manage API keys with specific permissions' %></p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button @click="showCreateModal = true" type="button" class="al-btn-primary"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= req.translations.createApiKey || 'Create API Key' %></button>
          <a href="/admin/api/docs" class="al-btn-secondary"><%= req.translations.apiDocs || 'API Documentation' %></a>
        </div>
      </div>
      <div class="al-page-body space-y-3" id="admin-apikeys-list">
        <%- include('../../fragments/admin/apikeys/key-list', { apiKeys, settings, req }) %>
      </div>
    </div>
  </div>
</main>

<% /* Alpine scope wraps page + modals */ %>
<div x-data="apikeyPage()">

<div id="createApiKeyModal" class="al-sheet-overlay fixed inset-0 z-50 items-center justify-center overflow-y-auto" aria-hidden="true" x-show="showCreateModal" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" @keydown.escape.window="if(showCreateModal) showCreateModal = false" style="display:none">
  <div class="fixed inset-0 bg-transparent" aria-hidden="true" @click="showCreateModal = false"></div>
  <div id="createApiKeyPanel" class="al-sheet-panel relative my-auto mx-4 rounded-2xl shadow-xl w-full max-w-2xl" role="dialog" aria-modal="true" aria-labelledby="createApiKeyTitle" aria-describedby="createApiKeyDescription" tabindex="-1" style="background:var(--theme-bg-card); border-color:var(--theme-border);">

      <div class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
        <div>
          <h3 id="createApiKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong);"><%= req.translations.createNewApiKey || 'Create API Key' %></h3>
          <p id="createApiKeyDescription" class="text-xs mt-0.5" style="color:var(--theme-text-muted);">Set a name and choose what this key is allowed to do.</p>
        </div>
        <button type="button" @click="showCreateModal = false" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" style="color:var(--theme-text-muted);" aria-label="Close">
          <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
        </button>
      </div>

      <form id="createApiKeyForm" @submit.prevent="submitCreate()" class="px-6 py-4 space-y-5">
        <%- include('../../components/csrf') %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted);"><%= req.translations.apiKeyName || 'Name' %></label>
            <input type="text" name="name" id="name" required
              class="block w-full rounded-xl px-3 py-2 text-sm border transition focus:outline-none focus:ring-2 focus:ring-[var(--theme-border-accent)]"
              style="background:var(--theme-bg-input);border-color:var(--theme-border);color:var(--theme-text-strong);"
              placeholder="<%= req.translations.apiKeyNamePlaceholder || 'My API Key' %>">
          </div>
          <div>
            <label for="description" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted);"><%= req.translations.apiKeyDescriptionLabel || 'Description' %> <span style="color:var(--theme-text-placeholder);" class="font-normal">(optional)</span></label>
            <input type="text" name="description" id="description"
              class="block w-full rounded-xl px-3 py-2 text-sm border transition focus:outline-none focus:ring-2 focus:ring-[var(--theme-border-accent)]"
              style="background:var(--theme-bg-input);border-color:var(--theme-border);color:var(--theme-text-strong);"
              placeholder="What is this key used for?">
          </div>
        </div>

        <div>
          <p class="text-xs font-medium mb-2" style="color:var(--theme-text-muted);">Presets</p>
        <div class="flex gap-2">
          <button type="button" @click="applyPreset('full-admin')" class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" :style="activePreset === 'full-admin' ? 'background:var(--theme-primary);color:var(--theme-accent-text);border-color:var(--theme-primary)' : 'border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)'">
            <%- icon('shield', { class: 'size-3', strokeWidth: 1.5 }) %>Full Admin
          </button>
          <button type="button" @click="applyPreset('read-only')" class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" :style="activePreset === 'read-only' ? 'background:var(--theme-primary);color:var(--theme-accent-text);border-color:var(--theme-primary)' : 'border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)'">
            <%- icon('eye', { class: 'size-3', strokeWidth: 1.5 }) %>Read-Only
          </button>
          <button type="button" @click="applyPreset('server-manager')" class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" :style="activePreset === 'server-manager' ? 'background:var(--theme-primary);color:var(--theme-accent-text);border-color:var(--theme-primary)' : 'border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)'">
            <%- icon('server', { class: 'size-3', strokeWidth: 1.5 }) %>Server Manager
          </button>
          <button type="button" @click="applyPreset('user-manager')" class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" :style="activePreset === 'user-manager' ? 'background:var(--theme-primary);color:var(--theme-accent-text);border-color:var(--theme-primary)' : 'border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)'">
            <%- icon('user', { class: 'size-3', strokeWidth: 1.5 }) %>User Manager
          </button>
          <button type="button" @click="applyPreset('node-monitor')" class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" :style="activePreset === 'node-monitor' ? 'background:var(--theme-primary);color:var(--theme-accent-text);border-color:var(--theme-primary)' : 'border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)'">
            <%- icon('monitor', { class: 'size-3', strokeWidth: 1.5 }) %>Node Monitor
          </button>
          <button type="button" @click="applyPreset('none')" class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" :style="activePreset === 'none' ? 'background:var(--theme-primary);color:var(--theme-accent-text);border-color:var(--theme-primary)' : 'border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)'">
            <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>Clear All
          </button>
        </div>
        </div>

        <div>
          <p class="text-xs font-medium mb-2" style="color:var(--theme-text-muted);">Permissions</p>
          <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
            <% ['servers', 'users', 'nodes', 'settings'].forEach(category => { %>
              <div class="rounded-xl border overflow-hidden" style="border-color:var(--theme-border);">
                <button type="button"
                  class="category-toggle w-full flex items-center justify-between px-4 py-2.5 text-left transition-colors duration-150 hover:bg-[var(--theme-bg-hover)]"
                  style="background:var(--theme-bg-secondary);"
                  :aria-expanded="String(!!expandedCats['create_' + '<%= category %>'])"
                  @click="expandedCats['create_<%= category %>'] = !expandedCats['create_<%= category %>']">
                  <div class="flex items-center gap-2">
                    <% if (category === 'servers') { %>
                      <%- icon('server', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                    <% } else if (category === 'users') { %>
                      <%- icon('user', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                    <% } else if (category === 'nodes') { %>
                      <%- icon('hard-drive', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                    <% } else { %>
                      <%- icon('key', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                    <% } %>
                    <span class="text-xs font-medium capitalize" style="color:var(--theme-text);"><%= category %></span>
                    <span class="category-count text-[10px]" style="color:var(--theme-text-muted)" data-category="<%= category %>">0 selected</span>
                  </div>
                  <%- icon('chevron-down', { size: 14, class: 'category-chevron transition-transform duration-200 shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                </button>
                <div class="category-panel" x-show="expandedCats['create_<%= category %>']" x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" style="background:var(--theme-bg-card);">
                  <div class="px-4 py-3 border-t" style="border-color:var(--theme-border);">
                  <div class="grid grid-cols-2 gap-2">
                    <% allPermissions.filter(p => p.value.includes(category)).forEach(permission => { %>
                      <label class="flex items-center gap-2 px-3 py-2 rounded-lg border cursor-pointer transition-all duration-150 hover:border-[var(--theme-border)] has-[:checked]:border-[var(--theme-accent)] has-[:checked]:bg-[var(--theme-accent-subtle)]"
                        style="border-color:var(--theme-border);background:var(--theme-bg-secondary);">
                        <input type="checkbox"
                          :checked="isCreatePerm('<%= permission.value %>')"
                          @change="toggleCreatePerm('<%= permission.value %>')"
                          class="h-3.5 w-3.5 rounded shrink-0">
                        <span class="text-xs" style="color:var(--theme-text-muted);"><%= permission.name.split(' - ')[1] || permission.name %></span>
                      </label>
                    <% }); %>
                  </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="flex gap-2 py-4 border-t justify-end" style="border-color:var(--theme-border);">
          <button type="button" @click="showCreateModal = false"
            class="px-4 py-2 text-xs font-medium rounded-xl border transition active:scale-95 inline-flex items-center gap-2 hover:bg-[var(--theme-bg-hover)]"
            style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text);">
            <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
            Cancel
          </button>
          <button type="submit"
            class="px-4 py-2 text-xs font-medium rounded-xl transition active:scale-95 inline-flex items-center gap-2 hover:bg-[var(--theme-bg-hover)]"
            style="background:var(--theme-primary);color:var(--theme-accent-text);">
            <%- icon('plus', { class: 'size-3', strokeWidth: 1.5 }) %>
            Create API key
          </button>
        </div>

      </form>
    </div>
</div>


<div id="editApiKeyModal" class="al-sheet-overlay fixed inset-0 z-50 items-center justify-center" aria-hidden="true" x-show="showEditModal" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" style="display:none">
  <div class="absolute inset-0 bg-transparent" id="editApiKeyModalBackdrop" @click="showEditModal = false"></div>
  <div id="editApiKeyModalPanel" role="dialog" aria-modal="true" aria-labelledby="editApiKeyTitle" aria-describedby="editApiKeyDescription" tabindex="-1" class="al-sheet-panel relative rounded-2xl shadow-xl w-full max-w-2xl mx-4 max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border-color:var(--theme-border);">

    <!-- Header -->
    <div class="flex justify-between items-center px-6 py-4 border-b shrink-0" style="border-color:var(--theme-border);">
      <div>
        <p id="editApiKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong);"><%= req.translations.editApiKey || 'Edit API Key' %></p>
        <p id="editApiKeyDescription" class="text-xs mt-0.5" style="color:var(--theme-text-muted);">Update name, description, and permissions.</p>
      </div>
      <button type="button" @click="showEditModal = false" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" style="color:var(--theme-text-muted);" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>

    <!-- Body -->
    <form id="editApiKeyForm" @submit.prevent="submitEdit()" class="flex flex-col min-h-0 flex-1">
      <%- include('../../components/csrf') %>
      <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4 space-y-4">

        <!-- Name + description -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--theme-text-muted);"><%= req.translations.apiKeyName || 'Name' %></label>
            <input type="text" name="name" id="edit-name" required
              class="w-full rounded-xl border text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--theme-border-accent)] transition"
              style="border-color:var(--theme-border);background:var(--theme-bg-secondary);color:var(--theme-text-strong);"
              placeholder="<%= req.translations.apiKeyNamePlaceholder || 'My API Key' %>">
          </div>
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--theme-text-muted);"><%= req.translations.apiKeyDescriptionLabel || 'Description' %></label>
            <input type="text" name="description" id="edit-description"
              class="w-full rounded-xl border text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--theme-border-accent)] transition"
              style="border-color:var(--theme-border);background:var(--theme-bg-secondary);color:var(--theme-text-strong);"
              placeholder="<%= req.translations.apiKeyDescriptionPlaceholder || 'Used for server management' %>">
          </div>
        </div>

        <!-- Quick select -->
        <div class="flex gap-2">
          <button type="button" id="editSelectAllBtn" class="text-xs px-3 py-1.5 rounded-lg border transition inline-flex items-center gap-1.5 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-bg-secondary);border-color:var(--theme-border);color:var(--theme-text-muted);"><%- icon('check-check', { class: 'size-3', strokeWidth: 1.5 }) %> Select all</button>
          <button type="button" id="editSelectNoneBtn" class="text-xs px-3 py-1.5 rounded-lg border transition inline-flex items-center gap-1.5 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-bg-secondary);border-color:var(--theme-border);color:var(--theme-text-muted);"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %> Clear all</button>
          <button type="button" id="editSelectReadOnlyBtn" class="text-xs px-3 py-1.5 rounded-lg border transition inline-flex items-center gap-1.5 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-bg-secondary);border-color:var(--theme-border);color:var(--theme-text-muted);"><%- icon('eye', { class: 'size-3', strokeWidth: 1.5 }) %> Read only</button>
        </div>

        <!-- Permissions grid -->
        <div class="space-y-3">
          <% ['servers', 'users', 'nodes', 'settings'].forEach(cat => { %>
          <div class="rounded-xl border overflow-hidden" style="border-color:var(--theme-border);">
            <div class="flex items-center justify-between px-4 py-2.5" style="background:var(--theme-bg-secondary);">
              <p class="text-xs font-semibold capitalize" style="color:var(--theme-text-muted);"><%= cat %></p>
              <button type="button" class="edit-select-category text-xs transition hover:text-[var(--theme-text)]" style="color:var(--theme-text-muted);" data-category="<%= cat %>">Select all</button>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-1.5 px-4 py-3">
              <% allPermissions.filter(p => p.value.includes(cat)).forEach(permission => { %>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox"
                  :checked="isEditPerm('<%= permission.value %>')"
                  @change="toggleEditPerm('<%= permission.value %>')"
                  class="h-3.5 w-3.5 rounded focus:ring-[var(--theme-border-accent)]">
                <span class="text-xs transition group-hover:text-[var(--theme-text-strong)]" style="color:var(--theme-text);"><%= permission.name %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>

      </div>

      <!-- Footer -->
      <div class="flex gap-2 px-6 py-4 border-t justify-end shrink-0" style="border-color:var(--theme-border);">
         <button type="button" @click="showEditModal = false" class="px-4 py-2 text-xs font-medium rounded-xl transition inline-flex items-center gap-2 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-bg-secondary);color:var(--theme-text);"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %> Cancel</button>
        <button type="submit" class="px-4 py-2 text-xs font-medium rounded-xl transition inline-flex items-center gap-2 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-primary);color:var(--theme-accent-text);"><%- icon('save', { class: 'size-3', strokeWidth: 1.5 }) %> Save changes</button>
      </div>
    </form>
  </div>
</div>

<% if (created) { %>
<div id="createdKeyModal" class="al-sheet-overlay fixed inset-0 z-50 items-center justify-center" aria-hidden="true" x-show="showCreatedModal" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" @keydown.escape.window="if(showCreatedModal) showCreatedModal = false" style="display:none">
  <div class="absolute inset-0 bg-transparent" @click="showCreatedModal = false"></div>
  <div id="createdKeyPanel" role="dialog" aria-modal="true" aria-labelledby="createdKeyTitle" tabindex="-1" class="al-sheet-panel relative rounded-2xl shadow-xl w-full max-w-lg mx-4 max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <div class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
      <h3 id="createdKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong);">API key created</h3>
      <button type="button" @click="showCreatedModal = false" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" style="color:var(--theme-text-muted);" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="px-6 py-4">
      <p class="text-xs mb-4" style="color:var(--theme-text-muted);">Copy it now — for security, this is the only time the full key is shown.</p>
      <div class="flex items-center gap-2 rounded-xl px-3 py-2.5" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border)">
        <code class="flex-1 text-xs font-mono break-all" style="color:var(--theme-text-strong)"><%= created %></code>
      </div>
    </div>
    <div class="flex gap-2 px-6 py-4 border-t justify-end" style="border-color:var(--theme-border);">
      <button type="button" @click="showCreatedModal = false" class="al-btn-secondary"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %> Close</button>
      <button type="button" @click="copyToClipboard(createdKey)" class="al-btn-primary"><%- icon('copy', { class: 'size-4', strokeWidth: 1.5 }) %> Copy key</button>
    </div>
  </div>
</div>
<% } %>

</div><% /* end x-data scope */ %>



<script nonce="<%- nonce %>">
function apikeyPage() {
  return {
    showCreateModal: false,
    showEditModal: false,
    showCreatedModal: false,
    expandedCats: {},
    createForm: { name: '', description: '', permissions: [] },
    editForm: { id: 0, name: '', description: '', permissions: [] },
    editTarget: null,
    activePreset: null,
    createdKey: '<%= typeof created !== "undefined" ? created : "" %>',

    presetPermissions: {
      'full-admin': ['airlink.api.servers.read','airlink.api.servers.create','airlink.api.servers.update','airlink.api.servers.delete','airlink.api.users.read','airlink.api.users.create','airlink.api.users.update','airlink.api.users.delete','airlink.api.nodes.read','airlink.api.nodes.create','airlink.api.nodes.update','airlink.api.nodes.delete','airlink.api.settings.read','airlink.api.settings.update'],
      'read-only': ['airlink.api.servers.read','airlink.api.users.read','airlink.api.nodes.read','airlink.api.settings.read'],
      'server-manager': ['airlink.api.servers.read','airlink.api.servers.create','airlink.api.servers.update','airlink.api.servers.delete','airlink.api.nodes.read'],
      'user-manager': ['airlink.api.users.read','airlink.api.users.create','airlink.api.users.update','airlink.api.users.delete','airlink.api.servers.read'],
      'node-monitor': ['airlink.api.nodes.read','airlink.api.servers.read'],
      'none': []
    },

    allPermissions: <%- JSON.stringify(allPermissions) %>,

    init() {
      if (this.createdKey) this.showCreatedModal = true;
      // Expose for external callers
      window.showEditModal = (id, name, desc, perms) => {
        try { perms = typeof perms === 'string' ? JSON.parse(perms) : perms; } catch { perms = []; }
        this.editForm = { id, name, description: desc || '', permissions: [...perms] };
        this.showEditModal = true;
      };
      window.confirmDeleteApiKey = (keyId) => {
        window.modal.confirm({
          title: 'Delete API key', body: 'This will permanently revoke the key. Any integrations using it will stop working.',
          danger: true, confirmLabel: 'Yeah, delete it',
          onConfirm: () => this.deleteKey(keyId)
        });
      };
    },

    applyPreset(name) {
      this.activePreset = name;
      this.createForm.permissions = [...(this.presetPermissions[name] || [])];
    },

    toggleCreatePerm(perm) {
      const idx = this.createForm.permissions.indexOf(perm);
      if (idx === -1) this.createForm.permissions.push(perm);
      else this.createForm.permissions.splice(idx, 1);
    },

    isCreatePerm(perm) { return this.createForm.permissions.includes(perm); },

    toggleEditPerm(perm) {
      const idx = this.editForm.permissions.indexOf(perm);
      if (idx === -1) this.editForm.permissions.push(perm);
      else this.editForm.permissions.splice(idx, 1);
    },

    isEditPerm(perm) { return this.editForm.permissions.includes(perm); },

    editSelectAll() { this.editForm.permissions = this.allPermissions.map(p => p.value); },
    editClearAll() { this.editForm.permissions = []; },
    editReadOnly() { this.editForm.permissions = this.allPermissions.filter(p => p.value.includes('.read')).map(p => p.value); },

    async submitCreate() {
      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const params = new URLSearchParams();
        params.append('name', this.createForm.name);
        params.append('description', this.createForm.description);
        params.append('csrf-token', csrfToken);
        this.createForm.permissions.forEach(p => params.append('permissions', p));
        const res = await fetch('/admin/apikeys/create', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'csrf-token': csrfToken },
          body: params,
        });
        if (res.ok) {
          showToast('API key created', 'success');
          this.showCreateModal = false;
          window.location.href = res.url || '/admin/apikeys';
        } else {
          const data = await res.json().catch(() => ({}));
          showToast(data.error || 'Failed to create key.', 'error');
        }
      } catch (e) { showToast('Network error.', 'error'); }
    },

    async submitEdit() {
      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const params = new URLSearchParams();
        params.append('name', this.editForm.name);
        params.append('description', this.editForm.description);
        params.append('csrf-token', csrfToken);
        this.editForm.permissions.forEach(p => params.append('permissions', p));
        const res = await fetch('/admin/apikeys/edit/' + this.editForm.id, {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'csrf-token': csrfToken },
          body: params,
        });
        if (res.ok) {
          showToast('API key updated', 'success');
          this.showEditModal = false;
          window.location.reload();
        } else {
          const data = await res.json().catch(() => ({}));
          showToast(data.error || 'Failed to update key.', 'error');
        }
      } catch (e) { showToast('Network error.', 'error'); }
    },

    async deleteKey(keyId) {
      const form = document.getElementById('deleteKeyForm_' + keyId);
      if (!form) return;
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'Accept': 'application/json' }, body: new URLSearchParams(new FormData(form)) });
        if (res.ok) {
          showToast('API key deleted', 'success');
          const card = document.querySelector('[data-api-key-id="' + keyId + '"]');
          if (card && window.al) al.removeRow(card);
          else if (card) card.remove();
        } else {
          const data = await res.json().catch(() => ({}));
          showToast(data.error || 'Failed to delete key.', 'error');
        }
      } catch (e) { showToast('Network error.', 'error'); }
    },

    async toggleKey(keyId, enabling) {
      const form = document.getElementById('toggleKeyForm_' + keyId);
      if (!form) return;
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'Accept': 'application/json' }, body: new URLSearchParams(new FormData(form)) });
        if (res.ok) {
          showToast(enabling ? 'API key enabled' : 'API key disabled', 'success');
          window.location.reload();
        }
      } catch (e) { showToast('Network error.', 'error'); }
    },

    get createCatCounts() {
      const counts = {};
      ['servers','users','nodes','settings'].forEach(cat => {
        const total = this.allPermissions.filter(p => p.value.includes(cat)).length;
        const checked = this.createForm.permissions.filter(p => p.includes(cat)).length;
        counts[cat] = { total, checked };
      });
      return counts;
    },

    get editCatCounts() {
      const counts = {};
      ['servers','users','nodes','settings'].forEach(cat => {
        const total = this.allPermissions.filter(p => p.value.includes(cat)).length;
        const checked = this.editForm.permissions.filter(p => p.includes(cat)).length;
        counts[cat] = { total, checked };
      });
      return counts;
    }
  };
}

function copyToClipboard(text) {
  navigator.clipboard.writeText(text).then(() => showToast('API key copied to clipboard', 'success')).catch(() => showToast('Failed to copy', 'error'));
}
</script>

