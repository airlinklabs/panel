<%- include('../../layouts/admin', { title: t('apiKeysManagement') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbApiKeys') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('apiKeysManagement') %></h1>
    <p class="al-page-desc"><%= t('apiKeysDesc') %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <button id="openCreateApiKeyModal" type="button" class="al-btn-primary">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
      <span><%= t('createApiKey') %></span>
    </button>
    <a href="/admin/api/docs" class="al-btn-secondary"><%= t('apiDocs') %></a>
  </div>
</div>

<div class="al-page-body">
  <div class="space-y-3" id="admin-apikeys-list">
    <% if (apiKeys.length === 0) { %>
      <%- include('../../partials/empty-state', {
        iconName: 'key',
        title: t('noApiKeysYet'),
        description: t('noApiKeysYetDesc'),
        action: '<button type="button" data-open-create-apikey class="al-btn-primary">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }).toString() + ' ' + t('createApiKey') + '</button>'
      }) %>
    <% } else { %>
      <% apiKeys.forEach(function(apiKey) { %>
        <div class="al-card" data-api-key-id="<%= apiKey.id %>">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-3 mb-1">
                <span class="text-sm font-medium api-key-name" style="color:var(--theme-text-strong)"><%= apiKey.name %></span>
                <% if (apiKey.active) { %>
                  <span class="api-key-status-badge al-badge al-badge-online"><%= t('apiKeyActive') %></span>
                <% } else { %>
                  <span class="api-key-status-badge al-badge al-badge-offline"><%= t('apiKeyInactive') %></span>
                <% } %>
              </div>
              <% if (apiKey.description) { %>
                <p class="text-xs api-key-desc" style="color:var(--theme-text-muted)"><%= apiKey.description %></p>
              <% } %>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" onclick="showEditModal(<%- JSON.stringify(apiKey.id) %>, <%- JSON.stringify(apiKey.name) %>, <%- JSON.stringify(apiKey.description || '') %>, <%= Array.isArray(apiKey.permissions) ? JSON.stringify(apiKey.permissions) : '[]' %>)"
                class="al-btn-ghost al-btn-icon-only"
                aria-label="<%= t('ariaEditApiKey') %>">
                <%- icon('pencil', { size: 16, class: 'shrink-0' }) %>
              </button>
              <form id="toggleKeyForm_<%= apiKey.id %>" action="/admin/apikeys/toggle/<%= apiKey.id %>" method="POST" class="inline">
                <%- include('../../partials/csrf') %>
                <button type="submit" class="al-btn-ghost al-btn-icon-only" aria-label="<%= apiKey.active ? t('ariaDisableApiKey') : t('ariaEnableApiKey') %>">
                  <% if (apiKey.active) { %>
                    <%- icon('x-circle', { size: 16, class: 'shrink-0' }) %>
                  <% } else { %>
                    <%- icon('check-circle', { size: 16, class: 'shrink-0' }) %>
                  <% } %>
                </button>
              </form>
              <form id="deleteKeyForm_<%= apiKey.id %>" action="/admin/apikeys/delete/<%= apiKey.id %>" method="POST" class="inline">
                <%- include('../../partials/csrf') %>
                <button type="button" onclick="confirmDeleteApiKey('<%= apiKey.id %>')" class="al-btn-ghost al-btn-icon-only" style="color:var(--theme-danger);" aria-label="<%= t('ariaDeleteApiKey') %>">
                  <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
                </button>
              </form>
            </div>
          </div>
          <% if (apiKey.key) { %>
          <div class="mt-3 flex items-center gap-2">
            <div class="al-code-wrap flex-1 min-w-0">
              <code class="al-code block truncate" style="white-space:nowrap"><%= apiKey.key.substring(0, 12) %>••••••••••••</code>
            </div>
            <button onclick="copyToClipboard('<%= apiKey.key %>')" type="button" class="al-btn-secondary al-btn-sm shrink-0">
              <%- icon('copy', { class: 'size-3', strokeWidth: 1.5 }) %>
              <%= t('copyKey') %>
            </button>
          </div>
          <% } %>
          <div class="mt-2 flex items-center gap-3 text-xs" style="color:var(--theme-text-muted)">
            <span><%= t('apiKeyCreatedBy') %> <span class="font-medium" style="color:var(--theme-text-strong)"><%= t('activitySystemActor') %></span></span>
            <span aria-hidden="true">·</span>
            <span><%= new Date(apiKey.createdAt).toLocaleDateString() %></span>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<!-- Create API Key Modal -->
<div id="createApiKeyModal" class="al-sheet-overlay" role="dialog" aria-modal="true" aria-labelledby="createApiKeyTitle" style="display:none;">
  <div class="al-sheet-panel rounded-2xl max-w-2xl w-full max-h-[85vh] flex flex-col shadow-xl" style="background:var(--theme-bg-card);">
    <div class="al-sheet-header">
      <h3 id="createApiKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('createApiKeyModal') %></h3>
      <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" data-close-modal aria-label="<%= t('ariaClose') %>">
        <%- icon('x', { class: 'w-5 h-5' }) %>
      </button>
    </div>
    <form id="createApiKeyForm" class="flex flex-col min-h-0 flex-1">
      <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4 space-y-5">
        <%- include('../../partials/csrf') %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="al-form-field">
            <label for="name" class="al-form-label"><%= t('apiKeyName') %></label>
            <input type="text" name="name" id="name" required class="al-form-input" placeholder="<%= t('apiKeyNamePlaceholder') %>">
          </div>
          <div class="al-form-field">
            <label for="description" class="al-form-label"><%= t('apiKeyDescriptionLabel') %> <span class="font-normal" style="color:var(--theme-text-placeholder)"><%= t('apiKeyOptionalLabel') %></span></label>
            <input type="text" name="description" id="description" class="al-form-input" placeholder="<%= t('apiKeyPlaceholderDesc') %>">
          </div>
        </div>

        <div>
          <p class="text-xs font-medium mb-2" style="color:var(--theme-text-muted)"><%= t('apiKeyPresets') %></p>
          <div class="flex gap-2 flex-wrap">
            <button type="button" data-preset="full-admin" class="preset-btn al-chip">
              <%- icon('shield', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyFullAdmin') %>
            </button>
            <button type="button" data-preset="read-only" class="preset-btn al-chip">
              <%- icon('eye', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyReadOnlyPreset') %>
            </button>
            <button type="button" data-preset="server-manager" class="preset-btn al-chip">
              <%- icon('server', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyServerManager') %>
            </button>
            <button type="button" data-preset="user-manager" class="preset-btn al-chip">
              <%- icon('user', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyUserManager') %>
            </button>
            <button type="button" data-preset="node-monitor" class="preset-btn al-chip">
              <%- icon('monitor', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyNodeMonitor') %>
            </button>
            <button type="button" data-preset="none" class="preset-btn al-chip">
              <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyClearAll') %>
            </button>
          </div>
        </div>

        <div>
          <p class="text-xs font-medium mb-2" style="color:var(--theme-text-muted)"><%= t('apiKeyPermissions') %></p>
          <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
            <% ['servers', 'users', 'nodes', 'settings'].forEach(function(category) { %>
              <div class="al-disclosure">
                <button type="button"
                  class="al-disclosure-trigger category-toggle"
                  data-category="create_<%= category %>">
                  <span class="flex items-center gap-2">
                    <% if (category === 'servers') { %>
                      <%- icon('server', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                      <span class="text-xs font-medium" style="color:var(--theme-text)"><%= t('activityCategoryServers') %></span>
                    <% } else if (category === 'users') { %>
                      <%- icon('user', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                      <span class="text-xs font-medium" style="color:var(--theme-text)"><%= t('activityCategoryUsers') %></span>
                    <% } else if (category === 'nodes') { %>
                      <%- icon('hard-drive', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                      <span class="text-xs font-medium" style="color:var(--theme-text)"><%= t('activityCategoryNodes') %></span>
                    <% } else { %>
                      <%- icon('key', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                      <span class="text-xs font-medium" style="color:var(--theme-text)"><%= t('permCategorySettings') %></span>
                    <% } %>
                    <span class="category-count text-[10px]" style="color:var(--theme-text-muted)" data-category="<%= category %>"><%= t('permSelectedCount') %></span>
                  </span>
                  <%- icon('chevron-down', { size: 14, class: 'category-chevron transition-transform duration-200 shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                </button>
                <div class="al-disclosure-panel" data-create-category="<%= category %>">
                  <div>
                    <div class="grid grid-cols-2 gap-2">
                      <% allPermissions.filter(function(p) { return p.value.indexOf(category) !== -1; }).forEach(function(permission) { %>
                        <label class="al-perm-tile">
                          <input type="checkbox"
                            data-perm="<%= permission.value %>"
                            class="create-perm h-3.5 w-3.5 rounded shrink-0">
                          <span class="text-xs" style="color:var(--theme-text-muted)"><%= permission.name.split(' - ')[1] || permission.name %></span>
                        </label>
                      <% }); %>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
      <div class="al-sheet-footer">
        <button type="button" data-close-modal class="al-btn-secondary"><%= t('cancel') %></button>
        <button type="submit" class="al-btn-primary ml-auto">
          <%- icon('plus', { class: 'size-3', strokeWidth: 1.5 }) %>
          <%= t('createApiKey') %>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Edit API Key Modal -->
<div id="editApiKeyModal" class="al-sheet-overlay" role="dialog" aria-modal="true" aria-labelledby="editApiKeyTitle" style="display:none;">
  <div class="al-sheet-panel rounded-2xl max-w-2xl w-full max-h-[85vh] flex flex-col shadow-xl" style="background:var(--theme-bg-card);">
    <div class="al-sheet-header shrink-0">
      <p id="editApiKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('editApiKey') %></p>
      <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" data-close-modal aria-label="<%= t('ariaClose') %>">
        <%- icon('x', { class: 'w-5 h-5' }) %>
      </button>
    </div>
    <form id="editApiKeyForm" class="flex flex-col min-h-0 flex-1">
      <%- include('../../partials/csrf') %>
      <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="al-form-field">
            <label for="edit-name" class="al-form-label"><%= t('apiKeyName') %></label>
            <input type="text" name="name" id="edit-name" required class="al-form-input" placeholder="<%= t('apiKeyNamePlaceholder') %>">
          </div>
          <div class="al-form-field">
            <label for="edit-description" class="al-form-label"><%= t('apiKeyDescriptionLabel') %></label>
            <input type="text" name="description" id="edit-description" class="al-form-input" placeholder="<%= t('apiKeyPlaceholderDesc') %>">
          </div>
        </div>

        <div class="flex gap-2 flex-wrap">
          <button type="button" id="editSelectAllBtn" class="al-btn-secondary al-btn-sm"><%- icon('check-check', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('selectAll') %></button>
          <button type="button" id="editSelectNoneBtn" class="al-btn-secondary al-btn-sm"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('clearAll') %></button>
          <button type="button" id="editSelectReadOnlyBtn" class="al-btn-secondary al-btn-sm"><%- icon('eye', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('apiKeyReadOnlyPerm') %></button>
        </div>

        <div class="space-y-3">
          <% ['servers', 'users', 'nodes', 'settings'].forEach(function(cat) { %>
          <div class="al-disclosure">
            <div class="al-disclosure-head">
              <% if (cat === 'servers') { %>
                <p class="text-xs font-semibold" style="color:var(--theme-text-muted)"><%= t('activityCategoryServers') %></p>
              <% } else if (cat === 'users') { %>
                <p class="text-xs font-semibold" style="color:var(--theme-text-muted)"><%= t('activityCategoryUsers') %></p>
              <% } else if (cat === 'nodes') { %>
                <p class="text-xs font-semibold" style="color:var(--theme-text-muted)"><%= t('activityCategoryNodes') %></p>
              <% } else { %>
                <p class="text-xs font-semibold" style="color:var(--theme-text-muted)"><%= t('permCategorySettings') %></p>
              <% } %>
              <button type="button" class="edit-select-category al-btn-ghost al-btn-sm" data-category="<%= cat %>"><%= t('selectAll') %></button>            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-1.5 px-4 py-3">
              <% allPermissions.filter(function(p) { return p.value.indexOf(cat) !== -1; }).forEach(function(permission) { %>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox"
                  data-perm="<%= permission.value %>"
                  class="edit-perm h-3.5 w-3.5 rounded focus:ring-[var(--theme-border-accent)]">
                <span class="text-xs transition group-hover:text-[var(--theme-text-strong)]" style="color:var(--theme-text)"><%= permission.name %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <div class="al-sheet-footer shrink-0">
        <button type="button" data-close-modal class="al-btn-secondary"><%= t('cancel') %></button>
        <button type="submit" class="al-btn-primary ml-auto">
          <%- icon('save', { class: 'size-3', strokeWidth: 1.5 }) %>
          <%= t('apiKeySaveChanges') %>
        </button>
      </div>
    </form>
  </div>
</div>

<% if (created) { %>
<div id="createdKeyModal" class="al-sheet-overlay" role="dialog" aria-modal="true" aria-labelledby="createdKeyTitle" style="display:none;">
  <div class="al-sheet-panel rounded-2xl max-w-md w-full shadow-xl" style="background:var(--theme-bg-card);">
    <div class="al-sheet-header">
      <h3 id="createdKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('apiKeyCreatedTitle') %></h3>
      <button type="button" class="al-btn-ghost al-btn-icon-only shrink-0" data-close-modal aria-label="<%= t('ariaClose') %>">
        <%- icon('x', { class: 'w-5 h-5' }) %>
      </button>
    </div>
    <div class="px-5 py-4">
      <p class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= t('apiKeyCopyNotice') %></p>
      <div class="al-code-wrap">
        <code class="al-code block break-all"><%= created %></code>
      </div>
    </div>
    <div class="al-sheet-footer">
      <button type="button" data-close-modal class="al-btn-secondary"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('close') %></button>
      <button type="button" id="copyCreatedKeyBtn" class="al-btn-primary ml-auto"><%- icon('copy', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('apiKeyCopyKeyBtn') %></button>
    </div>
  </div>
</div>
<% } %>

<script nonce="<%- nonce %>">
(function() {
  var createForm = { name: '', description: '', permissions: [] };
  var editForm = { id: 0, name: '', description: '', permissions: [] };
  var activePreset = null;
  var createdKey = '<%= typeof created !== "undefined" ? created : "" %>';
  var selectedCountTpl = <%- JSON.stringify(t('permSelectedCount')) %>;

  var presetPermissions = {
    'full-admin': ['airlink.api.servers.read','airlink.api.servers.create','airlink.api.servers.update','airlink.api.servers.delete','airlink.api.users.read','airlink.api.users.create','airlink.api.users.update','airlink.api.users.delete','airlink.api.nodes.read','airlink.api.nodes.create','airlink.api.nodes.update','airlink.api.nodes.delete','airlink.api.settings.read','airlink.api.settings.update'],
    'read-only': ['airlink.api.servers.read','airlink.api.users.read','airlink.api.nodes.read','airlink.api.settings.read'],
    'server-manager': ['airlink.api.servers.read','airlink.api.servers.create','airlink.api.servers.update','airlink.api.servers.delete','airlink.api.nodes.read'],
    'user-manager': ['airlink.api.users.read','airlink.api.users.create','airlink.api.users.update','airlink.api.users.delete','airlink.api.servers.read'],
    'node-monitor': ['airlink.api.nodes.read','airlink.api.servers.read'],
    'none': []
  };

  var allPermissions = <%- JSON.stringify(allPermissions) %>;

  function showModal(id) { document.getElementById(id).style.display = ''; document.body.style.overflow = 'hidden'; }
  function hideModal(id) { document.getElementById(id).style.display = 'none'; document.body.style.overflow = ''; }

  function applyPreset(name) {
    activePreset = name;
    createForm.permissions = [].concat(presetPermissions[name] || []);
    document.querySelectorAll('.preset-btn').forEach(function(btn) {
      btn.classList.toggle('al-chip-accent', btn.dataset.preset === name);
    });
    syncCreatePermCheckboxes();
  }

  function toggleCreatePerm(perm) {
    var idx = createForm.permissions.indexOf(perm);
    if (idx === -1) createForm.permissions.push(perm);
    else createForm.permissions.splice(idx, 1);
    syncCreatePermCheckboxes();
  }

  function syncCreatePermCheckboxes() {
    document.querySelectorAll('.create-perm').forEach(function(cb) {
      cb.checked = createForm.permissions.indexOf(cb.dataset.perm) !== -1;
    });
    updateCategoryCounts('create');
  }

  function toggleEditPerm(perm) {
    var idx = editForm.permissions.indexOf(perm);
    if (idx === -1) editForm.permissions.push(perm);
    else editForm.permissions.splice(idx, 1);
    syncEditPermCheckboxes();
  }

  function syncEditPermCheckboxes() {
    document.querySelectorAll('.edit-perm').forEach(function(cb) {
      cb.checked = editForm.permissions.indexOf(cb.dataset.perm) !== -1;
    });
    updateCategoryCounts('edit');
  }

  function updateCategoryCounts(prefix) {
    var perms = prefix === 'create' ? createForm.permissions : editForm.permissions;
    ['servers','users','nodes','settings'].forEach(function(cat) {
      var count = perms.filter(function(p) { return p.indexOf(cat) !== -1; }).length;
      var el = document.querySelector('.category-count[data-category="' + cat + '"]');
      if (el) el.textContent = selectedCountTpl.replace('{{count}}', count);
    });
  }

  async function submitCreate() {
    try {
      var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
      var params = new URLSearchParams();
      params.append('name', document.getElementById('name').value);
      params.append('description', document.getElementById('description').value);
      createForm.permissions.forEach(function(p) { params.append('permissions', p); });
      var res = await fetch('/admin/apikeys/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrfToken },
        body: params,
      });
      if (res.redirected) {
        window.location.href = res.url;
      } else if (res.ok) {
        window.location.reload();
      } else {
        var data = await res.json().catch(function() { return {}; });
        showToast(data.error || <%- JSON.stringify(t('apiKeyCreateFailed')) %>, 'error');
      }
    } catch (e) { showToast(<%- JSON.stringify(t('networkError')) %>, 'error'); }
  }

  async function submitEdit() {
    try {
      var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
      var params = new URLSearchParams();
      params.append('name', document.getElementById('edit-name').value);
      params.append('description', document.getElementById('edit-description').value);
      editForm.permissions.forEach(function(p) { params.append('permissions', p); });
      var res = await fetch('/admin/apikeys/edit/' + editForm.id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrfToken },
        body: params,
      });
      if (res.redirected) {
        window.location.href = res.url;
      } else if (res.ok) {
        window.location.reload();
      } else {
        var data = await res.json().catch(function() { return {}; });
        showToast(data.error || <%- JSON.stringify(t('apiKeyUpdateFailed')) %>, 'error');
      }
    } catch (e) { showToast(<%- JSON.stringify(t('networkError')) %>, 'error'); }
  }

  async function deleteKey(keyId) {
    try {
      var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
      var res = await fetch('/admin/apikeys/delete/' + keyId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrfToken }
      });
      if (res.redirected) {
        window.location.href = res.url;
      } else if (res.ok) {
        window.location.reload();
      } else {
        var data = await res.json().catch(function() { return {}; });
        showToast(data.error || <%- JSON.stringify(t('apiKeyDeleteFailed')) %>, 'error');
      }
    } catch (e) { showToast(<%- JSON.stringify(t('networkError')) %>, 'error'); }
  }

  function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(function() {
      showToast(<%- JSON.stringify(t('apiKeyCopied')) %>, 'success');
    }).catch(function() {
      showToast(<%- JSON.stringify(t('apiKeyCopyFailed')) %>, 'error');
    });
  }

  // Event listeners
  document.querySelectorAll('#openCreateApiKeyModal, [data-open-create-apikey]').forEach(function(el) {
    el.addEventListener('click', function() { showModal('createApiKeyModal'); });
  });

  document.querySelectorAll('.al-sheet-overlay').forEach(function(overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === this && this.style.display !== 'none') hideModal(this.id);
    });
  });

  document.getElementById('createApiKeyForm').addEventListener('submit', function(e) { e.preventDefault(); submitCreate(); });

  document.getElementById('editApiKeyForm').addEventListener('submit', function(e) { e.preventDefault(); submitEdit(); });

  document.querySelectorAll('[data-close-modal]').forEach(function(el) {
    el.addEventListener('click', function() {
      var overlay = this.closest('.al-sheet-overlay');
      if (overlay && overlay.id) hideModal(overlay.id);
    });
  });

  document.querySelectorAll('.preset-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { applyPreset(this.dataset.preset); });
  });

  document.querySelectorAll('.category-toggle[data-category]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var panel = document.querySelector('[data-create-category="' + this.dataset.category.replace('create_', '') + '"]');
      if (panel) panel.classList.toggle('open');
    });
  });

  document.querySelectorAll('.create-perm').forEach(function(cb) {
    cb.addEventListener('change', function() { toggleCreatePerm(this.dataset.perm); });
  });

  document.querySelectorAll('.edit-perm').forEach(function(cb) {
    cb.addEventListener('change', function() { toggleEditPerm(this.dataset.perm); });
  });

  document.getElementById('editSelectAllBtn').addEventListener('click', function() {
    editForm.permissions = allPermissions.map(function(p) { return p.value; });
    syncEditPermCheckboxes();
  });

  document.getElementById('editSelectNoneBtn').addEventListener('click', function() {
    editForm.permissions = [];
    syncEditPermCheckboxes();
  });

  document.getElementById('editSelectReadOnlyBtn').addEventListener('click', function() {
    editForm.permissions = allPermissions.filter(function(p) { return p.value.indexOf('.read') !== -1; }).map(function(p) { return p.value; });
    syncEditPermCheckboxes();
  });

  document.querySelectorAll('.edit-select-category').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var cat = this.dataset.category;
      var catPerms = allPermissions.filter(function(p) { return p.value.indexOf(cat) !== -1; }).map(function(p) { return p.value; });
      var allChecked = catPerms.every(function(p) { return editForm.permissions.indexOf(p) !== -1; });
      if (allChecked) {
        editForm.permissions = editForm.permissions.filter(function(p) { return catPerms.indexOf(p) === -1; });
      } else {
        catPerms.forEach(function(p) { if (editForm.permissions.indexOf(p) === -1) editForm.permissions.push(p); });
      }
      syncEditPermCheckboxes();
    });
  });

  // Expose for external callers
  window.showEditModal = function(id, name, desc, perms) {
    try { perms = typeof perms === 'string' ? JSON.parse(perms) : perms; } catch(e) { perms = []; }
    editForm = { id: id, name: name, description: desc || '', permissions: [].concat(perms) };
    document.getElementById('edit-name').value = name;
    document.getElementById('edit-description').value = desc || '';
    syncEditPermCheckboxes();
    showModal('editApiKeyModal');
  };

  window.confirmDeleteApiKey = function(keyId) {
    window.modal.confirm({
      title: <%- JSON.stringify(t('apiKeyDeleteTitle')) %>,
      body: <%- JSON.stringify(t('apiKeyDeleteConfirm')) %>,
      danger: true,
      confirmLabel: <%- JSON.stringify(t('apiKeyDeleteAction')) %>,
      onConfirm: function() { deleteKey(keyId); }
    });
  };

  // Show created modal if key was just created
  if (createdKey && document.getElementById('createdKeyModal')) { showModal('createdKeyModal'); }
  if (document.getElementById('copyCreatedKeyBtn')) {
    document.getElementById('copyCreatedKeyBtn').addEventListener('click', function() { copyToClipboard(createdKey); });
  }

  syncCreatePermCheckboxes();
  syncEditPermCheckboxes();
})();
</script>

<%- include('../../layouts/admin-footer') %>
