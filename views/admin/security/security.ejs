<%- include('../../components/header', { title: 'Security' }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="w-60 shrink-0">
      <%- include('../../components/template') %>
    </div>
    <div id="page-content" class="flex-1 overflow-y-auto pt-16 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: 'Admin' },
        { label: 'Security' }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= req.translations.securityTitle || 'Security' %></h1>
          <p class="al-page-desc"><%= req.translations.securityDesc || 'Manage panel security settings, rate limiting, and IP access controls.' %></p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <button type="button" id="saveSecurityBtn" class="al-btn-primary"><%= req.translations.adminSettingsSave || 'Save' %></button>
        </div>
      </div>

      <div class="al-page-body space-y-6 max-w-3xl">

        <!-- Rate Limiting -->
        <div class="al-card overflow-hidden">
          <div class="al-card-header"><%= req.translations.rateLimiting || 'Rate Limiting' %></div>
          <form id="form-rate-limit" class="px-5 py-5 space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300"><%= req.translations.enableRateLimiting || 'Enable rate limiting' %></p>
                <p class="text-xs text-neutral-500 mt-0.5"><%= req.translations.enableRateLimitingDesc || 'Block IPs that exceed the request threshold.' %></p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="rateLimitEnabled" name="rateLimitEnabled" aria-label="<%= req.translations.enableRateLimiting || 'Enable rate limiting' %>" class="sr-only peer" value="true" <%= settings && settings.rateLimitEnabled ? 'checked' : '' %>>
                <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
              </label>
            </div>
            <div>
              <label for="rateLimitRpm" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5"><%= req.translations.requestsPerMinute || 'Requests per minute' %></label>
              <input type="number" id="rateLimitRpm" name="rateLimitRpm" min="1" max="10000" value="<%= settings ? settings.rateLimitRpm : 500 %>"
                class="al-input w-40">
            </div>

          </form>
        </div>

        <!-- IP Bans -->
        <div class="al-card overflow-hidden">
          <div class="al-card-header"><%= req.translations.bannedIps || 'Banned IPs' %></div>
          <div class="px-5 py-5 space-y-4">
            <div class="flex gap-2">
              <input type="text" id="ban-ip-input" placeholder="<%= req.translations.banIpPlaceholder || 'e.g. 192.168.1.100' %>"
                class="al-input flex-1">
              <button id="ban-ip-btn" type="button"
                class="al-btn-primary px-4 py-2 text-sm font-medium rounded-xl transition whitespace-nowrap">
                <%= req.translations.banIp || 'Ban IP' %>
              </button>
            </div>

            <% if (bannedIps && bannedIps.length > 0) { %>
              <ul id="banned-list" class="space-y-1.5">
                <% bannedIps.forEach(ip => { %>
                    <li class="flex items-center justify-between px-3 py-2 rounded-lg text-sm" style="background:var(--theme-bg-card);border:1px solid var(--theme-border)" data-ip="<%= ip %>">
                    <span class="font-mono text-xs" style="color:var(--theme-text-strong)"><%= ip %></span>
                    <button type="button" class="unban-btn text-xs" style="color:var(--theme-danger)"><%= req.translations.remove || 'Remove' %></button>
                  </li>
                <% }); %>
              </ul>
            <% } else { %>
              <p id="no-bans-msg" class="text-xs text-neutral-400"><%= req.translations.noBannedIps || 'No IPs are currently banned.' %></p>
            <% } %>
          </div>
        </div>


      </div>
    </div>
  </div>
</main>

<%- include('../../components/toast') %>

<script nonce="<%- nonce %>" src="/javascript/admin/admin-security.js"></script>

<%- include('../../components/footer') %>
