<%- include('../../layouts/admin', { title: t('securityTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('securityTitle') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('securityTitle') %></h1>
    <p class="al-page-desc"><%= t('securityDesc') %></p>
  </div>
</div>

<div class="al-page-body" data-al-tabs data-tabs-default="overview" data-tabs-hash>

  <div role="tablist" class="flex gap-1 mb-6 flex-wrap">
    <button type="button" role="tab" aria-selected="true" aria-controls="panel-overview" id="tab-overview" data-tab="overview" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('shield', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('overview') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-2fa" id="tab-2fa" data-tab="2fa" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('key-round', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('twoFa') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-captcha" id="tab-captcha" data-tab="captcha" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('bot', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('captcha') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-logins" id="tab-logins" data-tab="logins" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('log-in', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('logins') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-passwords" id="tab-passwords" data-tab="passwords" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('lock', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('passwords') %></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="panel-registration" id="tab-registration" data-tab="registration" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('user-plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('registration') %></button>
  </div>

  <!-- Overview -->
  <div id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" data-tab-panel="overview" class="tab-panel space-y-5">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="al-card">
        <div class="flex items-center gap-3">
          <span class="al-icon-tile al-icon-tile-success"><%- icon('shield-check', { class: 'size-5' }) %></span>
          <div class="min-w-0">
            <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);"><%= t('securityStatusActive') %></p>
            <p class="text-xs mt-1" style="color:var(--theme-text-muted);"><%= t('securityStatusLabel') %></p>
          </div>
        </div>
      </div>
      <div class="al-card">
        <div class="flex items-center gap-3">
          <span class="al-icon-tile al-icon-tile-info"><%- icon('key-round', { class: 'size-5' }) %></span>
          <div class="min-w-0">
            <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);"><%= settings.require2faForAdmins ? t('requiredLabel') : t('optionalLabel') %></p>
            <p class="text-xs mt-1" style="color:var(--theme-text-muted);"><%= t('admin2faLabel') %></p>
          </div>
        </div>
      </div>
      <div class="al-card">
        <div class="flex items-center gap-3">
          <span class="al-icon-tile al-icon-tile-warning"><%- icon('ban', { class: 'size-5' }) %></span>
          <div class="min-w-0">
            <% let bannedCount = 0; try { bannedCount = JSON.parse(settings.bannedIps || '[]').length; } catch(e) {} %>
            <p class="text-2xl font-semibold leading-none tabular-nums" style="color:var(--theme-text-strong);"><%= bannedCount %></p>
            <p class="text-xs mt-1" style="color:var(--theme-text-muted);"><%= t('bannedIps') %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2FA -->
  <div id="panel-2fa" role="tabpanel" aria-labelledby="tab-2fa" data-tab-panel="2fa" class="tab-panel space-y-5" hidden>
    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('twoFactorAuthTitle') %></p>
      </div>
      <div class="al-card-body">
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('require2faForAdmins') %></p>
            <p class="al-setting-desc"><%= t('require2faForAdminsDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="require2faForAdmins" class="sr-only peer" aria-label="<%= t('require2faForAdmins') %>" <%= settings.require2faForAdmins ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('require2faForAllUsers') %></p>
            <p class="al-setting-desc"><%= t('require2faForAllUsersDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="twoFactorRequired" class="sr-only peer" aria-label="<%= t('require2faForAllUsers') %>" <%= settings.twoFactorRequired ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- CAPTCHA -->
  <div id="panel-captcha" role="tabpanel" aria-labelledby="tab-captcha" data-tab-panel="captcha" class="tab-panel space-y-5" hidden>
    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('captchaConfigTitle') %></p>
          <p class="al-card-header-desc"><%= t('enableCaptchaDesc') %></p>
        </div>
      </div>
      <div class="al-card-body">
        <div class="al-setting-row mb-5">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('enableCaptcha') %></p>
            <p class="al-setting-desc"><%= t('enableCaptchaDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="captchaEnabled" class="sr-only peer" aria-label="<%= t('enableCaptcha') %>" <%= settings.captchaEnabled ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <%- include('../../partials/ui/form-field', {
            type: 'select', name: 'captchaProvider', id: 'captchaProvider',
            label: t('captchaProviderLabel'), value: settings.captchaProvider || 'google-recaptcha',
            options: [
              { value: 'google-recaptcha', label: t('captchaOptGoogle') },
              { value: 'hcaptcha', label: t('captchaOptHcaptcha') },
              { value: 'turnstile', label: t('captchaOptTurnstile') }
            ]
          }) %>
          <%- include('../../partials/ui/form-field', {
            type: 'text', name: 'captchaSiteKey', id: 'captchaSiteKey',
            label: t('captchaSiteKeyLabel'), value: settings.captchaSiteKey || '', autocomplete: 'off'
          }) %>
          <%- include('../../partials/ui/form-field', {
            type: 'password', name: 'captchaSecretKey', id: 'captchaSecretKey',
            label: t('captchaSecretKeyLabel'), value: settings.captchaSecretKey || '', autocomplete: 'off'
          }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Logins -->
  <div id="panel-logins" role="tabpanel" aria-labelledby="tab-logins" data-tab-panel="logins" class="tab-panel space-y-5" hidden>
    <div class="al-card">
      <div class="al-card-header">
        <div class="min-w-0">
          <p class="al-card-header-title"><%= t('loginProtection') %></p>
          <p class="al-card-header-desc"><%= t('bruteForceConfigDesc') %></p>
        </div>
      </div>
      <div class="al-card-body grid grid-cols-1 sm:grid-cols-2 gap-5">
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'loginMaxAttempts', id: 'loginMaxAttempts',
          label: t('maxFailedAttempts'), value: settings.loginMaxAttempts ?? 5, min: '1', max: '100'
        }) %>
        <%- include('../../partials/ui/form-field', {
          type: 'number', name: 'loginLockoutMinutes', id: 'loginLockoutMinutes',
          label: t('lockoutDurationMinutes'), value: settings.loginLockoutMinutes ?? 15, min: '1', max: '1440'
        }) %>
      </div>
    </div>
  </div>

  <!-- Passwords -->
  <div id="panel-passwords" role="tabpanel" aria-labelledby="tab-passwords" data-tab-panel="passwords" class="tab-panel space-y-5" hidden>
    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('passwordPolicyTitle') %></p>
      </div>
      <div class="al-card-body">
        <div class="mb-5">
          <%- include('../../partials/ui/form-field', {
            type: 'number', name: 'minPasswordLength', id: 'minPasswordLength',
            label: t('minPasswordLengthLabel'), value: settings.minPasswordLength || 8, min: '6', max: '128',
            wrapperCls: 'max-w-xs'
          }) %>
        </div>
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('requireUppercaseLabel') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="requireUppercase" class="sr-only peer" aria-label="<%= t('requireUppercaseLabel') %>" <%= settings.requireUppercase !== false ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('requireNumbersLabel') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="requireNumbers" class="sr-only peer" aria-label="<%= t('requireNumbersLabel') %>" <%= settings.requireNumbers !== false ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('requireSpecialLabel') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="requireSpecial" class="sr-only peer" aria-label="<%= t('requireSpecialLabel') %>" <%= settings.requireSpecial !== false ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Registration -->
  <div id="panel-registration" role="tabpanel" aria-labelledby="tab-registration" data-tab-panel="registration" class="tab-panel space-y-5" hidden>
    <div class="al-card">
      <div class="al-card-header">
        <p class="al-card-header-title"><%= t('registrationSettingsTitle') %></p>
      </div>
      <div class="al-card-body">
        <div class="al-setting-row">
          <div class="al-setting-copy">
            <p class="al-setting-title"><%= t('allowPublicRegistration') %></p>
            <p class="al-setting-desc"><%= t('allowPublicRegistrationDesc') %></p>
          </div>
          <label class="al-setting-control">
            <input type="checkbox" id="allowRegistration" class="sr-only peer" aria-label="<%= t('allowPublicRegistration') %>" <%= settings.allowRegistration ? 'checked' : '' %>>
            <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
          </label>
        </div>
      </div>
    </div>
  </div>

</div>

<script nonce="<%- nonce %>">
(function() {
  var csrfToken = '<%= csrfToken %>';
  var msgSaved = <%- JSON.stringify(t('securitySettingsSavedMsg')) %>;
  var msgFailed = <%- JSON.stringify(t('failedToSave')) %>;

  function collectSecurity() {
    return {
      require2faForAdmins: document.getElementById('require2faForAdmins')?.checked || false,
      twoFactorRequired: document.getElementById('twoFactorRequired')?.checked || false,
      captchaEnabled: document.getElementById('captchaEnabled')?.checked || false,
      captchaProvider: document.getElementById('captchaProvider')?.value || '',
      captchaSiteKey: document.getElementById('captchaSiteKey')?.value || '',
      captchaSecretKey: document.getElementById('captchaSecretKey')?.value || '',
      loginMaxAttempts: parseInt(document.getElementById('loginMaxAttempts')?.value || '5', 10),
      loginLockoutMinutes: parseInt(document.getElementById('loginLockoutMinutes')?.value || '15', 10),
      minPasswordLength: parseInt(document.getElementById('minPasswordLength')?.value || '8', 10),
      requireUppercase: document.getElementById('requireUppercase')?.checked ?? true,
      requireNumbers: document.getElementById('requireNumbers')?.checked ?? true,
      requireSpecial: document.getElementById('requireSpecial')?.checked ?? true,
      allowRegistration: document.getElementById('allowRegistration')?.checked || false,
    };
  }

  document.querySelectorAll('.al-page-body input, .al-page-body select').forEach(function(el) {
    el.addEventListener('change', function() {
      var data = collectSecurity();
      fetch('/admin/settings/security', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify(data),
      }).then(function(r) { return r.json(); }).then(function(res) {
        if (res.success) { showToast(msgSaved, 'success'); }
        else { showToast(res.message || msgFailed, 'error'); }
      }).catch(function() { showToast(msgFailed, 'error'); });
    });
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
