<%- include('../../layouts/admin', { title: t('menuManagerTitle') }) %>

<%- include('../../partials/flash-messages') %>

<div class="al-page-crumbs">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('menuManagerTitle') }
  ] }) %>
</div>

<div class="al-page-header">
  <div>
    <h1 class="al-page-title"><%= t('menuManagerTitle') %></h1>
    <p class="al-page-desc"><%= t('menuManagerDesc') %></p>
  </div>
</div>

<div class="al-page-body">
  <section class="al-section">
    <div class="al-section-head">
      <h2 class="al-section-title"><%= t('menuSectionTitle') %></h2>
    </div>
    <div class="al-table-wrapper">
      <table class="al-table al-table-card">
        <thead class="al-table-thead">
          <tr>
            <th scope="col" class="al-table-th"><%= t('menuColumnItem') %></th>
            <th scope="col" class="al-table-th"><%= t('menuColumnUrl') %></th>
            <th scope="col" class="al-table-th"><%= t('menuColumnGroup') %></th>
            <th scope="col" class="al-table-th"><%= t('menuColumnPriority') %></th>
            <th scope="col" class="al-table-th"><%= t('default') %></th>
          </tr>
        </thead>
        <tbody id="menuTableBody" class="al-table-tbody">
          <% if (Array.isArray(items) && items.length > 0) { %>
            <% items.forEach(function(item) { %>
              <tr class="al-table-tr">
                <td class="al-table-td al-table-cell-strong" data-label="<%= t('menuColumnItem') %>"><%= item.label %></td>
                <td class="al-table-td font-mono text-xs" data-label="<%= t('menuColumnUrl') %>"><%= item.url %></td>
                <td class="al-table-td text-xs" data-label="<%= t('menuColumnGroup') %>"><%= item.group || '—' %></td>
                <td class="al-table-td text-xs tabular-nums" data-label="<%= t('menuColumnPriority') %>"><%= item.priority %></td>
                <td class="al-table-td" data-label="<%= t('default') %>">
                  <% if (item.isDefault) { %>
                    <span class="al-badge al-badge-online"><%= t('default') %></span>
                  <% } else { %>
                    <span class="al-badge al-badge-neutral"><%= t('menuCustom') %></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else if (Array.isArray(items)) { %>
            <tr><td colspan="5" class="al-table-td al-table-empty py-6"><%= t('menuNoItems') %></td></tr>
          <% } else { %>
            <tr><td colspan="5" class="al-table-td al-table-empty py-6"><%= t('loading') %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<script nonce="<%- nonce %>">
(function() {
  var items = <%- JSON.stringify(items || []) %>;
  var tbody = document.getElementById('menuTableBody');
  var strItem = <%- JSON.stringify(t('menuColumnItem')) %>;
  var strUrl = <%- JSON.stringify(t('menuColumnUrl')) %>;
  var strGroup = <%- JSON.stringify(t('menuColumnGroup')) %>;
  var strPriority = <%- JSON.stringify(t('menuColumnPriority')) %>;
  var strDefault = <%- JSON.stringify(t('default')) %>;
  var strCustom = <%- JSON.stringify(t('menuCustom')) %>;
  var strNoItems = <%- JSON.stringify(t('menuNoItems')) %>;

  if (items.length === 0) {
    tbody.innerHTML = '<tr><td colspan="5" class="al-table-td al-table-empty py-6">' + strNoItems + '</td></tr>';
    return;
  }

  tbody.innerHTML = items.map(function(item) {
    var badge = item.isDefault
      ? '<span class="al-badge al-badge-online">' + strDefault + '</span>'
      : '<span class="al-badge al-badge-neutral">' + strCustom + '</span>';
    return '<tr class="al-table-tr">' +
      '<td class="al-table-td al-table-cell-strong" data-label="' + strItem + '">' + item.label + '</td>' +
      '<td class="al-table-td font-mono text-xs" data-label="' + strUrl + '">' + item.url + '</td>' +
      '<td class="al-table-td text-xs" data-label="' + strGroup + '">' + (item.group || '—') + '</td>' +
      '<td class="al-table-td text-xs tabular-nums" data-label="' + strPriority + '">' + item.priority + '</td>' +
      '<td class="al-table-td" data-label="' + strDefault + '">' + badge + '</td></tr>';
  }).join('');
})();
</script>

<%- include('../../layouts/admin-footer') %>
