<% /* search-overlay — the panel-wide command/search dialog.
   Opened by any [data-search-trigger] (desktop topbar pill, phone top bar);
   bound by public/javascript/shared/search.js.

   Copy comes from the live catalog: the dialog's aria-label, the combobox
   label, the listbox label, the footer key hints and the no-results state
   (data-empty-title / data-empty-hint are read by search.js) must all be
   translated — never hardcoded here. The search.js result labels are
   resolved below and merged into window.__i18n, which tx()/txAdmin()
   read first. */ %>
<div id="colcont">
  <div id="searchOverlay" class="al-sheet-overlay fixed inset-0 z-50 hidden items-start justify-center p-4 pt-[14vh] backdrop-blur-[8px]"
    role="dialog" aria-modal="true" aria-label="<%= t('navSearch') %>"
    data-empty-title="<%= t('searchEmptyTitle') %>"
    data-empty-hint="<%= t('searchEmptyHint') %>">
    <div id="searchPanel" class="al-sheet-panel w-full max-w-xl rounded-2xl border overflow-hidden shadow-2xl"
      style="border-color:var(--theme-border); background:var(--theme-bg-card);">
      <div class="flex items-center gap-3 px-4 py-3.5 border-b" style="border-color:var(--theme-border);">
        <%- icon('search', { class: 'h-5 w-5 shrink-0', style: 'color:var(--theme-text-muted)' }) %>
        <input id="searchInput" type="text" aria-label="<%= t('navSearch') %>"
          placeholder="<%= t('navSearch') %>..."
          class="flex-1 bg-transparent text-sm min-w-0"
          style="color:var(--theme-text-strong);"
          role="combobox" aria-autocomplete="list" aria-expanded="false"
          aria-controls="searchResults" aria-activedescendant=""
          autocomplete="off" spellcheck="false">
        <span aria-hidden="true" class="al-kbd hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium">ESC</span>
      </div>
      <div id="searchResults" role="listbox" aria-label="<%= t('searchResultsLabel') %>" class="p-2 max-h-[45vh] overflow-y-auto"></div>
      <div class="hidden sm:flex items-center gap-4 px-4 py-2.5 border-t text-[11px]" style="border-color:var(--theme-border); color:var(--theme-text-muted);">
        <span class="flex items-center gap-1.5"><kbd class="al-kbd px-1 py-0.5 text-[10px] font-medium">&#8593;&#8595;</kbd> <%= t('searchHintNavigate') %></span>
        <span class="flex items-center gap-1.5"><kbd class="al-kbd px-1 py-0.5 text-[10px] font-medium">Enter</kbd> <%= t('searchHintOpen') %></span>
        <span class="flex items-center gap-1.5"><kbd class="al-kbd px-1 py-0.5 text-[10px] font-medium">Esc</kbd> <%= t('searchHintClose') %></span>
      </div>
    </div>
  </div>
</div>
<%
  /* Every catalog key search.js resolves through tx()/txAdmin(), resolved
     here from the live catalog so the script ships no English defaults and
     every locale sees the same strings the sidebar renders. layouts/base.ejs
     only serialises a locale's own overrides (and nothing for `en`), so this
     merge is what actually fills the gaps. */
  const searchLabelKeys = [
    'admin', 'adminAddonsTitle', 'adminAnalyticsTitle', 'adminCreateImageTitle',
    'adminCreateNodeTitle', 'adminCreateServerTitle', 'adminCreateUserTitle',
    'adminImagesTitlePage', 'adminNodesTitle', 'adminOverviewTitle',
    'adminPlayerStatsTitle', 'adminRadarTitle', 'adminServersTitle',
    'adminSettingsTitle', 'adminUsersTitle', 'addonStoreTitle', 'apiDocs',
    'createServer', 'features', 'imageStoreTitle', 'navAccount',
    'navAirlinkCloud', 'navApiKeys', 'navDashboard', 'navMenu', 'navPages',
    'navServers', 'nodes', 'remove', 'searchEmptyHint', 'searchEmptyTitle',
    'searchQuickLinks', 'searchRecent', 'security', 'servers', 'uploadImage',
    'users'
  ];
  const searchLabels = {};
  searchLabelKeys.forEach(function (k) { searchLabels[k] = t(k); });
%>
<script nonce="<%- nonce %>">window.__i18n = Object.assign(window.__i18n || {}, <%- JSON.stringify(searchLabels) %>);</script>
<script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/search.js') %>?v=7"></script>
