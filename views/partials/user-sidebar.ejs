<!-- User sidebar — navigation for user-facing pages -->
<div id="pc-sidebar" class="sidebar hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-56 lg:flex-col left-0">
  <div id="pc-sidebar2" class="flex flex-col h-full">

    <!-- Static top: logo -->
    <div id="sidebar-logo-block" class="pl-6 pt-4 pb-4 flex min-w-0 shrink-0">
      <a href="/" id="sidebar-logo-link" class="flex items-center min-w-0">
        <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>" alt="<%= t('logoAlt') %>"
          class="logo-bg p-1 h-10 w-10 rounded-xl mr-3 shrink-0 inline-flex"
          style="background:var(--theme-logo-bg);">
        <div class="sidebar-label font-medium tracking-tight text-lg truncate min-w-0"
          style="color:var(--theme-text-strong);">
          <%= settings.title || t('brandName') %>
        </div>
      </a>
    </div>

    <!-- User info -->
    <% if (typeof user !== 'undefined' && user != null) { %>
      <a href="/account" id="sidebar-account-link"
        class="sidebar-special-link flex items-center space-x-4 py-4 px-4 border-y shrink-0 transition-colors group"
        style="border-color:var(--theme-nav-border);">
        <img loading="lazy" decoding="async" class="h-8 w-8 rounded-xl shrink-0"
          src="<%= user.avatar ? user.avatar : '/avatar/' + encodeURIComponent(user.username) %>" alt="<%= t('userAvatarAlt') %>">
        <div class="min-w-0">
          <p class="sidebar-account-name text-sm font-medium truncate transition-colors" style="color:var(--theme-text-strong);">
            <span id="sidebar-username"><%= user.username %></span>
            <span class="text-xs" style="color:var(--theme-text-muted);"><sup class="mt-1">#<%= String(user.id).padStart(4, '0') %></sup></span>
          </p>
          <p id="sidebar-description" class="text-xs truncate" style="color:var(--theme-text-muted);"><%= user.description %></p>
        </div>
      </a>
    <% } %>

    <!-- Scrollable nav -->
    <nav class="flex-1 overflow-y-auto">
      <ul role="list" class="py-1.5">
        <li>
          <ul role="list" class="-mx-2 space-y-1 relative">
            <div id="active-background"
              class="ml-1.5 absolute left-2 w-[calc(97%-1.5rem)] h-10 transition-none duration-0 z-[-1] rounded-xl opacity-0">
            </div>
            <%
            const sidebarItems = regularMenuItems || (global.uiComponentStore ? global.uiComponentStore.getSidebarItems(undefined, false) : []);
            const isServerPage = (typeof server !== 'undefined' && server && typeof req !== 'undefined' && req && (req.path || req.originalUrl || '').startsWith('/server/'));
            %>
            <div id="sidebar-main-view" class="sidebar-view<%= isServerPage ? ' hidden' : '' %>">
              <% if (!sidebarItems || sidebarItems.length === 0) { %>
                <li class="nav-item sidebar-view-item">
                  <a href="/"
                    class="nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal"
                    <% if (req.path === '/') { %> aria-current="page"<% } %>>
                    <%- icon('layout-dashboard', { class: 'w-5 h-5 mt-0.5' }) %>
                    <span><%= t('backToDashboard') %></span>
                  </a>
                </li>
              <% } else { %>
                <% sidebarItems.forEach(function(item, i) { %>
                  <% const isCurrentPath = (req.path === item.url) || (item.matchPrefix && req.path.startsWith(item.matchPrefix)); %>
                  <li class="nav-item sidebar-view-item" style="--i:<%= i + 1 %>">
                    <a href="<%= item.url %>"
                      class="nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal"
                      <% if (item.matchPrefix) { %> data-match-prefix="<%= item.matchPrefix %>"<% } %>
                      <% if (isCurrentPath) { %> aria-current="page"<% } %>>
                      <%- item.icon %>
                      <span><%= item.label %></span>
                    </a>
                  </li>
                <% }); %>
              <% } %>

              <!-- Admin section (only for admins) -->
              <% if (typeof user !== 'undefined' && user != null && user.isAdmin === true) { %>
                <% const adminGroups = adminSidebarGroups || []; %>
                <% if (adminGroups.length > 0) { %>
                  <p class="pl-8 text-xs font-medium pt-6 pb-2" style="color:var(--theme-nav-text);">
                    <span><%= t('navAdminPanel') %></span>
                  </p>
                  <% let adminAnimIdx = 0; %>
                  <% adminGroups.forEach(function(group) { %>
                    <% group.items.forEach(function(item) { %>
                      <li class="sidebar-view-item" style="--i:<%= adminAnimIdx++ %>">
                        <a href="<%= item.url %>"
                          class="nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal"
                          <% if (item.matchPrefix) { %> data-match-prefix="<%= item.matchPrefix %>"<% } %>
                          <% if (req.path === item.url) { %> aria-current="page"<% } %>>
                          <%- item.icon %>
                          <span><%= item.label %></span>
                        </a>
                      </li>
                    <% }); %>
                  <% }); %>
                <% } %>
              <% } %>
            </div>

            <% if (isServerPage && global.uiComponentStore) {
              const srvMenuItems = global.uiComponentStore.getServerMenuItems();
              const srvIsAdmin = (typeof user !== 'undefined' && user && user.isAdmin === true);
              const srvIsSub = (typeof req !== 'undefined' && req && req.subUser) ? true : false;
              // `navFeatures` (published by isAuthenticatedForServer): null =
              // image declares nothing, so hide nothing; an array filters.
              const srvEntries = srvMenuItems.filter(function(item) {
                if (item.isAdminItem && !srvIsAdmin) return false;
                if (item.ownerOnly && srvIsSub) return false;
                if (item.feature && typeof navFeatures !== 'undefined' && Array.isArray(navFeatures) && navFeatures.indexOf(item.feature) === -1) return false;
                return true;
              }).map(function(item) {
                return { item, url: (item.url || '#').replace(':uuid', server.UUID).replace(':id', server.id) };
              });
              const srvGroupOrder = ['run', 'data', 'manage', 'settings'];
              const srvGrouped = srvGroupOrder
                .map(function(g) { return { g: g, entries: srvEntries.filter(function(e) { return (e.item.group || 'manage') === g; }) }; })
                .filter(function(grp) { return grp.entries.length > 0; });
              if (srvGrouped.length > 0) {
                let srvAnimIdx = 0;
            %>
            <div id="sidebar-server-view" class="sidebar-view showing">
              <li class="nav-item">
                <a href="/"
                  class="nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal"
                  data-match-prefix="/server">
                  <%- icon('layout-dashboard', { class: 'w-5 h-5 mt-0.5' }) %>
                  <span><%= t('backToDashboard') %></span>
                </a>
              </li>
              <% srvGrouped.forEach(function(grp) { %>
                <% grp.entries.forEach(function(entry) { %>
                  <li class="nav-item server-anim-in" style="--i:<%= srvAnimIdx++ %>">
                    <a href="<%= entry.url %>"
                      class="nav-link mt-1 px-4 mx-4 group flex gap-x-3 py-1.5 rounded-xl text-sm leading-6 font-normal"
                      data-server-control-link>
                      <%- entry.item.icon.replace(/class="[^" ]*"/, 'class="w-5 h-5 mt-0.5 shrink-0"') %>
                      <span><%= entry.item.label %></span>
                    </a>
                  </li>
                <% }); %>
              <% }); %>
            </div>
            <% } %>
            <% } %>

          </ul>
        </li>
      </ul>
    </nav>

    <!-- Static bottom: logout -->
    <div class="shrink-0 border-t" style="border-color:var(--theme-nav-border);">
      <a href="/logout" id="sidebar-logout-link"
        class="sidebar-special-link sidebar-logout group flex gap-x-3 pl-6 py-4 text-sm font-medium leading-6 transition-colors duration-200">
        <%- icon('log-out', { class: 'w-5 h-5 mt-0.5 shrink-0', strokeWidth: 1.5 }) %>
        <span><%= t('navLogout') %></span>
      </a>
    </div>

  </div>
</div>

<script nonce="<%- nonce %>">
(function () {
  /* Paint only. Which row is active is decided here; the colours live in
     views/styles/components/sidebar.css (`.nav-link.active`, `.sidebar-active`)
     so no hex or inline colour ever ships in this partial. */
  function markActiveNav(path) {
    const srvLinks = document.querySelectorAll('[data-server-control-link]');
    let srvBest = null;
    let bestLen = -1;
    srvLinks.forEach(function (link) {
      link.classList.remove('active');
      const href = link.getAttribute('href') || '';
      const matched = path === href || (href !== '/' && path.startsWith(href + '/'));
      if (matched && href.length > bestLen) { bestLen = href.length; srvBest = link; }
    });
    if (srvBest) { srvBest.classList.add('active'); }

    const links = document.querySelectorAll('.nav-link');
    links.forEach(function (link) {
      if (link.hasAttribute('data-server-control-link')) return;
      const href = link.getAttribute('href');
      const prefix = link.getAttribute('data-match-prefix');
      if (srvBest && prefix && path.startsWith(prefix)) return;
      let active = false;
      if (href && path === href) active = true;
      else if (prefix && path.startsWith(prefix)) active = true;
      else if (href && path.startsWith(href + '/')) active = true;
      link.classList.toggle('active', active);
    });
  }

  function markSpecialLinks(path) {
    const account = document.getElementById('sidebar-account-link');
    if (account) {
      account.classList.toggle('sidebar-active', path === '/account' || path.startsWith('/account/'));
    }
    // The sidebar logo used to highlight on `/credits`; that page is gone,
    // so the logo no longer has an active state of its own.
  }

  if (document.getElementById('pc-sidebar')) {
    document.getElementById('pc-sidebar').style.display = '';
    markSpecialLinks(window.location.pathname);
    markActiveNav(window.location.pathname);
  }

  document.addEventListener('DOMContentLoaded', function () {
    if (!document.getElementById('pc-sidebar')) return;
    markSpecialLinks(window.location.pathname);
    markActiveNav(window.location.pathname);
  });
})();
</script>
