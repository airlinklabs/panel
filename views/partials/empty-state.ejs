<% /* empty-state: { iconName, title, description, action } */ %>
<div class="al-state-panel">
  <div class="al-icon-tile al-icon-tile-lg">
    <%- icon(locals.iconName || 'inbox', { class: 'w-5 h-5' }) %>
  </div>
  <h3 class="mt-3 text-sm font-semibold" style="color:var(--theme-text-strong)"><%= locals.title || t('nothingHere') %></h3>
  <% if (locals.description) { %>
  <p class="mt-1 max-w-xs text-sm" style="color:var(--theme-text-muted)"><%= locals.description %></p>
  <% } %>
  <% if (locals.action) { %>
  <div class="mt-4"><%- locals.action %></div>
  <% } %>
</div>
