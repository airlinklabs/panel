<% /* stat-card: { label, value, href, iconName } */ %>
<a href="<%= locals.href || '#' %>" class="group al-card">
  <div class="mb-3 flex items-center justify-between">
    <div class="al-icon-tile al-icon-tile-sm">
      <%- icon(locals.iconName || 'bar-chart') %>
    </div>
    <%- icon('arrow-right', { class: 'size-3 opacity-0 group-hover:opacity-100 transition-opacity', style: 'color:var(--theme-text-muted)' }) %>
  </div>
  <p class="text-xl font-semibold tabular-nums" style="color:var(--theme-text-strong)"><%= locals.value ?? '\u2014' %></p>
  <p class="mt-0.5 text-xs" style="color:var(--theme-text-muted)"><%= locals.label || '' %></p>
</a>
