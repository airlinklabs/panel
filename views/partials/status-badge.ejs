<% /* status-badge: { status: online|offline|starting|stopping|installing|suspended } */
const s = (locals.status || 'offline').toLowerCase();
const configs = {
  online:     { cls: 'al-badge-online',  dot: 'online',   label: t('online') },
  offline:    { cls: 'al-badge-offline', dot: 'offline',  label: t('offline') },
  starting:   { cls: 'al-badge-warning', dot: 'warning',  label: t('starting') },
  stopping:   { cls: 'al-badge-warning', dot: 'warning',  label: t('stopping') },
  installing: { cls: 'al-badge-info',    dot: 'info',     label: t('installing') },
  suspended:  { cls: 'al-badge-offline', dot: 'offline',  label: t('suspended') },
};
const cfg = configs[s] || configs.offline;
%>
<span class="<%= cfg.cls %>">
  <span class="al-dot-<%= cfg.dot %>"></span>
  <%= locals.label || cfg.label %>
</span>
