URL="http://localhost:3000"
PORT=3000
NAME="Airlink"
DATABASE_URL="postgresql://airlink:airlink@127.0.0.1:5432/airlink"
REDIS_URL="redis://127.0.0.1:6379"
NODE_ENV="development"
# Generate a production value with: openssl rand -hex 32
SESSION_SECRET="change_me"
# Defaults used by "Auto-generate database host" on the admin Databases page.
# Leave unset to fall back to 127.0.0.1:5432 with user "postgres" and peer auth.
PGHOST="127.0.0.1"
PGPORT="5432"
PGUSER="airlink"
PGPASSWORD=""
