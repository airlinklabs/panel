# ── Core ──────────────────────────────────────────────────────────────────────
# Full URL the panel is accessible from (browser-facing).
# MUST match the actual URL users type — CSP 'self' and cookie scoping depend on this.
# Examples: "http://192.168.1.10:3000", "https://panel.example.com"
URL="http://localhost:3000"
PORT=3000
NAME="Airlink"
NODE_ENV="development"

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a production value with: openssl rand -hex 32
SESSION_SECRET="change_me"

# Force secure cookies even on HTTP (set "true" when behind TLS-terminating proxy).
# Only effective when COOKIE_SECURE is not set; auto-detected from URL scheme.
# COOKIE_SECURE=""

# Session max age in milliseconds. Default: 7 days.
# SESSION_MAX_AGE_MS=604800000

# ── Reverse Proxy / HTTPS ─────────────────────────────────────────────────────
# Set to "true" when behind Nginx, Caddy, Cloudflare, or any TLS-terminating proxy.
# Enables trust of X-Forwarded-For / X-Forwarded-Proto headers.
# Also overrides the admin "behind reverse proxy" DB toggle.
TRUST_PROXY="false"

# Cookie domain for cross-subdomain sessions (e.g. ".example.com").
# Leave empty to default to the exact host.
COOKIE_DOMAIN=""

# ── Asset Delivery ────────────────────────────────────────────────────────────
# Explicit base URL for static assets — use when serving assets from a CDN
# or a different origin than the panel itself. Leave empty for same-origin.
# Example: "https://cdn.example.com" or "/assets"
ASSET_BASE_URL=""

# ── Content Security Policy ───────────────────────────────────────────────────
# "true"  = always enable CSP (even in development)
# "false" = always disable CSP
# unset   = enable in production only (default)
CSP_ENABLED=""

# ── Allowed Origins ───────────────────────────────────────────────────────────
# Comma-separated list of additional origins allowed for connect-src / fetch.
# Useful when the panel talks to external APIs or daemons on different hosts.
# Example: "https://daemon1.example.com,https://daemon2.example.com"
ALLOWED_ORIGINS=""

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Global request rate limit (requests per window per IP). 0 = unlimited.
# RATE_LIMIT_MAX=500
# Rate limit window in milliseconds. Default: 60000 (1 minute).
# RATE_LIMIT_WINDOW_MS=60000

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL="info"

# ── Storage ───────────────────────────────────────────────────────────────────
# Override the default storage directory (panel/storage).
# STORAGE_DIR=""
# Maximum upload size in bytes. Default: 52428800 (50 MB).
# MAX_UPLOAD_BYTES=52428800

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://airlink:airlink@127.0.0.1:5432/airlink"
DB_POOL_MAX=20
# Minimum idle connections kept in pool. Default: 2.
# DB_POOL_MIN=2
# Connection timeout in milliseconds. Default: 10000.
# DB_CONNECT_TIMEOUT_MS=10000
# Raw Postgres credentials — used by the admin "Auto-generate database host" page.
# Leave unset to fall back to 127.0.0.1:5432 with user "postgres" and peer auth.
PGHOST="127.0.0.1"
PGPORT="5432"
PGUSER="airlink"
PGPASSWORD=""

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ── TLS (Direct HTTPS — no reverse proxy) ────────────────────────────────────
# Provide cert/key paths to run HTTPS directly without a reverse proxy.
# TLS_CERT_PATH=""
# TLS_KEY_PATH=""

# ── SMTP / Email ──────────────────────────────────────────────────────────────
# Required for password reset, email notifications, 2FA recovery codes.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="no-reply@airlink.example"
# SMTP_SECURE="true"

# ── Addons ────────────────────────────────────────────────────────────────────
# Comma-separated addon names to auto-load. Leave empty for auto-detection.
# ADDONS=""
