generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Users {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  username          String?   @unique
  password          String
  isAdmin           Boolean   @default(false)
  description       String?   @default("No About Me")
  avatar            String?
  permissions       String?   @default("[]")
  serverLimit       Int?      @default(0)
  maxMemory         Int?      @default(0)
  maxCpu            Int?      @default(0)
  maxStorage        Int?      @default(0)
  maxDatabases      Int?      @default(0)
role          String            @default("user")
  onboardingCompleted Boolean     @default(false)
  onboardingSkipped   Boolean     @default(false)
  preferredNodeId Int?
  loginAttempts Int              @default(0)
  lockedUntil       DateTime?
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  totpRecoveryCodes String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  servers        Server[]
  folders        ServerFolder[]
  apiKeys        ApiKey[]
  loginHistory   LoginHistory[]
  subUserAccess  SubUser[]
  passwordResets PasswordReset[]
  activityLogs   ActivityLog[]
  preferredNode  Node?           @relation("UserPreferredNode", fields: [preferredNodeId], references: [id], onDelete: SetNull)
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  session_id String   @unique
  data       String
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Server {
  id               Int                 @id @default(autoincrement())
  UUID             String              @unique @default(uuid())
  name             String
  description      String?
  createdAt        DateTime            @default(now())
  Ports            String
  Memory           Int
  Swap             Int                 @default(0)
  Cpu              Int
  Storage          Int
  Variables        String?
  StartCommand     String?
  dockerImage      String?
  sftpCredential   SftpCredential?
  allowStartupEdit Boolean             @default(false)
  Installing       Boolean             @default(true)
  Queued           Boolean             @default(true)
  Suspended        Boolean             @default(false)
  Running          Boolean             @default(false)
  backupLimit      Int                 @default(5)
  backupIgnoreList String              @default("")
  databaseLimit    Int                 @default(0)
  ownerId          Int
  nodeId           Int
  imageId          Int
  node             Node                @relation(fields: [nodeId], references: [id])
  owner            Users               @relation(fields: [ownerId], references: [id])
  image            Images              @relation(fields: [imageId], references: [id])
  backups          Backup[]
  folder           ServerFolderMember?
  subUsers         SubUser[]
  schedules        Schedule[]
  databases        ServerDatabase[]
  activityLogs     ActivityLog[]
  allocations      Allocation[]
  serverMounts     ServerMount[]
}

model Mount {
  id        Int      @id @default(autoincrement())
  name      String
  source    String
  target    String
  readOnly  Boolean  @default(false)
  createdAt DateTime @default(now())

  servers ServerMount[]
}

model ServerMount {
  serverId String
  mountId  Int
  server   Server @relation(fields: [serverId], references: [UUID], onDelete: Cascade)
  mount    Mount  @relation(fields: [mountId], references: [id], onDelete: Cascade)

  @@id([serverId, mountId])
  @@index([serverId])
}

model DatabaseHost {
  id        Int              @id @default(autoincrement())
  name      String
  host      String
  port      Int              @default(3306)
  username  String
  password  String
  nodeId    Int?
  createdAt DateTime         @default(now())
  node      Node?            @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  databases ServerDatabase[]
}

model ServerDatabase {
  id               Int          @id @default(autoincrement())
  serverId         String
  hostId           Int
  databaseName     String
  databaseUser     String
  databasePassword String
  createdAt        DateTime     @default(now())
  server           Server       @relation(fields: [serverId], references: [UUID], onDelete: Cascade)
  host             DatabaseHost @relation(fields: [hostId], references: [id])

  @@index([serverId])
}

model Schedule {
  id         Int            @id @default(autoincrement())
  serverId   String
  name       String
  cron       String
  enabled    Boolean        @default(false)
  timeOffset Int            @default(0)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime       @default(now())
  server     Server         @relation(fields: [serverId], references: [UUID], onDelete: Cascade)
  tasks      ScheduleTask[]
}

model ScheduleTask {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  order      Int      @default(0)
  action     String
  payload    String
  timeOffset Int      @default(0)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model Images {
  id               Int      @id @default(autoincrement())
  UUID             String   @unique @default(uuid())
  name             String?
  description      String?
  author           String?
  authorName       String?
  createdAt        DateTime @default(now())
  meta             String?
  dockerImages     String?
  startup          String?
  stop             String?
  startup_done     String?
  config_files     String?
  info             String?
  scripts          String?
  variables        String?
  portRequirements String   @default("[]")
  status           String   @default("approved")
  createdById      Int?
  rejectionReason  String?

  servers Server[]
}

model Allocation {
  id        Int      @id @default(autoincrement())
  nodeId    Int
  ip        String   @default("")
  port      Int
  serverId  String? // null = available, else claimed by a server
  createdAt DateTime @default(now())

  node   Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [UUID], onDelete: SetNull)

  @@unique([nodeId, ip, port])
  @@index([nodeId, serverId])
}

model Node {
  id                 Int            @id @default(autoincrement())
  name               String
  ram                Int            @default(0)
  cpu                Int            @default(0)
  disk               Int            @default(0)
  overallocateMemory Int            @default(0)
  overallocateDisk   Int            @default(0)
  overallocateCpu    Int            @default(0)
  locationId         Int?
  address            String         @default("127.0.0.1")
  port               Int            @default(3001)
  key                String
  createdAt          DateTime       @default(now())
  allocatedPorts     String?        @default("[]")
  sftpPort           Int            @default(3003)
  maintenanceMode    Boolean        @default(false)
  location           Location?      @relation(fields: [locationId], references: [id])
  servers            Server[]
  databaseHosts      DatabaseHost[]
  allocations        Allocation[]
  preferredUsers     Users[]        @relation("UserPreferredNode")
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  shortCode String   @unique
  createdAt DateTime @default(now())
  nodes     Node[]
}

model settings {
  id                        Int      @id @default(autoincrement())
  title                     String   @default("Airlink")
  description               String   @default("AirLink is a free and open source project by AirlinkLabs")
  logo                      String   @default("../assets/logo.png")
  favicon                   String   @default("../assets/favicon.ico")
  theme                     String   @default("default")
  lightTheme                String   @default("default")
  darkTheme                 String   @default("default")
  language                  String   @default("en")
  allowRegistration         Boolean  @default(false)
  uploadLimit               Int      @default(100)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  sftpPort                  Int      @default(3003)
  virusTotalApiKey          String?
  rateLimitEnabled          Boolean  @default(true)
  rateLimitRpm              Int      @default(100)
  bannedIps                 String   @default("[]")
  allowUserCreateServer     Boolean  @default(false)
  allowUserDeleteServer     Boolean  @default(false)
  defaultServerLimit        Int      @default(0)
  defaultMaxMemory          Int      @default(512)
  defaultMaxCpu             Int      @default(100)
  defaultMaxStorage         Int      @default(5120)
  defaultMaxDatabases       Int      @default(0)
  defaultOverallocateMemory Int      @default(0)
  defaultOverallocateDisk   Int      @default(0)
  defaultOverallocateCpu    Int      @default(0)
  loginWallpaper            String?
  registerWallpaper         String?
  panelWallpaper            String?
  loginMaxAttempts          Int      @default(5)
  loginLockoutMinutes       Int      @default(15)
  enforceDaemonHttps        Boolean  @default(false)
  require2faForAdmins       Boolean  @default(false)
  behindReverseProxy        Boolean  @default(false)
  hashApiKeys               Boolean  @default(false)
  airlinkCloudApiKey        String?
  airlinkCloudBackupEnabled Boolean  @default(false)
  smtpHost                  String?
  smtpPort                  Int?     @default(587)
  smtpUser                  String?
  smtpPassword              String?
  smtpFrom                  String?
  smtpSecure                Boolean  @default(false)
  s3Enabled                 Boolean  @default(false)
  s3Endpoint                String?
  s3Region                  String?
  s3Bucket                  String?
  s3AccessKey               String?
  s3SecretKey               String?
  s3PathStyle               Boolean  @default(false)
  allowPrivilegedServerLimit  Int    @default(5)
  allowPrivilegedMaxMemory    Int    @default(2048)
  allowPrivilegedMaxCpu       Int    @default(200)
  allowPrivilegedMaxStorage   Int    @default(61440)
  allowPrivilegedMaxDatabases Int    @default(10)
  allowUserCreateImages     Boolean  @default(false)
  onboardingEnabled         Boolean  @default(true)
  onboardingSteps           String   @default("[]")
}

model ServerFolder {
  id        Int                  @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime             @default(now())
  owner     Users                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   ServerFolderMember[]

  @@index([ownerId])
}

model ServerFolderMember {
  id         Int          @id @default(autoincrement())
  folderId   Int
  serverUUID String       @unique
  folder     ServerFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  server     Server       @relation(fields: [serverUUID], references: [UUID], onDelete: Cascade)
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  name        String
  key         String   @unique
  description String?
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)
  userId      Int?
  user        Users?   @relation(fields: [userId], references: [id])
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      Users    @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
}

model PlayerStats {
  id            Int      @id @default(autoincrement())
  timestamp     DateTime @default(now())
  totalPlayers  Int      @default(0)
  maxPlayers    Int      @default(0)
  onlineServers Int      @default(0)
  totalServers  Int      @default(0)

  @@index([timestamp])
}

model Addon {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  version     String
  author      String?
  enabled     Boolean  @default(true)
  mainFile    String   @default("index.ts")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AddonSetting {
  id        Int      @id @default(autoincrement())
  addonSlug String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([addonSlug, key])
}

model Backup {
  id             Int      @id @default(autoincrement())
  UUID           String   @unique @default(uuid())
  name           String
  serverId       String
  filePath       String
  size           BigInt?
  checksum       String?
  locked         Boolean  @default(false)
  createdAt      DateTime @default(now())
  server         Server   @relation(fields: [serverId], references: [UUID], onDelete: Cascade)
  airlinkCloudId String?

  @@index([serverId])
  @@index([createdAt])
}

model SftpCredential {
  id        Int       @id @default(autoincrement())
  serverId  String    @unique
  username  String
  password  String
  host      String
  port      Int
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  server    Server    @relation(fields: [serverId], references: [UUID], onDelete: Cascade)
}

model SubUser {
  id          Int      @id @default(autoincrement())
  serverId    String
  userId      Int
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  server      Server   @relation(fields: [serverId], references: [UUID], onDelete: Cascade)
  user        Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  serverId  String?
  event     String
  metadata  String?
  ip        String?
  createdAt DateTime @default(now())
  actor     Users?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  server    Server?  @relation(fields: [serverId], references: [UUID], onDelete: SetNull)

  @@index([actorId])
  @@index([serverId])
  @@index([createdAt])
}
